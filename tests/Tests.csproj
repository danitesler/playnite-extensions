<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <!-- Plugin projects keep PlayniteSDK private; tests touch SDK base types (ObservableObject, ApplicationMode). -->
    <PackageReference Include="PlayniteSDK" Version="6.6.0" />
    <!-- Playnite loads plugin settings with Newtonsoft.Json; used to deserialize legacy settings JSON. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Autogrid\Autogrid.csproj" />
    <ProjectReference Include="..\src\AutoStatus\AutoStatus.csproj" />
    <ProjectReference Include="..\src\GameHoverDetails\GameHoverDetails.csproj" />
    <ProjectReference Include="..\src\RandomTheme\RandomTheme.csproj" />
  </ItemGroup>
</Project>
