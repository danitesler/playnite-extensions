<!--
    Overlay on Playnite Default/Views/TopPanel.xaml.
    Windows 11 title-bar row: 48px on the base layer (no fill, no border), like the Microsoft Store and Teams title
    bars. The search box sits in the middle (up to 468px, Fluent SearchBox outline, 32px) and shrinks when the row
    gets tight; Playnite's view controls, filters and notifications are subtle 32px icon buttons with 20px Fluent
    System Icons on the right, before the caption buttons. Notifications use a brand CounterBadge.
    The library itself sits on the content layer below (Views/Library.xaml).
    TopPanelMenu, the toggles and the icon templates keep Playnite's keys. All PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" Content="{DynamicResource FluentIconViewSettings}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" Content="{DynamicResource FluentIconFilterPresets}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" Content="{DynamicResource FluentIconGroup}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" Content="{DynamicResource FluentIconSort}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" Content="{DynamicResource FluentIconDetailsView}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" Content="{DynamicResource FluentIconGridView}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" Content="{DynamicResource FluentIconListView}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" TextElement.Foreground="{DynamicResource WarningBrush}" Content="{DynamicResource FluentIconUpdate}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" Content="{DynamicResource FluentIconExplorer}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" Content="{DynamicResource FluentIconRandom}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" Content="{DynamicResource FluentIconViewRandom}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" Content="{DynamicResource FluentIconSearch}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>

    <!-- Looked up from code for the main menu; the MenuPopover from DefaultControls/ContextMenu.xaml. -->
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <!-- Subtle icon ToggleButton; brand icon when checked or while a filter applies ("Filter active" label). -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource FluentNeutralForeground1Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource FluentBorderRadiusMedium}"
                            Padding="6,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" VerticalAlignment="Center" Content="{DynamicResource FluentIconFilter}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
                            <TextBlock x:Name="TextFilter" Text="{DynamicResource LOCFilterActiveLabel}"
                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{TemplateBinding Foreground}"
                                       Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="Foreground" Value="{DynamicResource FluentCompoundBrandForeground1Brush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource FluentSubtleBackgroundHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FluentCompoundBrandForeground1Brush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource FluentSubtleBackgroundHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FluentCompoundBrandForeground1Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Subtle icon button with a CounterBadge (brand, 16px, circular); hidden while there is nothing to show. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FluentNeutralForeground1Brush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource FluentBorderRadiusMedium}">
                        <Grid>
                            <ContentPresenter Width="{DynamicResource FluentIconSize}" Height="{DynamicResource FluentIconSize}" Content="{DynamicResource FluentIconNotifications}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
                            <Border CornerRadius="{DynamicResource FluentBorderRadiusCircular}" MinWidth="16" Height="16" Padding="4,0,4,0"
                                    Margin="0,0,-2,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource FluentBrandBackgroundBrush}">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FluentNeutralForegroundOnBrandBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource FluentSubtleBackgroundHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FluentCompoundBrandForeground1Brush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource FluentSubtleBackgroundHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FluentCompoundBrandForeground1Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Fluent SearchBox, outline, medium: CustomControls/SearchBox.xaml at 32px, centered, up to 468px. -->
    <Style x:Key="FluentTitleBarSearch" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="MaxWidth" Value="468" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <!-- Right padding: three 46px caption buttons + 8px. -->
                    <Border Height="48" Padding="12,0,146,0" Background="{TemplateBinding Background}">
                        <DockPanel>
                            <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource FluentHamburger}"
                                    DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center">
                                <ContentPresenter Width="20" Height="20" Content="{DynamicResource FluentIconMainMenu}" ContentTemplate="{DynamicResource FluentIconTemplate}" />
                            </Border>

                            <!-- ProgressBar (2px bar in brand) with its caption, on the left of the row. -->
                            <!-- Sized by its parts, which Playnite collapses while nothing runs, so it takes no room then. -->
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Name="PART_TextProgressText" Margin="4,0,0,4" MaxWidth="240"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource FluentNeutralForeground3Brush}"
                                               Style="{DynamicResource BaseTextBlockStyle}" />
                                    <ProgressBar Name="PART_ProgressGlobal" Height="2" Width="240" Margin="4,0,0,0" />
                                </StackPanel>
                                <Button Name="PART_ButtonProgressCancel"
                                        Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Margin="12,0,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <CheckBox x:Name="PART_ToggleNotifications" DockPanel.Dock="Right"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" />

                            <CheckBox x:Name="PART_ToggleFilter" DockPanel.Dock="Right"
                                      ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" />

                            <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal" Margin="16,0,0,0"
                                        VerticalAlignment="Center" DockPanel.Dock="Right" />

                            <SearchBox x:Name="PART_TextMainSearch" Margin="16,0,16,0"
                                       Style="{StaticResource FluentTitleBarSearch}"
                                       WindowChrome.IsHitTestVisibleInChrome="True" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
