<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml (grid mode, side panel).
    The Store product page stacked for a narrow column (16px gutters): the box art cover centered (max 280px),
    the title at 20px semibold with the icon, the developer as a brand
    Link, platforms and genres as small outline InteractionTags, the actions (primary Play or Install at 40px filling
    the width, secondary More, subtle icon Button Edit), then Subtitle 2 sections (16px semibold): Description,
    Additional information as one column of a semibold label over its value, Notes.
    The panel edge follows Playnite's panel settings. Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <DockPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DockPanel.Resources>

                            <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,12,12,0"
                                    Content="r" FontFamily="Marlett"
                                    Style="{DynamicResource SimpleButton}"
                                    Command="{MainViewModel CloseGameSideBarCommand}" />

                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCErrorNoGameSelected}"
                                       Margin="16,24,16,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrushDarker}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,0,16,24">
                                        <Image x:Name="PART_ImageCover" HorizontalAlignment="Center" Margin="0,0,0,16"
                                               Stretch="Uniform" StretchDirection="Both" MaxHeight="280"
                                               RenderOptions.BitmapScalingMode="Fant"
                                               Tag="{DynamicResource ShowCoverImage}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                            <DataTrigger.Value>
                                                                <sys:Boolean>False</sys:Boolean>
                                                            </DataTrigger.Value>
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <DockPanel>
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>
                                        <ItemsControl x:Name="PART_ItemsDevelopers" Tag="Accent" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <StackPanel Margin="0,12,0,0">
                                            <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" MinHeight="40" />
                                                <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" MinHeight="40" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Content="{DynamicResource LOCMoreAction}"
                                                    Margin="8,0,0,0" MinHeight="40" />
                                            <Button x:Name="PART_ButtonEditGame" Width="32" Height="32" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <ContentPresenter Width="20" Height="20"
                                                                  Content="{DynamicResource IconEdit}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel x:Name="PART_ElemDescription" Margin="0,28,0,0">
                                            <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <HtmlTextView x:Name="PART_HtmlDescription"
                                                          TextElement.Foreground="{DynamicResource TextBrush}"
                                                          Tag="{DynamicResource GlyphBrush}"
                                                          HtmlFontSize="{DynamicResource FontSize}"
                                                          HtmlFontFamily="{DynamicResource FontFamily}"
                                                          HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                          LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                        </StackPanel>

                                        <!-- Steam screenshots -->
                                        <StackPanel Margin="0,28,0,0"
                                                    Visibility="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                        </StackPanel>

                                        <TextBlock Text="{DynamicResource LOCGameDetails}" FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" Margin="0,28,0,12" />
                                        <StackPanel x:Name="PART_ElemPlayTime" Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCTimePlayed}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBlock x:Name="PART_TextPlayTime" />
                                        </StackPanel>
                                        <StackPanel x:Name="PART_ElemLastPlayed" Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCLastPlayed}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBlock x:Name="PART_TextLastActivity" />
                                        </StackPanel>
                                        <StackPanel x:Name="PART_ElemCompletionStatus" Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                        </StackPanel>
                                        <StackPanel x:Name="PART_ElemReleaseDate" Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                        </StackPanel>
                                        <StackPanel x:Name="PART_ElemPublishers" Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCPublisherLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <ItemsControl x:Name="PART_ItemsPublishers" />
                                        </StackPanel>
                                        <StackPanel x:Name="PART_ElemLibrary" Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCGameProviderTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                        </StackPanel>
                                        <StackPanel x:Name="PART_ElemInstallSize" Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBlock x:Name="PART_TextInstallSize" />
                                        </StackPanel>
                                        <StackPanel x:Name="PART_ElemFeatures" Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCFeaturesLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <ItemsControl x:Name="PART_ItemsFeatures" />
                                        </StackPanel>
                                        <StackPanel x:Name="PART_ElemLinks" Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCLinksLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <ItemsControl x:Name="PART_ItemsLinks" />
                                        </StackPanel>

                                        <StackPanel x:Name="PART_ElemNotes" Margin="0,12,0,0">
                                            <TextBlock Text="{DynamicResource LOCNotesLabel}" FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                     Background="{DynamicResource ControlBackgroundBrush}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
