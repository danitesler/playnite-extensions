<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details mode, right pane).
    The Microsoft Store product page in Fluent 2 parts. Hero: the background art, 320px, fading into the content layer
    (colorNeutralBackground1); hidden when there is no art. The page column (max 1000px, 36px sides) starts 120px
    down: the box art tile (Playnite's cover height setting, borderRadiusLarge, 1px colorNeutralStroke2 edge), then
    the title at 28px semibold (Title 1) with the icon, the developer as a brand Link, platforms and genres as small
    outline InteractionTags, and the actions: primary Play (or Install) at 40px (Button size large, min 160px wide),
    secondary More, subtle icon Button Edit (32px, Fluent edit icon).
    Sections under Title 3 headings (20px semibold), no cards (the content layer and Fluent's Card share
    colorNeutralBackground1): Description, then the Store's "Additional information" grid, three columns of a
    semibold label over its value (time played, last played, completion, release date, publisher, library, install
    size, features, links), then Notes.
    Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>

                            <!-- Hero art, fading into the content layer -->
                            <Grid x:Name="Hero" Height="320" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Fill="{DynamicResource ContentBackgroundBrush}">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#40000000" Offset="0" />
                                            <GradientStop Color="#FF000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>

                            <StackPanel MaxWidth="1000" VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Margin" Value="36,24,36,36" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=Hero}" Value="Visible">
                                                <Setter Property="Margin" Value="36,120,36,36" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Product header: box art tile, then title, developer, tags and actions -->
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Margin="0,0,24,0" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                        <Grid.CacheMode>
                                            <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                        </Grid.CacheMode>
                                        <Grid>
                                            <Grid.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=CoverShape}" />
                                            </Grid.OpacityMask>
                                            <Border x:Name="CoverShape" CornerRadius="{DynamicResource CornerRadiusLarge}" Background="{DynamicResource ContentBackgroundBrush}" />
                                            <Image x:Name="PART_ImageCover" Stretch="Uniform" StretchDirection="Both" Height="{Settings GameDetailsCoverHeight}"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                            <Border CornerRadius="{DynamicResource CornerRadiusLarge}" BorderThickness="{DynamicResource ControlBorderThickness}"
                                                    BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" />
                                        </Grid>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <DockPanel>
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeLargest}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>
                                        <ItemsControl x:Name="PART_ItemsDevelopers" Tag="Accent" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <StackPanel Margin="0,12,0,0">
                                            <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Grid MinWidth="160">
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" MinHeight="40" />
                                                <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" MinHeight="40" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Content="{DynamicResource LOCMoreAction}"
                                                    Margin="8,0,0,0" MinHeight="40" />
                                            <Button x:Name="PART_ButtonEditGame" Width="32" Height="32" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <ContentPresenter Width="20" Height="20"
                                                                  Content="{DynamicResource IconEdit}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Description -->
                                <StackPanel x:Name="PART_ElemDescription" Margin="0,40,0,0">
                                    <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <HtmlTextView x:Name="PART_HtmlDescription"
                                                  TextElement.Foreground="{DynamicResource TextBrush}"
                                                  Tag="{DynamicResource GlyphBrush}"
                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                </StackPanel>

                                <!-- Additional information: three columns of label over value -->
                                <TextBlock Text="{DynamicResource LOCGameDetails}" FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold" Margin="0,40,0,16" />
                                <UniformGrid Columns="3" Margin="0,0,-24,0">
                                    <StackPanel x:Name="PART_ElemPlayTime" Margin="0,0,24,20">
                                        <TextBlock Text="{DynamicResource LOCTimePlayed}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock x:Name="PART_TextPlayTime" />
                                    </StackPanel>
                                    <StackPanel x:Name="PART_ElemLastPlayed" Margin="0,0,24,20">
                                        <TextBlock Text="{DynamicResource LOCLastPlayed}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock x:Name="PART_TextLastActivity" />
                                    </StackPanel>
                                    <StackPanel x:Name="PART_ElemCompletionStatus" Margin="0,0,24,20">
                                        <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                    </StackPanel>
                                    <StackPanel x:Name="PART_ElemReleaseDate" Margin="0,0,24,20">
                                        <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                    </StackPanel>
                                    <StackPanel x:Name="PART_ElemPublishers" Margin="0,0,24,20">
                                        <TextBlock Text="{DynamicResource LOCPublisherLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl x:Name="PART_ItemsPublishers" />
                                    </StackPanel>
                                    <StackPanel x:Name="PART_ElemLibrary" Margin="0,0,24,20">
                                        <TextBlock Text="{DynamicResource LOCGameProviderTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                    </StackPanel>
                                    <StackPanel x:Name="PART_ElemInstallSize" Margin="0,0,24,20">
                                        <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock x:Name="PART_TextInstallSize" />
                                    </StackPanel>
                                    <StackPanel x:Name="PART_ElemFeatures" Margin="0,0,24,20">
                                        <TextBlock Text="{DynamicResource LOCFeaturesLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl x:Name="PART_ItemsFeatures" />
                                    </StackPanel>
                                    <StackPanel x:Name="PART_ElemLinks" Margin="0,0,24,20">
                                        <TextBlock Text="{DynamicResource LOCLinksLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl x:Name="PART_ItemsLinks" />
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel x:Name="PART_ElemNotes" Margin="0,24,0,0">
                                    <TextBlock Text="{DynamicResource LOCNotesLabel}" FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                             Background="{DynamicResource ControlBackgroundBrush}"
                                             AcceptsReturn="True" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
