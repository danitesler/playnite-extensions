<!-- Overlay on Playnite Default/Common.xaml: only restyled keys live here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- MenuPopover surface: colorNeutralBackground1, borderRadiusMedium; the edge stands in for shadow16. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource FluentBorderRadiusMedium}" />
    </Style>

    <!-- Fluent focus (react-tabster createFocusOutlineStyle): 2px colorStrokeFocus2 outline hugging the control, drawn
         2px outside a borderRadiusMedium edge, so its own corners are borderRadiusLarge. WPF shows FocusVisualStyle for
         keyboard focus only, like :focus-visible. -->
    <Style x:Key="FluentFocusOutline">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource FluentBorderRadiusLarge}"
                            BorderBrush="{DynamicResource FluentStrokeFocus2Brush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing at Fluent's medium size (32px controls), named after the component. -->
    <Thickness x:Key="FluentButtonPadding">12,5,12,5</Thickness> <!-- Button medium: 5px 12px (spacingHorizontalM), min-height 32px, inside a 1px border -->
    <Thickness x:Key="FluentInputPadding">12,5,12,5</Thickness> <!-- Input / Dropdown medium: 32px, spacingHorizontalMNudge 10px + 2px inline -->
    <Thickness x:Key="FluentMenuPopoverPadding">4</Thickness> <!-- MenuPopover padding 4px -->
    <Thickness x:Key="FluentMenuItemPadding">8,6,8,6</Thickness> <!-- MenuItem: spacingVerticalSNudge 6px + 2px label inset, 32px tall -->
    <Thickness x:Key="FluentOptionPadding">8,6,8,6</Thickness> <!-- Option: spacingVerticalSNudge 6px, spacingHorizontalS 8px -->
    <Thickness x:Key="FluentCardPadding">12</Thickness> <!-- Card medium: 12px -->
    <Thickness x:Key="FluentCardHeaderMargin">0,0,0,12</Thickness> <!-- Card medium gap 12px -->
    <sys:Double x:Key="FluentIconSize">20</sys:Double> <!-- Button medium icons: 20px -->
    <Thickness x:Key="FluentTooltipPadding">11,4,11,6</Thickness> <!-- Tooltip: 4px 11px 6px -->
</ResourceDictionary>
