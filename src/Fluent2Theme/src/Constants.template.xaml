<!--
    Fluent 2 Theme: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from tokens.css
    (Fluent's webDarkTheme tokens) and writes the result to the build as Constants.xaml.

    Keys are Fluent's token names with Fluent in front instead of the color prefix: colorNeutralBackground1 is
    FluentNeutralBackground1Color / FluentNeutralBackground1Brush, borderRadiusMedium is FluentBorderRadiusMedium,
    strokeWidthThin is FluentStrokeWidthThin.

    Theme XAML reads these keys with DynamicResource only: Playnite parses each theme file on its own before merging.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). fontSizeBase300 (14px) is the body size, fontSizeBase200 (12px) caption. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">28</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:fontFamilyBase|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys) -->
    <Thickness x:Key="PopupBorderThickness">{{px:strokeWidthThin}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:strokeWidthThin}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:strokeWidthThin}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:borderRadiusMedium}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- borderRadius*, strokeWidth* -->
    <CornerRadius x:Key="FluentBorderRadiusSmall">{{px:borderRadiusSmall}}</CornerRadius>
    <CornerRadius x:Key="FluentBorderRadiusMedium">{{px:borderRadiusMedium}}</CornerRadius>
    <CornerRadius x:Key="FluentBorderRadiusLarge">{{px:borderRadiusLarge}}</CornerRadius>
    <CornerRadius x:Key="FluentBorderRadiusXLarge">{{px:borderRadiusXLarge}}</CornerRadius>
    <CornerRadius x:Key="FluentBorderRadiusCircular">10000</CornerRadius>
    <Thickness x:Key="FluentStrokeWidthThin">{{px:strokeWidthThin}}</Thickness>

    <!-- Color tokens -->
    <Color x:Key="FluentNeutralForeground1Color">{{colorNeutralForeground1}}</Color>
    <Color x:Key="FluentNeutralForeground3Color">{{colorNeutralForeground3}}</Color>
    <Color x:Key="FluentNeutralForegroundInvertedColor">{{colorNeutralForegroundInverted}}</Color>
    <Color x:Key="FluentNeutralForegroundOnBrandColor">{{colorNeutralForegroundOnBrand}}</Color>
    <Color x:Key="FluentNeutralBackground1Color">{{colorNeutralBackground1}}</Color>
    <Color x:Key="FluentNeutralBackground1HoverColor">{{colorNeutralBackground1Hover}}</Color>
    <Color x:Key="FluentNeutralBackground1PressedColor">{{colorNeutralBackground1Pressed}}</Color>
    <Color x:Key="FluentNeutralBackground1SelectedColor">{{colorNeutralBackground1Selected}}</Color>
    <Color x:Key="FluentNeutralBackground2Color">{{colorNeutralBackground2}}</Color>
    <Color x:Key="FluentNeutralBackground6Color">{{colorNeutralBackground6}}</Color>
    <Color x:Key="FluentSubtleBackgroundHoverColor">{{colorSubtleBackgroundHover}}</Color>
    <Color x:Key="FluentSubtleBackgroundSelectedColor">{{colorSubtleBackgroundSelected}}</Color>
    <Color x:Key="FluentBrandBackgroundColor">{{colorBrandBackground}}</Color>
    <Color x:Key="FluentBrandBackgroundHoverColor">{{colorBrandBackgroundHover}}</Color>
    <Color x:Key="FluentCompoundBrandBackgroundColor">{{colorCompoundBrandBackground}}</Color>
    <Color x:Key="FluentCompoundBrandBackgroundHoverColor">{{colorCompoundBrandBackgroundHover}}</Color>
    <Color x:Key="FluentCompoundBrandForeground1Color">{{colorCompoundBrandForeground1}}</Color>
    <Color x:Key="FluentCompoundBrandStrokeColor">{{colorCompoundBrandStroke}}</Color>
    <Color x:Key="FluentNeutralStroke1Color">{{colorNeutralStroke1}}</Color>
    <Color x:Key="FluentNeutralStroke1HoverColor">{{colorNeutralStroke1Hover}}</Color>
    <Color x:Key="FluentNeutralStroke2Color">{{colorNeutralStroke2}}</Color>
    <Color x:Key="FluentNeutralStrokeAccessibleColor">{{colorNeutralStrokeAccessible}}</Color>
    <Color x:Key="FluentNeutralStrokeAccessibleHoverColor">{{colorNeutralStrokeAccessibleHover}}</Color>
    <Color x:Key="FluentStrokeFocus2Color">{{colorStrokeFocus2}}</Color>
    <Color x:Key="FluentPaletteRedBackground3Color">{{colorPaletteRedBackground3}}</Color>
    <Color x:Key="FluentPaletteYellowForeground1Color">{{colorPaletteYellowForeground1}}</Color>
    <Color x:Key="FluentStatusDangerForeground1Color">{{colorStatusDangerForeground1}}</Color>
    <Color x:Key="FluentStatusWarningForeground1Color">{{colorStatusWarningForeground1}}</Color>
    <Color x:Key="FluentStatusSuccessForeground1Color">{{colorStatusSuccessForeground1}}</Color>

    <SolidColorBrush x:Key="FluentNeutralForeground1Brush" Color="{DynamicResource FluentNeutralForeground1Color}" />
    <SolidColorBrush x:Key="FluentNeutralForeground3Brush" Color="{DynamicResource FluentNeutralForeground3Color}" />
    <SolidColorBrush x:Key="FluentNeutralForegroundInvertedBrush" Color="{DynamicResource FluentNeutralForegroundInvertedColor}" />
    <SolidColorBrush x:Key="FluentNeutralForegroundOnBrandBrush" Color="{DynamicResource FluentNeutralForegroundOnBrandColor}" />
    <SolidColorBrush x:Key="FluentNeutralBackground1Brush" Color="{DynamicResource FluentNeutralBackground1Color}" />
    <SolidColorBrush x:Key="FluentNeutralBackground1HoverBrush" Color="{DynamicResource FluentNeutralBackground1HoverColor}" />
    <SolidColorBrush x:Key="FluentNeutralBackground1PressedBrush" Color="{DynamicResource FluentNeutralBackground1PressedColor}" />
    <SolidColorBrush x:Key="FluentNeutralBackground1SelectedBrush" Color="{DynamicResource FluentNeutralBackground1SelectedColor}" />
    <SolidColorBrush x:Key="FluentNeutralBackground2Brush" Color="{DynamicResource FluentNeutralBackground2Color}" />
    <SolidColorBrush x:Key="FluentNeutralBackground6Brush" Color="{DynamicResource FluentNeutralBackground6Color}" />
    <SolidColorBrush x:Key="FluentSubtleBackgroundHoverBrush" Color="{DynamicResource FluentSubtleBackgroundHoverColor}" />
    <SolidColorBrush x:Key="FluentSubtleBackgroundSelectedBrush" Color="{DynamicResource FluentSubtleBackgroundSelectedColor}" />
    <SolidColorBrush x:Key="FluentBrandBackgroundBrush" Color="{DynamicResource FluentBrandBackgroundColor}" />
    <SolidColorBrush x:Key="FluentBrandBackgroundHoverBrush" Color="{DynamicResource FluentBrandBackgroundHoverColor}" />
    <SolidColorBrush x:Key="FluentCompoundBrandBackgroundBrush" Color="{DynamicResource FluentCompoundBrandBackgroundColor}" />
    <SolidColorBrush x:Key="FluentCompoundBrandBackgroundHoverBrush" Color="{DynamicResource FluentCompoundBrandBackgroundHoverColor}" />
    <SolidColorBrush x:Key="FluentCompoundBrandForeground1Brush" Color="{DynamicResource FluentCompoundBrandForeground1Color}" />
    <SolidColorBrush x:Key="FluentCompoundBrandStrokeBrush" Color="{DynamicResource FluentCompoundBrandStrokeColor}" />
    <SolidColorBrush x:Key="FluentNeutralStroke1Brush" Color="{DynamicResource FluentNeutralStroke1Color}" />
    <SolidColorBrush x:Key="FluentNeutralStroke1HoverBrush" Color="{DynamicResource FluentNeutralStroke1HoverColor}" />
    <SolidColorBrush x:Key="FluentNeutralStroke2Brush" Color="{DynamicResource FluentNeutralStroke2Color}" />
    <SolidColorBrush x:Key="FluentNeutralStrokeAccessibleBrush" Color="{DynamicResource FluentNeutralStrokeAccessibleColor}" />
    <SolidColorBrush x:Key="FluentNeutralStrokeAccessibleHoverBrush" Color="{DynamicResource FluentNeutralStrokeAccessibleHoverColor}" />
    <SolidColorBrush x:Key="FluentStrokeFocus2Brush" Color="{DynamicResource FluentStrokeFocus2Color}" />
    <SolidColorBrush x:Key="FluentPaletteRedBackground3Brush" Color="{DynamicResource FluentPaletteRedBackground3Color}" />
    <SolidColorBrush x:Key="FluentPaletteYellowForeground1Brush" Color="{DynamicResource FluentPaletteYellowForeground1Color}" />
    <SolidColorBrush x:Key="FluentStatusDangerForeground1Brush" Color="{DynamicResource FluentStatusDangerForeground1Color}" />
    <SolidColorBrush x:Key="FluentStatusWarningForeground1Brush" Color="{DynamicResource FluentStatusWarningForeground1Color}" />
    <SolidColorBrush x:Key="FluentStatusSuccessForeground1Brush" Color="{DynamicResource FluentStatusSuccessForeground1Color}" />

    <!--
        Playnite palette keys, mapped to Fluent's tokens. Every Playnite view and control the theme does not restyle
        reads these. GlyphColor (selection, checked, links) is the compound brand with colorNeutralForegroundInverted as
        TextColorDark; primary buttons use colorBrandBackground.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{colorNeutralForeground1}}</Color>
    <Color x:Key="TextColorDarker">{{colorNeutralForeground3}}</Color>
    <Color x:Key="TextColorDark">{{colorNeutralForegroundInverted}}</Color>
    <Color x:Key="MainColor">{{colorNeutralBackground1}}</Color>
    <Color x:Key="MainColorDark">{{colorNeutralBackground1}}</Color>
    <Color x:Key="HoverColor">{{colorSubtleBackgroundHover}}</Color>
    <Color x:Key="GlyphColor">{{colorCompoundBrandBackground}}</Color>
    <Color x:Key="HighlightGlyphColor">{{colorCompoundBrandBackground/50}}</Color>
    <Color x:Key="PopupBackgroundColor">{{colorNeutralBackground1}}</Color>
    <Color x:Key="PopupBorderColor">{{colorNeutralStroke2}}</Color>     <!-- stands in for shadow16 -->
    <Color x:Key="BackgroundToneColor">{{colorNeutralBackground1}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>     <!-- no frame around covers -->
    <Color x:Key="PanelSeparatorColor">#00000000</Color>         <!-- no lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{colorNeutralStroke2}}</Color>
    <Color x:Key="DataChangeNotifColor">{{colorStatusWarningForeground1}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{DynamicResource FluentNeutralStroke1Color}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource FluentSubtleBackgroundHoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{DynamicResource FluentNeutralBackground1Color}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource FluentNeutralBackground1Color}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource FluentNeutralBackground1Color}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{colorStatusSuccessForeground1}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{DynamicResource FluentStatusDangerForeground1Color}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{colorPaletteYellowForeground1}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource FluentStatusDangerForeground1Color}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{DynamicResource FluentNeutralBackground1Color}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{DynamicResource FluentNeutralBackground2Color}" />
</ResourceDictionary>
