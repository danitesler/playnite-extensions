    <!-- Content = one of the geometries above, drawn in the inherited foreground. The host sets the size. -->
    <DataTemplate x:Key="FluentIconTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="20" Height="20">
                <Path Data="{Binding}"
                      Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="FluentIcon16Template">
        <Viewbox Stretch="Uniform">
            <Canvas Width="16" Height="16">
                <Path Data="{Binding}"
                      Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentPresenter Width="20" Height="20"
                          Content="{DynamicResource FluentIconSearch}"
                          ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentPresenter Width="20" Height="20"
                          Content="{DynamicResource FluentIconClear}"
                          ContentTemplate="{DynamicResource FluentIconTemplate}" />
    </DataTemplate>

    <TextBlock x:Key="ExitIcon" Text="&#xef1d;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="AddFavoritesIcon" Text="&#xef25;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="RemoveGameIcon" Text="&#xec53;" FontFamily="{DynamicResource FontIcoFont}"
               FontWeight="Light" />
</ResourceDictionary>
