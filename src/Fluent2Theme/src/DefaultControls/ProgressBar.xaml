<!--
    Overlay on Playnite Default/DefaultControls/ProgressBar.xaml.
    Fluent ProgressBar (react-progress), rounded shape: colorNeutralBackground6 track, colorCompoundBrandBackground bar,
    borderRadiusMedium; the caller sets the thickness (Fluent medium is 2px). Indeterminate mode slides a 33% segment
    across the track over 3s by animating a gradient brush, so the rounded ends never need clipping.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource FluentCompoundBrandBackgroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource FluentNeutralBackground6Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource FluentBorderRadiusMedium}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{DynamicResource FluentBorderRadiusMedium}" />
                        <Border x:Name="IndeterminateBar" Visibility="Collapsed"
                                CornerRadius="{DynamicResource FluentBorderRadiusMedium}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-0.33" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="{DynamicResource FluentCompoundBrandBackgroundColor}" Offset="0" />
                                    <GradientStop Color="{DynamicResource FluentCompoundBrandBackgroundColor}" Offset="0.33" />
                                    <GradientStop Color="Transparent" Offset="0.33" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="IndeterminateBar" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateSlide">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateBar"
                                                         Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.33" To="1" Duration="0:0:3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="IndeterminateSlide" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
