<!--
    Overlay on Playnite Default/DefaultControls/RadioButton.xaml.
    Fluent Radio: 16px transparent circle with a colorNeutralStrokeAccessible edge; checked = colorCompoundBrandStroke
    edge and a colorCompoundBrandForeground1 dot.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FluentNeutralForeground1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentNeutralStrokeAccessibleBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FluentFocusOutline}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="BulletBorder"
                                         Fill="Transparent"
                                         Stroke="{TemplateBinding BorderBrush}"
                                         StrokeThickness="{DynamicResource EllipseBorderThickness}" />
                                <Ellipse x:Name="CheckIcon" Width="10" Height="10" Visibility="Collapsed"
                                         Fill="{DynamicResource FluentCompoundBrandBackgroundBrush}" />
                            </Grid>
                        </BulletDecorator.Bullet>
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Label" RecognizesAccessKey="True" Margin="8,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter Property="Margin" Value="0" TargetName="Label" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource FluentNeutralStrokeAccessibleHoverBrush}" TargetName="BulletBorder" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Setter Property="Stroke" Value="{DynamicResource FluentCompoundBrandStrokeBrush}" TargetName="BulletBorder" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
