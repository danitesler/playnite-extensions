<!--
    Fluent kit override of Shadcn/Desktop/DefaultControls/TextBox.xaml.
    Fluent Input (outline appearance): colorNeutralBackground1 fill, 1px colorNeutralStroke1 edge with a
    colorNeutralStrokeAccessible bottom, radius borderRadiusMedium; focus draws a 2px colorCompoundBrandStroke
    underline that grows from the center.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ShadcnPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ShadcnInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnInputBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ShadcnInputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ShadcnRadiusMd}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <!-- Bottom edge in the lighter accessible stroke; the corner radius curves its ends like CSS. -->
                        <Border x:Name="Underline" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                BorderThickness="0,0,0,1" CornerRadius="{DynamicResource ShadcnRadiusMd}"
                                BorderBrush="{DynamicResource ShadcnStrongBorderBrush}" />
                        <!-- Focus: 2px compound-brand line that grows from the center (Fluent ::after scaleX). -->
                        <Border x:Name="FocusLine" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                BorderThickness="0,0,0,2" CornerRadius="{DynamicResource ShadcnRadiusMd}"
                                BorderBrush="{DynamicResource ShadcnPrimaryBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ShadcnRingBrush}" TargetName="Underline" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusLine" To="1" Duration="0:0:0.2"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusLine" To="0" Duration="0:0:0.1"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless text box for hosts that draw their own chrome (editable ComboBox). -->
    <Style x:Key="ShadcnBareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ShadcnPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
