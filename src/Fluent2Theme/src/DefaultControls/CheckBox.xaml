<!--
    Overlay on Playnite Default/DefaultControls/CheckBox.xaml.
    Fluent Checkbox: 16px, borderRadiusSmall, transparent with a colorNeutralStrokeAccessible edge; checked and
    mixed fill with colorCompoundBrandBackground and a colorNeutralForegroundInverted mark.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FluentNeutralForeground1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentNeutralStrokeAccessibleBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FluentFocusOutline}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Border x:Name="Box" DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center"
                                    CornerRadius="{DynamicResource FluentBorderRadiusSmall}" SnapsToDevicePixels="True"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Background="Transparent">
                                <Grid>
                                    <Path x:Name="CheckIcon" Visibility="Collapsed" Width="9" Height="7" Stretch="Fill"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M0,3.5 L3,6.5 L9,0"
                                          Stroke="{DynamicResource FluentNeutralForegroundInvertedBrush}" StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Rectangle x:Name="IndeterminateIcon" Visibility="Collapsed" Width="8" Height="2"
                                               RadiusX="1" RadiusY="1"
                                               Fill="{DynamicResource FluentNeutralForegroundInvertedBrush}" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="Label" DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="8,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter Property="Margin" Value="0" TargetName="Label" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FluentNeutralStrokeAccessibleHoverBrush}" TargetName="Box" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon" />
                            <Setter Property="Background" Value="{DynamicResource FluentCompoundBrandBackgroundBrush}" TargetName="Box" />
                            <Setter Property="BorderBrush" Value="{DynamicResource FluentCompoundBrandStrokeBrush}" TargetName="Box" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Setter Property="Background" Value="{DynamicResource FluentCompoundBrandBackgroundBrush}" TargetName="Box" />
                            <Setter Property="BorderBrush" Value="{DynamicResource FluentCompoundBrandStrokeBrush}" TargetName="Box" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
