<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    Fluent SearchBox (outline, medium): the Input chrome of DefaultControls/TextBox.xaml (colorNeutralBackground1
    fill, colorNeutralStroke1 edge, accessible-stroke bottom, 2px brand focus line growing from the center) with a
    20px search icon before the text and a dismiss icon after it.
    Playnite's code hides PART_SeachIcon while the box has focus or text, so it carries the "Search" placeholder.
    ShowImage="False" (filter panel fields) drops the icon. PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon
    are Playnite's parts (all three must exist).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource FluentNeutralBackground1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentNeutralStroke1Brush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource FluentStrokeWidthThin}" />
        <Setter Property="Foreground" Value="{DynamicResource FluentNeutralForeground1Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Chrome" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource FluentBorderRadiusMedium}">
                            <Grid>
                                <ContentControl x:Name="Glyph" Margin="10,0,0,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                                Foreground="{DynamicResource FluentNeutralForeground3Brush}"
                                                ContentTemplate="{DynamicResource SearchTextIconTemplate}" />
                                <TextBlock x:Name="PART_SeachIcon" Margin="36,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource BaseTextBlockStyle}"
                                           Foreground="{DynamicResource FluentNeutralForeground3Brush}"
                                           Text="{DynamicResource LOCSearchLabel}" />
                                <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource FluentBareTextBox}"
                                         VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                         Padding="34,0,34,0" />
                                <ContentControl x:Name="PART_ClearTextIcon" Margin="0,0,8,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                                Background="Transparent"
                                                Foreground="{DynamicResource FluentNeutralForeground3Brush}"
                                                ContentTemplate="{DynamicResource ClearTextIconTemplate}" />
                            </Grid>
                        </Border>
                        <Border x:Name="Underline" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                BorderThickness="0,0,0,1" CornerRadius="{DynamicResource FluentBorderRadiusMedium}"
                                BorderBrush="{DynamicResource FluentNeutralStrokeAccessibleBrush}" />
                        <Border x:Name="FocusLine" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                BorderThickness="0,0,0,2" CornerRadius="{DynamicResource FluentBorderRadiusMedium}"
                                BorderBrush="{DynamicResource FluentCompoundBrandStrokeBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FluentNeutralStrokeAccessibleHoverBrush}" TargetName="Underline" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusLine" To="1" Duration="0:0:0.2"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusLine" To="0" Duration="0:0:0.1"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glyph" />
                            <Setter Property="Padding" Value="10,0,34,0" TargetName="PART_TextInpuText" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
