<!--
    Overlay on Playnite Default/DerivedStyles/HighlightBorder.xaml.
    Playnite templates this theme does not replace still use this border. Fluent Input edge: colorNeutralStroke1,
    colorNeutralStroke1Hover under the pointer, colorCompoundBrandStroke when focused, borderRadiusMedium.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="HighlightBorder" TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="CornerRadius" Value="{DynamicResource FluentBorderRadiusMedium}" />
        <Setter Property="BorderThickness" Value="{DynamicResource FluentStrokeWidthThin}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentNeutralStroke1Brush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FluentNeutralStroke1HoverBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FluentCompoundBrandStrokeBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
