<!--
    Overlay on Playnite Default/DerivedStyles/DetailsViewItemStyle.xaml (rows of the details view game list).
    Fluent TableRow (react-table, subtle): rows inset by 8px, borderRadiusMedium, colorSubtleBackgroundHover under the
    pointer, colorSubtleBackgroundSelected when selected, instead of Playnite's 5px primary edge and primary text.
    Text is colorNeutralForeground1 for installed games and colorNeutralForeground3 for the rest.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource FluentNeutralForeground3Brush}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Margin" Value="8,1,8,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent"
                            CornerRadius="{DynamicResource FluentBorderRadiusMedium}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource FluentNeutralForeground1Brush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource FluentSubtleBackgroundHoverBrush}" TargetName="Row" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource FluentSubtleBackgroundSelectedBrush}" TargetName="Row" />
                            <Setter Property="Foreground" Value="{DynamicResource FluentNeutralForeground1Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
