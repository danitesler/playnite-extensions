<!--
    Overlay on Playnite Default/CustomControls/TrayContextMenu.xaml. Tray icon menu: the Chakra Menu content of
    DefaultControls/ContextMenu.xaml, which Playnite loads earlier, so the StaticResource resolves to it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TrayContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />
</ResourceDictionary>
