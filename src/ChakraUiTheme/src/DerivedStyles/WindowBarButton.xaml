<!--
    Overlay on Playnite Default/DerivedStyles/WindowBarButton.xaml (title bars of dialogs; the main window uses
    ChakraWindowButton in DerivedStyles/MainWindowStyle.xaml).
    Chakra IconButton, "ghost" variant, drawn with lucide icons (Media.xaml) instead of Marlett: fg.muted at rest,
    gray.subtle behind fg on hover, radius l2; close turns into the red "solid" pair (red.solid, red.contrast).
    Playnite's window templates set Content to the Marlett character ("0" minimize, "1" maximize, "2" restore,
    "r" close); the template maps it to an icon. The buttons stay compact for the 25px title band of dialogs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="WindowBarButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ChakraFgMutedBrush}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="2,0,2,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ChakraRadiiL2}">
                        <!-- FontSize carries the icon size. -->
                        <ContentPresenter x:Name="Glyph"
                                          Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{DynamicResource ChakraIconWindowClose}"
                                          ContentTemplate="{DynamicResource ChakraIconTemplate}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="0">
                            <Setter Property="Content" Value="{DynamicResource ChakraIconWindowMinimize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Content" Value="{DynamicResource ChakraIconWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Content" Value="{DynamicResource ChakraIconWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ChakraFgBrush}" />
                <Setter Property="Background" Value="{DynamicResource ChakraGraySubtleBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="Content" Value="r" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource ChakraRedContrastBrush}" />
                <Setter Property="Background" Value="{DynamicResource ChakraRedSolidBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
