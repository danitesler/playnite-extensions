<!--
    Overlay on Playnite Default/DerivedStyles/HighlightBorder.xaml.
    Playnite templates this theme does not replace (ListView, RichTextBox, DatePicker, PathSelectionBox, ComboBoxList)
    still wrap their fields in this border. It becomes the Chakra Input "subtle" chrome: bg.muted fill inside a
    transparent 1px border, radius l2, a colorPalette.focusRing edge while focus is inside, no hover state. Hosts
    that set their own Background keep it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="HighlightBorder" TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="CornerRadius" Value="{DynamicResource ChakraRadiiL2}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource ChakraBgMutedBrush}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ChakraColorPaletteFocusRingBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
