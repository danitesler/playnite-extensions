<!--
    Overlay on Playnite Default/DerivedStyles/HighlightBorder.xaml.
    Playnite templates the kit does not replace still use this border; give them input chrome and a ring on
    hover/focus instead of the default cyan.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="HighlightBorder" TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnFieldRadius}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ShadcnFieldBorderThickness}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnInputBorderBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ShadcnRingBrush}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ShadcnRingBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
