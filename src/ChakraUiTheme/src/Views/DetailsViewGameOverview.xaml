<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details mode, right pane).
    A Chakra UI dashboard page (Chakra's product and stats templates), 32px padding (spacing 8), max 1100px.
    Header, HStack gap 6: the cover (Playnite's cover height setting) clipped to radius l3, then a VStack of platform
    Badges (subtle, brand palette), the name as a Heading 3xl (bold) with the game icon, and the actions: solid Play
    (or Install), subtle Button More, subtle IconButton Edit (40px, 20px lucide pencil).
    StatGroup: one row of Stat cards (bg.panel, radius l3, p-4): StatLabel in fg.muted, StatValueText at textStyle
    2xl semibold, for time played, last played and completion status; a hidden stat gives its space to the others.
    Below, the description and notes under Heading lg titles, and a Details Card (GroupBox) with a horizontal DataList:
    120px labels in fg.muted, values beside them; genres as Badges.
    No background art. Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}">
                        <StackPanel Margin="32,32,32,40" MaxWidth="1100">
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </StackPanel.Resources>

                            <!-- Header: HStack gap 6 -->
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Margin="0,0,24,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <Grid.CacheMode>
                                        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                    </Grid.CacheMode>
                                    <Grid>
                                        <Grid.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=CoverShape}" />
                                        </Grid.OpacityMask>
                                        <Border x:Name="CoverShape" CornerRadius="{DynamicResource CornerRadiusLarge}" Background="{DynamicResource ExpanderBackgroundBrush}" />
                                        <Image x:Name="PART_ImageCover" Stretch="Uniform" StretchDirection="Both" Height="{Settings GameDetailsCoverHeight}"
                                               RenderOptions.BitmapScalingMode="Fant" />
                                    </Grid>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0"
                                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                        <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                        <Grid HorizontalAlignment="Left">
                                            <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                            <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                        </Grid>
                                        <Button x:Name="PART_ButtonMoreActions" Margin="8,0,0,0" Content="{DynamicResource LOCMoreAction}" />
                                        <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Focusable="False" Margin="8,0,0,0">
                                            <ContentPresenter Width="20" Height="20"
                                                              Content="{DynamicResource IconEdit}"
                                                              ContentTemplate="{DynamicResource IconTemplate}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <!-- StatGroup: one row of Stat cards -->
                            <UniformGrid Rows="1" Margin="0,32,-16,0">
                                <Border x:Name="PART_ElemPlayTime" Margin="0,0,16,0" Padding="16"
                                        Background="{DynamicResource ExpanderBackgroundBrush}" CornerRadius="{DynamicResource CornerRadiusLarge}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSize}"
                                                   Foreground="{DynamicResource TextBrushDarker}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock x:Name="PART_TextPlayTime" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PART_ElemLastPlayed" Margin="0,0,16,0" Padding="16"
                                        Background="{DynamicResource ExpanderBackgroundBrush}" CornerRadius="{DynamicResource CornerRadiusLarge}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSize}"
                                                   Foreground="{DynamicResource TextBrushDarker}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock x:Name="PART_TextLastActivity" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PART_ElemCompletionStatus" Margin="0,0,16,0" Padding="16"
                                        Background="{DynamicResource ExpanderBackgroundBrush}" CornerRadius="{DynamicResource CornerRadiusLarge}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSize}"
                                                   Foreground="{DynamicResource TextBrushDarker}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Margin="0,32,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="240" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="340" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel x:Name="PART_ElemDescription">
                                        <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" FontSize="{DynamicResource GroupBoxHeaderFontSize}"
                                                   FontWeight="SemiBold" Margin="0,0,0,12" />
                                        <HtmlTextView x:Name="PART_HtmlDescription"
                                                      TextElement.Foreground="{DynamicResource TextBrush}"
                                                      Tag="{DynamicResource GlyphBrush}"
                                                      HtmlFontSize="{DynamicResource FontSize}"
                                                      HtmlFontFamily="{DynamicResource FontFamily}"
                                                      HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                      LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                      pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                    </StackPanel>
                                    <StackPanel x:Name="PART_ElemNotes" Margin="0,32,0,0">
                                        <TextBlock Text="{DynamicResource LOCNotesLabel}" FontSize="{DynamicResource GroupBoxHeaderFontSize}"
                                                   FontWeight="SemiBold" Margin="0,0,0,12" />
                                        <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                 Background="{DynamicResource ControlBackgroundBrush}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                                <GroupBox Grid.Column="2" VerticalAlignment="Top" Header="{DynamicResource LOCGameDetails}">
                                    <StackPanel Margin="0,-6,0,-6">
                                        <Grid x:Name="PART_ElemGenres" Margin="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource LOCGenresLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                            <ItemsControl Grid.Column="1" x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,2,0,-8">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Grid>
                                        <Grid x:Name="PART_ElemDevelopers" Margin="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource LOCDeveloperLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                            <ItemsControl Grid.Column="1" x:Name="PART_ItemsDevelopers" />
                                        </Grid>
                                        <Grid x:Name="PART_ElemPublishers" Margin="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource LOCPublisherLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                            <ItemsControl Grid.Column="1" x:Name="PART_ItemsPublishers" />
                                        </Grid>
                                        <Grid x:Name="PART_ElemReleaseDate" Margin="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                            <Button Grid.Column="1" x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                        </Grid>
                                        <Grid x:Name="PART_ElemLibrary" Margin="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                            <Button Grid.Column="1" x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                        </Grid>
                                        <Grid x:Name="PART_ElemLinks" Margin="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource LOCLinksLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                            <ItemsControl Grid.Column="1" x:Name="PART_ItemsLinks" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
