<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml (grid mode, side panel).
    The Chakra dashboard stacked for a narrow column (16px gutters): the cover clipped to radius l3 (max 280px),
    platform Badges, the name as a Heading xl (bold) with the icon, the actions (solid Play or Install filling the
    width, subtle More, subtle IconButton Edit), Stat cards two per row (bg.panel, radius l3, p-4; StatValueText 2xl
    semibold), a Details Card with a vertical DataList (label in fg.muted over the value; genres as Badges), then the
    description and notes under Heading lg titles.
    The panel edge follows Playnite's panel settings. Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <DockPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DockPanel.Resources>

                            <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,12,12,0"
                                    Content="r" FontFamily="Marlett"
                                    Style="{DynamicResource SimpleButton}"
                                    Command="{MainViewModel CloseGameSideBarCommand}" />

                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCErrorNoGameSelected}"
                                       Margin="16,24,16,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrushDarker}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,0,16,24">
                                        <Grid HorizontalAlignment="Center" Margin="0,0,0,16" Tag="{DynamicResource ShowCoverImage}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                            <DataTrigger.Value>
                                                                <sys:Boolean>False</sys:Boolean>
                                                            </DataTrigger.Value>
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.CacheMode>
                                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                            </Grid.CacheMode>
                                            <Grid>
                                                <Grid.OpacityMask>
                                                    <VisualBrush Visual="{Binding ElementName=CoverShape}" />
                                                </Grid.OpacityMask>
                                                <Border x:Name="CoverShape" CornerRadius="{DynamicResource CornerRadiusLarge}" Background="{DynamicResource ExpanderBackgroundBrush}" />
                                                <Image x:Name="PART_ImageCover" Stretch="Uniform" StretchDirection="Both" MaxHeight="280"
                                                       RenderOptions.BitmapScalingMode="Fant" />
                                            </Grid>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                        <DockPanel Margin="0,4,0,0">
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeLarger}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Margin="8,0,0,0" Content="{DynamicResource LOCMoreAction}" />
                                            <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Focusable="False" Margin="8,0,0,0">
                                                <ContentPresenter Width="20" Height="20"
                                                                  Content="{DynamicResource IconEdit}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>

                                        <Grid x:Name="OverviewLayoutGrid" Tag="{DynamicResource OverviewDetailsAsTab}" Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <TabControl x:Name="OverviewTabs" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                        SelectedIndex="0" VerticalAlignment="Top" Margin="0,0,0,12">
                                                <TabControl.Style>
                                                    <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=OverviewLayoutGrid}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabControl.Style>
                                                <TabItem Header="{DynamicResource LOCGameDescriptionTitle}" />
                                                <TabItem Header="{DynamicResource LOCGameDetails}" />
                                            </TabControl>

                                            <StackPanel x:Name="DescriptionPanel" Grid.Row="1" Grid.Column="0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Tag, ElementName=OverviewLayoutGrid}" Value="True" />
                                                                    <Condition Binding="{Binding SelectedIndex, ElementName=OverviewTabs}" Value="1" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <StackPanel x:Name="PART_ElemDescription">
                                                    <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" FontSize="{DynamicResource GroupBoxHeaderFontSize}"
                                                               FontWeight="SemiBold" Margin="0,0,0,12" />
                                                    <HtmlTextView x:Name="PART_HtmlDescription"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"
                                                                  Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </StackPanel>
                                                <GroupBox Margin="0,24,0,0" Header="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}"
                                                          Visibility="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                </GroupBox>
                                                <StackPanel x:Name="PART_ElemNotes" Margin="0,24,0,0">
                                                    <TextBlock Text="{DynamicResource LOCNotesLabel}" FontSize="{DynamicResource GroupBoxHeaderFontSize}"
                                                               FontWeight="SemiBold" Margin="0,0,0,12" />
                                                    <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                             Background="{DynamicResource ControlBackgroundBrush}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel x:Name="DetailsPanel" Grid.Row="1">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Grid.Column" Value="1" />
                                                        <Setter Property="Width" Value="260" />
                                                        <Setter Property="Margin" Value="16,0,0,0" />
                                                        <Setter Property="VerticalAlignment" Value="Top" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=OverviewLayoutGrid}" Value="True">
                                                                <Setter Property="Grid.Column" Value="0" />
                                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                <Setter Property="Width" Value="Auto" />
                                                                <Setter Property="Margin" Value="0" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Tag, ElementName=OverviewLayoutGrid}" Value="True" />
                                                                    <Condition Binding="{Binding SelectedIndex, ElementName=OverviewTabs}" Value="0" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <UniformGrid Columns="2" Margin="0,0,-8,0">
                                                    <Border x:Name="PART_ElemPlayTime" Margin="0,0,8,8" Padding="16"
                                                            Background="{DynamicResource ExpanderBackgroundBrush}" CornerRadius="{DynamicResource CornerRadiusLarge}">
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSize}"
                                                                       Foreground="{DynamicResource TextBrushDarker}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            <TextBlock x:Name="PART_TextPlayTime" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="PART_ElemLastPlayed" Margin="0,0,8,8" Padding="16"
                                                            Background="{DynamicResource ExpanderBackgroundBrush}" CornerRadius="{DynamicResource CornerRadiusLarge}">
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSize}"
                                                                       Foreground="{DynamicResource TextBrushDarker}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            <TextBlock x:Name="PART_TextLastActivity" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="PART_ElemCompletionStatus" Margin="0,0,8,8" Padding="16"
                                                            Background="{DynamicResource ExpanderBackgroundBrush}" CornerRadius="{DynamicResource CornerRadiusLarge}">
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSize}"
                                                                       Foreground="{DynamicResource TextBrushDarker}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>

                                                <GroupBox Margin="0,8,0,0" Header="{DynamicResource LOCGameDetails}">
                                                    <StackPanel Margin="0,-6,0,-6">
                                                        <StackPanel x:Name="PART_ElemGenres" Margin="0,6,0,6">
                                                            <TextBlock Text="{DynamicResource LOCGenresLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,2,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemDevelopers" Margin="0,6,0,6">
                                                            <TextBlock Text="{DynamicResource LOCDeveloperLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsDevelopers" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemPublishers" Margin="0,6,0,6">
                                                            <TextBlock Text="{DynamicResource LOCPublisherLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsPublishers" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemReleaseDate" Margin="0,6,0,6">
                                                            <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemLibrary" Margin="0,6,0,6">
                                                            <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemLinks" Margin="0,6,0,6">
                                                            <TextBlock Text="{DynamicResource LOCLinksLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsLinks" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </GroupBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
