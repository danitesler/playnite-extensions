<!--
    Chakra UI Theme: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from
    tokens.css (Chakra's CSS variables) and writes the result to the build as Constants.xaml.

    Keys follow Chakra's token paths: colors.bg.panel is ChakraBgPanelColor / ChakraBgPanelBrush, the virtual
    colorPalette.solid is ChakraColorPaletteSolid, radii.l2 is ChakraRadiiL2. Opacity modifiers keep Chakra's
    notation as a suffix: colorPalette.solid/90 is ChakraColorPaletteSolid90.

    Theme XAML reads these keys with DynamicResource only: Playnite parses each theme file on its own before merging.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): textStyle xs / sm / md ... Chakra's fonts.body is Inter with a system fallback,
         which is Segoe UI on Windows; Inter is not bundled. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys) -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:chakra-radii-l2}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Semantic radii: l1 (xs), l2 (sm), l3 (md), full -->
    <CornerRadius x:Key="ChakraRadiiL1">{{px:chakra-radii-l1}}</CornerRadius>
    <CornerRadius x:Key="ChakraRadiiL2">{{px:chakra-radii-l2}}</CornerRadius>
    <CornerRadius x:Key="ChakraRadiiL3">{{px:chakra-radii-l3}}</CornerRadius>
    <CornerRadius x:Key="ChakraRadiiFull">9999</CornerRadius>

    <!-- Semantic colors -->
    <Color x:Key="ChakraBgColor">{{chakra-colors-bg}}</Color>
    <Color x:Key="ChakraBgMutedColor">{{chakra-colors-bg-muted}}</Color>
    <Color x:Key="ChakraBgEmphasizedColor">{{chakra-colors-bg-emphasized}}</Color>
    <Color x:Key="ChakraBgInvertedColor">{{chakra-colors-bg-inverted}}</Color>
    <Color x:Key="ChakraBgPanelColor">{{chakra-colors-bg-panel}}</Color>
    <Color x:Key="ChakraFgColor">{{chakra-colors-fg}}</Color>
    <Color x:Key="ChakraFgMutedColor">{{chakra-colors-fg-muted}}</Color>
    <Color x:Key="ChakraFgInvertedColor">{{chakra-colors-fg-inverted}}</Color>
    <Color x:Key="ChakraFgErrorColor">{{chakra-colors-fg-error}}</Color>
    <Color x:Key="ChakraBorderColor">{{chakra-colors-border}}</Color>
    <Color x:Key="ChakraBorderEmphasizedColor">{{chakra-colors-border-emphasized}}</Color>

    <!-- gray and red palettes (Button, IconButton, scrollbar; the close button and the notification Badge) -->
    <Color x:Key="ChakraGrayFgColor">{{chakra-colors-gray-fg}}</Color>
    <Color x:Key="ChakraGraySubtleColor">{{chakra-colors-gray-subtle}}</Color>
    <Color x:Key="ChakraGrayMutedColor">{{chakra-colors-gray-muted}}</Color>
    <Color x:Key="ChakraGraySolidColor">{{chakra-colors-gray-solid}}</Color>
    <Color x:Key="ChakraRedContrastColor">{{chakra-colors-red-contrast}}</Color>
    <Color x:Key="ChakraRedSolidColor">{{chakra-colors-red-solid}}</Color>

    <!-- colorPalette (teal): the brand palette -->
    <Color x:Key="ChakraColorPaletteContrastColor">{{chakra-colors-color-palette-contrast}}</Color>
    <Color x:Key="ChakraColorPaletteFgColor">{{chakra-colors-color-palette-fg}}</Color>
    <Color x:Key="ChakraColorPaletteSubtleColor">{{chakra-colors-color-palette-subtle}}</Color>
    <Color x:Key="ChakraColorPaletteMutedColor">{{chakra-colors-color-palette-muted}}</Color>
    <Color x:Key="ChakraColorPaletteSolidColor">{{chakra-colors-color-palette-solid}}</Color>
    <Color x:Key="ChakraColorPaletteFocusRingColor">{{chakra-colors-color-palette-focus-ring}}</Color>

    <!-- Opacity modifiers the recipes use -->
    <Color x:Key="ChakraColorPaletteSolid90Color">{{chakra-colors-color-palette-solid/90}}</Color>          <!-- Button solid hover -->
    <Color x:Key="ChakraColorPaletteFocusRing50Color">{{chakra-colors-color-palette-focus-ring/50}}</Color> <!-- Slider thumb focus ring -->
    <Color x:Key="ChakraBgEmphasized60Color">{{chakra-colors-bg-emphasized/60}}</Color>                    <!-- highlighted menu / select / listbox items -->
    <Color x:Key="ChakraBgEmphasized72Color">{{chakra-colors-bg-emphasized/72}}</Color>                    <!-- Slider outline track -->

    <SolidColorBrush x:Key="ChakraBgBrush" Color="{DynamicResource ChakraBgColor}" />
    <SolidColorBrush x:Key="ChakraBgMutedBrush" Color="{DynamicResource ChakraBgMutedColor}" />
    <SolidColorBrush x:Key="ChakraBgEmphasizedBrush" Color="{DynamicResource ChakraBgEmphasizedColor}" />
    <SolidColorBrush x:Key="ChakraBgInvertedBrush" Color="{DynamicResource ChakraBgInvertedColor}" />
    <SolidColorBrush x:Key="ChakraBgPanelBrush" Color="{DynamicResource ChakraBgPanelColor}" />
    <SolidColorBrush x:Key="ChakraFgBrush" Color="{DynamicResource ChakraFgColor}" />
    <SolidColorBrush x:Key="ChakraFgMutedBrush" Color="{DynamicResource ChakraFgMutedColor}" />
    <SolidColorBrush x:Key="ChakraFgInvertedBrush" Color="{DynamicResource ChakraFgInvertedColor}" />
    <SolidColorBrush x:Key="ChakraFgErrorBrush" Color="{DynamicResource ChakraFgErrorColor}" />
    <SolidColorBrush x:Key="ChakraBorderBrush" Color="{DynamicResource ChakraBorderColor}" />
    <SolidColorBrush x:Key="ChakraBorderEmphasizedBrush" Color="{DynamicResource ChakraBorderEmphasizedColor}" />
    <SolidColorBrush x:Key="ChakraGrayFgBrush" Color="{DynamicResource ChakraGrayFgColor}" />
    <SolidColorBrush x:Key="ChakraGraySubtleBrush" Color="{DynamicResource ChakraGraySubtleColor}" />
    <SolidColorBrush x:Key="ChakraGrayMutedBrush" Color="{DynamicResource ChakraGrayMutedColor}" />
    <SolidColorBrush x:Key="ChakraGraySolidBrush" Color="{DynamicResource ChakraGraySolidColor}" />
    <SolidColorBrush x:Key="ChakraRedContrastBrush" Color="{DynamicResource ChakraRedContrastColor}" />
    <SolidColorBrush x:Key="ChakraRedSolidBrush" Color="{DynamicResource ChakraRedSolidColor}" />
    <SolidColorBrush x:Key="ChakraColorPaletteContrastBrush" Color="{DynamicResource ChakraColorPaletteContrastColor}" />
    <SolidColorBrush x:Key="ChakraColorPaletteFgBrush" Color="{DynamicResource ChakraColorPaletteFgColor}" />
    <SolidColorBrush x:Key="ChakraColorPaletteSubtleBrush" Color="{DynamicResource ChakraColorPaletteSubtleColor}" />
    <SolidColorBrush x:Key="ChakraColorPaletteMutedBrush" Color="{DynamicResource ChakraColorPaletteMutedColor}" />
    <SolidColorBrush x:Key="ChakraColorPaletteSolidBrush" Color="{DynamicResource ChakraColorPaletteSolidColor}" />
    <SolidColorBrush x:Key="ChakraColorPaletteFocusRingBrush" Color="{DynamicResource ChakraColorPaletteFocusRingColor}" />
    <SolidColorBrush x:Key="ChakraColorPaletteSolid90Brush" Color="{DynamicResource ChakraColorPaletteSolid90Color}" />
    <SolidColorBrush x:Key="ChakraColorPaletteFocusRing50Brush" Color="{DynamicResource ChakraColorPaletteFocusRing50Color}" />
    <SolidColorBrush x:Key="ChakraBgEmphasized60Brush" Color="{DynamicResource ChakraBgEmphasized60Color}" />
    <SolidColorBrush x:Key="ChakraBgEmphasized72Brush" Color="{DynamicResource ChakraBgEmphasized72Color}" />

    <!--
        Playnite palette keys, mapped to Chakra's semantic tokens. Every Playnite view and control the theme does not
        restyle reads these. GlyphColor = colorPalette.solid and TextColorDark = colorPalette.contrast: Playnite
        always pairs those two (selected rows, play button).
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{chakra-colors-fg}}</Color>
    <Color x:Key="TextColorDarker">{{chakra-colors-fg-muted}}</Color>
    <Color x:Key="TextColorDark">{{chakra-colors-color-palette-contrast}}</Color>
    <Color x:Key="MainColor">{{chakra-colors-gray-subtle}}</Color>
    <Color x:Key="MainColorDark">{{chakra-colors-bg-panel}}</Color>
    <Color x:Key="HoverColor">{{chakra-colors-bg-emphasized}}</Color>
    <Color x:Key="GlyphColor">{{chakra-colors-color-palette-solid}}</Color>
    <Color x:Key="HighlightGlyphColor">{{chakra-colors-color-palette-solid/50}}</Color>
    <Color x:Key="PopupBackgroundColor">{{chakra-colors-bg-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{chakra-colors-border}}</Color>
    <Color x:Key="BackgroundToneColor">{{chakra-colors-bg-panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>     <!-- no frame around covers -->
    <Color x:Key="PanelSeparatorColor">#00000000</Color>         <!-- no lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{chakra-colors-border}}</Color>
    <Color x:Key="DataChangeNotifColor">{{chakra-colors-fg-warning}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{DynamicResource ChakraBorderEmphasizedColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource ChakraBgEmphasizedColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{DynamicResource ChakraBgInvertedColor}" />   <!-- Tooltip bg.inverted -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource ChakraBgPanelColor}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="Transparent" />                              <!-- Checkbox solid: no fill until checked -->
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{chakra-colors-fg-success}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{DynamicResource ChakraFgErrorColor}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{chakra-colors-fg-warning}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource ChakraFgErrorColor}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{DynamicResource ChakraBgPanelColor}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{DynamicResource ChakraBgColor}" />
</ResourceDictionary>
