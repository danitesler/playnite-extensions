<!--
    Overlay on Playnite Default/DefaultControls/PasswordBox.xaml.
    Chakra Input, "subtle" variant, size md: bg.muted fill inside a transparent 1px border, radius l2, h-10 / px-3
    (ChakraInputPadding). focusVisibleRing="inside": focus paints a 2px colorPalette.focusRing edge over the control,
    no outer halo.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ChakraFgBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ChakraColorPaletteSolidBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ChakraFgBrush}" />
        <Setter Property="Background" Value="{DynamicResource ChakraBgMutedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ChakraInputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Grid>
                        <Border x:Name="Border" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ChakraRadiiL2}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <Border x:Name="FocusRing" BorderThickness="2" Visibility="Collapsed"
                                IsHitTestVisible="False" SnapsToDevicePixels="True"
                                CornerRadius="{DynamicResource ChakraRadiiL2}"
                                BorderBrush="{DynamicResource ChakraColorPaletteFocusRingBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ChakraColorPaletteFocusRingBrush}" TargetName="Border" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FocusRing" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
