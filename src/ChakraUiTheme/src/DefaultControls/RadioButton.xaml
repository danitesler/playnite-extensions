<!--
    Overlay on Playnite Default/DefaultControls/RadioButton.xaml.
    Chakra RadioGroup item, "solid" variant, size md: a 20px (boxSize 5) circle with a 1px border.emphasized edge;
    checked fills it with colorPalette.solid and draws the dot (scale 0.4, 8px) in colorPalette.contrast. The label
    sits 10px away (gap 2.5) at fontWeight medium. Keyboard focus is Chakra's outside ring (ChakraFocusRing).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ChakraFgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChakraBorderEmphasizedBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource ChakraFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Ellipse x:Name="Control" Fill="Transparent"
                                         Stroke="{TemplateBinding BorderBrush}"
                                         StrokeThickness="{DynamicResource EllipseBorderThickness}" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Visibility="Collapsed"
                                         Fill="{DynamicResource ChakraColorPaletteContrastBrush}" />
                            </Grid>
                        </BulletDecorator.Bullet>
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Label" RecognizesAccessKey="True" Margin="10,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter Property="Margin" Value="0" TargetName="Label" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Dot" />
                            <Setter Property="Fill" Value="{DynamicResource ChakraColorPaletteSolidBrush}" TargetName="Control" />
                            <Setter Property="Stroke" Value="{DynamicResource ChakraColorPaletteSolidBrush}" TargetName="Control" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
