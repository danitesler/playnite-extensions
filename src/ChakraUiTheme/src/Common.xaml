<!--
    Chakra kit override of Shadcn/Desktop/Common.xaml (the whole file is replaced, so PopupBorder is repeated).
    Chakra focusVisibleRing="outside": 2px solid colorPalette.focusRing outline, 2px offset.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnPopupRadius}" />
    </Style>

    <Style x:Key="ShadcnFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource ShadcnRadiusLg}"
                            BorderBrush="{DynamicResource ShadcnRingBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Control metrics for Chakra UI v3 (md sizes). Kit controls read these with DynamicResource, so each kit
        sets its design system's spacing here instead of replacing whole control files.
    -->
    <Thickness x:Key="ShadcnButtonPadding">16,10,16,10</Thickness> <!-- Button md: h-10, px-4 -->
    <Thickness x:Key="ShadcnInputPadding">12,9,12,9</Thickness> <!-- Input / Select md: h-10, px-3, inside a 1px border -->
    <CornerRadius x:Key="ShadcnPopupRadius">4</CornerRadius> <!-- Menu / Popover content rounded l2 -->
    <Thickness x:Key="ShadcnMenuPadding">6</Thickness> <!-- Menu content p-1.5 -->
    <Thickness x:Key="ShadcnMenuItemPadding">8,6,8,6</Thickness> <!-- Menu item px-2 py-1.5 -->
    <CornerRadius x:Key="ShadcnMenuItemRadius">2</CornerRadius> <!-- Menu item rounded l1 -->
    <Thickness x:Key="ShadcnListItemPadding">8,6,8,6</Thickness> <!-- Listbox / Combobox item px-2 py-1.5 -->
    <CornerRadius x:Key="ShadcnCardRadius">6</CornerRadius> <!-- Card rounded l3 -->
    <Thickness x:Key="ShadcnCardPadding">24</Thickness> <!-- Card md: card padding = spacing.6 -->
    <Thickness x:Key="ShadcnCardTitleMargin">0,0,0,24</Thickness> <!-- card body padding under the header -->
    <sys:Double x:Key="ShadcnIconSize">20</sys:Double> <!-- IconButton md icons: size 5 -->
    <Thickness x:Key="ShadcnTooltipPadding">10,4,10,4</Thickness> <!-- Tooltip px-2.5 py-1 -->
</ResourceDictionary>
