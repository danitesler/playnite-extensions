<!-- Overlay on Playnite Default/Common.xaml: only restyled keys live here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Popover content: bg.panel, rounded l3. Chakra lifts it with shadow lg; a 1px border edge stands in for it. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    </Style>

    <!-- focusVisibleRing="outside": 2px solid colorPalette.focusRing outline, 2px offset. WPF shows FocusVisualStyle
         for keyboard focus only, like :focus-visible. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource CornerRadiusLarge}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Recipe spacing at size md (Chakra's default size), keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">16,10,16,10</Thickness> <!-- button md: h-10, px-4, 1px transparent border -->
    <Thickness x:Key="InputPadding">12,9,12,9</Thickness> <!-- input / select trigger md: h-10, px-3, inside a 1px border -->
    <Thickness x:Key="MenuPadding">6</Thickness> <!-- menu content md: p-1.5 -->
    <Thickness x:Key="MenuItemPadding">8,6,8,6</Thickness> <!-- menu item md: px-2 py-1.5 -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness> <!-- select content md: p-1 -->
    <Thickness x:Key="ComboBoxItemPadding">8,6,8,6</Thickness> <!-- select item md: px-2 py-1.5 -->
    <Thickness x:Key="ListBoxItemPadding">8,6,8,6</Thickness> <!-- listbox item: px-2 py-1.5 -->
    <Thickness x:Key="GroupBoxPadding">24</Thickness> <!-- card md: card-padding = spacing.6 -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,24</Thickness> <!-- card body padding under the header -->
    <sys:Double x:Key="GroupBoxHeaderFontSize">18</sys:Double> <!-- card md title: textStyle lg -->
    <sys:Double x:Key="IconSize">20</sys:Double> <!-- button md _icon: size 5 -->
    <Thickness x:Key="TooltipPadding">10,4,10,4</Thickness> <!-- tooltip content: px-2.5 py-1 -->
</ResourceDictionary>
