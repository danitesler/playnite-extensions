<!--
    Overlay on Playnite Default/DefaultControls/Thumb.xaml.
    The implicit Thumb (splitters, custom controls): the bronze scroll thumb, lit gold while hovered or while its
    track has focus.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource ThumbBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Plate" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                            MinHeight="10" Margin="0" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ThumbHoverBrush}" TargetName="Plate" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Plate" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Track}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ThumbHoverBrush}" TargetName="Plate" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Plate" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
