<!--
    Overlay on Playnite Default/DefaultControls/ToggleButton.xaml.
    The same stone plate as Button. Checked is a pressed-in plate: sunken face, gold text, gold rim.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Outline" Background="{DynamicResource NormalBrushDark}"
                            BorderBrush="{DynamicResource NormalBrushDark}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Border x:Name="Rim" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Border x:Name="LitEdge" BorderBrush="{DynamicResource SelectedHoverBrush}" BorderThickness="0,1,0,0">
                                <Border x:Name="ShadedEdge" BorderBrush="{DynamicResource NormalBrushDark}" BorderThickness="0,0,0,1">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ToggleButtonCheckedBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBrushDark}" TargetName="LitEdge" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedHoverBrush}" TargetName="ShadedEdge" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
