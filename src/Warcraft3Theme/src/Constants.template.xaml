<!--
    Warcraft III Theme: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from
    tokens.css and writes the result to the build as Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo: Playnite's
    palette keys, then shared keys for roles Playnite has none for. Each placeholder names the token that plays the
    role, so the theme's own token names live in tokens.css and here only. Theme XAML reads the brushes (never the
    Color keys), so ThemeModifier edits reach every control.

    The look in one line: dark blue-grey stone plates, bronze-to-gold trim, parchment-white text with gold titles.
    Gold (GlyphBrush) is the one accent, the way Warcraft III's menus use it for every title, hover and selection.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). Friz Quadrata when installed, Palatino Linotype / Georgia otherwise. -->
    <sys:Double x:Key="FontSizeSmall">{{px:wc3-text-size-small}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:wc3-text-size}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:wc3-text-size-large}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:wc3-text-size-larger}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:wc3-text-size-largest}}</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:wc3-font-body|Georgia}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:wc3-font-mono|Consolas}}</FontFamily>

    <!-- Shape (Playnite keys). ControlCornerRadius is the plate radius: the interface is nearly square. -->
    <Thickness x:Key="PopupBorderThickness">{{px:wc3-trim-width}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:wc3-hairline}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:wc3-trim-width}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:wc3-radius-plate}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale: slot (icon frames, inset wells) and full (selection rings, round pips) -->
    <CornerRadius x:Key="CornerRadiusLarge">{{px:wc3-radius-slot}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:wc3-radius-round}}</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        MainColor is the stone plate (buttons, raised surfaces), MainColorDark the deep well behind panels.
        GlyphColor is menu gold, with TextColorDark the near-black used on gold fills.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{wc3-text-white}}</Color>
    <Color x:Key="TextColorDarker">{{wc3-text-dim}}</Color>
    <Color x:Key="TextColorDark">{{wc3-text-on-gold}}</Color>
    <Color x:Key="MainColor">{{wc3-stone-plate}}</Color>
    <Color x:Key="MainColorDark">{{wc3-stone-deep}}</Color>
    <Color x:Key="HoverColor">{{wc3-text-gold/18}}</Color>
    <Color x:Key="GlyphColor">{{wc3-text-gold}}</Color>
    <Color x:Key="HighlightGlyphColor">{{wc3-text-gold/53}}</Color>
    <Color x:Key="PopupBackgroundColor">{{wc3-stone-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{wc3-trim}}</Color>
    <Color x:Key="BackgroundToneColor">{{wc3-stone-raised}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{wc3-stone-abyss}}</Color>   <!-- the black well an icon sits in -->
    <Color x:Key="PanelSeparatorColor">{{wc3-trim-dark}}</Color>          <!-- trim lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{wc3-trim-dark}}</Color>
    <Color x:Key="DataChangeNotifColor">{{wc3-orange}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{wc3-trim}}" />                 <!-- bronze trim on controls -->
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{wc3-stone-deep}}" />      <!-- tooltips are the darkest plate -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{wc3-stone-plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{wc3-stone-abyss}}" />   <!-- unchecked well -->
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{wc3-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{wc3-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{wc3-text-gold}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{wc3-red}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{wc3-stone-panel}}" />     <!-- dialog panels -->
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{wc3-stone-deep}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->
    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{wc3-stone-abyss}}" />        <!-- the black behind the console frame -->
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{wc3-stone-deep}}" />       <!-- the play field the library sits on -->
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{wc3-stone-panel}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{wc3-stone-abyss}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{wc3-stone-plate}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{wc3-text-gold}}" />
    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{wc3-stone-plate-hover}}" />         <!-- lit stone plate -->
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{wc3-stone-bevel}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{wc3-text-gold-hover}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{wc3-text-gold/14}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{wc3-stone-plate-hover}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{wc3-stone-plate-hover}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{wc3-text-gold-hover}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{wc3-red-dark}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{wc3-text-white}}" />
    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{wc3-text-gold}}" />         <!-- menu button text is gold -->
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{wc3-stone-plate-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{wc3-stone-plate-pressed}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{wc3-trim}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{wc3-trim-dark}}" />  <!-- bronze plate for the default action -->
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{wc3-trim}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{wc3-text-gold-hover}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{wc3-stone-plate-pressed}}" />
    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{wc3-stone-abyss}}" />        <!-- inset well -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{wc3-trim-dark}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{wc3-trim}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{wc3-trim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{wc3-trim-shine}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{wc3-stone-abyss}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{wc3-trim-light}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{wc3-trim-shine}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{wc3-health}}" />       <!-- the green health bar -->
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{wc3-health-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{wc3-trim-dark}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{wc3-trim}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{wc3-stone-abyss}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{wc3-trim-dark}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{wc3-trim}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{wc3-text-gold}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{wc3-trim-light}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{wc3-stone-deep}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{wc3-text-gold-hover}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{wc3-green}}" />     <!-- the green selection ring around a selected unit -->
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{wc3-stone-plate-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{wc3-stone-plate-pressed}}" />
    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{wc3-trim-dark}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{wc3-text-white}}" />
</ResourceDictionary>
