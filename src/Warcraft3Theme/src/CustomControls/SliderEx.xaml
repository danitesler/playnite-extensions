<!--
    Overlay on Playnite Default/CustomControls/SliderEx.xaml.
    SliderEx is a Slider: the options-screen slider from DefaultControls/Slider.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SliderEx}" BasedOn="{StaticResource {x:Type Slider}}" />
</ResourceDictionary>
