<!--
    Overlay on Playnite Default/Views/TopPanel.xaml.
    The strip along the top of the in-game screen: a stone band with a bronze lower edge. From the left: the menu
    plate, the edit-well search box, the command-card buttons (view, sort, group, filter presets, view switches),
    the filter and notification plates, add-on items, and the global progress as a green health bar with its label.
    The right 110px stay clear for the caption buttons. PART_* names are Playnite's.
    Glyphs are the game-icons set in Media.xaml (Icon keys) drawn by IconTemplate in the item's foreground.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}"
                          TextElement.Foreground="{DynamicResource WarningBrush}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <!-- Top panel dropdowns (view settings, sort, group): the same plate as every menu. -->
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <!-- Filter plate: a stone plate with the funnel; when a filter is active (Tag True) the plate gets the label and
         turns gold-rimmed. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource NormalBrushDark}"
                            BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Height="34">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Margin="6,0,6,0" VerticalAlignment="Center">
                                <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconFilter}"
                                                  ContentTemplate="{DynamicResource IconTemplate}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource LOCFilterActiveLabel}"
                                           Style="{DynamicResource BaseTextBlockStyle}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Name="TextFilter" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Plate" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Notification plate: the bell with a red count pip, the game's alert color. Hidden with no notifications. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource NormalBrushDark}"
                            BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Height="34">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <ContentPresenter Width="20" Height="20" Content="{DynamicResource IconNotifications}"
                                                  ContentTemplate="{DynamicResource IconTemplate}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <Border CornerRadius="{DynamicResource CornerRadiusLarge}" MinWidth="15" Height="15"
                                        Margin="0,0,1,1" Background="{DynamicResource DangerBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Api Notifications.Count}" FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource DangerForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The search well: SearchBox at the top strip's height, up to 300px. -->
    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Width" Value="300" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Border Height="50" BorderBrush="{DynamicResource PopupBorderBrush}"
                            Background="{DynamicResource TopPanelBackgroundBrush}"
                            d:DesignWidth="1280"
                            d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0,0,0,2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Margin="8,0,110,0">
                            <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource MainMenuButton}"
                                    DockPanel.Dock="Left" Width="40" Height="34" Margin="0,0,10,0">
                                <ContentPresenter Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch"
                                       Margin="0,0,6,0" DockPanel.Dock="Left"
                                       Style="{DynamicResource TopPanelSearchBox}"
                                       WindowChrome.IsHitTestVisibleInChrome="True" />

                            <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" />

                            <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}"
                                      DockPanel.Dock="Left" VerticalAlignment="Center" />

                            <CheckBox x:Name="PART_ToggleNotifications"
                                      Style="{DynamicResource TopPanelNotificationsToggle}"
                                      DockPanel.Dock="Left" VerticalAlignment="Center" />

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="15,0,15,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,0">
                                <Grid MaxWidth="600" MinWidth="300" Height="22">
                                    <ProgressBar Name="PART_ProgressGlobal" />
                                    <TextBlock Name="PART_TextProgressText"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Style="{DynamicResource BaseTextBlockStyle}" Margin="5,0,5,0" />
                                </Grid>

                                <Button Name="PART_ButtonProgressCancel"
                                        Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Padding="10,3,10,3" Margin="6,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
