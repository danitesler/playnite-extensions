<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    Warcraft III frames everything in trim: a dark outline, a bronze-to-gold rim, then the stone face. Popups take the
    rim alone (a WPF popup is a layered window, so it keeps a plain 2px edge and no shadow).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Popup plate: panel stone inside a 2px bronze rim, square corners like the F10 game menu. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Keyboard focus: a thin bright-gold frame just inside the control's rim, like the highlighted menu button.
         WPF shows FocusVisualStyle for keyboard focus only. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="3" BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing, keyed by the Playnite control. Values follow the game's dialogs: roomy plates, tight lists. -->
    <Thickness x:Key="ButtonPadding">16,6,16,6</Thickness> <!-- menu plates: text sits well inside the rim -->
    <Thickness x:Key="InputPadding">8,5,8,5</Thickness> <!-- chat and edit boxes: an inset well -->
    <Thickness x:Key="MenuPadding">4</Thickness> <!-- game menu: 4px between the rim and the first plate -->
    <Thickness x:Key="MenuItemPadding">10,6,10,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6,10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">8,5,8,5</Thickness> <!-- map list rows -->
    <Thickness x:Key="GroupBoxPadding">12</Thickness> <!-- dialog panel body -->
    <Thickness x:Key="GroupBoxHeaderPadding">12,6,12,6</Thickness> <!-- panel title plate -->
    <Thickness x:Key="TooltipPadding">10,8,10,8</Thickness> <!-- tooltip: title line, then body, 10px inset -->
    <sys:Double x:Key="IconSize">20</sys:Double> <!-- command-card glyphs -->
</ResourceDictionary>
