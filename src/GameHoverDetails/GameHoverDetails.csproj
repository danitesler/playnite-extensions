<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <RootNamespace>GameHoverDetails</RootNamespace>
    <AssemblyName>GameHoverDetails</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.6.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="info\extension.yaml">
      <Link>extension.yaml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="info\icon.png">
      <Link>icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ====== 本地化字典文件（如需要） ====== -->
  <ItemGroup>
    <Content Include="Localization\**\*.xaml" Condition="Exists('Localization')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ====== Toolbox 自动打包 ====== -->
  <Target Name="ToolboxPack" AfterTargets="Build">
    <Exec Command="&quot;%25LOCALAPPDATA%25\Playnite\Toolbox.exe&quot; pack $(ProjectDir)$(OutDir) $(ProjectDir)bin" />
  </Target>
</Project>