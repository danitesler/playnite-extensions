<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <RootNamespace>GameHoverDetails</RootNamespace>
    <AssemblyName>GameHoverDetails</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.6.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="info\extension.yaml">
      <Link>extension.yaml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="info\icon.png">
      <Link>icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="fonts\LICENSE-Phosphor.txt">
      <Link>fonts\LICENSE-Phosphor.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="fonts\LICENSE-Unicons.txt">
      <Link>fonts\LICENSE-Unicons.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="fonts\LICENSE-HugeIcons.txt">
      <Link>fonts\LICENSE-HugeIcons.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="fonts\LICENSE-SketchyIcons.txt">
      <Link>fonts\LICENSE-SketchyIcons.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="fonts\NOTICE-SketchyIcons.txt">
      <Link>fonts\NOTICE-SketchyIcons.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="fonts\LICENSE-Iconsax.txt">
      <Link>fonts\LICENSE-Iconsax.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="fonts\LICENSE-PixelIconLibrary.txt">
      <Link>fonts\LICENSE-PixelIconLibrary.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="fonts\LICENSE-Pixelarticons.txt">
      <Link>fonts\LICENSE-Pixelarticons.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Localization\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="CopyIconFontFiles" AfterTargets="Build">
    <ItemGroup>
      <_IconFontFiles Include="$(MSBuildProjectDirectory)\fonts\*.ttf" />
    </ItemGroup>
    <Copy SourceFiles="@(_IconFontFiles)"
          DestinationFolder="$(OutputPath)fonts"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
