<UserControl x:Class="GameHoverDetails.GameHoverDetailsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:GameHoverDetails"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="760"
             DataContextChanged="UserControl_DataContextChanged"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolConverter x:Key="InvertBool" />
        <Style x:Key="SettingsFieldTitle" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SettingsFieldTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        </Style>
        <!-- Playnite themes often give ItemsControl a ScrollViewer; override so the Fields list only scrolls on the tab ScrollViewer. -->
        <Style x:Key="FieldsListNonScrollingItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <StackPanel IsItemsHost="True"
                                    Focusable="False"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsSectionDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Background" Value="{DynamicResource TextBrush}" />
            <Setter Property="Opacity" Value="0.22" />
        </Style>
        <Style x:Key="SettingsDisplaySectionDivider" TargetType="Border" BasedOn="{StaticResource SettingsSectionDivider}">
            <Setter Property="Margin" Value="0,22,0,16" />
        </Style>
        <!-- Playnite Default CheckBox: 18px mark + 1px borders + 5px content gap. Nested
             groups use this left inset so sliders/combos line up with the checkbox label. -->
        <Thickness x:Key="SettingsNestedGroupMargin">25,12,0,0</Thickness>
        <Style x:Key="SettingsTabScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="8,8,8,8" />
        </Style>
        <Style x:Key="SettingsTabIntro" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        </Style>
        <Style x:Key="SettingsFieldLabel" TargetType="Label" BasedOn="{StaticResource SettingsFieldTitle}" />
        <Style x:Key="SettingsFieldLabelSpaced" TargetType="Label" BasedOn="{StaticResource SettingsFieldTitle}">
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        <Style x:Key="SettingsSliderValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        </Style>
        <Style x:Key="SettingsParentCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,20,0,0" />
        </Style>
        <Style x:Key="SettingsNestedGroup" TargetType="Panel">
            <Setter Property="Margin" Value="{StaticResource SettingsNestedGroupMargin}" />
        </Style>
        <Style x:Key="SettingsColorRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- Full-width rule under the tab headers (same baseline as the selected-tab underline). -->
        <Style x:Key="SettingsTabControl" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TabPanel IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          HorizontalAlignment="Stretch" />
                                <Border Style="{StaticResource SettingsSectionDivider}"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="SelectedContent"
                                              TextElement.FontWeight="Normal" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8,12,8" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent">
                            <Border x:Name="HeaderChrome" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="SelectedUnderline"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch"
                                    SnapsToDevicePixels="True"
                                    Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectedUnderline" Property="Background" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="HeaderChrome" Property="TextElement.FontWeight" Value="SemiBold" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="Auto" MinWidth="140" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="16,16,16,0">
                <CheckBox Content="{DynamicResource LOCGameHoverDetails_Settings_EnableHover}"
                          Margin="0,0,0,10"
                          IsChecked="{Binding HoverDisabled, Converter={StaticResource InvertBool}, Mode=TwoWay}" />
                <CheckBox Content="{DynamicResource LOCGameHoverDetails_Settings_ShowInFullscreen}"
                          IsEnabled="{Binding HoverDisabled, Converter={StaticResource InvertBool}}"
                          IsChecked="{Binding HoverDisabledInFullscreen, Converter={StaticResource InvertBool}, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Margin="16,28,16,8"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       IsHitTestVisible="False"
                       Text="{DynamicResource LOCGameHoverDetails_Settings_Heading}" />

            <TabControl Grid.Row="2"
                        Style="{StaticResource SettingsTabControl}"
                        Margin="16,0,16,8"
                        Padding="0"
                        SelectedIndex="0"
                        FontWeight="Normal"
                        Foreground="{DynamicResource TextBrush}">
                <TabItem Header="{DynamicResource LOCGameHoverDetails_Settings_TabFields}">
                    <ScrollViewer x:Name="FieldsScrollViewer"
                                  Style="{StaticResource SettingsTabScrollViewer}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsTabIntro}"
                                       Text="{DynamicResource LOCGameHoverDetails_Settings_FieldsDescription}" />

                            <Border Padding="10,10,10,12"
                                    HorizontalAlignment="Stretch"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    BorderBrush="#5C5C64">
                                <StackPanel>
                                    <Label Style="{StaticResource SettingsFieldLabel}"
                                           Content="{DynamicResource LOCGameHoverDetails_Settings_AddField}" />
                                    <Grid Margin="0,0,0,12">
                                    <ComboBox x:Name="AddFieldCombo"
                                              HorizontalContentAlignment="Left"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="32"
                                              MaxDropDownHeight="320"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              StaysOpenOnEdit="True"
                                              Foreground="{DynamicResource TextBrush}"
                                              DropDownOpened="AddFieldCombo_DropDownOpened"
                                              DropDownClosed="AddFieldCombo_DropDownClosed"
                                              GotKeyboardFocus="AddFieldCombo_GotKeyboardFocus"
                                              PreviewMouseLeftButtonDown="AddFieldCombo_PreviewMouseLeftButtonDown"
                                              PreviewKeyDown="AddFieldCombo_PreviewKeyDown">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <EventSetter Event="PreviewMouseLeftButtonDown"
                                                             Handler="AddFieldComboItem_PreviewMouseLeftButtonDown" />
                                                <EventSetter Event="PreviewMouseLeftButtonUp"
                                                             Handler="AddFieldComboItem_PreviewMouseLeftButtonUp" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="26">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"
                                                                      Width="16"
                                                                      Height="16"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      FlowDirection="LeftToRight"
                                                                      Opacity="0.92"
                                                                      Content="{Binding SettingsIcon}" />
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock x:Name="AddFieldSearchHint"
                                               IsHitTestVisible="False"
                                               Margin="10,0,28,0"
                                               VerticalAlignment="Center"
                                               Opacity="0.45"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{DynamicResource LOCGameHoverDetails_Settings_AddFieldSearch}" />
                                    </Grid>

                                    <ItemsControl x:Name="FieldsList"
                                                  Style="{StaticResource FieldsListNonScrollingItemsControlStyle}"
                                                  Margin="0"
                                                  Padding="0"
                                                  HorizontalAlignment="Stretch"
                                                  Foreground="{DynamicResource TextBrush}">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"
                                                                      Width="16"
                                                                      Height="16"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      FlowDirection="LeftToRight"
                                                                      Opacity="0.92"
                                                                      Content="{Binding SettingsIcon}" />
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Margin="8,0,0,0">
                                                        <Button Padding="8,4"
                                                                MinWidth="30"
                                                                Content="↑"
                                                                FontSize="14"
                                                                ToolTip="{DynamicResource LOCGameHoverDetails_Settings_MoveUp}"
                                                                IsEnabled="{Binding CanMoveUp}"
                                                                Click="EnabledMoveUp_Click" />
                                                        <Button Padding="8,4"
                                                                MinWidth="30"
                                                                Margin="6,0,0,0"
                                                                Content="↓"
                                                                FontSize="14"
                                                                ToolTip="{DynamicResource LOCGameHoverDetails_Settings_MoveDown}"
                                                                IsEnabled="{Binding CanMoveDown}"
                                                                Click="EnabledMoveDown_Click" />
                                                        <Button Padding="8,4"
                                                                MinWidth="56"
                                                                Margin="6,0,0,0"
                                                                Content="{DynamicResource LOCGameHoverDetails_Settings_Remove}"
                                                                ToolTip="{DynamicResource LOCGameHoverDetails_Settings_RemoveFromHover}"
                                                                Click="EnabledRemove_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource LOCGameHoverDetails_Settings_TabDisplay}">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsTabIntro}"
                                       Text="{DynamicResource LOCGameHoverDetails_Settings_DisplayDescription}" />
                            <Label Style="{StaticResource SettingsFieldLabel}"
                                   Content="{DynamicResource LOCGameHoverDetails_Settings_BodyTextSize}" />
                            <Slider Minimum="9"
                                    Maximum="20"
                                    TickFrequency="0.5"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding HoverBodyFontSize, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource SettingsSliderValue}"
                                       Text="{Binding HoverBodyFontSize, StringFormat='{}{0:0.#}'}" />

                            <Border Style="{StaticResource SettingsDisplaySectionDivider}" />
                            <CheckBox Style="{StaticResource SettingsParentCheckBox}"
                                      Margin="0"
                                      Content="{DynamicResource LOCGameHoverDetails_Settings_HideEmptyFields}"
                                      IsChecked="{Binding HideEmptyFields, Mode=TwoWay}" />

                            <Border Style="{StaticResource SettingsDisplaySectionDivider}" />
                            <CheckBox Style="{StaticResource SettingsParentCheckBox}"
                                      Margin="0"
                                      Content="{DynamicResource LOCGameHoverDetails_Settings_ShowTitles}"
                                      IsChecked="{Binding HideFieldTitlesInHover, Converter={StaticResource InvertBool}, Mode=TwoWay}" />
                            <StackPanel Style="{StaticResource SettingsNestedGroup}"
                                        Visibility="{Binding HideFieldTitlesInHover, Converter={StaticResource InvertBool}}">
                                <Label Style="{StaticResource SettingsFieldLabel}"
                                       Content="{DynamicResource LOCGameHoverDetails_Settings_TitleTextSize}" />
                                <Slider Minimum="8"
                                        Maximum="16"
                                        TickFrequency="0.5"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding HoverTitleFontSize, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource SettingsSliderValue}"
                                           Text="{Binding HoverTitleFontSize, StringFormat='{}{0:0.#}'}" />
                            </StackPanel>

                            <Border Style="{StaticResource SettingsDisplaySectionDivider}" />
                            <CheckBox Style="{StaticResource SettingsParentCheckBox}"
                                      Margin="0"
                                      Content="{DynamicResource LOCGameHoverDetails_Settings_ShowIcons}"
                                      IsChecked="{Binding ShowFieldInlineIconsInHover, Mode=TwoWay}" />
                            <StackPanel Style="{StaticResource SettingsNestedGroup}"
                                        Visibility="{Binding ShowFieldInlineIconsInHover, Converter={StaticResource BoolToVis}}">
                                <Label Style="{StaticResource SettingsFieldLabel}"
                                       Content="{DynamicResource LOCGameHoverDetails_Settings_IconStyle}" />
                                <ComboBox MinHeight="32"
                                          SelectedValue="{Binding HoverIconStyle, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          Foreground="{DynamicResource TextBrush}">
                                    <ComboBoxItem Tag="Unicons"
                                                  Content="{DynamicResource LOCGameHoverDetails_Settings_IconStyleUnicons}" />
                                    <ComboBoxItem Tag="Phosphor"
                                                  Content="{DynamicResource LOCGameHoverDetails_Settings_IconStylePhosphor}" />
                                    <ComboBoxItem Tag="HugeIcons"
                                                  Content="{DynamicResource LOCGameHoverDetails_Settings_IconStyleHugeIcons}" />
                                    <ComboBoxItem Tag="Sketchy"
                                                  Content="{DynamicResource LOCGameHoverDetails_Settings_IconStyleSketchy}" />
                                    <ComboBoxItem Tag="Iconsax"
                                                  Content="{DynamicResource LOCGameHoverDetails_Settings_IconStyleIconsax}" />
                                    <ComboBoxItem Tag="Pixel"
                                                  Content="{DynamicResource LOCGameHoverDetails_Settings_IconStylePixel}" />
                                    <ComboBoxItem Tag="Pixelarticons"
                                                  Content="{DynamicResource LOCGameHoverDetails_Settings_IconStylePixelarticons}" />
                                </ComboBox>

                                <Label Style="{StaticResource SettingsFieldLabelSpaced}"
                                       Content="{DynamicResource LOCGameHoverDetails_Settings_IconSize}" />
                                <Slider Minimum="8"
                                        Maximum="40"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding HoverIconChipSizeDip, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource SettingsSliderValue}"
                                           Text="{Binding HoverIconChipSizeDip, StringFormat='{}{0} px'}" />

                                <Label Style="{StaticResource SettingsFieldLabelSpaced}"
                                       Content="{DynamicResource LOCGameHoverDetails_Settings_IconPadding}" />
                                <Slider Minimum="0"
                                        Maximum="16"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding HoverIconChipPaddingDip, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource SettingsSliderValue}"
                                           Text="{Binding HoverIconChipPaddingDip, StringFormat='{}{0} px'}" />

                                <CheckBox Style="{StaticResource SettingsParentCheckBox}"
                                          Content="{DynamicResource LOCGameHoverDetails_Settings_ShowIconBackground}"
                                          IsChecked="{Binding HideIconChipBackground, Converter={StaticResource InvertBool}, Mode=TwoWay}" />
                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding ShowIconBackgroundColorControls, Converter={StaticResource BoolToVis}}">
                                    <Label Style="{StaticResource SettingsFieldLabel}"
                                           Content="{DynamicResource LOCGameHoverDetails_Settings_IconBackgroundStyle}" />
                                    <ComboBox MinHeight="32"
                                              SelectedValue="{Binding HoverIconChipShape, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Foreground="{DynamicResource TextBrush}">
                                        <ComboBoxItem Tag="Circle"
                                                      Content="{DynamicResource LOCGameHoverDetails_Settings_IconBackgroundStyleCircle}" />
                                        <ComboBoxItem Tag="Rectangle"
                                                      Content="{DynamicResource LOCGameHoverDetails_Settings_IconBackgroundStyleRectangle}" />
                                        <ComboBoxItem Tag="Rounded"
                                                      Content="{DynamicResource LOCGameHoverDetails_Settings_IconBackgroundStyleRounded}" />
                                        <ComboBoxItem Tag="SoftRounded"
                                                      Content="{DynamicResource LOCGameHoverDetails_Settings_IconBackgroundStyleSoftRounded}" />
                                        <ComboBoxItem Tag="Squircle"
                                                      Content="{DynamicResource LOCGameHoverDetails_Settings_IconBackgroundStyleSquircle}" />
                                        <ComboBoxItem Tag="Arch"
                                                      Content="{DynamicResource LOCGameHoverDetails_Settings_IconBackgroundStyleArch}" />
                                        <ComboBoxItem Tag="Tile"
                                                      Content="{DynamicResource LOCGameHoverDetails_Settings_IconBackgroundStyleTile}" />
                                        <ComboBoxItem Tag="Leaf"
                                                      Content="{DynamicResource LOCGameHoverDetails_Settings_IconBackgroundStyleLeaf}" />
                                    </ComboBox>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SettingsFieldTitleText}"
                                                   Text="{DynamicResource LOCGameHoverDetails_Settings_IconBackground}" />
                                        <Button Grid.Column="1"
                                                Width="32"
                                                Height="22"
                                                Margin="8,0,8,0"
                                                Padding="0"
                                                ToolTip="{DynamicResource LOCGameHoverDetails_Settings_PickIconBackground}"
                                                Click="IconBackgroundSwatch_Click"
                                                Background="{Binding ChromeIconBackgroundSwatchBrush}"
                                                BorderBrush="#808080"
                                                BorderThickness="1" />
                                        <TextBox Grid.Column="2"
                                                 VerticalContentAlignment="Center"
                                                 FlowDirection="LeftToRight"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 Text="{Binding HoverChromeIconBackgroundHex, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{DynamicResource LOCGameHoverDetails_Settings_TabAppearance}">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsTabIntro}"
                                       Text="{DynamicResource LOCGameHoverDetails_Settings_AppearanceDescription}" />
                            <CheckBox Margin="0,0,0,12"
                                      Content="{DynamicResource LOCGameHoverDetails_Settings_UseGameBackground}"
                                      IsChecked="{Binding UseGameBackground, Mode=TwoWay}" />
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center"
                                          Content="{DynamicResource LOCGameHoverDetails_Settings_UseThemeColors}"
                                          IsChecked="{Binding UseThemeChrome, Mode=TwoWay}" />
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Padding="12,4"
                                        Content="{DynamicResource LOCGameHoverDetails_Settings_ResetColors}"
                                        Click="ResetChromeColors_Click" />
                            </Grid>
                            <StackPanel Margin="0,16,0,0">
                                <Grid Style="{StaticResource SettingsColorRow}"
                                      Visibility="{Binding ShowRegularBackgroundColorControls, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SettingsFieldTitleText}"
                                               Text="{DynamicResource LOCGameHoverDetails_Settings_Background}" />
                                    <Button Grid.Column="1"
                                            Width="32"
                                            Height="22"
                                            Margin="8,0,8,0"
                                            Padding="0"
                                            ToolTip="{DynamicResource LOCGameHoverDetails_Settings_PickBackground}"
                                            Click="BackgroundSwatch_Click"
                                            Background="{Binding ChromeBackgroundSwatchBrush}"
                                            BorderBrush="#808080"
                                            BorderThickness="1" />
                                    <TextBox Grid.Column="2"
                                             VerticalContentAlignment="Center"
                                             FlowDirection="LeftToRight"
                                             Foreground="{DynamicResource TextBrush}"
                                             Text="{Binding HoverChromeBackgroundHex, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                            </StackPanel>
                            <Label Style="{StaticResource SettingsFieldLabelSpaced}"
                                   Content="{DynamicResource LOCGameHoverDetails_Settings_BackgroundOpacity}" />
                            <Slider Minimum="0"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding HoverChromeBackgroundOpacity, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource SettingsSliderValue}"
                                       Text="{Binding HoverChromeBackgroundOpacity, StringFormat='{}{0}%'}" />
                            <Border Style="{StaticResource SettingsDisplaySectionDivider}" />
                            <CheckBox Style="{StaticResource SettingsParentCheckBox}"
                                      Margin="0"
                                      Content="{DynamicResource LOCGameHoverDetails_Settings_ShowBorder}"
                                      IsChecked="{Binding HidePanelBorder, Converter={StaticResource InvertBool}, Mode=TwoWay}" />
                            <Grid Style="{StaticResource SettingsNestedGroup}"
                                  Visibility="{Binding ShowBorderColorControls, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsFieldTitleText}"
                                           Text="{DynamicResource LOCGameHoverDetails_Settings_Border}" />
                                <Button Grid.Column="1"
                                        Width="32"
                                        Height="22"
                                        Margin="8,0,8,0"
                                        Padding="0"
                                        ToolTip="{DynamicResource LOCGameHoverDetails_Settings_PickBorder}"
                                        Click="BorderSwatch_Click"
                                        Background="{Binding ChromeBorderSwatchBrush}"
                                        BorderBrush="#808080"
                                        BorderThickness="1" />
                                <TextBox Grid.Column="2"
                                         VerticalContentAlignment="Center"
                                         FlowDirection="LeftToRight"
                                         Foreground="{DynamicResource TextBrush}"
                                         Text="{Binding HoverChromeBorderHex, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDisplaySectionDivider}" />
                            <CheckBox Style="{StaticResource SettingsParentCheckBox}"
                                      Margin="0"
                                      Content="{DynamicResource LOCGameHoverDetails_Settings_ShowDividers}"
                                      IsChecked="{Binding HideFieldDividers, Converter={StaticResource InvertBool}, Mode=TwoWay}" />
                            <Grid Style="{StaticResource SettingsNestedGroup}"
                                  Visibility="{Binding ShowDividerColorControls, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsFieldTitleText}"
                                           Text="{DynamicResource LOCGameHoverDetails_Settings_Divider}" />
                                <Button Grid.Column="1"
                                        Width="32"
                                        Height="22"
                                        Margin="8,0,8,0"
                                        Padding="0"
                                        ToolTip="{DynamicResource LOCGameHoverDetails_Settings_PickDivider}"
                                        Click="DividerSwatch_Click"
                                        Background="{Binding ChromeDividerSwatchBrush}"
                                        BorderBrush="#808080"
                                        BorderThickness="1" />
                                <TextBox Grid.Column="2"
                                         VerticalContentAlignment="Center"
                                         FlowDirection="LeftToRight"
                                         Foreground="{DynamicResource TextBrush}"
                                         Text="{Binding HoverChromeDividerHex, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource LOCGameHoverDetails_Settings_TabTimingSize}">
                    <ScrollViewer Style="{StaticResource SettingsTabScrollViewer}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsTabIntro}"
                                       Text="{DynamicResource LOCGameHoverDetails_Settings_TimingSizeDescription}" />
                            <Label Style="{StaticResource SettingsFieldLabel}"
                                   Content="{DynamicResource LOCGameHoverDetails_Settings_TooltipDelay}" />
                            <Slider Minimum="0"
                                    Maximum="500"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding ShowDelayMs, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource SettingsSliderValue}"
                                       Text="{Binding ShowDelayMs, StringFormat='{}{0} ms'}" />

                            <Label Style="{StaticResource SettingsFieldLabelSpaced}"
                                   Content="{DynamicResource LOCGameHoverDetails_Settings_PanelWidth}" />
                            <Slider x:Name="WidthSlider"
                                    Minimum="120"
                                    Maximum="500"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding HoverWidth, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource SettingsSliderValue}"
                                       Text="{Binding HoverWidth, StringFormat='{}{0} px'}" />

                            <Label Style="{StaticResource SettingsFieldLabelSpaced}"
                                   Content="{DynamicResource LOCGameHoverDetails_Settings_FieldColumns}" />
                            <Slider Minimum="1"
                                    Maximum="3"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding HoverFieldColumnCount, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource SettingsSliderValue}"
                                       Text="{Binding HoverFieldColumnCount}" />

                            <Label Style="{StaticResource SettingsFieldLabelSpaced}"
                                   Content="{DynamicResource LOCGameHoverDetails_Settings_FieldSpacing}" />
                            <Slider Minimum="4"
                                    Maximum="36"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding HoverFieldBlockSpacingDip, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource SettingsSliderValue}"
                                       Text="{Binding HoverFieldBlockSpacingDip, StringFormat='{}{0} px'}" />

                            <Label Style="{StaticResource SettingsFieldLabelSpaced}"
                                   Content="{DynamicResource LOCGameHoverDetails_Settings_ListPadding}" />
                            <Slider Minimum="4"
                                    Maximum="32"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding HoverContentPaddingDip, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource SettingsSliderValue}"
                                       Text="{Binding HoverContentPaddingDip, StringFormat='{}{0} px'}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- Live preview: Display + Layout (width, columns, spacing, titles, icons, enable) -->
        <StackPanel Grid.Column="1"
                    Margin="6,16,8,16"
                    VerticalAlignment="Top"
                    ClipToBounds="False">
            <TextBlock Text="{DynamicResource LOCGameHoverDetails_Settings_Preview}"
                       Foreground="{DynamicResource TextBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <Grid HorizontalAlignment="Left"
                  Margin="0,0,4,0">
                <Border Background="#48000000"
                        CornerRadius="8"
                        Margin="0,2,0,0"
                        IsHitTestVisible="False" />
                <Border x:Name="PreviewChromeBorder"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    MinWidth="120"
                    Width="{Binding HoverWidth}"
                    MaxWidth="{Binding HoverWidth}"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="#48484E"
                    Background="#1C1C1E"
                    Padding="0"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HoverDisabled}" Value="True">
                                <Setter Property="Opacity" Value="0.4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid x:Name="PreviewChromeBody">
                    <Border x:Name="PreviewCoverHost"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    <Border x:Name="PreviewCoverTint"
                            Background="#FF000000"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />
                    <StackPanel x:Name="PreviewFieldsHost"
                                Margin="14,12"
                                VerticalAlignment="Top" />
                </Grid>
            </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
