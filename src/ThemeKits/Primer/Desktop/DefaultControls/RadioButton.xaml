<!--
    Primer kit override of Shadcn/Desktop/DefaultControls/RadioButton.xaml.
    Primer Radio: 16px circle, borderColor-emphasis edge on bgColor-default; checked = 4px accent-emphasis ring
    around a white (fgColor-onEmphasis) center.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnInputBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource ShadcnFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" StrokeThickness="1"
                                         Stroke="{TemplateBinding BorderBrush}"
                                         Fill="{DynamicResource ShadcnInputBackgroundBrush}" />
                            </Grid>
                        </BulletDecorator.Bullet>
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Label" RecognizesAccessKey="True" Margin="8,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter Property="Margin" Value="0" TargetName="Label" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource ShadcnRingBrush}" TargetName="Ring" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="StrokeThickness" Value="4" TargetName="Ring" />
                            <Setter Property="Stroke" Value="{DynamicResource ShadcnPrimaryBrush}" TargetName="Ring" />
                            <Setter Property="Fill" Value="{DynamicResource ShadcnPrimaryForegroundBrush}" TargetName="Ring" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
