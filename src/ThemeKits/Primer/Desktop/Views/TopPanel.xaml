<!--
    Primer kit override of Shadcn/Desktop/Views/TopPanel.xaml.
    GitHub AppHeader: a 64px band in bgColor-inset with 16px padding and no bottom border. Like GitHub's global bar,
    the left side stays quiet and everything lives on the right: the search input (TextInput medium, 272px), then
    Playnite's view controls, filters and notifications as invisible 32px IconButtons with 16px Octicons.
    Notifications use GitHub's unread dot instead of a count; an active filter shows "Filter active" on the button.
    TopPanelMenu, the toggles and the icon templates keep Playnite's keys. All PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" Content="{DynamicResource ShadcnIconViewSettings}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" Content="{DynamicResource ShadcnIconFilterPresets}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" Content="{DynamicResource ShadcnIconGroup}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" Content="{DynamicResource ShadcnIconSort}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" Content="{DynamicResource ShadcnIconDetailsView}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" Content="{DynamicResource ShadcnIconGridView}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" Content="{DynamicResource ShadcnIconListView}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" TextElement.Foreground="{DynamicResource WarningBrush}" Content="{DynamicResource ShadcnIconUpdate}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" Content="{DynamicResource ShadcnIconExplorer}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" Content="{DynamicResource ShadcnIconRandom}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" Content="{DynamicResource ShadcnIconViewRandom}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" Content="{DynamicResource ShadcnIconSearch}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>

    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ShadcnMenuPadding}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ShadcnPopupRadius}"
                            Padding="{TemplateBinding Padding}"
                            Grid.IsSharedSizeScope="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Invisible IconButton; selected fill while the panel is open or a filter applies. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ShadcnRadiusMd}"
                            Padding="8,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" VerticalAlignment="Center" Content="{DynamicResource ShadcnIconFilter}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
                            <TextBlock x:Name="TextFilter" Text="{DynamicResource LOCFilterActiveLabel}"
                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{TemplateBinding Foreground}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Invisible IconButton with GitHub's unread dot (accent, ringed in the header color); hidden when empty. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ShadcnRadiusMd}">
                        <Grid>
                            <ContentPresenter Width="{DynamicResource ShadcnIconSize}" Height="{DynamicResource ShadcnIconSize}" Content="{DynamicResource ShadcnIconNotifications}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
                            <Ellipse Width="10" Height="10" Margin="0,5,5,0"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Fill="{DynamicResource ShadcnPrimaryBrush}"
                                     Stroke="{DynamicResource ShadcnHeaderBrush}" StrokeThickness="2" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- GitHub's header search: a TextInput (medium, 32px) at its 272px minimum width. -->
    <Style x:Key="ShadcnTopBarSearch" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Width" Value="272" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <!-- Right padding: the window buttons (14px + 3 x 32px + gaps) + 16px gap. -->
                    <Border Height="64" Padding="16,0,140,0" Background="{DynamicResource ShadcnHeaderBrush}">
                        <DockPanel>
                            <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource ShadcnLogoTile}"
                                    DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center">
                                <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconMainMenu}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
                            </Border>

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <CheckBox x:Name="PART_ToggleNotifications" DockPanel.Dock="Right"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" />

                            <CheckBox x:Name="PART_ToggleFilter" DockPanel.Dock="Right"
                                      ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" />

                            <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal" Margin="8,0,0,0"
                                        VerticalAlignment="Center" DockPanel.Dock="Right" />

                            <SearchBox x:Name="PART_TextMainSearch" DockPanel.Dock="Right"
                                       Style="{StaticResource ShadcnTopBarSearch}"
                                       WindowChrome.IsHitTestVisibleInChrome="True" />

                            <!-- ProgressBar (default 8px, accent) with its label; left-aligned like GitHub's context area. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="8,0,16,0">
                                <StackPanel MaxWidth="480" MinWidth="240" VerticalAlignment="Center">
                                    <TextBlock Name="PART_TextProgressText" Margin="0,0,0,6"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                                               Style="{DynamicResource BaseTextBlockStyle}" />
                                    <ProgressBar Name="PART_ProgressGlobal" Height="8" />
                                </StackPanel>
                                <Button Name="PART_ButtonProgressCancel"
                                        Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Margin="12,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
