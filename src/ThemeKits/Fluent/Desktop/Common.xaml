<!--
    Fluent kit override of Shadcn/Desktop/Common.xaml (whole file replaced, so PopupBorder is repeated).
    Fluent focus (react-tabster createFocusOutlineStyle): 2px colorStrokeFocus2 outline hugging the control,
    radius borderRadiusMedium.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnRadiusMd}" />
    </Style>

    <Style x:Key="ShadcnFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ShadcnRadiusLg}"
                            BorderBrush="{DynamicResource ShadcnRingBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
