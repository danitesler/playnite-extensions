<!--
    Fluent kit override of Shadcn/Desktop/Common.xaml (whole file replaced, so PopupBorder is repeated).
    Fluent focus (react-tabster createFocusOutlineStyle): 2px colorStrokeFocus2 outline hugging the control,
    radius borderRadiusMedium.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnPopupRadius}" />
    </Style>

    <Style x:Key="ShadcnFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ShadcnRadiusLg}"
                            BorderBrush="{DynamicResource ShadcnRingBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Control metrics for Fluent 2 (medium, 32px controls). Kit controls read these with DynamicResource, so each kit
        sets its design system's spacing here instead of replacing whole control files.
    -->
    <Thickness x:Key="ShadcnButtonPadding">12,5,12,5</Thickness> <!-- Button medium: 5px 12px, min-height 32px, inside a 1px border -->
    <Thickness x:Key="ShadcnInputPadding">12,5,12,5</Thickness> <!-- Input / Dropdown medium: 32px, 10px + 2px inline padding -->
    <CornerRadius x:Key="ShadcnPopupRadius">8</CornerRadius> <!-- MenuPopover borderRadiusXLarge -->
    <Thickness x:Key="ShadcnMenuPadding">4</Thickness> <!-- MenuPopover padding 4px -->
    <Thickness x:Key="ShadcnMenuItemPadding">8,6,8,6</Thickness> <!-- MenuItem: 6px + 2px content inset, 32px tall -->
    <CornerRadius x:Key="ShadcnMenuItemRadius">4</CornerRadius> <!-- MenuItem borderRadiusMedium -->
    <Thickness x:Key="ShadcnListItemPadding">8,6,8,6</Thickness> <!-- Option / ListItem: 6px 8px -->
    <CornerRadius x:Key="ShadcnCardRadius">4</CornerRadius> <!-- Card borderRadiusMedium -->
    <Thickness x:Key="ShadcnCardPadding">12</Thickness> <!-- Card medium: 12px -->
    <Thickness x:Key="ShadcnCardTitleMargin">0,0,0,12</Thickness> <!-- Card gap 12px -->
    <sys:Double x:Key="ShadcnIconSize">20</sys:Double> <!-- Button medium icons: 20px -->
    <Thickness x:Key="ShadcnTooltipPadding">11,4,11,6</Thickness> <!-- Tooltip: 4px 11px 6px -->
</ResourceDictionary>
