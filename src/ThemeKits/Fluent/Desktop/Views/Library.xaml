<!--
    Fluent kit override of Playnite Default/Views/Library.xaml.
    WinUI content layer: the title-bar row (TopPanel) stays on the base layer, and everything below sits on a
    lighter layer (colorNeutralBackground1) whose top-left corner is rounded (8px, OverlayCornerRadius) where it
    meets the navigation rail. A frame-colored mask draws that corner over the content, so the background image
    can run to the edge. The corner is square when the rail is not on the left or is hidden.
    PART_ImageBackground and the PART_View* names are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TopPanel Grid.Row="0" />

                        <Border x:Name="Layer" Grid.Row="1" CornerRadius="8,0,0,0"
                                Background="{DynamicResource ShadcnCardBrush}">
                            <Grid>
                                <FadeImage x:Name="PART_ImageBackground"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" />

                                <DockPanel>
                                    <FilterPanel x:Name="PART_FilterPanel"
                                                 DockPanel.Dock="{Settings FilterPanelPosition}"
                                                 Width="{Settings FilterPanelWitdh}"
                                                 Visibility="{Settings FilterPanelVisible}" />

                                    <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                                   DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                                   Width="{Settings ExplorerPanelWitdh}" />

                                    <Grid DockPanel.Dock="Left">
                                        <LibraryDetailsView x:Name="PART_ViewDetails" />
                                        <LibraryGridView x:Name="PART_ViewGrid" />
                                        <LibraryListView x:Name="PART_ViewList" />
                                    </Grid>
                                </DockPanel>

                                <Path x:Name="LayerCorner" Data="M0,0 H8 A8,8 0 0 0 0,8 Z"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      IsHitTestVisible="False" SnapsToDevicePixels="True"
                                      Fill="{DynamicResource ShadcnBackgroundBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="LayerCorner" />
                            <Setter Property="CornerRadius" Value="0" TargetName="Layer" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="LayerCorner" />
                            <Setter Property="CornerRadius" Value="0" TargetName="Layer" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="LayerCorner" />
                            <Setter Property="CornerRadius" Value="0" TargetName="Layer" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings ShowSidebar}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="LayerCorner" />
                            <Setter Property="CornerRadius" Value="0" TargetName="Layer" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
