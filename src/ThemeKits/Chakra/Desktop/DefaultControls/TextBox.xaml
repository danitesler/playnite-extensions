<!--
    Chakra kit override of Shadcn/Desktop/DefaultControls/TextBox.xaml.
    Chakra Input, subtle variant (md): bg.muted fill and a transparent 1px border from the palette (input-background,
    input-border), h-10 / px-3 from ShadcnInputPadding. focusVisibleRing="inside": focus paints a 2px
    colorPalette.focusRing edge over the control, no outer halo. Radius l2.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ShadcnPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ShadcnInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ShadcnInputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ShadcnRadiusMd}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <Border x:Name="FocusRing" BorderThickness="2" Visibility="Collapsed"
                                IsHitTestVisible="False" SnapsToDevicePixels="True"
                                CornerRadius="{DynamicResource ShadcnRadiusMd}"
                                BorderBrush="{DynamicResource ShadcnRingBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ShadcnRingBrush}" TargetName="Border" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FocusRing" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless text box for hosts that draw their own chrome (editable ComboBox). -->
    <Style x:Key="ShadcnBareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource ShadcnPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
