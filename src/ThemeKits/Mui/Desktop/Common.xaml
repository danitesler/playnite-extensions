<!--
    Mui kit override of Shadcn/Desktop/Common.xaml (whole file replaced, so PopupBorder is repeated).
    Material shows keyboard focus as a state layer, not a ring: ShadcnFocusVisual fills the control with
    action.focus (focus-overlay).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnRadiusMd}" />
    </Style>

    <Style x:Key="ShadcnFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border IsHitTestVisible="False" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource ShadcnRadiusMd}"
                            Background="{DynamicResource ShadcnFocusOverlayBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
