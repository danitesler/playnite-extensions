<!--
    Mui kit override of Shadcn/Desktop/DefaultControls/CheckBox.xaml.
    MUI Checkbox: 18px box, 2px text.secondary outline, 2px corners; checked/indeterminate = primary fill with
    the mark cut in primary.contrastText. Hover shows the round state layer (action.hover, primary 8% when on).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource ShadcnFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center">
                                <!-- Negative margin: the 38px state layer spills past the control like MUI's ripple. -->
                                <Ellipse x:Name="StateLayer" Margin="-10" Visibility="Hidden" IsHitTestVisible="False"
                                         Fill="{DynamicResource ShadcnAccentBrush}" />
                                <Border x:Name="Box" CornerRadius="2" BorderThickness="2" SnapsToDevicePixels="True"
                                        BorderBrush="{TemplateBinding BorderBrush}" Background="Transparent">
                                    <Grid>
                                        <Path x:Name="CheckIcon" Visibility="Collapsed" Width="10" Height="8" Stretch="Fill"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M0,4 L3.5,7.5 L10,0"
                                              Stroke="{DynamicResource ShadcnPrimaryForegroundBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Square" StrokeEndLineCap="Square" StrokeLineJoin="Miter" />
                                        <Rectangle x:Name="IndeterminateIcon" Visibility="Collapsed" Width="10" Height="2"
                                                   Fill="{DynamicResource ShadcnPrimaryForegroundBrush}" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <ContentPresenter x:Name="Label" DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="10,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter Property="Margin" Value="0" TargetName="Label" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="StateLayer" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon" />
                            <Setter Property="Background" Value="{DynamicResource ShadcnPrimaryBrush}" TargetName="Box" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ShadcnPrimaryBrush}" TargetName="Box" />
                            <Setter Property="Fill" Value="{DynamicResource ShadcnPrimaryTintBrush}" TargetName="StateLayer" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Setter Property="Background" Value="{DynamicResource ShadcnPrimaryBrush}" TargetName="Box" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ShadcnPrimaryBrush}" TargetName="Box" />
                            <Setter Property="Fill" Value="{DynamicResource ShadcnPrimaryTintBrush}" TargetName="StateLayer" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
