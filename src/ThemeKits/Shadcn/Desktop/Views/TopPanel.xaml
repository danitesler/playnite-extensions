<!--
    Overlay on Playnite Default/Views/TopPanel.xaml.
    shadcn dashboard header (site-header in dashboard-01), inside the inset card: 48px (h-12), px-4, no border.
    Search sits on the left as a filled, borderless h-8 field (w-64, the docs-site search trigger); the view
    controls, filter and notification toggles are ghost icon buttons on the right, clear of the window buttons
    (DerivedStyles/MainWindowStyle.xaml). Progress takes the middle when a task runs.
    Icons are lucide (Media.xaml) at 16px. TopPanelMenu is looked up from code; the icon templates, toggles and
    TopPanelMenu keep Playnite's keys. All PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconViewSettings}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconFilterPresets}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconGroup}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconSort}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconDetailsView}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconGridView}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconListView}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconUpdate}" ContentTemplate="{DynamicResource ShadcnIconTemplate}"
                          TextElement.Foreground="{DynamicResource WarningBrush}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconExplorer}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconRandom}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconViewRandom}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource ShadcnIconSearch}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
    </DataTemplate>

    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ShadcnMenuPadding}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ShadcnPopupRadius}"
                            Padding="{TemplateBinding Padding}"
                            Grid.IsSharedSizeScope="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost icon toggle; "Filter active" label and accent fill while a filter applies, accent when the panel is open. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ShadcnRadiusMd}"
                            Padding="8,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter Width="16" Height="16" VerticalAlignment="Center"
                                              Content="{DynamicResource ShadcnIconFilter}"
                                              ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
                            <TextBlock x:Name="TextFilter" Text="{DynamicResource LOCFilterActiveLabel}"
                                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{TemplateBinding Foreground}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ghost bell with a destructive count badge; hidden while there is nothing to show. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ShadcnRadiusMd}">
                        <Grid>
                            <ContentPresenter Width="16" Height="16"
                                              Content="{DynamicResource ShadcnIconNotifications}"
                                              ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
                            <Border CornerRadius="{DynamicResource ShadcnRadiusFull}" MinWidth="16" Height="16" Padding="4,0,4,0"
                                    Margin="0,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource ShadcnDestructiveBrush}">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource ShadcnPrimaryForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Header search: filled with the card surface, no border, h-8, w-64. -->
    <Style x:Key="ShadcnTopBarSearch" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Width" Value="256" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ShadcnCardBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <!-- Right padding: 16px + the window buttons (108px) + 8px gap. -->
                    <Border Height="48" Padding="16,0,132,0" Background="{TemplateBinding Background}">
                        <DockPanel>
                            <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource ShadcnLogoTile}"
                                    DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ContentPresenter Width="16" Height="16"
                                                  Content="{DynamicResource ShadcnIconMainMenu}"
                                                  ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch" DockPanel.Dock="Left"
                                       Style="{StaticResource ShadcnTopBarSearch}"
                                       WindowChrome.IsHitTestVisibleInChrome="True" />

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <CheckBox x:Name="PART_ToggleNotifications" DockPanel.Dock="Right"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" />

                            <CheckBox x:Name="PART_ToggleFilter" DockPanel.Dock="Right"
                                      ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" />

                            <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" DockPanel.Dock="Right" />

                            <!-- Progress: xs muted status line over an h-2 bar. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="16,0,16,0">
                                <StackPanel MaxWidth="480" MinWidth="240" VerticalAlignment="Center">
                                    <TextBlock Name="PART_TextProgressText" Margin="0,0,0,4"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource ShadcnMutedForegroundBrush}"
                                               Style="{DynamicResource BaseTextBlockStyle}" />
                                    <ProgressBar Name="PART_ProgressGlobal" Height="8" />
                                </StackPanel>
                                <Button Name="PART_ButtonProgressCancel"
                                        Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Margin="12,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
