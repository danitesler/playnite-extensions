<!--
    Overlay on Playnite Default/DerivedStyles/WindowBarButton.xaml.
    Title bar minimize / maximize / restore / close as shadcn ghost icon buttons drawn with the kit's icon set
    (Media.xaml) instead of Marlett. Playnite's window templates set Content to the Marlett character ("0" minimize,
    "1" maximize, "2" restore, "r" close); the template maps it to an icon. Close turns destructive on hover.
    WindowBarButton stays compact for dialogs (their title band is 25px); ShadcnMainWindowBarButton is the 32px
    (size-8) variant DerivedStyles/MainWindowStyle.xaml puts in the main window's header.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="WindowBarButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedForegroundBrush}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="2,0,2,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ShadcnRadiusMd}">
                        <!-- FontSize carries the icon size. -->
                        <ContentPresenter x:Name="Glyph"
                                          Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{DynamicResource ShadcnIconWindowClose}"
                                          ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="0">
                            <Setter Property="Content" Value="{DynamicResource ShadcnIconWindowMinimize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Content" Value="{DynamicResource ShadcnIconWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Content" Value="{DynamicResource ShadcnIconWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ShadcnAccentForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource ShadcnGhostHoverBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="Content" Value="r" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource ShadcnDestructiveSubtleBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ShadcnMainWindowBarButton" TargetType="Button" BasedOn="{StaticResource WindowBarButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="16" />
    </Style>
</ResourceDictionary>
