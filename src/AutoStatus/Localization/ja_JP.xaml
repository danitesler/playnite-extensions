<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutoStatus_Settings_Enable">AutoStatus を有効にする</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleRule">遊ばなくなったゲームのプレイ状況を変更する</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleFrom">このプレイ状況のゲーム</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleDays">この日数プレイしていない</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleTo">変更後のプレイ状況</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeRule">ゲームを起動したときにプレイ状況を変更する</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeFrom">プレイ状況が次のいずれかの場合</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeTo">変更後のプレイ状況</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_Hint">ルールは Playnite の起動時、6 時間ごと、保存後、および拡張機能メニューから実行されます。Playnite で一度もプレイしていないゲームは変更されません。</sys:String>
    <sys:String x:Key="LOCAutoStatus_Menu_ApplyNow">今すぐプレイ状況ルールを適用</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_Moved">{2} 日間プレイがなかったため {1} に変更: {0}</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_NothingToDo">プレイ状況の変更が必要なゲームはありませんでした。</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_StaleStatuses">遊ばなくなったゲーム: 異なる 2 つのプレイ状況を選択してください。</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_ResumeStatuses">起動したゲーム: 監視するプレイ状況を 1 つ以上と、変更後のプレイ状況を選択してください。</sys:String>

</ResourceDictionary>
