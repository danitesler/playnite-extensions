<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutoStatus_Settings_Enable">AutoStatus aktivieren</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleRule">Status von Spielen ändern, die ich nicht mehr spiele</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleFrom">Spiele mit diesem Status</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleDays">So viele Tage nicht gespielt</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleTo">Ihren Status ändern zu</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeRule">Status eines Spiels ändern, wenn ich es starte</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeFrom">Wenn sein Status einer von diesen ist</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeTo">Seinen Status ändern zu</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_Hint">Die Regeln laufen beim Start von Playnite, alle 6 Stunden, nach dem Speichern und über das Menü Erweiterungen. Spiele, die nie in Playnite gespielt wurden, bleiben unverändert.</sys:String>
    <sys:String x:Key="LOCAutoStatus_Menu_ApplyNow">Statusregeln jetzt anwenden</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_Moved">Nach {2} Tagen ohne Spielen auf {1} geändert: {0}</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_NothingToDo">Kein Spiel brauchte eine Statusänderung.</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_StaleStatuses">Spiele, die ich nicht mehr spiele: Wähle zwei verschiedene Status.</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_ResumeStatuses">Spiele, die ich starte: Wähle mindestens einen Status und den Zielstatus.</sys:String>

</ResourceDictionary>
