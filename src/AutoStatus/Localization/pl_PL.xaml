<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutoStatus_Settings_Enable">Włącz AutoStatus</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleRule">Zmieniaj status gier, w które przestałem grać</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleFrom">Gry z tym statusem</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleDays">Nieuruchamiane od tylu dni</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleTo">Zmień ich status na</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeRule">Zmieniaj status gry, gdy ją uruchamiam</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeFrom">Jeśli jej status to jeden z tych</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeTo">Zmień jej status na</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_Hint">Reguły działają przy starcie Playnite, co 6 godzin, po zapisaniu i z menu Rozszerzenia. Gry, w które nigdy nie grano w Playnite, pozostają bez zmian.</sys:String>
    <sys:String x:Key="LOCAutoStatus_Menu_ApplyNow">Zastosuj reguły statusu teraz</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_Moved">Zmieniono na {1} po {2} dniach bez grania: {0}</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_NothingToDo">Żadna gra nie wymagała zmiany statusu.</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_StaleStatuses">Gry, w które przestałem grać: wybierz dwa różne statusy.</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_ResumeStatuses">Gry, które uruchamiam: wybierz co najmniej jeden status i status docelowy.</sys:String>

</ResourceDictionary>
