<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutoStatus_Settings_Enable">AutoStatus-ის ჩართვა</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleRule">იმ თამაშების სტატუსის შეცვლა, რომლებსაც აღარ ვთამაშობ</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleFrom">ამ სტატუსის მქონე თამაშები</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleDays">ამდენი დღე არ ნათამაშები</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleTo">ახალი სტატუსი</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeRule">თამაშის სტატუსის შეცვლა მისი გაშვებისას</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeFrom">თუ მისი სტატუსი ერთ-ერთია ამათგან</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeTo">ახალი სტატუსი</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_Hint">წესები ეშვება Playnite-ის გაშვებისას, ყოველ 6 საათში, შენახვის შემდეგ და გაფართოებების მენიუდან. თამაშები, რომლებიც Playnite-ში არასოდეს უთამაშიათ, არ იცვლება.</sys:String>
    <sys:String x:Key="LOCAutoStatus_Menu_ApplyNow">სტატუსის წესების ახლავე გამოყენება</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_Moved">შეიცვალა {1}-ზე {2} დღე თამაშის გარეშე: {0}</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_NothingToDo">არცერთ თამაშს არ სჭირდებოდა სტატუსის შეცვლა.</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_StaleStatuses">თამაშები, რომლებსაც აღარ ვთამაშობ: აირჩიეთ ორი განსხვავებული სტატუსი.</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_ResumeStatuses">თამაშები, რომლებსაც ვუშვებ: აირჩიეთ მინიმუმ ერთი სტატუსი და ახალი სტატუსი.</sys:String>

</ResourceDictionary>
