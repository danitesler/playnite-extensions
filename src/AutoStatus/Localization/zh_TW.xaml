<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutoStatus_Settings_Enable">啟用 AutoStatus</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleRule">變更我不再玩的遊戲的完成狀態</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleFrom">具有此狀態的遊戲</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleDays">未遊玩的天數</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleTo">將其狀態變更為</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeRule">啟動遊戲時變更其狀態</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeFrom">如果其狀態為下列之一</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeTo">將其狀態變更為</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_Hint">規則會在 Playnite 啟動時、每 6 小時、儲存後以及從擴充功能選單執行。從未在 Playnite 中遊玩過的遊戲不會被變更。</sys:String>
    <sys:String x:Key="LOCAutoStatus_Menu_ApplyNow">立即套用狀態規則</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_Moved">{2} 天未遊玩，已變更為 {1}：{0}</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_NothingToDo">沒有遊戲需要變更狀態。</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_StaleStatuses">我不再玩的遊戲：請選擇兩個不同的狀態。</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_ResumeStatuses">我啟動的遊戲：請至少選擇一個狀態以及要變更為的狀態。</sys:String>

</ResourceDictionary>
