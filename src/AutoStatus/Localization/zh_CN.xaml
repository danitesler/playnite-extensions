<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutoStatus_Settings_Enable">启用 AutoStatus</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleRule">更改我不再玩的游戏的完成状态</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleFrom">具有此状态的游戏</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleDays">未游玩的天数</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleTo">将其状态更改为</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeRule">启动游戏时更改其状态</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeFrom">如果其状态为以下之一</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeTo">将其状态更改为</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_Hint">规则会在 Playnite 启动时、每 6 小时、保存后以及从扩展菜单运行。从未在 Playnite 中游玩过的游戏不会被更改。</sys:String>
    <sys:String x:Key="LOCAutoStatus_Menu_ApplyNow">立即应用状态规则</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_Moved">{2} 天未游玩，已更改为 {1}：{0}</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_NothingToDo">没有游戏需要更改状态。</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_StaleStatuses">我不再玩的游戏：请选择两个不同的状态。</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_ResumeStatuses">我启动的游戏：请至少选择一个状态以及要更改为的状态。</sys:String>

</ResourceDictionary>
