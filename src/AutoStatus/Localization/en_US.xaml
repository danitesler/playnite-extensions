<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutoStatus_Settings_Enable">Enable AutoStatus</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleRule">Change the status of games I stopped playing</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleFrom">Games with this status</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleDays">Not played for this many days</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_StaleTo">Change their status to</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeRule">Change the status of a game when I start it</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeFrom">If its status is one of these</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_ResumeTo">Change its status to</sys:String>
    <sys:String x:Key="LOCAutoStatus_Settings_Hint">Rules run when Playnite starts, every 6 hours, after you save, and from the Extensions menu. Games never played in Playnite are left alone.</sys:String>
    <sys:String x:Key="LOCAutoStatus_Menu_ApplyNow">Apply status rules now</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_Moved">Changed to {1} after {2} days without play: {0}</sys:String>
    <sys:String x:Key="LOCAutoStatus_Result_NothingToDo">No games needed a status change.</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_StaleStatuses">Games I stopped playing: pick two different statuses.</sys:String>
    <sys:String x:Key="LOCAutoStatus_Verify_ResumeStatuses">Games I start: pick at least one status and the status to change to.</sys:String>

</ResourceDictionary>
