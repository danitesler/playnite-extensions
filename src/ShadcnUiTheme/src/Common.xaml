<!-- Overlay on Playnite Default/Common.xaml: only restyled keys live here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnPopupRadius}" />
    </Style>

    <!-- focus-visible:ring-[3px] ring-ring/50. WPF shows FocusVisualStyle for keyboard focus only. -->
    <Style x:Key="ShadcnFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="3" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource ShadcnRadiusLg}"
                            BorderBrush="{DynamicResource ShadcnRingFocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Control metrics for shadcn/ui new-york-v4. Kit controls read these with DynamicResource, so each kit
        sets its design system's spacing here instead of replacing whole control files. Radii (ShadcnPopupRadius,
        ShadcnMenuItemRadius, ShadcnCardRadius) come from the palette in Constants.xaml; derived kits set them here.
    -->
    <Thickness x:Key="ShadcnButtonPadding">16,8,16,8</Thickness> <!-- Button default size: h-9, px-4 (no border) -->
    <Thickness x:Key="ShadcnInputPadding">12,7,12,7</Thickness> <!-- Input / Select trigger: h-9, px-3, inside a 1px border -->
    <Thickness x:Key="ShadcnMenuPadding">4</Thickness> <!-- DropdownMenuContent p-1 -->
    <Thickness x:Key="ShadcnMenuItemPadding">8,6,8,6</Thickness> <!-- DropdownMenuItem px-2 py-1.5 -->
    <Thickness x:Key="ShadcnListItemPadding">8,6,8,6</Thickness> <!-- CommandItem px-2 py-1.5 -->
    <Thickness x:Key="ShadcnCardPadding">24</Thickness> <!-- Card py-6, px-6 (gap-6 under the title) -->
    <Thickness x:Key="ShadcnCardTitleMargin">0,0,0,24</Thickness> <!-- gap-6 under the card title -->
    <sys:Double x:Key="ShadcnIconSize">16</sys:Double> <!-- icons in the header and sidebar: size-4 -->
    <Thickness x:Key="ShadcnTooltipPadding">12,6,12,6</Thickness> <!-- TooltipContent px-3 py-1.5 -->
</ResourceDictionary>
