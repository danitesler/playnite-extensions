<!-- Overlay on Playnite Default/Common.xaml: only restyled keys live here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Popover surface (PopoverContent: rounded-md, border, bg-popover). -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- focus-visible:ring-[3px] ring-ring/50. WPF shows FocusVisualStyle for keyboard focus only. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="3" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource CornerRadiusLarge}"
                            BorderBrush="{DynamicResource FocusHaloBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing from shadcn/ui new-york-v4, keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">16,8,16,8</Thickness> <!-- Button size default: h-9, px-4 (no border) -->
    <Thickness x:Key="InputPadding">12,7,12,7</Thickness> <!-- Input / SelectTrigger: h-9, px-3, inside a 1px border -->
    <Thickness x:Key="MenuPadding">4</Thickness> <!-- DropdownMenuContent p-1 -->
    <Thickness x:Key="MenuItemPadding">8,6,8,6</Thickness> <!-- DropdownMenuItem px-2 py-1.5 -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness> <!-- SelectContent p-1 -->
    <Thickness x:Key="ComboBoxItemPadding">8,6,8,6</Thickness> <!-- SelectItem px-2 py-1.5 -->
    <Thickness x:Key="ListBoxItemPadding">8,6,8,6</Thickness> <!-- CommandItem px-2 py-1.5 -->
    <Thickness x:Key="GroupBoxPadding">24</Thickness> <!-- Card py-6, CardHeader / CardContent px-6 -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,24</Thickness> <!-- Card gap-6 under the header -->
    <sys:Double x:Key="IconSize">16</sys:Double> <!-- icons in the header and sidebar: size-4 -->
    <Thickness x:Key="TooltipPadding">12,6,12,6</Thickness> <!-- TooltipContent px-3 py-1.5 -->
</ResourceDictionary>
