<!--
    Shadcn UI Theme: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from
    tokens.css (shadcn's CSS variables) and writes the result to the build as Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo: Playnite's
    palette keys, then shared keys for roles Playnite has none for. Each placeholder names the shadcn variable that
    plays the role (opacity variants use the Tailwind class the component uses: bg-primary/90 is primary/90), so
    shadcn's names live in tokens.css and here only. Theme XAML reads the brushes (never the Color keys), so
    ThemeModifier edits reach every control.

    Optional sidebar and foreground variables fall back the way shadcn's own defaults pair them, so palettes that leave
    them out still render. Colors keep the alpha tokens.css gives them (border and input are translucent white, as in
    shadcn), except popup edges: WPF popups are layered windows, so those are flattened onto the popover color.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). A palette's font-sans / font-mono win over Segoe UI and Consolas. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-sans|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>

    <!-- Shape (Playnite keys). ControlCornerRadius is the medium step of the radius scale (rounded-md). -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius-md}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale: Tailwind rounded-sm / -lg / -xl from the radius tokens, rounded-full as a pill. -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:radius-xl}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <!-- Shell-colored mask for one rounded-xl corner of the inset card (Views/MainWindow.xaml flips it per corner). -->
    <Geometry x:Key="MainWindowInsetCornerGeometry">M0,0 H{{px:radius-xl}} A{{px:radius-xl}},{{px:radius-xl}} 0 0 0 0,{{px:radius-xl}} Z</Geometry>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor = primary and TextColorDark = primary-foreground: Playnite always pairs those two (selected rows,
        play button).
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{foreground}}</Color>
    <Color x:Key="TextColorDarker">{{muted-foreground}}</Color>
    <Color x:Key="TextColorDark">{{primary-foreground}}</Color>
    <Color x:Key="MainColor">{{secondary}}</Color>
    <Color x:Key="MainColorDark">{{card}}</Color>
    <Color x:Key="HoverColor">{{accent}}</Color>
    <Color x:Key="GlyphColor">{{primary}}</Color>
    <Color x:Key="HighlightGlyphColor">{{primary/50}}</Color>
    <Color x:Key="PopupBackgroundColor">{{popover?card}}</Color>
    <Color x:Key="PopupBorderColor">{{border@popover?border@card}}</Color>
    <Color x:Key="BackgroundToneColor">{{card}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>     <!-- no frame around covers -->
    <Color x:Key="PanelSeparatorColor">#00000000</Color>         <!-- no lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{border}}</Color>
    <Color x:Key="DataChangeNotifColor">#FFF59E0B</Color>        <!-- Tailwind amber-500; shadcn has no warning token -->

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{input?border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{foreground}}" />   <!-- Tooltip bg-foreground -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{secondary}}" />    <!-- Button secondary -->
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{input/30?border/30}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="#FF4ADE80" />    <!-- Tailwind green-400 -->
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{destructive}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="#FFFACC15" />       <!-- Tailwind yellow-400 -->

    <SolidColorBrush x:Key="WarningBrush" Color="{{destructive}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{card}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{background}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell: inset layout, the window frame in the sidebar color around a background card -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{sidebar?card}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{sidebar-primary?primary}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{sidebar-primary-foreground?primary-foreground}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{card}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{accent}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{accent/50}}" />               <!-- dark:hover:bg-accent/50 -->
    <SolidColorBrush x:Key="FocusBrush" Color="{{ring}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{ring/50}}" />                     <!-- focus-visible:ring-ring/50 -->
    <SolidColorBrush x:Key="DangerBrush" Color="{{destructive/60}}" />                 <!-- dark:bg-destructive/60 -->
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{foreground}}" />

    <!-- Buttons: Button secondary, default (primary), outline -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{secondary-foreground?foreground}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{secondary/80}}" />    <!-- hover:bg-secondary/80 -->
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{accent}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{primary/90}}" /> <!-- hover:bg-primary/90 -->

    <!-- Inputs: Input, SelectTrigger (dark:bg-input/30, dark:hover:bg-input/50) -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{input/30?border/30}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{input/50?border/50}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{ring}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{muted}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="#FFFFFFFF" />           <!-- Tailwind bg-white -->
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{primary/20}}" />           <!-- bg-primary/20 -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{border}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{input?border}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{input?border}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{ring}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{muted}}" />      <!-- TabsList bg-muted -->
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{ring}}" />
    <!-- Badge variant secondary: bg-secondary, text-secondary-foreground, [a&]:hover:bg-secondary/90 -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{secondary}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{secondary-foreground?foreground}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{secondary/90}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{background}}" />          <!-- text-background -->
</ResourceDictionary>
