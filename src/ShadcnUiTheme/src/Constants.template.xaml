<!--
    Shadcn UI Theme: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from
    tokens.css (shadcn's CSS variables) and writes the result to the build as Constants.xaml.

    Keys follow shadcn's variables: sidebar-accent-foreground becomes ShadcnSidebarAccentForegroundColor and
    ShadcnSidebarAccentForegroundBrush. Opacity variants are named after the Tailwind class shadcn's components use:
    bg-primary/90 is ShadcnPrimary90Brush. Colors keep the alpha tokens.css gives them (border and input are
    translucent white, as in shadcn), except popup edges: WPF popups are layered windows, so those are flattened
    onto the popover color.

    Theme XAML reads these keys with DynamicResource only: Playnite parses each theme file on its own before merging.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). A palette's font-sans / font-mono win over Segoe UI and Consolas. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-sans|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>

    <!-- Shape (Playnite keys) -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius-md}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale: Tailwind rounded-sm .. rounded-xl from the radius tokens, rounded-full as a pill. -->
    <CornerRadius x:Key="ShadcnRadiusSm">{{px:radius-sm}}</CornerRadius>
    <CornerRadius x:Key="ShadcnRadiusMd">{{px:radius-md}}</CornerRadius>
    <CornerRadius x:Key="ShadcnRadiusLg">{{px:radius-lg}}</CornerRadius>
    <CornerRadius x:Key="ShadcnRadiusXl">{{px:radius-xl}}</CornerRadius>
    <CornerRadius x:Key="ShadcnRadiusFull">9999</CornerRadius>
    <!-- Frame-colored mask for one rounded-xl corner of the inset card (Views/MainWindow.xaml flips it per corner). -->
    <Geometry x:Key="ShadcnInsetCornerGeometry">M0,0 H{{px:radius-xl}} A{{px:radius-xl}},{{px:radius-xl}} 0 0 0 0,{{px:radius-xl}} Z</Geometry>

    <!-- shadcn color tokens: one Color + one Brush per variable. Optional sidebar and foreground variables fall back
         the way shadcn's own defaults pair them, so palettes that leave them out still render. -->
    <Color x:Key="ShadcnBackgroundColor">{{background}}</Color>
    <Color x:Key="ShadcnForegroundColor">{{foreground}}</Color>
    <Color x:Key="ShadcnCardColor">{{card}}</Color>
    <Color x:Key="ShadcnCardForegroundColor">{{card-foreground?foreground}}</Color>
    <Color x:Key="ShadcnPopoverColor">{{popover?card}}</Color>
    <Color x:Key="ShadcnPopoverForegroundColor">{{popover-foreground?foreground}}</Color>
    <Color x:Key="ShadcnPrimaryColor">{{primary}}</Color>
    <Color x:Key="ShadcnPrimaryForegroundColor">{{primary-foreground}}</Color>
    <Color x:Key="ShadcnSecondaryColor">{{secondary}}</Color>
    <Color x:Key="ShadcnSecondaryForegroundColor">{{secondary-foreground?foreground}}</Color>
    <Color x:Key="ShadcnMutedColor">{{muted}}</Color>
    <Color x:Key="ShadcnMutedForegroundColor">{{muted-foreground}}</Color>
    <Color x:Key="ShadcnAccentColor">{{accent}}</Color>
    <Color x:Key="ShadcnAccentForegroundColor">{{accent-foreground?foreground}}</Color>
    <Color x:Key="ShadcnDestructiveColor">{{destructive}}</Color>
    <Color x:Key="ShadcnBorderColor">{{border}}</Color>
    <Color x:Key="ShadcnInputColor">{{input?border}}</Color>
    <Color x:Key="ShadcnRingColor">{{ring}}</Color>
    <Color x:Key="ShadcnSidebarColor">{{sidebar?card}}</Color>
    <Color x:Key="ShadcnSidebarForegroundColor">{{sidebar-foreground?foreground}}</Color>
    <Color x:Key="ShadcnSidebarPrimaryColor">{{sidebar-primary?primary}}</Color>
    <Color x:Key="ShadcnSidebarPrimaryForegroundColor">{{sidebar-primary-foreground?primary-foreground}}</Color>
    <Color x:Key="ShadcnSidebarAccentColor">{{sidebar-accent?accent}}</Color>
    <Color x:Key="ShadcnSidebarAccentForegroundColor">{{sidebar-accent-foreground?accent-foreground?foreground}}</Color>
    <Color x:Key="ShadcnSidebarBorderColor">{{sidebar-border?border}}</Color>
    <!-- Tailwind white (bg-white): the slider thumb. -->
    <Color x:Key="ShadcnWhiteColor">#FFFFFFFF</Color>

    <!-- Opacity variants, named after the Tailwind classes shadcn's components use -->
    <Color x:Key="ShadcnPrimary90Color">{{primary/90}}</Color>              <!-- hover:bg-primary/90 (Button default) -->
    <Color x:Key="ShadcnPrimary20Color">{{primary/20}}</Color>              <!-- bg-primary/20 (Progress track) -->
    <Color x:Key="ShadcnSecondary80Color">{{secondary/80}}</Color>          <!-- hover:bg-secondary/80 (Button secondary) -->
    <Color x:Key="ShadcnAccent50Color">{{accent/50}}</Color>                <!-- dark:hover:bg-accent/50 (Button ghost) -->
    <Color x:Key="ShadcnInput30Color">{{input/30?border/30}}</Color>        <!-- dark:bg-input/30 (Input, Select, Checkbox) -->
    <Color x:Key="ShadcnInput50Color">{{input/50?border/50}}</Color>        <!-- dark:hover:bg-input/50 -->
    <Color x:Key="ShadcnRing50Color">{{ring/50}}</Color>                    <!-- focus-visible:ring-ring/50 -->
    <Color x:Key="ShadcnDestructive60Color">{{destructive/60}}</Color>      <!-- dark:bg-destructive/60 (Button destructive) -->

    <SolidColorBrush x:Key="ShadcnBackgroundBrush" Color="{DynamicResource ShadcnBackgroundColor}" />
    <SolidColorBrush x:Key="ShadcnForegroundBrush" Color="{DynamicResource ShadcnForegroundColor}" />
    <SolidColorBrush x:Key="ShadcnCardBrush" Color="{DynamicResource ShadcnCardColor}" />
    <SolidColorBrush x:Key="ShadcnCardForegroundBrush" Color="{DynamicResource ShadcnCardForegroundColor}" />
    <SolidColorBrush x:Key="ShadcnPopoverBrush" Color="{DynamicResource ShadcnPopoverColor}" />
    <SolidColorBrush x:Key="ShadcnPopoverForegroundBrush" Color="{DynamicResource ShadcnPopoverForegroundColor}" />
    <SolidColorBrush x:Key="ShadcnPrimaryBrush" Color="{DynamicResource ShadcnPrimaryColor}" />
    <SolidColorBrush x:Key="ShadcnPrimaryForegroundBrush" Color="{DynamicResource ShadcnPrimaryForegroundColor}" />
    <SolidColorBrush x:Key="ShadcnSecondaryBrush" Color="{DynamicResource ShadcnSecondaryColor}" />
    <SolidColorBrush x:Key="ShadcnSecondaryForegroundBrush" Color="{DynamicResource ShadcnSecondaryForegroundColor}" />
    <SolidColorBrush x:Key="ShadcnMutedBrush" Color="{DynamicResource ShadcnMutedColor}" />
    <SolidColorBrush x:Key="ShadcnMutedForegroundBrush" Color="{DynamicResource ShadcnMutedForegroundColor}" />
    <SolidColorBrush x:Key="ShadcnAccentBrush" Color="{DynamicResource ShadcnAccentColor}" />
    <SolidColorBrush x:Key="ShadcnAccentForegroundBrush" Color="{DynamicResource ShadcnAccentForegroundColor}" />
    <SolidColorBrush x:Key="ShadcnDestructiveBrush" Color="{DynamicResource ShadcnDestructiveColor}" />
    <SolidColorBrush x:Key="ShadcnBorderBrush" Color="{DynamicResource ShadcnBorderColor}" />
    <SolidColorBrush x:Key="ShadcnInputBrush" Color="{DynamicResource ShadcnInputColor}" />
    <SolidColorBrush x:Key="ShadcnRingBrush" Color="{DynamicResource ShadcnRingColor}" />
    <SolidColorBrush x:Key="ShadcnSidebarBrush" Color="{DynamicResource ShadcnSidebarColor}" />
    <SolidColorBrush x:Key="ShadcnSidebarForegroundBrush" Color="{DynamicResource ShadcnSidebarForegroundColor}" />
    <SolidColorBrush x:Key="ShadcnSidebarPrimaryBrush" Color="{DynamicResource ShadcnSidebarPrimaryColor}" />
    <SolidColorBrush x:Key="ShadcnSidebarPrimaryForegroundBrush" Color="{DynamicResource ShadcnSidebarPrimaryForegroundColor}" />
    <SolidColorBrush x:Key="ShadcnSidebarAccentBrush" Color="{DynamicResource ShadcnSidebarAccentColor}" />
    <SolidColorBrush x:Key="ShadcnSidebarAccentForegroundBrush" Color="{DynamicResource ShadcnSidebarAccentForegroundColor}" />
    <SolidColorBrush x:Key="ShadcnSidebarBorderBrush" Color="{DynamicResource ShadcnSidebarBorderColor}" />
    <SolidColorBrush x:Key="ShadcnWhiteBrush" Color="{DynamicResource ShadcnWhiteColor}" />
    <SolidColorBrush x:Key="ShadcnPrimary90Brush" Color="{DynamicResource ShadcnPrimary90Color}" />
    <SolidColorBrush x:Key="ShadcnPrimary20Brush" Color="{DynamicResource ShadcnPrimary20Color}" />
    <SolidColorBrush x:Key="ShadcnSecondary80Brush" Color="{DynamicResource ShadcnSecondary80Color}" />
    <SolidColorBrush x:Key="ShadcnAccent50Brush" Color="{DynamicResource ShadcnAccent50Color}" />
    <SolidColorBrush x:Key="ShadcnInput30Brush" Color="{DynamicResource ShadcnInput30Color}" />
    <SolidColorBrush x:Key="ShadcnInput50Brush" Color="{DynamicResource ShadcnInput50Color}" />
    <SolidColorBrush x:Key="ShadcnRing50Brush" Color="{DynamicResource ShadcnRing50Color}" />
    <SolidColorBrush x:Key="ShadcnDestructive60Brush" Color="{DynamicResource ShadcnDestructive60Color}" />

    <!--
        Playnite palette keys, mapped to shadcn roles. Every Playnite view and control the theme does not restyle
        reads these, so this block alone recolors most of Playnite. GlyphColor = primary and TextColorDark =
        primary-foreground: Playnite always pairs those two (selected rows, play button).
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{foreground}}</Color>
    <Color x:Key="TextColorDarker">{{muted-foreground}}</Color>
    <Color x:Key="TextColorDark">{{primary-foreground}}</Color>
    <Color x:Key="MainColor">{{secondary}}</Color>
    <Color x:Key="MainColorDark">{{card}}</Color>
    <Color x:Key="HoverColor">{{accent}}</Color>
    <Color x:Key="GlyphColor">{{primary}}</Color>
    <Color x:Key="HighlightGlyphColor">{{primary/50}}</Color>
    <Color x:Key="PopupBackgroundColor">{{popover?card}}</Color>
    <Color x:Key="PopupBorderColor">{{border@popover?border@card}}</Color>
    <Color x:Key="BackgroundToneColor">{{card}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>     <!-- no frame around covers -->
    <Color x:Key="PanelSeparatorColor">#00000000</Color>         <!-- no lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{border}}</Color>
    <Color x:Key="DataChangeNotifColor">#FFF59E0B</Color>        <!-- Tailwind amber-500; shadcn has no warning token -->

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{DynamicResource ShadcnInputColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource ShadcnAccentColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{DynamicResource ShadcnForegroundColor}" />   <!-- Tooltip bg-foreground -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource ShadcnCardColor}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource ShadcnInput30Color}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="#FF4ADE80" />    <!-- Tailwind green-400 -->
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{DynamicResource ShadcnDestructiveColor}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="#FFFACC15" />       <!-- Tailwind yellow-400 -->

    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource ShadcnDestructiveColor}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{DynamicResource ShadcnCardColor}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{DynamicResource ShadcnBackgroundColor}" />
</ResourceDictionary>
