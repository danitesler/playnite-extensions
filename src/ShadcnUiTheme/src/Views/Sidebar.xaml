<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    shadcn Sidebar, collapsible="icon" inside the inset layout: no fill of its own (the window frame is the sidebar
    surface, Views/MainWindow.xaml) and no border. 16px padding puts the 32px menu buttons on the frame and the main
    menu tile level with the card's header. The main menu is the SidebarHeader logo tile: a rounded-lg primary square
    with the gamepad icon.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ShadcnLogoTile" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnRadiusLg}" />
        <Setter Property="Background" Value="{DynamicResource ShadcnPrimaryBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ShadcnPrimaryForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShadcnPrimaryHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="Transparent" Padding="16"
                            Margin="{TemplateBinding Padding}">
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource ShadcnLogoTile}"
                                    DockPanel.Dock="Top" Margin="0,0,0,16">
                                <ContentPresenter Width="16" Height="16"
                                                  Content="{DynamicResource ShadcnIconMainMenu}"
                                                  ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
                            </Border>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- On the right the title bar buttons sit above the sidebar. -->
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,40,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Padding" Value="16,8,16,8" TargetName="BorderContentHolder" />
                            <Setter Property="Margin" Value="0,0,16,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,124,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Padding" Value="16,8,16,8" TargetName="BorderContentHolder" />
                            <Setter Property="Margin" Value="0,0,16,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
