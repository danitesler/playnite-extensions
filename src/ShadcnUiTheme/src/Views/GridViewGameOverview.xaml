<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml (grid mode, side panel).
    The shadcn/ui page stacked for a narrow column (16px gutters): the name (text-xl font-bold) with the icon, the
    developer in text-muted-foreground, the actions (Play or Install filling the width, More, icon Button Edit), a
    Separator, platform and genre Badges, then the same Tabs: Description (description and Notes Cards) and Details
    (a Card with the Table, 110px label cells).
    The panel edge follows Playnite's panel settings. Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <DockPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DockPanel.Resources>

                            <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,12,12,0"
                                    Content="r" FontFamily="Marlett"
                                    Style="{DynamicResource SimpleButton}"
                                    Command="{MainViewModel CloseGameSideBarCommand}" />

                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCErrorNoGameSelected}"
                                       Margin="16,24,16,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrushDarker}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,0,16,24">
                                        <Image x:Name="PART_ImageCover" HorizontalAlignment="Center" Margin="0,0,0,16"
                                               Stretch="Uniform" StretchDirection="Both" MaxHeight="280"
                                               RenderOptions.BitmapScalingMode="Fant"
                                               Tag="{DynamicResource ShowCoverImage}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                            <DataTrigger.Value>
                                                                <sys:Boolean>False</sys:Boolean>
                                                            </DataTrigger.Value>
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <DockPanel>
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeLarger}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>
                                        <ItemsControl x:Name="PART_ItemsDevelopers" Tag="Muted" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Content="{DynamicResource LOCMoreAction}" Margin="8,0,0,0" />
                                            <Button x:Name="PART_ButtonEditGame" Width="36" Height="36" Padding="0" Focusable="False" Margin="8,0,0,0">
                                                <ContentPresenter Width="16" Height="16"
                                                                  Content="{DynamicResource IconEdit}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                        <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,16" />
                                        <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <Grid x:Name="OverviewLayoutGrid" Tag="{DynamicResource OverviewDetailsAsTab}" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <TabControl x:Name="OverviewTabs" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                        SelectedIndex="0" VerticalAlignment="Top" Margin="0,0,0,12">
                                                <TabControl.Style>
                                                    <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=OverviewLayoutGrid}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TabControl.Style>
                                                <TabItem Header="{DynamicResource LOCGameDescriptionTitle}" />
                                                <TabItem Header="{DynamicResource LOCGameDetails}" />
                                            </TabControl>

                                            <StackPanel x:Name="DescriptionPanel" Grid.Row="1" Grid.Column="0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Tag, ElementName=OverviewLayoutGrid}" Value="True" />
                                                                    <Condition Binding="{Binding SelectedIndex, ElementName=OverviewTabs}" Value="1" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <GroupBox x:Name="PART_ElemDescription" Header="{DynamicResource LOCGameDescriptionTitle}">
                                                    <HtmlTextView x:Name="PART_HtmlDescription"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"
                                                                  Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </GroupBox>
                                                <GroupBox Header="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" Margin="0,16,0,0"
                                                          Visibility="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                </GroupBox>
                                                <GroupBox x:Name="PART_ElemNotes" Header="{DynamicResource LOCNotesLabel}" Margin="0,16,0,0">
                                                    <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                             Background="{DynamicResource ControlBackgroundBrush}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" />
                                                </GroupBox>
                                            </StackPanel>

                                            <GroupBox x:Name="DetailsPanel" Grid.Row="1" Header="{DynamicResource LOCGameDetails}">
                                                <GroupBox.Style>
                                                    <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                                                        <Setter Property="Grid.Column" Value="1" />
                                                        <Setter Property="Width" Value="260" />
                                                        <Setter Property="Margin" Value="16,0,0,0" />
                                                        <Setter Property="VerticalAlignment" Value="Top" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, ElementName=OverviewLayoutGrid}" Value="True">
                                                                <Setter Property="Grid.Column" Value="0" />
                                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                <Setter Property="Width" Value="Auto" />
                                                                <Setter Property="Margin" Value="0" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Tag, ElementName=OverviewLayoutGrid}" Value="True" />
                                                                    <Condition Binding="{Binding SelectedIndex, ElementName=OverviewTabs}" Value="0" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </GroupBox.Style>
                                                <StackPanel Margin="-8,-10,-8,-10">
                                                    <Border x:Name="PART_ElemPlayTime" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,10,8,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCTimePlayed}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock Grid.Column="1" x:Name="PART_TextPlayTime" />
                                                        </Grid>
                                                    </Border>
                                                    <Border x:Name="PART_ElemLastPlayed" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,10,8,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCLastPlayed}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock Grid.Column="1" x:Name="PART_TextLastActivity" />
                                                        </Grid>
                                                    </Border>
                                                    <Border x:Name="PART_ElemCompletionStatus" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,10,8,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <Button Grid.Column="1" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </Grid>
                                                    </Border>
                                                    <Border x:Name="PART_ElemReleaseDate" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,10,8,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <Button Grid.Column="1" x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </Grid>
                                                    </Border>
                                                    <Border x:Name="PART_ElemPublishers" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,10,8,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCPublisherLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl Grid.Column="1" x:Name="PART_ItemsPublishers" />
                                                        </Grid>
                                                    </Border>
                                                    <Border x:Name="PART_ElemLibrary" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,10,8,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCGameProviderTitle}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <Button Grid.Column="1" x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </Grid>
                                                    </Border>
                                                    <Border x:Name="PART_ElemLinks" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0" Padding="8,10,8,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource LOCLinksLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl Grid.Column="1" x:Name="PART_ItemsLinks" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </GroupBox>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
