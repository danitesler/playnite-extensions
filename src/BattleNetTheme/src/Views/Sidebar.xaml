<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    The Battle.net app bar: 56px in the frame color with a 1px divider under it. At the left the logo button opens the
    main menu (in the client the logo opens its menu too): a blue spiral and the PLAYNITE wordmark. Next to it come the
    tabs (CustomControls/SidebarItem.xaml). The right 140px stay clear for the window buttons.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts. Only the top layout is implemented.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The logo button: a hover fill behind the mark and wordmark; also used by Views/TopPanel.xaml. -->
    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="10,0,12,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="Root" Height="56"
                            Background="{DynamicResource TopPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1">
                        <DockPanel x:Name="DockContentHolder" Margin="{TemplateBinding Padding}">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                    DockPanel.Dock="Left" Margin="12,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentPresenter Width="28" Height="28"
                                                      Content="{DynamicResource IconMainMenu}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                    <TextBlock Text="PLAYNITE" Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                               FontFamily="{DynamicResource FontFamily}"
                                               Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Left" CanContentScroll="True" Margin="0,0,140,0"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Horizontal" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemMainMenu}" Value="Collapsed">
                            <Setter Property="Margin" Value="12,0,140,0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
