<!--
    Mui kit override of Shadcn/Desktop/Common.xaml (whole file replaced, so PopupBorder is repeated).
    Material shows keyboard focus as a state layer, not a ring: ShadcnFocusVisual fills the control with
    action.focus (focus-overlay).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnPopupRadius}" />
    </Style>

    <Style x:Key="ShadcnFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border IsHitTestVisible="False" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource ShadcnRadiusMd}"
                            Background="{DynamicResource ShadcnFocusOverlayBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Control metrics for MUI v7 (8px spacing unit). Kit controls read these with DynamicResource, so each kit
        sets its design system's spacing here instead of replacing whole control files.
    -->
    <Thickness x:Key="ShadcnButtonPadding">16,9,16,8</Thickness> <!-- contained Button medium: 6px 16px at a 24.5px line = 36.5px tall -->
    <Thickness x:Key="ShadcnInputPadding">12,10,12,10</Thickness> <!-- FilledInput small, hidden label: 40px tall, 12px sides -->
    <CornerRadius x:Key="ShadcnPopupRadius">4</CornerRadius> <!-- Paper shape.borderRadius -->
    <CornerRadius x:Key="ShadcnFieldRadius">4,4,0,0</CornerRadius> <!-- FilledInput: rounded top, square bottom -->
    <Thickness x:Key="ShadcnFieldBorderThickness">0,0,0,1</Thickness> <!-- FilledInput: underline only -->
    <Thickness x:Key="ShadcnMenuPadding">0,8,0,8</Thickness> <!-- MenuList padding 8px 0 -->
    <Thickness x:Key="ShadcnMenuItemPadding">16,9,16,8</Thickness> <!-- MenuItem 6px 16px at a 24px line = 36px -->
    <CornerRadius x:Key="ShadcnMenuItemRadius">0</CornerRadius> <!-- MenuItem is square, full width -->
    <Thickness x:Key="ShadcnListItemPadding">16,8,16,8</Thickness> <!-- ListItemButton 8px 16px -->
    <CornerRadius x:Key="ShadcnCardRadius">4</CornerRadius> <!-- Card (Paper) shape.borderRadius -->
    <Thickness x:Key="ShadcnCardPadding">16</Thickness> <!-- CardContent / CardHeader 16px -->
    <Thickness x:Key="ShadcnCardTitleMargin">0,0,0,16</Thickness> <!-- CardHeader to CardContent -->
    <sys:Double x:Key="ShadcnIconSize">24</sys:Double> <!-- SvgIcon medium -->
    <Thickness x:Key="ShadcnTooltipPadding">8,4,8,4</Thickness> <!-- Tooltip 4px 8px -->
</ResourceDictionary>
