<!-- Overlay on Playnite Default/Common.xaml: only restyled keys live here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Popover Paper: elevation 8 (PopupBackgroundBrush), shape.borderRadius. MUI lifts it with shadow 8; a 1px
         divider edge stands in for the shadow on WPF's layered popups. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- ButtonBase focusVisible: Material shows keyboard focus as a state layer, not a ring. The control is filled
         with action.focus (WPF shows FocusVisualStyle for keyboard focus only). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border IsHitTestVisible="False" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing (theme.spacing: 8px unit), keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">16,9,16,8</Thickness> <!-- Button contained, medium: 6px 16px at a 24.5px line = 36.5px tall -->
    <Thickness x:Key="InputPadding">12,10,12,10</Thickness> <!-- FilledInput size small, hiddenLabel: 40px tall, 12px sides -->
    <Thickness x:Key="InputBorderThickness">0,0,0,1</Thickness> <!-- FilledInput: the bottom line only -->
    <Thickness x:Key="MenuPadding">0,8,0,8</Thickness> <!-- MenuList padding 8px 0 -->
    <Thickness x:Key="MenuItemPadding">16,9,16,8</Thickness> <!-- MenuItem 6px 16px at a 24px line = 36px (minHeight auto from sm up) -->
    <Thickness x:Key="ComboBoxDropDownPadding">0,8,0,8</Thickness> <!-- Select opens a Menu: MenuList padding 8px 0 -->
    <Thickness x:Key="ComboBoxItemPadding">16,9,16,8</Thickness> <!-- MenuItem 6px 16px -->
    <Thickness x:Key="ListBoxItemPadding">16,8,16,8</Thickness> <!-- ListItemButton 8px 16px -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness> <!-- CardHeader / CardContent padding 16px -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,16</Thickness> <!-- CardHeader to CardContent -->
    <sys:Double x:Key="IconSize">24</sys:Double> <!-- SvgIcon fontSize medium -->
    <Thickness x:Key="TooltipPadding">8,4,8,4</Thickness> <!-- Tooltip 4px 8px -->
</ResourceDictionary>
