<!--
    Overlay on Playnite Default/DefaultControls/Thumb.xaml (thumbs outside scroll bars).
    The same Material dark thumb as DefaultControls/ScrollViewer.xaml: text.primary at 26% (action.disabled strength)
    with shape.borderRadius corners, 50% on hover and 70% (text.secondary strength) while dragging.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource MuiTextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bar" MinHeight="10" SnapsToDevicePixels="True" Opacity="0.26"
                            CornerRadius="{DynamicResource MuiShapeBorderRadius}"
                            Background="{TemplateBinding Background}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.5" TargetName="Bar" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Opacity" Value="0.7" TargetName="Bar" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
