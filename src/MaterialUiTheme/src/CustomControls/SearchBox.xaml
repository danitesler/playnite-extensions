<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    MUI FilledInput with a start adornment (search icon), like DefaultControls/TextBox.xaml: white 9% fill, rounded
    top, 1px underline, 2px primary underline growing from the center on focus. The app bar search in
    Views/TopPanel.xaml has its own template.
    Playnite's code hides PART_SeachIcon while the box has focus or text, so it carries the "Search" placeholder.
    ShowImage="False" (filter panel fields) drops the icon. PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon
    are Playnite's parts (all three must exist).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Background" Value="{DynamicResource MuiFilledInputBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MuiFilledInputUnderlineBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource MuiFilledInputBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource MuiTextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Chrome" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource MuiFilledInputRadius}">
                            <Grid>
                                <ContentControl x:Name="Glyph" Margin="12,0,0,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                                Foreground="{DynamicResource MuiTextSecondaryBrush}"
                                                ContentTemplate="{DynamicResource SearchTextIconTemplate}" />
                                <TextBlock x:Name="PART_SeachIcon" Margin="40,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource BaseTextBlockStyle}"
                                           Foreground="{DynamicResource MuiTextSecondaryBrush}"
                                           Text="{DynamicResource LOCSearchLabel}" />
                                <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource MuiBareTextBox}"
                                         VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                         Padding="38,0,36,0" />
                                <ContentControl x:Name="PART_ClearTextIcon" Margin="0,0,10,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                                Background="Transparent"
                                                Foreground="{DynamicResource MuiTextSecondaryBrush}"
                                                ContentTemplate="{DynamicResource ClearTextIconTemplate}" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusLine" Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                Background="{DynamicResource MuiPrimaryMainBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MuiFilledInputHoverBgBrush}" TargetName="Chrome" />
                            <Setter Property="BorderBrush" Value="{DynamicResource MuiTextPrimaryBrush}" TargetName="Chrome" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MuiFilledInputBgBrush}" TargetName="Chrome" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusLine" To="1" Duration="0:0:0.2"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusLine" To="0" Duration="0:0:0.2"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glyph" />
                            <Setter Property="Padding" Value="10,0,36,0" TargetName="PART_TextInpuText" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
