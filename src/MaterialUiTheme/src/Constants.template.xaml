<!--
    Material UI Theme: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from
    tokens.css (MUI's CSS variables) and writes the result to the build as Constants.xaml.

    Keys follow theme.palette paths: palette.background.paper is MuiBackgroundPaperColor / MuiBackgroundPaperBrush,
    palette.FilledInput.bg is MuiFilledInputBg. Paper at elevation N (dark mode: the white overlay on
    background.default) is MuiPaperElevationN. alpha(primary.main, action.selectedOpacity) and friends are
    MuiPrimarySelected / MuiPrimaryHover / MuiPrimarySelectedHover.
    Action and text colors keep their alpha, as in MUI; popup surfaces and edges are flattened onto
    background.default, because WPF popups are layered windows.

    Theme XAML reads these keys with DynamicResource only: Playnite parses each theme file on its own before merging.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): MUI's type scale is Roboto; Roboto is not bundled (Toolbox drops Fonts/), so
         Segoe UI. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys) -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:mui-shape-borderRadius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- theme.shape -->
    <CornerRadius x:Key="MuiShapeBorderRadius">{{px:mui-shape-borderRadius}}</CornerRadius>
    <CornerRadius x:Key="MuiRadiusCircular">9999</CornerRadius>                              <!-- borderRadius: '50%' (IconButton, Radio) -->
    <CornerRadius x:Key="MuiFilledInputRadius">{{px:mui-shape-borderRadius}},{{px:mui-shape-borderRadius}},0,0</CornerRadius>

    <!-- theme.palette -->
    <Color x:Key="MuiPrimaryMainColor">{{mui-palette-primary-main}}</Color>
    <Color x:Key="MuiPrimaryDarkColor">{{mui-palette-primary-dark}}</Color>
    <Color x:Key="MuiPrimaryContrastTextColor">{{mui-palette-primary-contrastText@mui-palette-primary-main}}</Color>
    <Color x:Key="MuiErrorMainColor">{{mui-palette-error-main}}</Color>
    <Color x:Key="MuiErrorContrastTextColor">{{mui-palette-error-contrastText}}</Color>
    <Color x:Key="MuiWarningMainColor">{{mui-palette-warning-main}}</Color>
    <Color x:Key="MuiSuccessMainColor">{{mui-palette-success-main}}</Color>
    <Color x:Key="MuiCommonWhiteColor">{{mui-palette-common-white}}</Color>
    <Color x:Key="MuiBackgroundDefaultColor">{{mui-palette-background-default}}</Color>
    <Color x:Key="MuiBackgroundPaperColor">{{mui-palette-background-paper}}</Color>
    <Color x:Key="MuiTextPrimaryColor">{{mui-palette-text-primary}}</Color>
    <Color x:Key="MuiTextSecondaryColor">{{mui-palette-text-secondary}}</Color>
    <Color x:Key="MuiDividerColor">{{mui-palette-divider}}</Color>
    <Color x:Key="MuiActionActiveColor">{{mui-palette-action-active}}</Color>
    <Color x:Key="MuiActionHoverColor">{{mui-palette-action-hover}}</Color>
    <Color x:Key="MuiActionSelectedColor">{{mui-palette-action-selected}}</Color>
    <Color x:Key="MuiActionFocusColor">{{mui-palette-action-focus}}</Color>
    <Color x:Key="MuiFilledInputBgColor">{{mui-palette-FilledInput-bg}}</Color>
    <Color x:Key="MuiFilledInputHoverBgColor">{{mui-palette-FilledInput-hoverBg}}</Color>
    <Color x:Key="MuiTooltipBgColor">{{mui-palette-Tooltip-bg@mui-palette-background-default}}</Color>
    <Color x:Key="MuiLinearProgressPrimaryBgColor">{{mui-palette-LinearProgress-primaryBg}}</Color>

    <!-- Paper surfaces in dark mode: background.paper with the elevation overlay -->
    <Color x:Key="MuiPaperElevation1Color">{{mui-overlays-1@mui-palette-background-paper}}</Color>  <!-- Card -->
    <Color x:Key="MuiPaperElevation4Color">{{mui-overlays-4@mui-palette-background-paper}}</Color>  <!-- AppBar -->
    <Color x:Key="MuiPaperElevation8Color">{{mui-overlays-8@mui-palette-background-paper}}</Color>  <!-- Menu, Popover -->

    <!-- Colors MUI's components hard-code or derive -->
    <Color x:Key="MuiOutlinedInputBorderColor">{{mui-OutlinedInput-border}}</Color>
    <Color x:Key="MuiFilledInputUnderlineColor">{{mui-FilledInput-underline}}</Color>
    <Color x:Key="MuiAppBarSearchBgColor">{{mui-AppBar-search-bg}}</Color>
    <Color x:Key="MuiAppBarSearchHoverBgColor">{{mui-AppBar-search-hoverBg}}</Color>
    <Color x:Key="MuiPrimaryOutlinedBorderColor">{{mui-palette-primary-main/50}}</Color>     <!-- Button outlined: alpha(primary.main, 0.5) -->
    <Color x:Key="MuiPrimaryHoverColor">{{mui-palette-primary-main/8}}</Color>                  <!-- alpha(primary.main, hoverOpacity) -->
    <Color x:Key="MuiPrimarySelectedColor">{{mui-palette-primary-main/16}}</Color>              <!-- alpha(primary.main, selectedOpacity) -->
    <Color x:Key="MuiPrimarySelectedHoverColor">{{mui-palette-primary-main/24}}</Color>         <!-- selectedOpacity + hoverOpacity -->

    <SolidColorBrush x:Key="MuiPrimaryMainBrush" Color="{DynamicResource MuiPrimaryMainColor}" />
    <SolidColorBrush x:Key="MuiPrimaryDarkBrush" Color="{DynamicResource MuiPrimaryDarkColor}" />
    <SolidColorBrush x:Key="MuiPrimaryContrastTextBrush" Color="{DynamicResource MuiPrimaryContrastTextColor}" />
    <SolidColorBrush x:Key="MuiErrorMainBrush" Color="{DynamicResource MuiErrorMainColor}" />
    <SolidColorBrush x:Key="MuiErrorContrastTextBrush" Color="{DynamicResource MuiErrorContrastTextColor}" />
    <SolidColorBrush x:Key="MuiWarningMainBrush" Color="{DynamicResource MuiWarningMainColor}" />
    <SolidColorBrush x:Key="MuiSuccessMainBrush" Color="{DynamicResource MuiSuccessMainColor}" />
    <SolidColorBrush x:Key="MuiCommonWhiteBrush" Color="{DynamicResource MuiCommonWhiteColor}" />
    <SolidColorBrush x:Key="MuiBackgroundDefaultBrush" Color="{DynamicResource MuiBackgroundDefaultColor}" />
    <SolidColorBrush x:Key="MuiBackgroundPaperBrush" Color="{DynamicResource MuiBackgroundPaperColor}" />
    <SolidColorBrush x:Key="MuiTextPrimaryBrush" Color="{DynamicResource MuiTextPrimaryColor}" />
    <SolidColorBrush x:Key="MuiTextSecondaryBrush" Color="{DynamicResource MuiTextSecondaryColor}" />
    <SolidColorBrush x:Key="MuiDividerBrush" Color="{DynamicResource MuiDividerColor}" />
    <SolidColorBrush x:Key="MuiActionActiveBrush" Color="{DynamicResource MuiActionActiveColor}" />
    <SolidColorBrush x:Key="MuiActionHoverBrush" Color="{DynamicResource MuiActionHoverColor}" />
    <SolidColorBrush x:Key="MuiActionSelectedBrush" Color="{DynamicResource MuiActionSelectedColor}" />
    <SolidColorBrush x:Key="MuiActionFocusBrush" Color="{DynamicResource MuiActionFocusColor}" />
    <SolidColorBrush x:Key="MuiFilledInputBgBrush" Color="{DynamicResource MuiFilledInputBgColor}" />
    <SolidColorBrush x:Key="MuiFilledInputHoverBgBrush" Color="{DynamicResource MuiFilledInputHoverBgColor}" />
    <SolidColorBrush x:Key="MuiTooltipBgBrush" Color="{DynamicResource MuiTooltipBgColor}" />
    <SolidColorBrush x:Key="MuiLinearProgressPrimaryBgBrush" Color="{DynamicResource MuiLinearProgressPrimaryBgColor}" />
    <SolidColorBrush x:Key="MuiPaperElevation1Brush" Color="{DynamicResource MuiPaperElevation1Color}" />
    <SolidColorBrush x:Key="MuiPaperElevation4Brush" Color="{DynamicResource MuiPaperElevation4Color}" />
    <SolidColorBrush x:Key="MuiPaperElevation8Brush" Color="{DynamicResource MuiPaperElevation8Color}" />
    <SolidColorBrush x:Key="MuiOutlinedInputBorderBrush" Color="{DynamicResource MuiOutlinedInputBorderColor}" />
    <SolidColorBrush x:Key="MuiFilledInputUnderlineBrush" Color="{DynamicResource MuiFilledInputUnderlineColor}" />
    <SolidColorBrush x:Key="MuiAppBarSearchBgBrush" Color="{DynamicResource MuiAppBarSearchBgColor}" />
    <SolidColorBrush x:Key="MuiAppBarSearchHoverBgBrush" Color="{DynamicResource MuiAppBarSearchHoverBgColor}" />
    <SolidColorBrush x:Key="MuiPrimaryOutlinedBorderBrush" Color="{DynamicResource MuiPrimaryOutlinedBorderColor}" />
    <SolidColorBrush x:Key="MuiPrimaryHoverBrush" Color="{DynamicResource MuiPrimaryHoverColor}" />
    <SolidColorBrush x:Key="MuiPrimarySelectedBrush" Color="{DynamicResource MuiPrimarySelectedColor}" />
    <SolidColorBrush x:Key="MuiPrimarySelectedHoverBrush" Color="{DynamicResource MuiPrimarySelectedHoverColor}" />

    <!--
        Playnite palette keys, mapped to MUI's palette. Every Playnite view and control the theme does not restyle reads
        these. GlyphColor = primary.main and TextColorDark = primary.contrastText: Playnite always pairs those two
        (selected rows, play button).
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{mui-palette-text-primary}}</Color>
    <Color x:Key="TextColorDarker">{{mui-palette-text-secondary@mui-palette-background-default}}</Color>
    <Color x:Key="TextColorDark">{{mui-palette-primary-contrastText@mui-palette-primary-main}}</Color>
    <Color x:Key="MainColor">{{mui-palette-action-disabledBackground@mui-palette-background-default}}</Color>
    <Color x:Key="MainColorDark">{{mui-overlays-1@mui-palette-background-paper}}</Color>
    <Color x:Key="HoverColor">{{mui-palette-action-hover@mui-palette-background-default}}</Color>
    <Color x:Key="GlyphColor">{{mui-palette-primary-main}}</Color>
    <Color x:Key="HighlightGlyphColor">{{mui-palette-primary-main/50}}</Color>
    <Color x:Key="PopupBackgroundColor">{{mui-overlays-8@mui-palette-background-paper}}</Color>
    <Color x:Key="PopupBorderColor">{{mui-palette-divider@mui-overlays-8@mui-palette-background-paper}}</Color>
    <Color x:Key="BackgroundToneColor">{{mui-overlays-1@mui-palette-background-paper}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>     <!-- no frame around covers -->
    <Color x:Key="PanelSeparatorColor">#00000000</Color>         <!-- no lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{mui-palette-divider@mui-palette-background-default}}</Color>
    <Color x:Key="DataChangeNotifColor">{{mui-palette-warning-main}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{DynamicResource MuiOutlinedInputBorderColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource MuiActionHoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{DynamicResource MuiTooltipBgColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource MuiPaperElevation1Color}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource MuiFilledInputBgColor}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{DynamicResource MuiSuccessMainColor}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{DynamicResource MuiErrorMainColor}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{DynamicResource MuiWarningMainColor}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource MuiErrorMainColor}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{DynamicResource MuiPaperElevation1Color}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{DynamicResource MuiBackgroundDefaultColor}" />
</ResourceDictionary>
