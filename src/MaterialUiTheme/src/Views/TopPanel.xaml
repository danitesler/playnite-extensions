<!--
    Overlay on Playnite Default/Views/TopPanel.xaml.
    MUI AppBar (position="static", elevation 4) with a regular Toolbar: 64px on the Paper color at elevation 4 (the
    only raised surface in the theme), 16px gutters, no divider. The search is the classic app bar search: a
    white 15% field (25% on hover) with the icon inside, no border, that widens from 240px to 360px while focused.
    Icon buttons are 40px circles with 24px Material icons: view controls on the right, then filters and notifications,
    where MUI Badges replace text: a primary dot while a filter applies, an error count for notifications.
    TopPanelMenu, the toggles and the icon templates keep Playnite's keys. All PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconViewSettings}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconFilterPresets}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconGroup}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconSort}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconDetailsView}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconGridView}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconListView}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" TextElement.Foreground="{DynamicResource WarningBrush}" Content="{DynamicResource MuiIconUpdate}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconExplorer}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconRandom}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconViewRandom}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconSearch}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
    </DataTemplate>

    <!-- Looked up from code for the main menu; the MUI Menu paper of DefaultControls/ContextMenu.xaml. -->
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <!-- IconButton with a Badge variant="dot" (primary) while a filter applies; primary icon while the panel is open. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource MuiTextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource MuiRadiusCircular}">
                        <Grid>
                            <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconFilter}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
                            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,8,8,0" Visibility="Collapsed"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Fill="{DynamicResource MuiPrimaryMainBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="Dot" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MuiActionHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MuiPrimaryMainBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- IconButton with a standard Badge (error color, 20px pill); hidden while there is nothing to show. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MuiTextPrimaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource MuiRadiusCircular}">
                        <Grid>
                            <ContentPresenter Width="{DynamicResource MuiSvgIconSize}" Height="{DynamicResource MuiSvgIconSize}" Content="{DynamicResource MuiIconNotifications}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
                            <Border CornerRadius="10" MinWidth="20" Height="20" Padding="6,0,6,0"
                                    Margin="0,-2,-4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource MuiErrorMainBrush}">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="{DynamicResource FontSizeSmall}"
                                           FontWeight="Medium" Foreground="{DynamicResource MuiTextPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MuiActionHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MuiPrimaryMainBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- App bar search (MUI's "Search" + "StyledInputBase" example). -->
    <Style x:Key="MuiAppBarSearch" TargetType="{x:Type SearchBox}">
        <Setter Property="Width" Value="240" />
        <Setter Property="Height" Value="40" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource MuiAppBarSearchBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MuiTextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource MuiShapeBorderRadius}">
                        <Grid>
                            <ContentControl x:Name="Glyph" Margin="16,0,0,0" Focusable="False" IsTabStop="False"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                            Content="{DynamicResource MuiIconSearch}"
                                            ContentTemplate="{DynamicResource MuiIconTemplate}"
                                            Width="24" Height="24" />
                            <TextBlock x:Name="PART_SeachIcon" Margin="56,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Opacity="0.5" TextTrimming="CharacterEllipsis"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{DynamicResource LOCSearchLabel}" />
                            <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource MuiBareTextBox}"
                                     VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                     Padding="54,0,40,0" />
                            <ContentControl x:Name="PART_ClearTextIcon" Margin="0,0,12,0" Focusable="False" IsTabStop="False"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                            Background="Transparent"
                                            ContentTemplate="{DynamicResource ClearTextIconTemplate}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MuiAppBarSearchHoverBgBrush}" TargetName="Chrome" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width" To="360" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width" To="240" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <!-- Right padding: the window buttons (12px + 3 x 40px) + 8px gap. -->
                    <Border Height="64" Padding="16,0,140,0" Background="{DynamicResource MuiPaperElevation4Brush}">
                        <DockPanel>
                            <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource MuiMenuIconButton}"
                                    DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center">
                                <ContentPresenter Width="24" Height="24" Content="{DynamicResource MuiIconMainMenu}" ContentTemplate="{DynamicResource MuiIconTemplate}" />
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch" DockPanel.Dock="Left"
                                       Style="{StaticResource MuiAppBarSearch}"
                                       WindowChrome.IsHitTestVisibleInChrome="True" />

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <CheckBox x:Name="PART_ToggleNotifications" DockPanel.Dock="Right"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" />

                            <CheckBox x:Name="PART_ToggleFilter" DockPanel.Dock="Right"
                                      ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" />

                            <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" DockPanel.Dock="Right" />

                            <!-- LinearProgress (4px) under a caption line. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="24,0,24,0">
                                <StackPanel MaxWidth="480" MinWidth="240" VerticalAlignment="Center">
                                    <TextBlock Name="PART_TextProgressText" Margin="0,0,0,6"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource MuiTextSecondaryBrush}"
                                               Style="{DynamicResource BaseTextBlockStyle}" />
                                    <ProgressBar Name="PART_ProgressGlobal" Height="4" />
                                </StackPanel>
                                <Button Name="PART_ButtonProgressCancel"
                                        Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Margin="16,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
