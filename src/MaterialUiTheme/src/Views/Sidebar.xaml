<!--
    Mui kit override of Shadcn/Desktop/Views/Sidebar.xaml.
    MUI permanent Drawer, mini variant (closed): 64px wide on background.default, no divider. Its top 64px is painted
    with the app bar color and holds the menu IconButton (PART_ElemMainMenu), so the app bar reads as one bar across
    the window (the "clipped" drawer layout). List items below start after the List's 8px padding.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- IconButton, medium: 40px circle, 24px icon, action.hover on hover. Also used by Views/TopPanel.xaml. -->
    <Style x:Key="ShadcnLogoTile" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnRadiusFull}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid x:Name="Root" Background="Transparent" Margin="{TemplateBinding Padding}">
                        <Border x:Name="HeaderBand" Height="64" VerticalAlignment="Top"
                                Background="{DynamicResource ShadcnHeaderBrush}" />
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource ShadcnLogoTile}"
                                    DockPanel.Dock="Top" Margin="0,12,0,12" HorizontalAlignment="Center">
                                <ContentPresenter Width="24" Height="24" Content="{DynamicResource ShadcnIconMainMenu}" ContentTemplate="{DynamicResource ShadcnIconTemplate}" />
                            </Border>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True" Padding="0,8,0,8"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Menu shown on the app bar instead: keep the list below the band. -->
                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemMainMenu}" Value="Collapsed">
                            <Setter Property="Margin" Value="0,64,0,0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <!-- On the right the window buttons take the band; the menu button moves under it. -->
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Margin" Value="0,76,0,12" TargetName="PART_ElemMainMenu" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Background" Value="{DynamicResource ShadcnHeaderBrush}" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderBand" />
                            <Setter Property="Margin" Value="12,12,8,12" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Padding" Value="0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,140,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderBand" />
                            <Setter Property="Margin" Value="12,4,8,4" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Padding" Value="0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
