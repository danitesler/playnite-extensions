<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details mode, right pane).
    Material Design's media detail page (Google Play's app page, in MUI parts). Hero: the background art, 360px,
    under a scrim that fades into background.default; hidden when there is no art. The content column (max 1100px,
    24px gutters) starts 200px down so the header overlaps the hero: the cover (Playnite's cover height setting) and,
    beside it, the title as Typography h4 (regular weight), the developer as a primary Link, genres as small filled
    Chips, then the actions: contained Play (or Install), text Button More, IconButton Edit (40px circle, 24px icon,
    action hover).
    Below, two Cards (GroupBox: Paper elevation 1): Description (and a Notes card) on the left; on the right a 360px
    Details card holding a List: ListItemIcon (24px Material Icon, text.secondary, 56px slot) and ListItemText (value as
    primary at 15px, field name as secondary in text.secondary).
    Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>

                            <!-- Hero: background art under a scrim that fades into background.default -->
                            <Grid x:Name="Hero" Height="360" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Fill="{DynamicResource WindowBackgourndBrush}">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#33000000" Offset="0" />
                                            <GradientStop Color="#99000000" Offset="0.55" />
                                            <GradientStop Color="#FF000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>

                            <StackPanel MaxWidth="1100" VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Margin" Value="24,24,24,32" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=Hero}" Value="Visible">
                                                <Setter Property="Margin" Value="24,200,24,32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Header: cover card, then title (h4), developer link, chips and actions -->
                                <DockPanel>
                                    <Image x:Name="PART_ImageCover" DockPanel.Dock="Left" Margin="0,0,24,0" VerticalAlignment="Bottom"
                                           Height="{Settings GameDetailsCoverHeight}" Stretch="Uniform" StretchDirection="Both"
                                           RenderOptions.BitmapScalingMode="Fant" />
                                    <StackPanel VerticalAlignment="Bottom">
                                        <DockPanel>
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeLargest}"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>
                                        <ItemsControl x:Name="PART_ItemsDevelopers" Tag="Accent" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,16,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Content="{DynamicResource LOCMoreAction}"
                                                    Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusFull}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <ContentPresenter Width="24" Height="24"
                                                                  Content="{DynamicResource IconEdit}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Cards: About (description, notes) and Details (List) -->
                                <Grid Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="240" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <GroupBox x:Name="PART_ElemDescription" Header="{DynamicResource LOCGameDescriptionTitle}">
                                            <HtmlTextView x:Name="PART_HtmlDescription"
                                                          TextElement.Foreground="{DynamicResource TextBrush}"
                                                          Tag="{DynamicResource GlyphBrush}"
                                                          HtmlFontSize="{DynamicResource FontSize}"
                                                          HtmlFontFamily="{DynamicResource FontFamily}"
                                                          HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                          LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                        </GroupBox>
                                        <GroupBox x:Name="PART_ElemNotes" Header="{DynamicResource LOCNotesLabel}" Margin="0,16,0,0">
                                            <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                     Background="{DynamicResource ControlBackgroundBrush}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" />
                                        </GroupBox>
                                    </StackPanel>
                                    <GroupBox Grid.Column="2" VerticalAlignment="Top" Header="{DynamicResource LOCGameDetails}">
                                        <StackPanel Margin="0,-8,0,-8">
                                            <DockPanel x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                  Content="{DynamicResource IconPlayTime}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="PART_TextPlayTime" FontSize="{DynamicResource FontSizeLarge}" />
                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSize}"
                                                               Foreground="{DynamicResource TextBrushDarker}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                  Content="{DynamicResource IconLastPlayed}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="PART_TextLastActivity" FontSize="{DynamicResource FontSizeLarge}" />
                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSize}"
                                                               Foreground="{DynamicResource TextBrushDarker}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                  Content="{DynamicResource IconCompletionStatus}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSize}"
                                                               Foreground="{DynamicResource TextBrushDarker}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel x:Name="PART_ElemPlatform" Margin="0,8,0,8">
                                                <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                  Content="{DynamicResource IconPlatform}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <ItemsControl x:Name="PART_ItemsPlatforms" />
                                                    <TextBlock Text="{DynamicResource LOCPlatformTitle}" FontSize="{DynamicResource FontSize}"
                                                               Foreground="{DynamicResource TextBrushDarker}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                  Content="{DynamicResource IconPublisher}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <ItemsControl x:Name="PART_ItemsPublishers" />
                                                    <TextBlock Text="{DynamicResource LOCPublisherLabel}" FontSize="{DynamicResource FontSize}"
                                                               Foreground="{DynamicResource TextBrushDarker}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                  Content="{DynamicResource IconReleaseDate}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                    <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" FontSize="{DynamicResource FontSize}"
                                                               Foreground="{DynamicResource TextBrushDarker}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel x:Name="PART_ElemLibrary" Margin="0,8,0,8">
                                                <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                  Content="{DynamicResource IconGameProvider}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                    <TextBlock Text="{DynamicResource LOCGameProviderTitle}" FontSize="{DynamicResource FontSize}"
                                                               Foreground="{DynamicResource TextBrushDarker}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel x:Name="PART_ElemLinks" Margin="0,8,0,8">
                                                <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                  Content="{DynamicResource IconLink}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <ItemsControl x:Name="PART_ItemsLinks" />
                                                    <TextBlock Text="{DynamicResource LOCLinksLabel}" FontSize="{DynamicResource FontSize}"
                                                               Foreground="{DynamicResource TextBrushDarker}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
