<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml (grid mode, side panel).
    One MUI Card filling the panel: CardMedia (the background art, 180px, cropped; hidden when there is no art),
    CardHeader (40px round avatar from the game icon, title at 20px, developer as a primary Link as the subheader),
    CardActions (contained Play or Install, text Button More, IconButton Edit), small filled Chips for genres, a
    divider, the same icon List as the details pane (ListItemIcon + two-line ListItemText), a divider, then the
    description as CardContent body text in text.secondary and the notes. 16px gutters.
    The panel edge follows Playnite's panel settings. Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <DockPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DockPanel.Resources>

                            <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,12,12,0"
                                    Content="r" FontFamily="Marlett"
                                    Style="{DynamicResource SimpleButton}"
                                    Command="{MainViewModel CloseGameSideBarCommand}" />

                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCErrorNoGameSelected}"
                                       Margin="16,24,16,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrushDarker}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,0,16,24">
                                        <!-- CardMedia -->
                                        <Grid Height="180" Margin="0,0,0,16" ClipToBounds="True" IsHitTestVisible="False">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- CardHeader: avatar, title, subheader -->
                                        <DockPanel>
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,16,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                                                </Image.Clip>
                                            </Image>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLarger}"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <ItemsControl x:Name="PART_ItemsDevelopers" Tag="Accent">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- CardActions -->
                                        <DockPanel Margin="0,16,0,0">
                                            <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Focusable="False" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusFull}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <ContentPresenter Width="24" Height="24"
                                                                  Content="{DynamicResource IconEdit}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonMoreActions" DockPanel.Dock="Right" Content="{DynamicResource LOCMoreAction}"
                                                    Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <Grid HorizontalAlignment="Left">
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                            </Grid>
                                        </DockPanel>

                                        <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,16,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,8" />
                                        <DockPanel x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                            <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                              Content="{DynamicResource IconPlayTime}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="PART_TextPlayTime" FontSize="{DynamicResource FontSizeLarge}" />
                                                <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSize}"
                                                           Foreground="{DynamicResource TextBrushDarker}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                            <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                              Content="{DynamicResource IconLastPlayed}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="PART_TextLastActivity" FontSize="{DynamicResource FontSizeLarge}" />
                                                <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSize}"
                                                           Foreground="{DynamicResource TextBrushDarker}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                            <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                              Content="{DynamicResource IconCompletionStatus}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSize}"
                                                           Foreground="{DynamicResource TextBrushDarker}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel x:Name="PART_ElemPlatform" Margin="0,8,0,8">
                                            <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                              Content="{DynamicResource IconPlatform}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <ItemsControl x:Name="PART_ItemsPlatforms" />
                                                <TextBlock Text="{DynamicResource LOCPlatformTitle}" FontSize="{DynamicResource FontSize}"
                                                           Foreground="{DynamicResource TextBrushDarker}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                            <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                              Content="{DynamicResource IconPublisher}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <ItemsControl x:Name="PART_ItemsPublishers" />
                                                <TextBlock Text="{DynamicResource LOCPublisherLabel}" FontSize="{DynamicResource FontSize}"
                                                           Foreground="{DynamicResource TextBrushDarker}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                            <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                              Content="{DynamicResource IconReleaseDate}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" FontSize="{DynamicResource FontSize}"
                                                           Foreground="{DynamicResource TextBrushDarker}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel x:Name="PART_ElemLibrary" Margin="0,8,0,8">
                                            <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                              Content="{DynamicResource IconGameProvider}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                <TextBlock Text="{DynamicResource LOCGameProviderTitle}" FontSize="{DynamicResource FontSize}"
                                                           Foreground="{DynamicResource TextBrushDarker}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel x:Name="PART_ElemLinks" Margin="0,8,0,8">
                                            <ContentPresenter DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,32,0" VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                              Content="{DynamicResource IconLink}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <ItemsControl x:Name="PART_ItemsLinks" />
                                                <TextBlock Text="{DynamicResource LOCLinksLabel}" FontSize="{DynamicResource FontSize}"
                                                           Foreground="{DynamicResource TextBrushDarker}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,16" />

                                        <StackPanel x:Name="PART_ElemDescription">
                                            <HtmlTextView x:Name="PART_HtmlDescription"
                                                          TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                          Tag="{DynamicResource GlyphBrush}"
                                                          HtmlFontSize="{DynamicResource FontSize}"
                                                          HtmlFontFamily="{DynamicResource FontFamily}"
                                                          HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                          LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                        </StackPanel>
                                        <StackPanel x:Name="PART_ElemNotes" Margin="0,16,0,0">
                                            <TextBlock Text="{DynamicResource LOCNotesLabel}" FontWeight="Medium" Margin="0,0,0,8" />
                                            <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                     Background="{DynamicResource ControlBackgroundBrush}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
