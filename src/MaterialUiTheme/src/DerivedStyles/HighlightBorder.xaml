<!--
    Overlay on Playnite Default/DerivedStyles/HighlightBorder.xaml.
    Playnite templates this theme does not replace (ListView, RichTextBox, DatePicker, PathSelectionBox, ComboBoxList)
    still wrap their fields in this border. It becomes the MUI FilledInput chrome: rounded top, a 1px white 70%
    underline, text.primary under the pointer and primary.main while focus is inside (the 1px line stands in for the
    animated 2px one). Hosts that set their own Background keep it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="HighlightBorder" TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="CornerRadius" Value="{DynamicResource MuiFilledInputRadius}" />
        <Setter Property="BorderThickness" Value="{DynamicResource MuiFilledInputBorderThickness}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MuiFilledInputUnderlineBrush}" />
        <Setter Property="Background" Value="{DynamicResource MuiFilledInputBgBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MuiTextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MuiPrimaryMainBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
