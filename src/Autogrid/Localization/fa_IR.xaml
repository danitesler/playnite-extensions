<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">حالت (فقط در نمای شبکه‌ای دسکتاپ)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">خاموش</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite اندازه جلدها را حفظ می‌کند. ستون‌ها با پنجره کم و زیاد می‌شوند.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">تغییر اندازه جلدها</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">جلدها تغییر اندازه می‌دهند تا تعداد ستون‌ها ثابت بماند، حتی وقتی جزئیات بازی باز می‌شود.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">تغییر اندازه، جزئیات روی شبکه می‌لغزد</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">جلدها با پنجره تغییر اندازه می‌دهند. جزئیات بازی به‌جای باریک کردن شبکه، لبه آن را می‌پوشاند.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">حالت اندازه‌بندی</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">ستون‌ها</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">سطرها</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">ستون‌های هدف (کاشی‌های افقی)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">سطرهای هدف (کاشی‌های عمودی)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">تنظیم پنجره دید (پیکسل)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">اگر پوسته‌ای هنوز در کناره‌ها فاصله ایجاد می‌کند، تنظیم پنجره دید را تغییر دهید تا شبکه هم‌تراز شود.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">ستون‌های هدف باید بین ۱ تا ۲۰ باشد.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">سطرهای هدف باید بین ۱ تا ۱۰ باشد.</sys:String>

</ResourceDictionary>
