<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">فعال‌سازی Autogrid (فقط در نمای شبکه‌ای دسکتاپ)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">حالت اندازه‌بندی</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">ستون‌ها</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">سطرها</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">ستون‌های هدف (کاشی‌های افقی)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">سطرهای هدف (کاشی‌های عمودی)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">تنظیم پنجره دید (پیکسل)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">اگر پوسته‌ای هنوز در کناره‌ها فاصله ایجاد می‌کند، تنظیم پنجره دید را تغییر دهید تا شبکه هم‌تراز شود.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">ستون‌های هدف باید بین ۱ تا ۲۰ باشد.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">سطرهای هدف باید بین ۱ تا ۱۰ باشد.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">تنظیم پنجره دید باید بین -۲۰۰ تا ۲۰۰ پیکسل باشد.</sys:String>

</ResourceDictionary>
