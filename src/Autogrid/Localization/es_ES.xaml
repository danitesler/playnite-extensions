<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Modo (solo en vista de cuadrícula de escritorio)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Desactivado</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite mantiene el tamaño de tus portadas. Las columnas cambian con la ventana.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Redimensionar portadas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Las portadas cambian de tamaño para mantener el número de columnas, también al abrir los detalles del juego.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Redimensionar, los detalles se deslizan encima</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Las portadas se adaptan a la ventana. Los detalles del juego cubren el borde de la cuadrícula en lugar de estrecharla.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Modo de tamaño</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Columnas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Filas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Columnas objetivo (mosaicos horizontales)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Filas objetivo (mosaicos verticales)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Ajuste del área de visualización (píxeles)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Si un tema sigue dejando espacio a los lados, ajusta el área hasta que la cuadrícula quede alineada.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Las columnas objetivo deben estar entre 1 y 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Las filas objetivo deben estar entre 1 y 10.</sys:String>

</ResourceDictionary>
