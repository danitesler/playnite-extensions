<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Activar Autogrid (solo en vista de cuadrícula de escritorio)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Modo de tamaño</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Columnas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Filas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Columnas objetivo (mosaicos horizontales)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Filas objetivo (mosaicos verticales)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Ajuste del área de visualización (píxeles)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Si un tema sigue dejando espacio a los lados, ajusta el área hasta que la cuadrícula quede alineada.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Las columnas objetivo deben estar entre 1 y 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Las filas objetivo deben estar entre 1 y 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">El ajuste del área de visualización debe estar entre -200 y 200 píxeles.</sys:String>

</ResourceDictionary>
