<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Ενεργοποίηση Autogrid (μόνο σε προβολή πλέγματος επιφάνειας εργασίας)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Λειτουργία μεγέθους</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Στήλες</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Γραμμές</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Στόχος στηλών (οριζόντια πλακίδια)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Στόχος γραμμών (κάθετα πλακίδια)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Προσαρμογή περιοχής προβολής (pixel)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Εάν ένα θέμα αφήνει ακόμα κενό στα πλάγια, προσαρμόστε την περιοχή προβολής μέχρι το πλέγμα να ευθυγραμμιστεί.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Ο στόχος στηλών πρέπει να είναι μεταξύ 1 και 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Ο στόχος γραμμών πρέπει να είναι μεταξύ 1 και 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Η προσαρμογή περιοχής προβολής πρέπει να είναι μεταξύ -200 και 200 pixel.</sys:String>

</ResourceDictionary>
