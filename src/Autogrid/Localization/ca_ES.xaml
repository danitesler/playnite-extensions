<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Mode (només a la vista de quadrícula d'escriptori)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Desactivat</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">El Playnite manté la mida de les portades. Les columnes canvien amb la finestra.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Redimensiona les portades</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Les portades es redimensionen per mantenir el nombre de columnes, també quan s'obren els detalls del joc.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Redimensiona, els detalls llisquen per sobre</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Les portades s'adapten a la finestra. Els detalls del joc cobreixen la vora de la quadrícula en lloc d'encongir-la.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Mode de dimensionament</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Columnes</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Files</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Columnes desitjades (mosaics horitzontals)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Files desitjades (mosaics verticals)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Ajust de l'àrea de visualització (píxels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Si un tema encara deixa espai als costats, ajusteu l'àrea fins que la quadrícula quedi alineada.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">El nombre de columnes desitjades ha d'estar entre 1 i 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">El nombre de files desitjades ha d'estar entre 1 i 10.</sys:String>

</ResourceDictionary>
