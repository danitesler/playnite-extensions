<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Aktifkan Autogrid (hanya tampilan kisi desktop)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Mode ukuran</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolom</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Baris</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Target kolom (petak horizontal)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Target baris (petak vertikal)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Penyesuaian area pandang (piksel)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Jika tema masih menyisakan ruang di sisi-sisinya, sesuaikan area pandang sampai kisi pas rata.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Target kolom harus antara 1 dan 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Target baris harus antara 1 dan 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Penyesuaian area pandang harus antara -200 dan 200 piksel.</sys:String>

</ResourceDictionary>
