<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">啟用 Autogrid（僅桌面網格檢視）</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">調整模式</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">欄</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">列</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">目標欄數（水平圖磚）</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">目標列數（垂直圖磚）</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">檢視區調整（像素）</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">如果佈景主題在兩側仍留有空隙，請微調檢視區直到網格完全貼合。</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">目標欄數必須介於 1 到 20 之間。</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">目標列數必須介於 1 到 10 之間。</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">檢視區調整必須介於 -200 到 200 像素之間。</sys:String>

</ResourceDictionary>
