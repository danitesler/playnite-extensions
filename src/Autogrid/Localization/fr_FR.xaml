<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Mode (vue en grille du bureau uniquement)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Désactivé</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite conserve la taille de vos jaquettes. Les colonnes varient avec la fenêtre.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Redimensionner les jaquettes</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Les jaquettes changent de taille pour garder le nombre de colonnes, y compris à l'ouverture des détails du jeu.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Redimensionner, les détails glissent par-dessus</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Les jaquettes suivent la fenêtre. Les détails du jeu recouvrent le bord de la grille au lieu de la rétrécir.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Mode de dimensionnement</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Colonnes</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Lignes</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Colonnes cibles (vignettes horizontales)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Lignes cibles (vignettes verticales)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Ajustement de la zone d'affichage (pixels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Si un thème laisse encore de l'espace sur les côtés, ajustez la zone jusqu'à ce que la grille soit alignée.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Le nombre de colonnes cibles doit être compris entre 1 et 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Le nombre de lignes cibles doit être compris entre 1 et 10.</sys:String>

</ResourceDictionary>
