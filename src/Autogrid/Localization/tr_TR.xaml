<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Autogrid'i etkinleştir (yalnızca masaüstü ızgara görünümü)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Boyutlandırma modu</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Sütunlar</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Satırlar</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Hedef sütunlar (yatay kutucuklar)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Hedef satırlar (dikey kutucuklar)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Görünüm alanı ayarı (piksel)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Tema yanlarda boşluk bırakıyorsa, ızgara tam oturana kadar görünüm alanı ayarını değiştirin.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Hedef sütunlar 1 ile 20 arasında olmalıdır.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Hedef satırlar 1 ile 10 arasında olmalıdır.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Görünüm alanı ayarı -200 ile 200 piksel arasında olmalıdır.</sys:String>

</ResourceDictionary>
