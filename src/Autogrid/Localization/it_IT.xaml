<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Modalità (solo vista griglia desktop)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Disattivato</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite mantiene la dimensione delle copertine. Le colonne cambiano con la finestra.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Ridimensiona copertine</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Le copertine si ridimensionano per mantenere il numero di colonne, anche quando si aprono i dettagli del gioco.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Ridimensiona, i dettagli scorrono sopra</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Le copertine seguono la finestra. I dettagli del gioco coprono il bordo della griglia invece di restringerla.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Modalità di ridimensionamento</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Colonne</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Righe</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Colonne di destinazione (riquadri orizzontali)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Righe di destinazione (riquadri verticali)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Regolazione area di visualizzazione (pixel)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Se un tema lascia ancora spazio ai lati, regola l'area finché la griglia non è a filo.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Le colonne di destinazione devono essere comprese tra 1 e 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Le righe di destinazione devono essere comprese tra 1 e 10.</sys:String>

</ResourceDictionary>
