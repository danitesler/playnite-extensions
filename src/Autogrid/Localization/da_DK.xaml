<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Aktivér Autogrid (kun skrivebordsgittervisning)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Størrelsestilstand</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolonner</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Rækker</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Målkolonner (vandrette felter)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Målrækker (lodrette felter)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Justering af visningsområde (pixels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Hvis et tema stadig efterlader plads i siderne, kan du justere visningsområdet, indtil gitteret flugter.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Målkolonner skal være mellem 1 og 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Målrækker skal være mellem 1 og 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Justering af visningsområde skal være mellem -200 og 200 pixels.</sys:String>

</ResourceDictionary>
