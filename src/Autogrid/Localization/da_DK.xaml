<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Tilstand (kun skrivebordsgittervisning)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Fra</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite beholder din coverstørrelse. Kolonner kommer og går med vinduet.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Tilpas covers</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Covers skifter størrelse for at bevare antallet af kolonner, også når spildetaljer åbnes.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Tilpas, detaljer glider hen over</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Covers følger vinduets størrelse. Spildetaljer dækker gitterets kant i stedet for at gøre det smallere.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Størrelsestilstand</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolonner</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Rækker</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Målkolonner (vandrette felter)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Målrækker (lodrette felter)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Justering af visningsområde (pixels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Hvis et tema stadig efterlader plads i siderne, kan du justere visningsområdet, indtil gitteret flugter.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Målkolonner skal være mellem 1 og 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Målrækker skal være mellem 1 og 10.</sys:String>

</ResourceDictionary>
