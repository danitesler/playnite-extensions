<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Autogrid engedélyezése (csak asztali rácsnézetben)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Méretezési mód</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Oszlopok</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Sorok</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Céloszlopok (vízszintes csempék)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Célsorok (függőleges csempék)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Nézetablak igazítása (pixel)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Ha egy téma még mindig üres helyet hagy a széleken, állítsa a nézetablakot, amíg a rács ki nem simul.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">A céloszlopok számának 1 és 20 között kell lennie.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">A célsorok számának 1 és 10 között kell lennie.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">A nézetablak igazításának -200 és 200 pixel között kell lennie.</sys:String>

</ResourceDictionary>
