<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Mód (csak asztali rácsnézetben)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Ki</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">A Playnite megtartja a borítók méretét. Az oszlopok az ablakkal együtt jönnek és mennek.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Borítók átméretezése</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">A borítók átméreteződnek, hogy az oszlopszám megmaradjon, a játék részleteinek megnyitásakor is.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Átméretezés, a részletek fölé csúsznak</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">A borítók az ablakhoz igazodnak. A játék részletei a rács szélét takarják le ahelyett, hogy szűkítenék.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Méretezési mód</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Oszlopok</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Sorok</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Céloszlopok (vízszintes csempék)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Célsorok (függőleges csempék)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Nézetablak igazítása (pixel)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Ha egy téma még mindig üres helyet hagy a széleken, állítsa a nézetablakot, amíg a rács ki nem simul.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">A céloszlopok számának 1 és 20 között kell lennie.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">A célsorok számának 1 és 10 között kell lennie.</sys:String>

</ResourceDictionary>
