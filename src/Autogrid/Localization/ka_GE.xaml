<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Autogrid-ის ჩართვა (მხოლოდ დესკტოპის ბადის ხედში)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">ზომის განსაზღვრის რეჟიმი</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">სვეტები</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">რიგები</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">სამიზნე სვეტები (ჰორიზონტალური ფილები)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">სამიზნე რიგები (ვერტიკალური ფილები)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">ხედვის არეს მორგება (პიქსელები)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">თუ თემა გვერდებზე მაინც ტოვებს სივრცეს, შეცვალეთ ხედვის არე, სანამ ბადე ზუსტად არ გასწორდება.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">სამიზნე სვეტები უნდა იყოს 1-დან 20-მდე.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">სამიზნე რიგები უნდა იყოს 1-დან 10-მდე.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">ხედვის არეს მორგება უნდა იყოს -200-დან 200 პიქსელამდე.</sys:String>

</ResourceDictionary>
