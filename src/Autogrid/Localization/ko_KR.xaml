<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Autogrid 활성화 (데스크톱 그리드 뷰 전용)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">크기 조정 모드</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">열</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">행</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">목표 열 수 (가로 타일)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">목표 행 수 (세로 타일)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">뷰포트 조정 (픽셀)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">테마의 양쪽에 여백이 남는 경우 그리드가 딱 맞을 때까지 뷰포트 조정을 미세하게 조절하세요.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">목표 열 수는 1에서 20 사이여야 합니다.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">목표 행 수는 1에서 10 사이여야 합니다.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">뷰포트 조정은 -200에서 200픽셀 사이여야 합니다.</sys:String>

</ResourceDictionary>
