<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Luba Autogrid (ainult töölaua ruudustikuvaates)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Suuruse määramise režiim</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Veerud</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Read</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Sihtveerud (horisontaalsed paanid)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Sihtread (vertikaalsed paanid)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Vaateakna kohandamine (pikslid)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Kui kujundus jätab külgedele ruumi, kohandage vaateakent, kuni ruudustik on servadeni tasa.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Sihtveergude arv peab olema vahemikus 1 kuni 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Sihtridade arv peab olema vahemikus 1 kuni 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Vaateakna kohandamine peab olema vahemikus -200 kuni 200 pikslit.</sys:String>

</ResourceDictionary>
