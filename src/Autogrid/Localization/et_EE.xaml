<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Režiim (ainult töölaua ruudustikuvaates)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Väljas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite säilitab kaanepiltide suuruse. Veerud tulevad ja kaovad koos aknaga.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Muuda kaante suurust</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Kaaned muudavad suurust, et veergude arv püsiks, ka siis, kui mängu üksikasjad avanevad.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Muuda suurust, üksikasjad libisevad peale</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Kaaned järgivad akna suurust. Mängu üksikasjad katavad ruudustiku serva, selle asemel et seda kitsendada.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Suuruse määramise režiim</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Veerud</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Read</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Sihtveerud (horisontaalsed paanid)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Sihtread (vertikaalsed paanid)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Vaateakna kohandamine (pikslid)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Kui kujundus jätab külgedele ruumi, kohandage vaateakent, kuni ruudustik on servadeni tasa.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Sihtveergude arv peab olema vahemikus 1 kuni 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Sihtridade arv peab olema vahemikus 1 kuni 10.</sys:String>

</ResourceDictionary>
