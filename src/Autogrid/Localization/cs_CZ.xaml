<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Režim (pouze v mřížkovém zobrazení plochy)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Vypnuto</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite zachová velikost obalů. Sloupce přibývají a ubývají podle okna.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Měnit velikost obalů</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Obaly mění velikost tak, aby zůstal počet sloupců, i když se otevřou podrobnosti hry.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Měnit velikost, podrobnosti se vysunou přes mřížku</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Obaly se přizpůsobí oknu. Podrobnosti hry překryjí okraj mřížky, místo aby ji zúžily.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Režim změny velikosti</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Sloupce</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Řádky</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Cílový počet sloupců (vodorovné dlaždice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Cílový počet řádků (svislé dlaždice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Úprava výřezu (pixely)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Pokud motiv stále nechává místo po stranách, upravte výřez, dokud mřížka přesně nedoléhá.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Cílový počet sloupců musí být mezi 1 a 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Cílový počet řádků musí být mezi 1 a 10.</sys:String>

</ResourceDictionary>
