<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Povolit Autogrid (pouze v mřížkovém zobrazení plochy)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Režim změny velikosti</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Sloupce</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Řádky</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Cílový počet sloupců (vodorovné dlaždice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Cílový počet řádků (svislé dlaždice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Úprava výřezu (pixely)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Pokud motiv stále nechává místo po stranách, upravte výřez, dokud mřížka přesně nedoléhá.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Cílový počet sloupců musí být mezi 1 a 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Cílový počet řádků musí být mezi 1 a 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Úprava výřezu musí být mezi -200 a 200 pixely.</sys:String>

</ResourceDictionary>
