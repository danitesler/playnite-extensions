<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Bật Autogrid (chỉ chế độ xem lưới trên màn hình nền)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Chế độ định kích thước</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Cột</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Hàng</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Số cột mục tiêu (ô ngang)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Số hàng mục tiêu (ô dọc)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Điều chỉnh khung hiển thị (pixel)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Nếu giao diện vẫn để lại khoảng trống ở các cạnh, hãy điều chỉnh khung hiển thị cho đến khi lưới vừa khít.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Số cột mục tiêu phải từ 1 đến 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Số hàng mục tiêu phải từ 1 đến 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Điều chỉnh khung hiển thị phải từ -200 đến 200 pixel.</sys:String>

</ResourceDictionary>
