<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Chế độ (chỉ chế độ xem lưới trên màn hình nền)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Tắt</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite giữ nguyên kích thước ảnh bìa. Số cột tăng giảm theo cửa sổ.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Đổi kích thước ảnh bìa</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Ảnh bìa đổi kích thước để giữ số cột, kể cả khi mở chi tiết trò chơi.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Đổi kích thước, chi tiết trượt đè lên</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Ảnh bìa đổi theo cửa sổ. Chi tiết trò chơi che mép lưới thay vì thu hẹp lưới.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Chế độ định kích thước</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Cột</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Hàng</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Số cột mục tiêu (ô ngang)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Số hàng mục tiêu (ô dọc)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Điều chỉnh khung hiển thị (pixel)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Nếu giao diện vẫn để lại khoảng trống ở các cạnh, hãy điều chỉnh khung hiển thị cho đến khi lưới vừa khít.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Số cột mục tiêu phải từ 1 đến 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Số hàng mục tiêu phải từ 1 đến 10.</sys:String>

</ResourceDictionary>
