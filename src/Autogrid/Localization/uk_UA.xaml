<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Режим (лише режим сітки робочого столу)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Вимкнено</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite зберігає розмір обкладинок. Стовпці з'являються й зникають разом із вікном.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Змінювати розмір обкладинок</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Обкладинки змінюють розмір, щоб зберегти кількість стовпців, також коли відкриваються відомості про гру.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Змінювати розмір, відомості висуваються поверх</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Обкладинки підлаштовуються під вікно. Відомості про гру перекривають край сітки, а не звужують її.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Режим підбору розміру</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Стовпці</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Рядки</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Бажана кількість стовпців (плитки по горизонталі)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Бажана кількість рядків (плитки по вертикалі)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Коригування області перегляду (пікселі)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Якщо тема залишає вільне місце з боків, змінюйте коригування області, доки сітка не заповнить простір.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Кількість стовпців має бути від 1 до 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Кількість рядків має бути від 1 до 10.</sys:String>

</ResourceDictionary>
