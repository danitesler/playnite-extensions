<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Увімкнути Autogrid (лише режим сітки робочого столу)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Режим підбору розміру</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Стовпці</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Рядки</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Бажана кількість стовпців (плитки по горизонталі)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Бажана кількість рядків (плитки по вертикалі)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Коригування області перегляду (пікселі)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Якщо тема залишає вільне місце з боків, змінюйте коригування області, доки сітка не заповнить простір.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Кількість стовпців має бути від 1 до 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Кількість рядків має бути від 1 до 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Коригування області перегляду має бути від -200 до 200 пікселів.</sys:String>

</ResourceDictionary>
