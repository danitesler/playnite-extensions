<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">تفعيل Autogrid (عرض شبكة سطح المكتب فقط)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">وضع تحديد الحجم</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">أعمدة</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">صفوف</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">عدد الأعمدة المستهدف (المربعات الأفقية)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">عدد الصفوف المستهدف (المربعات الرأسية)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">ضبط مساحة العرض (بالبكسل)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">إذا كان المظهر يترك فراغًا على الجوانب، فاضبط مساحة العرض حتى تتطابق الشبكة تمامًا.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">يجب أن يكون عدد الأعمدة المستهدف بين 1 و20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">يجب أن يكون عدد الصفوف المستهدف بين 1 و10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">يجب أن يكون ضبط مساحة العرض بين -200 و200 بكسل.</sys:String>

</ResourceDictionary>
