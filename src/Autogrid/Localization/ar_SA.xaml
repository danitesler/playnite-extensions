<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">الوضع (عرض شبكة سطح المكتب فقط)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">إيقاف</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">يحتفظ Playnite بحجم الأغلفة. تزيد الأعمدة وتنقص مع النافذة.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">تغيير حجم الأغلفة</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">يتغير حجم الأغلفة للحفاظ على عدد الأعمدة، حتى عند فتح تفاصيل اللعبة.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">تغيير الحجم مع انزلاق التفاصيل فوق الشبكة</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">يتغير حجم الأغلفة مع النافذة. أما تفاصيل اللعبة فتغطي حافة الشبكة بدلًا من تصغيرها.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">وضع تحديد الحجم</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">أعمدة</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">صفوف</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">عدد الأعمدة المستهدف (المربعات الأفقية)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">عدد الصفوف المستهدف (المربعات الرأسية)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">ضبط مساحة العرض (بالبكسل)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">إذا كان المظهر يترك فراغًا على الجوانب، فاضبط مساحة العرض حتى تتطابق الشبكة تمامًا.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">يجب أن يكون عدد الأعمدة المستهدف بين 1 و20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">يجب أن يكون عدد الصفوف المستهدف بين 1 و10.</sys:String>

</ResourceDictionary>
