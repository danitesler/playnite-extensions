<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Aktiveer Autogrid (Slegs werkskerm-roosteraansig)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Groottemodus</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolomme</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Rye</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Teikenkolomme (horisontale teëls)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Teikenrye (vertikale teëls)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Aansigt-verstelling (pieksels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">As 'n tema steeds spasie aan die kante laat, pas aansigt-verstelling aan totdat die rooster gelyk is.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Teikenkolomme moet tussen 1 en 20 wees.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Teikenrye moet tussen 1 en 10 wees.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Aansigt-verstelling moet tussen -200 en 200 pieksels wees.</sys:String>

</ResourceDictionary>
