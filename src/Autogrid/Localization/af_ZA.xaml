<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Modus (Slegs werkskerm-roosteraansig)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Af</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite behou jou omslaggrootte. Kolomme kom en gaan saam met die venster.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Pas omslae aan</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Omslae verander van grootte om die aantal kolomme te behou, ook wanneer speletjiebesonderhede oopmaak.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Pas aan, besonderhede skuif oor</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Omslae verander saam met die venster. Speletjiebesonderhede bedek eerder die rooster se rand.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Groottemodus</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolomme</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Rye</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Teikenkolomme (horisontale teëls)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Teikenrye (vertikale teëls)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Aansigt-verstelling (pieksels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">As 'n tema steeds spasie aan die kante laat, pas aansigt-verstelling aan totdat die rooster gelyk is.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Teikenkolomme moet tussen 1 en 20 wees.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Teikenrye moet tussen 1 en 10 wees.</sys:String>

</ResourceDictionary>
