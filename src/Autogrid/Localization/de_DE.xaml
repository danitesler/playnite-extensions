<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Modus (nur Desktop-Rasteransicht)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Aus</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite behält deine Covergröße. Spalten kommen und gehen mit dem Fenster.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Cover anpassen</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Cover ändern ihre Größe, damit die Spaltenzahl bleibt, auch wenn Spieldetails geöffnet werden.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Anpassen, Details schieben sich darüber</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Cover passen sich dem Fenster an. Spieldetails überdecken stattdessen den Rand des Rasters.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Größenmodus</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Spalten</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Zeilen</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Zielspalten (horizontale Kacheln)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Zielzeilen (vertikale Kacheln)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Ansichtsbereich anpassen (Pixel)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Wenn ein Design an den Seiten noch Platz lässt, passe den Ansichtsbereich an, bis das Raster bündig ist.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Zielspalten müssen zwischen 1 und 20 liegen.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Zielzeilen müssen zwischen 1 und 10 liegen.</sys:String>

</ResourceDictionary>
