<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Autogrid aktivieren (nur Desktop-Rasteransicht)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Größenmodus</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Spalten</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Zeilen</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Zielspalten (horizontale Kacheln)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Zielzeilen (vertikale Kacheln)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Ansichtsbereich anpassen (Pixel)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Wenn ein Design an den Seiten noch Platz lässt, passe den Ansichtsbereich an, bis das Raster bündig ist.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Zielspalten müssen zwischen 1 und 20 liegen.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Zielzeilen müssen zwischen 1 und 10 liegen.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Die Anpassung des Ansichtsbereichs muss zwischen -200 und 200 Pixeln liegen.</sys:String>

</ResourceDictionary>
