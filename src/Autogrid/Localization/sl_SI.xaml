<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Način (samo mrežni pogled namizja)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Izklopljeno</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite ohrani velikost ovitkov. Stolpci se dodajajo in odvzemajo z oknom.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Spreminjaj velikost ovitkov</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Ovitki spreminjajo velikost, da ostane število stolpcev, tudi ko se odprejo podrobnosti igre.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Spreminjaj velikost, podrobnosti zdrsnejo čez</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Ovitki sledijo oknu. Podrobnosti igre prekrijejo rob mreže, namesto da bi jo zožile.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Način določanja velikosti</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Stolpci</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Vrstice</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Ciljno število stolpcev (vodoravne ploščice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Ciljno število vrstic (navpične ploščice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Prilagoditev vidnega polja (slikovne pike)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Če tema ob straneh še vedno pušča prostor, prilagajajte vidno polje, dokler se mreža ne poravna.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Ciljno število stolpcev mora biti med 1 in 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Ciljno število vrstic mora biti med 1 in 10.</sys:String>

</ResourceDictionary>
