<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Aktiver Autogrid (kun rutenettvisning på skrivebordet)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Dimensjoneringsmodus</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolonner</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Rader</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Målkolonner (horisontale fliser)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Målrader (vertikale fliser)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Justering av visningsområde (piksler)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Hvis et tema fremdeles etterlater plass på sidene, kan du justere visningsområdet til rutenettet flukter.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Målkolonner må være mellom 1 og 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Målrader må være mellom 1 og 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Justering av visningsområde må være mellom -200 og 200 piksler.</sys:String>

</ResourceDictionary>
