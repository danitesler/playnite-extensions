<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Mode (Desktop grid view only)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Off</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite keeps your cover size. Columns come and go with the window.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Resize covers</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Covers resize to keep the column count, also when game details open.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Resize, details slide over</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Covers resize with the window. Game details cover the grid's edge instead.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Sizing mode</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Columns</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Rows</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Target columns (horizontal tiles)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Target rows (vertical tiles)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Viewport adjust (pixels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">If a theme still leaves space on the sides, nudge viewport adjust until the grid is flush.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Target columns must be between 1 and 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Target rows must be between 1 and 10.</sys:String>

</ResourceDictionary>
