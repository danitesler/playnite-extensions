<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">模式（仅桌面网格视图）</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">关闭</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite 保持封面大小，列数随窗口增减。</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">调整封面大小</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">调整封面大小以保持列数，打开游戏详情时也一样。</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">调整大小，详情覆盖在上方</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">封面随窗口调整大小。游戏详情会覆盖网格边缘，而不是压缩网格。</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">调整模式</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">列</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">行</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">目标列数（水平磁贴）</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">目标行数（垂直磁贴）</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">视口微调（像素）</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">如果主题在两侧仍留有空隙，请微调视口直到网格完全贴合。</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">目标列数必须在 1 到 20 之间。</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">目标行数必须在 1 到 10 之间。</sys:String>

</ResourceDictionary>
