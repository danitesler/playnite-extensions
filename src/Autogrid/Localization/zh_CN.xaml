<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">启用 Autogrid（仅桌面网格视图）</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">调整模式</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">列</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">行</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">目标列数（水平磁贴）</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">目标行数（垂直磁贴）</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">视口微调（像素）</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">如果主题在两侧仍留有空隙，请微调视口直到网格完全贴合。</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">目标列数必须在 1 到 20 之间。</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">目标行数必须在 1 到 10 之间。</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">视口微调必须在 -200 到 200 像素之间。</sys:String>

</ResourceDictionary>
