<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Mod (doar în vizualizarea grilă de desktop)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Dezactivat</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite păstrează dimensiunea copertelor. Coloanele apar și dispar odată cu fereastra.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Redimensionează copertele</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Copertele se redimensionează pentru a păstra numărul de coloane, inclusiv când se deschid detaliile jocului.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Redimensionează, detaliile alunecă deasupra</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Copertele urmează fereastra. Detaliile jocului acoperă marginea grilei în loc să o îngusteze.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Mod de dimensionare</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Coloane</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Rânduri</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Coloane țintă (dale orizontale)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Rânduri țintă (dale verticale)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Ajustare zonă de vizualizare (pixeli)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Dacă o temă lasă spațiu pe margini, ajustați zona de vizualizare până când grila se aliniază perfect.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Coloanele țintă trebuie să fie între 1 și 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Rândurile țintă trebuie să fie între 1 și 10.</sys:String>

</ResourceDictionary>
