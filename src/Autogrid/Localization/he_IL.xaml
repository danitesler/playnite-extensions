<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">הפעל את Autogrid (בתצוגת רשת שולחן עבודה בלבד)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">מצב גודל</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">עמודות</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">שורות</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">יעד עמודות (אריחים אופקיים)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">יעד שורות (אריחים אנכיים)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">כוונון שטח תצוגה (פיקסלים)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">אם ערכת נושא עדיין משאירה רווח בצדדים, כוונן את שטח התצוגה עד שהרשת תתיישר.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">יעד העמודות חייב להיות בין 1 ל-20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">יעד השורות חייב להיות בין 1 ל-10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">כוונון שטח התצוגה חייב להיות בין -200 ל-200 פיקסלים.</sys:String>

</ResourceDictionary>
