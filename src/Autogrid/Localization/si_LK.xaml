<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">ප්‍රකාරය (ඩෙස්ක්ටොප් ජාලක දසුන පමණි)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">අක්‍රිය</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite ඔබේ කවර ප්‍රමාණය තබා ගනී. කවුළුව සමඟ තීරු එකතු වී ඉවත් වේ.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">කවර ප්‍රමාණය වෙනස් කරන්න</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">තීරු ගණන රැක ගැනීමට කවර ප්‍රමාණය වෙනස් වේ, ක්‍රීඩා විස්තර විවෘත වන විටද.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">ප්‍රමාණය වෙනස් කරන්න, විස්තර උඩින් ලිස්සයි</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">කවර කවුළුව සමඟ ප්‍රමාණය වෙනස් වේ. ක්‍රීඩා විස්තර ජාලකය පටු නොකර එහි කෙළවර වසයි.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">ප්‍රමාණ ප්‍රකාරය</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">තීරු</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">පේළි</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">ඉලක්ක තීරු (තිරස් ටයිල්)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">ඉලක්ක පේළි (සිරස් ටයිල්)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">දසුන් කලාප ගැළපුම (පික්සල)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">තේමාවක් දෙපස ඉඩ තබයි නම්, ජාලකය හරියන තුරු දසුන් කලාපය සකසන්න.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">ඉලක්ක තීරු ගණන 1 සහ 20 අතර විය යුතුය.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">ඉලක්ක පේළි ගණන 1 සහ 10 අතර විය යුතුය.</sys:String>

</ResourceDictionary>
