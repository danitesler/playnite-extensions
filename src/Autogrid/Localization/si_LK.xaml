<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Autogrid සක්‍රීය කරන්න (ඩෙස්ක්ටොප් ජාලක දසුන පමණි)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">ප්‍රමාණ ප්‍රකාරය</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">තීරු</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">පේළි</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">ඉලක්ක තීරු (තිරස් ටයිල්)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">ඉලක්ක පේළි (සිරස් ටයිල්)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">දසුන් කලාප ගැළපුම (පික්සල)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">තේමාවක් දෙපස ඉඩ තබයි නම්, ජාලකය හරියන තුරු දසුන් කලාපය සකසන්න.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">ඉලක්ක තීරු ගණන 1 සහ 20 අතර විය යුතුය.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">ඉලක්ක පේළි ගණන 1 සහ 10 අතර විය යුතුය.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">දසුන් කලාප ගැළපුම -200 සහ 200 පික්සල අතර විය යුතුය.</sys:String>

</ResourceDictionary>
