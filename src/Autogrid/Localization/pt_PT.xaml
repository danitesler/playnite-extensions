<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Modo (apenas na vista de grelha do ambiente de trabalho)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Desativado</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">O Playnite mantém o tamanho das capas. As colunas mudam com a janela.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Redimensionar capas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">As capas mudam de tamanho para manter o número de colunas, também ao abrir os detalhes do jogo.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Redimensionar, detalhes deslizam por cima</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">As capas acompanham a janela. Os detalhes do jogo cobrem o limite da grelha em vez de a estreitar.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Modo de dimensionamento</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Colunas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Linhas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Colunas pretendidas (mosaicos horizontais)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Linhas pretendidas (mosaicos verticais)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Ajuste da área de visualização (píxeis)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Se um tema ainda deixar espaço de lado, ajuste a área de visualização até a grelha ficar alinhada.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">As colunas pretendidas têm de estar entre 1 e 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">As linhas pretendidas têm de estar entre 1 e 10.</sys:String>

</ResourceDictionary>
