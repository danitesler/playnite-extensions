<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Ativar Autogrid (apenas na vista de grelha do ambiente de trabalho)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Modo de dimensionamento</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Colunas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Linhas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Colunas pretendidas (mosaicos horizontais)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Linhas pretendidas (mosaicos verticais)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Ajuste da área de visualização (píxeis)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Se um tema ainda deixar espaço de lado, ajuste a área de visualização até a grelha ficar alinhada.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">As colunas pretendidas têm de estar entre 1 e 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">As linhas pretendidas têm de estar entre 1 e 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">O ajuste da área de visualização tem de estar entre -200 e 200 píxeis.</sys:String>

</ResourceDictionary>
