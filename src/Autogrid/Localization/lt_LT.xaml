<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Režimas (tik darbalaukio tinklelio rodinyje)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Išjungta</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">„Playnite“ išlaiko viršelių dydį. Stulpeliai atsiranda ir dingsta kartu su langu.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Keisti viršelių dydį</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Viršeliai keičia dydį, kad išliktų stulpelių skaičius, taip pat atidarius žaidimo informaciją.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Keisti dydį, informacija užslenka ant viršaus</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Viršeliai prisitaiko prie lango. Žaidimo informacija uždengia tinklelio kraštą, užuot jį susiaurinusi.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Dydžio keitimo režimas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Stulpeliai</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Eilutės</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Tiksliniai stulpeliai (horizontalios plytelės)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Tikslinės eilutės (vertikalios plytelės)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Rodymo srities koregavimas (pikseliais)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Jei motyvas šonuose vis dar palieka vietos, koreguokite rodymo sritį, kol tinklelis susilygins.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Tikslinių stulpelių skaičius turi būti nuo 1 iki 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Tikslinių eilučių skaičius turi būti nuo 1 iki 10.</sys:String>

</ResourceDictionary>
