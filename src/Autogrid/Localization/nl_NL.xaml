<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Autogrid inschakelen (alleen desktop-rasterweergave)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Modus voor formaataanpassing</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolommen</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Rijen</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Doelkolommen (horizontale tegels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Doelrijen (verticale tegels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Weergavegebied aanpassen (pixels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Als een thema aan de zijkanten nog ruimte overlaat, pas dan het weergavegebied aan totdat het raster aansluit.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Doelkolommen moeten tussen 1 en 20 liggen.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Doelrijen moeten tussen 1 en 10 liggen.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Weergavegebiedaanpassing moet tussen -200 en 200 pixels liggen.</sys:String>

</ResourceDictionary>
