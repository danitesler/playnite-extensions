<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Modus (alleen desktop-rasterweergave)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Uit</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite houdt je covergrootte aan. Kolommen komen en gaan met het venster.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Covers schalen</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Covers schalen mee om het aantal kolommen te houden, ook als speldetails opengaan.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Schalen, details schuiven eroverheen</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Covers schalen mee met het venster. Speldetails bedekken in plaats daarvan de rand van het raster.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Modus voor formaataanpassing</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolommen</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Rijen</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Doelkolommen (horizontale tegels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Doelrijen (verticale tegels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Weergavegebied aanpassen (pixels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Als een thema aan de zijkanten nog ruimte overlaat, pas dan het weergavegebied aan totdat het raster aansluit.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Doelkolommen moeten tussen 1 en 20 liggen.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Doelrijen moeten tussen 1 en 10 liggen.</sys:String>

</ResourceDictionary>
