<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Autogrid सक्षम करा (केवळ डेस्कटॉप ग्रिड दृश्य)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">आकार मोड</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">स्तंभ</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">ओळी</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">लक्ष्य स्तंभ (आडव्या टाइल्स)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">लक्ष्य ओळी (उभ्या टाइल्स)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">व्ह्यूपोर्ट समायोजन (पिक्सेल)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">थीम बाजूला जागा सोडत असल्यास, ग्रिड व्यवस्थित बसेना तोपर्यंत व्ह्यूपोर्ट समायोजन बदला.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">लक्ष्य स्तंभ 1 आणि 20 दरम्यान असणे आवश्यक आहे.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">लक्ष्य ओळी 1 आणि 10 दरम्यान असणे आवश्यक आहे.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">व्ह्यूपोर्ट समायोजन -200 आणि 200 पिक्सेल दरम्यान असणे आवश्यक आहे.</sys:String>

</ResourceDictionary>
