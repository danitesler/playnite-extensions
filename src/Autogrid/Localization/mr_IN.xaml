<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">मोड (केवळ डेस्कटॉप ग्रिड दृश्य)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">बंद</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite तुमचा कव्हर आकार तसाच ठेवतो. विंडोनुसार स्तंभ वाढतात आणि कमी होतात.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">कव्हरचा आकार बदला</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">स्तंभांची संख्या टिकवण्यासाठी कव्हरचा आकार बदलतो, गेम तपशील उघडल्यावरही.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">आकार बदला, तपशील वरून सरकतात</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">कव्हर विंडोनुसार आकार बदलतात. गेम तपशील ग्रिड अरुंद न करता त्याची कड झाकतात.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">आकार मोड</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">स्तंभ</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">ओळी</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">लक्ष्य स्तंभ (आडव्या टाइल्स)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">लक्ष्य ओळी (उभ्या टाइल्स)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">व्ह्यूपोर्ट समायोजन (पिक्सेल)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">थीम बाजूला जागा सोडत असल्यास, ग्रिड व्यवस्थित बसेना तोपर्यंत व्ह्यूपोर्ट समायोजन बदला.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">लक्ष्य स्तंभ 1 आणि 20 दरम्यान असणे आवश्यक आहे.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">लक्ष्य ओळी 1 आणि 10 दरम्यान असणे आवश्यक आहे.</sys:String>

</ResourceDictionary>
