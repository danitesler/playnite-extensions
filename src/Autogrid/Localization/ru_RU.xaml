<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Включить Autogrid (только режим сетки на рабочем столе)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Режим подбора размера</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Столбцы</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Строки</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Желаемое число столбцов (плитки по горизонтали)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Желаемое число строк (плитки по вертикали)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Коррекция области просмотра (пиксели)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Если тема оставляет пустые места по бокам, изменяйте коррекцию области, пока сетка не заполнит пространство.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Число столбцов должно быть от 1 до 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Число строк должно быть от 1 до 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Коррекция области просмотра должна быть от -200 до 200 пикселей.</sys:String>

</ResourceDictionary>
