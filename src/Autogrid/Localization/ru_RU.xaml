<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Режим (только режим сетки на рабочем столе)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Выключено</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite сохраняет размер обложек. Столбцы появляются и исчезают вместе с окном.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Менять размер обложек</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Обложки меняют размер, чтобы сохранить число столбцов, в том числе при открытии сведений об игре.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Менять размер, сведения выезжают поверх</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Обложки подстраиваются под окно. Сведения об игре перекрывают край сетки, а не сужают её.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Режим подбора размера</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Столбцы</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Строки</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Желаемое число столбцов (плитки по горизонтали)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Желаемое число строк (плитки по вертикали)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Коррекция области просмотра (пиксели)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Если тема оставляет пустые места по бокам, изменяйте коррекцию области, пока сетка не заполнит пространство.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Число столбцов должно быть от 1 до 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Число строк должно быть от 1 до 10.</sys:String>

</ResourceDictionary>
