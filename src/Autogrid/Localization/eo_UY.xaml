<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Ebligi Autogrid (nur labortabla kradvido)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Grandeca reĝimo</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolonoj</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Vicoj</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Celaj kolonoj (horizontalaj kaheloj)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Celaj vicoj (vertikalaj kaheloj)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Alĝustigo de vidareo (rastrumeroj)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Se etoso ankoraŭ lasas spacon ĉe la flankoj, alĝustigu la vidareon ĝis la krado plenas.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Celaj kolonoj devas esti inter 1 kaj 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Celaj vicoj devas esti inter 1 kaj 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Alĝustigo de vidareo devas esti inter -200 kaj 200 rastrumeroj.</sys:String>

</ResourceDictionary>
