<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Активиране на Autogrid (само в решетъчен изглед на десктоп)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Режим на оразмеряване</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Колони</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Редове</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Целеви колони (хоризонтални плочки)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Целеви редове (вертикални плочки)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Корекция на изгледа (пиксели)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Ако дадена тема все още оставя празно място отстрани, коригирайте изгледа, докато решетката се изравни.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Целевите колони трябва да са между 1 и 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Целевите редове трябва да са между 1 и 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Корекцията на изгледа трябва да бъде между -200 и 200 пиксела.</sys:String>

</ResourceDictionary>
