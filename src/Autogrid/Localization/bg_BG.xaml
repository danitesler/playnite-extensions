<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Режим (само в решетъчен изглед на десктоп)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Изключено</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite запазва размера на обложките. Колоните се добавят и махат според прозореца.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Преоразмеряване на обложките</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Обложките се преоразмеряват, за да запазят броя колони, и когато се отворят подробностите за играта.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Преоразмеряване, подробностите се плъзгат отгоре</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Обложките следват прозореца. Подробностите за играта покриват края на решетката, вместо да я свиват.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Режим на оразмеряване</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Колони</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Редове</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Целеви колони (хоризонтални плочки)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Целеви редове (вертикални плочки)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Корекция на изгледа (пиксели)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Ако дадена тема все още оставя празно място отстрани, коригирайте изгледа, докато решетката се изравни.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Целевите колони трябва да са между 1 и 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Целевите редове трябва да са между 1 и 10.</sys:String>

</ResourceDictionary>
