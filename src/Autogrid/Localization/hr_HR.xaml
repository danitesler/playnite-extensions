<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Omogući Autogrid (samo prikaz rešetke radne površine)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Način određivanja veličine</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Stupci</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Redovi</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Ciljani stupci (vodoravne pločice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Ciljani redovi (okomite pločice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Prilagodba vidnog polja (pikseli)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Ako tema i dalje ostavlja prazan prostor sa strane, prilagodite vidno polje dok se rešetka ne poravna.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Ciljani stupci moraju biti između 1 i 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Ciljani redovi moraju biti između 1 i 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Prilagodba vidnog polja mora biti između -200 i 200 piksela.</sys:String>

</ResourceDictionary>
