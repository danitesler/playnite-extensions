<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">モード (デスクトップのグリッド表示のみ)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">オフ</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite のカバーサイズのまま。列数はウィンドウに合わせて増減します。</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">カバーをリサイズ</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">列数を保つようにカバーをリサイズします。ゲーム詳細を開いたときも同様です。</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">リサイズ、詳細は上に重ねる</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">カバーはウィンドウに合わせてリサイズ。ゲーム詳細はグリッドを縮めず、端に重なります。</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">サイズ調整モード</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">列</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">行</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">目標列数 (水平タイルの数)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">目標行数 (垂直タイルの数)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">ビューポート調整 (ピクセル)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">テーマによって左右に余白ができる場合は、グリッドがぴったり収まるまでビューポート調整を変更してください。</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">目標列数は 1 から 20 の間である必要があります。</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">目標行数は 1 から 10 の間である必要があります。</sys:String>

</ResourceDictionary>
