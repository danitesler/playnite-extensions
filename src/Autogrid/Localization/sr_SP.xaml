<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Režim (samo prikaz mreže na radnoj površini)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Isključeno</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite zadržava veličinu omota. Kolone se dodaju i uklanjaju sa prozorom.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Menjaj veličinu omota</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Omoti menjaju veličinu da bi ostao isti broj kolona, i kada se otvore detalji igre.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Menjaj veličinu, detalji klize preko</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Omoti prate veličinu prozora. Detalji igre prekrivaju ivicu mreže umesto da je suze.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Režim veličine</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolone</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Redovi</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Ciljane kolone (horizontalne pločice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Ciljani redovi (vertikalne pločice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Prilagođavanje vidnog polja (pikseli)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Ako tema i dalje ostavlja prostor sa strane, podešavajte vidno polje dok se mreža ne poravna.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Ciljane kolone moraju biti između 1 i 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Ciljani redovi moraju biti između 1 i 10.</sys:String>

</ResourceDictionary>
