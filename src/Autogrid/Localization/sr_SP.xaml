<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Omogući Autogrid (samo prikaz mreže na radnoj površini)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Režim veličine</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolone</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Redovi</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Ciljane kolone (horizontalne pločice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Ciljani redovi (vertikalne pločice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Prilagođavanje vidnog polja (pikseli)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Ako tema i dalje ostavlja prostor sa strane, podešavajte vidno polje dok se mreža ne poravna.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Ciljane kolone moraju biti između 1 i 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Ciljani redovi moraju biti između 1 i 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Prilagođavanje vidnog polja mora biti između -200 i 200 piksela.</sys:String>

</ResourceDictionary>
