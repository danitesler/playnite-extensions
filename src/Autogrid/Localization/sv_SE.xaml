<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Läge (endast skrivbordsrutnätsvy)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Av</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite behåller din omslagsstorlek. Kolumner kommer och går med fönstret.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Ändra storlek på omslag</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Omslag ändrar storlek för att behålla antalet kolumner, även när speldetaljer öppnas.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Ändra storlek, detaljer glider över</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Omslag följer fönstrets storlek. Speldetaljer täcker rutnätets kant i stället för att göra det smalare.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Storleksläge</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolumner</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Rader</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Målkolumner (horisontella brickor)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Målrader (vertikala brickor)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Justering av visningsyta (pixlar)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Om ett tema lämnar utrymme på sidorna, justera visningsytan tills rutnätet sluter tätt.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Målkolumner måste vara mellan 1 och 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Målrader måste vara mellan 1 och 10.</sys:String>

</ResourceDictionary>
