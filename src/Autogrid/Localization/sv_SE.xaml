<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Aktivera Autogrid (endast skrivbordsrutnätsvy)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Storleksläge</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolumner</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Rader</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Målkolumner (horisontella brickor)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Målrader (vertikala brickor)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Justering av visningsyta (pixlar)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Om ett tema lämnar utrymme på sidorna, justera visningsytan tills rutnätet sluter tätt.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Målkolumner måste vara mellan 1 och 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Målrader måste vara mellan 1 och 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Justering av visningsyta måste vara mellan -200 och 200 pixlar.</sys:String>

</ResourceDictionary>
