<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Modo (somente na exibição de grade da área de trabalho)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Desativado</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">O Playnite mantém o tamanho das capas. As colunas mudam com a janela.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Redimensionar capas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">As capas mudam de tamanho para manter o número de colunas, também ao abrir os detalhes do jogo.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Redimensionar, detalhes deslizam por cima</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">As capas acompanham a janela. Os detalhes do jogo cobrem a borda da grade em vez de estreitá-la.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Modo de dimensionamento</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Colunas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Linhas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Colunas de destino (blocos horizontais)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Linhas de destino (blocos verticais)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Ajuste da área de exibição (pixels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Se um tema ainda deixar espaço nas laterais, ajuste a área de exibição até que a grade fique alinhada.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">As colunas de destino devem estar entre 1 e 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">As linhas de destino devem estar entre 1 e 10.</sys:String>

</ResourceDictionary>
