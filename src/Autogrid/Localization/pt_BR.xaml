<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Ativar Autogrid (somente na exibição de grade da área de trabalho)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Modo de dimensionamento</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Colunas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Linhas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Colunas de destino (blocos horizontais)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Linhas de destino (blocos verticais)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Ajuste da área de exibição (pixels)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Se um tema ainda deixar espaço nas laterais, ajuste a área de exibição até que a grade fique alinhada.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">As colunas de destino devem estar entre 1 e 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">As linhas de destino devem estar entre 1 e 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">O ajuste da área de exibição deve estar entre -200 e 200 pixels.</sys:String>

</ResourceDictionary>
