<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Tila (vain työpöydän ruudukkonäkymässä)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Pois</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite säilyttää kansikuvien koon. Sarakkeita tulee ja lähtee ikkunan mukana.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Muuta kansien kokoa</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Kannet muuttavat kokoaan, jotta sarakemäärä pysyy, myös kun pelin tiedot avataan.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Muuta kokoa, tiedot liukuvat päälle</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Kannet seuraavat ikkunan kokoa. Pelin tiedot peittävät ruudukon reunan sen kaventamisen sijaan.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Kokotila</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Sarakkeet</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Rivit</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Kohdesarakkeet (vaakaruudut)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Kohderivit (pystyruudut)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Näyttöalueen säätö (pikseliä)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Jos teema jättää reunoille tilaa, säädä näyttöaluetta, kunnes ruudukko täyttää tilan tasaisesti.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Kohdesarakkeiden määrän on oltava välillä 1–20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Kohderivien määrän on oltava välillä 1–10.</sys:String>

</ResourceDictionary>
