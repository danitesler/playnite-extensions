<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Modo (só na vista de grade do escritorio)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Desactivado</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite mantén o tamaño das túas portadas. As columnas cambian coa xanela.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Redimensionar portadas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">As portadas cambian de tamaño para manter o número de columnas, tamén ao abrir os detalles do xogo.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Redimensionar, os detalles deslízanse por riba</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">As portadas adáptanse á xanela. Os detalles do xogo cobren o bordo da grade en vez de estreitala.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Modo de dimensionamento</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Columnas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Filas</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Columnas obxectivo (mosaicos horizontais)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Filas obxectivo (mosaicos verticais)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Axuste da área de visualización (píxeles)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Se un tema aínda deixa espazo aos lados, axusta a área ata que a grade quede aliñada.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">As columnas obxectivo deben estar entre 1 e 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">As filas obxectivo deben estar entre 1 e 10.</sys:String>

</ResourceDictionary>
