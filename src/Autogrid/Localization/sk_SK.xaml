<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Enable">Povoliť Autogrid (iba v mriežkovom zobrazení plochy)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Režim zmeny veľkosti</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Stĺpce</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Riadky</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Cieľový počet stĺpcov (vodorovné dlaždice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Cieľový počet riadkov (zvislé dlaždice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Úprava výrezu (pixely)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Ak motív stále necháva miesto po stranách, upravujte výrez, kým mriežka presne nedolieha.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Cieľový počet stĺpcov musí byť medzi 1 a 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Cieľový počet riadkov musí byť medzi 1 a 10.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_ViewportAdjust">Úprava výrezu musí byť medzi -200 a 200 pixelmi.</sys:String>

</ResourceDictionary>
