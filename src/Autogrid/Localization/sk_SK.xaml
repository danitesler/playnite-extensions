<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Režim (iba v mriežkovom zobrazení plochy)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Vypnuté</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite zachová veľkosť obalov. Stĺpce pribúdajú a ubúdajú podľa okna.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Meniť veľkosť obalov</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Obaly menia veľkosť, aby zostal počet stĺpcov, aj keď sa otvoria podrobnosti hry.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Meniť veľkosť, podrobnosti sa vysunú cez mriežku</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Obaly sa prispôsobia oknu. Podrobnosti hry prekryjú okraj mriežky namiesto jej zúženia.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Režim zmeny veľkosti</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Stĺpce</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Riadky</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Cieľový počet stĺpcov (vodorovné dlaždice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Cieľový počet riadkov (zvislé dlaždice)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Úprava výrezu (pixely)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Ak motív stále necháva miesto po stranách, upravujte výrez, kým mriežka presne nedolieha.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Cieľový počet stĺpcov musí byť medzi 1 a 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Cieľový počet riadkov musí byť medzi 1 a 10.</sys:String>

</ResourceDictionary>
