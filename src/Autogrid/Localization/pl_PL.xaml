<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCAutogrid_Settings_Mode">Tryb (tylko widok siatki pulpitu)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOff">Wyłączony</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeOffHint">Playnite zachowuje rozmiar okładek. Kolumny przybywają i ubywają razem z oknem.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResize">Zmieniaj rozmiar okładek</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeResizeHint">Okładki zmieniają rozmiar, aby zachować liczbę kolumn, także po otwarciu szczegółów gry.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeep">Zmieniaj rozmiar, szczegóły wysuwają się na wierzch</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ModeKeepHint">Okładki dopasowują się do okna. Szczegóły gry zakrywają krawędź siatki zamiast ją zwężać.</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_SizingMode">Tryb ustalania rozmiaru</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Columns">Kolumny</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_Rows">Wiersze</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetColumns">Docelowa liczba kolumn (poziome kafelki)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_TargetRows">Docelowa liczba wierszy (pionowe kafelki)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjust">Korekta obszaru widoku (piksele)</sys:String>
    <sys:String x:Key="LOCAutogrid_Settings_ViewportAdjustHint">Jeśli motyw nadal pozostawia wolne miejsce po bokach, dostosuj obszar, aż siatka zostanie wyrównana.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetColumns">Docelowa liczba kolumn musi wynosić od 1 do 20.</sys:String>
    <sys:String x:Key="LOCAutogrid_Verify_TargetRows">Docelowa liczba wierszy musi wynosić od 1 do 10.</sys:String>

</ResourceDictionary>
