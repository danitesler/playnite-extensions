<UserControl x:Class="Autogrid.AutogridSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Autogrid"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="400">
    <UserControl.Resources>
        <local:GridSizingModeToBoolConverter x:Key="ColumnsModeConverter" TargetMode="Columns" />
        <local:GridSizingModeToBoolConverter x:Key="RowsModeConverter" TargetMode="Rows" />
    </UserControl.Resources>
    <StackPanel Margin="16">
        <CheckBox Content="{DynamicResource LOCAutogrid_Settings_Enable}"
                  IsChecked="{Binding Enabled, Mode=TwoWay}" />
        <Separator Margin="0,16,0,16" />

        <Label Margin="0,0,0,4" Content="{DynamicResource LOCAutogrid_Settings_SizingMode}" />
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="{DynamicResource LOCAutogrid_Settings_Columns}"
                         Margin="0,0,16,0"
                         IsChecked="{Binding SizingMode, Converter={StaticResource ColumnsModeConverter}, Mode=TwoWay}" />
            <RadioButton Content="{DynamicResource LOCAutogrid_Settings_Rows}"
                         IsChecked="{Binding SizingMode, Converter={StaticResource RowsModeConverter}, Mode=TwoWay}" />
        </StackPanel>
        <Separator Margin="0,16,0,16" />

        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SizingMode}" Value="Rows">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Label Margin="0,0,0,4" Content="{DynamicResource LOCAutogrid_Settings_TargetColumns}" />
            <Slider Minimum="1"
                    Maximum="20"
                    Value="{Binding TargetColumns, Mode=TwoWay}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource TextBrush}"
                       Text="{Binding TargetColumns, StringFormat={}{0}}" />
        </StackPanel>

        <StackPanel Margin="0,12,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SizingMode}" Value="Rows">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Label Margin="0,0,0,4" Content="{DynamicResource LOCAutogrid_Settings_TargetRows}" />
            <Slider Minimum="1"
                    Maximum="10"
                    Value="{Binding TargetRows, Mode=TwoWay}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource TextBrush}"
                       Text="{Binding TargetRows, StringFormat={}{0}}" />
        </StackPanel>

        <Label Margin="0,16,0,4" Content="{DynamicResource LOCAutogrid_Settings_ViewportAdjust}" />
        <Slider Minimum="-200"
                Maximum="200"
                Value="{Binding ViewportAdjustPx, Mode=TwoWay}"
                TickFrequency="1"
                IsSnapToTickEnabled="True" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="{DynamicResource TextBrush}"
                   Text="{Binding ViewportAdjustPx, StringFormat={}{0} px}" />
        <TextBlock Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}"
                   Text="{DynamicResource LOCAutogrid_Settings_ViewportAdjustHint}" />
    </StackPanel>
</UserControl>
