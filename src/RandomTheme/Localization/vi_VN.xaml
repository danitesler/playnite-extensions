<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCRandomTheme_Section">Chủ đề ngẫu nhiên</sys:String>
    <sys:String x:Key="LOCRandomTheme_Desktop">Máy tính để bàn</sys:String>
    <sys:String x:Key="LOCRandomTheme_Fullscreen">Toàn màn hình</sys:String>
    <sys:String x:Key="LOCRandomTheme_Enable_Desktop">Chọn ngẫu nhiên một chủ đề Máy tính để bàn mỗi lần khởi động</sys:String>
    <sys:String x:Key="LOCRandomTheme_Enable_Fullscreen">Chọn ngẫu nhiên một chủ đề Toàn màn hình mỗi lần khởi động</sys:String>
    <sys:String x:Key="LOCRandomTheme_AvoidRepeat">Không chọn chủ đề đã được đặt</sys:String>
    <sys:String x:Key="LOCRandomTheme_ThemesLabel_Desktop">Các chủ đề Máy tính để bàn để chọn</sys:String>
    <sys:String x:Key="LOCRandomTheme_ThemesLabel_Fullscreen">Các chủ đề Toàn màn hình để chọn</sys:String>
    <sys:String x:Key="LOCRandomTheme_SelectAll">Chọn tất cả</sys:String>
    <sys:String x:Key="LOCRandomTheme_SelectNone">Bỏ chọn tất cả</sys:String>
    <sys:String x:Key="LOCRandomTheme_NoThemes">Chưa cài đặt chủ đề tương thích nào.</sys:String>
    <sys:String x:Key="LOCRandomTheme_NextTheme">Chủ đề cho lần khởi động tiếp theo: {0}</sys:String>
