    <sys:String x:Key="LOCRandomTheme_Fullscreen">Viso ekrano</sys:String>
    <sys:String x:Key="LOCRandomTheme_Enable_Desktop">Kiekvieną kartą paleidus pasirinkti atsitiktinę darbalaukio temą</sys:String>
    <sys:String x:Key="LOCRandomTheme_Enable_Fullscreen">Kiekvieną kartą paleidus pasirinkti atsitiktinę viso ekrano temą</sys:String>
    <sys:String x:Key="LOCRandomTheme_AvoidRepeat">Nesirinkti jau nustatytos temos</sys:String>
    <sys:String x:Key="LOCRandomTheme_ThemesLabel_Desktop">Darbalaukio temos, iš kurių renkamasi</sys:String>
