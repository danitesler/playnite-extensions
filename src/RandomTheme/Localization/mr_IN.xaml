<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCRandomTheme_Section">यादृच्छिक थीम</sys:String>
    <sys:String x:Key="LOCRandomTheme_Desktop">डेस्कटॉप</sys:String>
    <sys:String x:Key="LOCRandomTheme_Fullscreen">फुलस्क्रीन</sys:String>
    <sys:String x:Key="LOCRandomTheme_Enable_Desktop">प्रत्येक सुरुवातीला यादृच्छिक डेस्कटॉप थीम निवडा</sys:String>
    <sys:String x:Key="LOCRandomTheme_Enable_Fullscreen">प्रत्येक सुरुवातीला यादृच्छिक फुलस्क्रीन थीम निवडा</sys:String>
