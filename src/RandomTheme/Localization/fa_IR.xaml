<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCRandomTheme_Section">زمینهٔ تصادفی</sys:String>
    <sys:String x:Key="LOCRandomTheme_Desktop">میزکار</sys:String>
    <sys:String x:Key="LOCRandomTheme_Fullscreen">تمام‌صفحه</sys:String>
    <sys:String x:Key="LOCRandomTheme_Enable_Desktop">انتخاب یک زمینهٔ تصادفی میزکار در هر راه‌اندازی</sys:String>
    <sys:String x:Key="LOCRandomTheme_Enable_Fullscreen">انتخاب یک زمینهٔ تصادفی تمام‌صفحه در هر راه‌اندازی</sys:String>
    <sys:String x:Key="LOCRandomTheme_ThemesLabel_Desktop">زمینه‌های میزکار برای انتخاب</sys:String>
    <sys:String x:Key="LOCRandomTheme_ThemesLabel_Fullscreen">زمینه‌های تمام‌صفحه برای انتخاب</sys:String>
    <sys:String x:Key="LOCRandomTheme_SelectAll">گزینش همه</sys:String>
    <sys:String x:Key="LOCRandomTheme_SelectNone">واگزینش همه</sys:String>
    <sys:String x:Key="LOCRandomTheme_NoThemes">هیچ زمینهٔ سازگاری نصب نشده است.</sys:String>
    <sys:String x:Key="LOCRandomTheme_NextTheme">زمینه برای راه‌اندازی بعدی: {0}</sys:String>
    <sys:String x:Key="LOCRandomTheme_RandomizeNow">انتخاب تصادفی اکنون</sys:String>
    <sys:String x:Key="LOCRandomTheme_RandomizeNow_Desktop">تغییر تصادفی زمینهٔ میزکار اکنون</sys:String>
    <sys:String x:Key="LOCRandomTheme_RandomizeNow_Fullscreen">تغییر تصادفی زمینهٔ تمام‌صفحه اکنون</sys:String>
    <sys:String x:Key="LOCRandomTheme_Note">Playnite زمینهٔ خود را پیش از راه‌اندازی افزونه‌ها بارگیری می‌کند؛ بنابراین زمینهٔ تازه‌انتخاب‌شده در نوبت بعدی راه‌اندازی Playnite در آن حالت استفاده می‌شود.</sys:String>
    <sys:String x:Key="LOCRandomTheme_RestartQuestion">زمینهٔ جدید پس از راه‌اندازی مجدد Playnite استفاده خواهد شد. اکنون راه‌اندازی مجدد شود؟</sys:String>
    <sys:String x:Key="LOCRandomTheme_AppliedLater">زمینهٔ جدید در نوبت بعدی راه‌اندازی Playnite در آن حالت استفاده خواهد شد.</sys:String>
    <sys:String x:Key="LOCRandomTheme_Error_NoThemes">هیچ زمینه‌ای برای حالت {0} در دسترس نیست. یک زمینهٔ سازگار نصب کنید یا دست‌کم یکی را در تنظیمات افزونه انتخاب کنید.</sys:String>
    <sys:String x:Key="LOCRandomTheme_Error_Apply">زمینهٔ {0} تغییر نکرد، زیرا دسترسی به تنظیمات Playnite ممکن نبود. برای جزئیات، extensions.log را ببینید.</sys:String>
    <sys:String x:Key="LOCRandomTheme_Error_Restart">Playnite نتوانست خودش را دوباره راه‌اندازی کند. لطفاً آن را دستی راه‌اندازی مجدد کنید.</sys:String>
    <sys:String x:Key="LOCRandomTheme_Error_Verify">دست‌کم یک زمینه برای حالت {0} انتخاب کنید یا انتخاب تصادفی را برای {0} خاموش کنید.</sys:String>
</ResourceDictionary>
