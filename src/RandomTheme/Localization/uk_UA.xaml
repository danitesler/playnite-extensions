<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCRandomTheme_Section">Випадкова тема</sys:String>
    <sys:String x:Key="LOCRandomTheme_Desktop">Робочий стіл</sys:String>
    <sys:String x:Key="LOCRandomTheme_Fullscreen">Повноекранний режим</sys:String>
    <sys:String x:Key="LOCRandomTheme_Enable_Desktop">Обирати випадкову тему для режиму «Робочий стіл» під час кожного запуску</sys:String>
    <sys:String x:Key="LOCRandomTheme_Enable_Fullscreen">Обирати випадкову тему для повноекранного режиму під час кожного запуску</sys:String>
    <sys:String x:Key="LOCRandomTheme_ThemesLabel_Desktop">Теми режиму «Робочий стіл» для вибору</sys:String>
    <sys:String x:Key="LOCRandomTheme_ThemesLabel_Fullscreen">Теми повноекранного режиму для вибору</sys:String>
