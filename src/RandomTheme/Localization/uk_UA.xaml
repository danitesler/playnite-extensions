    <sys:String x:Key="LOCRandomTheme_NoThemes">Сумісні теми не встановлено.</sys:String>
    <sys:String x:Key="LOCRandomTheme_NextTheme">Тема під час наступного запуску: {0}</sys:String>
    <sys:String x:Key="LOCRandomTheme_RandomizeNow">Випадковий вибір зараз</sys:String>
