<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCRandomTheme_Section">ערכת נושא אקראית</sys:String>
    <sys:String x:Key="LOCRandomTheme_Desktop">שולחן עבודה</sys:String>
    <sys:String x:Key="LOCRandomTheme_Fullscreen">מסך מלא</sys:String>
    <sys:String x:Key="LOCRandomTheme_Enable_Desktop">בחירת ערכת נושא אקראית לשולחן העבודה בכל הפעלה</sys:String>
    <sys:String x:Key="LOCRandomTheme_Enable_Fullscreen">בחירת ערכת נושא אקראית למסך מלא בכל הפעלה</sys:String>
    <sys:String x:Key="LOCRandomTheme_ThemesLabel_Desktop">ערכות נושא לשולחן העבודה לבחירה מתוכן</sys:String>
    <sys:String x:Key="LOCRandomTheme_ThemesLabel_Fullscreen">ערכות נושא למסך מלא לבחירה מתוכן</sys:String>
    <sys:String x:Key="LOCRandomTheme_SelectAll">בחר הכל</sys:String>
    <sys:String x:Key="LOCRandomTheme_SelectNone">בטל בחירה של הכל</sys:String>
    <sys:String x:Key="LOCRandomTheme_NoThemes">לא הותקנו ערכות נושא תואמות.</sys:String>
    <sys:String x:Key="LOCRandomTheme_NextTheme">ערכת הנושא להפעלה הבאה: {0}</sys:String>
    <sys:String x:Key="LOCRandomTheme_RandomizeNow">בחר באקראי עכשיו</sys:String>
    <sys:String x:Key="LOCRandomTheme_RandomizeNow_Desktop">החלף ערכת נושא של שולחן העבודה באקראי עכשיו</sys:String>
    <sys:String x:Key="LOCRandomTheme_RandomizeNow_Fullscreen">החלף ערכת נושא של מסך מלא באקראי עכשיו</sys:String>
    <sys:String x:Key="LOCRandomTheme_Note">Playnite טוענת את ערכת הנושא שלה לפני שהתוספים מופעלים, לכן ערכת נושא שנבחרה זה עתה תשמש בהפעלה הבאה של Playnite באותו מצב.</sys:String>
    <sys:String x:Key="LOCRandomTheme_RestartQuestion">ערכת הנושא החדשה תשמש לאחר הפעלה מחדש של Playnite. להפעיל מחדש עכשיו?</sys:String>
    <sys:String x:Key="LOCRandomTheme_AppliedLater">ערכת הנושא החדשה תשמש בהפעלה הבאה של Playnite באותו מצב.</sys:String>
    <sys:String x:Key="LOCRandomTheme_Error_NoThemes">אין ערכות נושא זמינות לבחירה עבור {0}. התקן ערכת נושא תואמת או בחר לפחות אחת בהגדרות התוסף.</sys:String>
    <sys:String x:Key="LOCRandomTheme_Error_Apply">לא ניתן היה לשנות את ערכת הנושא של {0} משום שלא ניתן היה לגשת להגדרות של Playnite. פרטים ב-extensions.log.</sys:String>
    <sys:String x:Key="LOCRandomTheme_Error_Restart">Playnite לא הצליחה להפעיל את עצמה מחדש. הפעל אותה מחדש ידנית.</sys:String>
    <sys:String x:Key="LOCRandomTheme_Error_Verify">בחר לפחות ערכת נושא אחת עבור {0}, או כבה את הבחירה האקראית עבור {0}.</sys:String>
    <sys:String x:Key="LOCRandomTheme_Cadence_Label">שינוי ערכת נושא</sys:String>
    <sys:String x:Key="LOCRandomTheme_Cadence_0">בכל הפעלה</sys:String>
    <sys:String x:Key="LOCRandomTheme_Cadence_1">כל יום</sys:String>
    <sys:String x:Key="LOCRandomTheme_Cadence_2">כל 3 ימים</sys:String>
    <sys:String x:Key="LOCRandomTheme_Cadence_3">כל 7 ימים</sys:String>
    <sys:String x:Key="LOCRandomTheme_Cadence_4">כל 30 ימים</sys:String>
</ResourceDictionary>
