<!--
    Overlay on Playnite Default/DefaultControls/ScrollViewer.xaml (the ScrollBar; the ScrollViewer template is Playnite's).
    UIPanelScrollBarTemplate: a 16px dark groove with a bronze edge, a small square arrow button at each end (red
    leather face, gold edge, gold arrow) and the beige knob with three grip lines (ScrollBarThumb).
    Horizontal bars are the vertical template turned by 90 degrees, as in Playnite's; the arrows turn with it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="ScrollBarTrackButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The knob: a beige plate with a black edge and three grip lines. -->
    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Knob" MinHeight="14" Margin="1,0,1,0"
                            Background="{DynamicResource ScrollBarThumbBrush}"
                            BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusSmall}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="6" Height="1" Margin="0,1,0,1" Background="{DynamicResource TextBrushDark}" Opacity="0.5" />
                            <Border Width="6" Height="1" Margin="0,1,0,1" Background="{DynamicResource TextBrushDark}" Opacity="0.5" />
                            <Border Width="6" Height="1" Margin="0,1,0,1" Background="{DynamicResource TextBrushDark}" Opacity="0.5" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" TargetName="Knob" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" TargetName="Knob" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The arrow button at either end of the bar. The arrow is IconDropDown; the up arrow is turned over. -->
    <Style x:Key="ScrollBarArrowButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="Face" Margin="1" BorderThickness="1"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            CornerRadius="{DynamicResource CornerRadiusSmall}">
                        <ContentPresenter x:Name="Arrow" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          Content="{DynamicResource IconDropDown}"
                                          ContentTemplate="{DynamicResource IconTemplate}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Up">
                            <Setter Property="RenderTransform" TargetName="Arrow">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" TargetName="Face" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Face" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" TargetName="Face" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Root" Width="16" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="3" Margin="1,0,1,0"
                                Background="{DynamicResource ScrollBarTrackBrush}"
                                BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" />
                        <RepeatButton x:Name="LineUp" Grid.Row="0" Tag="Up"
                                      Style="{DynamicResource ScrollBarArrowButton}"
                                      Command="ScrollBar.LineUpCommand" />
                        <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.Resources>
                                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">28</sys:Double>
                            </Track.Resources>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="UpButton" Style="{DynamicResource ScrollBarTrackButton}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="DownButton" Style="{DynamicResource ScrollBarTrackButton}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{DynamicResource ScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                        <RepeatButton x:Name="LineDown" Grid.Row="2"
                                      Style="{DynamicResource ScrollBarArrowButton}"
                                      Command="ScrollBar.LineDownCommand" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="LayoutTransform" TargetName="Root">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Vertical" />
                            <Setter TargetName="UpButton" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="DownButton" Property="Command" Value="ScrollBar.PageRightCommand" />
                            <Setter TargetName="LineUp" Property="Command" Value="ScrollBar.LineLeftCommand" />
                            <Setter TargetName="LineDown" Property="Command" Value="ScrollBar.LineRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
