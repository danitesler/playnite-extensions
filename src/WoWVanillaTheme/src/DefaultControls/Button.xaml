<!--
    Overlay on Playnite Default/DefaultControls/Button.xaml.
    UIPanelButtonTemplate: a dark red leather face lit from the top, a gold-bronze edge inside a black outline, gold
    text with a one pixel shadow. Hover lifts the whole face and lights the edge (UI-Panel-Button-Highlight), pressed
    goes dark and moves the text down one pixel, disabled goes gray. Brushes: ButtonBackgroundBrush,
    ButtonHoverBackgroundBrush, ButtonPressedBackgroundBrush, ButtonBorderBrush, ButtonForegroundBrush.
    The disabled look replaces BaseStyle's dimming (Opacity back to 1): the gray face is the disabled look.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Outline" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusLarge}">
                        <Border x:Name="Border" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Border x:Name="Sheen" Margin="1,0,1,0" Height="4" VerticalAlignment="Top" IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource TextBrush}" BorderThickness="0,1,0,0" Opacity="0.22"
                                        CornerRadius="3,3,0,0" />
                                <Border x:Name="Glow" Margin="1" Opacity="0" IsHitTestVisible="False"
                                        Background="{DynamicResource HoverBrush}"
                                        CornerRadius="{DynamicResource CornerRadiusSmall}" />
                                <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="0" Opacity="0.9" RenderingBias="Performance" />
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="Glow" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0" TargetName="Glow" />
                            <Setter Property="Opacity" Value="0" TargetName="Sheen" />
                            <Setter Property="RenderTransform" TargetName="Content">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0" TargetName="Glow" />
                            <Setter Property="Opacity" Value="0.1" TargetName="Sheen" />
                            <Setter Property="Effect" Value="{x:Null}" TargetName="Content" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
