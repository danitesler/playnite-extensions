<!--
    Overlay on Playnite Default/Views/FilterPanelView.xaml (the panel and the preset buttons; the field styles are
    Playnite's). The panel is a strip of dark glass on a bronze line. The close button is the red plate of the window
    buttons; the preset buttons are bare glyphs in gold (the bin, the quill and the plus) that turn white under the
    pointer. PART_* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="FilterPresetButtonAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent" CornerRadius="{DynamicResource CornerRadiusSmall}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type FilterPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPanel}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            Background="{DynamicResource ExpanderBackgroundBrush}"
                            d:DesignWidth="200">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="2,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings FilterPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,2,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Background="{TemplateBinding Background}">
                            <DockPanel Margin="10,8,5,5" DockPanel.Dock="Top">
                                <Button Content="r" Style="{DynamicResource WindowBarButton}"
                                        DockPanel.Dock="Right" Margin="0,0,5,0"
                                        Name="PART_ButtonClose" />
                                <Button DockPanel.Dock="Left" Content="{DynamicResource LOCClearFilters}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Style="{DynamicResource SimpleButton}"
                                        Name="PART_ButtonClear" />
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="8,0,6,5">
                                <Button x:Name="PART_ButtonDeleteFilter" Style="{DynamicResource FilterPresetButtonAction}">
                                    <ContentPresenter Width="16" Height="16"
                                                      Content="{DynamicResource IconRemove}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button x:Name="PART_ButtonRenameFilter" Style="{DynamicResource FilterPresetButtonAction}">
                                    <ContentPresenter Width="16" Height="16"
                                                      Content="{DynamicResource IconEdit}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button x:Name="PART_ButtonSaveFilter" Style="{DynamicResource FilterPresetButtonAction}">
                                    <ContentPresenter Width="16" Height="16"
                                                      Content="{DynamicResource IconAdd}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <ComboBox x:Name="PART_ComboFilterPresets"
                                          DockPanel.Dock="Left" VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          DockPanel.Dock="Top" Padding="0,0,0,15">
                                <StackPanel x:Name="PART_PanelItemsHost" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
