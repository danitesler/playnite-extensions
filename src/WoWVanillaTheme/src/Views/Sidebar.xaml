<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    The sidebar is a strip of the stone the client's main menu bar is cut from (ShellBackgroundBrush) with a bronze
    edge on the side that faces the library. The main menu button is a micro menu button: a dark slot with a bevelled
    bronze border and a gold glyph (MainMenuButton; also used by Views/TopPanel.xaml). Items are slots too
    (CustomControls/SidebarItem.xaml). PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
        <Setter Property="Background" Value="{DynamicResource GridItemBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SlotBorderBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemHoverBorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Margin="{TemplateBinding Padding}"
                            Background="{DynamicResource ShellBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,2,0">
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                    DockPanel.Dock="Top" Margin="6,6,6,4">
                                <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" Margin="6,0,6,6" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="BorderThickness" Value="2,0,0,0" TargetName="BorderContentHolder" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="BorderThickness" Value="0,0,0,2" TargetName="BorderContentHolder" />
                            <Setter Property="Margin" Value="6,6,2,6" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,110,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="2,6,2,6" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="BorderThickness" Value="0,2,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Margin" Value="6,6,2,6" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="2,6,2,6" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
