<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml: the game details as a quest log page.
    Playnite's arrangement is kept (background art at the top, the cover and title over it, the action buttons, the
    property list on the left, the text on the right); every PART_ name is Playnite's.
      - The title is set the way the client sets a zone name: gold, large, with a one pixel shadow. The cover and the
        icon sit in item slots (bevelled bronze edge in a black line, on the dark bed behind icons).
      - The property list is an item tooltip: the tooltip navy inside its light 2px edge, labels in gold
        (GameFontNormal), values in white, links white until the pointer turns them gold, scores in the item quality
        colors (green, gold, red).
      - The description and the notes are the quest text: ink (ParchmentTextBrush) on a paper page with a tooth
        (Images/parchment.png) and darkened rim, inside the gold and bronze frame. The description is drawn by
        DescriptionView.html, which uses the same inks.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1280"
                                  d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid>
                            <FadeImage x:Name="PART_ImageBackground" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Top">
                                <FadeImage.ImageOpacityMask>
                                    <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="2" RadiusY="0.9">
                                        <RadialGradientBrush.GradientStops>
                                            <GradientStop Color="Black" Offset="0.3" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </RadialGradientBrush.GradientStops>
                                    </RadialGradientBrush>
                                </FadeImage.ImageOpacityMask>
                            </FadeImage>

                            <Grid HorizontalAlignment="Stretch" Margin="20,0,20,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Settings CalculatedGameDetailsIndentation}" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Title, icon, cover and the action buttons -->
                                <DockPanel Margin="0,20,0,15" MaxWidth="1024" Grid.Row="1"
                                           Background="Transparent">
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Bottom" SnapsToDevicePixels="True"
                                            Visibility="{Binding Visibility, ElementName=PART_ImageCover}"
                                            BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1"
                                            CornerRadius="{DynamicResource CornerRadiusLarge}">
                                        <Border BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="3"
                                                Background="{DynamicResource GridItemBackgroundBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <Image Name="PART_ImageCover"
                                                   Height="{Settings GameDetailsCoverHeight}"
                                                   StretchDirection="Both" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                        </Border>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom" DockPanel.Dock="Left">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center" SnapsToDevicePixels="True"
                                                    Visibility="{Binding Visibility, ElementName=PART_ImageIcon}"
                                                    BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1"
                                                    CornerRadius="{DynamicResource CornerRadiusLarge}">
                                                <Border BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="2"
                                                        Background="{DynamicResource GridItemBackgroundBrush}"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                                    <Image Name="PART_ImageIcon" MaxHeight="48" MaxWidth="48"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="Fant" />
                                                </Border>
                                            </Border>
                                            <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource FontFamily}"
                                                       DockPanel.Dock="Left"
                                                       FontSize="{DynamicResource FontSizeLargest}" Margin="0,0,10,0" TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource GlyphBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="2" BlurRadius="0" Opacity="1" RenderingBias="Performance" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </DockPanel>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Orientation="Horizontal" Margin="0,15,0,0">
                                            <Button Name="PART_ButtonPlayAction"
                                                    Width="150" Height="40" Style="{DynamicResource PlayButton}" />
                                            <Button Name="PART_ButtonContextAction"
                                                    Width="150" Height="40" />
                                            <Button Name="PART_ButtonMoreActions"
                                                    Content="{DynamicResource LOCMoreAction}"
                                                    Width="150" Height="40" Margin="10,0,0,0" />
                                            <Button x:Name="PART_ButtonEditGame"
                                                    Margin="10,0,0,0" Width="40" Height="40" Padding="0" Focusable="False">
                                                <Button.Content>
                                                    <ContentPresenter Width="20" Height="20"
                                                                      Content="{DynamicResource IconEdit}"
                                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                                </Button.Content>
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <DockPanel MaxWidth="1024" Grid.Row="2">
                                    <!-- The property list: an item tooltip -->
                                    <Border DockPanel.Dock="Left" Width="{Settings PropertiesPanelWith}"
                                            Margin="2,0,12,20" VerticalAlignment="Top" SnapsToDevicePixels="True"
                                            Background="{DynamicResource TooltipBackgroundBrush}"
                                            BorderBrush="{DynamicResource PopupBorderBrush}"
                                            BorderThickness="{DynamicResource PopupBorderThickness}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <Border BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1"
                                                CornerRadius="{DynamicResource CornerRadiusSmall}"
                                                Padding="{DynamicResource TooltipPadding}">
                                            <StackPanel>
                                                <StackPanel.Resources>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                    <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                                                        <Setter Property="Margin" Value="0,4,8,4" />
                                                        <Setter Property="VerticalAlignment" Value="Top" />
                                                        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                                                    </Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Resources>

                                                <TextBlock Text="{DynamicResource LOCGameDetails}" Margin="0,0,0,4"
                                                           FontSize="{DynamicResource FontSizeLarge}"
                                                           Style="{DynamicResource BaseTextBlockStyle}" />

                                                <Separator Background="{DynamicResource MenuSeparatorBrush}" />

                                                <GridEx Margin="0,5,0,0"
                                                        ColumnCount="2" StarColumns="1"
                                                        RowCount="25" AutoLayoutColumns="2">
                                                    <Grid.Resources>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
                                                    </Grid.Resources>

                                                    <Label Name="PART_ElemAdded" Content="{DynamicResource LOCDateAddedLabel}" />
                                                    <TextBlock Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                    <Label Name="PART_ElemPlayTime" Content="{DynamicResource LOCTimePlayed}" />
                                                    <TextBlock Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                    <Label Name="PART_ElemLastPlayed" Content="{DynamicResource LOCLastPlayed}" />
                                                    <TextBlock Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                    <Label Name="PART_ElemRecentActivity" Content="{DynamicResource LOCRecentActivityLabel}" />
                                                    <TextBlock Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                    <Label Name="PART_ElemCompletionStatus" Content="{DynamicResource LOCCompletionStatus}" />
                                                    <Button Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" />

                                                    <Label Name="PART_ElemInstallDirectory" Content="{DynamicResource LOCGameInstallDirTitle}" />
                                                    <Button Name="PART_ButtonInstallDirectory" VerticalAlignment="Center" />

                                                    <Label Name="PART_ElemInstallSize" Content="{DynamicResource LOCInstallSizeLabel}" />
                                                    <TextBlock Name="PART_TextInstallSize" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                    <Label Name="PART_ElemLibrary" Content="{DynamicResource LOCGameProviderTitle}" />
                                                    <Button Name="PART_ButtonLibrary" VerticalAlignment="Center" />

                                                    <Label Name="PART_ElemPlatform" Content="{DynamicResource LOCPlatformTitle}" />
                                                    <ItemsControl Name="PART_ItemsPlatforms" />

                                                    <Label Name="PART_ElemGenres" Content="{DynamicResource LOCGenreLabel}" />
                                                    <ItemsControl Name="PART_ItemsGenres" />

                                                    <Label Name="PART_ElemDevelopers" Content="{DynamicResource LOCDeveloperLabel}" />
                                                    <ItemsControl Name="PART_ItemsDevelopers" />

                                                    <Label Name="PART_ElemPublishers" Content="{DynamicResource LOCPublisherLabel}" />
                                                    <ItemsControl Name="PART_ItemsPublishers" />

                                                    <Label Name="PART_ElemReleaseDate" Content="{DynamicResource LOCGameReleaseDateTitle}" />
                                                    <Button Name="PART_ButtonReleaseDate" VerticalAlignment="Center" />

                                                    <Label Name="PART_ElemCategories" Content="{DynamicResource LOCGameCategoriesTitle}" />
                                                    <ItemsControl Name="PART_ItemsCategories" />

                                                    <Label Name="PART_ElemFeatures" Content="{DynamicResource LOCFeaturesLabel}" />
                                                    <ItemsControl Name="PART_ItemsFeatures" />

                                                    <Label Name="PART_ElemTags" Content="{DynamicResource LOCTagsLabel}" />
                                                    <ItemsControl Name="PART_ItemsTags" />

                                                    <Label Name="PART_ElemAgeRating" Content="{DynamicResource LOCAgeRatingLabel}" />
                                                    <ItemsControl Name="PART_ItemsAgeRatings" />

                                                    <Label Name="PART_ElemSeries" Content="{DynamicResource LOCSeriesLabel}" />
                                                    <ItemsControl Name="PART_ItemsSeries" />

                                                    <Label Name="PART_ElemSource" Content="{DynamicResource LOCSourceLabel}" />
                                                    <Button Name="PART_ButtonSource" VerticalAlignment="Center" />

                                                    <Label Name="PART_ElemRegion" Content="{DynamicResource LOCRegionLabel}" />
                                                    <ItemsControl Name="PART_ItemsRegions" />

                                                    <Label Name="PART_ElemVersion" Content="{DynamicResource LOCVersionLabel}" />
                                                    <Button Name="PART_ButtonVersion" VerticalAlignment="Center" />

                                                    <Label Name="PART_ElemCommunityScore" Content="{DynamicResource LOCCommunityScore}" />
                                                    <TextBlock Name="PART_TextCommunityScore" VerticalAlignment="Center"
                                                               Style="{DynamicResource TextBlockGameScore}" />

                                                    <Label Name="PART_ElemCriticScore" Content="{DynamicResource LOCCriticScore}" />
                                                    <TextBlock Name="PART_TextCriticScore" VerticalAlignment="Center"
                                                               Style="{DynamicResource TextBlockGameScore}" />

                                                    <Label Name="PART_ElemUserScore" Content="{DynamicResource LOCUserScore}" />
                                                    <TextBlock Name="PART_TextUserScore" VerticalAlignment="Center"
                                                               Style="{DynamicResource TextBlockGameScore}" />

                                                    <Label Name="PART_ElemLinks" Content="{DynamicResource LOCLinksLabel}" />
                                                    <ItemsControl Name="PART_ItemsLinks" />
                                                </GridEx>
                                            </StackPanel>
                                        </Border>
                                    </Border>

                                    <!-- The quest text: description and notes on paper -->
                                    <Border Margin="0,0,2,20" VerticalAlignment="Top" SnapsToDevicePixels="True"
                                            BorderBrush="{DynamicResource FrameBrush}"
                                            BorderThickness="{DynamicResource FrameThickness}"
                                            CornerRadius="{DynamicResource CornerRadiusLarge}">
                                        <Border BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                                                Background="{DynamicResource ParchmentBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <Grid>
                                                <Border IsHitTestVisible="False" Opacity="0.9">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{ThemeFile 'Images/parchment.png'}"
                                                                    TileMode="Tile" Stretch="Fill"
                                                                    ViewportUnits="Absolute" Viewport="0,0,256,256" />
                                                    </Border.Background>
                                                </Border>
                                                <Border IsHitTestVisible="False" Background="{DynamicResource ParchmentEdgeBrush}">
                                                    <Border.CacheMode>
                                                        <BitmapCache />
                                                    </Border.CacheMode>
                                                    <Border.OpacityMask>
                                                        <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
                                                            <GradientStop Color="Transparent" Offset="0.55" />
                                                            <GradientStop Color="#A0000000" Offset="1" />
                                                        </RadialGradientBrush>
                                                    </Border.OpacityMask>
                                                </Border>
                                                <StackPanel Margin="22,14,22,20">
                                                    <StackPanel Name="PART_ElemDescription">
                                                        <Grid Margin="0,0,0,3">
                                                            <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}"
                                                                       Margin="1,1,0,0" Opacity="0.65"
                                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                                       Foreground="{DynamicResource ParchmentLabelBrush}" />
                                                            <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}"
                                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                                       Foreground="{DynamicResource ParchmentTitleBrush}" />
                                                        </Grid>
                                                        <Separator Background="{DynamicResource ParchmentLabelBrush}" Opacity="0.55" Margin="0,0,0,4" />
                                                        <HtmlTextView Name="PART_HtmlDescription"
                                                                      Margin="0,5,0,5"
                                                                      HtmlFontSize="{DynamicResource FontSize}"
                                                                      HtmlFontFamily="{DynamicResource FontFamily}"
                                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                      pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                    </StackPanel>

                                                    <StackPanel Name="PART_ElemNotes" Margin="0,12,0,0">
                                                        <Grid Margin="0,0,0,3">
                                                            <TextBlock Text="{DynamicResource LOCNotesLabel}"
                                                                       Margin="1,1,0,0" Opacity="0.65"
                                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                                       Foreground="{DynamicResource ParchmentLabelBrush}" />
                                                            <TextBlock Text="{DynamicResource LOCNotesLabel}"
                                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                                       Foreground="{DynamicResource ParchmentTitleBrush}" />
                                                        </Grid>
                                                        <Separator Background="{DynamicResource ParchmentLabelBrush}" Opacity="0.55" Margin="0,0,0,4" />
                                                        <TextBox Name="PART_TextNotes" IsReadOnly="True"
                                                                 Style="{DynamicResource BareTextBox}"
                                                                 Foreground="{DynamicResource ParchmentTextBrush}"
                                                                 CaretBrush="{DynamicResource ParchmentTextBrush}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                 Margin="0,5,0,5" Padding="0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
