<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    Component sizes come from the client's own templates (UIPanelButtonTemplate 21px, InputBoxTemplate 20px,
    UIDropDownMenuTemplate, GameTooltip insets of 5px), scaled up a step for a desktop window.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Popups: the tooltip navy inside UI-Tooltip-Border, a 2px light edge. Templates that draw a popup add the dark
         line just inside the edge themselves. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: a thin gold line just inside the control edge. WPF shows FocusVisualStyle for the keyboard only. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="1" Margin="3" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource CornerRadiusSmall}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: the ring goes around the box, outside its edge. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="1" Margin="-3" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource CornerRadiusSmall}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing, keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">14,4,14,5</Thickness> <!-- UIPanelButtonTemplate: 21px face, text 14px in from the caps -->
    <Thickness x:Key="InputPadding">8,3,8,3</Thickness> <!-- InputBoxTemplate: 20px field, text 8px in -->
    <Thickness x:Key="MenuPadding">5</Thickness> <!-- Tooltip and dropdown backdrops inset their content by 5px -->
    <Thickness x:Key="MenuItemPadding">10,4,10,4</Thickness> <!-- UIDropDownMenuButton: 16px rows, text 10px in -->
    <Thickness x:Key="ComboBoxDropDownPadding">5</Thickness> <!-- Dropdown list backdrop inset -->
    <Thickness x:Key="ComboBoxItemPadding">8,4,8,4</Thickness> <!-- Dropdown list rows -->
    <Thickness x:Key="ListBoxItemPadding">8,4,8,4</Thickness> <!-- Quest log rows: 16px tall at 1024 -->
    <Thickness x:Key="GroupBoxPadding">12</Thickness> <!-- Options frame inner margin -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness> <!-- Gap under a frame title -->
    <Thickness x:Key="GroupBoxHeaderPadding">12,6,12,6</Thickness> <!-- The title band of an options frame -->
    <sys:Double x:Key="GroupBoxHeaderFontSize">16</sys:Double> <!-- GameFontNormalLarge: frame titles are set at 16 -->
    <Thickness x:Key="TooltipPadding">10,8,10,8</Thickness> <!-- GameTooltip: 5px backdrop inset plus 5px of air -->
    <sys:Double x:Key="IconSize">20</sys:Double> <!-- Micro menu buttons carry 20px glyphs -->
</ResourceDictionary>
