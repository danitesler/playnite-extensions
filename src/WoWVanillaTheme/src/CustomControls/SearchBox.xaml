<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    The client's edit box (Common-Input-Border) with a magnifier at the start: near-black field, tan edge inside a black
    outline, gold edge and a faint ring on keyboard focus. The chrome is drawn here around a chromeless text box so
    hosts can restyle it through Background / BorderBrush / BorderThickness / Height (TopPanelSearchBox).
    Playnite's code hides PART_SeachIcon while the box has focus or text, so it carries the "Search" placeholder; the
    magnifier itself stays. ShowImage="False" (filter panel fields) drops the magnifier and the placeholder.
    PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon are Playnite's parts (all three must exist).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Halo" Margin="-2" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"
                                SnapsToDevicePixels="True" CornerRadius="{DynamicResource CornerRadiusXLarge}"
                                BorderBrush="{DynamicResource FocusHaloBrush}" />
                        <Border SnapsToDevicePixels="True" BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusLarge}">
                            <Border x:Name="Chrome" SnapsToDevicePixels="True"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Grid>
                                    <ContentControl x:Name="Glyph" Margin="8,0,0,0" Focusable="False" IsTabStop="False"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                                    Foreground="{DynamicResource ButtonForegroundBrush}"
                                                    ContentTemplate="{DynamicResource SearchTextIconTemplate}" />
                                    <TextBlock x:Name="PART_SeachIcon" Margin="30,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                               Style="{DynamicResource BaseTextBlockStyle}"
                                               Foreground="{DynamicResource TextBrushDarker}"
                                               Text="{DynamicResource LOCSearchLabel}" />
                                    <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                             VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                             Padding="28,0,26,0" />
                                    <ContentControl x:Name="PART_ClearTextIcon" Margin="0,0,8,0" Focusable="False" IsTabStop="False"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextBrushDarker}"
                                                    ContentTemplate="{DynamicResource ClearTextIconTemplate}" />
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Chrome" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Chrome" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Halo" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glyph" />
                            <Setter Property="Padding" Value="8,0,26,0" TargetName="PART_TextInpuText" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
