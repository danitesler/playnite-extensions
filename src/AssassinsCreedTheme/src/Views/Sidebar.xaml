<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    The tab strip of the menus: 52px on the shell layer with a hairline under it. The main menu button (menu lines
    around a diamond, PART_ElemMainMenu) sits at the left, the tabs follow, and 146px stay clear on the right for the
    caption buttons. Always horizontal: Views/MainWindow.xaml docks it to the top whatever the Sidebar position setting says.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Main menu button: 56x52, flush with the strip; the diamond turns gold under the pointer. Also used by Views/TopPanel.xaml. -->
    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Height="52"
                            Background="{DynamicResource ShellBackgroundBrush}"
                            BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,0,1">
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                    DockPanel.Dock="Left">
                                <ContentPresenter Width="22" Height="22"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <ScrollViewer x:Name="ScrollSidebarItems" DockPanel.Dock="Left"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          CanContentScroll="True" Margin="0,0,146,0">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Horizontal" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
