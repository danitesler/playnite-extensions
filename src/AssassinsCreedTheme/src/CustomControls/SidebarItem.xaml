<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    A menu tab: a 22px icon and the tab's title in the heading serif, in capitals. Resting tabs are in the secondary
    ink; under the pointer the ink brightens and a hairline appears; the current tab has a gold icon, a 2px gold
    underline and a diamond sitting on it. Library and Statistics get this theme's icons (IconLibrary, IconStatistics).
    Tabs from add-ons keep their own icon, scaled into the 22px box, and their title. PART_ProgressStatus is kept as a
    2px bar along the bottom edge. The title comes from the item's Title, the same text as its tooltip.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Padding" Value="18,0,18,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid>
                        <ProgressBar x:Name="PART_ProgressStatus" Height="2" VerticalAlignment="Bottom"
                                     BorderThickness="0" Background="Transparent" />
                        <Border x:Name="Tab" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid x:Name="IconHost" Width="22" Height="22" VerticalAlignment="Center">
                                    <Viewbox x:Name="ItemIcon">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    </Viewbox>
                                    <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                    ContentTemplate="{DynamicResource IconTemplate}" />
                                </Grid>
                                <TextBlock x:Name="TabLabel" Margin="10,1,0,0" VerticalAlignment="Center"
                                           MaxWidth="150" TextTrimming="CharacterEllipsis"
                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                           FontSize="{DynamicResource FontSize}" FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{Binding Title, Converter={StaticResource StringToUpperCaseConverter}}" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="Underline" Height="2" Margin="10,0,10,0" VerticalAlignment="Bottom"
                                   IsHitTestVisible="False" Visibility="Collapsed"
                                   Fill="{DynamicResource GlyphBrush}" />
                        <Path x:Name="Marker" Width="8" Height="8" Margin="0,0,0,2"
                              HorizontalAlignment="Center" VerticalAlignment="Bottom"
                              IsHitTestVisible="False" Visibility="Collapsed"
                              Data="M4,0 L8,4 L4,8 L0,4 Z" Fill="{DynamicResource GlyphBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Underline" />
                            <Setter Property="Height" Value="1" TargetName="Underline" />
                            <Setter Property="Fill" Value="{DynamicResource TabItemHoverIndicatorBrush}" TargetName="Underline" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Underline" />
                            <Setter Property="Height" Value="2" TargetName="Underline" />
                            <Setter Property="Fill" Value="{DynamicResource TabItemIndicatorBrush}" TargetName="Underline" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Marker" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" TargetName="IconHost" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Title}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TabLabel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TabLabel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ListItemHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
