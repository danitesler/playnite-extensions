<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml: the frame around a cover tile in the grid view.
    Selected (static, setters): the Pip-Boy selection box, FrameThickness (1px) of GridViewItemSelectedBorderBrush
    (green), 3px outside the tile, square.
    Hover is the Pip-Boy screen answering the pointer, animated on its own layers (no setters on animated parts):
      in  0.12s in three frame steps (0.4, 0.75, 1): a 1px box in the stronger rule (GridViewItemHoverBorderBrush) steps on
          3px outside the tile and a faint green band (SelectedBrush at 0.22) starts rolling down the cover, once every
          3s (the menus' vertical hold); while hovered the box flickers slightly (bEnableFlickerPipboy).
      out 0.35s: the box decays, the band is cut (FillBehavior Stop on every exit).
    No bloom and no OpacityMask on the cover. The tile is GridViewItemTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <ContentPresenter />
                        <Grid x:Name="Roll" ClipToBounds="True" IsHitTestVisible="False" Visibility="Hidden">
                            <Rectangle Height="18" VerticalAlignment="Top" Fill="{DynamicResource SelectedBrush}" Opacity="0.22">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0" />
                                        <GradientStop Color="Black" Offset="0.7" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="RollShift" Y="-18" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Border x:Name="SelectionBorder" BorderThickness="1" Margin="-3" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                        <!-- Running game: the Pip-Boy in status blue. A 2px frame inside the cover's edge over a 6px band. LAUNCHING: the screen's refresh line rolls down the cover (a symmetric glow bar, constant speed)
                             while the ruler on the terminal tape at its foot fills; as it lands the prompt lights and the block cursor goes solid (1.7s loop). RUNNING: ruler full, frame breathes, cursor blinks slowly (3.6s). -->
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="6" Opacity="0.16" />
                            <Rectangle x:Name="RunningScan" Visibility="Collapsed" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.32">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.28" /><GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.14" /><GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0" /></LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                            <Grid Height="22" Margin="6,0,6,6" VerticalAlignment="Bottom">
                                <Border Background="{DynamicResource ShellBackgroundBrush}" Opacity="0.88" />
                                <Border BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="0,1,0,0" Opacity="0.4" />
                                <StackPanel Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Path x:Name="RunningPrompt" Data="M0,0 L4,4 L0,8" Width="5" Height="9" Stretch="None" Margin="0,0,5,0" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" StrokeLineJoin="Miter" />
                                    <Rectangle x:Name="RunningMark" Width="7" Height="11" Fill="{DynamicResource RunningIndicatorBrush}" />
                                </StackPanel>
                                <Grid Height="6" Margin="30,0,7,0" VerticalAlignment="Center">
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.45" />
                                    <Grid>
                                        <Grid.OpacityMask>
                                            <DrawingBrush TileMode="Tile" Viewport="0,0,3,6" ViewportUnits="Absolute" Viewbox="0,0,3,6" ViewboxUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="#FF000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,6" /></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush>
                                        </Grid.OpacityMask>
                                        <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                        <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                        <Grid x:Name="BoxFlicker" IsHitTestVisible="False">
                            <Border x:Name="HoverBox" BorderThickness="1" Margin="-3" SnapsToDevicePixels="True" Opacity="0"
                                    BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverBox" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0.75" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Roll" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3" BeginTime="0:0:0.12">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BoxFlicker" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.58" Value="0.8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.64" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.78" Value="0.85" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.84" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RollShift" Storyboard.TargetProperty="Y">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-18" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="520" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RollShift" Storyboard.TargetProperty="Y" To="-18" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BoxFlicker" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Roll" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.05" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="BorderThickness" Value="{DynamicResource FrameThickness}" TargetName="SelectionBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.28" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.14" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.14" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.14" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.28" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.28" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningPrompt" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.12" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.12" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.75" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.75" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.12" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.7" Value="0.12" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningPrompt" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.6" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
