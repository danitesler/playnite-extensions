<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml: the frame around a cover tile in the grid view.
    Selected (static, setters): the Pip-Boy selection box, FrameThickness (1px) of GridViewItemSelectedBorderBrush
    (green), 3px outside the tile, square.
    Hover is the Pip-Boy screen answering the pointer, animated on its own layers (no setters on animated parts):
      in  0.12s in three frame steps (0.4, 0.75, 1): a 1px box in the stronger rule (GridViewItemHoverBorderBrush) steps on
          3px outside the tile and a faint green band (SelectedBrush at 0.22) starts rolling down the cover, once every
          3s (the menus' vertical hold); while hovered the box flickers slightly (bEnableFlickerPipboy).
      out 0.35s: the box decays, the band is cut (FillBehavior Stop on every exit).
    No bloom and no OpacityMask on the cover. The tile is GridViewItemTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <ContentPresenter />
                        <Grid x:Name="Roll" ClipToBounds="True" IsHitTestVisible="False" Visibility="Hidden">
                            <Rectangle Height="18" VerticalAlignment="Top" Fill="{DynamicResource SelectedBrush}" Opacity="0.22">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0" />
                                        <GradientStop Color="Black" Offset="0.7" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="RollShift" Y="-18" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Border x:Name="SelectionBorder" BorderThickness="1" Margin="-3" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                        <Grid x:Name="BoxFlicker" IsHitTestVisible="False">
                            <Border x:Name="HoverBox" BorderThickness="1" Margin="-3" SnapsToDevicePixels="True" Opacity="0"
                                    BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverBox" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0.75" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Roll" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3" BeginTime="0:0:0.12">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BoxFlicker" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.58" Value="0.8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.64" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.78" Value="0.85" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.84" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RollShift" Storyboard.TargetProperty="Y">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-18" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="520" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RollShift" Storyboard.TargetProperty="Y" To="-18" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BoxFlicker" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Roll" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.05" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="BorderThickness" Value="{DynamicResource FrameThickness}" TargetName="SelectionBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
