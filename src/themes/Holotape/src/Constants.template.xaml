<!--
    Holotape: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Fallout 3 and New Vegas, kept quiet: warm near-black yellow-brown surfaces (page 14110a, rail void 0c0a06), body
    text in the New Vegas amber washed toward parchment (text ecd9aa), titles in the amber itself (ffb642), and the
    Fallout 3 Pip-Boy green (1aff80) as the only emphasis: selection outline, focus, checked marks, Play, progress.
    Square corners and 1px lines throughout.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). Placeholder syntax: see reference.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys) -->
    <sys:Double x:Key="FontSizeSmall">{{px:pb-text-sm}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:pb-text-md}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:pb-text-lg}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:pb-text-xl}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:pb-text-2xl}}</sys:Double>
    <!-- Body: Bahnschrift, the squared DIN that ships with Windows 10+, is the closest system face to the games'
         condensed lettering and still reads well in long descriptions. Headings: Monofonto (the Pip-Boy face in both
         games) when the user has it installed; a theme cannot ship fonts and Monofonto's license forbids it anyway.
         Monospace: Fixedsys Excelsior (public domain, close to the RobCo terminal face) when installed, else Consolas. -->
    <FontFamily x:Key="FontFamily">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Monofonto, Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Fixedsys Excelsior 3.01, Consolas</FontFamily>

    <!-- Shape (Playnite keys): square corners, 1px edges -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:pb-radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">0</CornerRadius>
    <!-- The Pip-Boy selection box: a 1px outline -->
    <Thickness x:Key="FrameThickness">{{px:pb-frame}}</Thickness>

    <!--
        Playnite palette. GlyphColor (selection, checked, links) is the Fallout 3 green; TextColorDark is the dark ink
        used on a solid green fill. MainColor is a row, MainColorDark the page.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{pb-text}}</Color>
    <Color x:Key="TextColorDarker">{{pb-text-dim}}</Color>
    <Color x:Key="TextColorDark">{{pb-green-ink}}</Color>
    <Color x:Key="MainColor">{{pb-row}}</Color>
    <Color x:Key="MainColorDark">{{pb-page}}</Color>
    <Color x:Key="HoverColor">{{pb-row-hover}}</Color>
    <Color x:Key="GlyphColor">{{pb-green}}</Color>
    <Color x:Key="HighlightGlyphColor">{{pb-green/40}}</Color>
    <Color x:Key="PopupBackgroundColor">{{pb-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{pb-line-strong}}</Color>
    <Color x:Key="BackgroundToneColor">{{pb-row}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{pb-line}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{pb-line}}</Color>
    <Color x:Key="DataChangeNotifColor">{{pb-amber}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{pb-line}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{pb-panel}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{pb-row}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{pb-well}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{pb-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{pb-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{pb-amber}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{pb-warning}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{pb-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{pb-page}}" />

    <!-- Shell: the rail is the unlit glass around the screen; the views sit on the warm page -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{pb-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{pb-page}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{pb-well}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{pb-row}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{pb-line}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{pb-amber}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{pb-page}}" />

    <!-- States: the Pip-Boy selection, a green 1px outline over a faint green wash, green text -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{pb-green}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{pb-green}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{pb-row}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{pb-green-wash}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{pb-green-wash}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{pb-green}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{pb-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{pb-text}}" />

    <!-- Buttons: a dark row with a hairline edge; Play is the green terminal key (outline, wash, green type) -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{pb-text}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{pb-line}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{pb-row-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{pb-row-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{pb-green-wash}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{pb-green}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{pb-green-wash-strong}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{pb-green}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{pb-green}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{pb-green-wash}}" />

    <!-- Inputs: a recessed terminal well, hairline edge, green edge on focus -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{pb-well}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{pb-void}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{pb-line}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{pb-line-strong}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{pb-text-dim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{pb-text}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{pb-line}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{pb-green}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{pb-green}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{pb-row}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{pb-line}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{pb-line-strong}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{pb-line}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{pb-line-strong}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{pb-green}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{pb-line-strong}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{pb-green}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{pb-row}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{pb-text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{pb-green-wash}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{pb-line}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{pb-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{pb-line-strong}}" />

    <!-- Headings: the New Vegas amber -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{pb-amber}}" />
</ResourceDictionary>
