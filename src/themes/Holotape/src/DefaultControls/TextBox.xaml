<!--
    Overlay on Playnite Default/DefaultControls/TextBox.xaml. A RobCo terminal field: a recessed well
    (InputBackgroundBrush, darker than the page), 1px hairline edge (InputBorderBrush), square, parchment type with a
    green caret, InputPadding (32 tall). Hover: InputHoverBackgroundBrush and InputHoverBorderBrush. Keyboard focus:
    the green 1px edge (FrameThickness of FocusBrush) drawn over the hairline, so nothing shifts.
    BareTextBox: no chrome at all, for hosts that draw their own (search box, editable dropdown).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LocalPhosphorFieldTemplate: a RobCo terminal screen. Faint green scanlines (1px every 3px) cover the field at rest.
        Hover: the scanlines strengthen. Keyboard focus: the screen warms, a soft phosphor glow lights the inner edge and
        a 2px green line sweeps along the bottom from left to right like a CRT refresh (0.18s, linear).
        State is read from the nearest Control above; no desired size.
    -->
    <ControlTemplate x:Key="LocalPhosphorFieldTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle x:Name="Scan" Margin="1" Fill="{DynamicResource FocusBrush}" Opacity="0.09">
                <Rectangle.OpacityMask>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,1,3" ViewportUnits="Absolute" Viewbox="0,0,1,3" ViewboxUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#00000000" Geometry="M0,0 H1 V3 H0 Z" />
                                <GeometryDrawing Brush="#FF000000" Geometry="M0,0 H1 V1 H0 Z" />
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Border x:Name="Glow" Margin="1" BorderThickness="3" BorderBrush="{DynamicResource FocusBrush}" Opacity="0" />
            <Rectangle x:Name="Sweep" Height="2" VerticalAlignment="Bottom" Margin="1,0,1,1" Fill="{DynamicResource FocusBrush}" RenderTransformOrigin="0,0.5">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="SweepScale" ScaleX="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <Setter TargetName="Scan" Property="Opacity" Value="0.15" />
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Scan" Property="Opacity" Value="0.15" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Refresh">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SweepScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Refresh" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Grid>
                            <Border x:Name="Border" BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                            </Border>
                            <Control x:Name="FieldOverlay" Template="{DynamicResource LocalPhosphorFieldTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        </Grid>
                        <Border x:Name="Frame" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderThickness="{DynamicResource FrameThickness}" BorderBrush="{DynamicResource FocusBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" TargetName="Border" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Frame" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No fill, no edge, no padding: the host (search box, editable dropdown) draws the field. -->
    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
