<!--
    Holotape: ContextMenu. Every popup menu and dropdown list (hamburger menu, top bar dropdowns via TopPanelMenu,
    GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select boxes) wears
    the Pip-Boy 3000 / RobCo terminal frame (LocalPipBoyMenuTemplate): warm sepia CRT panel (PopupBackgroundBrush) in a
    1px PopupBorderBrush square frame with faint horizontal scanlines (1px every 3px) and amber Pip-Boy end-tick bracket
    rules across the top and bottom edges. Rows sit 9px below the top edge and 7px above the foot.
    Rows and the 10px tick-ruler group break are in Menu.xaml.
    Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalPipBoyMenuTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="{DynamicResource PopupBorderThickness}" />
            <!-- Faint CRT scanlines: 1px every 3px -->
            <Rectangle Margin="1" Opacity="0.22">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="{DynamicResource ShellBackgroundBrush}">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,4,1" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Top Pip-Boy amber bracket rule with 4px downward end ticks -->
            <Grid Height="5" Margin="6,3,6,0" VerticalAlignment="Top" Opacity="0.72">
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource HeadingForegroundBrush}" />
                <Rectangle Width="1" Height="5" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource HeadingForegroundBrush}" />
                <Rectangle Width="1" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource HeadingForegroundBrush}" />
            </Grid>
            <!-- Bottom Pip-Boy amber bracket rule with 4px upward end ticks -->
            <Grid Height="4" Margin="6,0,6,3" VerticalAlignment="Bottom" Opacity="0.55">
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource HeadingForegroundBrush}" />
                <Rectangle Width="1" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource HeadingForegroundBrush}" />
                <Rectangle Width="1" Height="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource HeadingForegroundBrush}" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalPipBoyMenuTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,9,0,7" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="5,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
