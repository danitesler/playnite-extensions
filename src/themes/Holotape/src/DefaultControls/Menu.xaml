<!--
    Holotape: Menu and MenuItem — Pip-Boy 3000 / RobCo terminal menu rows (Fallout 3 & New Vegas).
    Levers:
    - Panel: sepia CRT panel in 1px square frame with faint 3px scanlines and top/bottom amber end-tick bracket rules
      (LocalPipBoyMenuTemplate in ContextMenu.xaml).
    - Rows: 28px tall, fixed 24px icon column (16px icon muted 0.8 at rest), plain * label column, shared Auto shortcut column.
    - Highlight (IsHighlighted): Pip-Boy 1px green selection outline (SelectedBrush) over 12% green wash (MenuItemHoverBrush)
      steps on like CRT phosphor (3 frames over 90ms) while a monospace green ">" prompt slides in and the label turns green
      (SelectedForegroundBrush); phosphor decay out over 220ms FillBehavior=Stop.
    - Group break (MenuItem.SeparatorStyleKey): 10px tall Pip-Boy tick ruler (1px rule with 4px end ticks and 10px amber gauge ticks).
    - Shortcuts: recessed square RobCo key wells (InputBackgroundBrush, 1px NormalBorderBrush -> SelectedBrush on highlight) with
      MonospaceFontFamily text in amber (HeadingForegroundBrush) turning Pip-Boy green on highlight.
    - Submenu mark: double-chevron ">>" in MonospaceFontFamily (TextBrushDarker -> SelectedForegroundBrush on highlight,
      HeadingForegroundBrush on held green wash + hairline while IsSubmenuOpen).
    - Marked rows: Exit (InputGestureText="Alt+Q") uses a 1px hostile-red outline (DangerBrush) over 22% DangerBrush wash, red ">"
      prompt and parchment DangerForegroundBrush label (~9.8:1 contrast); checked rows (IsChecked) draw the Pip-Boy "equipped"
      12x12 green outline with a solid 6x6 green square inside.
    Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="true" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group break in every menu: 10px Pip-Boy tick ruler (1px rule with 4px end ticks and spaced amber gauge ticks). -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" Margin="6,0" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource MenuSeparatorBrush}" />
                        <Rectangle Height="3" Margin="4,0,4,2" VerticalAlignment="Center" Opacity="0.45">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,12,3" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="{DynamicResource HeadingForegroundBrush}">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,1,3" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Width="1" Height="5" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource PopupBorderBrush}" />
                        <Rectangle Width="1" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource PopupBorderBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TopLevelHeader: an item in a menu bar, opening a popup menu -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid>
            <Border x:Name="HoverBorder" Background="Transparent" />
            <Border x:Name="Frame" Visibility="Collapsed" BorderBrush="{DynamicResource SelectedBrush}"
                    BorderThickness="{DynamicResource FrameThickness}" />
            <TextBlock VerticalAlignment="Center" Padding="12,6" Style="{DynamicResource BaseTextBlockStyle}"
                       Foreground="{TemplateBinding Foreground}">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </TextBlock>
            <Popup Placement="Bottom" VerticalOffset="2" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                <Border Style="{DynamicResource PopupBorder}" SnapsToDevicePixels="True">
                    <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" Margin="{DynamicResource MenuPadding}"
                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="HoverBorder" />
                <Setter Property="Visibility" Value="Visible" TargetName="Frame" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="HoverBorder" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- TopLevelItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid>
            <Border x:Name="HoverBorder" Background="Transparent" />
            <Border x:Name="Frame" Visibility="Collapsed" BorderBrush="{DynamicResource SelectedBrush}"
                    BorderThickness="{DynamicResource FrameThickness}" />
            <TextBlock VerticalAlignment="Center" Padding="12,6" Style="{DynamicResource BaseTextBlockStyle}"
                       Foreground="{TemplateBinding Foreground}">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </TextBlock>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="HoverBorder" />
                <Setter Property="Visibility" Value="Visible" TargetName="Frame" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeader: a row that opens a submenu to the right -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="28" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held plate while submenu is open (setter only, never flickers) -->
            <Border x:Name="MenuHeld" Margin="0,1" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="{DynamicResource MenuItemHoverBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
            <!-- Pip-Boy 1px green selection box over green wash -->
            <Border x:Name="MenuBox" Margin="0,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="{DynamicResource MenuItemHoverBrush}" BorderBrush="{DynamicResource SelectedBrush}"
                    BorderThickness="{DynamicResource FrameThickness}" />
            <!-- RobCo ">" prompt -->
            <TextBlock x:Name="MenuPrompt" Text="&gt;" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource SelectedBrush}" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="MenuPromptShift" X="-4" />
                </TextBlock.RenderTransform>
            </TextBlock>
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.8" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <TextBlock x:Name="MenuArrow" Grid.Column="3" Text="&gt;&gt;" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="10"
                           Foreground="{DynamicResource TextBrushDarker}" />
            </Grid>
            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                   HorizontalOffset="4" VerticalOffset="-9" Focusable="False" AllowsTransparency="True">
                <Grid MinWidth="200" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalPipBoyMenuTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="0,9,0,7" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" Margin="5,0"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="MenuHeld" />
                <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" TargetName="MenuArrow" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuArrow" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuBox" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuPrompt" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuBox" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.045" Value="0.78" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuPrompt" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                            <DoubleAnimation Storyboard.TargetName="MenuPromptShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuBox" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuPrompt" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="MenuPrompt" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="MenuPromptShift" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.22" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuItem: a plain row -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="28" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Pip-Boy 1px green selection box (hostile red outline + wash on Exit) -->
            <Grid x:Name="MenuBox" Margin="0,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="MenuBoxBorder" Background="{DynamicResource MenuItemHoverBrush}"
                        BorderBrush="{DynamicResource SelectedBrush}" BorderThickness="{DynamicResource FrameThickness}" />
                <Rectangle x:Name="MenuDangerWash" Margin="1" Fill="{DynamicResource DangerBrush}" Opacity="0" />
            </Grid>
            <!-- RobCo ">" prompt -->
            <TextBlock x:Name="MenuPrompt" Text="&gt;" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource SelectedBrush}" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="MenuPromptShift" X="-4" />
                </TextBlock.RenderTransform>
            </TextBlock>
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.8" />
                <!-- Pip-Boy "equipped" marker: 12x12 green outline with solid 6x6 green square -->
                <Border x:Name="GlyphPanel" Grid.Column="0" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Visibility="Collapsed" BorderBrush="{DynamicResource SelectedBrush}" BorderThickness="1"
                        Background="{DynamicResource InputBackgroundBrush}">
                    <Rectangle Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Fill="{DynamicResource SelectedBrush}" />
                </Border>
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <Border x:Name="MenuKeyWell" Grid.Column="2" Height="17" Margin="14,0,0,0" Padding="4,0" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="GestureText" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="10.5"
                               Foreground="{DynamicResource HeadingForegroundBrush}" Opacity="0.78" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuKeyWell" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuKeyWell" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" TargetName="Icon" />
                <Setter Property="Background" Value="Transparent" TargetName="MenuBoxBorder" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" TargetName="MenuBoxBorder" />
                <Setter Property="Opacity" Value="0.22" TargetName="MenuDangerWash" />
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" TargetName="MenuPrompt" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" TargetName="MenuKeyWell" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Setter Property="BorderBrush" Value="{DynamicResource SelectedBrush}" TargetName="MenuKeyWell" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="GestureText" />
                <Setter Property="Opacity" Value="1" TargetName="GestureText" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuBox" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuPrompt" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuBox" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.045" Value="0.78" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuPrompt" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                            <DoubleAnimation Storyboard.TargetName="MenuPromptShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuBox" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuPrompt" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="MenuPrompt" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="MenuPromptShift" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.22" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Icon" />
                <!-- Parchment on hostile wash holds ~9.8:1 -->
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="GestureText" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" TargetName="MenuKeyWell" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="true" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
