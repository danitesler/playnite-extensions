<!--
    Overlay on Playnite Default/DefaultControls/ComboBox.xaml. A terminal well with a chevron: InputBackgroundBrush fill,
    1px InputBorderBrush edge, square, InputPadding (32 tall), the value in parchment, the chevron (IconDropDown) in
    TextBrushDarker at the end, parchment on hover and green while open. Hover: InputHover* brushes. Keyboard focus or
    open: the green edge (FrameThickness of FocusBrush).
    Popup: the menus' Pip-Boy CRT panel (LocalPipBoyMenuTemplate, ContextMenu.xaml). Items (ComboBoxItem) are 28px rows
    matching Menu.xaml: stepped 1px Pip-Boy green selection box + RobCo ">" prompt on IsHighlighted, and the "equipped"
    green square marker visible in the leading column on IsSelected.
    Structure kept from the Default template: ToggleButton, ContentSite, PART_EditableTextBox, PART_Popup. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Grid Background="Transparent">
                                                <ContentPresenter x:Name="Chevron" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  Margin="0,0,10,0" IsHitTestVisible="False"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                  Content="{DynamicResource IconDropDown}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                                <ToggleButton x:Name="FilterGroupIndicator" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                              Margin="0,0,-5,0" Background="Transparent" BorderThickness="0" Padding="0" Width="30" Height="28" VerticalAlignment="Center" Visibility="Collapsed"
                                                              IsHitTestVisible="False" Focusable="False" IsChecked="True"
                                                              Style="{DynamicResource ExpanderDownHeaderStyle}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType={x:Type FilterPanel}}, FallbackValue=False}" Value="True">
                                                    <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="FilterGroupIndicator" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Chevron" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Chevron" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- ComboBox-chevron-room: the value never runs under the chevron (12px + 10px margin + 8px gap = 30px kept clear). -->
                                <Border Margin="0,0,30,0" IsHitTestVisible="False">
                                    <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                </Border>
                                <TextBox MinHeight="0" x:Name="PART_EditableTextBox" Style="{DynamicResource BareTextBox}" Visibility="Hidden"
                                         VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                         Margin="8,0,30,0" Focusable="True"
                                         IsReadOnly="{TemplateBinding IsReadOnly}" />
                            </Grid>
                        </Border>
                        <Border x:Name="Frame" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderThickness="{DynamicResource FrameThickness}" BorderBrush="{DynamicResource FocusBrush}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" VerticalOffset="2" Focusable="False" AllowsTransparency="True">
                            <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Control Template="{DynamicResource LocalPipBoyMenuTemplate}" Focusable="False" IsTabStop="False" />
                                <ScrollViewer Margin="0,9,0,7" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Name="ItemsPresenter" Margin="5,0" KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" TargetName="Border" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Frame" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Frame" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="ContentSite" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid x:Name="ListRow" Height="28" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="ListBox" Margin="0,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                                Background="{DynamicResource MenuItemHoverBrush}" BorderBrush="{DynamicResource SelectedBrush}"
                                BorderThickness="{DynamicResource FrameThickness}" />
                        <TextBlock x:Name="ListPrompt" Text="&gt;" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource SelectedBrush}" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="ListPromptShift" X="-4" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <Grid Margin="18,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ListEquipped" Grid.Column="0" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="Collapsed" BorderBrush="{DynamicResource SelectedBrush}" BorderThickness="1"
                                    Background="{DynamicResource InputBackgroundBrush}">
                                <Rectangle Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Fill="{DynamicResource SelectedBrush}" />
                            </Border>
                            <ContentPresenter x:Name="ListLabel" Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="ListEquipped" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ListHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListBox" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListPrompt" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ListBox" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.045" Value="0.78" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListPrompt" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                                        <DoubleAnimation Storyboard.TargetName="ListPromptShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ListHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListBox" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListPrompt" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="ListPrompt" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="ListPromptShift" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" TargetName="ListRow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
