<!--
    Overlay on Playnite Default/Common.xaml. Spacing and focus for Holotape.
    The Pip-Boy lists are dense single-line rows with generous left inset and wide gaps between sections; Holotape keeps
    that rhythm at desktop size: 32px rows (14px text, about 19px tall, + 2 x 6.5), 12px inline padding, square 1px
    edges, and keyboard focus drawn as the Pip-Boy selection box (a 1px green outline) 2px outside the control.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: the panel brown with a 1px rule-colored edge, square -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Keyboard focus: the Pip-Boy selection box, a 1px green outline (FrameThickness) 2px outside the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="{DynamicResource FrameThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: 32 tall, 14 inline -->
    <Thickness x:Key="ButtonPadding">14,6.5</Thickness>
    <!-- Text box, password box, dropdown: 10 inline, 32 tall -->
    <Thickness x:Key="InputPadding">10,6.5</Thickness>
    <!-- Menus: 4px around rows 28 tall, the Pip-Boy list density -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">10,4.5,16,4.5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,4.5,16,4.5</Thickness>
    <!-- List box row: 10 inline, 28 tall -->
    <Thickness x:Key="ListBoxItemPadding">10,4.5</Thickness>
    <!-- Group box: a Pip-Boy section, amber header over a ticked rule, no fill -->
    <Thickness x:Key="GroupBoxPadding">0,12,0,4</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,4</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">15</sys:Double>
    <!-- Tooltip: 10 / 6 -->
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Glyphs at 18px -->
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">320</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">260</sys:Double>
</ResourceDictionary>
