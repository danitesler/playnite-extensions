<!--
    Overlay on Playnite Default/Common.xaml. Spacing and focus for Holotape.
    The Pip-Boy lists are dense single-line rows with generous left inset and wide gaps between sections; Holotape keeps
    that rhythm at desktop size: 32px rows (14px text, about 19px tall, + 2 x 6.5), 12px inline padding, square 1px
    edges, and keyboard focus drawn as the Pip-Boy selection box (a 1px green outline) 2px outside the control.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: the panel brown with a 1px rule-colored edge, square -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Keyboard focus: the Pip-Boy selection box, a 1px green outline (FrameThickness) 2px outside the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="{DynamicResource FrameThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: 32 tall, 14 inline -->
    <Thickness x:Key="ButtonPadding">14,5</Thickness>
    <!-- Text box, password box, dropdown: 10 inline, 32 tall -->
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <!-- Menus: 4px around rows 28 tall, the Pip-Boy list density -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">10,4.5,16,4.5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,4.5,16,4.5</Thickness>
    <!-- List box row: 10 inline, 28 tall -->
    <Thickness x:Key="ListBoxItemPadding">10,4.5</Thickness>
    <!-- Group box: a Pip-Boy section, amber header over a ticked rule, no fill -->
    <Thickness x:Key="GroupBoxPadding">0,12,0,4</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,4</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">15</sys:Double>
    <!-- Tooltip: 10 / 6 -->
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Glyphs at 18px -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a holotape cartridge (chamfered body, label window with three
         data rows) sitting over the Pip-Boy deck's slot line, 26x26 centred in the host. Rest: amber body, dim rows.
         Hover (IsMouseOver): the Pip-Boy selection box steps on around the tape in three frames and the rows light green one
         after another, all discrete steps (0.24s), no easing: the terminal never glides. Leaving fades them (FillBehavior Stop).
         Open (the menu's ContextMenu.IsOpen on the nearest Border, which is PART_ElemMainMenu): the tape is loaded: it drops 2px
         into the slot, the body and slot line turn green, the rows give way to a RobCo prompt (> and a block cursor) whose
         cursor blinks until the menu closes. Hover animates the box and the lit rows, open the body, slot, rows host, prompt and
         cursor, so they layer without fighting. -->
    <ControlTemplate x:Key="LocalHolotapeMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Path Data="M2,23.5 H24" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1.5" Opacity="0.6" />
                <Path x:Name="SlotLit" Data="M2,23.5 H24" Stroke="{DynamicResource SelectedBrush}" StrokeThickness="1.5" Opacity="0" />
                <Rectangle x:Name="Box" Canvas.Left="0.5" Canvas.Top="2.5" Width="25" Height="20" Stroke="{DynamicResource SelectedBrush}" StrokeThickness="1" Opacity="0" />
                <Canvas x:Name="Cart" Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="CartMove" Y="0" /></Canvas.RenderTransform>
                    <Path Data="M2.5,4.5 H17.5 L23.5,10.5 V20.5 H2.5 Z" Stroke="{DynamicResource MainMenuButtonForegroundBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" />
                    <Path x:Name="BodyLit" Data="M2.5,4.5 H17.5 L23.5,10.5 V20.5 H2.5 Z" Stroke="{DynamicResource SelectedBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" Opacity="0" />
                    <Path Data="M5.5,7.5 H12.5" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1" />
                    <Canvas x:Name="RowsHost" Width="26" Height="26">
                        <Path Data="M7.5,11.75 H18 M7.5,14.25 H15 M7.5,16.75 H18" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1.5" />
                        <Path x:Name="Lit1" Data="M7.5,11.75 H18" Stroke="{DynamicResource SelectedBrush}" StrokeThickness="1.5" Opacity="0" />
                        <Path x:Name="Lit2" Data="M7.5,14.25 H15" Stroke="{DynamicResource SelectedBrush}" StrokeThickness="1.5" Opacity="0" />
                        <Path x:Name="Lit3" Data="M7.5,16.75 H18" Stroke="{DynamicResource SelectedBrush}" StrokeThickness="1.5" Opacity="0" />
                    </Canvas>
                    <Path x:Name="Prompt" Data="M6.5,11 L10,14 L6.5,17" Stroke="{DynamicResource SelectedBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" Opacity="0" />
                    <Rectangle x:Name="Cursor" Canvas.Left="12.5" Canvas.Top="14.5" Width="5" Height="3" Fill="{DynamicResource SelectedBrush}" Opacity="0" />
                </Canvas>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Box" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0.65" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.16" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lit1" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lit2" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lit3" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Box" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Lit1" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Lit2" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Lit3" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CartMove" Storyboard.TargetProperty="Y" To="2" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BodyLit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="SlotLit" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="RowsHost" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="Prompt" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.16" Duration="0:0:0.12" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Cursor" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.24" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CartMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BodyLit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SlotLit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RowsHost" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.08" Duration="0:0:0.14" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Prompt" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Cursor" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
