<!--
    Overlay on Playnite Default/Views/Library.xaml.
    The library layer is the warm page (ContentBackgroundBrush). The optional background art (PART_ImageBackground)
    sits behind the views like a picture on a dim CRT: darkened by the page color (ScrimBrush at 75%), faint scanlines
    (the same brush through a tiled 1-in-3 line mask), and a vignette (the same brush through a radial mask, solid at
    the edges). All of it sits in a BitmapCache wrapper because it is masked. Layout and parts are Playnite's.
    Deviation: the Pip-Boy tints everything one color and blooms; WPF has no cheap tint or bloom over live art, so the
    art keeps its own colors under the scrim.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid Background="{TemplateBinding Background}"
                          d:DesignWidth="1500" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
                            <Grid.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                            </Grid.CacheMode>
                            <FadeImage x:Name="PART_ImageBackground"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <Border Background="{DynamicResource ScrimBrush}" Opacity="0.75" />
                            <!-- Scanlines: every third pixel row a little darker, the Pip-Boy screen at its quietest -->
                            <Border Background="{DynamicResource ScrimBrush}" Opacity="0.6">
                                <Border.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Stretch="None"
                                                  Viewport="0,0,100,3" ViewportUnits="Absolute"
                                                  Viewbox="0,0,100,3" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#FF000000">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,2,100,1" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border Background="{DynamicResource ScrimBrush}">
                                <Border.OpacityMask>
                                    <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4" RadiusX="0.75" RadiusY="0.8">
                                        <GradientStop Color="#00000000" Offset="0.35" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>

                        <TopPanel DockPanel.Dock="Top" Grid.Row="0" />

                        <DockPanel Grid.Row="1">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}" />

                            <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                           DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}" />

                            <Grid DockPanel.Dock="Left">
                                <LibraryDetailsView x:Name="PART_ViewDetails" />
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
