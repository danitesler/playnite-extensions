{
    "_comment": "Phosphor 2.1.1 (MIT). Geometry jobs replace the matching keys in Media.xaml. Menu PNGs use src/tokens.css colors. The custom Play, Info and Download geometries stay in Media.xaml.",
    "jobs": [
        {
            "pack": "phosphor",
            "urlTemplate": "https://cdn.jsdelivr.net/npm/@phosphor-icons/core@{ref}/assets/{variant}/{name}{variantSuffix}.svg",
            "ref": "2.1.1",
            "variant": "light",
            "format": "Geometry",
            "keyPrefix": "Icon",
            "xamlOut": "src/Media.xaml",
            "updateXaml": true,
            "icons": [
                "magnifying-glass=Search",
                "x=Clear",
                "sliders-horizontal=ViewSettings",
                "bookmark-simple=FilterPresets",
                "stack=Group",
                "arrows-down-up=Sort",
                "list-dashes=DetailsView",
                "squares-four=GridView",
                "rows=ListView",
                "arrow-circle-down=Update",
                "tree-structure=Explorer",
                "dice-five=Random",
                "shuffle=ViewRandom",
                "funnel-simple=Filter",
                "bell=Notifications",
                "list=MainMenu",
                "vault=Library",
                "chart-bar=Statistics",
                "minus=WindowMinimize",
                "square=WindowMaximize",
                "copy=WindowRestore",
                "x=WindowClose",
                "caret-down=DropDown",
                "caret-right=Submenu",
                "check=Check",
                "plus=Add",
                "pencil-simple=Edit",
                "trash=Remove",
                "dots-three=Options"
            ]
        },
        {
            "pack": "phosphor",
            "urlTemplate": "https://cdn.jsdelivr.net/npm/@phosphor-icons/core@{ref}/assets/{variant}/{name}{variantSuffix}.svg",
            "ref": "2.1.1",
            "variant": "light",
            "format": "Png",
            "outDir": "src/Images/Phosphor",
            "colorToken": "pb-text-dim",
            "icons": [
                "corners-out",
                "plus",
                "arrows-clockwise",
                "info",
                "gear-six",
                "puzzle-piece",
                "play",
                "download-simple",
                "link",
                "folder-open",
                "hard-drives",
                "app-window",
                "star",
                "eye-slash",
                "eye",
                "sun",
                "pencil-simple",
                "dice-five",
                "book-open",
                "archive",
                "clock-counter-clockwise"
            ]
        },
        {
            "pack": "phosphor",
            "urlTemplate": "https://cdn.jsdelivr.net/npm/@phosphor-icons/core@{ref}/assets/{variant}/{name}{variantSuffix}.svg",
            "ref": "2.1.1",
            "variant": "light",
            "format": "Png",
            "outDir": "src/Images/Phosphor",
            "colorToken": "pb-red",
            "icons": [
                "sign-out=sign-out-red",
                "trash=trash-red"
            ]
        },
        {
            "pack": "phosphor",
            "urlTemplate": "https://cdn.jsdelivr.net/npm/@phosphor-icons/core@{ref}/assets/{variant}/{name}{variantSuffix}.svg",
            "ref": "2.1.1",
            "variant": "light",
            "format": "Png",
            "outDir": "src/Images/Phosphor",
            "colorToken": "pb-amber",
            "icons": [
                "star=star-gold"
            ]
        }
    ]
}
