<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    The menus are built from three marks: a hairline, a diamond, and four corner brackets around whatever is current.
    CornerMarksTemplate and DividerTemplate turn the last two into one reusable piece each (drawn in the Foreground of
    the Control that hosts them, so a brush key recolors them); HeadingTextBlock is the caption style above a block.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Four 9px brackets, 1.5px wide, one per corner of the host. Host: a Control with Foreground set and hit testing off,
         stretched over the item it marks (hover, selection, keyboard focus). -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderThickness="1.5,1.5,0,0" BorderBrush="{TemplateBinding Foreground}" />
            <Border Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                    BorderThickness="0,1.5,1.5,0" BorderBrush="{TemplateBinding Foreground}" />
            <Border Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    BorderThickness="0,0,1.5,1.5" BorderBrush="{TemplateBinding Foreground}" />
            <Border Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    BorderThickness="1.5,0,0,1.5" BorderBrush="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- A diamond at the left end and a hairline that fades out to the right. Host: a Control with Foreground set;
         it is 9px tall and as wide as its parent gives it. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="{x:Type Control}">
        <Grid Height="9" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Rectangle Height="1" Margin="12,0,0,0" VerticalAlignment="Center"
                       Fill="{TemplateBinding Foreground}" Opacity="0.7">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="5" Height="5" Margin="1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="45" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Caption above a block of properties, a description or notes: the heading serif in small caps (fonts without
         small caps show it as typed), in the secondary ink so the gold stays for the marks. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <!-- Keyboard focus (WPF shows it for the keyboard only): the four gold corner brackets, hugging the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Margin="-3" IsHitTestVisible="False" Focusable="False"
                             Template="{DynamicResource CornerMarksTemplate}"
                             Foreground="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing: roomier than a desktop app, like the menus (32 to 36px controls, 8px rhythm). -->
    <Thickness x:Key="ButtonPadding">18,8,18,8</Thickness> <!-- Button: 36px tall inside the 1px edge -->
    <Thickness x:Key="InputPadding">10,7,10,7</Thickness> <!-- Text box, password box, dropdown: 34px -->
    <Thickness x:Key="MenuPadding">4</Thickness> <!-- Menu and context menu surface -->
    <Thickness x:Key="MenuItemPadding">14,8,14,8</Thickness> <!-- Menu item: 34px -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness> <!-- Dropdown surface -->
    <Thickness x:Key="ComboBoxItemPadding">12,7,12,7</Thickness> <!-- Dropdown item -->
    <Thickness x:Key="ListBoxItemPadding">12,7,12,7</Thickness> <!-- List box item -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness> <!-- Group box body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness> <!-- Gap under the group box header -->
    <Thickness x:Key="TooltipPadding">12,7,12,8</Thickness> <!-- Tooltip -->
    <sys:Double x:Key="IconSize">20</sys:Double> <!-- Top bar and sidebar icons -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">400</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, so the real carousel replaces it without the page jumping. Each Viewbox scales a fixed 1600px
         layout to the width its column gives it (height is unbounded in a vertical stack). The tiles are the host's
         Foreground at low opacity; the whole thing pulses while visible. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the plugin's ContentControl, visible while that control has no height. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="16"
                        Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
