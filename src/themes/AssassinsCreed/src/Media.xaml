<!--
    Overlay on Playnite Default/Media.xaml.
    Icon set: original artwork drawn for this theme, not taken from any game. Thin monoline strokes on a 24 grid
    (1.5 wide, miter joins, flat caps), diamonds where other sets use dots, chamfers where they use rounded corners.
    icons/*.svg are the sources; each Geometry below is the path data of the matching file, drawn as a stroke by
    IconTemplate (a 24 grid scaled to the host) in the inherited foreground. IconSmallTemplate draws the same
    geometries with a heavier stroke for 12 to 16px hosts (dropdown, submenu and check marks).

    Menu icons (main menu, game menu) are theme file paths: Playnite's MenuHelpers.GetIcon loads a string resource as an
    image through ThemeFile, so each key names a PNG under Images/Icons. Those are the same artwork rendered at 48px
    in the ivory-soft token (crimson-bright for exit and remove, gold for the filled favorite star); icons.json lists
    the jobs for scripts/render-icons.ps1. Sidebar Library and Statistics get their icons through
    CustomControls/SidebarItem.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Top bar, sidebar and window chrome: search, close, view-settings, filter-presets, group, sort, details-view, grid-view, list-view, update, explorer, random, view-random, filter, notifications, main-menu, library, statistics, window-minimize, window-maximize, window-restore -->
    <Geometry x:Key="IconSearch">M4.5 10.5 A6 6 0 1 1 16.5 10.5 A6 6 0 1 1 4.5 10.5 Z M15 15 L20.5 20.5</Geometry>
    <Geometry x:Key="IconClear">M6 6 L18 18 M18 6 L6 18</Geometry>
    <Geometry x:Key="IconViewSettings">M4 6 H10 M14 6 H20 M12 4 L14 6 L12 8 L10 6 Z M4 12 H14 M18 12 H20 M16 10 L18 12 L16 14 L14 12 Z M4 18 H6 M10 18 H20 M8 16 L10 18 L8 20 L6 18 Z</Geometry>
    <Geometry x:Key="IconFilterPresets">M7 3.5 H17 V20.5 L12 16.5 L7 20.5 Z</Geometry>
    <Geometry x:Key="IconGroup">M12 3.5 L20.5 8 L12 12.5 L3.5 8 Z M3.5 12 L12 16.5 L20.5 12 M3.5 16 L12 20.5 L20.5 16</Geometry>
    <Geometry x:Key="IconSort">M4 6.5 H13 M4 12 H10 M4 17.5 H7 M17.5 5 V19 M14 15.5 L17.5 19 L21 15.5</Geometry>
    <Geometry x:Key="IconDetailsView">M3.5 4.5 H20.5 V19.5 H3.5 Z M10 4.5 V19.5 M5.5 8.5 H8 M5.5 12 H8 M5.5 15.5 H8 M13 9 H18 M13 12.5 H17</Geometry>
    <Geometry x:Key="IconGridView">M4 4 H10.5 V10.5 H4 Z M13.5 4 H20 V10.5 H13.5 Z M4 13.5 H10.5 V20 H4 Z M13.5 13.5 H20 V20 H13.5 Z</Geometry>
    <Geometry x:Key="IconListView">M5 4.4 L6.6 6 L5 7.6 L3.4 6 Z M5 10.4 L6.6 12 L5 13.6 L3.4 12 Z M5 16.4 L6.6 18 L5 19.6 L3.4 18 Z M9.5 6 H20.5 M9.5 12 H20.5 M9.5 18 H20.5</Geometry>
    <Geometry x:Key="IconUpdate">M12 4 V15.5 M7 10.5 L12 15.5 L17 10.5 M4.5 19.5 H19.5</Geometry>
    <Geometry x:Key="IconExplorer">M3.5 12 A8.5 8.5 0 1 1 20.5 12 A8.5 8.5 0 1 1 3.5 12 Z M15.8 8.2 L13.6 13.6 L8.2 15.8 L10.4 10.4 Z</Geometry>
    <Geometry x:Key="IconRandom">M12 3 L20 7.5 V16.5 L12 21 L4 16.5 V7.5 Z M4 7.5 L12 12 L20 7.5 M12 12 V21</Geometry>
    <Geometry x:Key="IconViewRandom">M3.5 7 H7.5 L16.5 17 H20.5 M17.5 14 L20.5 17 L17.5 20 M3.5 17 H7.5 L9.5 14.8 M14.5 9.2 L16.5 7 H20.5 M17.5 4 L20.5 7 L17.5 10</Geometry>
    <Geometry x:Key="IconFilter">M3.5 5 H20.5 L14 12.5 V19.5 L10 17 V12.5 Z</Geometry>
    <Geometry x:Key="IconNotifications">M6 15 V10 A6 6 0 0 1 18 10 V15 L20 18 H4 Z M10 20.5 H14</Geometry>
    <Geometry x:Key="IconMainMenu">M4 6.5 H20 M4 17.5 H20 M4 12 H8.5 M15.5 12 H20 M12 8.5 L15.5 12 L12 15.5 L8.5 12 Z</Geometry>
    <Geometry x:Key="IconLibrary">M12 6.5 C10 5 7 4.5 3.5 5 V18.5 C7 18 10 18.5 12 20 C14 18.5 17 18 20.5 18.5 V5 C17 4.5 14 5 12 6.5 Z M12 6.5 V20</Geometry>
    <Geometry x:Key="IconStatistics">M4 4 V20 H20 M7.5 15.5 L11.5 10.5 L14.5 13.5 L19.5 7.5 M16.5 7.5 H19.5 V10.5</Geometry>
    <Geometry x:Key="IconWindowMinimize">M6 12 H18</Geometry>
    <Geometry x:Key="IconWindowMaximize">M6.5 6.5 H17.5 V17.5 H6.5 Z</Geometry>
    <Geometry x:Key="IconWindowRestore">M9 9 V5.5 H18.5 V15 H15 M5.5 9 H15 V18.5 H5.5 Z</Geometry>
    <Geometry x:Key="IconWindowClose">M6 6 L18 18 M18 6 L6 18</Geometry>

    <!-- Select, menu and check indicators: dropdown, submenu, check -->
    <Geometry x:Key="IconDropDown">M6.5 9.5 L12 15 L17.5 9.5</Geometry>
    <Geometry x:Key="IconSubmenu">M9.5 6.5 L15 12 L9.5 17.5</Geometry>
    <Geometry x:Key="IconCheck">M5.5 12.5 L10 17 L18.5 7.5</Geometry>

    <!-- Filter preset actions: add, edit, remove -->
    <Geometry x:Key="IconAdd">M12 5 V19 M5 12 H19</Geometry>
    <Geometry x:Key="IconEdit">M4.5 19.5 L5.5 15 L15.5 5 L19 8.5 L9 18.5 Z M13 7.5 L16.5 11</Geometry>
    <Geometry x:Key="IconRemove">M5 7 H19 M9.5 7 V4.5 H14.5 V7 M6.5 7 L7.5 20 H16.5 L17.5 7 M10 10.5 V16.5 M14 10.5 V16.5</Geometry>

    <!-- Content = one of the geometries above, drawn as a stroke in the inherited foreground. The host sets the size. -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" StrokeThickness="1.5"
                      StrokeLineJoin="Miter" StrokeMiterLimit="4" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" StrokeThickness="2"
                      StrokeLineJoin="Miter" StrokeMiterLimit="4" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource IconSearch}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource IconClear}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <sys:String x:Key="FullscreenModeIcon">Images/Icons/fullscreen.png</sys:String>
    <sys:String x:Key="AddGameIcon">Images/Icons/add.png</sys:String>
    <sys:String x:Key="UpdateDbIcon">Images/Icons/sync.png</sys:String>
    <sys:String x:Key="AboutPlayniteIcon">Images/Icons/info.png</sys:String>
    <sys:String x:Key="ExitIcon">Images/Icons/exit-danger.png</sys:String>
    <sys:String x:Key="SettingsIcon">Images/Icons/settings.png</sys:String>
    <sys:String x:Key="AddonsIcon">Images/Icons/addons.png</sys:String>
    <sys:String x:Key="PlayIcon">Images/Icons/play.png</sys:String>
    <sys:String x:Key="InstallIcon">Images/Icons/install.png</sys:String>
    <sys:String x:Key="LinksIcon">Images/Icons/links.png</sys:String>
    <sys:String x:Key="OpenFolderIcon">Images/Icons/folder.png</sys:String>
    <sys:String x:Key="InstallSizeIcon">Images/Icons/database.png</sys:String>
    <sys:String x:Key="DesktopShortcutIcon">Images/Icons/desktop-shortcut.png</sys:String>
    <sys:String x:Key="AddFavoritesIcon">Images/Icons/star.png</sys:String>
    <sys:String x:Key="RemoveFavoritesIcon">Images/Icons/star-fill.png</sys:String>
    <sys:String x:Key="HideIcon">Images/Icons/eye-closed.png</sys:String>
    <sys:String x:Key="UnHideIcon">Images/Icons/eye.png</sys:String>
    <sys:String x:Key="HdrIcon">Images/Icons/sun.png</sys:String>
    <sys:String x:Key="EditGameIcon">Images/Icons/edit.png</sys:String>
    <sys:String x:Key="RemoveGameIcon">Images/Icons/remove-danger.png</sys:String>
    <sys:String x:Key="DiceIcon">Images/Icons/random.png</sys:String>
    <sys:String x:Key="ManualIcon">Images/Icons/book.png</sys:String>
    <sys:String x:Key="BackupIcon">Images/Icons/archive.png</sys:String>
    <sys:String x:Key="RestoreBackupIcon">Images/Icons/history.png</sys:String>
</ResourceDictionary>
