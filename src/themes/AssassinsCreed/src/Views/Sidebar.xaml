<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    Icon rail on the shell layer: 44px of void, with a hairline on the edge that faces the library. The main menu
    button (menu lines around a diamond, PART_ElemMainMenu) sits at the start of the rail; the items follow, icon
    only. Left and right are vertical; top and bottom are a horizontal strip, and those two keep 146px clear for
    the caption buttons. Views/MainWindow.xaml docks the rail with Playnite's Sidebar position.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Main menu button: 44px, flush with the rail; the diamond turns gold under the pointer. Also used by Views/TopPanel.xaml. -->
    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder"
                            Background="{DynamicResource ShellBackgroundBrush}"
                            BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,1,0">
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                    DockPanel.Dock="Top">
                                <ContentPresenter Width="18" Height="18"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <ScrollViewer x:Name="ScrollSidebarItems" DockPanel.Dock="Top"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="True">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Margin" Value="0,36,0,0" TargetName="PART_ElemMainMenu" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,146,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
