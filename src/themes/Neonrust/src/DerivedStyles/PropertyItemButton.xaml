<!--
    Neonrust: DerivedStyles/PropertyItemButton.xaml.
    Text link by default in Ranger teal; chamfered-feel petrol tag chip when ancestor ItemsControl has Tag="Chip",
    flipping blazing Solar Acid Yellow with dark petrol ink on hover. Uses ControlCornerRadius (never CornerRadiusFull).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Rectangle x:Name="ChipHoverSpray" Visibility="Collapsed" Margin="-7,-4"
                                   Fill="{DynamicResource SelectedBrush}" Opacity="0.54"
                                   OpacityMask="{DynamicResource LocalYellowSprayMask}" IsHitTestVisible="False" />
                        <Border x:Name="ChipPlate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Rectangle x:Name="ChipCornerPip" Width="3" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Margin="-5,-1,0,0" Fill="{DynamicResource GlyphBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Control x:Name="ChipRoughRim" Visibility="Collapsed"
                                 Template="{DynamicResource LocalNeonrustRoughFrameTemplate}"
                                 Foreground="{DynamicResource GlyphBrush}" Opacity="0.72"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Value="Chip">
                            <Setter Property="Background" Value="{DynamicResource PropertyItemBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                            <Setter Property="Padding" Value="8,3" />
                            <Setter Property="Margin" Value="0,0,5,5" />
                            <Setter TargetName="ChipCornerPip" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ChipRoughRim" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedBrush}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Value="Chip" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ChipHoverSpray" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ChipRoughRim" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ChipPlate" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                            <Setter TargetName="ChipPlate" Property="BorderBrush" Value="{DynamicResource GiltHotBrush}" />
                            <Setter TargetName="ChipPlate" Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="ChipCornerPip" Property="Fill" Value="{DynamicResource BeamBrush}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
