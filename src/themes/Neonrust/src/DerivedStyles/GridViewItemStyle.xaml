<!--
    Neonrust: DerivedStyles/GridViewItemStyle.xaml.
    Ranger Datapad / Skill-Slot grid cover tiles (05-inventory / 06-skills):
    - Hover: smooth 1.022 lift + 2px Ranger teal perimeter frame + 4 "+" registration crosshairs at corners.
    - Selected: blazing 2.5px Solar Acid Yellow frame + Hot Punk Magenta top-left & bottom-right chamfer tabs.
    - Running / Launching: Feltrite Electric Blue RunningIndicator inset 4px inside selection with angled
      RunningScan and bottom petrol tape holding 2px RunningFill + 3 staggered Feltrite crystal diamonds.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Border x:Name="BaseFrame" Background="{DynamicResource GridItemBackgroundBrush}"
                                BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <ContentPresenter />
                                <Control Template="{DynamicResource LocalNeonrustRoughFrameTemplate}"
                                         Foreground="{DynamicResource NormalBorderBrush}" Opacity="0.72"
                                         Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <!-- Animated Hover Frame: Outer teal neon glow + rough Ranger Teal rim + 4 "+" registration crosshairs -->
                        <Grid x:Name="HoverFrame" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Rectangle Margin="-12" Fill="{DynamicResource GlyphBrush}" Opacity="0.44"
                                       OpacityMask="{DynamicResource LocalItemGlowMask}" />
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                    BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" BorderThickness="1.5" />
                            <Control Template="{DynamicResource LocalNeonrustRoughFrameTemplate}"
                                     Foreground="{DynamicResource GlyphBrush}"
                                     Focusable="False" IsTabStop="False" />
                            <TextBlock Text="+" FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource GlyphBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,2,0,0" />
                            <TextBlock Text="+" FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource GlyphBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,5,0" />
                            <TextBlock Text="+" FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource GlyphBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5,0,0,2" />
                            <TextBlock Text="+" FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource GlyphBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,2" />
                        </Grid>

                        <!-- Animated Selected Frame: Yellow spray-paint outer glow + Solar Yellow frame + Hot Magenta slashes -->
                        <Grid x:Name="SelectedFrame" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Rectangle Margin="-14" Fill="{DynamicResource SelectedBrush}" Opacity="0.58"
                                       OpacityMask="{DynamicResource LocalItemGlowMask}" />
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                    BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" BorderThickness="2.5" />
                            <Polygon Points="0,0 14,0 0,14" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Fill="{DynamicResource BeamBrush}" />
                            <Polygon Points="14,14 0,14 14,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Fill="{DynamicResource BeamBrush}" />
                        </Grid>

                        <!-- Feltrite Electric Blue Running / Launching Indicator (inset 4px inside selection) -->
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="1" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.18" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningFrame" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                            <!-- Bottom 18px petrol tape holding RunningFill and 3 Feltrite diamonds -->
                            <Border Height="18" VerticalAlignment="Bottom" Margin="2" CornerRadius="1"
                                    Background="{DynamicResource InputBackgroundBrush}" Opacity="0.92">
                                <Grid Margin="6,0">
                                    <Grid Height="2" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                        <Border CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                                        <Border x:Name="RunningFill" CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2">
                                        <Polygon x:Name="CovDia1" Width="6" Height="6" Margin="0,0,4,0" Points="3,0 6,3 3,6 0,3"
                                                 Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.68" RenderTransformOrigin="0.5,0.5">
                                            <Polygon.RenderTransform><ScaleTransform x:Name="CovDia1S" ScaleX="0.85" ScaleY="0.85" /></Polygon.RenderTransform>
                                        </Polygon>
                                        <Polygon x:Name="CovDia2" Width="6" Height="6" Margin="0,0,4,0" Points="3,0 6,3 3,6 0,3"
                                                 Fill="{DynamicResource TextBrush}" Opacity="0.95" RenderTransformOrigin="0.5,0.5">
                                            <Polygon.RenderTransform><ScaleTransform x:Name="CovDia2S" ScaleX="1" ScaleY="1" /></Polygon.RenderTransform>
                                        </Polygon>
                                        <Polygon x:Name="CovDia3" Width="6" Height="6" Points="3,0 6,3 3,6 0,3"
                                                 Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.72" RenderTransformOrigin="0.5,0.5">
                                            <Polygon.RenderTransform><ScaleTransform x:Name="CovDia3S" ScaleX="0.85" ScaleY="0.85" /></Polygon.RenderTransform>
                                        </Polygon>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Panel.ZIndex" Value="5" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CovHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.022" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.022" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CovHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="4" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CovSelIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CovSelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Launching -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.15" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.55" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovDia1S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="0.85" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="1.25" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.3" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovDia2S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.15" Value="1.3" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.95" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovDia3S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="0.85" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.25" Value="1.25" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Running -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovDia1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovDia3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.45" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:3.0" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
