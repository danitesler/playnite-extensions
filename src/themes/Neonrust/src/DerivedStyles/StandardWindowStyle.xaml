<!--
    Neonrust: DerivedStyles/StandardWindowStyle.xaml.
    44px Ranger Datapad dialog title band (CaptionHeight=44 == ContentPresenter top Margin=44):
    - Bruised magenta-plum scratched left wash (LocalGrungeHeaderMask), 3-blade Wingstick mark,
      Solar Yellow Chakra Petch heading, ghosted Wingstick vector watermark inside ClipToBounds Canvas,
      and magenta-to-yellow-to-teal closing rule.
    - WindowSettings AutomationId trigger sets PART_TextTitle.Text to LOCSettingsLabel.
    - WindowDesignStyle defined standalone (never BasedOn StandardWindowStyle: WPF crash guard).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder"
                                BorderBrush="{DynamicResource GlyphBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Perforated metal-net + grunge stains + corner glow over dialog body -->
                                <Grid Margin="0,44,0,0" ClipToBounds="True" IsHitTestVisible="False">
                                    <Rectangle Fill="{DynamicResource GlyphBrush}" Opacity="0.12"
                                               OpacityMask="{DynamicResource LocalDatapadMeshMask}" />
                                    <Rectangle Fill="{DynamicResource CapBarBrush}" Opacity="0.18"
                                               OpacityMask="{DynamicResource LocalBgStainsMask}" />
                                    <Rectangle Fill="{DynamicResource ScrimBrush}" Opacity="0.30"
                                               OpacityMask="{DynamicResource LocalBgStainsMask}" />
                                    <Rectangle Width="340" Height="116" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                               Margin="-40,0,0,-36" Fill="{DynamicResource BeamBrush}" Opacity="0.28"
                                               OpacityMask="{DynamicResource LocalSprayHaloMask}" />
                                    <Rectangle Width="340" Height="110" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Margin="0,0,-30,-36" Fill="{DynamicResource GlyphBrush}" Opacity="0.18"
                                               OpacityMask="{DynamicResource LocalSprayHaloMask}" />
                                </Grid>

                                <!-- Content offset equals CaptionHeight (44) -->
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px Title Band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}">
                                    <Grid ClipToBounds="True" IsHitTestVisible="False">
                                        <!-- Weathered brushed metal strip across full header -->
                                        <Rectangle Fill="{DynamicResource CapBarBrush}" Opacity="0.36"
                                                   OpacityMask="{DynamicResource LocalGrungeHeaderMask}" />
                                        <!-- Bruised magenta-plum scratched left flare + bottom burn glow behind title -->
                                        <Rectangle Width="380" HorizontalAlignment="Left"
                                                   Fill="{DynamicResource HeaderBandBrush}" Opacity="0.90"
                                                   OpacityMask="{DynamicResource LocalGrungeHeaderMask}" />
                                        <Rectangle Width="280" Height="36" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                   Fill="{DynamicResource BeamBrush}" Opacity="0.38"
                                                   OpacityMask="{DynamicResource LocalTitleGlowMask}" />
                                        <!-- Ghosted Tri-Blade Wingstick watermark in Canvas (zero desired width) -->
                                        <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="1" Height="44" Margin="0,0,196,0">
                                            <Viewbox Canvas.Left="-34" Canvas.Top="-12" Width="68" Height="68" Opacity="0.14">
                                                <Canvas Width="64" Height="64">
                                                    <Path Data="{DynamicResource LocalWingstickRingGeo}" Fill="{DynamicResource GlyphBrush}" />
                                                    <Path Data="{DynamicResource LocalWingstickBladesGeo}" Fill="{DynamicResource GlyphBrush}" />
                                                </Canvas>
                                            </Viewbox>
                                        </Canvas>
                                    </Grid>

                                    <!-- Closing rough-etched teal hairline + magenta-to-yellow lead streak -->
                                    <Rectangle Height="4" VerticalAlignment="Bottom" Margin="0,0,0,-1"
                                               Fill="{DynamicResource GlyphBrush}" Opacity="0.65"
                                               OpacityMask="{DynamicResource LocalRoughEdgeHMask}" IsHitTestVisible="False" />
                                    <Rectangle Width="320" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                               Fill="{DynamicResource BeamBrush}" IsHitTestVisible="False">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF000000" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>

                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <Viewbox Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <Canvas Width="64" Height="64">
                                                    <Path Data="{DynamicResource LocalWingstickBladesGeo}" Fill="{DynamicResource SelectedBrush}" />
                                                    <Ellipse Canvas.Left="29" Canvas.Top="29" Width="6" Height="6" Fill="{DynamicResource BeamBrush}" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="PART_TextTitle"
                                                       Text="{TemplateBinding Title}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontWeight="Bold"
                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standalone WindowDesignStyle (TargetType="Window", NEVER BasedOn StandardWindowStyle!) -->
    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
