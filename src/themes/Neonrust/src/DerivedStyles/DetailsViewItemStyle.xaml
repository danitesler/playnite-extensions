<!--
    Neonrust: DerivedStyles/DetailsViewItemStyle.xaml.
    Ranger Datapad game list rows (05-inventory WINGSTICK / 07-codex CROSS):
    - Idle: calm petrol row with subtle 1px teal wireframe border.
    - Hover: smooth 110ms petrol-teal wash + bright Ranger teal rim + sliding teal edge tick + 2px nudge
      + RowHoverAction (26x26 transparent Play / Install glyph, hidden during launch/run, RowHoverRoom 38px).
    - Selected: blazing Solar Acid Yellow (SelectedBrush) slab with pitch-black ink (SelectedForegroundBrush)
      and a springing 3px Hot Punk Magenta edge bar.
    - Running / Launching: Feltrite Electric Blue RunningIndicator above hover & selection with angled RunningScan,
      2px RunningFill, RunningMarkPlate, and 3 staggered Feltrite crystal diamonds inside 48px RowRoom.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="8,3,8,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Idle: dark translucent chamfered plate + RAGE 2 rough-etched weathered teal outline -->
                        <Grid x:Name="IdlePlate" IsHitTestVisible="False">
                            <Rectangle Fill="{DynamicResource InputBackgroundBrush}" Opacity="0.82"
                                       OpacityMask="{DynamicResource LocalYellowSlabMask}" />
                            <Rectangle Fill="{DynamicResource GlyphBrush}" Opacity="0.56"
                                       OpacityMask="{DynamicResource LocalRoughBorderRowMask}" />
                        </Grid>

                        <!-- Animated Hover Plate: soft teal glow + chamfered teal wash + bright rough-etched outline -->
                        <Grid x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Rectangle Margin="-8,-5" Fill="{DynamicResource GlyphBrush}" Opacity="0.28"
                                       OpacityMask="{DynamicResource LocalYellowSprayMask}" />
                            <Rectangle Fill="{DynamicResource ListItemHoverBrush}" Opacity="0.92"
                                       OpacityMask="{DynamicResource LocalYellowSlabMask}" />
                            <Rectangle Fill="{DynamicResource GlyphBrush}" Opacity="0.98"
                                       OpacityMask="{DynamicResource LocalRoughBorderRowMask}" />
                            <Rectangle Width="3" HorizontalAlignment="Left" Margin="1,6"
                                       Fill="{DynamicResource GlyphBrush}" />
                        </Grid>

                        <!-- Selected: Yellow aerosol spray-paint halo + stencil-painted Solar Acid Yellow slab + Hot Magenta bar -->
                        <Grid x:Name="SelectedPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <!-- Outer yellow spray-paint cloud radiating around the selected button -->
                            <Rectangle Margin="-12,-7" Fill="{DynamicResource SelectedBrush}" Opacity="0.68"
                                       OpacityMask="{DynamicResource LocalYellowSprayMask}" />
                            <Rectangle Margin="-7,-4" Fill="{DynamicResource WarningBrush}" Opacity="0.30"
                                       OpacityMask="{DynamicResource LocalYellowSprayMask}" />
                            <!-- Painted chamfered yellow slab (never sterile flat vector) -->
                            <Rectangle Fill="{DynamicResource ListItemSelectedBrush}"
                                       OpacityMask="{DynamicResource LocalYellowSlabMask}" />
                            <!-- Subtle bright highlight along top edge of painted slab -->
                            <Rectangle Margin="2,1,2,10" Fill="{DynamicResource GiltHotBrush}" Opacity="0.38"
                                       OpacityMask="{DynamicResource LocalYellowSlabMask}" />
                            <Rectangle x:Name="SelBar" Width="3" HorizontalAlignment="Left" Margin="1,4"
                                       Fill="{DynamicResource BeamBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="SelBarScale" ScaleY="0.2" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <!-- Feltrite Electric Blue Running / Launching Indicator (above hover & selection) -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="1" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.18"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border x:Name="RunningMarkPlate" Width="48" HorizontalAlignment="Right" Margin="1.5"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.36">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningScan" Visibility="Collapsed"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.44"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.32">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid Height="2" Margin="4,0,4,2" VerticalAlignment="Bottom">
                                <Border CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34" />
                                <Border x:Name="RunningFill" CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <!-- 3 Staggered Feltrite Crystal Diamonds -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,1">
                                <Polygon x:Name="RowDia1" Width="6" Height="6" Margin="0,0,3,0" Points="3,0 6,3 3,6 0,3"
                                         Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.68" RenderTransformOrigin="0.5,0.5">
                                    <Polygon.RenderTransform><ScaleTransform x:Name="RowDia1S" ScaleX="0.85" ScaleY="0.85" /></Polygon.RenderTransform>
                                </Polygon>
                                <Polygon x:Name="RowDia2" Width="6" Height="6" Margin="0,0,3,0" Points="3,0 6,3 3,6 0,3"
                                         Fill="{DynamicResource TextBrush}" Opacity="0.95" RenderTransformOrigin="0.5,0.5">
                                    <Polygon.RenderTransform><ScaleTransform x:Name="RowDia2S" ScaleX="1" ScaleY="1" /></Polygon.RenderTransform>
                                </Polygon>
                                <Polygon x:Name="RowDia3" Width="6" Height="6" Points="3,0 6,3 3,6 0,3"
                                         Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.72" RenderTransformOrigin="0.5,0.5">
                                    <Polygon.RenderTransform><ScaleTransform x:Name="RowDia3S" ScaleX="0.85" ScaleY="0.85" /></Polygon.RenderTransform>
                                </Polygon>
                            </StackPanel>
                        </Grid>

                        <!-- Content Host with RowRoom (running) & RowHoverRoom (RowHoverAction) -->
                        <Border x:Name="RowRoom" Padding="0">
                            <Border x:Name="RowHoverRoom" Padding="0">
                                <Border Padding="{TemplateBinding Padding}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ContentShift" X="0" />
                                    </Border.RenderTransform>
                                    <ContentPresenter />
                                </Border>
                            </Border>
                        </Border>

                        <!-- RowHoverAction: 26x26 transparent Play / Install glyph on right edge while hovered (never during launch/run) -->
                        <Button x:Name="RowHoverPlay" Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0" Cursor="Hand"
                                Focusable="False" IsTabStop="False"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl Content="{DynamicResource IconPlay}"
                                                                        ContentTemplate="{DynamicResource IconTemplate}"
                                                                        Foreground="{TemplateBinding Foreground}" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                        <Setter TargetName="Glyph" Property="Width" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Height" Value="17" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="RowHoverInstall" Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0" Cursor="Hand"
                                Focusable="False" IsTabStop="False"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl Content="{DynamicResource IconDownload}"
                                                                        ContentTemplate="{DynamicResource IconTemplate}"
                                                                        Foreground="{TemplateBinding Foreground}" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                        <Setter TargetName="Glyph" Property="Width" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Height" Value="17" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter TargetName="IdlePlate" Property="Opacity" Value="0.32" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="ContentShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="ContentShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowSelIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelBarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowSelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SelBarScale" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Launching -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,48,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.15" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.55" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowDia1S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="0.85" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="1.25" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.3" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowDia2S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.15" Value="1.3" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.95" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowDia3S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="0.85" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.25" Value="1.25" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Running -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,48,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowDia1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowDia3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.45" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:3.0" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
