<!--
    Neonrust: DerivedStyles/PlayButton.xaml.
    Hero Focal Piece 1 — Hot Punk Magenta Dry-Brush PLAY CTA (RAGE 2 CONTINUE GAME / BUY x1):
    - Rest: Hot Punk Magenta dry-brush slab (LocalBrushBarMask) with crisp white Chakra Petch Bold label.
    - Hover: Aerosol magenta halo (LocalSprayHaloMask) + angled Solar Yellow paint-glint sheen (LocalPaintGlintMask)
      + paired Solar Yellow corner lock ticks closing in (BackEase).
    - Press: Separate PressedPlate in PrimaryButtonPressedBackgroundBrush.
    - Launching / Running: Solid Feltrite Electric Blue (RunningIndicatorBrush) plate darkened by RunningBreath scrim
      (white label >= 6.5:1), angled Feltrite RunningScan sweep (1.55s), PlayRoom right padding (46px) reserving clean room
      for 3 staggered Feltrite crystal diamonds in RunningActionIndicator; Cancel shown ONLY on IsRunning + IsMouseOver(Self)
      hiding PlayContent via Visibility="Hidden".
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinWidth" Value="174" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="26,0,26,0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Idle/Hover Hot Magenta Aerosol Halo behind dry-brush slab (collapsed while running/launching) -->
                        <Grid x:Name="IdleHaloHost" IsHitTestVisible="False">
                            <Rectangle Margin="-14,-8,-14,-8" Fill="{DynamicResource BeamBrush}" Opacity="0.34"
                                       OpacityMask="{DynamicResource LocalSprayHaloMask}" />
                            <Rectangle x:Name="HoverHalo" Margin="-20,-10,-20,-10"
                                       Fill="{DynamicResource BeamBrush}" Opacity="0" Visibility="Collapsed"
                                       OpacityMask="{DynamicResource LocalSprayHaloMask}" />
                        </Grid>

                        <!-- Idle Dry-Brush Slab (shown when not launching/running) -->
                        <Grid x:Name="IdleBrushPlate" IsHitTestVisible="False">
                            <Rectangle Fill="{TemplateBinding Background}" OpacityMask="{DynamicResource LocalBrushBarMask}" />
                            <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0">
                                <Rectangle Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" OpacityMask="{DynamicResource LocalBrushBarMask}" />
                                <Rectangle Margin="6,2" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0.34"
                                           OpacityMask="{DynamicResource LocalPaintGlintMask}" />
                            </Grid>
                            <Rectangle x:Name="PressedPlate" Visibility="Collapsed"
                                       Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                       OpacityMask="{DynamicResource LocalBrushBarMask}" />
                        </Grid>

                        <!-- Launching / Running Feltrite Dry-Brush Plate (matches Play silhouette with >= 6.5:1 label contrast) -->
                        <Border x:Name="RunningSolidPlate" Visibility="Collapsed"
                                Background="{DynamicResource RunningIndicatorBrush}"
                                BorderThickness="0"
                                OpacityMask="{DynamicResource LocalBrushBarMask}"
                                IsHitTestVisible="False">
                            <Grid ClipToBounds="True">
                                <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}" Opacity="0.34" />
                                <Border x:Name="RunningScan" Visibility="Collapsed"
                                        Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.7">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.32">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Border x:Name="RunningHoverDim" Background="{DynamicResource DangerBrush}" Opacity="0" />
                            </Grid>
                        </Border>

                        <!-- Hover Solar Yellow Corner Lock Ticks (collapsed while running/launching) -->
                        <Grid x:Name="IdleTicksHost" IsHitTestVisible="False">
                            <Grid x:Name="HoverTicks" Visibility="Collapsed" Opacity="0">
                                <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,1,0,0">
                                    <Grid.RenderTransform><TranslateTransform x:Name="TickTLShift" X="-5" Y="-4" /></Grid.RenderTransform>
                                    <Rectangle Width="10" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource SelectedBrush}" />
                                    <Rectangle Width="2" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource SelectedBrush}" />
                                </Grid>
                                <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,1">
                                    <Grid.RenderTransform><TranslateTransform x:Name="TickBRShift" X="5" Y="4" /></Grid.RenderTransform>
                                    <Rectangle Width="10" Height="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource SelectedBrush}" />
                                    <Rectangle Width="2" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource SelectedBrush}" />
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Label & Cancel Layer with RunningMarkRoom reservation -->
                        <Grid Margin="{TemplateBinding Padding}">
                            <Border x:Name="PlayRoom" Padding="0">
                                <StackPanel x:Name="PlayContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentControl x:Name="PlayGlyph" Content="{DynamicResource IconPlay}"
                                                    ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                    Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DangerForegroundBrush}"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverHalo" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverTicks" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverHalo" Storyboard.TargetProperty="Opacity" To="0.54" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="HoverTicks" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="TickTLShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TickTLShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TickBRShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TickBRShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverHalo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="HoverTicks" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="TickTLShift" Storyboard.TargetProperty="X" To="-5" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="TickTLShift" Storyboard.TargetProperty="Y" To="-4" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="TickBRShift" Storyboard.TargetProperty="X" To="5" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="TickBRShift" Storyboard.TargetProperty="Y" To="4" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverHalo" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverTicks" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!-- RunningMarkRoom left="0" right="30" -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="IdleHaloHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleBrushPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleTicksHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningSolidPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,30,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,30,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity"
                                                         From="0.34" To="0.50" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="IdleHaloHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleBrushPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleTicksHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningSolidPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,30,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,30,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.26" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.44" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.26" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Running + Hover (Self ONLY, never TemplatedParent): Cancel fades in, PlayContent Hidden -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="CancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="CancelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- RunningActionIndicator overlay placed over the game page Play / ContextAction cell -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="1" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <!-- Segmented 2px foot line -->
                        <Grid Height="2" Margin="6,0,6,4" VerticalAlignment="Bottom">
                            <Border CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.32" />
                            <Border x:Name="RunningFill" CornerRadius="1" Background="{DynamicResource TextBrush}"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <!-- 3 staggered Feltrite crystal diamonds in reserved right strip -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,2">
                            <Polygon x:Name="ActDia1" Width="7" Height="7" Margin="0,0,3,0" Points="3.5,0 7,3.5 3.5,7 0,3.5"
                                     Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.65" RenderTransformOrigin="0.5,0.5">
                                <Polygon.RenderTransform><ScaleTransform x:Name="ActDia1S" ScaleX="0.85" ScaleY="0.85" /></Polygon.RenderTransform>
                            </Polygon>
                            <Polygon x:Name="ActDia2" Width="7" Height="7" Margin="0,0,3,0" Points="3.5,0 7,3.5 3.5,7 0,3.5"
                                     Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.95" RenderTransformOrigin="0.5,0.5">
                                <Polygon.RenderTransform><ScaleTransform x:Name="ActDia2S" ScaleX="1" ScaleY="1" /></Polygon.RenderTransform>
                            </Polygon>
                            <Polygon x:Name="ActDia3" Width="7" Height="7" Points="3.5,0 7,3.5 3.5,7 0,3.5"
                                     Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.72" RenderTransformOrigin="0.5,0.5">
                                <Polygon.RenderTransform><ScaleTransform x:Name="ActDia3S" ScaleX="0.85" ScaleY="0.85" /></Polygon.RenderTransform>
                            </Polygon>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.15" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.55" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDia1S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="0.85" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="1.25" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.3" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDia2S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.15" Value="1.3" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.95" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDia3S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="0.85" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.25" Value="1.25" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.74" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.74" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDia1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDia3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.45" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:3.0" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
