<!--
    Neonrust: DefaultControls/ListView.xaml (implicit ListViewItem style only).
    Petrol-teal hover, blazing Solar Acid Yellow selection slab + Hot Magenta left edge bar,
    and Feltrite Electric Blue RunningIndicator with angled RunningScan, 2px RunningFill,
    RunningMarkPlate, and 3 staggered Feltrite crystal diamonds inside 48px RowRoom.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,4,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="HoverRectangle" Visibility="Collapsed"
                                Background="{DynamicResource ListItemHoverBrush}" IsHitTestVisible="False" />
                        <Grid x:Name="SelectedRectangle" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border Background="{DynamicResource ListItemSelectedBrush}" />
                            <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource BeamBrush}" />
                        </Grid>

                        <!-- Feltrite Electric Blue Running / Launching Indicator -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="1" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.18" />
                            <Border x:Name="RunningMarkPlate" Width="48" HorizontalAlignment="Right" Margin="1.5"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.36">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningScan" Visibility="Collapsed"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.44">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.32">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid Height="2" Margin="4,0,4,2" VerticalAlignment="Bottom">
                                <Border CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34" />
                                <Border x:Name="RunningFill" CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,1">
                                <Polygon x:Name="LvDia1" Width="6" Height="6" Margin="0,0,3,0" Points="3,0 6,3 3,6 0,3"
                                         Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.68" RenderTransformOrigin="0.5,0.5">
                                    <Polygon.RenderTransform><ScaleTransform x:Name="LvDia1S" ScaleX="0.85" ScaleY="0.85" /></Polygon.RenderTransform>
                                </Polygon>
                                <Polygon x:Name="LvDia2" Width="6" Height="6" Margin="0,0,3,0" Points="3,0 6,3 3,6 0,3"
                                         Fill="{DynamicResource TextBrush}" Opacity="0.95" RenderTransformOrigin="0.5,0.5">
                                    <Polygon.RenderTransform><ScaleTransform x:Name="LvDia2S" ScaleX="1" ScaleY="1" /></Polygon.RenderTransform>
                                </Polygon>
                                <Polygon x:Name="LvDia3" Width="6" Height="6" Points="3,0 6,3 3,6 0,3"
                                         Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.72" RenderTransformOrigin="0.5,0.5">
                                    <Polygon.RenderTransform><ScaleTransform x:Name="LvDia3S" ScaleX="0.85" ScaleY="0.85" /></Polygon.RenderTransform>
                                </Polygon>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="RowRoom" Padding="0">
                            <Border Padding="{TemplateBinding Padding}">
                                <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverRectangle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedRectangle" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverRectangle" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,48,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.15" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.55" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LvDia1S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="0.85" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="1.25" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.3" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LvDia2S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.15" Value="1.3" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.95" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LvDia3S" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="0.85" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.25" Value="1.25" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,48,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LvDia1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LvDia3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.45" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:3.0" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
