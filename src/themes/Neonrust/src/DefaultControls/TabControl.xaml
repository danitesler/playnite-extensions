<!--
    Neonrust: DefaultControls/TabControl.xaml.
    Keeps Foreground={DynamicResource TextBrush} on TabItem itself so child dialog labels inherit cleanly;
    idle/hover/selected header colors target HeaderText directly (TabItemColors rule).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,0,1">
                            <TabPanel x:Name="HeaderPanel" Panel.ZIndex="1" IsItemsHost="True" Background="Transparent" />
                        </Border>
                        <Border x:Name="Border" Grid.Row="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0"
                                KeyboardNavigation.TabNavigation="Local"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost" Margin="0,8,0,0" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="Root" Background="Transparent" Margin="0,0,4,0">
                        <!-- Weathered metal tab shell + rough-etched outline -->
                        <Border x:Name="TabPlate" Background="{DynamicResource NormalBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True" IsHitTestVisible="False">
                                <Rectangle Fill="{DynamicResource CapBarBrush}" Opacity="0.34"
                                           OpacityMask="{DynamicResource LocalGrungeHeaderMask}" />
                                <Control x:Name="TabRoughFrame" Template="{DynamicResource LocalNeonrustRoughFrameTemplate}"
                                         Foreground="{DynamicResource NormalBorderBrush}"
                                         Focusable="False" IsTabStop="False" />
                            </Grid>
                        </Border>
                        <!-- Selected: RAGE 2 LOG-style bottom burn highlight inset from tab borders -->
                        <Grid x:Name="SelBurn" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle Margin="-16,-4,-16,-12" Fill="{DynamicResource BeamBrush}" Opacity="0.86"
                                       OpacityMask="{DynamicResource LocalTabBurnHaloMask}" />
                            <Rectangle Margin="3,3,3,1" Fill="{DynamicResource BeamBrush}" Opacity="0.52"
                                       OpacityMask="{DynamicResource LocalTabBurnHaloMask}" />
                            <Rectangle Margin="4,4,4,1" Fill="{DynamicResource WarningBrush}" Opacity="0.70"
                                       OpacityMask="{DynamicResource LocalTabBurnCoreMask}" />
                            <Rectangle Margin="6,5,6,2" Fill="{DynamicResource SelectedBrush}" Opacity="0.98"
                                       OpacityMask="{DynamicResource LocalTabBurnCoreMask}" />
                            <Rectangle Margin="10,7,10,2" Fill="{DynamicResource GiltHotBrush}" Opacity="0.82"
                                       OpacityMask="{DynamicResource LocalTabBurnCoreMask}" />
                        </Grid>
                        <TextBlock x:Name="HeaderText" Margin="{TemplateBinding Padding}"
                                   FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TabItemForegroundBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabPlate" Property="Background" Value="{DynamicResource ListItemHoverBrush}" />
                            <Setter TargetName="TabRoughFrame" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabPlate" Property="Background" Value="{DynamicResource NormalBrushDark}" />
                            <Setter TargetName="TabRoughFrame" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="SelBurn" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="HeaderText" Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
