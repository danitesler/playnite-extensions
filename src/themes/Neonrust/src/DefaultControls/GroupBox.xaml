<!--
    Neonrust: DefaultControls/GroupBox.xaml.
    Content-sized Ranger Datapad dossier card (Statistics page safe: zero wide Paths or fixed widths >=200).
    Crowned by a bruised magenta-plum scratched header cap (LocalGrungeHeaderMask inside ClipToBounds Grid).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Grid ClipToBounds="True" IsHitTestVisible="False">
                                    <Rectangle Fill="{DynamicResource GlyphBrush}" Opacity="0.10"
                                               OpacityMask="{DynamicResource LocalDatapadMeshMask}" />
                                    <Rectangle Fill="{DynamicResource ScrimBrush}" Opacity="0.22"
                                               OpacityMask="{DynamicResource LocalBgStainsMask}" />
                                </Grid>
                                <DockPanel>
                                    <!-- Bruised magenta-plum scratched header band with rising title glow -->
                                    <Border x:Name="HeaderBand" DockPanel.Dock="Top"
                                            Background="{DynamicResource HeaderBandBrush}"
                                            BorderBrush="Transparent" BorderThickness="0">
                                        <Grid ClipToBounds="True">
                                            <Rectangle Fill="{DynamicResource BeamBrush}" Opacity="0.32"
                                                       OpacityMask="{DynamicResource LocalGrungeHeaderMask}" IsHitTestVisible="False" />
                                            <Rectangle Height="30" VerticalAlignment="Bottom" Fill="{DynamicResource BeamBrush}" Opacity="0.44"
                                                       OpacityMask="{DynamicResource LocalTitleGlowMask}" IsHitTestVisible="False" />
                                            <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource SelectedBrush}" IsHitTestVisible="False" />
                                            <Rectangle Height="4" VerticalAlignment="Bottom" Margin="0,0,0,-1"
                                                       Fill="{DynamicResource GlyphBrush}" Opacity="0.68"
                                                       OpacityMask="{DynamicResource LocalRoughEdgeHMask}" IsHitTestVisible="False" />
                                            <ContentPresenter Margin="{DynamicResource GroupBoxHeaderPadding}"
                                                              ContentSource="Header" RecognizesAccessKey="True"
                                                              TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                              TextElement.FontWeight="Bold"
                                                              TextElement.FontSize="{DynamicResource GroupBoxHeaderFontSize}"
                                                              TextElement.Foreground="{DynamicResource HeaderBandForegroundBrush}" />
                                        </Grid>
                                    </Border>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                                </DockPanel>
                            </Grid>
                        </Border>
                        <Control Template="{DynamicResource LocalNeonrustRoughFrameTemplate}"
                                 Foreground="{DynamicResource GlyphBrush}" Opacity="0.70"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderBand" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
