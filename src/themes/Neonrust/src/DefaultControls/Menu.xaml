<!--
    Neonrust: DefaultControls/Menu.xaml.
    Unified Ranger Datapad + Anarchy Dry-Brush popup menu rows:
    - Compact 30px rows, fixed 26px icon column, plain "*" label column (trims cleanly), shared-size shortcut column.
    - Highlight: Hot Punk Magenta dry-brush swipe (LocalBrushBarMask) slides in (115ms) with a 3px Solar Yellow vertical stub;
      label turns crisp white and kicks 2px right.
    - Group break: 10px break with 14px hot-magenta brush stub, 4px Solar Yellow diamond, and 1px Ranger teal hairline.
    - Shortcuts: Dark-petrol monospace key chips with 1px teal rim; light up Solar Yellow on highlight.
    - Submenu mark: Sharp chevron turning Solar Yellow on highlight; IsSubmenuOpen holds a petrol-teal + yellow-bar plate.
    - Marked rows: Alt+Q Exit shows Authority Crimson label & keycap at rest, flipping to solid Authority Crimson dry-brush slab
      with stark white label (>5.6:1) on highlight; checked rows show a Solar Yellow rotated diamond check.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group Break (SeparatorStyleKey): <=10px tall -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" Margin="6,0,8,0" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Width="14" Height="2" VerticalAlignment="Center" Margin="0,0,5,0"
                                   Fill="{DynamicResource BeamBrush}" Opacity="0.85" />
                        <Rectangle Grid.Column="1" Width="4" Height="4" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Fill="{DynamicResource SelectedBrush}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                                   Fill="{DynamicResource MenuSeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SubmenuItemTemplateKey: Plain 30px menu row -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated Hot Punk Magenta dry-brush highlight slab + Solar Yellow stub -->
            <Grid x:Name="HighlightPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HighlightSlide" X="-6" />
                </Grid.RenderTransform>
                <Rectangle x:Name="BrushFill" Fill="{DynamicResource MenuItemHoverBrush}"
                           OpacityMask="{DynamicResource LocalBrushBarMask}" />
                <Rectangle x:Name="LeadStub" Width="3" HorizontalAlignment="Left" Margin="0,4"
                           Fill="{DynamicResource SelectedBrush}" />
            </Grid>

            <Grid Margin="6,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcutCol" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <!-- Fixed 26px Icon / Check slot -->
                <Grid Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource GlyphBrush}" />
                    <Grid x:Name="CheckMark" Visibility="Collapsed" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Polygon Points="7,1 13,7 7,13 1,7" Fill="{DynamicResource SelectedBrush}" />
                        <ContentControl Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Width="8" Height="8" Foreground="{DynamicResource SelectedForegroundBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- Plain * Label column -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="True" VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelSlide" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Shared-size Shortcut keycap chip -->
                <Border x:Name="ShortcutChip" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0"
                        Padding="5,1" Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusSmall}">
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11"
                               Foreground="{DynamicResource TextBrushDarker}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutChip" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutChip" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!-- Exit (Alt+Q) at rest: Authority Crimson label + crimson-rimmed keycap -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutChip" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="BrushFill" Property="Fill" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="LeadStub" Property="Fill" Value="{DynamicResource DangerForegroundBrush}" />
            </Trigger>

            <!-- Highlight (pointer or keyboard) -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter TargetName="ShortcutChip" Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                <Setter TargetName="ShortcutChip" Property="BorderBrush" Value="{DynamicResource SelectedBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource SelectedBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.115" />
                            <DoubleAnimation Storyboard.TargetName="HighlightSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.115">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.115" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.17" />
                            <DoubleAnimation Storyboard.TargetName="HighlightSlide" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.17" />
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.17" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.17" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Exit highlighted: Authority Crimson dry-brush slab with stark white label & keycap (>=5.6:1) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutChip" Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeaderTemplateKey: 30px parent row with submenu popup -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held plate while submenu is open (never flickers) -->
            <Grid x:Name="OpenPlate" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource ListItemHoverBrush}" />
                <Rectangle Width="3" HorizontalAlignment="Left" Margin="0,4" Fill="{DynamicResource SelectedBrush}" />
            </Grid>

            <!-- Animated Hot Punk Magenta dry-brush highlight -->
            <Grid x:Name="HighlightPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HighlightSlide" X="-6" />
                </Grid.RenderTransform>
                <Rectangle Fill="{DynamicResource MenuItemHoverBrush}" OpacityMask="{DynamicResource LocalBrushBarMask}" />
                <Rectangle Width="3" HorizontalAlignment="Left" Margin="0,4" Fill="{DynamicResource SelectedBrush}" />
            </Grid>

            <Grid Margin="6,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcutCol" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource GlyphBrush}" />
                </Grid>

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="True" VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelSlide" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <ContentControl x:Name="SubArrow" Grid.Column="3" Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource GlyphBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Popup x:Name="Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-7"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade">
                <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" MinWidth="208">
                    <Control Template="{DynamicResource LocalNeonrustMenuBoardTemplate}"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    <ScrollViewer CanContentScroll="True" Margin="4,7,4,6"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource SelectedBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource SelectedBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.115" />
                            <DoubleAnimation Storyboard.TargetName="HighlightSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.115">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.115" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.17" />
                            <DoubleAnimation Storyboard.TargetName="HighlightSlide" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.17" />
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.17" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.17" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
