<!-- Neonrust: DefaultControls/ToolTip.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TooltipForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource TooltipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TooltipBorderBrush}" />
        <Setter Property="Padding" Value="{DynamicResource TooltipPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <Rectangle Fill="{DynamicResource GlyphBrush}" Opacity="0.09"
                                           OpacityMask="{DynamicResource LocalDatapadMeshMask}" IsHitTestVisible="False" />
                                <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource BeamBrush}" IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <Control Template="{DynamicResource LocalNeonrustRoughFrameTemplate}"
                                 Foreground="{DynamicResource GlyphBrush}" Opacity="0.80"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
