<!--
    Neonrust: DefaultControls/Button.xaml.
    32px ControlHeight via Height=NaN trigger; ThemeModifier 41px icon-button uniform 32/41 LayoutTransform;
    IsDefault=True wears RAGE 2's Hot Punk Magenta dry-brush slab (LocalBrushBarMask).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Standard Ranger metal plate with weathered texture + rough-etched chamfered outline -->
                        <Grid x:Name="Border" IsHitTestVisible="False">
                            <Rectangle Fill="{TemplateBinding Background}" OpacityMask="{DynamicResource LocalYellowSlabMask}" />
                            <Rectangle Fill="{DynamicResource CapBarBrush}" Opacity="0.18"
                                       OpacityMask="{DynamicResource LocalGrungeHeaderMask}" />
                            <Rectangle Fill="{DynamicResource GlyphBrush}" Opacity="0.68"
                                       OpacityMask="{DynamicResource LocalRoughBorderRowMask}" />
                        </Grid>
                        <!-- Default-button Hot Punk Magenta aerosol halo + dry-brush plate -->
                        <Grid x:Name="DefaultBrushHost" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle Margin="-12,-6" Fill="{DynamicResource BeamBrush}" Opacity="0.46"
                                       OpacityMask="{DynamicResource LocalSprayHaloMask}" />
                            <Rectangle x:Name="DefaultBrush"
                                       Fill="{DynamicResource PrimaryButtonBackgroundBrush}"
                                       OpacityMask="{DynamicResource LocalBrushBarMask}" />
                        </Grid>
                        <!-- Hover wash + teal glow + bright rough-etched outline -->
                        <Grid x:Name="HoverOverlay" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Rectangle Margin="-8,-5" Fill="{DynamicResource GlyphBrush}" Opacity="0.28"
                                       OpacityMask="{DynamicResource LocalYellowSprayMask}" />
                            <Rectangle Fill="{DynamicResource ButtonHoverBackgroundBrush}"
                                       OpacityMask="{DynamicResource LocalYellowSlabMask}" />
                            <Rectangle Fill="{DynamicResource GlyphBrush}"
                                       OpacityMask="{DynamicResource LocalRoughBorderRowMask}" />
                        </Grid>
                        <!-- Pressed wash -->
                        <Grid x:Name="PressedOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle Fill="{DynamicResource ButtonPressedBackgroundBrush}"
                                       OpacityMask="{DynamicResource LocalYellowSlabMask}" />
                            <Rectangle Fill="{DynamicResource SelectedBrush}"
                                       OpacityMask="{DynamicResource LocalRoughBorderRowMask}" />
                        </Grid>
                        <!-- Top-left diagonal accent notch -->
                        <Rectangle x:Name="CornerPip" Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Margin="3,2,0,0" Fill="{DynamicResource GlyphBrush}" Opacity="0.65" IsHitTestVisible="False" />

                        <ContentPresenter x:Name="ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Border" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CornerPip" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DefaultBrushHost" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Padding" Value="22,5" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
                            <Setter TargetName="CornerPip" Property="Fill" Value="{DynamicResource SelectedBrush}" />
                            <Setter TargetName="CornerPip" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BtnHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="BtnHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HoverOverlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DefaultBrush" Property="Fill" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedOverlay" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PressedOverlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DefaultBrush" Property="Fill" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Standard 32px height when no explicit Height is set -->
            <Trigger Property="Height" Value="{x:Static sys:Double.NaN}">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <!-- ThemeModifier hardcoded Width=41 icon buttons scaled uniformly 32/41 -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SimpleButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Plate" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BottomButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="MinWidth" Value="92" />
    </Style>
</ResourceDictionary>
