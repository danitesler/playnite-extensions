<!--
    Neonrust: DefaultControls/ContextMenu.xaml.
    Unified popup menu board (LocalNeonrustMenuBoardTemplate):
    - Panel: Smoked petrol-teal Ranger Datapad sheet with subtle datapad-mesh.png lattice, 1px teal border,
      3px Hot Punk Magenta top spray-cap band (with Solar Yellow lead bar), and "+" corner registration marks.
    - Shared across ContextMenu, TopPanelMenu, submenus, and ComboBox popups.
    - UseLayoutRounding="True" keeps 16px bare PNG menu icons sharp at 125%/175% DPI scaling.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalNeonrustMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <Grid ClipToBounds="True">
                    <!-- Perforated metal-net + grunge stains -->
                    <Rectangle Fill="{DynamicResource GlyphBrush}" Opacity="0.11"
                               OpacityMask="{DynamicResource LocalDatapadMeshMask}" />
                    <Rectangle Fill="{DynamicResource ScrimBrush}" Opacity="0.24"
                               OpacityMask="{DynamicResource LocalBgStainsMask}" />
                    <!-- Top hot-magenta burn bleed under cap -->
                    <Rectangle Height="36" VerticalAlignment="Top" Fill="{DynamicResource BeamBrush}" Opacity="0.22"
                               OpacityMask="{DynamicResource LocalSprayHaloMask}" />
                    <!-- 3px Hot Punk Magenta top spray-cap + Solar Yellow lead segment -->
                    <Rectangle Height="3" VerticalAlignment="Top" Fill="{DynamicResource BeamBrush}" />
                    <Rectangle Width="42" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Fill="{DynamicResource SelectedBrush}" />
                    <!-- Bottom right subtle teal corner tick -->
                    <Rectangle Width="28" Height="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Fill="{DynamicResource GlyphBrush}" Opacity="0.7" />
                    <!-- Miniature "+" registration crosshair top-right -->
                    <TextBlock Text="+" FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="10"
                               Foreground="{DynamicResource GlyphBrush}" Opacity="0.55"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,5,0" />
                </Grid>
            </Border>
            <!-- Rough-etched 4-sided popup outline -->
            <Control Template="{DynamicResource LocalNeonrustRoughFrameTemplate}"
                     Foreground="{DynamicResource GlyphBrush}" Opacity="0.78"
                     Focusable="False" IsTabStop="False" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="216" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuRoot" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Control Template="{DynamicResource LocalNeonrustMenuBoardTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ScrollViewer CanContentScroll="True" Margin="4,7,4,6"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
