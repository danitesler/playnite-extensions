<!--
    Neonrust: DefaultControls/TextBox.xaml.
    Shared field signature (LocalNeonrustFieldTemplate, hosted by TextBox, PasswordBox, ComboBox):
    - Edge: Deep petrol-void well framed in 1px Ranger teal with 45-deg top-right micro corner glint.
    - Rest mark: 3x14px vertical Ranger teal stub inside the left edge + 3 bottom Video Settings stepped ticks.
    - Hover (IsMouseOver on ancestor Control): Left stub extends and illuminates; top-right corner tick lights teal.
    - Focus (Tag="Active" set by host): One-shot (160ms) Hot Punk Magenta bottom rail sweep grows across the floor
      while the left stub flips blazing Solar Acid Yellow and the stepped ticks ignite magenta.
    Zero desired size (Rectangles only, no Stretch="Fill" Path). ControlHeight=32; BareTextBox stays chromeless.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalNeonrustFieldTemplate" TargetType="{x:Type Control}">
        <Grid ClipToBounds="True" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Left vertical Ranger stub (stays inside left InputPadding inset) -->
            <Rectangle x:Name="LeftStub" Width="2.5" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="1,0,0,0" Fill="{DynamicResource GlyphBrush}" Opacity="0.82" />
            <!-- Hover top-right diagonal corner glint -->
            <Grid x:Name="HoverTicks" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Opacity="0">
                <Rectangle Width="7" Height="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" />
                <Rectangle Width="1.5" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" />
            </Grid>
            <!-- Video Settings stepped ticks along bottom-left floor -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,1">
                <Rectangle x:Name="Tick1" Width="8" Height="1.5" Margin="0,0,2,0" Fill="{DynamicResource InputUnderlineBrush}" />
                <Rectangle x:Name="Tick2" Width="8" Height="1.5" Margin="0,0,2,0" Fill="{DynamicResource InputUnderlineBrush}" />
                <Rectangle x:Name="Tick3" Width="8" Height="1.5" Fill="{DynamicResource InputUnderlineBrush}" />
            </StackPanel>
            <!-- One-shot Hot Punk Magenta bottom trace on Tag="Active" -->
            <Rectangle x:Name="FocusBar" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                       Fill="{DynamicResource BeamBrush}" Opacity="0" RenderTransformOrigin="0,0.5">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="FocusBarScale" ScaleX="0.05" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <!-- Active Solar Yellow stub overlay -->
            <Rectangle x:Name="ActiveStub" Width="3" VerticalAlignment="Stretch" HorizontalAlignment="Left"
                       Margin="0,2,0,2" Fill="{DynamicResource SelectedBrush}" Opacity="0" />
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="FieldHoverIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LeftStub" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="HoverTicks" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.11" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard x:Name="FieldHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="LeftStub" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="HoverTicks" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Tick1" Property="Fill" Value="{DynamicResource BeamBrush}" />
                <Setter TargetName="Tick2" Property="Fill" Value="{DynamicResource BeamBrush}" />
                <Setter TargetName="Tick3" Property="Fill" Value="{DynamicResource SelectedBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="FieldFocusIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ActiveStub" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="FocusBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="FocusBarScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="FieldFocusOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="ActiveStub" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="FocusBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="FocusBarScale" Storyboard.TargetProperty="ScaleX" To="0.05" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="CaretBrush" Value="{DynamicResource SelectedBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BeamBrush}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False" />
                        </Border>
                        <Control x:Name="FieldOverlay"
                                 Template="{DynamicResource LocalNeonrustFieldTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                            <Setter Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Border" />
                            <Setter Property="Tag" Value="Active" TargetName="FieldOverlay" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chromeless inner TextBox for SearchBox and editable ComboBox -->
    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource SelectedBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BeamBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
