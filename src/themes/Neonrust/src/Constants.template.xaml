<!--
    Neonrust: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Palette and shared keys mapped from RAGE 2 Ranger Datapad & Anarchy Overlay research (RESEARCH.md).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite + shared keys) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">30</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Chakra Petch, Chakra Petch, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width & position -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape (Playnite + shared keys) -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:nr-radius-md}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:nr-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:nr-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:nr-radius-full}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">0</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{nr-ink}}</Color>
    <Color x:Key="TextColorDarker">{{nr-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{nr-ink-dark}}</Color>
    <Color x:Key="MainColor">{{nr-surface}}</Color>
    <Color x:Key="MainColorDark">{{nr-surface-hi}}</Color>
    <Color x:Key="HoverColor">{{nr-teal-wash}}</Color>
    <Color x:Key="GlyphColor">{{nr-teal}}</Color>
    <Color x:Key="HighlightGlyphColor">{{nr-teal-highlight}}</Color>
    <Color x:Key="PopupBackgroundColor">{{nr-popup}}</Color>
    <Color x:Key="PopupBorderColor">{{nr-teal-dim}}</Color>
    <Color x:Key="BackgroundToneColor">{{nr-void}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">#00000000</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{nr-teal-dim}}</Color>
    <Color x:Key="DataChangeNotifColor">{{nr-magenta-neon}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{nr-teal-dim}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{nr-tooltip}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{nr-surface-hi}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{nr-void}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{nr-emerald}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{nr-crimson}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{nr-amber}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{nr-amber}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{nr-surface}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{nr-ground}}" />

    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{nr-surface}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{nr-ground}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{nr-top-bar}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{nr-void}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{nr-surface}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{nr-void}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{nr-teal-dim}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{nr-magenta-neon}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{nr-scrim}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{nr-banner-tint}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{nr-void}}" />

    <!-- Game page -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{nr-banner-tint}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{nr-ground}}" />

    <!-- States -->
    <SolidColorBrush x:Key="BeamBrush" Color="{{nr-magenta-neon}}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{{nr-yellow}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{nr-yellow-bright}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{nr-yellow}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{nr-ink-dark}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{nr-feltrite}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{nr-teal-wash}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{nr-yellow}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{nr-magenta}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{nr-magenta-neon}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{nr-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{nr-white}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{nr-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{nr-white}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{nr-teal-wash}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{nr-teal-press}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{nr-teal-dim}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{nr-magenta}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{nr-magenta-neon}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{nr-magenta-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{nr-magenta-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{nr-white}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{nr-yellow}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{nr-surface-hi}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{nr-teal-dim}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{nr-teal-wash}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{nr-teal-press}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{nr-yellow}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{nr-void}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{nr-surface}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{nr-teal-dim}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="InputUnderlineBrush" Color="{{nr-teal-subtle}}" />
    <SolidColorBrush x:Key="InputHoverUnderlineBrush" Color="{{nr-magenta-neon}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{nr-teal-dim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{nr-void}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{nr-yellow}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{nr-magenta-neon}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{nr-white}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{nr-void}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{nr-teal-dim}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{nr-void}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{nr-teal-dim}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{nr-ink-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{nr-ink}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{nr-yellow}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{nr-magenta-neon}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{nr-tab-metal}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{nr-yellow}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{nr-teal-wash}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{nr-yellow}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{nr-ink-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{nr-ink-dark}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{nr-magenta-neon}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{nr-surface-hi}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{nr-yellow}}" />

    <!-- Popups, Frames & Typography -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{nr-teal-subtle}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{nr-ink}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{nr-top-bar}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{nr-yellow}}" />
    <SolidColorBrush x:Key="CapBarBrush" Color="{{nr-tab-metal}}" />
    <SolidColorBrush x:Key="CapBarLitBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{nr-magenta-wash}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{nr-yellow}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{nr-yellow}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{nr-magenta-neon}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{nr-teal-dim}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="GiltHotBrush" Color="{{nr-yellow-bright}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{nr-teal-dim}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{nr-teal}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{nr-teal-subtle}}" />
</ResourceDictionary>
