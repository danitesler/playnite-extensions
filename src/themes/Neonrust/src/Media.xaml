<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Neonrust bespoke chamfered vector icon set (RAGE 2 Ranger Datapad geometry) -->

    <DataTemplate x:Key="IconTemplate">
        <Viewbox MaxWidth="{DynamicResource IconSize}"
                 MaxHeight="{DynamicResource IconSize}"
                 Stretch="Uniform"
                 SnapsToDevicePixels="True">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"
                      Stretch="None" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox MaxWidth="12" MaxHeight="12" Stretch="Uniform" SnapsToDevicePixels="True">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"
                      Stretch="None" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileTemplate">
        <Viewbox MaxWidth="22" MaxHeight="22" Stretch="Uniform" SnapsToDevicePixels="True">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"
                      Stretch="None" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileSolidTemplate">
        <Viewbox MaxWidth="22" MaxHeight="22" Stretch="Uniform" SnapsToDevicePixels="True">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"
                      Stretch="None" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

