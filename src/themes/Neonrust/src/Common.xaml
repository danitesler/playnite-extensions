<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Neonrust spacing, shared FX masks, chamfered brand graphics, and animated Wingstick menu mark -->
    <Thickness x:Key="ButtonPadding">12,5</Thickness>
    <Thickness x:Key="InputPadding">12,5,10,5</Thickness>
    <Thickness x:Key="MenuPadding">4,6</Thickness>
    <Thickness x:Key="MenuItemPadding">10,4</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4,6</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,5</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,5</Thickness>
    <Thickness x:Key="GroupBoxPadding">12,10</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">10,6</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">13</sys:Double>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Shared procedural white-mask ImageBrushes (src/Images/fx/*.png) -->
    <ImageBrush x:Key="LocalBrushBarMask" ImageSource="{ThemeFile 'Images/fx/brush-bar.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalDatapadMeshMask" ImageSource="{ThemeFile 'Images/fx/datapad-mesh.png'}" TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute" Stretch="None" />
    <ImageBrush x:Key="LocalBgStainsMask" ImageSource="{ThemeFile 'Images/fx/bg-stains.png'}" TileMode="Tile" Viewport="0,0,512,512" ViewportUnits="Absolute" Stretch="None" />
    <ImageBrush x:Key="LocalSprayHaloMask" ImageSource="{ThemeFile 'Images/fx/spray-halo.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalYellowSprayMask" ImageSource="{ThemeFile 'Images/fx/yellow-spray.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalYellowSlabMask" ImageSource="{ThemeFile 'Images/fx/yellow-slab.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalRoughBorderRowMask" ImageSource="{ThemeFile 'Images/fx/rough-border-row.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalRoughEdgeHMask" ImageSource="{ThemeFile 'Images/fx/rough-edge-h.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalRoughEdgeVMask" ImageSource="{ThemeFile 'Images/fx/rough-edge-v.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalTabBurnCoreMask" ImageSource="{ThemeFile 'Images/fx/tab-burn-core.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalTabBurnHaloMask" ImageSource="{ThemeFile 'Images/fx/tab-burn-halo.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalTitleGlowMask" ImageSource="{ThemeFile 'Images/fx/title-glow.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalItemGlowMask" ImageSource="{ThemeFile 'Images/fx/item-glow.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalGrungeHeaderMask" ImageSource="{ThemeFile 'Images/fx/grunge-header.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalPaintGlintMask" ImageSource="{ThemeFile 'Images/fx/paint-glint.png'}" Stretch="Fill" />

    <!-- Shared 3-blade Wingstick rotor geometries (64x64 viewbox) -->
    <StreamGeometry x:Key="LocalWingstickRingGeo">M 15,9 L 49,9 L 55,15 L 55,26 L 50,26 L 50,17.5 L 46.5,14 L 17.5,14 L 14,17.5 L 14,26 L 9,26 L 9,15 Z M 9,38 L 14,38 L 14,46.5 L 17.5,50 L 46.5,50 L 50,46.5 L 50,38 L 55,38 L 55,49 L 49,55 L 15,55 L 9,49 Z</StreamGeometry>
    <StreamGeometry x:Key="LocalWingstickBladesGeo">M 32,14 L 37.5,19.5 L 35.5,29.5 L 46.5,34.5 L 49,41.5 L 42,44.5 L 33.5,37.5 L 25.5,46 L 18,45 L 17.5,37.5 L 27.5,32.5 L 27.5,19.5 Z M 32,28.5 A 3.5,3.5 0 1 0 32,35.5 A 3.5,3.5 0 1 0 32,28.5 Z</StreamGeometry>

    <!-- Popup border style -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus visual: crisp Ranger teal + Solar Yellow diagonal ticks -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Rectangle Margin="-2" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1.5" StrokeDashArray="4 2" />
                        <Rectangle Width="6" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,-2,0,0" Fill="{DynamicResource SelectedBrush}" />
                        <Rectangle Width="6" Height="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Fill="{DynamicResource SelectedBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading style -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
    </Style>

    <!-- Metadata / section divider: 5px Solar Yellow diamond + rough-etched Ranger teal hairline (zero desired width) -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="{x:Type Control}">
        <Grid Height="10" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Width="5" Height="5" Fill="{DynamicResource SelectedBrush}"
                       VerticalAlignment="Center" Margin="1,0,7,0" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="45" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Grid.Column="1" Height="4" VerticalAlignment="Center"
                       Fill="{DynamicResource GlyphBrush}" Opacity="0.62"
                       OpacityMask="{DynamicResource LocalRoughEdgeHMask}" />
        </Grid>
    </ControlTemplate>

    <!-- Reusable 4-sided rough-etched panel border overlay (zero desired size, never distorts aspect) -->
    <ControlTemplate x:Key="LocalNeonrustRoughFrameTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Rectangle Height="4" VerticalAlignment="Top" Margin="0,-1,0,0"
                       Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalRoughEdgeHMask}" />
            <Rectangle Height="4" VerticalAlignment="Bottom" Margin="0,0,0,-1"
                       Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalRoughEdgeHMask}" />
            <Rectangle Width="4" HorizontalAlignment="Left" Margin="-1,0,0,0"
                       Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalRoughEdgeVMask}" />
            <Rectangle Width="4" HorizontalAlignment="Right" Margin="0,0,-1,0"
                       Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalRoughEdgeVMask}" />
        </Grid>
    </ControlTemplate>

    <!-- Perforated metal-net + mottled grunge stains + ambient edge glows (collapses under ShowBackgroundImageOnWindow) -->
    <ControlTemplate x:Key="LocalNeonrustBackdropTemplate" TargetType="{x:Type Control}">
        <Grid ClipToBounds="True" IsHitTestVisible="False">
            <!-- Perforated metal-net rough texture -->
            <Rectangle Fill="{DynamicResource GlyphBrush}" Opacity="0.13"
                       OpacityMask="{DynamicResource LocalDatapadMeshMask}" />
            <!-- Large-scale mottled oxidation & dark grime stains -->
            <Rectangle Fill="{DynamicResource CapBarBrush}" Opacity="0.22"
                       OpacityMask="{DynamicResource LocalBgStainsMask}" />
            <Rectangle Fill="{DynamicResource ScrimBrush}" Opacity="0.34"
                       OpacityMask="{DynamicResource LocalBgStainsMask}" />
            <!-- Ambient wasteland neon edge bleeds (hot magenta bottom-left, smoky teal bottom-center/right & top) -->
            <Rectangle Width="440" Height="156" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="-46,0,0,-48" Fill="{DynamicResource BeamBrush}" Opacity="0.34"
                       OpacityMask="{DynamicResource LocalSprayHaloMask}" />
            <Rectangle Width="520" Height="140" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="40,0,0,-48" Fill="{DynamicResource GlyphBrush}" Opacity="0.24"
                       OpacityMask="{DynamicResource LocalSprayHaloMask}" />
            <Rectangle Width="420" Height="124" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,-32,-42" Fill="{DynamicResource GlyphBrush}" Opacity="0.18"
                       OpacityMask="{DynamicResource LocalSprayHaloMask}" />
            <Rectangle Width="460" Height="110" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="80,-44,0,0" Fill="{DynamicResource GlyphBrush}" Opacity="0.12"
                       OpacityMask="{DynamicResource LocalSprayHaloMask}" />
        </Grid>
    </ControlTemplate>

    <!-- SteamScreenshots 12s loading skeleton -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <Grid Margin="0,0,0,16" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="220" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="+" FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11" Foreground="{DynamicResource GlyphBrush}" Opacity="0.6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,2,0,0" />
                    <TextBlock Text="+" FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11" Foreground="{DynamicResource GlyphBrush}" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,2" />
                    <Rectangle x:Name="SkelPulse" Fill="{DynamicResource GlyphBrush}" Opacity="0.08" />
                </Grid>
            </Border>
            <UniformGrid Grid.Row="2" Columns="5">
                <Border Height="54" Margin="0,0,6,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Height="54" Margin="3,0,3,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Height="54" Margin="3,0,3,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Height="54" Margin="3,0,3,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Height="54" Margin="6,0,0,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
            </UniformGrid>
        </Grid>
    </ControlTemplate>

    <!-- Designed Empty State (Intel Attained modal horizon lines + 3-Blade Wingstick mark) -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="{x:Type Control}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center" Width="380">
                <Grid Height="2" Margin="0,0,0,22">
                    <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}" Opacity="0.8" />
                    <Rectangle Width="120" Height="2" HorizontalAlignment="Center" Fill="{DynamicResource BeamBrush}" />
                </Grid>

                <Viewbox Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Canvas Width="64" Height="64">
                        <Path Data="{DynamicResource LocalWingstickRingGeo}" Fill="{DynamicResource NormalBorderBrush}" />
                        <Path Data="{DynamicResource LocalWingstickBladesGeo}" Fill="{DynamicResource SelectedBrush}" />
                        <Ellipse Canvas.Left="29" Canvas.Top="29" Width="6" Height="6" Fill="{DynamicResource BeamBrush}" />
                    </Canvas>
                </Viewbox>

                <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                           FontFamily="{DynamicResource HeadingFontFamily}"
                           FontWeight="Bold" FontSize="17"
                           Foreground="{DynamicResource HeadingForegroundBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                <Grid Height="2" Margin="0,22,0,0">
                    <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}" Opacity="0.8" />
                    <Rectangle Width="80" Height="2" HorizontalAlignment="Center" Fill="{DynamicResource GlyphBrush}" />
                </Grid>
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <!--
        MAIN MENU MARK (required unique animated mark): LocalNeonrustMenuMarkTemplate
        Motif: Tri-Blade Wingstick Rotor inside a broken chamfered stencil reticle (RAGE 2 Wingstick + Datapad).
        - Rest: Ranger teal rotor inside oxidized-teal broken ring, subtle magenta hub core.
        - Hover (IsMouseOver): Rotor rotates 120 deg smoothly (BackEase) while outer stencil ring flashes Solar Yellow.
        - Open (ContextMenu.IsOpen on ancestor Border): Separate outer container breathes & oscillates gently,
          central magenta hub flares up, and 4 Solar Yellow corner lock ticks expand outward.
        Hover and Open target completely separate elements/transforms so they never conflict.
    -->
    <ControlTemplate x:Key="LocalNeonrustMenuMarkTemplate" TargetType="{x:Type Control}">
        <Grid Background="Transparent" Width="28" Height="28" SnapsToDevicePixels="True">
            <!-- Open-state ambient corner ticks (separate elements, never touched by hover) -->
            <Grid x:Name="OpenTicks" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="OpenTicksScale" ScaleX="0.72" ScaleY="0.72" />
                </Grid.RenderTransform>
                <Rectangle Width="5" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource SelectedBrush}" />
                <Rectangle Width="2" Height="5" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource SelectedBrush}" />
                <Rectangle Width="5" Height="2" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource SelectedBrush}" />
                <Rectangle Width="2" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource SelectedBrush}" />
                <Rectangle Width="5" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource SelectedBrush}" />
                <Rectangle Width="2" Height="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource SelectedBrush}" />
                <Rectangle Width="5" Height="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource SelectedBrush}" />
                <Rectangle Width="2" Height="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource SelectedBrush}" />
            </Grid>

            <!-- Outer open-state oscillation container -->
            <Viewbox x:Name="MarkHost" Width="26" Height="26" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Viewbox.RenderTransform>
                    <RotateTransform x:Name="OpenRotorAngle" Angle="0" />
                </Viewbox.RenderTransform>
                <Canvas Width="64" Height="64">
                    <!-- Broken chamfered stencil ring (rest + hover yellow flash layer) -->
                    <Path Data="{DynamicResource LocalWingstickRingGeo}" Fill="{DynamicResource NormalBorderBrush}" />
                    <Path x:Name="HoverRingFlash" Data="{DynamicResource LocalWingstickRingGeo}"
                          Fill="{DynamicResource SelectedBrush}" Opacity="0" />

                    <!-- 3-blade Wingstick rotor (spins in place around exact hub 32,32 on hover) -->
                    <Path x:Name="HoverRotor" Data="{DynamicResource LocalWingstickBladesGeo}"
                          Fill="{DynamicResource MainMenuButtonForegroundBrush}">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="HoverRotorAngle" Angle="0" CenterX="32" CenterY="32" />
                        </Path.RenderTransform>
                    </Path>

                    <!-- Central hub core (rest small magenta dot; open flares with pulsing ring) -->
                    <Ellipse Canvas.Left="29" Canvas.Top="29" Width="6" Height="6" Fill="{DynamicResource BeamBrush}" />
                    <Ellipse x:Name="OpenCoreFlare" Canvas.Left="26" Canvas.Top="26" Width="12" Height="12"
                             Fill="{DynamicResource BeamBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="OpenCoreScale" ScaleX="0.4" ScaleY="0.4" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Viewbox>
        </Grid>

        <ControlTemplate.Triggers>
            <!-- Hover: spin Wingstick rotor continuously in place around hub (32,32) + flash outer ring Solar Yellow -->
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="MenuMarkHoverIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverRotorAngle" Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:0.95" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="HoverRingFlash" Storyboard.TargetProperty="Opacity"
                                             To="0.95" Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard x:Name="MenuMarkHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverRotorAngle" Storyboard.TargetProperty="Angle"
                                             To="0" Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HoverRingFlash" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>

            <!-- Menu Open: lock ticks outward, ignite magenta core flare, slow breathing oscillation -->
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="MenuMarkOpenIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OpenTicks" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="OpenTicksScale" Storyboard.TargetProperty="ScaleX"
                                             To="1.06" Duration="0:0:0.20">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="OpenTicksScale" Storyboard.TargetProperty="ScaleY"
                                             To="1.06" Duration="0:0:0.20">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="OpenCoreFlare" Storyboard.TargetProperty="Opacity"
                                             From="0.55" To="1" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="OpenCoreScale" Storyboard.TargetProperty="ScaleX"
                                             From="0.82" To="1.12" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="OpenCoreScale" Storyboard.TargetProperty="ScaleY"
                                             From="0.82" To="1.12" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="OpenRotorAngle" Storyboard.TargetProperty="Angle"
                                             From="-8" To="8" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard x:Name="MenuMarkOpenOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="OpenTicks" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="OpenTicksScale" Storyboard.TargetProperty="ScaleX" To="0.72" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="OpenTicksScale" Storyboard.TargetProperty="ScaleY" To="0.72" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="OpenCoreFlare" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="OpenCoreScale" Storyboard.TargetProperty="ScaleX" To="0.4" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="OpenCoreScale" Storyboard.TargetProperty="ScaleY" To="0.4" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="OpenRotorAngle" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
