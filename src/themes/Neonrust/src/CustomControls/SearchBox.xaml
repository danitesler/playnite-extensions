<!--
    Neonrust: CustomControls/SearchBox.xaml.
    Sunken petrol-void Ranger search well with vertical left stub (flips Solar Yellow on focus),
    bottom stepped ticks, Hot Magenta focus rail, persistent magnifier Glyph outside PART_SeachIcon,
    and full-hit transparent Border template on PART_ClearTextIcon.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Field" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="{DynamicResource ControlBorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <!-- Left vertical Ranger stub -->
                                <Rectangle x:Name="LeftStub" Width="2.5" HorizontalAlignment="Left" Margin="1,6,0,6"
                                           Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                                <!-- Bottom stepped Video Settings ticks -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Margin="12,0,0,1" IsHitTestVisible="False">
                                    <Rectangle Width="8" Height="1.5" Margin="0,0,2,0" Fill="{DynamicResource InputUnderlineBrush}" />
                                    <Rectangle x:Name="TickMid" Width="8" Height="1.5" Margin="0,0,2,0" Fill="{DynamicResource BeamBrush}" Opacity="0.72" />
                                    <Rectangle Width="8" Height="1.5" Fill="{DynamicResource InputUnderlineBrush}" />
                                </StackPanel>
                                <!-- Focus magenta-to-yellow bottom sweep -->
                                <Rectangle x:Name="FocusFlare" Height="2" VerticalAlignment="Bottom"
                                           Fill="{DynamicResource BeamBrush}" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

                                <ContentControl x:Name="Glyph" Focusable="False" Content="{DynamicResource IconSearch}"
                                                ContentTemplate="{DynamicResource IconTemplate}"
                                                Foreground="{DynamicResource GlyphBrush}" Margin="10,0,0,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                IsHitTestVisible="False" Panel.ZIndex="1" />
                                <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                                <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                         Padding="34,0,28,0" VerticalContentAlignment="Center" />
                                <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}"
                                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,4,0" Cursor="Hand"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ContentControl.Template>
                                        <ControlTemplate TargetType="ContentControl">
                                            <Border Background="Transparent" Padding="4">
                                                <ContentPresenter ContentSource="Content" />
                                            </Border>
                                        </ControlTemplate>
                                    </ContentControl.Template>
                                </ContentControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                            <Setter TargetName="LeftStub" Property="Margin" Value="0,4,0,4" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="LeftStub" Property="Fill" Value="{DynamicResource SelectedBrush}" />
                            <Setter TargetName="LeftStub" Property="Margin" Value="0,2,0,2" />
                            <Setter TargetName="FocusFlare" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusFlare" Property="Opacity" Value="0.95" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TextInpuText" Property="Padding" Value="10,0,28,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
