<!--
    Neonrust: CustomControls/TopPanelItem.xaml.
    34x32 oxidized-metal Ranger bumper socket; hover lifts teal wash + teal rim;
    IsToggled ignites RAGE 2's blazing Solar Acid Yellow active tab wrapped in a Hot Punk Magenta spray halo!
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TopPanelItem}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanelItem}">
                    <Grid Background="Transparent">
                        <!-- Weathered metal socket with rough-etched outline -->
                        <Border Background="{DynamicResource NormalBrushDark}"
                                BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                            <Grid ClipToBounds="True">
                                <Rectangle Fill="{DynamicResource CapBarBrush}" Opacity="0.24"
                                           OpacityMask="{DynamicResource LocalGrungeHeaderMask}" />
                                <Control Template="{DynamicResource LocalNeonrustRoughFrameTemplate}"
                                         Foreground="{DynamicResource NormalBorderBrush}" Opacity="0.88"
                                         Focusable="False" IsTabStop="False" />
                            </Grid>
                        </Border>
                        <!-- Animated hover plate with teal glow + rough rim -->
                        <Grid x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Rectangle Margin="-8,-5" Fill="{DynamicResource GlyphBrush}" Opacity="0.28"
                                       OpacityMask="{DynamicResource LocalItemGlowMask}" />
                            <Border Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Control Template="{DynamicResource LocalNeonrustRoughFrameTemplate}"
                                     Foreground="{DynamicResource GlyphBrush}"
                                     Focusable="False" IsTabStop="False" />
                        </Grid>
                        <!-- Toggled: RAGE 2 LOG-style incandescent inner bottom burn that does NOT touch the borders -->
                        <Grid x:Name="ActiveWash" Visibility="Collapsed" IsHitTestVisible="False">
                            <!-- Wide fiery magenta burn bloom spilling gently downward & into neighbors -->
                            <Rectangle Margin="-16,-5,-16,-14" Fill="{DynamicResource BeamBrush}" Opacity="0.90"
                                       OpacityMask="{DynamicResource LocalTabBurnHaloMask}" />
                            <!-- Weathered gunmetal tab shell with visible rough border -->
                            <Border Background="{DynamicResource NormalBrushDark}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Control Template="{DynamicResource LocalNeonrustRoughFrameTemplate}"
                                     Foreground="{DynamicResource GlyphBrush}" Opacity="0.72"
                                     Focusable="False" IsTabStop="False" />
                            <!-- Inset inner bottom burn: magenta outer rim -> warm amber -> acid yellow hot core -->
                            <Rectangle Margin="2,2,2,1" Fill="{DynamicResource BeamBrush}" Opacity="0.62"
                                       OpacityMask="{DynamicResource LocalTabBurnHaloMask}" />
                            <Rectangle Margin="2,2,2,1" Fill="{DynamicResource WarningBrush}" Opacity="0.78"
                                       OpacityMask="{DynamicResource LocalTabBurnCoreMask}" />
                            <Rectangle Margin="2,2,2,1" Fill="{DynamicResource TopPanelItemCheckedBackgroundBrush}" Opacity="1"
                                       OpacityMask="{DynamicResource LocalTabBurnCoreMask}" />
                            <Rectangle Margin="4,4,4,2" Fill="{DynamicResource GiltHotBrush}" Opacity="0.90"
                                       OpacityMask="{DynamicResource LocalTabBurnCoreMask}" />
                        </Grid>
                        <Border x:Name="Border" BorderThickness="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TopHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TopHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.17" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.17" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsToggled" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="ActiveWash" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsToggled" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
