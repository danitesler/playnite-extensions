<!--
    Hextech navigation bar: the client's top bar. 56px, near-black, the hexagon mark at the left, then one tab per sidebar item
    (icon and title), a hairline of dark gold fading out toward both ends. 150px stay clear on the right for the window buttons.
    The sidebar position setting is ignored: MainWindow.xaml always docks this control to the top.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border Height="56" Background="{DynamicResource ShellBackgroundBrush}">
                        <Grid>
                            <DockPanel>
                                <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource MainMenuButton}"
                                        DockPanel.Dock="Left" Width="64">
                                    <ContentPresenter Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Content="{DynamicResource IconMainMenu}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                              DockPanel.Dock="Left" Margin="0,0,150,0" x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Horizontal" />
                                </ScrollViewer>
                            </DockPanel>
                            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource PanelSeparatorBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.35" />
                                        <GradientStop Color="#FF000000" Offset="0.65" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
