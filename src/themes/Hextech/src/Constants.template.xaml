<!--
    Hextech: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    Token names (hx-*) stay in tokens.css; here each placeholder names the token that plays the key's role.
    Gold is the accent (selection, links, hover edges); hextech blue is kept for the Play button and focus.
    Theme XAML reads brushes only, never Color keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). Body is Segoe UI; headings, tabs and Play use Palatino Linotype, the closest serif Windows ships to the client's Beaufort. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">30</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Palatino Linotype</FontFamily>

    <!-- Shape (Playnite keys). -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:hx-radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <CornerRadius x:Key="CornerRadiusSmall">{{px:hx-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:hx-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:hx-radius-full}}</CornerRadius>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{hx-text}}</Color>
    <Color x:Key="TextColorDarker">{{hx-text-muted}}</Color>
    <Color x:Key="TextColorDark">{{hx-void}}</Color>
    <Color x:Key="MainColor">{{hx-button}}</Color>
    <Color x:Key="MainColorDark">{{hx-card}}</Color>
    <Color x:Key="HoverColor">{{hx-card-hover}}</Color>
    <Color x:Key="GlyphColor">{{hx-gold-3}}</Color>
    <Color x:Key="HighlightGlyphColor">{{hx-gold-3/50}}</Color>
    <Color x:Key="PopupBackgroundColor">{{hx-void}}</Color>
    <Color x:Key="PopupBorderColor">{{hx-gold-6}}</Color>
    <Color x:Key="BackgroundToneColor">{{hx-card}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{hx-card}}</Color>
    <Color x:Key="PanelSeparatorColor">{{hx-gold-6}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{hx-gold-7}}</Color>
    <Color x:Key="DataChangeNotifColor">{{hx-amber}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{hx-gold-6}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{{hx-card-hover}}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{hx-void}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{hx-button}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{hx-void}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{hx-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{hx-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{hx-amber}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{hx-red}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{hx-card}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{hx-page}}" />

    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{hx-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{hx-page}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{hx-page}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{hx-void}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{hx-card}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{hx-card-active}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{hx-gold-7}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{hx-gold-3}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{hx-gold-7}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{hx-gold-1}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{hx-card-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{hx-gold-7}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{hx-card-active}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{hx-blue-1}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{hx-red-deep}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{hx-text}}" />

    <!-- Buttons: flat grey with a gold edge; Play is hextech blue -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{hx-gold-2}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{hx-gold-6}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{hx-button-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{hx-button-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{hx-blue-4}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{hx-blue-1}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{hx-blue-3}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{hx-blue-5}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{hx-blue-hi}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{hx-gold-7}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{hx-void}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{hx-gold-6}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{hx-gold-5}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{hx-gold-5}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{hx-gold-3}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{hx-card-active}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{hx-gold-3}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{hx-blue-1}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{hx-card-active}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{hx-gold-6}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{hx-gold-5}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{hx-gold-6}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{hx-gold-5}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{hx-gold-3}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{hx-gold-5}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{hx-gold-5}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{hx-button}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{hx-gold-2}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{hx-button-hover}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{hx-gold-7}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{hx-gold-1}}" />
</ResourceDictionary>
