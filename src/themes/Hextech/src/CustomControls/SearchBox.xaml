<!--
    Hextech search box: a near-black well with a 1px dark-gold edge (brighter gold on hover, full gold while typing),
    gold-grey magnifier. TopPanelSearchBox is the same box on the top bar; the implicit style is the one dialogs get.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Frame" Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                        <Grid>
                            <ContentControl x:Name="PART_SeachIcon"
                                            ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"
                                            Foreground="{DynamicResource ButtonForegroundBrush}" />
                            <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     VerticalContentAlignment="Center" Padding="34,0,30,0" />
                            <ContentControl x:Name="PART_ClearTextIcon"
                                            ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"
                                            Foreground="{DynamicResource TextBrushDarker}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger SourceName="PART_TextInpuText" Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelSearchBox" TargetType="SearchBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Frame" Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                        <Grid>
                            <ContentControl x:Name="PART_SeachIcon"
                                            ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"
                                            Foreground="{DynamicResource ButtonForegroundBrush}" />
                            <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     VerticalContentAlignment="Center" Padding="34,0,30,0" />
                            <ContentControl x:Name="PART_ClearTextIcon"
                                            ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"
                                            Foreground="{DynamicResource TextBrushDarker}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger SourceName="PART_TextInpuText" Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
