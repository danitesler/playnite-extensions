<!--
    Hextech overlay on Playnite Default/Common.xaml: only restyled keys live here.
    Spacing follows the client's flat, generous controls: 34px buttons and inputs, 32px menu rows.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menus, dropdowns, popups: near-black panel with a 1px dark-gold edge, square corners. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Keyboard focus: a 1px hextech-blue outline just outside the control edge. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">18,7</Thickness>
    <Thickness x:Key="InputPadding">10,7</Thickness>
    <Thickness x:Key="MenuPadding">2</Thickness>
    <Thickness x:Key="MenuItemPadding">14,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">2</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">12,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">12,7</Thickness>
    <Thickness x:Key="GroupBoxPadding">16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,10</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <sys:Double x:Key="IconSize">20</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->

    <!-- Main menu button: the hexagon mark, gold at rest, cream when hovered. -->
    <Style x:Key="MainMenuButton" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bare text box for hosts that draw their own frame (search box). -->
    <Style x:Key="BareTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main window minimize, maximize, close: Playnite sets Content to 0, 1, 2 (restore) or r (close). -->
    <Style x:Key="MainWindowButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="12" Height="12">
                            <ContentPresenter x:Name="IcoMin" Visibility="Collapsed" Content="{DynamicResource IconWindowMinimize}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <ContentPresenter x:Name="IcoMax" Visibility="Collapsed" Content="{DynamicResource IconWindowMaximize}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <ContentPresenter x:Name="IcoRes" Visibility="Collapsed" Content="{DynamicResource IconWindowRestore}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <ContentPresenter x:Name="IcoClose" Visibility="Collapsed" Content="{DynamicResource IconWindowClose}" ContentTemplate="{DynamicResource IconTemplate}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                            <Setter TargetName="IcoMin" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Value="1">
                            <Setter TargetName="IcoMax" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Value="2">
                            <Setter TargetName="IcoRes" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Value="r">
                            <Setter TargetName="IcoClose" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="r" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
