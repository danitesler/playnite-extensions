<!--
    Testbed: Common.xaml — spacing keys, shared white-mask ImageBrushes, modular test-chamber chrome templates
    (BrandMarkTemplate, GlowFrameTemplate, DividerTemplate, CornerMarksTemplate, LocalPanelGridTemplate,
    LocalAntlineDotsTemplate, EmptyGameTemplate, SteamScreenshotsSkeletonTemplate, HeadingTextBlock, SecondaryButton).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Spacing & Metric Keys (per repo FormControlHeight & Menu rules) -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>               <!-- Standard 32px inputs, combos, buttons -->
    <sys:Double x:Key="IconSize">16</sys:Double>                    <!-- Compact rail and top bar glyphs -->
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>           <!-- Default hero banner height (0..600) -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>             <!-- Default banner darkening slider (0..1) -->
    <Thickness x:Key="ButtonPadding">14,5</Thickness>               <!-- 1px border + 5px v-pad = 32px -->
    <Thickness x:Key="InputPadding">9,5</Thickness>                 <!-- TextBox / PasswordBox / ComboBox -->
    <Thickness x:Key="MenuPadding">8,12,8,6</Thickness>             <!-- Stepped chamber board inset -->
    <Thickness x:Key="MenuItemPadding">10,4</Thickness>             <!-- Compact 30px menu rows -->
    <Thickness x:Key="ComboBoxDropDownPadding">8,12,8,6</Thickness> <!-- Stepped ComboBox popup inset -->
    <Thickness x:Key="ComboBoxItemPadding">10,4</Thickness>         <!-- 30px ComboBox rows -->
    <Thickness x:Key="ListBoxItemPadding">10,5</Thickness>          <!-- ListBox rows -->
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>      <!-- Framed modular panel GroupBox inset -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>              <!-- Dark carbon tooltip inset -->

    <!-- Shared White-Mask FX ImageBrushes (recolored live by ThemeModifier via Fill/Background) -->
    <ImageBrush x:Key="LocalPanelGridMaskBrush" ImageSource="{ThemeFile 'Images/fx/panel-grid.png'}"
                TileMode="Tile" Viewport="0,0,56,56" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalAntlineDotsMaskBrush" ImageSource="{ThemeFile 'Images/fx/antline-dots.png'}"
                TileMode="Tile" Viewport="0,0,12,8" ViewportUnits="Absolute" Stretch="None" AlignmentY="Center" />
    <ImageBrush x:Key="LocalPortalSheenMaskBrush" ImageSource="{ThemeFile 'Images/fx/portal-sheen.png'}" Stretch="Fill" />

    <!-- 9-Slice ImageBrushes for portal-bloom.png (96x96 with 28px corner/edge borders) -->
    <ImageBrush x:Key="LocalBloomTL" ImageSource="{ThemeFile 'Images/fx/portal-bloom.png'}" Viewbox="0,0,28,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBloomTC" ImageSource="{ThemeFile 'Images/fx/portal-bloom.png'}" Viewbox="28,0,40,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBloomTR" ImageSource="{ThemeFile 'Images/fx/portal-bloom.png'}" Viewbox="68,0,28,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBloomML" ImageSource="{ThemeFile 'Images/fx/portal-bloom.png'}" Viewbox="0,28,28,40" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBloomMR" ImageSource="{ThemeFile 'Images/fx/portal-bloom.png'}" Viewbox="68,28,28,40" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBloomBL" ImageSource="{ThemeFile 'Images/fx/portal-bloom.png'}" Viewbox="0,68,28,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBloomBC" ImageSource="{ThemeFile 'Images/fx/portal-bloom.png'}" Viewbox="28,68,40,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBloomBR" ImageSource="{ThemeFile 'Images/fx/portal-bloom.png'}" Viewbox="68,68,28,28" ViewboxUnits="Absolute" Stretch="Fill" />

    <!-- 9-Slice ImageBrushes for inner-shadow.png (96x96 with 28px corner/edge inset shadow) -->
    <ImageBrush x:Key="LocalInsetTL" ImageSource="{ThemeFile 'Images/fx/inner-shadow.png'}" Viewbox="0,0,28,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalInsetTC" ImageSource="{ThemeFile 'Images/fx/inner-shadow.png'}" Viewbox="28,0,40,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalInsetTR" ImageSource="{ThemeFile 'Images/fx/inner-shadow.png'}" Viewbox="68,0,28,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalInsetML" ImageSource="{ThemeFile 'Images/fx/inner-shadow.png'}" Viewbox="0,28,28,40" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalInsetMR" ImageSource="{ThemeFile 'Images/fx/inner-shadow.png'}" Viewbox="68,28,28,40" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalInsetBL" ImageSource="{ThemeFile 'Images/fx/inner-shadow.png'}" Viewbox="0,68,28,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalInsetBC" ImageSource="{ThemeFile 'Images/fx/inner-shadow.png'}" Viewbox="28,68,40,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalInsetBR" ImageSource="{ThemeFile 'Images/fx/inner-shadow.png'}" Viewbox="68,68,28,28" ViewboxUnits="Absolute" Stretch="Fill" />

    <!-- Popup Border -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard Focus Visual (luminous Portal Cyan ring) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modular Chamber Wall Grid Overlay (recolored by Foreground) -->
    <ControlTemplate x:Key="LocalPanelGridTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalPanelGridMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Vector 4-Edge Compact Inset Inner Shadow (18px soft 5-stop curve; zero 9-slice DPI seams) -->
    <ControlTemplate x:Key="LocalButtonInnerShadowTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Rectangle Height="18" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D4000000" Offset="0" />
                        <GradientStop Color="#80000000" Offset="0.25" />
                        <GradientStop Color="#34000000" Offset="0.55" />
                        <GradientStop Color="#0E000000" Offset="0.80" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="18" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#DC000000" Offset="0" />
                        <GradientStop Color="#86000000" Offset="0.26" />
                        <GradientStop Color="#38000000" Offset="0.56" />
                        <GradientStop Color="#10000000" Offset="0.82" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="18" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#CC000000" Offset="0" />
                        <GradientStop Color="#76000000" Offset="0.25" />
                        <GradientStop Color="#2E000000" Offset="0.55" />
                        <GradientStop Color="#0C000000" Offset="0.80" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="18" HorizontalAlignment="Right" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                        <GradientStop Color="#CC000000" Offset="0" />
                        <GradientStop Color="#76000000" Offset="0.25" />
                        <GradientStop Color="#2E000000" Offset="0.55" />
                        <GradientStop Color="#0C000000" Offset="0.80" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Vector 4-Edge Wall/Panel Inset Inner Shadow (48-52px soft bright 5-stop spread matching Portal 2 backlit panels) -->
    <ControlTemplate x:Key="LocalPanelInnerShadowTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Rectangle Height="52" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC000000" Offset="0" />
                        <GradientStop Color="#7A000000" Offset="0.24" />
                        <GradientStop Color="#32000000" Offset="0.52" />
                        <GradientStop Color="#0E000000" Offset="0.78" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="52" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#D2000000" Offset="0" />
                        <GradientStop Color="#80000000" Offset="0.26" />
                        <GradientStop Color="#36000000" Offset="0.54" />
                        <GradientStop Color="#10000000" Offset="0.80" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="48" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#C4000000" Offset="0" />
                        <GradientStop Color="#72000000" Offset="0.24" />
                        <GradientStop Color="#2C000000" Offset="0.52" />
                        <GradientStop Color="#0C000000" Offset="0.78" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="48" HorizontalAlignment="Right" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                        <GradientStop Color="#C4000000" Offset="0" />
                        <GradientStop Color="#72000000" Offset="0.24" />
                        <GradientStop Color="#2C000000" Offset="0.52" />
                        <GradientStop Color="#0C000000" Offset="0.78" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Combined Wall Surface Overlay: 56x56 modular tile grid + soft 48-52px 4-edge inset inner shadow -->
    <ControlTemplate x:Key="LocalWallSurfaceTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{DynamicResource NormalBorderBrush}" Opacity="0.22"
                       OpacityMask="{DynamicResource LocalPanelGridMaskBrush}" />
            <Control Template="{DynamicResource LocalPanelInnerShadowTemplate}"
                     Foreground="{DynamicResource LocalCarbonEdgeBrush}" Opacity="0.20"
                     Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
        </Grid>
    </ControlTemplate>

    <!-- Shared Wall Grid + Inner Shadow Layer (Library, Explorer/Filter panels, StandardWindow dialogs; hidden on window art) -->
    <Style x:Key="LocalWallGridOverlay" TargetType="Control">
        <Setter Property="Template" Value="{DynamicResource LocalWallSurfaceTemplate}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Horizontal Circular Antline Dot Strip (recolored by Foreground) -->
    <ControlTemplate x:Key="LocalAntlineDotsTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalAntlineDotsMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- 9-Slice Outer Portal Rim Bloom (fixed 28px corner cells, zero desired size) -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomTL}" />
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomTC}" />
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomTR}" />
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomML}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomMR}" />
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomBL}" />
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomBC}" />
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomBR}" />
        </Grid>
    </ControlTemplate>

    <!-- Testbed Brand Mark: Dual-Arc Chamber Aperture Emblem -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="64" Height="64">
                <!-- Outer modular notched chamber brackets -->
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M5,5 H24.5 V11 H11 V24.5 H5 Z M39.5,5 H59 V24.5 H53 V11 H39.5 Z M5,39.5 H11 V53 H24.5 V59 H5 Z M53,39.5 H59 V59 H39.5 V53 H53 Z" />
                <!-- Central vertical split slit in Portal Cyan -->
                <Rectangle Canvas.Left="29.5" Canvas.Top="9.5" Width="5" Height="45" Fill="{DynamicResource LocalPortalCyanBrush}" />
                <!-- Left and right opposing elliptical portal arcs -->
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M25.5,15.5 A11.2,16.5 0 0,0 25.5,48.5 V42 A5.6,10 0 0,1 25.5,22 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M38.5,15.5 A11.2,16.5 0 0,1 38.5,48.5 V42 A5.6,10 0 0,0 38.5,22 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- 3-Dot Portal Blue Antline Divider + Zero-Width-Safe Grout Hairline (safe inside GroupBox/Statistics) -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="10" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                <Ellipse Width="4" Height="4" Fill="{TemplateBinding Foreground}" />
                <Ellipse Width="4" Height="4" Margin="3.5,0,0,0" Fill="{TemplateBinding Foreground}" />
                <Ellipse Width="4" Height="4" Margin="3.5,0,0,0" Fill="{TemplateBinding Foreground}" />
            </StackPanel>
            <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{TemplateBinding BorderBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Four L-Shaped Chamber Viewport Corner Brackets (zero desired size) -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Data="M0,10 L0,0 L10,0 L10,2 L2,2 L2,10 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L10,0 L10,10 L8,10 L8,2 L0,2 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L2,0 L2,8 L10,8 L10,10 L0,10 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M8,0 L10,0 L10,10 L0,10 L0,8 L8,8 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <!-- Empty Game Page: Stepped-Tab Modular Chamber Standby Card + Breathing Dual-Arc Mark -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid Background="Transparent" Margin="28" SnapsToDevicePixels="True">
            <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Protruding stepped top-left charcoal tab cap -->
                <Border Width="148" Height="10" HorizontalAlignment="Left" Background="{DynamicResource SelectedBrush}"
                        BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="0,2,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource LocalPortalCyanBrush}" />
                        <Ellipse Width="4" Height="4" Margin="5,0,0,0" Fill="{DynamicResource LocalPortalCyanBrush}" />
                        <Ellipse Width="4" Height="4" Margin="5,0,0,0" Fill="{DynamicResource LocalPortalCyanBrush}" />
                    </StackPanel>
                </Border>
                <!-- Modular cleanroom tile card -->
                <Border Background="{DynamicResource PopupBackgroundBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5">
                    <Grid>
                        <Control Template="{DynamicResource LocalPanelGridTemplate}"
                                 Foreground="{DynamicResource NormalBorderBrush}" Opacity="0.22"
                                 Focusable="False" IsHitTestVisible="False" />
                        <Control Template="{DynamicResource LocalPanelInnerShadowTemplate}"
                                 Foreground="{DynamicResource LocalCarbonEdgeBrush}" Opacity="0.20"
                                 Focusable="False" IsHitTestVisible="False" />
                        <Control x:Name="EmptyBrackets" Margin="8" Template="{DynamicResource CornerMarksTemplate}"
                                 Foreground="{DynamicResource LocalPortalCyanBrush}" IsHitTestVisible="False" />

                        <StackPanel Margin="36,28" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Border Background="{DynamicResource ShellBackgroundBrush}"
                                        BorderBrush="{DynamicResource SelectedBrush}" BorderThickness="1.5" />
                                <Border x:Name="EmptyPulseRing" Margin="-4"
                                        BorderBrush="{DynamicResource LocalPortalCyanBrush}" BorderThickness="1.5"
                                        Opacity="0.6" IsHitTestVisible="False" />
                                <Control Width="34" Height="34"
                                         Template="{DynamicResource BrandMarkTemplate}"
                                         Foreground="{DynamicResource PrimaryButtonForegroundBrush}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource GlyphBrush}" />
                                <Ellipse Width="5" Height="5" Margin="5,0,0,0" Fill="{DynamicResource LocalPortalCyanBrush}" />
                                <Ellipse Width="5" Height="5" Margin="5,0,0,0" Fill="{DynamicResource GlyphBrush}" />
                            </StackPanel>

                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       FontSize="{DynamicResource FontSizeLarger}"
                                       Foreground="{DynamicResource HeadingForegroundBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="EmptyBoardIdle">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyPulseRing" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.48" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:4.4" Value="0.48" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyBrackets" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.62" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:4.4" Value="0.62" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyBoardIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SteamScreenshots Plugin Loading Skeleton (stepped modular test-capture frames) -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Height="200" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                    Margin="0,0,0,8">
                <Grid>
                    <Rectangle Width="42" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Fill="{DynamicResource GlyphBrush}" />
                    <Control Margin="10" Template="{DynamicResource CornerMarksTemplate}"
                             Foreground="{DynamicResource NormalBorderBrush}" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource GlyphBrush}" />
                        <Ellipse Width="6" Height="6" Margin="6,0,0,0" Fill="{DynamicResource LocalPortalCyanBrush}" />
                        <Ellipse Width="6" Height="6" Margin="6,0,0,0" Fill="{DynamicResource GlyphBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <UniformGrid Columns="4">
                <Border Height="48" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.85" />
                <Border Height="48" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.75" />
                <Border Height="48" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.85" />
                <Border Height="48" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.75" />
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- Game Page Section Heading (Barlow Condensed Bold, flips to WindowArtForegroundBrush over window art) -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Game Page Secondary Action Button (40x40 cleanroom off-white modular plate with grid seams + 4-edge inset inner shadow) -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid ClipToBounds="True">
                                <Border x:Name="HoverFill" Background="{DynamicResource SecondaryButtonHoverBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="PressFill" Background="{DynamicResource SecondaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Control Template="{DynamicResource LocalPanelGridTemplate}"
                                         Foreground="{DynamicResource NormalBorderBrush}" Opacity="0.16"
                                         Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                <Control x:Name="InsetShadow" Template="{DynamicResource LocalButtonInnerShadowTemplate}"
                                         Foreground="{DynamicResource LocalCarbonEdgeBrush}" Opacity="0.24"
                                         Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="InsetShadow" Property="Opacity" Value="0.16" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecBtnHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecBtnHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="InsetShadow" Property="Opacity" Value="0.38" />
                            <Setter TargetName="PressFill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressFill" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a Portal-style pair, a blue and an orange portal oval joined by three dashed antline rows. Hover: a test cube slips out of the blue portal, crosses the antlines and drops into the orange one (one pass, eased). Open (ContextMenu.IsOpen of the nearest Border): both portal rims light and breathe out of step while a cube keeps shuttling through the pair until the menu closes. -->
    <ControlTemplate x:Key="LocalTestbedMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="26" Height="26">
                    <Ellipse x:Name="RimBlue" Canvas.Left="0.6" Canvas.Top="1.6" Width="9.6" Height="22.8" Stroke="{DynamicResource LocalPortalCyanBrush}" StrokeThickness="1" Opacity="0" />
                    <Ellipse x:Name="RimOrange" Canvas.Left="15.8" Canvas.Top="1.6" Width="9.6" Height="22.8" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="1" Opacity="0" />
                    <Ellipse Canvas.Left="2" Canvas.Top="3" Width="6.8" Height="20" Stroke="{DynamicResource PrimaryButtonBackgroundBrush}" StrokeThickness="2.2" />
                    <Ellipse Canvas.Left="17.2" Canvas.Top="3" Width="6.8" Height="20" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2.2" />
                    <Line X1="10.6" X2="15.4" Y1="9.6" Y2="9.6" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeDashArray="1.6 1.2" /><Line X1="10.6" X2="15.4" Y1="13" Y2="13" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeDashArray="1.6 1.2" /><Line X1="10.6" X2="15.4" Y1="16.4" Y2="16.4" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeDashArray="1.6 1.2" />
                    <Rectangle x:Name="CubeHover" Canvas.Left="6" Canvas.Top="11.5" Width="3" Height="3" Fill="{DynamicResource LocalPortalCyanBrush}" Opacity="0">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="CubeHoverMove" X="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="CubeOpen" Canvas.Left="6" Canvas.Top="11.5" Width="3" Height="3" Fill="{DynamicResource LocalPortalCyanBrush}" Opacity="0">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="CubeOpenMove" X="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CubeHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CubeHoverMove" Storyboard.TargetProperty="X" To="11" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CubeHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CubeHoverMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RimBlue" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RimBlue" Storyboard.TargetProperty="Opacity" From="1" To="0.5" BeginTime="0:0:0.4" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RimOrange" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RimOrange" Storyboard.TargetProperty="Opacity" From="1" To="0.5" BeginTime="0:0:0.5" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CubeOpen" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.2" Duration="0:0:0.1"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CubeOpenMove" Storyboard.TargetProperty="X" To="0" BeginTime="0:0:0.2" Duration="0:0:0.01"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CubeOpenMove" Storyboard.TargetProperty="X" From="0" To="11" BeginTime="0:0:0.2" Duration="0:0:0.9" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RimBlue" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RimOrange" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CubeOpen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CubeOpenMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
