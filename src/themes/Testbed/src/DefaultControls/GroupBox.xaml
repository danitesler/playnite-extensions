<!--
    Testbed: DefaultControls/GroupBox.xaml.
    Content-sized cleanroom modular panel card (zero fixed widths >= 200 so Playnite's Statistics sections wrap cleanly).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Control Template="{DynamicResource LocalPanelGridTemplate}"
                                     Foreground="{DynamicResource NormalBorderBrush}" Opacity="0.20"
                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                            <Control Template="{DynamicResource LocalPanelInnerShadowTemplate}"
                                     Foreground="{DynamicResource LocalCarbonEdgeBrush}" Opacity="0.20"
                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource SelectedBrush}"
                                        BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="0,2,0,0"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Margin="0,0,7,0" VerticalAlignment="Center"
                                                 Fill="{DynamicResource LocalPortalCyanBrush}" />
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                          TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                          TextElement.FontSize="{DynamicResource FontSizeLarge}"
                                                          TextElement.FontWeight="Bold"
                                                          TextElement.Foreground="{DynamicResource SelectedForegroundBrush}" />
                                    </StackPanel>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
