<!--
    Testbed: DefaultControls/ProgressBar.xaml.
    Modeled on Portal 2 Loading Screen circular indicator antlines (antline-dots.png):
    takes Height from TemplateBinding Height (MinHeight=8) so TopPanel PART_ProgressGlobal (Height=12) breathes cleanly.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid Height="{TemplateBinding Height}" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <!-- Unlit dot sockets across track -->
                        <Rectangle Margin="4,1" Fill="{DynamicResource NormalBorderBrush}" Opacity="0.35"
                                   OpacityMask="{DynamicResource LocalAntlineDotsMaskBrush}" IsHitTestVisible="False" />
                        <!-- Lit antline dots inside PART_Indicator -->
                        <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True" Margin="4,1">
                            <Rectangle Fill="{TemplateBinding Foreground}"
                                       OpacityMask="{DynamicResource LocalAntlineDotsMaskBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
