<!--
    Testbed: DefaultControls/ContextMenu.xaml.
    Signature menu panel (LocalMenuBoardTemplate) shared by ContextMenu, TopPanelMenu, submenus, and ComboBox lists:
    Cleanroom white modular aluminum panel (#F2F4F6) with 4.5% wall grid seams (panel-grid.png), 1.5px Aperture
    Charcoal border, 2px bottom shadow lip, and protruding top-left charcoal stepped tab cap crowned by a 2px
    Portal Cyan line and 3 cyan indicator dots (echoing Portal 2 Options / Save Game stepped panels).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Stepped Test-Chamber Board Panel Template (zero DropShadowEffect) -->
    <ControlTemplate x:Key="LocalMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Protruding top-left charcoal stepped chamber tab cap (6px tall) -->
            <Border Width="96" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{DynamicResource PopupBorderBrush}"
                    BorderBrush="{DynamicResource LocalPortalCyanBrush}" BorderThickness="0,2,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource LocalPortalCyanBrush}" />
                    <Ellipse Width="2.5" Height="2.5" Margin="4,0,0,0" Fill="{DynamicResource LocalPortalCyanBrush}" />
                    <Ellipse Width="2.5" Height="2.5" Margin="4,0,0,0" Fill="{DynamicResource LocalPortalCyanBrush}" />
                </StackPanel>
            </Border>
            <!-- Cleanroom modular panel body -->
            <Border Margin="0,6,0,0" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="{DynamicResource PopupBorderThickness}">
                <Grid ClipToBounds="True">
                    <Control Template="{DynamicResource LocalPanelGridTemplate}"
                             Foreground="{DynamicResource NormalBorderBrush}" Opacity="0.20" />
                    <Control Template="{DynamicResource LocalPanelInnerShadowTemplate}"
                             Foreground="{DynamicResource LocalCarbonEdgeBrush}" Opacity="0.20" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="MinWidth" Value="216" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalMenuBoardTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ScrollViewer Margin="6,10,6,6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle"
                                            Grid.IsSharedSizeScope="True" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
