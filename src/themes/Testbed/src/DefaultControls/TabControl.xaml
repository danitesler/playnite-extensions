<!--
    Testbed: DefaultControls/TabControl.xaml.
    Modeled on Portal 2 Store/Customization header tabs (portal-2-skins.jpg): dark carbon tiles at rest; active tab
    rises cleanly into Portal Blue (#0D77A3) with 3px Portal Cyan cap bar and pure white lettering.
    TabItemColors rule: TabItem keeps Foreground=TextBrush so child edit-dialog labels stay readable; idle/hover/selected
    text colors are set strictly on HeaderText (TextBlock wrapping ContentPresenter ContentSource="Header").
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="TabPlate" Background="{DynamicResource TabControlHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource LocalCarbonEdgeBrush}" BorderThickness="0,0,1,0" />
                        <Border x:Name="HoverPlate" Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Grid x:Name="SelectedPlate" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border Background="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                            <Rectangle Height="3" VerticalAlignment="Top" Fill="{DynamicResource TabItemIndicatorBrush}" />
                        </Grid>
                        <TextBlock x:Name="HeaderText" Margin="{TemplateBinding Padding}"
                                   FontFamily="{DynamicResource HeadingFontFamily}"
                                   FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource TabItemForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TabHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TabHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource ShellBackgroundBrush}"
                                BorderBrush="{DynamicResource LocalCarbonEdgeBrush}" BorderThickness="1"
                                Margin="0,0,0,10">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Panel.ZIndex="1" />
                        </Border>
                        <Border x:Name="ContentPanel" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
