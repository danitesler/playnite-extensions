<!--
    Testbed: DefaultControls/Button.xaml.
    32px (ControlHeight) sharp modular aluminum buttons with 2px bottom shadow lip (portal-2-options.jpg Back button).
    Default/Primary buttons (IsDefault=True) switch to Portal Blue (#0D77A3) with 3px Portal Cyan left slit.
    Includes mandatory ThemeModifier Width==41 square proportional scale trigger (32/41 = 0.7804878048780488).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Testbed: DefaultControls/Button.xaml.
         Cleanroom backlit off-white modular buttons (grid seams + 4-edge inset inner shadow matching Portal 2 Extras
         Play/Back buttons). Default/Primary buttons (IsDefault=True) switch to Aperture Steel-Cerulean backlit plates
         with deep teal-navy 4-edge inset inner shadow (matching Portal 2 Store Add to Cart / Checkout buttons).
         Includes mandatory ThemeModifier Width==41 square proportional scale trigger (32/41 = 0.7804878048780488). -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid ClipToBounds="True">
                            <!-- Backlit center glow for Primary/IsDefault blue buttons -->
                            <Rectangle x:Name="PrimaryCenterGlow" Visibility="Collapsed" Opacity="0.16" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="0.5,0.48" GradientOrigin="0.5,0.48" RadiusX="0.65" RadiusY="0.72">
                                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Border x:Name="HoverOverlay" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressOverlay" Background="{DynamicResource ButtonPressedBackgroundBrush}"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            <!-- Cleanroom modular tile seams -->
                            <Control x:Name="TileGrid" Template="{DynamicResource LocalPanelGridTemplate}"
                                     Foreground="{DynamicResource NormalBorderBrush}" Opacity="0.16"
                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                            <!-- 4-edge inset inner shadow -->
                            <Control x:Name="InsetShadow" Template="{DynamicResource LocalButtonInnerShadowTemplate}"
                                     Foreground="{DynamicResource LocalCarbonEdgeBrush}" Opacity="0.24"
                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="ContentHost" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                            <Setter TargetName="PrimaryCenterGlow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TileGrid" Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                            <Setter TargetName="TileGrid" Property="Opacity" Value="0.07" />
                            <Setter TargetName="InsetShadow" Property="Foreground" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                            <Setter TargetName="InsetShadow" Property="Opacity" Value="0.62" />
                            <Setter TargetName="HoverOverlay" Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="PressOverlay" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="InsetShadow" Property="Opacity" Value="0.16" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BtnHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="BtnHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource LocalPortalCyanBrush}" />
                            <Setter TargetName="InsetShadow" Property="Opacity" Value="0.48" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressOverlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressOverlay" Property="Opacity" Value="1" />
                            <Setter TargetName="InsetShadow" Property="Opacity" Value="0.38" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="InsetShadow" Property="Opacity" Value="0.76" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="{x:Static sys:Double.NaN}">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <!-- ThemeModifier icon-button 41px -> 32x32 uniform proportional scale trigger -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SimpleButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Border x:Name="HoverPlate" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource LocalPortalCyanBrush}" BorderThickness="1"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SimpleHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SimpleHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
