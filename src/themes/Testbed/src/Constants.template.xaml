<!--
    Testbed: Constants.xaml template (Clinical Modular Test-Chamber theme inspired by Portal 2).
    scripts/build-theme.ps1 renders tokens.css placeholders into Constants.xaml.
    Light cleanroom aluminum wall panels paired with dark carbon chrome, Aperture Charcoal inversion bars,
    Portal Blue primary polarity, Propulsion Orange running indicator, Caution Yellow filter pip, and Crimson danger.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Barlow Semi Condensed & Barlow Condensed bundled as static OFL TTFs in Typography/) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">21</sys:Double>
    <sys:Double x:Key="FontSizeLargest">38</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow Semi Condensed, Barlow Semi Condensed, Bahnschrift SemiCondensed, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Barlow Condensed, Barlow Condensed, Bahnschrift SemiCondensed, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Game page metadata pane defaults (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape & radii: 0px architectural modular panels; 9999 strictly for 1:1 circular dots/radios -->
    <Thickness x:Key="PopupBorderThickness">1.5</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:tb-radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:tb-radius-sm|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:tb-radius-lg|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{tb-ink}}</Color>
    <Color x:Key="TextColorDarker">{{tb-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{tb-pure-white}}</Color>
    <Color x:Key="MainColor">{{tb-wall-tile}}</Color>
    <Color x:Key="MainColorDark">{{tb-wall-well}}</Color>
    <Color x:Key="HoverColor">{{tb-wall-hover}}</Color>
    <Color x:Key="GlyphColor">{{tb-portal-blue}}</Color>
    <Color x:Key="HighlightGlyphColor">{{tb-portal-cyan-soft}}</Color>
    <Color x:Key="PopupBackgroundColor">{{tb-wall-tile}}</Color>
    <Color x:Key="PopupBorderColor">{{tb-charcoal}}</Color>
    <Color x:Key="BackgroundToneColor">{{tb-wall-well}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{tb-grout}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{tb-grout-soft}}</Color>
    <Color x:Key="DataChangeNotifColor">{{tb-yellow}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{tb-grout}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{tb-carbon}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{tb-white}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{tb-portal-cyan}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{tb-wall-tile}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{tb-pure-white}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{tb-teal-pos}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{tb-crimson}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{tb-amber-mix}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{tb-amber-mix}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{tb-wall-well}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{tb-wall-base}}" />

    <!-- Shell, Chrome & Game Page Brushes -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{tb-carbon}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{tb-carbon-top}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{tb-wall-base}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{tb-wall-base}}" />
    <!-- Banner darkening color: light aluminum chamber wall so darkened art washes smoothly into cleanroom panel -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{tb-wall-base}}" />
    <!-- ScrimBrush: deep charcoal scrim darkening RunningIndicatorBrush orange plate so white text stays >= 6.3:1 -->
    <SolidColorBrush x:Key="ScrimBrush" Color="{{tb-scrim}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{tb-carbon-tile}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{tb-white}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{tb-wall-tile}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{tb-pure-white}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{tb-carbon-hover}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{tb-carbon-top}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{tb-white}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{tb-ink}}" />

    <!-- Light-Theme Window Background Art Flip (crisp white ink directly over dark/rich game art) -->
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{tb-white}}" />

    <!-- Theme-local structural roles (prefixed with Local) -->
    <SolidColorBrush x:Key="LocalCarbonEdgeBrush" Color="{{tb-carbon-edge}}" />
    <SolidColorBrush x:Key="LocalCarbonTileBrush" Color="{{tb-carbon-tile}}" />
    <SolidColorBrush x:Key="LocalShadowLipBrush" Color="{{tb-grout-deep}}" />
    <SolidColorBrush x:Key="LocalPortalCyanBrush" Color="{{tb-portal-cyan}}" />
    <SolidColorBrush x:Key="LocalWallChipBrush" Color="{{tb-wall-chip}}" />
    <SolidColorBrush x:Key="LocalRunningHighlightBrush" Color="{{tb-orange-hi}}" />
    <SolidColorBrush x:Key="LocalTagOrangeBrush" Color="{{tb-tag-orange}}" />

    <!-- State Brushes: Aperture Charcoal inversion bar + Portal Cyan slit; Propulsion Orange running state -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{tb-charcoal}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{tb-charcoal-hi}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{tb-portal-cyan}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{tb-white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{tb-wall-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{tb-charcoal}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{tb-charcoal}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{tb-grout-soft}}" />
    <!-- Dedicated Propulsion Orange running indicator (opposite hue from Blue Play, Charcoal selection, Yellow pip, Crimson danger) -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{tb-orange}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{tb-portal-cyan}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{tb-portal-cyan-halo}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{tb-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{tb-pure-white}}" />

    <!-- Button Brushes: Portal Blue Play CTA with crisp white label -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{tb-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{tb-wall-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{tb-wall-press}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{tb-grout}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{tb-portal-blue}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{tb-portal-blue-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{tb-portal-blue-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{tb-portal-blue-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{tb-pure-white}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{tb-portal-cyan}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{tb-wall-tile}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{tb-grout}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{tb-wall-hover}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{tb-wall-press}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{tb-portal-blue}}" />

    <!-- Input & Control Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{tb-wall-tile}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{tb-pure-white}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{tb-grout}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{tb-portal-cyan}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{tb-grout-deep}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{tb-portal-blue}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{tb-portal-blue-hover}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{tb-grout-soft}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{tb-charcoal}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{tb-portal-cyan}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{tb-portal-blue-hover}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{tb-portal-blue}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{tb-wall-well}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{tb-charcoal}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{tb-portal-blue}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{tb-wall-well}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{tb-charcoal}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{tb-portal-blue}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{tb-rail-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{tb-white}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{tb-portal-cyan}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{tb-portal-blue}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{tb-carbon-tile}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{tb-portal-cyan}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{tb-charcoal}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{tb-carbon-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{tb-portal-blue}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{tb-rail-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{tb-pure-white}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{tb-wall-chip}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{tb-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{tb-charcoal}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{tb-portal-link}}" />
</ResourceDictionary>
