<!--
    Testbed: DerivedStyles/StandardWindowStyle.xaml (Settings, Add-ons, Game Editor, every Playnite dialog).
    44px dark carbon modular title band (CaptionHeight=44, ContentPresenter Margin="0,44,0,0") with 2px Portal Cyan
    lead bar, Testbed Dual-Arc brand badge, Barlow Condensed uppercase title, 3-dot cyan antline indicator,
    subtle ghosted Dual-Arc watermark in zero-desired-size Canvas, 46x44 WindowBarButton captions, and closing 2px rule.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource LocalCarbonEdgeBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Control Style="{DynamicResource LocalWallGridOverlay}" Margin="0,44,0,0" />
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px Dark Carbon Title Band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}"
                                      ClipToBounds="True" SnapsToDevicePixels="True">
                                    <!-- Subtle modular tile grid on band -->
                                    <Control Template="{DynamicResource LocalPanelGridTemplate}"
                                             Foreground="{DynamicResource WindowTitleForegroundBrush}" Opacity="0.06"
                                             Focusable="False" IsHitTestVisible="False" />

                                    <!-- Stepped Portal Cyan top lead cap -->
                                    <Rectangle Width="248" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Fill="{DynamicResource LocalPortalCyanBrush}" IsHitTestVisible="False" />

                                    <!-- Ghosted Dual-Arc watermark in zero-desired-size Canvas (clear of caption buttons) -->
                                    <Canvas IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0">
                                        <Control Canvas.Left="-194" Canvas.Top="4" Width="36" Height="36"
                                                 Template="{DynamicResource BrandMarkTemplate}"
                                                 Foreground="{DynamicResource WindowTitleForegroundBrush}" Opacity="0.08" />
                                    </Canvas>

                                    <!-- Closing 2px carbon edge rule -->
                                    <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource LocalCarbonEdgeBrush}" IsHitTestVisible="False" />

                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
                                            <!-- Testbed Dual-Arc Brand Mark badge -->
                                            <Border Width="24" Height="24" Margin="0,0,10,0"
                                                    Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                                                    BorderBrush="{DynamicResource LocalPortalCyanBrush}" BorderThickness="1"
                                                    IsHitTestVisible="False">
                                                <Control Width="16" Height="16" Template="{DynamicResource BrandMarkTemplate}"
                                                         Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- 3-dot cyan chamber antline accents -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource LocalPortalCyanBrush}" />
                                                <Ellipse Width="5" Height="5" Margin="5,0,0,0" Fill="{DynamicResource LocalPortalCyanBrush}" />
                                                <Ellipse Width="5" Height="5" Margin="5,0,0,0" Fill="{DynamicResource GlyphBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter Property="Text" Value="{DynamicResource LOCSettingsLabel}" TargetName="PART_TextTitle" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
