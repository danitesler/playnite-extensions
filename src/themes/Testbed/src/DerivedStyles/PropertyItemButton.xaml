<!--
    Testbed: DerivedStyles/PropertyItemButton.xaml.
    Default: Portal Link blue (#0A6A94) underlining on hover.
    Tag="Chip" (ItemsControl ancestor): sharp 0px modular aluminum tiles (#E4E8EC) with 1px grout border,
    2px lower bevel lip, and 3x3 top-left Portal Blue corner pip (inverting cleanly to Aperture Charcoal #343639
    with crisp white text and Portal Cyan pip on hover). Uses ControlCornerRadius (never CornerRadiusFull).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="ChipPlate" Visibility="Collapsed"
                                Background="{DynamicResource PropertyItemBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Rectangle x:Name="ChipLip" Height="2" VerticalAlignment="Bottom"
                                           Fill="{DynamicResource WindowPanelSeparatorBrush}" IsHitTestVisible="False" />
                                <Rectangle x:Name="ChipPip" Width="3" Height="3" Margin="2,2,0,0"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="Label" Margin="{TemplateBinding Padding}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                            <Setter TargetName="ChipPlate" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                            <Setter Property="Padding" Value="9,2,8,3" />
                            <Setter Property="Margin" Value="0,0,5,5" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Label" Property="TextDecorations" Value="{x:Null}" />
                            <Setter TargetName="ChipPlate" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                            <Setter TargetName="ChipPlate" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            <Setter TargetName="ChipLip" Property="Fill" Value="{DynamicResource LocalPortalCyanBrush}" />
                            <Setter TargetName="ChipPip" Property="Fill" Value="{DynamicResource LocalPortalCyanBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
