<!--
    Testbed: DerivedStyles/PlayButton.xaml (+ RunningActionIndicator).
    Hero Moment (PlayButton): Portal Blue architectural slab (#0D77A3, MinWidth="156") with 1.5px deep portal border
    and 3px luminous Portal Cyan (#1CA8E3) left slit.
    - Hover (gated off during IsLaunching/IsRunning): outer 9-slice GlowFrameTemplate (portal-bloom.png) illuminates,
      diagonal LocalPortalSheenMaskBrush sweeps across the slab (220ms), and 4 internal CornerMarksTemplate viewport
      brackets snap cleanly inward (150ms CubicEase).
    - Press: separate sunken PressedLayer (#085170).
    - Launching / Running: plate fills solid RunningIndicatorBrush (Propulsion Orange #C64E08), darkened by ScrimBrush
      RunningBreath (0.50 launching -> 9.43:1 white contrast; 0.22..0.42 running -> 6.36..8.46:1), swept by angled
      RunningScan (#F47A1F 1.6s loop), and framed by RunningActionIndicator with antline-dotted foot bar and 3
      staggered circular orange beacon dots inside 36px right PlayRoom strip.
    - Cancel on hover: single MultiDataTrigger on IsRunning + RelativeSource Self IsMouseOver (never TemplatedParent).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinWidth" Value="156" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="18,0,18,0" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Backlit Aperture Steel-Cerulean Recessed Panel (Portal 2 Add to Cart / Checkout design; zero outer halo) -->
                        <Border x:Name="PlayFill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid ClipToBounds="True">
                                <!-- Backlit radial center luminosity (swells cleanly outward on hover) -->
                                <Rectangle x:Name="BacklitCenter" Opacity="0.16" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="BacklitScale" ScaleX="0.92" ScaleY="0.92" />
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Fill>
                                        <RadialGradientBrush Center="0.5,0.48" GradientOrigin="0.5,0.48" RadiusX="0.68" RadiusY="0.78">
                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Subtle modular grid seams inside blue button -->
                                <Control x:Name="PlayGrid" Template="{DynamicResource LocalPanelGridTemplate}"
                                         Foreground="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.08"
                                         Focusable="False" IsTabStop="False" IsHitTestVisible="False" />

                                <!-- Hover layer: brighter backlit cerulean + subtle internal diagonal pass -->
                                <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Border Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                                    <Rectangle x:Name="HoverSheen" Width="110" HorizontalAlignment="Left"
                                               Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.18"
                                               OpacityMask="{DynamicResource LocalPortalSheenMaskBrush}">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="SheenSlideX" X="-110" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>

                                <!-- Pressed layer (Collapsed at rest) -->
                                <Border x:Name="PressedLayer" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Running / Launching plate scrim (keeps pure white label >= 5.25:1 across all frames) -->
                                <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}"
                                        Visibility="Collapsed" Opacity="0.32" IsHitTestVisible="False" />

                                <!-- Launching horizontal Propulsion Orange scan sweep (below label, inside plate shape) -->
                                <Border x:Name="RunningScan" Background="{DynamicResource LocalRunningHighlightBrush}"
                                        Visibility="Collapsed" Opacity="0.45" IsHitTestVisible="False">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>

                                <!-- Running hover darken scrim under Cancel label -->
                                <Border x:Name="RunningHoverDim" Background="{DynamicResource ScrimBrush}"
                                        Opacity="0" IsHitTestVisible="False" />

                                <!-- Internal backlit cyan edge bevel glow (illuminates inside recess on hover, zero external halo) -->
                                <Control x:Name="InnerRimGlow" Template="{DynamicResource LocalButtonInnerShadowTemplate}"
                                         Foreground="{DynamicResource LocalPortalCyanBrush}"
                                         Visibility="Collapsed" Opacity="0"
                                         Focusable="False" IsTabStop="False" IsHitTestVisible="False" />

                                <!-- Rich 4-edge inset inner shadow (contracts outward as backlit panel lifts on hover; deepens inward on press) -->
                                <Control x:Name="PlayInsetShadow" Template="{DynamicResource LocalButtonInnerShadowTemplate}"
                                         Foreground="{DynamicResource PrimaryButtonBorderBrush}" Opacity="0.64"
                                         RenderTransformOrigin="0.5,0.5"
                                         Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                    <Control.RenderTransform>
                                        <ScaleTransform x:Name="InsetShadowScale" ScaleX="1" ScaleY="1" />
                                    </Control.RenderTransform>
                                </Control>

                                <!-- Label host (PlayRoom reserves 36px right strip while Launching/Running) -->
                                <!-- RunningMarkRoom left="0" right="36" -->
                                <Border x:Name="PlayRoom" Margin="0">
                                    <StackPanel x:Name="PlayContent" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}">
                                        <ContentControl x:Name="PlayGlyph" Width="13" Height="13" Margin="0,0,8,0"
                                                        Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource PrimaryButtonForegroundBrush}" VerticalAlignment="Center"
                                                        IsHitTestVisible="False">
                                            <ContentControl.RenderTransform>
                                                <TranslateTransform x:Name="PlayGlyphShift" X="0" />
                                            </ContentControl.RenderTransform>
                                        </ContentControl>
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                    </StackPanel>
                                </Border>

                                <!-- Cancel hover label (shown ONLY while IsRunning AND button itself IsMouseOver; crisp white immediately) -->
                                <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                           Visibility="Collapsed" Opacity="1" Margin="0,0,36,0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                           FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Idle Hover (Portal 2 inner-shadow lift + internal cyan bevel illumination; zero external halo) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource LocalPortalCyanBrush}" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Visible" />
                            <Setter TargetName="InnerRimGlow" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <!-- Inner shadow lifts toward the rim as backlit panel brightens -->
                                        <DoubleAnimation Storyboard.TargetName="PlayInsetShadow" Storyboard.TargetProperty="Opacity" To="0.40" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="InsetShadowScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="InsetShadowScale" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <!-- Internal cyan bevel light + backlit center swell -->
                                        <DoubleAnimation Storyboard.TargetName="InnerRimGlow" Storyboard.TargetProperty="Opacity" To="0.48" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BacklitCenter" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BacklitScale" Storyboard.TargetProperty="ScaleX" To="1.14" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BacklitScale" Storyboard.TargetProperty="ScaleY" To="1.20" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SheenSlideX" Storyboard.TargetProperty="X" From="-110" To="240" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlayGlyphShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="PlayInsetShadow" Storyboard.TargetProperty="Opacity" To="0.64" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="InsetShadowScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="InsetShadowScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="InnerRimGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="BacklitCenter" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="BacklitScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="BacklitScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="PlayGlyphShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <!-- Pressed: panel presses physically deeper into its inner-shadow housing -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedLayer" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressedLayer" Property="Opacity" Value="0.85" />
                            <Setter TargetName="InnerRimGlow" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayPressIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PlayInsetShadow" Storyboard.TargetProperty="Opacity" To="0.80" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="InsetShadowScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="InsetShadowScale" Storyboard.TargetProperty="ScaleY" To="0.86" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PlayInsetShadow" Storyboard.TargetProperty="Opacity" To="0.40" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="InsetShadowScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="InsetShadowScale" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- LAUNCHING: Propulsion Orange plate + ScrimBreath 0.50 + horizontal RunningScan sweep -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PlayFill" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="BacklitCenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InnerRimGlow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayInsetShadow" Property="Foreground" Value="{DynamicResource LocalCarbonEdgeBrush}" />
                            <Setter TargetName="PlayInsetShadow" Property="Opacity" Value="0.45" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayRoom" Property="Margin" Value="0" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,36,0" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity"
                                                         From="0.34" To="0.50" Duration="0:0:0.22" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.4" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.402" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING: Propulsion Orange plate + slow 3.0s idle ScrimBreath -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PlayFill" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="BacklitCenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InnerRimGlow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayInsetShadow" Property="Foreground" Value="{DynamicResource LocalCarbonEdgeBrush}" />
                            <Setter TargetName="PlayInsetShadow" Property="Opacity" Value="0.45" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayRoom" Property="Margin" Value="0" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,36,0" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.22" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.22" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING + HOVER (RelativeSource Self, NEVER TemplatedParent): Cancel label + dim scrim -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.28" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="RunningCancelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RunningActionIndicator: Overlay over Play/ContextAction cell in DetailsViewGameOverview & GridViewGameOverview -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.94" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2">
                            <Border BorderBrush="{DynamicResource LocalRunningHighlightBrush}" BorderThickness="1" Opacity="0.7" />
                        </Border>

                        <!-- Antline-dotted foot progress bar (4px above bottom) -->
                        <Grid Height="4" Margin="6,0,6,3" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource LocalRunningHighlightBrush}" Opacity="0.28"
                                       OpacityMask="{DynamicResource LocalAntlineDotsMaskBrush}" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource PrimaryButtonForegroundBrush}"
                                       OpacityMask="{DynamicResource LocalAntlineDotsMaskBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <!-- 3 Circular Staggered Chamber Beacon Dots on right edge (clear of 36px PlayRoom) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,1">
                            <Ellipse x:Name="ActDot1" Width="5.5" Height="5.5" Margin="0,0,3.5,0"
                                     Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.55" />
                            <Ellipse x:Name="ActDot2" Width="5.5" Height="5.5" Margin="0,0,3.5,0"
                                     Fill="{DynamicResource LocalRunningHighlightBrush}" Opacity="0.75" />
                            <Ellipse x:Name="ActDot3" Width="5.5" Height="5.5"
                                     Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.55" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDot1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDot2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActDot3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
