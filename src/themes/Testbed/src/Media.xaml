<!--
    Testbed: Media.xaml — Bespoke cleanroom modular signage Icon* vector geometries matched to Portal 2
    facility pictograms and UI buttons. IconMainMenu carries Testbed's Dual-Arc Chamber Aperture mark.
    Playnite's 22 icofont menu icons omit local Foreground so they inherit TextElement.Foreground and invert
    cleanly on Aperture Charcoal and Thermal Crimson highlights.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Icon DataTemplates (uniformly scaled Viewbox fitting smallest hosts) -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox MaxWidth="{DynamicResource IconSize}" MaxHeight="{DynamicResource IconSize}" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox MaxWidth="12" MaxHeight="12" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileSolidTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <!-- Brand Mark: Dual-Arc Chamber Aperture Emblem -->
    <Geometry x:Key="IconMainMenu">F0 M2,2 H9.2 V4.2 H4.2 V9.2 H2 Z M14.8,2 H22 V9.2 H19.8 V4.2 H14.8 Z M2,14.8 H4.2 V19.8 H9.2 V22 H2 Z M19.8,14.8 H22 V22 H14.8 V19.8 H19.8 Z M11.1,3.6 H12.9 V20.4 H11.1 Z M9.6,5.8 A4.2,6.2 0 0,0 9.6,18.2 V15.8 A2.1,3.8 0 0,1 9.6,8.2 Z M14.4,5.8 A4.2,6.2 0 0,1 14.4,18.2 V15.8 A2.1,3.8 0 0,0 14.4,8.2 Z</Geometry>

