<!--
    Ironward: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared vocabulary (scripts/data/theme-keys.json); each placeholder names the iw token that plays
    the key's role. Theme XAML reads brushes only, never Color keys.
    Unofficial theme inspired by DOOM: The Dark Ages UI: abyssal verdigris-iron surfaces, spearhead silver-teal rules,
    engraved Cinzel headings, molten forge-ember selection/CTA plates, sea-steel hovers, and armor-jade running marks.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: classical engraved serif headings (Cinzel, bundled), crisp humanist UI body (Segoe UI, ships with Windows). -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:iw-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Cinzel, {{text:iw-font-display|Cinzel}}, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:iw-font-mono|Consolas}}</FontFamily>

    <!-- Usable metadata content width; applied inside the pane's horizontal padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: razor-sharp architectural corners paired with 45-deg chamfers and spearhead finials. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:iw-radius-md|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:iw-radius-sm|1}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:iw-radius-lg|3}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:iw-radius-xl|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{iw-bone}}</Color>
    <Color x:Key="TextColorDarker">{{iw-muted}}</Color>
    <Color x:Key="TextColorDark">{{iw-ink-dark}}</Color>
    <Color x:Key="MainColor">{{iw-well}}</Color>
    <Color x:Key="MainColorDark">{{iw-panel}}</Color>
    <Color x:Key="HoverColor">{{iw-hover}}</Color>
    <Color x:Key="GlyphColor">{{iw-ember}}</Color>
    <Color x:Key="HighlightGlyphColor">{{iw-ember-lit}}</Color>
    <Color x:Key="PopupBackgroundColor">{{iw-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{iw-popup-border}}</Color>
    <Color x:Key="BackgroundToneColor">{{iw-panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{iw-hairline}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{iw-hairline}}</Color>
    <Color x:Key="DataChangeNotifColor">{{iw-gold-lit}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{iw-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{iw-panel}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{iw-well}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{iw-well-deep}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <!-- Running game: Armor Jade (#1d7a47), distinct from ember Play, sea-steel hover, and gold filter/score accents. -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{iw-jade}}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{iw-jade-lit}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{iw-crimson-lit}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{iw-gold-lit}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{iw-gold-lit}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{iw-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{iw-surface}}" />

    <!-- Shell and surfaces -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{iw-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{iw-surface}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{iw-chrome}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{iw-surface}}" />
    <!-- Banner darkening color (ThemeModifier): deep abyssal verdigris void so darkened banners keep Ironward's cold iron cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{iw-void}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{iw-scrim}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{iw-chrome}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{iw-well-deep}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{iw-well}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{iw-well}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{iw-ember-lit}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{iw-hairline}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{iw-rule}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{iw-rule-lit}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{iw-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{iw-ember-row}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{iw-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{iw-bone}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{iw-ember-lit}}" />

    <!-- States and selection -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{iw-ember-row}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{iw-ember-deep}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{iw-ember-lit}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{iw-bone}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{iw-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{iw-ember-row}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{iw-hover}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{iw-ember-lit}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{iw-ember/55}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{iw-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{iw-bone}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{iw-bone}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{iw-bone}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{iw-mist}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{iw-border}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{iw-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{iw-well-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{iw-ember-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{iw-ember}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{iw-ember-aa}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{iw-ember-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{iw-bone}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{iw-ember-lit}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{iw-well}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{iw-border}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{iw-hover}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{iw-well-deep}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{iw-ember-aa}}" />

    <!-- Inputs and controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{iw-well-deep}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{iw-panel}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{iw-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{iw-sea-teal}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{iw-border}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{iw-sea-teal-lit}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{iw-ember}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{iw-well-deep}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{iw-bone}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{iw-sea-teal-lit}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{iw-sea-teal-lit}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{iw-well-deep}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{iw-sea-teal}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{iw-border}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{iw-rule}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{iw-well-deep}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{iw-border}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{iw-rule}}" />

    <!-- Tabs, covers, headers, metadata -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{iw-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{iw-bone}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{iw-ember-lit}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{iw-sea-teal}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{iw-sea-teal}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{iw-ember-lit}}" />

    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{iw-well}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{iw-mist}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{iw-hover}}" />

    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{iw-well}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{iw-bone}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{iw-bone}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{iw-rule-lit}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{iw-ember-lit}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{iw-rule}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{iw-bone}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{iw-rule}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{iw-hairline}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{iw-sea-teal}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{iw-rule-lit}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{iw-void}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{iw-hairline}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{iw-bone}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{iw-rule}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{iw-chrome}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{iw-bone}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{iw-steel-blue-lit}}" />
</ResourceDictionary>
