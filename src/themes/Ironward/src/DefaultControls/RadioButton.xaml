<!--
    Ironward: RadioButton. Rotated 45-degree diamond socket matching DOOM: The Dark Ages modal/progression pips (13-modal).
    Checked ignites the ember rim and inner diamond pip. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource CheckBoxFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <DockPanel Background="Transparent">
                        <Grid Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Path x:Name="Socket" Width="16" Height="16" Stretch="Fill"
                                  Fill="{DynamicResource CheckBoxCheckMarkBkBrush}" Stroke="{DynamicResource CheckBoxBorderBrush}" StrokeThickness="1.2"
                                  Data="M8,0 L16,8 L8,16 L0,8 Z" />
                            <Path x:Name="Gem" Width="7" Height="7" Stretch="Fill" Visibility="Collapsed"
                                  Fill="{DynamicResource PrimaryButtonGlowBrush}"
                                  Data="M4,0 L8,4 L4,8 L0,4 Z" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Socket" Property="Stroke" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Socket" Property="Stroke" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                            <Setter TargetName="Gem" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
