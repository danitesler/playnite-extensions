<!--
    Ironward: ContextMenu. Every popup menu and dropdown list (hamburger menu, top bar dropdowns via TopPanelMenu,
    GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select boxes) wears
    the forged verdigris-iron codex tablet (LocalIronwardMenuTemplate): PopupBackgroundBrush with subtle stone-iron
    mottle (GrainTemplate at 0.07), 1px PopupBorderBrush rim, diagonal silver-teal corner barbs, a top silver-teal
    spearhead rule breaking around a molten ember V-notch chevron, and a silver-teal foot rule. Rows start 9px down.
    Rows and the 10px double-spearhead group break are in Menu.xaml.
    Structure: Playnite Default 10.60. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalIronwardMenuTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Control Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource TextBrush}"
                     Opacity="0.07" Margin="1" Focusable="False" IsTabStop="False" />
            <!-- Forged silver-teal diagonal corner barbs -->
            <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0"
                  Data="M 0,7 L 0,0 L 7,0 L 5,2 L 2,2 L 2,5 Z" Fill="{DynamicResource TopPanelRuleEndBrush}" Opacity="0.8" />
            <Path Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                  Data="M 0,0 L 7,0 L 7,7 L 5,5 L 5,2 L 2,2 Z" Fill="{DynamicResource TopPanelRuleEndBrush}" Opacity="0.8" />
            <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,2"
                  Data="M 0,0 L 2,2 L 2,5 L 5,5 L 7,7 L 0,7 Z" Fill="{DynamicResource TopPanelRuleEndBrush}" Opacity="0.6" />
            <Path Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                  Data="M 7,0 L 7,7 L 0,7 L 2,5 L 5,5 L 5,2 Z" Fill="{DynamicResource TopPanelRuleEndBrush}" Opacity="0.6" />
            <!-- Top silver-teal rule breaking around a molten ember V-notch crown -->
            <Grid Height="6" Margin="14,2,14,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Top" Margin="0,1,3,0" Fill="{DynamicResource TopPanelRuleStartBrush}" Opacity="0.7" />
                <Path Grid.Column="1" Width="12" Height="6" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Data="M 0,0 L 6,6 L 12,0 L 9.5,0 L 6,3.5 L 2.5,0 Z" Fill="{DynamicResource SelectedBorderBrush}" />
                <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Top" Margin="3,1,0,0" Fill="{DynamicResource TopPanelRuleStartBrush}" Opacity="0.7" />
            </Grid>
            <!-- Thin silver-teal foot rule -->
            <Rectangle Height="1" Margin="18,0,18,2" VerticalAlignment="Bottom" Fill="{DynamicResource TopPanelRuleStartBrush}" Opacity="0.45" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalIronwardMenuTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,9,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="5,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
