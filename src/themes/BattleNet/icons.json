{
    "_comment": "Icons this theme ships. Phosphor Icons 2.1.1 (MIT, npm @phosphor-icons/core). The Geometry job writes icons.generated.xaml: paste its entries into src/Media.xaml (not committed). The Png jobs write the menu icons Media.xaml maps to files. Colors are src/tokens.css bnet-text-muted and bnet-red; re-run after changing them. Render with .\\scripts\\render-icons.ps1 -Extension battlenet (Windows).",
    "jobs": [
        {
            "_comment": "Icon<Role> geometries drawn by IconTemplate on Phosphor's 256 grid.",
            "pack": "phosphor",
            "ref": "main",
            "variant": "regular",
            "format": "Geometry",
            "keyPrefix": "Icon",
            "xamlOut": "icons.generated.xaml",
            "icons": [
                "magnifying-glass=Search", "x=Clear", "sliders-horizontal=ViewSettings", "bookmarks-simple=FilterPresets",
                "rows=Group", "sort-ascending=Sort", "columns=DetailsView", "squares-four=GridView", "list-bullets=ListView",
                "download-simple=Update", "tree-structure=Explorer", "dice-five=Random", "shuffle=ViewRandom", "funnel=Filter",
                "bell=Notifications", "spiral=MainMenu", "game-controller=Library", "chart-bar=Statistics", "minus=WindowMinimize",
                "square=WindowMaximize", "copy=WindowRestore", "x=WindowClose", "caret-down=DropDown", "caret-right=Submenu",
                "check=Check", "plus=Add", "pencil-simple=Edit", "trash=Remove", "gear=Options"
            ]
        },
        {
            "_comment": "Menu icons: Media.xaml maps Playnite's *Icon keys to these files.",
            "pack": "phosphor",
            "ref": "main",
            "variant": "regular",
            "format": "Png",
            "outDir": "src/Images/Phosphor",
            "size": 48,
            "color": "#a4abb8",
            "icons": [
                "arrows-out=screen-full", "plus", "arrows-clockwise=sync", "info", "gear", "plugs=plug", "play",
                "download-simple=download", "link", "folder-open=file-directory", "database", "desktop=desktop-download",
                "star", "eye-slash=eye-closed", "eye", "sun", "pencil-simple=pencil", "dice-five=dice", "book-open=book",
                "archive", "clock-counter-clockwise=history"
            ]
        },
        {
            "pack": "phosphor",
            "ref": "main",
            "variant": "fill",
            "format": "Png",
            "outDir": "src/Images/Phosphor",
            "size": 48,
            "color": "#a4abb8",
            "icons": [ "star=star-fill" ]
        },
        {
            "pack": "phosphor",
            "ref": "main",
            "variant": "regular",
            "format": "Png",
            "outDir": "src/Images/Phosphor",
            "size": 48,
            "color": "#ff5a52",
            "suffix": "-danger",
            "icons": [ "sign-out", "trash" ]
        }
    ]
}
