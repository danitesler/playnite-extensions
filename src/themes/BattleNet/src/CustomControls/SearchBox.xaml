<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    A dark input well with a leading search icon: 36px, InputBackgroundBrush fill, a 1px edge that lightens on hover and
    turns Blizzard blue while the box has focus, small corners. The chrome is drawn here around a chromeless text box so
    hosts can restyle it through Background / BorderBrush / Height (the toolbar search in Views/TopPanel.xaml).
    Playnite's code hides PART_SeachIcon while the box has focus or text, so it carries the "Search" placeholder; the
    icon itself stays. ShowImage="False" (filter panel fields) drops the icon and the placeholder.
    PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon are Playnite's parts (all three must exist).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Chrome" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <ContentControl x:Name="Glyph" Margin="12,0,0,0" Focusable="False" IsTabStop="False"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                            Foreground="{DynamicResource TextBrushDarker}"
                                            ContentTemplate="{DynamicResource SearchTextIconTemplate}" />
                            <TextBlock x:Name="PART_SeachIcon" Margin="38,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Foreground="{DynamicResource TextBrushDarker}"
                                       Text="{DynamicResource LOCSearchLabel}" />
                            <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                     Padding="36,0,32,0" />
                            <ContentControl x:Name="PART_ClearTextIcon" Margin="0,0,10,0" Focusable="False" IsTabStop="False"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextBrushDarker}"
                                            ContentTemplate="{DynamicResource ClearTextIconTemplate}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Chrome" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Chrome" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glyph" />
                            <Setter Property="Margin" Value="12,0,0,0" TargetName="PART_SeachIcon" />
                            <Setter Property="Padding" Value="10,0,32,0" TargetName="PART_TextInpuText" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
