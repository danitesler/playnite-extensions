<!--
    Overlay on Playnite Default/CustomControls/TrayContextMenu.xaml. Same surface as the theme's ContextMenu
    (DefaultControls/ContextMenu.xaml), so the style is BasedOn it; theme files load one by one, so the StaticResource
    resolves to the theme's own ContextMenu style.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TrayContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />
</ResourceDictionary>
