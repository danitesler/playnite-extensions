<!--
    Relay: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared vocabulary (scripts/data/theme-keys.json). Token names (me-*) live in tokens.css.
    Role map: ../AGENTS.md -> Tokens. Theme XAML reads brushes only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Type: humanist sans body (Myriad in the game, Segoe UI here), wide square display face for titles. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">28</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:me-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Orbitron, {{text:me-font-heading|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width; applied inside the pane's padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: no rounding anywhere; corners are cut at 45 degrees by the plate templates in Common.xaml. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:me-radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Thickness x:Key="FrameThickness">1</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{me-sand}}</Color>
    <Color x:Key="TextColorDarker">{{me-dust}}</Color>
    <Color x:Key="TextColorDark">{{me-void}}</Color>
    <Color x:Key="MainColor">{{me-plate}}</Color>
    <Color x:Key="MainColorDark">{{me-panel}}</Color>
    <Color x:Key="HoverColor">{{me-row-hover}}</Color>
    <Color x:Key="GlyphColor">{{me-lime}}</Color>
    <Color x:Key="HighlightGlyphColor">{{me-lime-deep}}</Color>
    <Color x:Key="PopupBackgroundColor">{{me-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{me-copper}}</Color>
    <Color x:Key="BackgroundToneColor">{{me-hull}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{me-rule}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{me-rule}}</Color>
    <Color x:Key="DataChangeNotifColor">{{me-lime}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{me-panel}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{me-plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{me-void}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{me-lime}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{me-renegade}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{me-amber}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{me-yellow}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{me-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{me-void}}" />

    <!-- Shell: warm black frame, the library one step lighter -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{me-void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{me-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{me-hull}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{me-hull}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{me-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{me-plate}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the theme's
         own ArtTint color, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{me-plate}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{me-copper}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{me-rule}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{me-panel}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{me-panel-hi}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{me-lime}}" />

    <!-- States: the selected option is an olive plate with a lime rim and lime text -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{me-olive}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{me-lime-deep}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{me-lime}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{me-lime}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{me-row-hover}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{me-plate}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{me-gold}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{me-renegade}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{me-gold}}" />

    <!-- Headings: lime display titles, orange "+" marker, copper rules -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{me-lime}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{me-orange}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{me-new}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{me-rule}}" />

    <!-- Buttons: amber plate with a rim and gold text; Play is the lime confirm plate -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{me-gold}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{me-plate-hi}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{me-copper}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{me-lime-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{me-lime}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{me-lime-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{me-olive}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{me-lime}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{me-olive}}" />

    <!-- Inputs: sunken black wells with a rim -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{me-void}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{me-orange}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{me-copper}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{me-orange}}" />

    <!-- Controls: bars, scroll rail, tabs, menus -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{me-rule}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{me-orange}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{me-gold}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{me-orange}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{me-rule}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{me-orange}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{me-orange}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{me-dust}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{me-amber}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{me-rule}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{me-sand}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{me-copper}}" />

    <!-- Library -->
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{me-lime}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{me-orange}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{me-rule}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{me-copper}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{me-orange}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{me-row-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{me-olive}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{me-amber}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{me-lime}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{me-lime}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{me-panel-hi}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{me-orange}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{me-plate}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{me-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{me-lime}}" />

    <!-- Running game: me-paragon, the paragon blue, the cold opposite of the orange, lime and amber the menus select and hover with. -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{me-paragon}}" />
</ResourceDictionary>
