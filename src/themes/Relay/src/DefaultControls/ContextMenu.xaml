<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is a Mass Effect 2 codex panel: warm black (PopupBackgroundBrush) with the top-left
    and bottom-right corners cut at 45 degrees (10px), a 1px copper rim (FrameBrush), a lime tick on the top edge and an
    orange "+" in the top-right corner, like the metadata pane (no honeycomb behind the text).
    LocalCodexPanelTemplate is shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and
    CustomControls/FilterSelectionBox.xaml. Nothing rises above the panel; rows start 8px below its top and stay clear
    of both cuts. Rows, highlight and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalCodexPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
            </Grid.RowDefinitions>
            <Path Grid.Row="0" Grid.Column="0" Stretch="Fill" Data="M1,0 L1,1 L0,1 Z" Fill="{DynamicResource PopupBackgroundBrush}" />
            <Path Grid.Row="2" Grid.Column="2" Stretch="Fill" Data="M0,0 L1,0 L0,1 Z" Fill="{DynamicResource PopupBackgroundBrush}" />
            <Rectangle Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Fill="{DynamicResource PopupBackgroundBrush}" />
            <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="{DynamicResource PopupBackgroundBrush}" />
            <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Fill="{DynamicResource PopupBackgroundBrush}" />
            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource FrameBrush}" />
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource FrameBrush}" />
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource FrameBrush}" />
            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource FrameBrush}" />
            <Path Grid.Row="0" Grid.Column="0" Stretch="Fill" Data="M0,1 L1,0" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1" />
            <Path Grid.Row="2" Grid.Column="2" Stretch="Fill" Data="M1,0 L0,1" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1" />
            <!-- Codex marks: the lime tick on the top edge, the orange "+" in the top-right corner -->
            <Border Grid.Row="0" Grid.Column="1" Width="28" Height="2" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{DynamicResource SelectedBorderBrush}" />
            <Grid Grid.RowSpan="3" Grid.ColumnSpan="3" Width="7" Height="7" Margin="0,3,4,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Rectangle Width="1" Fill="{DynamicResource HeadingMarkerBrush}" />
                <Rectangle Height="1" Fill="{DynamicResource HeadingMarkerBrush}" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalCodexPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="1,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
