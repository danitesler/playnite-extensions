<!--
    Relay: GroupBox. A codex panel: lime display-face title above a warm black plate with cut top-left and bottom-right
    corners and a copper rim, plus the orange "+" marker on its top-right. Content-sized (the plate template has no
    desired size and the marker is 7px), so Statistics keeps its wrapping cards. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}" Style="{DynamicResource HeadingTextBlock}">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header" RecognizesAccessKey="True" />
                        </TextBlock>
                        <Grid>
                            <Control Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" Padding="10"
                                     Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="{TemplateBinding Padding}" />
                            <Path Width="7" Height="7" Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Fill"
                                  Data="{DynamicResource IconAdd}" Fill="{DynamicResource HeadingMarkerBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
