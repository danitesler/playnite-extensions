<!--
    Relay: spacing, focus and the shared plate shapes of the Mass Effect 2 menus.
    ChamferTemplate is the button plate (Info / Exit / Mark All Viewed): the top-left and bottom-right corners cut at
    45 degrees, a 1px amber rim and a faint honeycomb band through the middle. SlantPlateTemplate is the research row
    and selected option: a parallelogram with a 1px rim. Cut and slant sizes come from the host's Padding.Left.
    Both are built from rectangles and stretched triangles, so they have no desired size and fit any plate.
    GlowFrameTemplate is the soft rim bloom of the lit panels, a 9-slice white mask (art/sprites.py).
    Sizes: 32px fields, 16px glyphs, 8px cuts on buttons, 10px slants on rows.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Plates in the game: text inset about 16px from the cut, rows 20px apart in a 1080p menu (about 30px here). -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">8,5</Thickness>
    <Thickness x:Key="MenuPadding">0,4</Thickness>
    <Thickness x:Key="MenuItemPadding">14,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,3</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">12,5</Thickness>
    <Thickness x:Key="ListBoxItemPadding">12,5</Thickness>
    <Thickness x:Key="GroupBoxPadding">16,12,16,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>

    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Button plate: cut top-left and bottom-right corners (size = Padding.Left), Background body, BorderBrush rim,
         and a honeycomb band in BorderBrush through the middle row. -->
    <ControlTemplate x:Key="ChamferTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Path Grid.Row="0" Grid.Column="0" Stretch="Fill" Data="M1,0 L1,1 L0,1 Z" Fill="{TemplateBinding Background}"
                  Width="{Binding Padding.Left, RelativeSource={RelativeSource TemplatedParent}}"
                  Height="{Binding Padding.Left, RelativeSource={RelativeSource TemplatedParent}}" />
            <Path Grid.Row="2" Grid.Column="2" Stretch="Fill" Data="M0,0 L1,0 L0,1 Z" Fill="{TemplateBinding Background}"
                  Width="{Binding Padding.Left, RelativeSource={RelativeSource TemplatedParent}}"
                  Height="{Binding Padding.Left, RelativeSource={RelativeSource TemplatedParent}}" />
            <Rectangle Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="{TemplateBinding BorderBrush}" Opacity="0.22">
                <Rectangle.OpacityMask>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,6.928,12" ViewportUnits="Absolute" Viewbox="0,0,6.928,12" ViewboxUnits="Absolute" Stretch="Fill">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Geometry="M3.464,0 L6.928,2 L6.928,6 L3.464,8 L0,6 L0,2 Z M3.464,8 L3.464,12">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#FFFFFFFF" Thickness="0.7" />
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{TemplateBinding BorderBrush}" />
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{TemplateBinding BorderBrush}" />
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0,0,0,1" BorderBrush="{TemplateBinding BorderBrush}" />
            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" BorderThickness="1,0,0,0" BorderBrush="{TemplateBinding BorderBrush}" />
            <Path Grid.Row="0" Grid.Column="0" Stretch="Fill" Data="M0,1 L1,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
            <Path Grid.Row="2" Grid.Column="2" Stretch="Fill" Data="M1,0 L0,1" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
        </Grid>
    </ControlTemplate>

    <!-- Research row / selected option: a parallelogram leaning right (slant = Padding.Left), Background body,
         BorderBrush rim. Foreground is unused (no offset second plate). -->
    <ControlTemplate x:Key="SlantPlateTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Stretch="Fill" Data="M1,0 L1,1 L0,1 Z" Fill="{TemplateBinding Background}"
                  Width="{Binding Padding.Left, RelativeSource={RelativeSource TemplatedParent}}" />
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Background}" />
            <Path Grid.Column="2" Stretch="Fill" Data="M0,0 L1,0 L0,1 Z" Fill="{TemplateBinding Background}"
                  Width="{Binding Padding.Left, RelativeSource={RelativeSource TemplatedParent}}" />
            <Border Grid.Column="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{TemplateBinding BorderBrush}" />
            <Border Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0,0,0,1" BorderBrush="{TemplateBinding BorderBrush}" />
            <Path Grid.Column="0" Stretch="Fill" Data="M0,1 L1,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
            <Path Grid.Column="2" Stretch="Fill" Data="M1,0 L0,1" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
        </Grid>
    </ControlTemplate>

    <!-- Rim bloom of a lit panel: 9-slice of Images/fx/glow-frame.png (128px, 44px corners), in the host's Foreground.
         Hosts sit at a -28 margin around the plate they light. No desired size. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,84,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Targeting brackets of the HUD: four 10px L marks, 1.5px thick, in the host's Foreground. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}" Data="F1M0,0H10V1.5H1.5V10H0Z" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}" Data="F1M0,0H10V10H8.5V1.5H0Z" />
            <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Data="F1M0,0H1.5V8.5H10V10H0Z" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Data="F1M8.5,0H10V10H0V8.5H8.5Z" />
        </Grid>
    </ControlTemplate>

    <!-- Rule under a heading: 1px line in the inherited foreground with a slanted 18px tick at its left end. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="4" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Opacity="0.55" />
            <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Data="F1M3,0H21L18,4H0Z" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1" StrokeDashArray="3 2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
