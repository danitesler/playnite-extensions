<!--
    Relay: dialogs and the Settings window drawn as a Mass Effect 2 menu screen: a 44px warm black title band with the
    screen title in lime display type behind a slanted lime tick, a honeycomb field fading in toward the right end of
    the band (copper, 18%), and a closing copper rule with a lit orange segment under the title. 1px copper frame.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource FrameBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid VerticalAlignment="Top" Height="44" Background="{DynamicResource WindowTitleBackgroundBrush}" IsHitTestVisible="False" />
                                <Grid VerticalAlignment="Top" Height="44" ClipToBounds="True" IsHitTestVisible="False">
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0.35" Color="#00FFFFFF" />
                                            <GradientStop Offset="1" Color="#FFFFFFFF" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <Canvas>
                                        <Rectangle Width="2400" Height="44" Fill="{DynamicResource FrameBrush}" Opacity="0.18">
                                            <Rectangle.OpacityMask>
                                                <DrawingBrush TileMode="Tile" Viewport="0,0,10.392,18" ViewportUnits="Absolute" Viewbox="0,0,6.928,12" ViewboxUnits="Absolute" Stretch="Fill">
                                                    <DrawingBrush.Drawing>
                                                        <GeometryDrawing Geometry="M3.464,0 L6.928,2 L6.928,6 L3.464,8 L0,6 L0,2 Z M3.464,8 L3.464,12">
                                                            <GeometryDrawing.Pen>
                                                                <Pen Brush="#FFFFFFFF" Thickness="0.6" />
                                                            </GeometryDrawing.Pen>
                                                        </GeometryDrawing>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Canvas>
                                </Grid>
                                <Rectangle VerticalAlignment="Top" Height="1" Margin="0,43,0,0" Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />
                                <Path VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12,41,0,0" Data="F1M2,0H150L148,3H0Z" Fill="{DynamicResource HeadingMarkerBrush}" IsHitTestVisible="False" />
                                <DockPanel VerticalAlignment="Top" Height="44" LastChildFill="False">
                                    <Path DockPanel.Dock="Left" Margin="16,0,10,0" VerticalAlignment="Center" Data="F1M4,0H10L6,14H0Z" Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                                    <TextBlock Text="{TemplateBinding Title}" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeLarger}"
                                               Style="{DynamicResource HeadingTextBlock}" Foreground="{DynamicResource WindowTitleForegroundBrush}" x:Name="PART_TextTitle" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </DockPanel>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
