<!--
    Relay: metadata values. An orange text link by default (the codex entry links), lime on hover; a small slanted
    research-row chip when the owning list has Tag="Chip": warm plate, dark copper rim, sand text, orange rim on hover.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="Margin" Value="0,0,8,2" />
        <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" Background="Transparent"
                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}" TextWrapping="Wrap" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="Margin" Value="0,0,5,5" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Control x:Name="Plate" Template="{DynamicResource SlantPlateTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Padding="5"
                                         Background="{DynamicResource PropertyItemBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" />
                                <TextBlock Margin="11,3" FontSize="{TemplateBinding FontSize}" Foreground="{DynamicResource TextBrush}"
                                           Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}" TextWrapping="Wrap" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Plate" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                                    <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
