<!--
    Relay: cover tiles. Selected is static: a 2px orange frame with the codex "+" marker on its top-right corner.
    Hover is the HUD target lock: lime targeting brackets close in on the cover (from 10px out to 3px, 0.18s, eased)
    while a 1px lime outline fades in; leaving reverses it over 0.25s. Everything is drawn
    inside the item spacing. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}" Margin="{Settings ItemSpacingMargin}" x:Name="ItemGrid">
                        <ContentPresenter />
                        <Border x:Name="SelectionFrame" BorderThickness="2" Margin="-2" IsHitTestVisible="False" Visibility="Collapsed"
                                BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" />
                        <Path x:Name="SelectionPip" Width="11" Height="11" Margin="0,-5,-5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Fill"
                              Data="{DynamicResource IconAdd}" IsHitTestVisible="False" Visibility="Collapsed" Fill="{DynamicResource GridViewItemSelectedBorderBrush}" />
                        <Border x:Name="HoverOutline" BorderThickness="1" Margin="-1" IsHitTestVisible="False" Opacity="0"
                                BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                        <Control x:Name="HoverMarks" Template="{DynamicResource CornerMarksTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                 Foreground="{DynamicResource GridViewItemHoverBorderBrush}" Margin="-10" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectionFrame" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectionPip" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="91" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <ThicknessAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Margin" To="-3" Duration="0:0:0.18">
                                            <ThicknessAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverOutline" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <ThicknessAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Margin" To="-10" Duration="0:0:0.25">
                                            <ThicknessAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverOutline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
