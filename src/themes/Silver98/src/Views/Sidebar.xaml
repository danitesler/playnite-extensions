<!--
    Silver 98: Views/Sidebar.xaml.
    44px Windows 95/98 Quick Launch / Explorer Rebar rail (#C0C0C0) with a raised 3D right seam,
    crowned by a 40x44 raised 3D Start / Main Menu button bearing the Classic CRT Computer mark and
    a 2-line horizontal rebar grip below it. Turns transparent when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <DockPanel x:Name="DockContentHolder">
                                <!-- Start / Main Menu Button: Raised 3D Win32 button with CRT Computer mark -->
                                <Border x:Name="PART_ElemMainMenu" Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                        Width="40" Height="42" Margin="2,3,2,2"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                <Control x:Name="MenuBevel" Template="{DynamicResource LocalRaisedBevelTemplate}" IsHitTestVisible="False" />
                <Rectangle x:Name="MenuFocusDots" Margin="3" Stroke="{DynamicResource TextBrush}"
                           StrokeThickness="1" StrokeDashArray="1 1"
                           Visibility="Collapsed" IsHitTestVisible="False" />
                <Control Template="{DynamicResource LocalSilver98MenuMarkTemplate}" Focusable="False" IsTabStop="False" Foreground="{DynamicResource MainMenuButtonForegroundBrush}" />
            </Grid>
                                </Border>

                                <!-- Win98 Rebar double etched grip bar -->
                                <StackPanel x:Name="MenuDivider" DockPanel.Dock="Top" Margin="5,2,5,4" IsHitTestVisible="False">
                                    <Border Height="1" Background="{DynamicResource LocalBevelHighlightBrush}" />
                                    <Border Height="1" Background="{DynamicResource LocalBevelShadowBrush}" />
                                    <Border Height="1" Margin="0,1,0,0" Background="{DynamicResource LocalBevelHighlightBrush}" />
                                    <Border Height="1" Background="{DynamicResource LocalBevelShadowBrush}" />
                                </StackPanel>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>

                            <!-- Raised 3D right edge seam -->
                            <StackPanel x:Name="EdgeRule" Orientation="Horizontal" HorizontalAlignment="Right" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                <Border Width="1" Background="{DynamicResource LocalBevelShadowBrush}" />
                                <Border Width="1" Background="{DynamicResource LocalBevelHighlightBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Background" Value="Transparent" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuBevel" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuDivider" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Visibility" Value="Visible" TargetName="MenuFocusDots" />
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="2,2,4,2" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="40" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,136,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuDivider" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="2,2,4,2" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="40" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuDivider" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
