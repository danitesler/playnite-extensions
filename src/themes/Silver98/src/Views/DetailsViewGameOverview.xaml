                                                                                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                                        <Border Grid.Column="2"><TextBlock x:Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" /></Border>
