<!--
    Silver 98: Views/DetailsViewGameOverview.xaml (generated by art/gen-overviews.mjs).
    - Explorer 4.0 Web View hero banner (GameBannerHeight=260, spacer x * 204 / 260 floor 20) with GameBannerDarken + 50% floor.
    Simple, authentic Win32 3D dialog layout with active title bar gradient.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="DetailsViewGameOverview">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DetailsViewGameOverview">
                    <ScrollViewer x:Name="PART_ScrollViewHost" Visibility="Visible" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                        <Grid x:Name="PageRoot" UseLayoutRounding="True">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                            <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                                <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                    <Setter Property="Height" Value="0" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <!-- Smooth dissolve into PageRoot.Background (#FFFFFF) so title and Explorer 4.0 Web View header sit cleanly -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.28" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.80" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <StackPanel Margin="28,0,28,28">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border x:Name="DetailsBannerSpacer" MinHeight="20" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 204 / 260'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="20" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
                                                    <Setter Property="Height" Value="20" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel Margin="0,10,0,16">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                                        <Grid MinWidth="166" Height="40">
                                            <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                            <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                            <Control Style="{DynamicResource RunningActionIndicator}" />
                                        </Grid>
                                        <Button x:Name="PART_ButtonMoreActions" Width="40" Height="40" Padding="0" Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                            <ContentControl Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                        <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Style="{DynamicResource SecondaryButton}" Margin="6,0,0,0" ToolTip="{DynamicResource LOCEditGame}">
                                            <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>
                                    <DockPanel>
                                        <Image x:Name="PART_ImageIcon" MaxWidth="48" MaxHeight="48" Margin="0,0,14,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLargest}"
                                                       FontWeight="Bold" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Control Template="{DynamicResource DividerTemplate}" Margin="0,5,0,0" Focusable="False" IsHitTestVisible="False">
                                                <Control.Style>
                                                    <Style TargetType="Control">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Control.Style>
                                            </Control>
                                        </StackPanel>
                                    </DockPanel>
                                </DockPanel>
                                <Grid Margin="0,14,0,0" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
<Grid Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                        <!-- Classic Windows 98 File Properties 3D Dialog Card (Active Navy Title Bar + Sunken White Property Well, 300px usable inner width) -->
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                                Background="{DynamicResource PopupBackgroundBrush}" Padding="3" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Control Template="{DynamicResource LocalRaisedBevelTemplate}" IsHitTestVisible="False" />
                                                <DockPanel Margin="3">
                                                    <!-- Windows 98 Active Title Bar Gradient -->
                                                    <Grid DockPanel.Dock="Top" Height="22" Margin="0,0,0,3" Background="{DynamicResource WindowTitleBackgroundBrush}">
                                                        <Rectangle Fill="{DynamicResource LocalCaptionGradientEndBrush}" IsHitTestVisible="False">
                                                            <Rectangle.OpacityMask>
                                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                    <GradientStop Color="#00000000" Offset="0" />
                                                                    <GradientStop Color="#FF000000" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Rectangle.OpacityMask>
                                                        </Rectangle>
                                                        <DockPanel Margin="6,0,4,0">
                                                            <Control Width="14" Height="14" DockPanel.Dock="Left" Margin="0,0,6,0"
                                                                     Template="{DynamicResource LocalFolderIconTemplate}" />
                                                            <TextBlock Text="{DynamicResource LOCGameDetails}"
                                                                       FontFamily="{DynamicResource FontFamily}"
                                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Grid>

                                                    <!-- Sunken White Property Well -->
                                                    <Grid>
                                                        <Border Background="{DynamicResource InputBackgroundBrush}" Padding="14,12,14,12">
                                                            <StackPanel Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch" x:Name="DetailsMetadataContent">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                                <Control Template="{DynamicResource DividerTemplate}" Margin="0,0,0,10" Focusable="False" />
                                                                <Grid ClipToBounds="True" x:Name="DetailsMetadataViewport">
                                                                    <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-28,0,-4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-28,-24,-4" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Margin" Value="0,0,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,0,-24,0" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Margin" Value="0,0,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,0,-24,0" /></MultiDataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                                        <Border x:Name="MetaProgress" Padding="0,9,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,9,0,0" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
</Border>
<Border x:Name="PART_ElemCompletionStatus" Padding="0,2" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                                        <Border Grid.Column="2"><Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PropertyItemButton}" /></Border>
                                                                                    </Grid>
                                                                                </Border>
<Border x:Name="PART_ElemPlayTime" Padding="0,2" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                    <Grid>
