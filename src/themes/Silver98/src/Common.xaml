<!--
    Silver 98: Common.xaml — spacing keys, shared white-mask ImageBrushes (dithered checkerboard & segmented
    progress blocks), Win32 3D bevel chrome templates (LocalRaisedBevelTemplate, LocalSunkenBevelTemplate,
    LocalEtchedBoxTemplate, LocalDottedFocusTemplate), BrandMarkTemplate, DividerTemplate (Explorer 4.0 Web View
    4-color rule), EmptyGameTemplate, SteamScreenshotsSkeletonTemplate, HeadingTextBlock, and SecondaryButton.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Spacing & Metric Keys (per repo FormControlHeight & Menu rules) -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>               <!-- Standard 32px inputs, combos, buttons -->
    <sys:Double x:Key="IconSize">16</sys:Double>                    <!-- Classic 16x16 Win95/98 pixel icons -->
    <sys:Double x:Key="GameBannerHeight">260</sys:Double>           <!-- Default hero banner height (0..600) -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>             <!-- Default banner darkening slider (0..1) -->
    <Thickness x:Key="ButtonPadding">14,5</Thickness>               <!-- 2px 3D bevel + 5px v-pad = 32px -->
    <Thickness x:Key="InputPadding">8,5</Thickness>                 <!-- TextBox / PasswordBox / ComboBox -->
    <Thickness x:Key="MenuPadding">3,3,3,3</Thickness>              <!-- Raised 3D Win32 menu board inset -->
    <Thickness x:Key="MenuItemPadding">8,4</Thickness>              <!-- Compact 28px menu rows -->
    <Thickness x:Key="ComboBoxDropDownPadding">3,3,3,3</Thickness>  <!-- Sunken ComboBox popup inset -->
    <Thickness x:Key="ComboBoxItemPadding">8,4</Thickness>          <!-- 28px ComboBox rows -->
    <Thickness x:Key="ListBoxItemPadding">8,4</Thickness>           <!-- ListBox rows -->
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>      <!-- Etched Win32 GroupBox inset -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,6</Thickness>
    <Thickness x:Key="TooltipPadding">7,4</Thickness>               <!-- #FFFFE1 Win95/98 tooltip inset -->

    <!-- Shared White-Mask FX ImageBrushes (recolored live by ThemeModifier via Fill/Background) -->
    <ImageBrush x:Key="LocalDitherCheckerMaskBrush" ImageSource="{ThemeFile 'Images/fx/dither-checker.png'}"
                TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Stretch="None" />
    <ImageBrush x:Key="LocalProgressBlocksMaskBrush" ImageSource="{ThemeFile 'Images/fx/progress-blocks.png'}"
                TileMode="Tile" Viewport="0,0,10,12" ViewportUnits="Absolute" Stretch="Fill" />

    <!-- Popup Border -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Classic Win32 Dotted Keyboard Focus Visual -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="3" Stroke="{DynamicResource TextBrush}" StrokeThickness="1"
                               StrokeDashArray="1 1" SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Win32 2px Raised 3D Bevel Frame (EDGE_RAISED: #FFFFFF/#DFDFDF top-left, #808080/#000000 bottom-right) -->
    <ControlTemplate x:Key="LocalRaisedBevelTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{DynamicResource LocalBevelHighlightBrush}" BorderThickness="1,1,0,0" />
            <Border BorderBrush="{DynamicResource LocalBevelDarkBrush}" BorderThickness="0,0,1,1" />
            <Border Margin="1" BorderBrush="{DynamicResource LocalBevelLightBrush}" BorderThickness="1,1,0,0" />
            <Border Margin="1" BorderBrush="{DynamicResource LocalBevelShadowBrush}" BorderThickness="0,0,1,1" />
        </Grid>
    </ControlTemplate>

    <!-- Win32 2px Sunken 3D Bevel Well (EDGE_SUNKEN: #808080/#000000 top-left, #DFDFDF/#FFFFFF bottom-right) -->
    <ControlTemplate x:Key="LocalSunkenBevelTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{DynamicResource LocalBevelShadowBrush}" BorderThickness="1,1,0,0" />
            <Border BorderBrush="{DynamicResource LocalBevelHighlightBrush}" BorderThickness="0,0,1,1" />
            <Border Margin="1" BorderBrush="{DynamicResource LocalBevelDarkBrush}" BorderThickness="1,1,0,0" />
            <Border Margin="1" BorderBrush="{DynamicResource LocalBevelLightBrush}" BorderThickness="0,0,1,1" />
        </Grid>
    </ControlTemplate>

    <!-- Win32 1px Thin Raised Bevel (TBSTYLE_FLAT toolbar hover & status panes) -->
    <ControlTemplate x:Key="LocalThinRaisedBevelTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{DynamicResource LocalBevelHighlightBrush}" BorderThickness="1,1,0,0" />
            <Border BorderBrush="{DynamicResource LocalBevelShadowBrush}" BorderThickness="0,0,1,1" />
        </Grid>
    </ControlTemplate>

    <!-- Win32 1px Thin Sunken Bevel (Status bar cells & checked toolbar items) -->
    <ControlTemplate x:Key="LocalThinSunkenBevelTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{DynamicResource LocalBevelShadowBrush}" BorderThickness="1,1,0,0" />
            <Border BorderBrush="{DynamicResource LocalBevelHighlightBrush}" BorderThickness="0,0,1,1" />
        </Grid>
    </ControlTemplate>

    <!-- Dithered Checkerboard Surface Overlay (Win95/98 scrollbar track & checked toolbar button well) -->
    <ControlTemplate x:Key="LocalDitherOverlayTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalDitherCheckerMaskBrush}"
                   IsHitTestVisible="False" SnapsToDevicePixels="True" />
    </ControlTemplate>

    <!-- Silver 98 Brand Mark: Classic 90s Colored CRT Desktop Computer & Monitor -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
                <!-- Black pixel monitor & keyboard outline -->
                <Path RenderOptions.EdgeMode="Aliased" Fill="{DynamicResource LocalBevelDarkBrush}"
                      Data="M2,1 H14 V11 H10 V13 H13 V15 H3 V13 H6 V11 H2 Z" />
                <!-- 3D Silver monitor bezel & base -->
                <Path RenderOptions.EdgeMode="Aliased" Fill="{DynamicResource LocalFaceBrush}"
                      Data="M3,2 H13 V10 H3 Z M7,11 H9 V13 H7 Z M4,13 H12 V14 H4 Z" />
                <!-- Top-left white bevel highlight on monitor -->
                <Path RenderOptions.EdgeMode="Aliased" Fill="{DynamicResource LocalBevelHighlightBrush}"
                      Data="M3,2 H12 V3 H4 V9 H3 Z" />
                <!-- Classic Navy CRT Screen -->
                <Path RenderOptions.EdgeMode="Aliased" Fill="{DynamicResource LocalNavyBrush}"
                      Data="M4,3 H12 V8 H4 Z" />
                <!-- Cyan Window inside CRT Screen -->
                <Path RenderOptions.EdgeMode="Aliased" Fill="{DynamicResource LocalCaptionGradientEndBrush}"
                      Data="M5,4 H10 V7 H5 Z" />
                <Path RenderOptions.EdgeMode="Aliased" Fill="{DynamicResource LocalBevelHighlightBrush}"
                      Data="M5,4 H10 V5 H5 Z" />
                <!-- Green Power LED -->
                <Path RenderOptions.EdgeMode="Aliased" Fill="{DynamicResource PositiveRatingBrush}"
                      Data="M11,9 H12 V10 H11 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Classic Colored 16x16 Yellow Manila Folder Template (reused in headers & tree) -->
    <ControlTemplate x:Key="LocalFolderIconTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
                <Path RenderOptions.EdgeMode="Aliased" Fill="{DynamicResource LocalBevelDarkBrush}"
                      Data="M2,2 H7 V3 H14 V13 H1 V3 H2 Z" />
                <Path RenderOptions.EdgeMode="Aliased" Fill="{DynamicResource DataChangeNotifBrush}"
                      Data="M2,3 H6 V4 H13 V12 H2 Z" />
                <Path RenderOptions.EdgeMode="Aliased" Fill="{DynamicResource LocalBevelHighlightBrush}"
                      Data="M2,4 H13 V5 H2 Z" />
                <Path RenderOptions.EdgeMode="Aliased" Fill="{DynamicResource MixedRatingBrush}"
                      Data="M3,6 H13 V12 H3 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Explorer 4.0 Web View 4-Color Divider Bar (Red / Yellow / Green / Blue; safe inside GroupBox/Statistics) -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="4" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Height="2" VerticalAlignment="Center" Fill="{DynamicResource LocalWebRedBrush}" />
            <Rectangle Grid.Column="1" Height="2" VerticalAlignment="Center" Fill="{DynamicResource LocalWebYellowBrush}" />
            <Rectangle Grid.Column="2" Height="2" VerticalAlignment="Center" Fill="{DynamicResource LocalWebGreenBrush}" />
            <Rectangle Grid.Column="3" Height="2" VerticalAlignment="Center" Fill="{DynamicResource LocalWebBlueBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Four Pixel Selection Handles (CornerMarksTemplate, zero desired size) -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Width="5" Height="5" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Rectangle Width="5" Height="5" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Rectangle Width="5" Height="5" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Rectangle Width="5" Height="5" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <!-- Empty Game Page: Classic Windows 98 Dialog Box with Active Title Bar, CRT Computer Mark & Blinking Prompt -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid Background="Transparent" Margin="28" SnapsToDevicePixels="True">
            <Border MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource PopupBackgroundBrush}" Padding="3">
                <Grid>
                    <Control Template="{DynamicResource LocalRaisedBevelTemplate}" IsHitTestVisible="False" />
                    <StackPanel Margin="3">
                        <!-- Windows 98 Active Title Bar Gradient (brush + OpacityMask so ThemeModifier recolors live) -->
                        <Grid Height="22">
                            <Border Background="{DynamicResource WindowTitleBackgroundBrush}" />
                            <Rectangle Fill="{DynamicResource LocalCaptionGradientEndBrush}" IsHitTestVisible="False">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <DockPanel Margin="6,0,4,0">
                                <Control Width="14" Height="14" DockPanel.Dock="Left" Margin="0,0,6,0"
                                         Template="{DynamicResource BrandMarkTemplate}" />
                                <Border Width="14" Height="14" DockPanel.Dock="Right" Background="{DynamicResource ButtonBackgroundBrush}">
                                    <Grid>
                                        <Control Template="{DynamicResource LocalRaisedBevelTemplate}" />
                                        <ContentControl Width="8" Height="8" Content="{DynamicResource IconWindowClose}"
                                                        ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource TextBrush}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="Explorer — Program Manager"
                                           FontFamily="{DynamicResource FontFamily}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>

                        <!-- Dialog Body -->
                        <Grid Margin="18,18,18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Top" Margin="0,0,16,0">
                                <Control Width="40" Height="40" Template="{DynamicResource BrandMarkTemplate}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                           FontFamily="{DynamicResource FontFamily}"
                                           FontSize="{DynamicResource FontSize}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8" />
                                <!-- Sunken DOS / Status Readout with blinking cursor -->
                                <Border Background="{DynamicResource InputBackgroundBrush}" Padding="8,5">
                                    <Grid>
                                        <Control Template="{DynamicResource LocalSunkenBevelTemplate}" Margin="-8,-5" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="C:\GAMES&gt;" FontFamily="{DynamicResource MonospaceFontFamily}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{DynamicResource TextBrushDarker}" />
                                            <Rectangle x:Name="PromptCaret" Width="7" Height="12" Margin="5,0,0,0"
                                                       Fill="{DynamicResource GlyphBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Etched rule + 3D OK Button look -->
                        <Border Height="2" Margin="10,0,10,10"
                                BorderBrush="{DynamicResource LocalBevelShadowBrush}" BorderThickness="0,1,0,0"
                                Background="{DynamicResource LocalBevelHighlightBrush}" />
                        <Border Width="84" Height="26" HorizontalAlignment="Center" Margin="0,0,0,10"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource LocalBevelDarkBrush}" BorderThickness="1">
                            <Grid>
                                <Control Template="{DynamicResource LocalRaisedBevelTemplate}" />
                                <Rectangle Margin="4" Stroke="{DynamicResource TextBrush}" StrokeThickness="1" StrokeDashArray="1 1" />
                                <TextBlock Text="OK" FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSizeSmall}"
                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="EmptyBoardIdle">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PromptCaret" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyBoardIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SteamScreenshots Plugin Loading Skeleton (Win98 image viewer dialog frame) -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Height="196" Background="{DynamicResource PopupBackgroundBrush}" Padding="3" Margin="0,0,0,8">
                <Grid>
                    <Control Template="{DynamicResource LocalRaisedBevelTemplate}" />
                    <DockPanel Margin="2">
                        <Border DockPanel.Dock="Top" Height="16" Background="{DynamicResource GlyphBrush}" Padding="5,0">
                            <TextBlock Text="Imaging — Preview.bmp" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource WindowTitleForegroundBrush}" VerticalAlignment="Center" />
                        </Border>
                        <Border Background="{DynamicResource InputBackgroundBrush}" Margin="0,2,0,0">
                            <Grid>
                                <Control Template="{DynamicResource LocalSunkenBevelTemplate}" />
                                <Control Width="24" Height="24" Template="{DynamicResource BrandMarkTemplate}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </Grid>
            </Border>
            <UniformGrid Columns="4">
                <Border Height="46" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}">
                    <Control Template="{DynamicResource LocalRaisedBevelTemplate}" />
                </Border>
                <Border Height="46" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}">
                    <Control Template="{DynamicResource LocalRaisedBevelTemplate}" />
                </Border>
                <Border Height="46" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}">
                    <Control Template="{DynamicResource LocalRaisedBevelTemplate}" />
                </Border>
                <Border Height="46" Background="{DynamicResource PopupBackgroundBrush}">
                    <Control Template="{DynamicResource LocalRaisedBevelTemplate}" />
                </Border>
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- Game Page Section Heading (Bold Tahoma, flips to WindowArtForegroundBrush over window art) -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Game Page Secondary Action Button (40x40 Raised 3D Win32 Silver Command Square) -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" />
                        <Border x:Name="HoverFill" Background="{DynamicResource SecondaryButtonHoverBackgroundBrush}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="PressFill" Background="{DynamicResource SecondaryButtonPressedBackgroundBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <Control x:Name="RaisedBevel" Template="{DynamicResource LocalRaisedBevelTemplate}" IsHitTestVisible="False" />
                        <Control x:Name="SunkenBevel" Template="{DynamicResource LocalSunkenBevelTemplate}"
                                 Visibility="Collapsed" IsHitTestVisible="False" />
                        <Rectangle x:Name="FocusDots" Margin="4" Stroke="{DynamicResource TextBrush}" StrokeThickness="1"
                                   StrokeDashArray="1 1" Visibility="Collapsed" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="PressShift" X="0" Y="0" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusDots" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecBtnHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecBtnHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressFill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RaisedBevel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SunkenBevel" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecPressIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="X" To="1" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="SecPressIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): three cascaded desktop windows, each with a navy title strip, on the face-grey bevel button. Hover: the back window slides up-left and the front one down-right (a springy explode of the cascade). Open (ContextMenu.IsOpen of the nearest Border): a busy hourglass appears on the front window and flips over and over, until the menu closes. -->
    <ControlTemplate x:Key="LocalSilver98MenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="SpreadA" X="0" Y="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="2" Canvas.Top="2" Width="15" Height="10" Fill="{DynamicResource LocalWindowBrush}" Stroke="{DynamicResource LocalBevelDarkBrush}" StrokeThickness="1" />
                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="13" Height="2.6" Fill="{DynamicResource LocalNavyBrush}" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    
                    <Rectangle Canvas.Left="5" Canvas.Top="6.5" Width="15" Height="10" Fill="{DynamicResource LocalWindowBrush}" Stroke="{DynamicResource LocalBevelDarkBrush}" StrokeThickness="1" />
                    <Rectangle Canvas.Left="6" Canvas.Top="7.5" Width="13" Height="2.6" Fill="{DynamicResource LocalNavyBrush}" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="SpreadC" X="0" Y="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="8" Canvas.Top="11" Width="15" Height="10" Fill="{DynamicResource LocalWindowBrush}" Stroke="{DynamicResource LocalBevelDarkBrush}" StrokeThickness="1" />
                    <Rectangle Canvas.Left="9" Canvas.Top="12" Width="13" Height="2.6" Fill="{DynamicResource LocalNavyBrush}" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas x:Name="Busy" Canvas.Left="12" Canvas.Top="14" Width="7" Height="9.4" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><RotateTransform x:Name="BusyTurn" Angle="0" /></Canvas.RenderTransform>
                        <Rectangle Width="7" Height="1" Fill="{DynamicResource LocalBevelDarkBrush}" />
                        <Rectangle Canvas.Top="8.4" Width="7" Height="1" Fill="{DynamicResource LocalBevelDarkBrush}" />
                        <Path Data="M0.6,1 H6.4 L3.5,4.6Z M0.6,8.4 H6.4 L3.5,5Z" Fill="{DynamicResource LocalWebYellowBrush}" Stroke="{DynamicResource LocalBevelDarkBrush}" StrokeThickness="0.6" />
                    </Canvas>
                </Canvas>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SpreadA" Storyboard.TargetProperty="X" To="-1.6" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SpreadA" Storyboard.TargetProperty="Y" To="-1.6" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SpreadC" Storyboard.TargetProperty="X" To="1.6" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SpreadC" Storyboard.TargetProperty="Y" To="1.6" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
