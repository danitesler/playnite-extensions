<!--
    Silver 98: DerivedStyles/DetailsViewItemStyle.xaml.
    Classic Windows 98 Explorer list rows inside the sunken white list pane:
    - Hover: Soft pale-blue Win98 Explorer hot-track wash (#E4ECF7 ListItemHoverBrush) with a 2px #000080 Navy
      left tick and a crisp 2px label nudge.
    - Selected: Full-bleed #000080 Navy selection bar (ListItemSelectedBrush), 1px inner dotted cyan focus rectangle
      (StrokeDashArray="1 1"), and #FFFFFF white text (SelectedForegroundBrush).
    - RowHoverAction: Right-edge transparent 26x26 Play / Install glyph button (RowHoverRoom pads right by 38px;
      explicitly collapsed while IsRunning or IsLaunching).
    - RunningIndicator (Windows 95/98 Desktop Teal #008080): drawn above hover & selection, below content;
      2px Desktop Teal frame (RunningFrame) with 1px inner keyline, segmented block sweep (RunningScan),
      segmented block progress foot line (RunningFill), RunningMarkPlate right backing strip + 3 stepping
      pixel block pips inside 40px RowRoom right padding.
    - Light-theme window art flip: unselected rows take WindowArtForegroundBrush when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- RowHoverAction transparent glyph button style (no fill at rest or hover; grows 14 -> 17px on hover) -->
    <Style x:Key="LocalRowHoverActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.78"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl Content="{TemplateBinding Content}"
                                            ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{TemplateBinding Foreground}" Focusable="False" />
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            <Setter TargetName="Glyph" Property="Width" Value="17" />
                            <Setter TargetName="Glyph" Property="Height" Value="17" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="8,3,8,3" />
        <Setter Property="Margin" Value="1,0,1,1" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ControlTemplate.Resources>
                        <DrawingBrush x:Key="LocalSegmentedFootMask" TileMode="Tile" Viewport="0,0,5,3" ViewportUnits="Absolute" Viewbox="0,0,5,3" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="Black">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,4,3" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </ControlTemplate.Resources>
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Hover Layer: Win98 Explorer hot-track pale blue wash + 2px Navy left tick -->
                        <Grid x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Background="{DynamicResource ListItemHoverBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}" />
                        </Grid>

                        <!-- Selected Layer: Classic #000080 Navy Highlight Bar + 1px Dotted Inner Focus Frame -->
                        <Grid x:Name="SelectedPlate" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border Background="{DynamicResource ListItemSelectedBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Rectangle Margin="1" Stroke="{DynamicResource LocalFocusCyanBrush}"
                                       StrokeThickness="1" StrokeDashArray="1 1" Opacity="0.88" />
                        </Grid>

                        <!-- Running Game Indicator (Windows 95/98 Desktop Teal #008080; above hover & selection, below content) -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.16" />

                            <!-- Segmented Block Sweep (Launching only) -->
                            <Grid x:Name="RunningScan" Visibility="Collapsed" ClipToBounds="True">
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <Border Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.42" />
                            </Grid>

                            <!-- 2px Desktop Teal Frame with 1px inner keyline so it reads over both #FFFFFF and #000080 Navy -->
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                    BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border BorderBrush="{DynamicResource LocalBevelHighlightBrush}" BorderThickness="1" Opacity="0.6" />
                            </Border>

                            <!-- 2px Segmented Progress Foot Line -->
                            <Grid Height="2" VerticalAlignment="Bottom" Margin="4,0,4,2" OpacityMask="{StaticResource LocalSegmentedFootMask}">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="FillScaleX" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>

                            <!-- RunningMarkPlate right backing strip + 3 Stepping Pixel Block Pips inside sunken box -->
                            <Border x:Name="RunningMarkPlate" Width="40" HorizontalAlignment="Right" Margin="0,2,2,2"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.45" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border Margin="0,0,6,0" Padding="4,3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{DynamicResource ScrimBrush}" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle x:Name="BlockPip1" Width="3" Height="6" Fill="{DynamicResource LocalRunningHighlightBrush}" />
                                    <Rectangle x:Name="BlockPip2" Width="3" Height="6" Margin="2,0,0,0" Fill="{DynamicResource LocalRunningHighlightBrush}" Opacity="0.3" />
                                    <Rectangle x:Name="BlockPip3" Width="3" Height="6" Margin="2,0,0,0" Fill="{DynamicResource LocalRunningHighlightBrush}" Opacity="0.3" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Content Host inside RowRoom (for running pips) and RowHoverRoom (for RowHoverAction) -->
                        <Border x:Name="RowRoom" Padding="0">
                            <Border x:Name="RowHoverRoom" Padding="0">
                                <ContentPresenter x:Name="RowPresenter" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="RowShiftX" X="0" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Border>

                        <!-- RowHoverAction: Play (installed) / Install (uninstalled) buttons on right edge -->
                        <Button x:Name="RowHoverPlay" Content="{DynamicResource IconPlay}"
                                ToolTip="{DynamicResource LOCPlayGame}"
                                Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LocalRowHoverActionButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="RowHoverInstall" Content="{DynamicResource IconDownload}"
                                ToolTip="{DynamicResource LOCInstallGame}"
                                Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LocalRowHoverActionButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </DataTrigger>

                        <!-- Row hover animation & RowHoverRoom padding -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="RowHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowShiftX" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="RowHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowShiftX" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Selected Row -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SelectedPlate" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!-- RunningMarkRoom left="0" right="40" -->
                        <!-- LAUNCHING State -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,40,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningPipsLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlockPip1" Storyboard.TargetProperty="Opacity" Duration="0:0:0.88">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.66" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlockPip2" Storyboard.TargetProperty="Opacity" Duration="0:0:0.88">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.66" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlockPip3" Storyboard.TargetProperty="Opacity" Duration="0:0:0.88">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.44" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.66" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                                <RemoveStoryboard BeginStoryboardName="RunningPipsLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING State -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,40,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningPipsRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlockPip1" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlockPip2" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlockPip3" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                                <RemoveStoryboard BeginStoryboardName="RunningPipsRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
