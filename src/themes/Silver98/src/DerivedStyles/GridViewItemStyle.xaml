<!--
    Silver 98: DerivedStyles/GridViewItemStyle.xaml.
    Classic Windows 98 Explorer window-framed cover tiles:
    - Idle: Raised 2px 3D silver rim (LocalRaisedBevelTemplate) around the cover slot.
    - Hover: Lifts card 2px upward in discrete steps, lights a 2px #1084D0 Title-Bar Blue border
      (GridViewItemHoverBorderBrush) and 4 pixel selection handles (CornerMarksTemplate).
    - Selected: Locks a 2px #000080 Navy frame (GridViewItemSelectedBorderBrush) with a top 7px
      #000080 -> #1084D0 active title bar cap and a 1px dotted cyan focus inner border.
    - RunningIndicator (Windows 95/98 Desktop Teal #008080, inset 4px inside the selection frame):
      2px Desktop Teal frame (RunningFrame), segmented block sweep (RunningScan), and a 16px bottom
      status bar tape holding segmented progress blocks (RunningFill) and 3 stepping pixel block pips.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ControlTemplate.Resources>
                        <DrawingBrush x:Key="LocalSegmentedFootMask" TileMode="Tile" Viewport="0,0,5,3" ViewportUnits="Absolute" Viewbox="0,0,5,3" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="Black">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,4,3" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </ControlTemplate.Resources>
                    <Grid x:Name="ItemGrid" Margin="{Settings ItemSpacingMargin}" Background="Transparent">
                        <Grid x:Name="Card" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="HoverLift" Y="0" />
                            </Grid.RenderTransform>
                            <Border x:Name="Panel" Background="{DynamicResource GridItemBackgroundBrush}">
                                <Grid>
                                    <ContentPresenter x:Name="CoverPresenter" />

                                    <!-- Raised 3D Win32 Bevel Rim at rest -->
                                    <Control x:Name="IdleBevelRim" Template="{DynamicResource LocalRaisedBevelTemplate}"
                                             IsHitTestVisible="False" />

                                    <!-- Hover: 2px Title-Bar Blue border + 4 pixel selection handles -->
                                    <Grid x:Name="HoverOverlay" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                        <Border BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" BorderThickness="2" />
                                        <Control Margin="2" Template="{DynamicResource CornerMarksTemplate}"
                                                 Foreground="{DynamicResource GridViewItemHoverBorderBrush}" />
                                    </Grid>

                                    <!-- Selected: 2px Navy Frame + 7px Active Title Bar Cap + 1px Dotted Focus Inner Line -->
                                    <Grid x:Name="SelectionBorder" Visibility="Collapsed" IsHitTestVisible="False">
                                        <Border BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" BorderThickness="2">
                                            <Rectangle Margin="1" Stroke="{DynamicResource LocalFocusCyanBrush}"
                                                       StrokeThickness="1" StrokeDashArray="1 1" Opacity="0.9" />
                                        </Border>
                                        <Grid Height="7" VerticalAlignment="Top" Margin="2,2,2,0">
                                            <Rectangle Fill="{DynamicResource WindowTitleBackgroundBrush}" />
                                            <Rectangle Fill="{DynamicResource LocalCaptionGradientEndBrush}">
                                                <Rectangle.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="#00000000" Offset="0" />
                                                        <GradientStop Color="#FF000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Running Game Indicator (inset 4px so selection frame stays visible on outer rim) -->
                            <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.85"
                                  IsHitTestVisible="False" SnapsToDevicePixels="True">
                                <Border x:Name="RunningWash" BorderThickness="5"
                                        BorderBrush="{DynamicResource RunningIndicatorBrush}" Opacity="0.18" />
                                <Border x:Name="RunningScan" Visibility="Collapsed"
                                        Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.32">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.35" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Border x:Name="RunningFrame" BorderThickness="2"
                                        BorderBrush="{DynamicResource RunningIndicatorBrush}" />

                                <!-- 18px Win32 Status Bar Tape at bottom of cover -->
                                <Border x:Name="RunningTape" Height="18" Margin="2" VerticalAlignment="Bottom"
                                        Background="{DynamicResource ScrimBrush}"
                                        BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <StackPanel Margin="0,0,0,3" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle x:Name="BlockPip1" Width="4" Height="6" Fill="{DynamicResource LocalRunningHighlightBrush}" />
                                            <Rectangle x:Name="BlockPip2" Width="4" Height="6" Margin="3,0,0,0" Fill="{DynamicResource LocalRunningHighlightBrush}" Opacity="0.3" />
                                            <Rectangle x:Name="BlockPip3" Width="4" Height="6" Margin="3,0,0,0" Fill="{DynamicResource LocalRunningHighlightBrush}" Opacity="0.3" />
                                        </StackPanel>
                                        <Grid x:Name="RunningFoot" Height="2" Margin="4,0,4,2" VerticalAlignment="Bottom"
                                              OpacityMask="{StaticResource LocalSegmentedFootMask}">
                                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalRunningHighlightBrush}"
                                                       RenderTransformOrigin="0,0.5">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform x:Name="FillScaleX" ScaleX="0" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="TileHoverIn">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverLift" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="-2" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="TileHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverLift" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Setter TargetName="HoverOverlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SelectionBorder" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="Panel" />
                        </DataTrigger>

                        <!-- LAUNCHING State -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.35" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.352" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.352" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningPipsLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlockPip1" Storyboard.TargetProperty="Opacity" Duration="0:0:0.88">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.66" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlockPip2" Storyboard.TargetProperty="Opacity" Duration="0:0:0.88">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.66" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlockPip3" Storyboard.TargetProperty="Opacity" Duration="0:0:0.88">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.44" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.66" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                                <RemoveStoryboard BeginStoryboardName="RunningPipsLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING State -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningPipsRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlockPip1" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlockPip2" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlockPip3" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                                <RemoveStoryboard BeginStoryboardName="RunningPipsRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
