<!--
    Silver 98: DerivedStyles/PropertyItemButton.xaml.
    - Default (Link): Classic Windows 98 Explorer Web View / Internet Explorer 4.0 blue hyperlink (#0000EE LinkBrush)
      with a 1px underline; on hover turns bright title-bar blue (#1084D0 FocusBrush).
    - Chip (ItemsControl Tag="Chip" for Genres, Tags, Features): Raised 2px 3D Win32 silver button tag
      (#C0C0C0 PropertyItemBackgroundBrush, sharp 0px ControlCornerRadius, never CornerRadiusFull) with LocalRaisedBevelTemplate;
      on hover inverts to #000080 Navy (PropertyItemHoverBackgroundBrush) with #FFFFFF SelectedForegroundBrush and a 1px dotted inner focus frame.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <TextBlock x:Name="LinkText"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                   TextDecorations="Underline"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LinkText" Property="Foreground" Value="{DynamicResource FocusBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                <Setter Property="Margin" Value="0,0,5,5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="ChipRoot" MinHeight="22" Background="{DynamicResource PropertyItemBackgroundBrush}"
                                  SnapsToDevicePixels="True">
                                <Border x:Name="ChipHoverPlate" Background="{DynamicResource PropertyItemHoverBackgroundBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Visibility="Collapsed" IsHitTestVisible="False" />
                                <Control x:Name="ChipBevel" Template="{DynamicResource LocalRaisedBevelTemplate}" IsHitTestVisible="False" />
                                <Rectangle x:Name="ChipFocusDots" Margin="2" Stroke="{DynamicResource LocalFocusCyanBrush}"
                                           StrokeThickness="1" StrokeDashArray="1 1" Visibility="Collapsed" IsHitTestVisible="False" />
                                <TextBlock x:Name="ChipLabel" Margin="8,2,8,3"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipHoverPlate" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ChipFocusDots" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ChipLabel" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
