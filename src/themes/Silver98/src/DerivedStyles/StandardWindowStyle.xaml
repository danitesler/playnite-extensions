<!--
    Silver 98: DerivedStyles/StandardWindowStyle.xaml (Settings, Add-ons, Game Editor, every Playnite dialog).
    38px Windows 98 Active Title Bar Gradient (#000080 Navy -> #1084D0 Sky Blue, CaptionHeight=38,
    ContentPresenter Margin="0,38,0,0") inside a raised 2px 3D Win32 dialog frame, with the Classic CRT Computer
    BrandMarkTemplate icon, bold white title, ghosted CRT Computer watermark in a zero-desired-size Canvas,
    and raised 3D caption buttons (WindowBarButton).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="38" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" CornerRadius="0"
                                Background="{TemplateBinding Background}" Padding="3">
                            <Grid>
                                <!-- Outer 2px Win32 Raised 3D Dialog Frame -->
                                <Control Template="{DynamicResource LocalRaisedBevelTemplate}" Margin="-3" IsHitTestVisible="False" />

                                <ContentPresenter Margin="0,38,0,0" />

                                <!-- 36px Windows 98 Active Title Bar Gradient (#000080 -> #1084D0) -->
                                <Grid Height="36" VerticalAlignment="Top" ClipToBounds="True" SnapsToDevicePixels="True"
                                      Background="{DynamicResource WindowTitleBackgroundBrush}">
                                    <Rectangle Fill="{DynamicResource LocalCaptionGradientEndBrush}" IsHitTestVisible="False">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>

                                    <!-- Ghosted CRT Computer watermark in zero-desired-size Canvas (clear of caption buttons) -->
                                    <Canvas IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0">
                                        <Control Canvas.Left="-154" Canvas.Top="4" Width="28" Height="28"
                                                 Template="{DynamicResource BrandMarkTemplate}"
                                                 Foreground="{DynamicResource WindowTitleForegroundBrush}" Opacity="0.18" />
                                    </Canvas>

                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" Margin="2,0,0,0" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,10,0">
                                            <!-- Classic 16x16 CRT Computer System Menu Icon -->
                                            <Control Width="18" Height="18" Margin="0,0,8,0"
                                                     Template="{DynamicResource BrandMarkTemplate}"
                                                     Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                     IsHitTestVisible="False" />

                                            <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource FontFamily}"
                                                       FontSize="{DynamicResource FontSizeLarge}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter Property="Text" Value="{DynamicResource LOCSettingsLabel}" TargetName="PART_TextTitle" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
