<!--
    Silver 98: Constants.xaml template (Windows 95 and Windows 98 Classic UI inspired theme).
    scripts/build-theme.ps1 renders tokens.css placeholders into Constants.xaml.
    Classic #C0C0C0 3D silver chrome, 2px raised/sunken Win32 bevels, #FFFFFF sunken document client wells,
    #000080 -> #1084D0 active title bar gradient, #000080 navy selection bars, #FFFFE1 tooltips,
    #008080 Windows Desktop Teal running indicator, and Explorer 4.0 Web View 4-color accents.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Tahoma ships on every Windows desktop; Pixelify Sans bundled as static OFL TTF in Typography/) -->
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSize">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">19</sys:Double>
    <sys:Double x:Key="FontSizeLargest">30</sys:Double>
    <FontFamily x:Key="FontFamily">Tahoma, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Pixelify Sans, Pixelify Sans, Tahoma, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Game page metadata pane defaults (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape & radii: 0px sharp Win32 rectangular bevels; 9999 strictly for 1:1 circular radio/status dots -->
    <Thickness x:Key="PopupBorderThickness">2</Thickness>
    <Thickness x:Key="ControlBorderThickness">2</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:w98-radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:w98-radius-sm|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:w98-radius-lg|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{w98-text}}</Color>
    <Color x:Key="TextColorDarker">{{w98-text-muted}}</Color>
    <Color x:Key="TextColorDark">{{w98-text-invert}}</Color>
    <Color x:Key="MainColor">{{w98-face}}</Color>
    <Color x:Key="MainColorDark">{{w98-dither-well}}</Color>
    <Color x:Key="HoverColor">{{w98-face-hi}}</Color>
    <Color x:Key="GlyphColor">{{w98-navy}}</Color>
    <Color x:Key="HighlightGlyphColor">{{w98-title-blue-soft}}</Color>
    <Color x:Key="PopupBackgroundColor">{{w98-face}}</Color>
    <Color x:Key="PopupBorderColor">{{w98-bevel-dark}}</Color>
    <Color x:Key="BackgroundToneColor">{{w98-dither-well}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{w98-bevel-shadow}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{w98-bevel-shadow}}</Color>
    <Color x:Key="DataChangeNotifColor">{{w98-yellow-pip}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{w98-bevel-shadow}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{w98-tooltip-bg}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{w98-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{w98-bevel-dark}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{w98-face}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{w98-window}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{w98-green-pos}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{w98-danger}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{w98-amber-mix}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{w98-amber-mix}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{w98-face}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{w98-window}}" />

    <!-- Shell, Chrome & Game Page Brushes -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{w98-face}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{w98-face}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{w98-window}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{w98-window}}" />
    <!-- Banner darkening color: classic Win32 #C0C0C0 silver face so darkened banner blends into the shell -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{w98-face}}" />
    <!-- ScrimBrush: deep teal scrim darkening RunningIndicatorBrush plate so white text stays >= 7.5:1 -->
    <SolidColorBrush x:Key="ScrimBrush" Color="{{w98-teal-scrim}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{w98-face}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{w98-text}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{w98-window}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{w98-window}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{w98-bevel-shadow}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{w98-text-invert}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{w98-text}}" />

    <!-- Light-Theme Window Background Art Flip (crisp white text directly over dark/rich game art) -->
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{w98-text-invert}}" />

    <!-- Theme-local Win32 3D bevel, gradient & Explorer Web View tokens (prefixed with Local) -->
    <SolidColorBrush x:Key="LocalBevelHighlightBrush" Color="{{w98-bevel-highlight}}" />
    <SolidColorBrush x:Key="LocalBevelLightBrush" Color="{{w98-bevel-light}}" />
    <SolidColorBrush x:Key="LocalBevelShadowBrush" Color="{{w98-bevel-shadow}}" />
    <SolidColorBrush x:Key="LocalBevelDarkBrush" Color="{{w98-bevel-dark}}" />
    <SolidColorBrush x:Key="LocalFaceBrush" Color="{{w98-face}}" />
    <SolidColorBrush x:Key="LocalFaceHiBrush" Color="{{w98-face-hi}}" />
    <SolidColorBrush x:Key="LocalFacePressBrush" Color="{{w98-face-press}}" />
    <SolidColorBrush x:Key="LocalDitherWellBrush" Color="{{w98-dither-well}}" />
    <SolidColorBrush x:Key="LocalWindowBrush" Color="{{w98-window}}" />
    <SolidColorBrush x:Key="LocalWindowSoftBrush" Color="{{w98-window-soft}}" />
    <SolidColorBrush x:Key="LocalNavyBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="LocalCaptionGradientEndBrush" Color="{{w98-title-blue}}" />
    <SolidColorBrush x:Key="LocalFocusCyanBrush" Color="{{w98-focus-cyan}}" />
    <SolidColorBrush x:Key="LocalRunningHighlightBrush" Color="{{w98-teal-hi}}" />
    <SolidColorBrush x:Key="LocalWebRedBrush" Color="{{w98-web-red}}" />
    <SolidColorBrush x:Key="LocalWebYellowBrush" Color="{{w98-web-yellow}}" />
    <SolidColorBrush x:Key="LocalWebGreenBrush" Color="{{w98-web-green}}" />
    <SolidColorBrush x:Key="LocalWebBlueBrush" Color="{{w98-web-blue}}" />

    <!-- State Brushes: #000080 Navy selection bar + pure white text; #008080 Desktop Teal running state -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{w98-navy-hover}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{w98-title-blue}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{w98-text-invert}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{w98-row-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{w98-bevel-shadow}}" />
    <!-- Dedicated Windows 95/98 Desktop Teal (#008080) running indicator -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{w98-teal}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{w98-title-blue}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{w98-title-blue-halo}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{w98-danger}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{w98-text-invert}}" />

    <!-- Button Brushes: Primary Play CTA is Navy Default Push Button; secondary buttons are Raised 3D Silver -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{w98-text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{w98-face-hi}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{w98-face-press}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{w98-bevel-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{w98-navy-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{w98-navy-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{w98-bevel-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{w98-text-invert}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{w98-title-blue}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{w98-face}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{w98-bevel-dark}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{w98-face-hi}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{w98-face-press}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{w98-dither-well}}" />

    <!-- Input & Control Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{w98-window}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{w98-window}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{w98-bevel-shadow}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{w98-bevel-shadow}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{w98-navy-hover}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{w98-bevel-shadow}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{w98-face}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{w98-title-blue}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{w98-window}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{w98-face}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{w98-face-hi}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{w98-dither-well}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{w98-face}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{w98-face-hi}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{w98-text-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{w98-text}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{w98-navy}}" />
    <LinearGradientBrush x:Key="LocalWin98TitleGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{{w98-navy}}" Offset="0" />
        <GradientStop Color="{{w98-title-blue}}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LocalWin98TitleGradientVerticalBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="{{w98-navy}}" Offset="0" />
        <GradientStop Color="{{w98-title-blue}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{w98-title-blue}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{w98-face}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{w98-title-blue}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{w98-face-hi}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{w98-dither-well}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{w98-text}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{w98-face}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{w98-text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{w98-navy}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{w98-link}}" />
</ResourceDictionary>
