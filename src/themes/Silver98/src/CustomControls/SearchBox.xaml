<!--
    Silver 98: CustomControls/SearchBox.xaml.
    Sunken 2px 3D Win32 white search field (#FFFFFF) with persistent magnifier outside PART_SeachIcon
    (TextBrushDarker when empty/unfocused; GlyphBrush when focused or nonempty) and a raised 3D clear button
    on PART_ClearTextIcon with a full-hit transparent Border template.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Field" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Control Template="{DynamicResource LocalSunkenBevelTemplate}" IsHitTestVisible="False" />
                            <Border x:Name="FocusOutline" Margin="1" BorderBrush="Transparent" BorderThickness="1" IsHitTestVisible="False" />
                            <ContentControl x:Name="Glyph" Focusable="False" Content="{DynamicResource IconSearch}"
                                            ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{DynamicResource GlyphBrush}" Margin="8,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            IsHitTestVisible="False" Panel.ZIndex="1" />
                            <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                            <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     Padding="30,0,28,0" VerticalContentAlignment="Center" />
                            <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}"
                                            ContentTemplate="{DynamicResource IconSmallTemplate}"
                                            Foreground="{DynamicResource TextBrush}" Margin="0,0,4,0" Cursor="Hand"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ContentControl.Template>
                                    <ControlTemplate TargetType="ContentControl">
                                        <Border Background="Transparent" Padding="4">
                                            <ContentPresenter ContentSource="Content" />
                                        </Border>
                                    </ControlTemplate>
                                </ContentControl.Template>
                            </ContentControl>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusOutline" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusOutline" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TextInpuText" Property="Padding" Value="8,0,28,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
