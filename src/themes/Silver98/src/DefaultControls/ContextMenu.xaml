<!--
    Silver 98: DefaultControls/ContextMenu.xaml.
    Signature menu panel (LocalWin98MenuBoardTemplate) shared by ContextMenu, TopPanelMenu, submenus, and ComboBox lists:
    Classic Raised 3D Win32 silver menu board (#C0C0C0 with 2px #FFFFFF/#DFDFDF top-left highlight and #808080/#000000
    bottom-right shadow) paired with a vertical 6px Windows 98 Start-Menu Navy-to-Sky-Blue banner spine on the left.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Classic Windows 98 Raised 3D Menu Board Template (zero DropShadowEffect) -->
    <ControlTemplate x:Key="LocalWin98MenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource PopupBackgroundBrush}">
                <Grid>
                    <!-- Vertical 6px Windows 98 Start-Menu Navy-to-Blue spine along left inner edge -->
                    <Grid Width="6" Margin="2,2,0,2" HorizontalAlignment="Left">
                        <Rectangle Fill="{DynamicResource WindowTitleBackgroundBrush}" />
                        <Rectangle Fill="{DynamicResource LocalCaptionGradientEndBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                    <!-- Outer 2px Raised 3D Win32 Bevel -->
                    <Control Template="{DynamicResource LocalRaisedBevelTemplate}" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="MinWidth" Value="216" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalWin98MenuBoardTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ScrollViewer Margin="10,4,4,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle"
                                            Grid.IsSharedSizeScope="True" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
