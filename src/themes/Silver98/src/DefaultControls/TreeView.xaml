<!--
    Silver 98: DefaultControls/TreeView.xaml (Settings & Add-ons section list, Filter & Explorer trees).
    Minimal bare 28px Tahoma rows inside a sunken white SysTreeView32 pane:
    - Expander is a 16x16 host drawing the classic 11x11 Win95 [+] / [-] square box.
    - Hover fades #E4ECF7 hot-track blue wash (90ms).
    - Selected locks the classic #000080 Navy highlight bar + 2px #1084D0 left bar + 1px inner dotted cyan focus box + #FFFFFF label (140ms).
    - WindowSettings (252px) and WindowExtensions (276px) set InputBackgroundBrush (#FFFFFF) and reserve VerticalScrollBarVisibility=Visible.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Classic Win95/98 11x11 [+] / [-] Tree Expander Box (fixed 16x16 host) -->
    <Style x:Key="LocalTreeExpanderStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" Width="16" Height="16" SnapsToDevicePixels="True">
                        <Border x:Name="Box" Width="11" Height="11"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource LocalBevelShadowBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle x:Name="MinusBar" Width="5" Height="1" Fill="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle x:Name="PlusBar" Width="1" Height="5" Fill="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PlusBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Non-selectable Separator inside Settings tree -->
    <Style TargetType="{x:Type Separator}" x:Key="LocalTreeSeparatorStyle">
        <Setter Property="Tag" Value="TreeSeparator" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <StackPanel VerticalAlignment="Center">
                        <Border Height="1" Background="{DynamicResource LocalBevelShadowBrush}" />
                        <Border Height="1" Background="{DynamicResource LocalBevelHighlightBrush}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Padding" Value="6,0,8,0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Grid x:Name="RowGrid" MinHeight="28" Margin="0,0.5" Background="Transparent" SnapsToDevicePixels="True">
                            <!-- Hover wash (Collapsed at rest) -->
                            <Border x:Name="HoverPlate" Background="{DynamicResource ListItemHoverBrush}"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                            <!-- Selected #000080 Navy highlight bar + 2px #1084D0 left bar + dotted inner focus rim -->
                            <Border x:Name="SelectedPlate" Background="{DynamicResource ListItemSelectedBrush}"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                <Rectangle Margin="1" Stroke="{DynamicResource LocalFocusCyanBrush}" StrokeThickness="1"
                                           StrokeDashArray="1 1" Opacity="0.7" IsHitTestVisible="False" />
                            </Border>
                            <Rectangle x:Name="SelectedBar" Width="2" HorizontalAlignment="Left"
                                       Fill="{DynamicResource LocalCaptionGradientEndBrush}"
                                       Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Grid.Column="0" Width="16" Height="16"
                                              Style="{StaticResource LocalTreeExpanderStyle}"
                                              IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press" />
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="MaxWidth" Value="192" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Grid>

                        <ItemsPresenter x:Name="ItemsHost" Margin="18,0,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" SourceName="RowGrid" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeSelectIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeSelectOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding Header.Tag, RelativeSource={RelativeSource Self}}" Value="TreeSeparator">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter TargetName="RowGrid" Property="MinHeight" Value="8" />
                            <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="3,4,3,4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Style.Resources>
            <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource LocalTreeSeparatorStyle}" />
        </Style.Resources>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowSettings">
                <Setter Property="Width" Value="252" />
                <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalBevelShadowBrush}" />
                <Setter Property="BorderThickness" Value="0,0,2,0" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowExtensions">
                <Setter Property="Width" Value="276" />
                <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalBevelShadowBrush}" />
                <Setter Property="BorderThickness" Value="0,0,2,0" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
