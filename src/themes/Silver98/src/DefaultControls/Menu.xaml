<!--
    Silver 98: DefaultControls/Menu.xaml.
    Menus signature levers (docs/themes/menus.md):
    - Panel: LocalWin98MenuBoardTemplate (raised 2px 3D #C0C0C0 Win32 menu board with a vertical 6px Windows 98
      Navy-to-Blue Start-Menu banner spine along the left inner edge).
    - Highlight: 28px rows; full-bleed #000080 Navy selection bar fades/snaps in (90ms CubicEase) with a 1px
      inner dotted cyan focus frame, flipping label, shortcut, and Icon (TextElement.Foreground on TargetName="Icon")
      to crisp #FFFFFF white (16:1 contrast).
    - Group break: Classic 2px Win32 etched separator (1px #808080 shadow over 1px #FFFFFF highlight) in an 8px row.
    - Shortcuts: Right-aligned bare Win32 accelerator text (Tahoma/Consolas, #4A4A4A at rest, #FFFFFF on highlight).
    - Submenu mark: 4x7 Win32 pixel right triangle (IconSubmenu), #000000 at rest, #FFFFFF on highlight.
    - Marked rows: Exit (Alt+Q) wears #A80000 crimson label at rest and highlights with a solid #A80000 danger bar +
      white dotted focus frame + #FFFFFF text (8.2:1); checked rows draw a 14x14 sunken 3D check box well with a bold
      pixel checkmark (IconCheck).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group Break: Classic Win32 2px Etched Separator (#808080 over #FFFFFF) -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="4,0,4,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <StackPanel Height="8" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border Height="1" Margin="0,3,0,0" Background="{DynamicResource LocalBevelShadowBrush}" />
                        <Border Height="1" Background="{DynamicResource LocalBevelHighlightBrush}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SubmenuItem (plain leaf row, 28px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="28" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Classic #000080 Navy Selection Bar + 1px Dotted Inner Focus Frame -->
            <Grid x:Name="HighlightPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border x:Name="HighlightFill" Background="{DynamicResource MenuItemHoverBrush}" />
                <Rectangle x:Name="HighlightDots" Margin="1" Stroke="{DynamicResource LocalFocusCyanBrush}"
                           StrokeThickness="1" StrokeDashArray="1 1" Opacity="0.65" />
            </Grid>

            <Grid Margin="6,0,6,0">
                <Grid.ColumnDefinitions>
                    <!-- Fixed icon column (16px icon + 8px gap = 24px) -->
                    <ColumnDefinition Width="24" />
                    <!-- Plain * label column (never SharedSizeGroup on star column) -->
                    <ColumnDefinition Width="*" />
                    <!-- Shared shortcut column flush right -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                    <!-- Arrow spacer column matching SubmenuHeader -->
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <!-- 16x16 Colored Pixel Icon or Sunken 3D Win32 Check Box -->
                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" TextElement.Foreground="{DynamicResource TextBrush}" />

                <Grid x:Name="CheckBoxMark" Grid.Column="0" Width="15" Height="15"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Visibility="Collapsed" IsHitTestVisible="False">
                    <Border Background="{DynamicResource LocalDitherWellBrush}" />
                    <Control Template="{DynamicResource LocalThinSunkenBevelTemplate}" />
                    <ContentControl x:Name="CheckGlyph" Width="10" Height="10"
                                    Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                    Foreground="{DynamicResource TextBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Label -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{DynamicResource TextBrush}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Authentic Bare Right-Aligned Win32 Accelerator Text -->
                <Border x:Name="ShortcutCap" Grid.Column="2" Margin="16,0,2,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent">
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource FontFamily}" FontSize="12"
                               Foreground="{DynamicResource TextBrushDarker}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutCap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutCap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckBoxMark" Property="Visibility" Value="Visible" />
            </Trigger>

            <!-- Exit at rest: Classic Win98 Stop Crimson label & accelerator -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Trigger>

            <!-- Standard Highlight: #000080 Navy selection bar + white text, icon & accelerator -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuItemHighlightIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuItemHighlightOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Exit Highlight: Solid #A80000 Crimson bar + white dotted focus frame + white text (8.2:1) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HighlightFill" Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="HighlightDots" Property="Stroke" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeader (row opening a child popup submenu, 28px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="28" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held #000080 Navy plate while submenu is open -->
            <Border x:Name="OpenPlate" Background="{DynamicResource MenuItemHoverBrush}"
                    Visibility="Collapsed" IsHitTestVisible="False" />

            <!-- Animated #000080 Navy highlight bar -->
            <Grid x:Name="HighlightPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border Background="{DynamicResource MenuItemHoverBrush}" />
                <Rectangle Margin="1" Stroke="{DynamicResource LocalFocusCyanBrush}"
                           StrokeThickness="1" StrokeDashArray="1 1" Opacity="0.65" />
            </Grid>

            <Grid Margin="6,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" TextElement.Foreground="{DynamicResource TextBrush}" />

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{DynamicResource TextBrush}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <ContentControl x:Name="SubArrow" Grid.Column="3" Width="10" Height="10"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource TextBrush}" IsHitTestVisible="False" />
            </Grid>

            <Popup x:Name="Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-4"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade">
                <Grid MinWidth="204" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalWin98MenuBoardTemplate}"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    <ScrollViewer Margin="10,4,4,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubHeaderHighlightIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubHeaderHighlightOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
