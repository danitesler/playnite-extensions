<!--
    Silver 98: DefaultControls/GroupBox.xaml.
    Content-sized classic Win32 Etched GroupBox card (zero fixed widths >= 200 so Playnite's Statistics sections wrap cleanly).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True" Padding="2">
                        <Grid ClipToBounds="True">
                            <!-- Classic Win32 2px Etched Frame (#808080 outer, #FFFFFF inner) -->
                            <Border BorderBrush="{DynamicResource LocalBevelShadowBrush}" BorderThickness="1" />
                            <Border Margin="1" BorderBrush="{DynamicResource LocalBevelHighlightBrush}" BorderThickness="1" />
                            <DockPanel Margin="2">
                                <!-- Active Navy Title Strip Header -->
                                <Grid DockPanel.Dock="Top">
                                    <Border Background="{DynamicResource WindowTitleBackgroundBrush}" />
                                    <Rectangle Fill="{DynamicResource LocalCaptionGradientEndBrush}" IsHitTestVisible="False">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <StackPanel Orientation="Horizontal" Margin="8,5">
                                        <Control Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Template="{DynamicResource LocalFolderIconTemplate}" />
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                          TextElement.FontFamily="{DynamicResource FontFamily}"
                                                          TextElement.FontSize="{DynamicResource FontSize}"
                                                          TextElement.FontWeight="Bold"
                                                          TextElement.Foreground="{DynamicResource WindowTitleForegroundBrush}" />
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
