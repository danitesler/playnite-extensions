<!--
    Silver 98: DefaultControls/Button.xaml.
    32px (ControlHeight) Raised 2px 3D Win32 command buttons (#C0C0C0 face, #FFFFFF/#DFDFDF top-left highlight,
    #808080/#000000 bottom-right shadow). Default/Primary buttons (IsDefault=True) add the outer 1px #000000
    BS_DEFPUSHBUTTON keyline and 1px inner dotted black focus rectangle.
    Pressing a button flips the bevel to sunken and shifts the content 1px right and 1px down.
    Includes mandatory ThemeModifier Width==41 square proportional scale trigger (32/41 = 0.7804878048780488).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="OuterDefaultKeyline" BorderBrush="Transparent" BorderThickness="0"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="HoverOverlay" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressOverlay" Background="{DynamicResource ButtonPressedBackgroundBrush}"
                                    Visibility="Collapsed" IsHitTestVisible="False" />

                            <Control x:Name="RaisedBevel" Template="{DynamicResource LocalRaisedBevelTemplate}" IsHitTestVisible="False" />
                            <Control x:Name="SunkenBevel" Template="{DynamicResource LocalSunkenBevelTemplate}"
                                     Visibility="Collapsed" IsHitTestVisible="False" />

                            <!-- Classic Win32 1px Dotted Inner Focus Rectangle -->
                            <Rectangle x:Name="FocusDots" Margin="4" Stroke="{DynamicResource TextBrush}"
                                       StrokeThickness="1" StrokeDashArray="1 1"
                                       Visibility="Collapsed" IsHitTestVisible="False" />

                            <ContentPresenter x:Name="ContentHost" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="PressShift" X="0" Y="0" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Win32 Default Push Button (BS_DEFPUSHBUTTON): 1px black outer ring + bold text + dotted inner focus box -->
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="OuterDefaultKeyline" Property="BorderBrush" Value="{DynamicResource LocalBevelDarkBrush}" />
                            <Setter TargetName="OuterDefaultKeyline" Property="BorderThickness" Value="1" />
                            <Setter TargetName="FocusDots" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusDots" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BtnHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="BtnHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressOverlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RaisedBevel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SunkenBevel" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BtnPressIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="X" To="1" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="BtnPressIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="{x:Static sys:Double.NaN}">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <!-- ThemeModifier icon-button 41px -> 32x32 uniform proportional scale trigger -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SimpleButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Background="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Control Template="{DynamicResource LocalThinRaisedBevelTemplate}" />
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SimpleHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SimpleHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
