<!--
    Silver 98: DefaultControls/TabControl.xaml.
    Classic Win32 Property Sheet Tabs (SysTabControl32): raised 2px 3D silver tabs that step up and bold when selected.
    TabItemColors rule: TabItem keeps Foreground=TextBrush so child edit-dialog labels stay readable; idle/hover/selected
    text colors are set strictly on HeaderText (TextBlock wrapping ContentPresenter ContentSource="Header").
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="Root" Margin="0,2,2,0" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="TabPlate" Background="{DynamicResource TabControlHeaderBackgroundBrush}" />
                        <Border x:Name="HoverPlate" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Grid x:Name="SelectedPlate" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border Background="{DynamicResource ButtonBackgroundBrush}" />
                            <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource TabItemIndicatorBrush}" />
                        </Grid>
                        <Control Template="{DynamicResource LocalRaisedBevelTemplate}" IsHitTestVisible="False" />
                        <Rectangle x:Name="FocusDots" Margin="4" Stroke="{DynamicResource TextBrush}"
                                   StrokeThickness="1" StrokeDashArray="1 1"
                                   Visibility="Collapsed" IsHitTestVisible="False" />
                        <TextBlock x:Name="HeaderText" Margin="{TemplateBinding Padding}"
                                   FontFamily="{DynamicResource FontFamily}"
                                   FontSize="{DynamicResource FontSize}"
                                   Foreground="{DynamicResource TabItemForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TabHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TabHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Margin" Value="0,0,2,-1" />
                            <Setter TargetName="SelectedPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusDots" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="HeaderText" Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <TabPanel x:Name="HeaderPanel" DockPanel.Dock="Top" IsItemsHost="True" Panel.ZIndex="1" Margin="0,0,0,0" />
                        <Border x:Name="ContentPanel" Background="{TemplateBinding Background}" Padding="10"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                            <Grid>
                                <Control Template="{DynamicResource LocalRaisedBevelTemplate}" Margin="-10" IsHitTestVisible="False" />
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
