<!--
    Bliss XP: Common.xaml.
    Shared spacing, ControlHeight (32px), GameBannerHeight (320px), GameBannerDarken (0),
    PopupBorder, FocusVisual, LocalBlissXpBrandMarkTemplate, and LocalBlissXpMenuMarkTemplate
    (animated Bliss Hilltop-Window mark for PART_ElemMainMenu in Sidebar and TopPanel).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared spacing & metrics -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <Thickness x:Key="ButtonPadding">12,5</Thickness>
    <Thickness x:Key="InputPadding">8,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">8,4</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,4</Thickness>
    <Thickness x:Key="ListBoxItemPadding">8,5</Thickness>
    <Thickness x:Key="GroupBoxPadding">12,10</Thickness>
    <Thickness x:Key="TooltipPadding">8,5</Thickness>

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}"
                               StrokeThickness="1" StrokeDashArray="1 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Static Bliss Hilltop-Window Brand Mark (Settings title bar, Empty state) -->
    <ControlTemplate x:Key="LocalBlissXpBrandMarkTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Border Canvas.Left="2" Canvas.Top="3" Width="20" Height="18" CornerRadius="3.5"
                        Background="#30FFFFFF" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.8" />
                <Ellipse Canvas.Left="5.5" Canvas.Top="6" Width="4.4" Height="4.4"
                         Fill="{DynamicResource LocalXpOrangeLightBrush}" />
                <Path Data="M3.5,16.5 C7.5,11.5 13.5,11.5 20.5,15.5 L20.5,19.5 L3.5,19.5 Z"
                      Fill="{TemplateBinding Foreground}" Opacity="0.92" />
                <Path Data="M9.5,18 C13,14.5 16.5,14.5 20.5,17 L20.5,19.5 L9.5,19.5 Z"
                      Fill="{DynamicResource LocalXpGreenGlossBrush}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!--
        Main Menu Mark (docs/themes/menu-mark.md):
        Custom animated Bliss Hilltop-Window mark inside PART_ElemMainMenu (Sidebar & TopPanel).
        - Rest: calm crisp white-framed hilltop horizon with golden sun and green meadow wave.
        - Hover (IsMouseOver on Control): golden sun rises 1.5px and Luna Orange inner rim illuminates (180ms CubicEase).
        - Open (ContextMenu.IsOpen on ancestor Border): separate OpenHalo & HillWave gently breathe (2.4s Forever),
          cleanly reset by ExitActions covering every animated property.
    -->
    <ControlTemplate x:Key="LocalBlissXpMenuMarkTemplate" TargetType="{x:Type Control}">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <!-- Hover-only warm Luna Orange inner ring (separate element from Open state) -->
            <Border x:Name="HoverRim" Margin="2" CornerRadius="4"
                    BorderBrush="{DynamicResource LocalXpOrangeBrush}" BorderThickness="2"
                    Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

            <!-- Open-only engaged ring (separate element from Hover state) -->
            <Border x:Name="OpenRim" Margin="2" CornerRadius="4"
                    BorderBrush="{DynamicResource LocalXpOrangeLightBrush}" BorderThickness="2"
                    Background="#24FFFFFF" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

            <Viewbox Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="24" Height="24">
                    <!-- Outer Horizon Window Frame -->
                    <Border Canvas.Left="2" Canvas.Top="3" Width="20" Height="18" CornerRadius="3.5"
                            Background="#24FFFFFF" BorderBrush="{DynamicResource MainMenuButtonForegroundBrush}" BorderThickness="1.8" />

                    <!-- Hover-animated Sun Orb (separate element) -->
                    <Ellipse x:Name="SunOrb" Canvas.Left="5.8" Canvas.Top="6.2" Width="4.6" Height="4.6"
                             Fill="{DynamicResource LocalXpOrangeLightBrush}">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="SunLift" Y="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Back Meadow Hill -->
                    <Path Data="M3.5,16.5 C7.5,11.5 13.5,11.5 20.5,15.5 L20.5,19.5 L3.5,19.5 Z"
                          Fill="{DynamicResource MainMenuButtonForegroundBrush}" Opacity="0.92" />

                    <!-- Open-animated Foreground Bliss Hill (separate element) -->
                    <Path x:Name="FrontHill" Data="M9.2,18 C13,14.2 16.6,14.2 20.5,16.8 L20.5,19.5 L9.2,19.5 Z"
                          Fill="{DynamicResource LocalXpGreenGlossBrush}" RenderTransformOrigin="0.5,1">
                        <Path.RenderTransform>
                            <ScaleTransform x:Name="HillScale" ScaleX="1" ScaleY="1" />
                        </Path.RenderTransform>
                    </Path>
                </Canvas>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MarkHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SunLift" Storyboard.TargetProperty="Y" To="-1.4" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MarkHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="SunLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="MarkOpenIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OpenRim" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="OpenRim" Storyboard.TargetProperty="Opacity"
                                             From="0.65" To="1.0" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="HillScale" Storyboard.TargetProperty="ScaleY"
                                             From="1.0" To="1.18" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard x:Name="MarkOpenOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="OpenRim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="HillScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OpenRim" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
