<!--
    Bliss XP: Views/Sidebar.xaml.
    44px Glossy Luna Royal Blue vertical taskbar rail closed by a #00138C edge rule,
    crowned by the Grass Green Start PART_ElemMainMenu tile hosting LocalBlissXpMenuMarkTemplate.
    Turns transparent when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <!-- Glossy Luna Royal Blue vertical rail sheen -->
                            <Border x:Name="RailGloss" Background="{DynamicResource LocalXpRailBrush}" IsHitTestVisible="False" />

                            <DockPanel x:Name="DockContentHolder">
                                <!-- Glossy Grass Green Start Button (PART_ElemMainMenu) -->
                                <Border x:Name="PART_ElemMainMenu" Background="{DynamicResource LocalXpStartGreenBrush}"
                                        BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="0,0,0,1"
                                        Width="44" Height="48" Margin="0,0,0,4"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Border x:Name="StartGloss" Height="14" VerticalAlignment="Top" Margin="3,2,3,0"
                                                CornerRadius="5,5,2,2" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#66FFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Control Template="{DynamicResource LocalBlissXpMenuMarkTemplate}"
                                                 Focusable="False" IsTabStop="False" />
                                    </Grid>
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>

                            <!-- Right crisp Luna navy seam -->
                            <Border x:Name="EdgeRule" Width="1" HorizontalAlignment="Right"
                                    Background="{DynamicResource LocalXpBlueEdgeBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailGloss" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,108,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
