<!--
    Bliss XP: DerivedStyles/GridViewItemTemplate.xaml.
    Grid cover hover controls: 50x50 (>= 48x48 mandate) glossy XP Grass Green Play orb &
    Luna Royal Blue Info orb (GridTileButton) with whole-button transparent hit area and
    Luna Orange hover ring.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridTileButton" TargetType="Button">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Background" Value="{DynamicResource LocalXpTitleBarBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SelectedForegroundBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Orb" CornerRadius="25"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border Height="18" VerticalAlignment="Top" Margin="5,2,5,0" CornerRadius="14,14,4,4" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#66FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="OrangeGlow" CornerRadius="25" BorderBrush="{DynamicResource LocalXpOrangeBrush}"
                                        BorderThickness="2.5" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TileHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OrangeGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="OrangeGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TileHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="OrangeGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OrangeGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Grid>
                        <StackPanel>
                            <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}">
                                <Border x:Name="CoverClip" CornerRadius="3" ClipToBounds="True" Background="{DynamicResource NormalBrush}">
                                    <Grid>
                                        <Image x:Name="PART_ImageCover" RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="{Settings CoverArtStretch}" />
                                        <Border x:Name="HoverScrim" Background="#8800138C" Visibility="Collapsed" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>

                                <!-- 50x50 Glossy XP Play & Info Overlay Buttons -->
                                <StackPanel x:Name="HoverButtons" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Button x:Name="PART_ButtonPlay" Style="{DynamicResource GridTileButton}"
                                            Background="{DynamicResource LocalXpStartGreenBrush}">
                                        <ContentControl Width="20" Height="20" Content="{DynamicResource IconPlay}"
                                                        ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource SelectedForegroundBrush}" />
                                    </Button>
                                    <Button x:Name="PART_ButtonInfo" Style="{DynamicResource GridTileButton}">
                                        <ContentControl Width="20" Height="20" Content="{DynamicResource IconInfo}"
                                                        ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource SelectedForegroundBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="PART_TextName" Text="{Binding DisplayName}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Margin="2,5,2,2" Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="{DynamicResource IconDownload}" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="HoverScrim" />
                            <Setter Property="Visibility" Value="Visible" TargetName="HoverButtons" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" TargetName="PART_TextName" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
