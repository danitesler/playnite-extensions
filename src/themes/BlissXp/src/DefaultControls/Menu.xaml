<!--
    Bliss XP: DefaultControls/Menu.xaml.
    Unified Windows XP Luna menu rows (30px height):
    - Highlight: glossy #316AC5 Royal Blue bar with 3px #F8B330 Luna Orange left pip fading in over 100ms.
    - Group break: 9px break with #D6DFEE hairline from label column led by 14px #7BA2E7 periwinkle dash.
    - Icons: 32-bit XP PNGs in fixed 26px column; TextElement.Foreground on Icon flips white on highlight.
    - Shortcuts: right-aligned Tahoma muted slate turning white on highlight.
    - Submenu mark: 5x8 XP right chevron (#215DC6 at rest, #FFFFFF on highlight/open).
    - Marked rows: Alt+Q Exit in glossy coral-red danger style (>= 5.5:1); checked rows draw rounded #ECE9D8
      box with #003C74 rim and vivid Grass Green checkmark (white on highlight).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group break (9px tall, periwinkle lead dash + hairline) -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="9" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="9" Margin="28,0,6,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource MenuSeparatorBrush}" />
                        <Border Height="2" Width="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="1" Background="{DynamicResource LocalXpTaskBorderBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SubmenuItemTemplateKey (plain row, 30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="Root" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated Luna Royal Blue highlight plate + 3px Luna Orange left pip -->
            <Border x:Name="HighlightPlate" CornerRadius="2" Margin="1,1"
                    Background="{DynamicResource MenuItemHoverBrush}"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border x:Name="HighlightPip" Width="3" Margin="0,3,0,3" HorizontalAlignment="Left"
                        CornerRadius="0,2,2,0" Background="{DynamicResource LocalXpOrangeBrush}" />
            </Border>

            <!-- Danger highlight plate for Exit (Alt+Q) -->
            <Border x:Name="DangerPlate" CornerRadius="2" Margin="1,1"
                    Background="{DynamicResource LocalXpCloseRedBrush}"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

            <Grid Margin="6,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <!-- Fixed 26px Icon / Check column -->
                <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="18" Height="18">
                    <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource TextBrush}" />
                    <Border x:Name="CheckBoxPlate" Width="14" Height="14" CornerRadius="2"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <ContentControl x:Name="CheckMark" Width="10" Height="10"
                                        Content="{DynamicResource IconCheck}"
                                        ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{DynamicResource LocalXpGreenCheckBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Label (plain * column, CharacterEllipsis) -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Shortcut -->
                <TextBlock x:Name="ShortcutText" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                           Margin="14,0,0,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextBrushDarker}" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="ShortcutText" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="ShortcutText" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
                <Setter Property="Visibility" Value="Visible" TargetName="CheckBoxPlate" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" TargetName="ShortcutText" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="ShortcutText" />
                <Setter Property="Background" Value="{DynamicResource LocalXpBlueDarkBrush}" TargetName="CheckBoxPlate" />
                <Setter Property="BorderBrush" Value="{DynamicResource SelectedForegroundBrush}" TargetName="CheckBoxPlate" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="CheckMark" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" TargetName="HighlightPlate" />
                <Setter Property="Visibility" Value="Visible" TargetName="DangerPlate" />
                <Setter Property="Opacity" Value="1" TargetName="DangerPlate" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="ShortcutText" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="Root" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeaderTemplateKey (row with submenu popup, 30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="Root" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held open plate -->
            <Border x:Name="OpenPlate" CornerRadius="2" Margin="1,1"
                    Background="{DynamicResource MenuItemHoverBrush}"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border Width="3" Margin="0,3,0,3" HorizontalAlignment="Left"
                        CornerRadius="0,2,2,0" Background="{DynamicResource LocalXpOrangeBrush}" />
            </Border>

            <!-- Animated hover plate -->
            <Border x:Name="HighlightPlate" CornerRadius="2" Margin="1,1"
                    Background="{DynamicResource MenuItemHoverBrush}"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border Width="3" Margin="0,3,0,3" HorizontalAlignment="Left"
                        CornerRadius="0,2,2,0" Background="{DynamicResource LocalXpOrangeBrush}" />
            </Border>

            <Grid Margin="6,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="18" Height="18">
                    <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource TextBrush}" />
                </Grid>

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <ContentControl x:Name="SubArrow" Grid.Column="3" Width="10" Height="10"
                                Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource LocalXpTaskLinkBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   Placement="Right" HorizontalOffset="-2" VerticalOffset="-4"
                   PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
                <Grid Grid.IsSharedSizeScope="True" MinWidth="200" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalBlissXpMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="8,4,4,4" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="OpenPlate" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="SubArrow" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="SubArrow" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="Root" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
