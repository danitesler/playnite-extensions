<!--
    Bliss XP: DefaultControls/GroupBox.xaml.
    Windows XP Luna rounded GroupBox with #215DC6 Explorer Blue header and clean #D6D2C2 hairline.
    Stays content-sized (no wide child >= 200px).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalXpBeigeLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{DynamicResource NormalBrushDark}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CornerRadiusLarge}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="10,6"
                                    CornerRadius="4,4,0,0"
                                    Background="{DynamicResource LocalXpTaskHeaderBrush}"
                                    BorderBrush="{DynamicResource LocalXpBeigeLineBrush}" BorderThickness="0,0,0,1">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  TextElement.Foreground="{DynamicResource HeaderBandForegroundBrush}"
                                                  TextElement.FontWeight="Bold" />
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
