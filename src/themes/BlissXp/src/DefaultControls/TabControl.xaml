<!--
    Bliss XP: DefaultControls/TabControl.xaml.
    Windows XP Luna Display Properties Tabs: raised #FFFFFF active tab crowned by a 2px #F8B330 Luna Orange top cap.
    Keeps Foreground="{DynamicResource TextBrush}" on TabItem and styles HeaderText via TargetName.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="TabBorder" CornerRadius="4,4,0,0"
                                Background="{DynamicResource LocalXpButtonFaceBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0"
                                Margin="0,2,0,0">
                            <Grid>
                                <!-- 2px Luna Orange cap on selected/hovered tab -->
                                <Border x:Name="OrangeCap" Height="2" VerticalAlignment="Top"
                                        CornerRadius="3,3,0,0" Background="{DynamicResource TabItemIndicatorBrush}"
                                        Visibility="Collapsed" IsHitTestVisible="False" />
                                <TextBlock x:Name="HeaderText" Margin="{TemplateBinding Padding}"
                                           Foreground="{DynamicResource TabItemForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="OrangeCap" />
                            <Setter Property="Background" Value="{DynamicResource TabItemHoverIndicatorBrush}" TargetName="OrangeCap" />
                            <Setter Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" TargetName="HeaderText" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="2" />
                            <Setter Property="Margin" Value="0,0,0,-1" TargetName="TabBorder" />
                            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" TargetName="TabBorder" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" TargetName="TabBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="OrangeCap" />
                            <Setter Property="Background" Value="{DynamicResource TabItemIndicatorBrush}" TargetName="OrangeCap" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalXpTaskLinkBrush}" TargetName="HeaderText" />
                            <Setter Property="FontWeight" Value="Bold" TargetName="HeaderText" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel" Grid.Row="0" Panel.ZIndex="1" IsItemsHost="True"
                                  Margin="4,0,4,0" Background="Transparent" />
                        <Border x:Name="ContentPanel" Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
