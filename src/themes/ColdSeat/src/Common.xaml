<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Cold Seat spacing and focus. The game lays its glue buttons out on 0.035 screen-height plates with
        0.002 text offsets; here that becomes 32px plates (a 4px iron frame around a 24px blue plate): 14,4 buttons,
        8,4 inputs, 8,5 menu items.
    -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" StrokeThickness="1" Stroke="{DynamicResource FocusBrush}" StrokeDashArray="1 2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Thickness x:Key="ButtonPadding">14,4,14,4</Thickness>
    <Thickness x:Key="InputPadding">8,4,8,4</Thickness>
    <Thickness x:Key="MenuPadding">3</Thickness>
    <Thickness x:Key="MenuItemPadding">8,5,8,5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">3</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,5,8,5</Thickness>
    <Thickness x:Key="ListBoxItemPadding">8,5,8,5</Thickness>
    <Thickness x:Key="GroupBoxPadding">12</Thickness>
    <Thickness x:Key="TooltipPadding">10,6,10,6</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>

    <!-- Default banner height (ThemeModifier edits it, 0 = off). -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Forged iron plate: a black groove, the iron band lit on its top/left and dark on its bottom/right. Used for bands and
         small plates. Host sets Background (the iron), BorderBrush (outer groove) and BorderThickness. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="{x:Type Control}">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
            <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelLightBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BevelShadowBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" />
                </Border>
            </Border>
        </Border>
    </ControlTemplate>

    <!-- The glue button plate of the menus: a 3px iron frame between black grooves around a deep blue plate whose top and
         left edges are lit and whose upper third carries a blue sheen. Host: a Control with hit testing off, behind the
         content. Background = plate fill, BorderBrush = the lit blue. The plate starts 4px inside the bounds. -->
    <ControlTemplate x:Key="FramedPlateTemplate" TargetType="{x:Type Control}">
        <Border Background="{DynamicResource FrameBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
            <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelLightBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}">
                <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BevelShadowBrush}" Padding="1,1,0,0" CornerRadius="{DynamicResource CornerRadiusSmall}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1">
                        <Grid>
                            <Rectangle Fill="{TemplateBinding BorderBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#D9000000" />
                                        <GradientStop Offset="0.18" Color="#59000000" />
                                        <GradientStop Offset="0.5" Color="#00000000" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Border BorderThickness="1,1,0,0" BorderBrush="{TemplateBinding BorderBrush}" />
                            <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource FrameInnerBrush}" Opacity="0.55" />
                        </Grid>
                    </Border>
                </Border>
            </Border>
        </Border>
    </ControlTemplate>

    <!-- Rivets and bevel of a panel frame. The panel itself is two Borders (an 8px iron band between black grooves around the
         panel glass); this overlay sits over the band in the same cell: lit top/left, dark bottom/right, and a rivet in each
         corner and at the middle of the top and bottom rails. No desired size of its own, so a framed card stays content-sized. -->
    <ControlTemplate x:Key="RivetsTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Margin="1" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelLightBrush}" Opacity="0.8" />
            <Border Margin="1" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BevelShadowBrush}" />
            <Ellipse Width="4" Height="4" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.5" />
            <Ellipse Width="4" Height="4" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.5" />
            <Ellipse Width="4" Height="4" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.5" />
            <Ellipse Width="4" Height="4" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.5" />
            <Ellipse Width="4" Height="4" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.5" />
            <Ellipse Width="4" Height="4" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.5" />
        </Grid>
    </ControlTemplate>

    <!-- Scalable bloom: glow-frame.png (a 128px ring, 9-slice 44 / 40 / 44) filled with the host's Foreground brush, so
         ThemeModifier recolors it. Host: a Control at a negative margin equal to the bloom width (the sprite falls off over
         30px outward), hit testing off. Fixed corner cells only, so a host stays content-sized. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,84,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Empty game page (no game selected), the Warcraft III way: a small riveted iron panel on the night (the lobby "no
         games" plate) with a gold diamond that breathes while the page is visible, a rule and the localized message in
         menu gold. Host: a Control that is Collapsed unless its DataContext is null. Idle loop animates Opacity only. -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="{x:Type Control}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Control Template="{DynamicResource RivetsTemplate}" Focusable="False" IsTabStop="False" Panel.ZIndex="1" />
            <Border BorderThickness="1" BorderBrush="{DynamicResource FrameInnerBrush}" Background="{DynamicResource FrameBrush}" Padding="8" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border BorderThickness="1" BorderBrush="{DynamicResource FrameInnerBrush}" Background="{DynamicResource ExpanderBackgroundBrush}" Padding="40,28,40,26">
                    <StackPanel HorizontalAlignment="Center" MinWidth="160">
                        <Grid Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Polygon Points="22,1 43,22 22,43 1,22" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5" Fill="{DynamicResource FrameInnerBrush}" Opacity="0.9" />
                            <Polygon Points="22,9 35,22 22,35 9,22" Stroke="{DynamicResource BevelLightBrush}" StrokeThickness="1" />
                            <Polygon x:Name="Gem" Points="22,15 29,22 22,29 15,22" Fill="{DynamicResource GlyphBrush}" />
                        </Grid>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BevelShadowBrush}" Margin="0,0,0,12">
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" />
                        </Border>
                        <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" TextAlignment="Center" TextWrapping="Wrap"
                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                   Foreground="{DynamicResource HeadingForegroundBrush}">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="2" Opacity="0.9" RenderingBias="Quality" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="GemPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Gem" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.6" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="GemPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
