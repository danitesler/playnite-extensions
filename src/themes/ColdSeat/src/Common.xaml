<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Cold Seat spacing and focus. The game lays its glue buttons out on 0.035 screen-height plates with
        0.002 text offsets; here that becomes compact stone plates: 14,6 buttons, 8,5 inputs, 6,4 menu items.
    -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" StrokeThickness="1" Stroke="{DynamicResource FocusBrush}" StrokeDashArray="1 2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Thickness x:Key="ButtonPadding">14,6,14,6</Thickness>
    <Thickness x:Key="InputPadding">8,5,8,5</Thickness>
    <Thickness x:Key="MenuPadding">3</Thickness>
    <Thickness x:Key="MenuItemPadding">8,5,8,5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">3</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,5,8,5</Thickness>
    <Thickness x:Key="ListBoxItemPadding">8,5,8,5</Thickness>
    <Thickness x:Key="GroupBoxPadding">12</Thickness>
    <Thickness x:Key="TooltipPadding">10,6,10,6</Thickness>
    <sys:Double x:Key="IconSize">16</sys:Double>

    <!-- Default banner height (ThemeModifier edits it, 0 = off). -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">330</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Plate with a lit top/left edge and a dark bottom/right edge, like the game's stone button plates.
         Host sets Background, BorderBrush (outer rim) and BorderThickness. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="{x:Type Control}">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
            <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelLightBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BevelShadowBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" />
                </Border>
            </Border>
        </Border>
    </ControlTemplate>

    <!-- Scalable bloom: glow-frame.png (a 128px ring, 9-slice 44 / 40 / 44) filled with the host's Foreground brush, so
         ThemeModifier recolors it. Host: a Control at a negative margin equal to the bloom width (the sprite falls off over
         30px outward), hit testing off. Fixed corner cells only, so a host stays content-sized. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,84,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
