<!--
    ColdSeat: gives Playnite's filter dropdowns the shared field height (ControlHeight), so it lines up with text boxes and buttons.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type FilterEnumSelectionBox}" BasedOn="{StaticResource {x:Type FilterEnumSelectionBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
    <Style TargetType="{x:Type FilterStringSelectionBox}" BasedOn="{StaticResource {x:Type FilterStringSelectionBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
    <Style TargetType="{x:Type FilterSelectionBox}" BasedOn="{StaticResource {x:Type FilterSelectionBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
</ResourceDictionary>
