<!--
    Cold Seat GroupBox: a menu panel (Sound Options, the lobby panels). An 8px forged iron band between black grooves, riveted
    at the corners and the middle of the top and bottom rails (RivetsTemplate, no desired size), around the panel glass
    (ExpanderBackgroundBrush); HeadingFontFamily gold header over a MenuSeparatorBrush rule. Content-sized: no fixed widths.
    Padding GroupBoxPadding.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource FrameInnerBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource FrameBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Border Margin="8" BorderThickness="1" BorderBrush="{DynamicResource FrameInnerBrush}" Background="{TemplateBinding Background}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MenuSeparatorBrush}">
                                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}" Margin="{TemplateBinding Padding}"
                                               FontFamily="{DynamicResource HeadingFontFamily}" Foreground="{DynamicResource HeadingForegroundBrush}">
                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                          RecognizesAccessKey="True" />
                                    </TextBlock>
                                </Border>
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                                  Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                    </Border>
                    <Control Template="{DynamicResource RivetsTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
