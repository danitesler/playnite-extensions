<!--
    Cold Seat Button: the glue button of the Frozen Throne menus (Single Player, OK, Cancel). A deep blue plate
    (ButtonBackgroundBrush) with a lit blue top/left line and sheen (SelectedSheenBrush), set in a 3px forged iron frame between
    black grooves (FramedPlateTemplate in Common.xaml). Gold label; hover blends the lit plate in (ButtonHoverBackgroundBrush)
    and turns the label white; pressed sinks to ButtonPressedBackgroundBrush and pushes the label 1px down and right (the FDF
    ButtonPushedTextOffset). Disabled: the plate goes black, as the locked dropdowns of the game lobby. Padding
    ButtonPadding. Keyboard focus: FocusVisual.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SelectedSheenBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="Plate" Template="{DynamicResource FramedPlateTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                        <Border x:Name="HoverPlate" Margin="4" IsHitTestVisible="False" Opacity="0" Background="{DynamicResource ButtonHoverBackgroundBrush}">
                            <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource SelectedBorderBrush}" />
                        </Border>
                        <Border x:Name="PressPlate" Margin="4" IsHitTestVisible="False" Opacity="0" Background="{DynamicResource ButtonPressedBackgroundBrush}">
                            <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource FrameInnerBrush}" />
                        </Border>
                        <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="PushShift" X="0" Y="0" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                                        <DoubleAnimation Storyboard.TargetName="PushShift" Storyboard.TargetProperty="X" To="1" Duration="0:0:0.05" />
                                        <DoubleAnimation Storyboard.TargetName="PushShift" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PushShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.06" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PushShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" TargetName="Plate" />
                            <Setter Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" TargetName="Plate" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <!-- ThemeModifier icon buttons: the plugin sets Width=41 on them (editor and constants tabs).
                 Render at 32x32 via uniform 32/41 layout scaling, including glyphs and decoration; auto-width buttons keep ButtonPadding. -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- SecondaryButton: More and Edit on the game page. The same glue button as every other, square, with a gold glyph. -->
    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
    </Style>

    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
