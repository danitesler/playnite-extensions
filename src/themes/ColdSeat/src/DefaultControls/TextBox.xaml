<!--
    Cold Seat TextBox: inset stone well. InputBackgroundBrush fill, 1px InputBorderBrush rim, a dark top/left inner edge
    (BevelShadowBrush) for the sunken look, ControlCornerRadius. Hover: InputHoverBorderBrush rim. Focus (IsKeyboardFocusWithin): FocusBrush rim.
    Padding InputPadding. BareTextBox is the chromeless variant for hosts that draw their own frame.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        LocalEditWellTemplate: the forged frame of an edit well, laid over the field (hit testing off, no desired size, so the
        field keeps its 32px). Outer groove, a 3px iron band worn with the theme's mottle and scratch textures and lit on its
        top/left and dark on its bottom/right (BevelTemplate's rule), an inner groove, then the well itself sunk: a 1px dark
        shadow on the top and left and a faint lit lip on the bottom. Hover: the band takes the lit iron (FrameHoverBrush).
        Keyboard focus: a gold line (FocusBrush) runs round the well and rime creeps up its bottom edge (LocalRimeEdgeTemplate).
        State is read from the nearest Control above, so TextBox and PasswordBox share it.
    -->
    <ControlTemplate x:Key="LocalEditWellTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderThickness="1" BorderBrush="{DynamicResource FrameInnerBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="1" BorderThickness="3" BorderBrush="{DynamicResource FrameHoverBrush}" />
            <Border x:Name="HoverBand" Margin="1" BorderThickness="3" BorderBrush="{DynamicResource NormalBorderBrush}" Visibility="Collapsed" />
            <Border Margin="1" BorderThickness="3" BorderBrush="{DynamicResource LocalMottleBrush}" />
            <Border Margin="1" BorderThickness="3" BorderBrush="{DynamicResource LocalScratchBrush}" Opacity="0.5" />
            <Border Margin="1" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource NormalBorderBrush}" Opacity="0.9" />
            <Border Margin="1" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BevelShadowBrush}" />
            <Border Margin="4" BorderThickness="1" BorderBrush="{DynamicResource FrameInnerBrush}" />
            <Border Margin="5" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelShadowBrush}" />
            <Border Margin="5" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BevelLightBrush}" Opacity="0.3" />
            <Border x:Name="FocusLine" Margin="4" BorderThickness="1" BorderBrush="{DynamicResource FocusBrush}" Visibility="Collapsed" />
            <Grid Margin="5,0,5,5" ClipToBounds="True">
                <Control x:Name="Rime" Template="{DynamicResource LocalRimeEdgeTemplate}" Opacity="0" Focusable="False" IsTabStop="False" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <Setter TargetName="HoverBand" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="RimeIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Rime" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.28" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="RimeIn" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <Control x:Name="FieldOverlay" Template="{DynamicResource LocalEditWellTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
