<!--
    Overlay on Playnite Default/DefaultControls/Menu.xaml. Every popup menu (hamburger menu, top bar dropdowns, game and
    group menus, tray) is Warcraft III: The Frozen Throne's glue menu on the forged-iron panel of ContextMenu.xaml
    (LocalFrozenIronPanelTemplate):
    - Panel: night-black dialog body in a 3px beveled forged-iron frame between black grooves, riveted at four corners.
    - Row: 30px tall; fixed 26px icon column, plain * label column (menu gold ButtonForegroundBrush at rest), shared Auto
      shortcut column.
    - Highlight: lit royal-blue glue button plate (ButtonHoverBackgroundBrush with upper blue sheen and 1px glint inside
      black groove) fades in (110ms) while a barbed gold menu spike slides in from the left and the label turns white and
      shifts 2px right; out over 180ms (FillBehavior="Stop").
    - Group break: 10px tall, forged iron bevel bar (groove over lit iron) split around a centered 5px iron rivet stud.
    - Shortcuts: sunken black edit-well chips (InputBackgroundBrush, recessed iron bevel); light white with blue glint
      on highlight.
    - Submenu mark: solid gold triangle on the right edge, turning white on highlight; held deep-blue glue plate while
      IsSubmenuOpen is True.
    - Marked rows: Exit (Alt+Q) has WarningBrush label at rest and takes a forged blood-crimson glue plate with white
      barbed spike, white label and white shortcut on highlight; checked rows show a 14px iron-bezel black well with a
      heavy gold check.
    Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0,3,0,3" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="true" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group break: 10px tall, forged iron bevel bar split around a centered 5px iron rivet stud. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" Margin="6,0" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Height="2" VerticalAlignment="Center" Background="{DynamicResource MenuSeparatorBrush}"
                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="0,1,0,0" />
                        <Border Grid.Column="1" Width="5" Height="5" Margin="6,0" VerticalAlignment="Center"
                                Background="{DynamicResource FrameHoverBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1">
                            <Rectangle Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
                        </Border>
                        <Border Grid.Column="2" Height="2" VerticalAlignment="Center" Background="{DynamicResource MenuSeparatorBrush}"
                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="0,1,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TopLevelHeader -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border">
            <Grid>
                <Border x:Name="HoverBorder" Background="{DynamicResource MenuItemHoverBrush}" Visibility="Collapsed"
                        CornerRadius="{DynamicResource ControlCornerRadius}" />
                <TextBlock VerticalAlignment="Center" Padding="{DynamicResource MenuItemPadding}" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                    <Grid MinWidth="220" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalFrozenIronPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="HoverBorder" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- TopLevelItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Style="{DynamicResource PopupBorder}">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>

    <!-- SubmenuHeader -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held deep-blue glue plate while submenu is open -->
            <Border x:Name="MenuHeld" Visibility="Collapsed" Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" IsHitTestVisible="False" />
            <!-- Lit royal-blue glue button plate with upper sheen and top/left glint -->
            <Border x:Name="MenuHover" Opacity="0" Visibility="Collapsed" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" IsHitTestVisible="False">
                <Grid>
                    <Rectangle Fill="{DynamicResource SelectedSheenBrush}">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#99000000" />
                                <GradientStop Offset="0.45" Color="#00000000" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource SelectedBorderBrush}" />
                </Grid>
            </Border>
            <!-- Barbed gold menu spike cursor -->
            <Path x:Name="MenuCursor" Width="7" Height="7" Margin="5,0,0,0" Stretch="Fill" HorizontalAlignment="Left"
                  VerticalAlignment="Center" Data="M 0,0 L 7,3.5 L 0,7 L 2,3.5 Z" Fill="{DynamicResource GlyphBrush}"
                  Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="MenuCursorShift" X="-4" />
                </Path.RenderTransform>
            </Path>
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.85" TextElement.Foreground="{DynamicResource GlyphBrush}" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource ButtonForegroundBrush}" TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MenuLabelShift" X="0" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <Path x:Name="MenuArrow" Grid.Column="3" Width="6" Height="8" Stretch="Fill" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Data="M 0,0 L 6,4 L 0,8 Z" Fill="{DynamicResource GlyphBrush}"
                      Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="0.5" />
            </Grid>
            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                   HorizontalOffset="4" VerticalOffset="-6" Focusable="False" AllowsTransparency="True">
                <Grid MinWidth="220" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalFrozenIronPanelTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Visibility" Value="Visible" TargetName="MenuHeld" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Setter Property="Fill" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuArrow" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursorShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuLabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursorShift" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuLabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Lit royal-blue glue button plate with upper sheen and top/left glint -->
            <Border x:Name="MenuHover" Opacity="0" Visibility="Collapsed" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" IsHitTestVisible="False">
                <Grid>
                    <Rectangle x:Name="MenuSheen" Fill="{DynamicResource SelectedSheenBrush}">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#99000000" />
                                <GradientStop Offset="0.45" Color="#00000000" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Border x:Name="MenuGlint" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource SelectedBorderBrush}" />
                </Grid>
            </Border>
            <!-- Barbed gold menu spike cursor -->
            <Path x:Name="MenuCursor" Width="7" Height="7" Margin="5,0,0,0" Stretch="Fill" HorizontalAlignment="Left"
                  VerticalAlignment="Center" Data="M 0,0 L 7,3.5 L 0,7 L 2,3.5 Z" Fill="{DynamicResource GlyphBrush}"
                  Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="MenuCursorShift" X="-4" />
                </Path.RenderTransform>
            </Path>
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.85" TextElement.Foreground="{DynamicResource GlyphBrush}" />
                <!-- Checked row: 14px iron-bezel black well with heavy gold check -->
                <Border x:Name="GlyphPanel" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Visibility="Collapsed" Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource FrameHoverBrush}" BorderThickness="1">
                    <Path Width="9" Height="7" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0,3.5 L 3.2,7 L 9,0.5" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="2" />
                </Border>
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource ButtonForegroundBrush}" TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MenuLabelShift" X="0" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <Border x:Name="MenuKeyWell" Grid.Column="2" Height="18" Margin="14,0,0,0" Padding="5,0" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource FrameHoverBrush}" BorderThickness="1">
                    <TextBlock x:Name="GestureText" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuKeyWell" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuKeyWell" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" TargetName="MenuLabel" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" TargetName="MenuKeyWell" />
                <Setter Property="Background" Value="{DynamicResource DangerBrush}" TargetName="MenuHover" />
                <Setter Property="Fill" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuSheen" />
                <Setter Property="Opacity" Value="0.22" TargetName="MenuSheen" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuGlint" />
                <Setter Property="Fill" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuCursor" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" TargetName="MenuKeyWell" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="GestureText" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursorShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuLabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursorShift" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuLabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <!-- White on blood crimson keeps contrast >= 4.5:1 -->
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Icon" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuKeyWell" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="GestureText" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
