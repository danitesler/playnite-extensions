<!--
    Cold Seat CheckBox: square 18x18 stone-dark well (CheckBoxCheckMarkBkBrush) with a 1px CheckBoxBorderBrush rim and a dark
    top/left inner edge; gold check mark drawn as a Path (no icon dependency), gold square for indeterminate. Hover rim CheckBoxHoverBorderBrush.
    Keyboard focus: FocusVisual. Label text TextBrush.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Border x:Name="BulletBorder" DockPanel.Dock="Left" VerticalAlignment="Center"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{DynamicResource FrameBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelLightBrush}"
                                        CornerRadius="{DynamicResource CornerRadiusSmall}">
                                    <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BevelShadowBrush}" Padding="1,1,0,0">
                                        <Border Background="{DynamicResource CheckBoxCheckMarkBkBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1">
                                            <Grid Width="12" Height="12">
                                                <!-- The check of the options screens: a heavy gold tick with a dark gold underside that leans out of the well. -->
                                                <Path x:Name="CheckShade" Visibility="Collapsed" Data="M 1,6.5 L 4.8,10.5 L 12.5,0.5"
                                                      Stroke="{DynamicResource CheckBoxHoverBorderBrush}" StrokeThickness="3"
                                                      StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Miter"
                                                      Stretch="None" SnapsToDevicePixels="False" Margin="0,1,0,-1" />
                                                <Path x:Name="CheckIcon" Visibility="Collapsed" Data="M 1,6.5 L 4.8,10.5 L 12.5,0.5"
                                                      Stroke="{DynamicResource GlyphBrush}" StrokeThickness="2.4"
                                                      StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Miter"
                                                      Stretch="None" SnapsToDevicePixels="False" />
                                                <Rectangle x:Name="IndeterminateIcon" Visibility="Collapsed" Width="6" Height="6"
                                                           Fill="{DynamicResource GlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Border>
                            </Border>
                            <ContentPresenter DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="8,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckShade" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="BulletBorder" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
