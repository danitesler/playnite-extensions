<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is Warcraft III: The Frozen Throne's forged-iron dialog panel (LocalFrozenIronPanelTemplate,
    shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: night-black dialog body (PopupBackgroundBrush) in a 3px forged iron bevel frame (FrameBrush, BevelLightBrush
      top/left, BevelShadowBrush bottom/right) between 1px black grooves (FrameInnerBrush), riveted at all four corners.
      No DropShadowEffect.
    - Rows, rules and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalFrozenIronPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <!-- Outer groove + 3px beveled forged-iron frame + inner groove around dialog night body -->
            <Border Background="{DynamicResource FrameBrush}" BorderBrush="{DynamicResource FrameInnerBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelLightBrush}">
                    <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BevelShadowBrush}" Padding="1">
                        <Border Background="{DynamicResource PopupBackgroundBrush}"
                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" />
                    </Border>
                </Border>
            </Border>
            <!-- Four forged iron corner rivets -->
            <Border Width="5" Height="5" Margin="2,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{DynamicResource FrameHoverBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1">
                <Rectangle Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            </Border>
            <Border Width="5" Height="5" Margin="0,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{DynamicResource FrameHoverBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1">
                <Rectangle Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            </Border>
            <Border Width="5" Height="5" Margin="2,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Background="{DynamicResource FrameHoverBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1">
                <Rectangle Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            </Border>
            <Border Width="5" Height="5" Margin="0,0,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="{DynamicResource FrameHoverBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1">
                <Rectangle Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="232" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalFrozenIronPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
