<!--
    Cold Seat ToggleButton: the Button stone plate. Checked state reads as a pressed plate: ToggleButtonCheckedBackgroundBrush
    ice wash, SelectedBorderBrush rim, inverted bevel, white text. Unchecked is gold text, white on hover over ButtonHoverBackgroundBrush.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Border x:Name="BevelLight" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelLightBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Border x:Name="BevelShadow" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BevelShadowBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" TargetName="Plate" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ToggleButtonCheckedBackgroundBrush}" TargetName="Plate" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" TargetName="Plate" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BevelShadowBrush}" TargetName="BevelLight" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BevelLightBrush}" TargetName="BevelShadow" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" TargetName="Plate" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BevelShadowBrush}" TargetName="BevelLight" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BevelLightBrush}" TargetName="BevelShadow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
