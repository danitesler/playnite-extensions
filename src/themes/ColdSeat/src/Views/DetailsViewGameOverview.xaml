<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!--
        Cold Seat game page (details view). Follows the shared skeleton in src/themes/AGENTS.md:
        1. HeroArt banner (GameBannerHeight, art faded downward under a void scrim and ice tint, BitmapCache).
        2. Spacer scaled with HeroArt by MathConverter (x * 150 / 320), 24 when the banner is off.
        3. Header: gold title (HeadingFontFamily, FontSizeLargest) left, actions right: PLAY 220x48 gold plate
           (PlayButton), More and Edit stone plates 48 high.
        4. Two columns: Steam screenshots, description and notes left; metadata pane right (PropertiesPanelWith),
           framed like the Esc menu panel: 1px stone rim, 3px night inset, 1px void inner line.
        Metadata: six collapsing groups, 8px field rhythm, 12px group rhythm, caption column beside the value,
        captions in muted gold. The wrapper margins are -(2 x 12 + 1 + 8) top and -8 bottom.
    -->
    <!--
        Pulsing placeholder for the Steam Screenshots plugin control: a 16:9 main plate over a row of five thumbnails,
        drawn in the host's Foreground at low strength. Used while a Steam game waits for the plugin (12 s at most).
    -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type ContentControl}">
        <Grid x:Name="SkeletonRoot" IsHitTestVisible="False">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="0.45" To="1" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{TemplateBinding Foreground}" Opacity="0.16" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
            <UniformGrid Grid.Row="1" Columns="5" Margin="-3,6,-3,0">
                <Border Margin="3,0" Background="{TemplateBinding Foreground}" Opacity="0.12" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Margin="3,0" Background="{TemplateBinding Foreground}" Opacity="0.12" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Margin="3,0" Background="{TemplateBinding Foreground}" Opacity="0.12" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Margin="3,0" Background="{TemplateBinding Foreground}" Opacity="0.12" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Margin="3,0" Background="{TemplateBinding Foreground}" Opacity="0.12" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
            </UniformGrid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1280"
                                  d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid>
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" Height="{DynamicResource GameBannerHeight}" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid>
                                    <Grid.CacheMode>
                                        <BitmapCache />
                                    </Grid.CacheMode>
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                        <FadeImage.ImageOpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Black" Offset="0.35" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </FadeImage.ImageOpacityMask>
                                    </FadeImage>
                                    <Rectangle Fill="{DynamicResource ArtTintBrush}" />
                                    <Rectangle Fill="{DynamicResource ScrimBrush}">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Transparent" Offset="0.2" />
                                                <GradientStop Color="Black" Offset="0.95" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                            <Grid HorizontalAlignment="Stretch" Margin="28,0,28,28" MaxWidth="1100">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 150 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="0,0,0,24" Background="Transparent">
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="16,0,0,0">
                                        <Grid Width="220" Height="48">
                                            <Button Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                            <Button Name="PART_ButtonContextAction" />
                                        </Grid>
                                        <Button Name="PART_ButtonMoreActions" Style="{DynamicResource SecondaryButton}" Content="{DynamicResource LOCMoreAction}"
                                                Width="120" Height="48" Margin="10,0,0,0" />
                                        <Button x:Name="PART_ButtonEditGame" Margin="10,0,0,0" Height="48" Width="48" Focusable="False"
                                                Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{DynamicResource SecondaryButton}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                    <DockPanel VerticalAlignment="Bottom">
                                        <Image Name="PART_ImageIcon" MaxHeight="48" MaxWidth="48" DockPanel.Dock="Left" Margin="0,0,12,0"
                                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                        <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}"
                                                   DockPanel.Dock="Left" FontSize="{DynamicResource FontSizeLargest}" Margin="0,0,10,0" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource HeadingForegroundBrush}">
                                            <TextBlock.Effect>
                                                <DropShadowEffect ShadowDepth="2" BlurRadius="2" Opacity="0.9" RenderingBias="Quality"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </DockPanel>
                                </DockPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid Margin="0,0,0,18">
                                            <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" Focusable="False">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                            <ContentControl x:Name="SteamScreenshotsSkeleton" Focusable="False" IsHitTestVisible="False"
                                                            Foreground="{DynamicResource SelectedBorderBrush}"
                                                            Template="{DynamicResource SteamScreenshotsSkeletonTemplate}">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </Grid>
                                        <StackPanel Name="PART_ElemDescription" Margin="0,0,0,18">
                                            <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Margin="0,0,0,6" FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource HeadingForegroundBrush}" />
                                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,0,0,8" />
                                            <HtmlTextView Name="PART_HtmlDescription"
                                                          Margin="0,0,0,0"
                                                          TextElement.Foreground="{DynamicResource TextBrush}"
                                                          Tag="{DynamicResource GlyphBrush}"
                                                          HtmlFontSize="{DynamicResource FontSize}"
                                                          HtmlFontFamily="{DynamicResource FontFamily}"
                                                          HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                          LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                        </StackPanel>
                                        <StackPanel Name="PART_ElemNotes" Margin="0,0,0,18">
                                            <TextBlock Text="{DynamicResource LOCNotesLabel}" Margin="0,0,0,6" FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource HeadingForegroundBrush}" />
                                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,0,0,8" />
                                            <TextBox Name="PART_TextNotes" IsReadOnly="True"
                                                     BorderThickness="0"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     Margin="-1,0,-1,0" Padding="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="2" VerticalAlignment="Top">
                                        <Border VerticalAlignment="Top" BorderThickness="1" BorderBrush="{DynamicResource PopupBorderBrush}" Background="{DynamicResource ExpanderBackgroundBrush}" Padding="3" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True" Width="{DynamicResource GameDetailsPaneWidth}">
                                            <Border BorderThickness="1" BorderBrush="{DynamicResource ShellBackgroundBrush}" Padding="16,16,16,8" CornerRadius="{DynamicResource CornerRadiusSmall}">
                                                <Grid ClipToBounds="True">
                                                    <StackPanel Margin="0,-33,0,-8">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                            </Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
                                                        </StackPanel.Resources>
                                                        <Border x:Name="MetaProgress" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,12,0,12" Padding="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <Button Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,12,0,12" Padding="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextCommunityScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCriticScore}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextCriticScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCUserScore}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextUserScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </Grid>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,12,0,12" Padding="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDeveloperLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsDevelopers" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCPublisherLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsPublishers" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <Button Name="PART_ButtonReleaseDate" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemSeries" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCSeriesLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsSeries" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsAgeRatings" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemRegion" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRegionLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsRegions" />
                                                                    </Grid>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaTags" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,12,0,12" Padding="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
