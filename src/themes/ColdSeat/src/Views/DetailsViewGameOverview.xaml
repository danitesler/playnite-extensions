<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!--
        Cold Seat game page (details view). Follows the shared skeleton in src/themes/AGENTS.md:
        1. HeroArt banner (GameBannerHeight, art faded downward under a void scrim and ice tint, BitmapCache).
        2. Spacer scaled with HeroArt by MathConverter (x * 150 / 320), 24 when the banner is off.
        3. Header: gold title (HeadingFontFamily, FontSizeLargest) left, actions right: PLAY 220x48 gold plate
           (PlayButton), More and Edit stone plates 48 high.
        4. Two columns: Steam screenshots, description and notes left; metadata pane right (PropertiesPanelWith),
           framed like the Esc menu panel: 1px stone rim, 3px night inset, 1px void inner line.
        Metadata: six collapsing groups, 8px field rhythm, 12px group rhythm, caption column beside the value,
        captions in muted gold. The wrapper margins are -(2 x 12 + 1 + 8) top and -8 bottom.
    -->
    <!--
        Pulsing placeholder for the Steam Screenshots plugin control: a 16:9 main plate over a row of five thumbnails,
        drawn in the host's Foreground at low strength. Used while a Steam game waits for the plugin (12 s at most).
    -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type ContentControl}">
        <Grid x:Name="SkeletonRoot" IsHitTestVisible="False">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="0.45" To="1" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{TemplateBinding Foreground}" Opacity="0.16" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
            <UniformGrid Grid.Row="1" Columns="5" Margin="-3,6,-3,0">
                <Border Margin="3,0" Background="{TemplateBinding Foreground}" Opacity="0.12" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Margin="3,0" Background="{TemplateBinding Foreground}" Opacity="0.12" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Margin="3,0" Background="{TemplateBinding Foreground}" Opacity="0.12" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Margin="3,0" Background="{TemplateBinding Foreground}" Opacity="0.12" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Margin="3,0" Background="{TemplateBinding Foreground}" Opacity="0.12" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
            </UniformGrid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="DataContext" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible"
                                  Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible"
                                  d:DesignWidth="1280"
                                  d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid>
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" Height="{DynamicResource GameBannerHeight}" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid>
                                    <Grid.CacheMode>
                                        <BitmapCache />
                                    </Grid.CacheMode>
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                        <FadeImage.ImageOpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Black" Offset="0.35" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </FadeImage.ImageOpacityMask>
                                    </FadeImage>
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                    <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <Rectangle Fill="{DynamicResource ArtTintBrush}" />
                                    <Rectangle Fill="{DynamicResource ScrimBrush}">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Transparent" Offset="0.2" />
                                                <GradientStop Color="Black" Offset="0.95" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                            <Grid HorizontalAlignment="Stretch" Margin="28,0,28,28" MaxWidth="1100">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" x:Name="DetailsBannerSpacer" MinHeight="28">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 150 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="28" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="28" />
</DataTrigger>
</Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="0,0,0,24" Background="Transparent">
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="16,0,0,0">
                                        <Grid Width="220" Height="48">
                                            <Button Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                            <Button Name="PART_ButtonContextAction" />
                                        </Grid>
                                        <Button Name="PART_ButtonMoreActions" Style="{DynamicResource SecondaryButton}"
                                                Width="48" Height="48" Margin="10,0,0,0"
                                                ToolTip="{DynamicResource LOCMoreAction}" Padding="0">
                                            <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                            Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                        </Button>
                                        <Button Padding="0" x:Name="PART_ButtonEditGame" Margin="10,0,0,0" Height="48" Width="48" Focusable="False"
                                                Style="{DynamicResource SecondaryButton}"
                                                Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}" ToolTip="{DynamicResource LOCEditGame}" />
                                    </StackPanel>
                                    <DockPanel VerticalAlignment="Bottom">
                                        <Image Name="PART_ImageIcon" MaxHeight="48" MaxWidth="48" DockPanel.Dock="Left" Margin="0,0,12,0"
                                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                        <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                                   DockPanel.Dock="Left" FontSize="{DynamicResource FontSizeLargest}" Margin="0,0,10,0" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource HeadingForegroundBrush}">
                                            <TextBlock.Effect>
                                                <DropShadowEffect ShadowDepth="2" BlurRadius="2" Opacity="0.9" RenderingBias="Quality"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </DockPanel>
                                </DockPanel>

                                <Grid Grid.Row="2" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 28 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataViewport" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="28,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<Grid VerticalAlignment="Top" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                        <Control Template="{DynamicResource RivetsTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Panel.ZIndex="1" />
                                        <Border VerticalAlignment="Top" BorderThickness="1" BorderBrush="{DynamicResource FrameInnerBrush}" Background="{DynamicResource FrameBrush}" Padding="8" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                                            <Border BorderThickness="1" BorderBrush="{DynamicResource FrameInnerBrush}" Background="{DynamicResource ExpanderBackgroundBrush}" Padding="16,16,16,8">
                                                <Grid ClipToBounds="True" x:Name="DetailsMetadataViewport" Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch">
<Grid.Style><Style TargetType="Grid"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                    <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-21,0,-4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-21,-24,-4" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                        <WrapPanel.Resources>
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                            </Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
                                                        </WrapPanel.Resources>
                                                        <Border x:Name="MetaProgress" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Padding="0,8,0,0"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Name="PART_ElemCompletionStatus" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <Button Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemPlayTime" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemLastPlayed" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemRecentActivity" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemAdded" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Padding="0,8,0,0"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Name="PART_ElemCommunityScore" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextCommunityScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemCriticScore" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCriticScore}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextCriticScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemUserScore" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCUserScore}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextUserScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </Grid>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Padding="0,8,0,0"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Name="PART_ElemDevelopers" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDeveloperLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsDevelopers" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemPublishers" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCPublisherLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsPublishers" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemReleaseDate" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <Button Name="PART_ButtonReleaseDate" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemSeries" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCSeriesLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsSeries" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemAgeRating" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsAgeRatings" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemRegion" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRegionLabel}" VerticalAlignment="Top" Margin="0,3,8,0" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsRegions" />
