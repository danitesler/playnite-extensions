<!--
    Frozen Throne sidebar: the compact vertical stone rail of the main menu, on the left.
    44px wide, items 44x40 with 16px glyphs, main menu button 44x40 (MainMenuButton, a stone plate with a lit top and left bevel).
    The rail is the void (ShellBackgroundBrush) with a 1px stone rim (PopupBorderBrush) and a lit bevel line (BevelLightBrush) on the library side.
    Right mirrors it; Top and Bottom draw a strip (the top strip keeps 146px clear on the right for the caption buttons).
    MainMenuButton is a Border style: PART_ElemMainMenu is a Border in Playnite's Default, the child draws IconMainMenu.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style x:Key="MainMenuButton" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource PopupBorderBrush}"
                            Background="{DynamicResource ShellBackgroundBrush}"
                            x:Name="BorderContentHolder" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BevelLightBrush}" x:Name="BorderBevel">
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource MainMenuButton}"
                                        Margin="0,0,0,4" DockPanel.Dock="Top">
                                    <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelLightBrush}" IsHitTestVisible="False">
                                        <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BevelShadowBrush}">
                                            <ContentControl Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Border>
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,40,0,0" />
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="BorderBevel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0,0,1,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="BorderContentHolder" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="BorderBevel" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,146,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0,0,1,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="BorderBevel" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
