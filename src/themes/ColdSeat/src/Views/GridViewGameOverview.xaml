<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!--
        Cold Seat game page (grid side panel). Same skeleton as the details view, narrower:
        HeroArt banner behind the panel, MathConverter spacer (x * 150 / 320), gold title, actions under it
        (PLAY gold plate, More, Edit stone plates, 40 high), a close button over the top-right corner.
        Two columns with a 24px gap: Steam screenshots, description and notes left; the double framed
        metadata pane right, captions above their values (4px), six collapsing groups.
    -->
    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border Padding="0,0,5,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                       Margin="0,20,0,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid x:Name="HeroArt" VerticalAlignment="Top" Height="{DynamicResource GameBannerHeight}" ClipToBounds="True" IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid>
                                        <Grid.CacheMode>
                                            <BitmapCache />
                                        </Grid.CacheMode>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                            <FadeImage.ImageOpacityMask>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="Black" Offset="0.35" />
                                                    <GradientStop Color="Transparent" Offset="1" />
                                                </LinearGradientBrush>
                                            </FadeImage.ImageOpacityMask>
                                        </FadeImage>
                                        <Rectangle Fill="{DynamicResource ArtTintBrush}" />
                                        <Rectangle Fill="{DynamicResource ScrimBrush}">
                                            <Rectangle.OpacityMask>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="Transparent" Offset="0.2" />
                                                    <GradientStop Color="Black" Offset="0.95" />
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Grid>
                                </Grid>
                                <ScrollViewer HorizontalAlignment="Stretch"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                              x:Name="PART_ScrollViewHost">
                                    <Grid Margin="22,0,22,24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 150 / 320'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="24" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <DockPanel Grid.Row="1" Margin="0,0,34,0">
                                            <Image Name="PART_ImageIcon" DockPanel.Dock="Left" MaxHeight="32" MaxWidth="32"
                                                   RenderOptions.BitmapScalingMode="Fant" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}"
                                                       DockPanel.Dock="Left" FontSize="{DynamicResource FontSizeLarger}" Margin="0,0,10,0" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource HeadingForegroundBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="2" BlurRadius="2" Opacity="0.9" RenderingBias="Quality"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </DockPanel>
                                        <Grid Grid.Row="2" Margin="0,12,0,18" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MaxWidth="170" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Name="PART_ButtonPlayAction" Grid.Column="0" Height="40" Style="{DynamicResource PlayButton}" />
                                            <Button Name="PART_ButtonContextAction" Grid.Column="0" Height="40" />
                                            <Button Name="PART_ButtonMoreActions" Style="{DynamicResource SecondaryButton}" Content="{DynamicResource LOCMoreAction}"
                                                    Height="40" Grid.Column="1" Margin="10,0,0,0" MinWidth="90" />
                                            <Button x:Name="PART_ButtonEditGame" Margin="10,0,0,0" Height="40" Grid.Column="2" Focusable="False"
                                                    Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{DynamicResource SecondaryButton}">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,18">
                                                    <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" Focusable="False">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                    <ContentControl x:Name="SteamScreenshotsSkeleton" Focusable="False" IsHitTestVisible="False"
                                                                    Foreground="{DynamicResource SelectedBorderBrush}"
                                                                    Template="{DynamicResource SteamScreenshotsSkeletonTemplate}">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                            <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <MultiDataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </MultiDataTrigger.EnterActions>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </Grid>
                                                <StackPanel Name="PART_ElemDescription" Margin="0,0,0,18">
                                                    <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Margin="0,0,0,6" FontFamily="{DynamicResource HeadingFontFamily}"
                                                               FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource HeadingForegroundBrush}" />
                                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,0,0,8" />
                                                    <HtmlTextView Name="PART_HtmlDescription"
                                                                  Margin="0,0,0,0"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"
                                                                  Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </StackPanel>
                                                <StackPanel Name="PART_ElemNotes" Margin="0,0,0,18">
                                                    <TextBlock Text="{DynamicResource LOCNotesLabel}" Margin="0,0,0,6" FontFamily="{DynamicResource HeadingFontFamily}"
                                                               FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource HeadingForegroundBrush}" />
                                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,0,0,8" />
                                                    <TextBox Name="PART_TextNotes" IsReadOnly="True"
                                                             BorderThickness="0"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             Margin="-1,0,-1,0" Padding="0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Grid Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
                                                <Border VerticalAlignment="Top" BorderThickness="1" BorderBrush="{DynamicResource PopupBorderBrush}" Background="{DynamicResource ExpanderBackgroundBrush}" Padding="3" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True" Width="{DynamicResource GridDetailsPaneWidth}">
                                                    <Border BorderThickness="1" BorderBrush="{DynamicResource ShellBackgroundBrush}" Padding="12,12,12,4" CornerRadius="{DynamicResource CornerRadiusSmall}">
                                                        <Grid ClipToBounds="True">
                                                            <StackPanel Margin="0,-33,0,-8">
                                                                <StackPanel.Resources>
                                                                    <Style TargetType="ItemsControl">
                                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                                    </Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
                                                                </StackPanel.Resources>
                                                                <Border x:Name="MetaProgress" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,12,0,12" Padding="0,12,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <StackPanel Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCCompletionStatus}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <Button Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCTimePlayed}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <TextBlock Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCLastPlayed}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <TextBlock Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <TextBlock Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <TextBlock Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaScores" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,12,0,12" Padding="0,12,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <StackPanel Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCCommunityScore}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <TextBlock Name="PART_TextCommunityScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCCriticScore}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <TextBlock Name="PART_TextCriticScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCUserScore}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <TextBlock Name="PART_TextUserScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaAbout" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,12,0,12" Padding="0,12,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <StackPanel Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCDeveloperLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <ItemsControl Name="PART_ItemsDevelopers" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCPublisherLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <ItemsControl Name="PART_ItemsPublishers" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <Button Name="PART_ButtonReleaseDate" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemSeries" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCSeriesLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <ItemsControl Name="PART_ItemsSeries" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <ItemsControl Name="PART_ItemsAgeRatings" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemRegion" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCRegionLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <ItemsControl Name="PART_ItemsRegions" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaTags" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,12,0,12" Padding="0,12,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <StackPanel Name="PART_ElemPlatform" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCPlatformTitle}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <ItemsControl Name="PART_ItemsPlatforms" Tag="Chip">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemGenres" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCGenreLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <ItemsControl Name="PART_ItemsGenres" Tag="Chip">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemCategories" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCGameCategoriesTitle}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <ItemsControl Name="PART_ItemsCategories" Tag="Chip">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemFeatures" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <ItemsControl Name="PART_ItemsFeatures" Tag="Chip">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemTags" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCTagsLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <ItemsControl Name="PART_ItemsTags" Tag="Chip">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaLibrary" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,12,0,12" Padding="0,12,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <StackPanel Name="PART_ElemLibrary" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <Button Name="PART_ButtonLibrary" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemSource" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCSourceLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <Button Name="PART_ButtonSource" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemVersion" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCVersionLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <Button Name="PART_ButtonVersion" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemInstallSize" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <TextBlock Name="PART_TextInstallSize" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemInstallDirectory" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <Button Name="PART_ButtonInstallDirectory" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaLinks" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,12,0,12" Padding="0,12,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <StackPanel Name="PART_ElemLinks" Margin="0,8,0,8">
                                                                            <TextBlock Text="{DynamicResource LOCLinksLabel}" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                                            <ItemsControl Name="PART_ItemsLinks" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </ScrollViewer>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Content="r" FontFamily="Marlett"
                                        Style="{DynamicResource SimpleButton}"
                                        Command="{MainViewModel CloseGameSideBarCommand}"
                                        Margin="0,10,15,5" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
