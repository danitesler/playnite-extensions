<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!--
        Cold Seat game page (grid side panel). Same skeleton as the details view, narrower:
        HeroArt banner behind the panel, MathConverter spacer (x * 150 / 320), gold title, actions under it
        (PLAY gold plate, More, Edit stone plates, 40 high), a close button over the top-left corner.
        Two columns with a 24px gap: Steam screenshots, description and notes left; the double framed
        metadata pane right, captions beside their values (12px gap), six collapsing groups.
    -->
    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border Padding="0,0,5,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Control Template="{DynamicResource EmptyGameTemplate}" Focusable="False" IsTabStop="False">
                            <Control.Style>
                                <Style TargetType="Control">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <Trigger Property="DataContext" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Control.Style>
                        </Control>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid x:Name="HeroArt" VerticalAlignment="Top" Height="{DynamicResource GameBannerHeight}" ClipToBounds="True" IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid>
                                        <Grid.CacheMode>
                                            <BitmapCache />
                                        </Grid.CacheMode>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                            <FadeImage.ImageOpacityMask>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="Black" Offset="0.35" />
                                                    <GradientStop Color="Transparent" Offset="1" />
                                                </LinearGradientBrush>
                                            </FadeImage.ImageOpacityMask>
                                        </FadeImage>
                                        <Rectangle Fill="{DynamicResource ArtTintBrush}" />
                                        <Rectangle Fill="{DynamicResource ScrimBrush}">
                                            <Rectangle.OpacityMask>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="Transparent" Offset="0.2" />
                                                    <GradientStop Color="Black" Offset="0.95" />
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Grid>
                                </Grid>
                                <ScrollViewer CanContentScroll="False" HorizontalAlignment="Stretch"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"
                                              x:Name="PART_ScrollViewHost">
                                    <Grid Margin="22,0,22,24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" MinHeight="22" x:Name="GridBannerSpacer">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 150 / 320'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="22" />
                                                        </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="22" />
</DataTrigger>
</Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <DockPanel Panel.ZIndex="2" Grid.Row="1" Margin="0,0,34,0">
                                            <Button x:Name="InlineSidePanelCloseButton" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" Width="28" Height="28" Padding="0"
                                                Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}" Command="{MainViewModel CloseGameSideBarCommand}"
                                                Template="{Binding Template, ElementName=SidePanelCloseButton}"
                                                Visibility="{Binding Tag, ElementName=SidePanelCloseButton, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Visible` : `Collapsed`'}">
                                                    <Button.RenderTransform>
                                                        <TranslateTransform Y="{Binding ContentVerticalOffset, ElementName=PART_ScrollViewHost}" />
                                                    </Button.RenderTransform>
                                            </Button>
                                            <Image Name="PART_ImageIcon" DockPanel.Dock="Left" MaxHeight="32" MaxWidth="32"
                                                   RenderOptions.BitmapScalingMode="Fant" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                                       DockPanel.Dock="Left" FontSize="{DynamicResource FontSizeLargest}" Margin="0,0,10,0" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource HeadingForegroundBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="2" BlurRadius="2" Opacity="0.9" RenderingBias="Quality"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </DockPanel>
                                        <Grid Grid.Row="2" Margin="0,12,0,18" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MaxWidth="170" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Name="PART_ButtonPlayAction" Grid.Column="0" Height="40" Style="{DynamicResource PlayButton}" />
                                            <Button Name="PART_ButtonContextAction" Grid.Column="0" Height="40" />
                                            <Button Width="40" Name="PART_ButtonMoreActions" Style="{DynamicResource SecondaryButton}"
                                                    Height="40" Grid.Column="1" Margin="10,0,0,0"
                                                ToolTip="{DynamicResource LOCMoreAction}" Padding="0">
                                            <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                            Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                        </Button>
                                            <Button Padding="0" Width="40" x:Name="PART_ButtonEditGame" Margin="10,0,0,0" Height="40" Grid.Column="2" Focusable="False"
                                                    Style="{DynamicResource SecondaryButton}"
                                                    Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}" ToolTip="{DynamicResource LOCEditGame}" />
                                        </Grid>
                                        <Grid Grid.Row="3" x:Name="GridOverviewBody">
<Grid.Tag>
    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400">
        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Tag" ElementName="GridMetadataContent" />
    </MultiBinding>
</Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>


                                            <Grid x:Name="GridMainColumn" VerticalAlignment="Top">
<Grid.Style><Style TargetType="Grid">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
    </DataTrigger></Style.Triggers>
</Style></Grid.Style>
<Grid.MaxWidth>
    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="z == true ? x : Max(0, x - y - 24)">
        <Binding Path="ActualWidth" ElementName="GridOverviewBody" />
        <Binding Path="ActualWidth" ElementName="GridMetadataColumn" />
        <Binding Path="Tag" ElementName="GridOverviewBody" />
    </MultiBinding>
</Grid.MaxWidth>
<StackPanel>
                                                <Grid x:Name="SteamScreenshotsGameScope">
                                                    <!-- Plugin visibility is shared: a late Steam load must never reveal a different game's section. -->
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.Source.Name}" Value="Steam">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                <GroupBox Header="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" Margin="0,0,0,18">
                                                    <GroupBox.Style>
                                                        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </GroupBox.Style>
                                                    <Grid>
                                                        <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" Focusable="False">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <!-- Restart the timeout for each selected game, including Steam-to-Steam changes. -->
                                                            <Border x:Name="SteamScreenshotsSkeleton" Tag="{Binding Game.Id, NotifyOnTargetUpdated=True}" IsHitTestVisible="False">
                                                                <Border.Triggers>
                                                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Border.Triggers>
                                                                <ContentControl Focusable="False" IsHitTestVisible="False" Foreground="{DynamicResource SelectedBorderBrush}"
                                                                                Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" />
                                                            </Border>
                                                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}"
                                                                    BorderThickness="1" Padding="24" CornerRadius="{DynamicResource ControlCornerRadius}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Visibility, ElementName=SteamScreenshotsSkeleton}" Value="Collapsed">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <Border Width="14" Height="14" BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1"
                                                                            Margin="0,0,0,12" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                                                        <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                                                                    </Border>
                                                                    <TextBlock Text="{DynamicResource LOCNoItemsFound}" Foreground="{DynamicResource TextBrushDarker}"
                                                                               TextAlignment="Center" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </GroupBox>
                                                </Grid>
                                                <StackPanel Name="PART_ElemDescription" Margin="0,0,0,18">
                                                    <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Margin="0,0,0,6" FontFamily="{DynamicResource HeadingFontFamily}"
                                                               FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource HeadingForegroundBrush}" />
                                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,0,0,8" />
                                                    <HtmlTextView Name="PART_HtmlDescription"
                                                                  Margin="0,0,0,0"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"
                                                                  Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </StackPanel>
                                                <StackPanel Name="PART_ElemNotes" Margin="0,0,0,18">
                                                    <TextBlock Text="{DynamicResource LOCNotesLabel}" Margin="0,0,0,6" FontFamily="{DynamicResource HeadingFontFamily}"
                                                               FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource HeadingForegroundBrush}" />
                                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Margin="0,0,0,8" />
                                                    <TextBox Name="PART_TextNotes" IsReadOnly="True"
                                                             BorderThickness="0"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             Margin="-1,0,-1,0" Padding="0"/>
                                                </StackPanel>
                                            </StackPanel>
</Grid>
                                            <Grid x:Name="GridMetadataColumn" VerticalAlignment="Top">
<Grid.Style><Style TargetType="Grid">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="Margin" Value="24,0,0,0" />
    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </DataTrigger></Style.Triggers>
</Style></Grid.Style>
<Grid Margin="0,0,0,0" VerticalAlignment="Top">
                                                <Control Template="{DynamicResource RivetsTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Panel.ZIndex="1" />
                                                <Border VerticalAlignment="Top" BorderThickness="1" BorderBrush="{DynamicResource FrameInnerBrush}" Background="{DynamicResource FrameBrush}" Padding="8" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                                                    <Border BorderThickness="1" BorderBrush="{DynamicResource FrameInnerBrush}" Background="{DynamicResource ExpanderBackgroundBrush}" Padding="12,12,12,4">
                                                        <Grid ClipToBounds="True" Tag="{DynamicResource GridDetailsPaneWidth}" x:Name="GridMetadataContent" HorizontalAlignment="Stretch">
<Grid.Style>
    <Style TargetType="Grid">
        <Setter Property="Width" Value="{DynamicResource GridDetailsPaneWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource GridDetailsPaneWidth}" /><Style.Triggers>
            <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /></DataTrigger>
        <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers>
    </Style>
</Grid.Style>
                                                            <WrapPanel x:Name="GridMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-21,0,-4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-21,-24,-4" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="GridMetadataContent" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                                <WrapPanel.Resources>
                                                                    <Style TargetType="ItemsControl">
                                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                                    </Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
                                                                </WrapPanel.Resources>
                                                                <Border x:Name="MetaProgress" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Padding="0,8,0,0"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataContent" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <Grid Name="PART_ElemCompletionStatus" Margin="0,4,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="2*" />
                                                                                <ColumnDefinition Width="12" />
                                                                                <ColumnDefinition Width="3*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{DynamicResource LOCCompletionStatus}" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                            <Button Grid.Column="2" Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                        </Grid>
                                                                        <Grid Name="PART_ElemPlayTime" Margin="0,4,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="2*" />
                                                                                <ColumnDefinition Width="12" />
                                                                                <ColumnDefinition Width="3*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{DynamicResource LOCTimePlayed}" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                            <TextBlock Grid.Column="2" Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        </Grid>
                                                                        <Grid Name="PART_ElemLastPlayed" Margin="0,4,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="2*" />
                                                                                <ColumnDefinition Width="12" />
                                                                                <ColumnDefinition Width="3*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{DynamicResource LOCLastPlayed}" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                            <TextBlock Grid.Column="2" Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        </Grid>
                                                                        <Grid Name="PART_ElemRecentActivity" Margin="0,4,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="2*" />
                                                                                <ColumnDefinition Width="12" />
                                                                                <ColumnDefinition Width="3*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                            <TextBlock Grid.Column="2" Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        </Grid>
                                                                        <Grid Name="PART_ElemAdded" Margin="0,4,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="2*" />
                                                                                <ColumnDefinition Width="12" />
                                                                                <ColumnDefinition Width="3*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{DynamicResource LOCDateAddedLabel}" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                            <TextBlock Grid.Column="2" Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaScores" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MenuSeparatorBrush}" Padding="0,8,0,0"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataContent" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Margin" Value="0,8,0,8" /><Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,8,24,8" /></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <Grid Name="PART_ElemCommunityScore" Margin="0,4,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="2*" />
                                                                                <ColumnDefinition Width="12" />
                                                                                <ColumnDefinition Width="3*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{DynamicResource LOCCommunityScore}" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource GlyphBrush}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                            <TextBlock Grid.Column="2" Name="PART_TextCommunityScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                        </Grid>
                                                                        <Grid Name="PART_ElemCriticScore" Margin="0,4,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="2*" />
                                                                                <ColumnDefinition Width="12" />
                                                                                <ColumnDefinition Width="3*" />
