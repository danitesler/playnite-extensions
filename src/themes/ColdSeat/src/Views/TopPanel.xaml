<!--
    Cold Seat top bar: a night strip like the Warcraft III main menu button bar, 48px tall.
    Fill TopPanelBackgroundBrush, a lit 1px line on top (BevelLightBrush) and a stone rule below (PanelSeparatorBrush, off with ShowPanelSeparators).
    Left to right: main menu (only visible when the sidebar is hidden), the item strip (PART_PanelMainItems, never wrapped), filter and notification toggles,
    plugin items, progress; the search box (TopPanelSearchBox, 240px) sits at the right edge. 146px stay clear on the right for the caption buttons.
    All glyphs are icons through IconTemplate at IconSize; the view switches are icon only (IconDetailsView, IconGridView, IconListView).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style x:Key="TopPanelSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Width" Value="240" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Resources>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
    </Style>

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentControl Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}"
                        Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentControl Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}"
                        Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentControl Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}"
                        Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentControl Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}"
                        Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentControl Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}"
                        Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentControl Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}"
                        Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentControl Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}"
                        Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentControl Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}"
                        Focusable="False" Foreground="{DynamicResource WarningBrush}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentControl Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}"
                        Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}"
                        Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}"
                        Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentControl Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}"
                        Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Padding="{DynamicResource MenuPadding}"
                            Grid.IsSharedSizeScope="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter active: a small diamond in the notification accent (DataChangeNotifBrush) on the icon's top-right corner, no text. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="4,6,0,6" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" Margin="7,0,7,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentControl Content="{DynamicResource IconFilter}" ContentTemplate="{DynamicResource IconTemplate}"
                                            Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Path x:Name="TextFilter" Visibility="Collapsed" IsHitTestVisible="False" Margin="-4,-18,-4,0" VerticalAlignment="Center" Width="10" Height="10" Stretch="Fill" Data="M5,0 L10,5 5,10 0,5 Z" Fill="{DynamicResource DataChangeNotifBrush}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" TargetName="Plate" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,6,0,6" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl Content="{DynamicResource IconNotifications}" ContentTemplate="{DynamicResource IconTemplate}"
                                            Focusable="False" Foreground="{TemplateBinding Foreground}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border CornerRadius="{DynamicResource CornerRadiusFull}" Width="16" Height="16"
                                    Margin="14,0,-8,-6" Background="{DynamicResource DangerBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="11"
                                           Foreground="{DynamicResource DangerForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Border Height="48" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DesignWidth="1280"
                            d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource TopPanelBackgroundBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource BevelLightBrush}" IsHitTestVisible="False" />
                            <DockPanel Margin="8,0,146,0">
                                <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource MainMenuButton}"
                                        DockPanel.Dock="Left" Margin="0,6,8,6" BorderThickness="1" Height="36">
                                    <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BevelLightBrush}" IsHitTestVisible="False">
                                        <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BevelShadowBrush}">
                                            <ContentControl Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Border>
                                </Border>

                            <SearchBox x:Name="PART_TextMainSearch"
                                           Style="{DynamicResource TopPanelSearchBox}"
                                           Margin="8,0,0,0"
                                           WindowChrome.IsHitTestVisibleInChrome="True" DockPanel.Dock="Left" HorizontalAlignment="Left" />

                            <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}"
                                          Style="{DynamicResource TopPanelFilterToggle}"
                                          DockPanel.Dock="Left" />

                            <!-- Keep sorting first even though Playnite inserts it after view settings and grouping. -->
                            <Grid x:Name="PART_PanelMainItems" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="{x:Type TopPanelItem}" BasedOn="{StaticResource {x:Type TopPanelItem}}">
                                        <Style.Triggers>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSortSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="0" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSearchButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="1" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGeneralViewSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="2" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelFilterPresetsSelectionTemplate}">
                                                <Setter Property="Grid.Column" Value="3" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGroupSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="4" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchDetailsViewTemplate}">
                                                <Setter Property="Grid.Column" Value="6" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchGridViewTemplate}">
                                                <Setter Property="Grid.Column" Value="7" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchListViewTemplate}">
                                                <Setter Property="Grid.Column" Value="8" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelUpdateButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="9" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="10" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelViewSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="11" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelExplorerSwitchTemplate}">
                                                <Setter Property="Grid.Column" Value="12" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Grid.Column" Value="5" />
                                    </Style>
                                </Grid.Resources>
                            </Grid>







                                <CheckBox x:Name="PART_ToggleNotifications"
                                          Style="{DynamicResource TopPanelNotificationsToggle}"
                                          DockPanel.Dock="Left" />

                                <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                            VerticalAlignment="Stretch" Margin="12,6,12,6"
                                            DockPanel.Dock="{Settings PluginTopPanelAlignment}"/>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                            HorizontalAlignment="Center" Margin="0,8,0,8">
                                    <Grid MaxWidth="600" MinWidth="300">
                                        <ProgressBar Name="PART_ProgressGlobal" />
                                        <TextBlock Name="PART_TextProgressText"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Style="{DynamicResource BaseTextBlockStyle}" Margin="5,0,5,0" />
                                    </Grid>

                                    <Button Name="PART_ButtonProgressCancel"
                                            Content="{DynamicResource LOCCancelLabel}"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            Margin="5,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
