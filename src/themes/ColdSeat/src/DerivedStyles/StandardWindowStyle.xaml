<!--
    Cold Seat: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    The Frozen Throne menu frame as a 44px forged iron band (lit top/left, dark bottom/right bevel) closed by a black
    groove over a lit iron line, a rivet at each end, with the title in menu gold, centered between two barbed iron
    spikes (the ones that flank the menu buttons). The window itself sits in a 2px iron rim. Caption buttons are the 40x32 Marlett WindowBarButton, so the caption and the content offset are 44
    (Default 25). PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource FrameBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}" ClipToBounds="True">
                                    <!-- The stone plate of the game's frame (lit top/left, dark bottom/right bevel) fills the band. -->
                                    <Control Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                             Background="{DynamicResource WindowTitleBackgroundBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1,1,1,0" />
                                    <!-- Closing rule: a dark line over the thin gold trim. -->
                                    <StackPanel VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <Rectangle Height="2" Fill="{DynamicResource FrameInnerBrush}" />
                                        <Rectangle Height="1" Fill="{DynamicResource BevelLightBrush}" Opacity="0.6" />
                                    </StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <!-- Rivets (1:1, so a full radius is safe) at both ends of the plate. -->
                                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="12,0,0,2" VerticalAlignment="Center" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="1" IsHitTestVisible="False" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,4,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                        <Ellipse DockPanel.Dock="Right" Width="6" Height="6" Margin="0,0,10,2" VerticalAlignment="Center" Fill="{DynamicResource BevelLightBrush}" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="1" IsHitTestVisible="False" />
                                        <!-- The title in menu gold, centered, between two frozen-ice diamonds. -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2">
                                            <Path Data="M17,0 L17,16 L11,14 L12,11 L0,8 L12,5 L11,2 Z" Width="17" Height="16" Stretch="None" Fill="{DynamicResource FrameHoverBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1" Margin="0,1,12,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                                       Foreground="{DynamicResource HeadingForegroundBrush}" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                            <Path Data="M0,0 L0,16 L6,14 L5,11 L17,8 L5,5 L6,2 Z" Width="17" Height="16" Stretch="None" Fill="{DynamicResource FrameHoverBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1" Margin="12,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
