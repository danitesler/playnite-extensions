<!-- Attache: RE4-inspired dialog frame. A 44px body-font title band, original smoke mask and pewter hairlines; native window parts and content remain intact. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>
    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PopupBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ContentPresenter Margin="0,44,0,0" />
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource PopupBackgroundBrush}" ClipToBounds="True">
                                    <!-- Canvas gives the decorative sprite no desired width, so small dialogs can still size to content. -->
                                    <Canvas IsHitTestVisible="False">
                                        <Rectangle Width="520" Height="44" Canvas.Left="0" Opacity="0.16" Fill="{DynamicResource SelectedSheenBrush}">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/smoke.png'}" Stretch="Fill" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Canvas>
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource SelectedBorderBrush}" Opacity="0.65" IsHitTestVisible="False" />
                                    <DockPanel LastChildFill="True" Margin="16,0,4,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                        <Rectangle Width="2" Height="16" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   Fill="{DynamicResource SelectedBorderBrush}" IsHitTestVisible="False" />
                                        <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}" VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                                   Foreground="{DynamicResource SelectedForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_ButtonMaximize" Property="Content" Value="2" />
                            <Setter TargetName="WindowBorder" Property="Padding" Value="8" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter TargetName="WindowBorder" Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
