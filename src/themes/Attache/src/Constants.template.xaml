<!--
    Attache: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo. The
    Resident Evil 4 menu colors keep their names in tokens.css; here each placeholder names the token that plays the
    key's role. Theme XAML reads brushes only, never Color keys.
    Placeholder syntax: .claude/skills/playnite-theme-dev/reference.md. Keep double braces out of comments here: the build
    renders them too.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Segoe UI for reading, Bahnschrift (Windows' condensed DIN) for the menu words and headings, the
         closest face Windows ships to the menus' narrow uppercase sans. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">30</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape: square everywhere, 1px hairlines. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{text-body}}</Color>                <!-- descriptions, values -->
    <Color x:Key="TextColorDarker">{{text-idle}}</Color>          <!-- option labels at rest, captions -->
    <Color x:Key="TextColorDark">{{page}}</Color>                 <!-- text on the amber accent -->
    <Color x:Key="MainColor">{{slot}}</Color>                     <!-- control fill -->
    <Color x:Key="MainColorDark">{{scene}}</Color>                <!-- panels -->
    <Color x:Key="HoverColor">{{slot-hover}}</Color>              <!-- hover fill -->
    <Color x:Key="GlyphColor">{{new-dot}}</Color>                 <!-- accent: the amber dot; checked, links -->
    <Color x:Key="HighlightGlyphColor">{{new-dot/50}}</Color>     <!-- accent at partial strength -->
    <Color x:Key="PopupBackgroundColor">{{scene}}</Color>         <!-- menus, dropdowns -->
    <Color x:Key="PopupBorderColor">{{tab-divider}}</Color>       <!-- popup edge -->
    <Color x:Key="BackgroundToneColor">{{scene}}</Color>          <!-- tinted areas in Playnite's views -->
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>      <!-- no frame around covers -->
    <Color x:Key="PanelSeparatorColor">{{hairline}}</Color>       <!-- lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{hairline}}</Color> <!-- dividers and card edges -->
    <Color x:Key="DataChangeNotifColor">{{new-dot}}</Color>       <!-- "data changed" text -->

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{hairline-strong}}" />   <!-- control edge -->
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{scene}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{slot}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{page}}" />      <!-- unchecked check box and radio fill -->
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{completed}}" />      <!-- the COMPLETED green -->
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{herb-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{speaker}}" />           <!-- the speaker-name yellow -->

    <SolidColorBrush x:Key="WarningBrush" Color="{{new-dot}}" />               <!-- warnings, the update icon -->

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{scene}}" />      <!-- cards: group boxes and expanders -->
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{page}}" />         <!-- window background (Playnite's spelling) -->

    <!-- Shared keys. ThemeModifier lists them under Edit constants. -->
    <!-- Surfaces -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{page}}" />          <!-- the main menu column -->
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{page}}" />        <!-- library layer under the art -->
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="Transparent" />    <!-- the top strip shows the art behind it -->
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{hairline}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{slot/50}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{text-menu}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{page}}" />                    <!-- darkens art behind the library -->
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{page}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{text-tab}}" />
    <!-- Main menu (sidebar) -->
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{text-menu}}" />         <!-- menu item at rest -->
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{text-menu-current}}" /> <!-- current menu item -->
    <!-- States: the pewter plate -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{plate-core}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{plate-sheen}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{plate-edge}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{text-current}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{plate-core}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{slot}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{text-body}}" />               <!-- keyboard focus outline -->
    <SolidColorBrush x:Key="DangerBrush" Color="{{logo-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{text-menu-current}}" />
    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{text-body}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{hairline-strong}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{plate-core}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{plate-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{plate-core}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{plate-edge}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{slot-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{plate-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{text-menu-current}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{slot-hover}}" />
    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{page}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{scene}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{hairline-strong}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{text-idle}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{text-idle}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{text-body}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{hairline-strong}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{text-body}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{text-body}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{hairline}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{hairline-strong}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{scrollbar}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{hairline-strong}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{scrollbar}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{tab-line}}" />     <!-- the current tab's glowing line -->
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{text-idle}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{plate-edge}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{slot}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{text-body}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{slot-hover}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{hairline}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{text-body}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{tab-divider}}" />
</ResourceDictionary>
