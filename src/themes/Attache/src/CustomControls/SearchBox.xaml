<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    A quiet field: the host's Background (transparent on the top strip), a hairline along the bottom only
    (InputBorderBrush) that turns warm grey under the pointer and warm white while typing, a thin magnifier at the left
    and the clear cross at the right, both in the idle grey. All three PART_ names are Playnite's and must stay.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Field" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <ContentControl x:Name="Glyph" Focusable="False" IsTabStop="False"
                                            ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0"
                                            Foreground="{DynamicResource GlyphBrush}" Panel.ZIndex="1" IsHitTestVisible="False" />
                            <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                            <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="32,0,28,0" />
                            <ContentControl x:Name="PART_ClearTextIcon" Focusable="False" IsTabStop="False" Cursor="Hand"
                                            ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                                            Foreground="{DynamicResource TextBrushDarker}">
                                <ContentControl.Template>
                                    <ControlTemplate TargetType="ContentControl">
                                        <Border Background="Transparent">
                                            <ContentPresenter ContentSource="Content" />
                                        </Border>
                                    </ControlTemplate>
                                </ContentControl.Template>
                            </ContentControl>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Field" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Field" />
                        </Trigger>

                        <!-- Keep the magnifier visible while Playnite hides its placeholder. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
