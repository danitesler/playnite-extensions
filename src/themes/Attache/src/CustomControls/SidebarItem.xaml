<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    One word of the Resident Evil 4 (2023) main menu: uppercase condensed sans (HeadingFontFamily) in a warm grey
    (SidebarItemForegroundBrush), no icon, no plate. The current item turns near white
    (SidebarItemSelectedForegroundBrush), grows from 16 to 19px and steps out to the left by 12px, exactly how the
    game marks it; under the pointer an item brightens in place. Left or right rail: 208x44 rows, words 36px in from
    the edge (24px when current). Top or bottom strip: words side by side, 56px tall.
    Playnite's own icon is kept in the template (collapsed) so add-on items keep their content. PART_ProgressStatus is a
    1px line under the word while an add-on reports progress.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="208" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid x:Name="Label" Margin="36,0,16,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Viewbox x:Name="ItemIcon" Width="16" Height="16" Visibility="Collapsed">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                            <TextBlock x:Name="Title" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="16"
                                       TextTrimming="CharacterEllipsis" MaxWidth="160"
                                       Text="{Binding Title, Converter={StaticResource StringToUpperCaseConverter}}" />
                            <ProgressBar x:Name="PART_ProgressStatus" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,-6"
                                         BorderThickness="0" Background="Transparent" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Margin" Value="24,0,16,0" TargetName="Label" />
                            <Setter Property="FontSize" Value="19" TargetName="Title" />
                            <Setter Property="MaxWidth" Value="172" TargetName="Title" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="18,0,18,0" TargetName="Label" />
                            <Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}" TargetName="Title" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="18,0,18,0" TargetName="Label" />
                            <Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}" TargetName="Title" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Selected}" Value="True" />
                                <Condition Binding="{Settings SidebarPosition}" Value="Top" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Margin" Value="18,0,18,0" TargetName="Label" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Selected}" Value="True" />
                                <Condition Binding="{Settings SidebarPosition}" Value="Bottom" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Margin" Value="18,0,18,0" TargetName="Label" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="56" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="56" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
