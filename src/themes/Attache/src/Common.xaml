<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    The Resident Evil 4 (2023) menus are words on near black. The current row of a list sits on a brushed pewter plate:
    dark in the middle, lit toward its top and bottom edges, a bright hairline along both, smoky mottling across it,
    and soft ends at left and right. SelectionBarTemplate is that plate, reused by every list, menu, tab rail and
    button; HeadingTextBlock is the uppercase condensed caption above a block.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- The selection plate, from the host's brushes: Background is the dark middle band, Foreground the sheen toward
         the top and bottom edges, BorderBrush the 1px hairlines along them. Images/smoke.png (art/smoke.py, white at
         low alpha) lays the smoky mottling over it. The ends fade out over 12px at either side. Host: a Control
         stretched behind the item, hit testing off. -->
    <ControlTemplate x:Key="SelectionBarTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#40000000" Offset="0" />
                    <GradientStop Color="Black" Offset="0.03" />
                    <GradientStop Color="Black" Offset="0.97" />
                    <GradientStop Color="#40000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.OpacityMask>
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop Color="#70000000" Offset="0.25" />
                        <GradientStop Color="Transparent" Offset="0.5" />
                        <GradientStop Color="#50000000" Offset="0.75" />
                        <GradientStop Color="Black" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{ThemeFile 'Images/smoke.png'}" Stretch="Fill" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}" Opacity="0.85" />
        </Grid>
    </ControlTemplate>

    <!-- The current options tab's mark: a 2px line in the host's Foreground, bright in the middle and fading out toward
         both ends, with a soft light rising 14px above it. Host: a Control at the bottom of the tab, hit testing off. -->
    <ControlTemplate x:Key="TabItemIndicatorTemplate" TargetType="{x:Type Control}">
        <Grid Height="16" VerticalAlignment="Bottom" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0" />
                    <GradientStop Color="Black" Offset="0.3" />
                    <GradientStop Color="Black" Offset="0.7" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Grid.OpacityMask>
            <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.3">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="Black" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- Caption above a block (description, notes, group boxes): the condensed face in small caps, in the inactive tab grey. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Keyboard focus (WPF shows it for the keyboard only): a 1px warm white outline 2px outside the control, square. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="1" Stroke="{DynamicResource FocusBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing: the options list's rows are tall (60px at 1080p, about 40px here); everything else on an 8px rhythm. -->
    <Thickness x:Key="ButtonPadding">18,8,18,8</Thickness> <!-- Button: 34px tall -->
    <Thickness x:Key="InputPadding">10,7,10,7</Thickness> <!-- Text box, password box, dropdown: 34px -->
    <Thickness x:Key="MenuPadding">0,6,0,6</Thickness> <!-- Menu surface: rows run edge to edge, like the main menu list -->
    <Thickness x:Key="MenuItemPadding">16,8,24,8</Thickness> <!-- Menu item: 34px -->
    <Thickness x:Key="ComboBoxDropDownPadding">0,4,0,4</Thickness> <!-- Dropdown surface -->
    <Thickness x:Key="ComboBoxItemPadding">12,7,12,7</Thickness> <!-- Dropdown item -->
    <Thickness x:Key="ListBoxItemPadding">12,7,12,7</Thickness> <!-- List box item -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness> <!-- Group box body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,10</Thickness> <!-- Gap under the group box caption -->
    <Thickness x:Key="TooltipPadding">12,7,12,8</Thickness> <!-- Tooltip -->
    <sys:Double x:Key="IconSize">18</sys:Double> <!-- Top bar and sidebar icons -->
    <sys:Double x:Key="GameBannerHeight">360</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">260</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder where the Steam Screenshots plugin control will appear: a 16:9 main image over five 16:9
         thumbnails in the host's Foreground at low opacity, pulsing while visible. Host: a Control with Foreground set,
         hit testing off, next to the plugin's ContentControl. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" Background="{TemplateBinding Foreground}" Opacity="0.15" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <UniformGrid Width="1648" Height="173" Rows="1" Columns="5">
                    <Border Margin="0,0,48,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="0,0,48,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="0,0,48,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="0,0,48,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="0,0,48,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                </UniformGrid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Pulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Pulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
