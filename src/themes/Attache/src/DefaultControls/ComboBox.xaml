<!--
    Overlay on Playnite Default/DefaultControls/ComboBox.xaml.
    A choice field: black with a lifted hairline edge (InputBorderBrush), square, 34px (InputPadding), the value in warm
    text and a thin caret (IconDropDown) at the right. Warm grey edge under the pointer, warm white while focused or
    open. The list drops onto the menus' smoky options panel (LocalOptionsListPanelTemplate, ContextMenu.xaml) with 30px
    rows like Menu.xaml's (docs/themes/menus.md).
    PART_EditableTextBox and PART_Popup are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <DockPanel LastChildFill="False" Background="Transparent">
                                            <ToggleButton x:Name="FilterGroupIndicator" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                          Margin="0,0,-5,0" Background="Transparent" BorderThickness="0" Padding="0" Width="30" Height="28" VerticalAlignment="Center" Visibility="Collapsed"
                                                          IsHitTestVisible="False" Focusable="False" IsChecked="True"
                                                          Style="{DynamicResource ExpanderDownHeaderStyle}" />
                                            <ContentControl x:Name="FilterOriginalArrow" DockPanel.Dock="Right" Width="12" Height="12" Margin="0,0,12,0"
                                                            Focusable="False" IsTabStop="False" Foreground="{DynamicResource TextBrushDarker}"
                                                            Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconTemplate}" />
                                        </DockPanel>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType={x:Type FilterPanel}}, FallbackValue=False}" Value="True">
                                                <Setter TargetName="FilterOriginalArrow" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="FilterGroupIndicator" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- ComboBox-chevron-room: the value never runs under the chevron (12px + 12px margin + 8px gap = 32px kept clear). -->
                            <Border Margin="0,0,32,0" IsHitTestVisible="False">
                                <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            </Border>
                            <TextBox MinHeight="0" x:Name="PART_EditableTextBox" Visibility="Hidden" VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch" Margin="10,0,32,0" Focusable="True"
                                     Style="{DynamicResource BareTextBox}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" VerticalOffset="2" Focusable="False" AllowsTransparency="True">
                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                    <Control Template="{DynamicResource LocalOptionsListPanelTemplate}" Focusable="False" IsTabStop="False" />
                                    <ScrollViewer Margin="1,4,1,9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="ContentSite" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List rows: the menus' options rows (Menu.xaml) at 30px with a hairline under each. The pewter plate fades in and
         the label steps 3px left on IsHighlighted (pointer and keyboard), 0.16s in and 0.22s out; the chosen item keeps
         the amber "new" dot and its warm white label while another row is highlighted. -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid x:Name="ListRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="ListPlate" Template="{DynamicResource SelectionBarTemplate}" Opacity="0" Visibility="Collapsed"
                                 Background="{DynamicResource MenuItemHoverBrush}" Foreground="{DynamicResource SelectedSheenBrush}"
                                 BorderBrush="{DynamicResource SelectedBorderBrush}" IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                        <Grid Margin="14,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ListDot" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="{DynamicResource GlyphBrush}" Visibility="Collapsed" />
                            <ContentPresenter x:Name="ListLabel" Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="ListLabelStep" X="0" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="ListDot" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ListPlateIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ListLabelStep" Storyboard.TargetProperty="X" To="-3" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ListPlateOut">
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="ListLabelStep" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" TargetName="ListRow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
