<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is the options screen's list (LocalOptionsListPanelTemplate, shared by ComboBox.xaml,
    CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: the pause menu's darkened scene (PopupBackgroundBrush) with the theme's smoke mottling over it, a hairline
      edge, square, and the current options tab's mark (TabItemIndicatorTemplate: a 2px line bright in the middle and
      fading to both ends, a soft light rising above it) along the foot. Rows run edge to edge, 4px from the top and 6px
      clear of the mark. No shadow (WPF popups are layered windows).
    Rows, hairlines and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalOptionsListPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Rectangle Fill="{DynamicResource PopupBackgroundBrush}" />
            <Rectangle Opacity="0.45">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{ThemeFile 'Images/smoke.png'}" Stretch="UniformToFill" />
                </Rectangle.Fill>
            </Rectangle>
            <Control Margin="1,0,1,1" VerticalAlignment="Bottom" Template="{DynamicResource TabItemIndicatorTemplate}"
                     Foreground="{DynamicResource TabItemIndicatorBrush}" Focusable="False" IsTabStop="False" />
            <Border BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalOptionsListPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="1,4,1,9" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
