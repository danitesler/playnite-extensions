<!--
    Overlay on Playnite Default/DefaultControls/ProgressBar.xaml.
    A flat line: the hairline as the rail (ProgressBarTrackBrush), warm white as the fill (ProgressBarForegroundBrush),
    no edge, square. Indeterminate: a segment fading at both ends that sweeps across, drawn as the fill brush under a
    gradient OpacityMask so ThemeModifier edits reach it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="Root" ClipToBounds="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Rectangle Fill="{TemplateBinding Background}" />
                        <Rectangle Name="PART_Track" />
                        <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                            <Rectangle Fill="{TemplateBinding Foreground}" />
                        </Decorator>
                        <Rectangle x:Name="Sweep" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" RenderTransformOrigin="0,0">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="0.5" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="SweepMove" X="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Sweep" Property="Width" Value="160" />
                            <Setter TargetName="Sweep" Property="HorizontalAlignment" Value="Left" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Sweeping">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SweepMove" Storyboard.TargetProperty="X"
                                                         From="-160" To="900" Duration="0:0:1.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="Sweeping" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
