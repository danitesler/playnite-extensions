<!-- Attache: one yellow disclosure-arrow template shared by native game-list expanders and navigation trees. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ExpanderDownHeaderStyle" TargetType="ToggleButton" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <DockPanel>
                            <Grid Width="16" Height="16" DockPanel.Dock="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock x:Name="CollapsedIcon" Text="&#xeaa0;" FontFamily="{StaticResource FontIcoFont}"
                                           FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource GlyphBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="ExpandedIcon" Text="&#xea99;" FontFamily="{StaticResource FontIcoFont}" Visibility="Collapsed"
                                           FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource GlyphBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" RecognizesAccessKey="True" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CollapsedIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ExpandedIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
