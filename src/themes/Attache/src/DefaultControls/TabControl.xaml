<!--
    Overlay on Playnite Default/DefaultControls/TabControl.xaml.
    The Resident Evil 4 (2023) options screen: a strip of uppercase category words split by 1px vertical rules over a
    hairline; the current one in warm white over the tab mark (TabItemIndicatorTemplate: a line fading out at both
    ends with a soft light above it), the others in the inactive grey. With the strip on the left (Playnite's
    settings), the categories become the options list: rows with the pewter selection plate on the current one.
    PART_SelectedContentHost is Playnite's part.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnDefinition0" />
                            <ColumnDefinition x:Name="ColumnDefinition1" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" x:Name="RowDefinition0" />
                            <RowDefinition Height="*" x:Name="RowDefinition1" />
                        </Grid.RowDefinitions>
                        <Border x:Name="HeaderBorder" Background="{DynamicResource TabControlHeaderBackgroundBrush}"
                                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Panel.ZIndex="1" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <Border x:Name="ContentPanel" Grid.Column="0" Grid.Row="1"
                                KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local" Background="{DynamicResource ControlBackgroundBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition1" Value="Auto" />
                            <Setter Property="Grid.Row" TargetName="HeaderBorder" Value="1" />
                            <Setter Property="BorderThickness" TargetName="HeaderBorder" Value="0,1,0,0" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Grid.Column" TargetName="ContentPanel" Value="1" />
                            <Setter Property="Width" TargetName="ColumnDefinition0" Value="Auto" />
                            <Setter Property="Width" TargetName="ColumnDefinition1" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition1" Value="0" />
                            <Setter Property="BorderThickness" TargetName="HeaderBorder" Value="0,0,1,0" />
                            <Setter Property="Padding" TargetName="HeaderBorder" Value="0,8,0,8" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Grid.Column" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Width" TargetName="ColumnDefinition0" Value="*" />
                            <Setter Property="Width" TargetName="ColumnDefinition1" Value="Auto" />
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition1" Value="0" />
                            <Setter Property="Grid.Column" TargetName="HeaderBorder" Value="1" />
                            <Setter Property="BorderThickness" TargetName="HeaderBorder" Value="1,0,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="TabGrid" Background="Transparent">
                        <Control x:Name="Cursor" Template="{DynamicResource SelectionBarTemplate}" Visibility="Collapsed"
                                 Background="{DynamicResource SelectedBrush}" Foreground="{DynamicResource SelectedSheenBrush}" BorderBrush="{DynamicResource SelectedBorderBrush}"
                                 Focusable="False" IsTabStop="False" />
                        <Control x:Name="Underline" Template="{DynamicResource TabItemIndicatorTemplate}" VerticalAlignment="Bottom"
                                 Visibility="Collapsed" Foreground="{DynamicResource TabItemIndicatorBrush}" Focusable="False" IsTabStop="False" />
                        <!-- The 1px vertical rule after each tab of the strip. -->
                        <Rectangle x:Name="Divider" Width="1" Margin="0,8,0,8" HorizontalAlignment="Right"
                                   Fill="{DynamicResource WindowPanelSeparatorBrush}" />
                        <TextBlock x:Name="TextContent" Padding="22,10,22,12" Style="{DynamicResource BaseTextBlockStyle}"
                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                   Typography.Capitals="AllSmallCaps" Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter x:Name="ContentSite" RecognizesAccessKey="True" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Underline" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="Underline" />
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" TargetName="Underline" />
                            <Setter Property="RenderTransform" TargetName="Underline">
                                <Setter.Value>
                                    <ScaleTransform ScaleY="-1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="TabStripPlacement" Value="Left" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Underline" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Cursor" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="TabStripPlacement" Value="Right" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Underline" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Cursor" />
                        </MultiTrigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Divider" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="ContentSite" />
                            <Setter Property="Padding" Value="20,9,24,9" TargetName="TextContent" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Divider" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="ContentSite" />
                            <Setter Property="Padding" Value="20,9,24,9" TargetName="TextContent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
