<!--
    Overlay on Playnite Default/Views/ExplorerPanel.xaml.
    The explorer as an options list: the page black (ShellBackgroundBrush) with a hairline on the edge facing the
    library, the field chooser on top and the values below as ListBox rows (pewter plate on the current one).
    PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ExplorerPanel}">
        <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ExplorerPanel}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}" Background="{TemplateBinding Background}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ExplorerPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="12,12,8,10">
                                <Button Name="PART_ButtonClose" DockPanel.Dock="Right" Style="{StaticResource SimpleButton}"
                                        Width="28" Height="28" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <ContentControl Width="12" Height="12" Focusable="False" IsTabStop="False"
                                                    Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <ComboBox Name="PART_SelectFields" MaxDropDownHeight="Auto" DockPanel.Dock="Left" />
                            </DockPanel>
                            <ListBox Name="PART_SelectItems" DockPanel.Dock="Top" Margin="0,0,0,8" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
