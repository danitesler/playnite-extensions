<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml: the side panel of the grid view.
    The game page of DetailsViewGameOverview.xaml, narrowed: darkened scene banner, the name in small caps, the Play
    plate and square More and Edit buttons under it, then the description and notes beside one metadata pane whose
    captions sit above their values. A close button over the top left corner. Hand-maintained now (art/gamepage.py no longer
    reproduces this file).
    Every PART_ element of Playnite's file is kept.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border x:Name="PageRoot" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Empty state (no game selected): the attache case under a faint halo, smoke drifting behind it (the plate's smoke
                                 texture), a pulsing amber dot (the menus' "something new" dot) between the latches, Playnite's "No game selected" in the
                                 condensed face and the tab mark under it. Centered in the visible area; the loops run only while it shows
                                 (RemoveStoryboard on exit). -->
                            <Grid VerticalAlignment="Stretch">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                                    <Grid Width="360" Height="150" HorizontalAlignment="Center">
                                        <Rectangle Width="230" Height="230" Opacity="0.14" Fill="{DynamicResource SelectedForegroundBrush}">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/halo.png'}" Stretch="Fill" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <Grid ClipToBounds="True" IsHitTestVisible="False">
                                            <Canvas>
                                                <Rectangle Width="1100" Height="150" Opacity="0.2" Fill="{DynamicResource TextBrushDarker}">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/smoke.png'}" TileMode="Tile" Stretch="Fill"
                                                                    Viewport="0,0,512,150" ViewportUnits="Absolute" />
                                                    </Rectangle.OpacityMask>
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="SmokeDrift">
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)" From="0" To="-512" Duration="0:0:40" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <RemoveStoryboard BeginStoryboardName="SmokeDrift" />
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                            </Canvas>
                                            <!-- Soft edges for the smoke band: plain gradients to the page color, no masks. -->
                                            <Rectangle HorizontalAlignment="Left" Width="110">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle HorizontalAlignment="Right" Width="110">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00000000" Offset="0" />
                                                        <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle VerticalAlignment="Top" Height="40">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle VerticalAlignment="Bottom" Height="40">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0" />
                                                        <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                        <Canvas Width="132" Height="100">
                                            <Path Data="M44,18 L44,8 L88,8 L88,18" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1.5" />
                                            <Rectangle Canvas.Top="18" Width="132" Height="78" Fill="{DynamicResource ButtonBackgroundBrush}"
                                                       Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1.5" />
                                            <Rectangle Canvas.Top="44" Width="132" Height="1" Fill="{DynamicResource NormalBorderBrush}" />
                                            <Rectangle Canvas.Left="22" Canvas.Top="33" Width="14" Height="24" Fill="{DynamicResource PrimaryButtonBackgroundBrush}"
                                                       Stroke="{DynamicResource PrimaryButtonBorderBrush}" StrokeThickness="1" />
                                            <Rectangle Canvas.Left="96" Canvas.Top="33" Width="14" Height="24" Fill="{DynamicResource PrimaryButtonBackgroundBrush}"
                                                       Stroke="{DynamicResource PrimaryButtonBorderBrush}" StrokeThickness="1" />
                                            <Path Data="M6,90 L6,84 M6,90 L12,90 M126,90 L126,84 M126,90 L120,90" Stroke="{DynamicResource PrimaryButtonBorderBrush}" StrokeThickness="1" />
                                            <Ellipse Canvas.Left="62.5" Canvas.Top="41" Width="7" Height="7" Fill="{DynamicResource GlyphBrush}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="DotPulse">
                                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.8">
                                                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="DotPulse" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Canvas>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                               FontFamily="{DynamicResource HeadingFontFamily}" FontSize="22" Typography.Capitals="AllSmallCaps"
                                               Foreground="{DynamicResource HeadingForegroundBrush}" />
                                    <Control Template="{DynamicResource TabItemIndicatorTemplate}" Foreground="{DynamicResource TabItemIndicatorBrush}"
                                             Width="220" Height="16" HorizontalAlignment="Center" Margin="0,4,0,0" Focusable="False" IsTabStop="False" />
                                </StackPanel>
                            </Grid>
                            <ScrollViewer CanContentScroll="False" x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <Grid>
                                    <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                        <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                        <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <!-- The menus' scene treatment: darkened overall, darkest at the left where the words sit and toward the title. -->
                                        <Rectangle Fill="{DynamicResource ScrimBrush}" Opacity="0.35" />
                                        <Rectangle Fill="{DynamicResource ScrimBrush}">
                                            <Rectangle.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#CC000000" Offset="0" />
                                                    <GradientStop Color="#00000000" Offset="0.6" />
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <Rectangle Fill="{DynamicResource ScrimBrush}">
                                            <Rectangle.OpacityMask>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#00000000" Offset="0.3" />
                                                    <GradientStop Color="#CC000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <!-- No OpacityMask on the banner (see the details view): a plain gradient to the page color. -->
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#00000000" Offset="0.4" />
                                                    <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                    <StackPanel Margin="24,0,24,24">
                                        <Border IsHitTestVisible="False" MinHeight="8" x:Name="GridBannerSpacer">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 150 / 360'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="8" />
                                                        </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="8" />
</DataTrigger>
</Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <DockPanel Panel.ZIndex="2" Margin="0,16,0,16">
                                            <Button x:Name="InlineSidePanelCloseButton" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" Width="28" Height="28" Padding="0"
                                                Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}" Command="{MainViewModel CloseGameSideBarCommand}"
                                                Template="{Binding Template, ElementName=SidePanelCloseButton}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="{Binding Tag, ElementName=SidePanelCloseButton, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Visible` : `Collapsed`'}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                    <Button.RenderTransform>
                                                        <TranslateTransform Y="{Binding ContentVerticalOffset, ElementName=PART_ScrollViewHost}" />
                                                    </Button.RenderTransform>
                                            </Button>
                                            <Image x:Name="PART_ImageIcon" MaxHeight="32" MaxWidth="32" DockPanel.Dock="Left" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLargest}"
                                                       Typography.Capitals="AllSmallCaps" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SelectedForegroundBrush}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" MinWidth="180" Height="40" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" MinWidth="180" Height="40" />
                                                <Control Style="{DynamicResource RunningActionIndicator}" Height="40" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Width="40" Height="40" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Margin="8,0,0,0" Focusable="False" ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                        <Grid x:Name="GridOverviewBody">
<Grid.Tag>
    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400">
        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Tag" ElementName="GridMetadataContent" />
    </MultiBinding>
</Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                            <Grid x:Name="GridMetadataColumn" VerticalAlignment="Top">
<Grid.Style><Style TargetType="Grid">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="Margin" Value="24,0,0,0" />
    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </DataTrigger></Style.Triggers>
</Style></Grid.Style>
<StackPanel Margin="0,0,0,0" Tag="{DynamicResource GridDetailsPaneWidth}" x:Name="GridMetadataContent" HorizontalAlignment="Stretch">
<StackPanel.Style>
    <Style TargetType="StackPanel">
        <Setter Property="Width" Value="{DynamicResource GridDetailsPaneWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource GridDetailsPaneWidth}" /><Style.Triggers>
            <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /></DataTrigger>
        <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers>
    </Style>
</StackPanel.Style>
                                                <!-- Metadata pane: one column of six groups split by hairlines (the first rule is clipped away). -->
                                                <Border ClipToBounds="True" x:Name="GridMetadataViewport">
                                                    <WrapPanel x:Name="GridMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-33,0,-8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-33,-24,-8" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                        <Border x:Name="MetaProgress" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                    <Button Grid.Column="2" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextPlayTime" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextLastActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" />
                                                                    <TextBlock Grid.Column="2" x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" TextWrapping="Wrap" />
