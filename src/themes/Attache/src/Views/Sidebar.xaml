<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    The Resident Evil 4 (2023) menus: a compact vertical navigation rail on the left (repo rule, Playnite's default
    Sidebar position) in ShellBackgroundBrush with a hairline on the edge facing the library:
    a 44px rail, the main menu button in a 44x56 cell level with the top bar, a short rule under it, then the items
    (SidebarItem.xaml) as 44x40 compact icon buttons with 16px glyphs. The current item sits on the pewter selection plate.
    Top and bottom are fallbacks: a 56px strip with 148px kept clear for the caption buttons.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Main menu button: the menu glyph in the menu grey on a 44x56 cell; near white under the pointer. Also used by
         Views/TopPanel.xaml when the sidebar is hidden. -->
    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Width="44" Background="{DynamicResource ShellBackgroundBrush}"
                            BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,1,0">
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="Header" DockPanel.Dock="Top" Height="56">
                                <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}" HorizontalAlignment="Center">
                                    <ContentPresenter Width="20" Height="20"
                                                      Content="{DynamicResource IconMainMenu}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Border>
                            </Border>
                            <Rectangle x:Name="HeaderRule" DockPanel.Dock="Top" Height="1" Width="28" Margin="0,0,0,8"
                                       HorizontalAlignment="Center" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
                            <ScrollViewer x:Name="ScrollSidebarItems" DockPanel.Dock="Top"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="True">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Margin" Value="0,44,0,0" TargetName="Header" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="BorderContentHolder" />
                            <Setter Property="Width" Value="{x:Static sys:Double.NaN}" TargetName="BorderContentHolder" />
                            <Setter Property="Height" Value="56" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="Header" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderRule" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="8,0,148,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Width" Value="{x:Static sys:Double.NaN}" TargetName="BorderContentHolder" />
                            <Setter Property="Height" Value="56" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="Header" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderRule" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="8,0,0,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
