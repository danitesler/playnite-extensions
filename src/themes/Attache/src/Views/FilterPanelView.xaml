<!--
    Overlay on Playnite Default/Views/FilterPanelView.xaml.
    The filter panel as an options column: the page black (ShellBackgroundBrush) with a hairline on the edge facing the
    library, 16px gutters, a header row with Clear and the close cross in the idle grey, then Playnite's filter blocks.
    Only the FilterPanel template is restyled; the keyed helper styles stay Playnite's. PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FilterPanelFilterSearchBox" TargetType="SearchBox" BasedOn="{StaticResource FilterPanelFilterSearchBox}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border Style="{DynamicResource HighlightBorder}" Background="{TemplateBinding Background}">
                        <Grid>
                            <ContentControl x:Name="PART_SeachIcon" ContentTemplate="{DynamicResource SearchTextIconTemplate}" Visibility="Collapsed" />
                            <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}" MinHeight="0"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,28,0" />
                            <ContentControl x:Name="PART_ClearTextIcon" ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="FilterPanelFilterSelectionBox" TargetType="FilterSelectionBox" BasedOn="{StaticResource FilterPanelFilterSelectionBox}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="FilterPanelFilterEnumSelectionBox" TargetType="FilterEnumSelectionBox" BasedOn="{StaticResource FilterPanelFilterEnumSelectionBox}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="FilterPanelFilterStringSelectionBox" TargetType="FilterStringSelectionBox" BasedOn="{StaticResource FilterPanelFilterStringSelectionBox}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style TargetType="{x:Type FilterPanel}">
        <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPanel}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}" Background="{TemplateBinding Background}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings FilterPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <DockPanel Margin="16,14,10,10" DockPanel.Dock="Top">
                                <Button Name="PART_ButtonClose" DockPanel.Dock="Right" Style="{StaticResource SimpleButton}"
                                        Width="28" Height="28">
                                    <ContentControl Width="12" Height="12" Focusable="False" IsTabStop="False"
                                                    Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button Name="PART_ButtonClear" DockPanel.Dock="Left" HorizontalAlignment="Left"
                                        Content="{DynamicResource LOCClearFilters}" Style="{StaticResource SimpleButton}" />
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="8,0,6,8">
                                <Button Width="28" MinWidth="28" MaxWidth="28" Padding="0" Height="28" MinHeight="0" MaxHeight="28" x:Name="PART_ButtonDeleteFilter" Content="&#xec53;" Style="{DynamicResource FilterPresetButtonAction}" />
                                <Button Width="28" MinWidth="28" MaxWidth="28" Padding="0" Height="28" MinHeight="0" MaxHeight="28" x:Name="PART_ButtonRenameFilter" Content="&#xec55;" Style="{DynamicResource FilterPresetButtonAction}" />
                                <Button Width="28" MinWidth="28" MaxWidth="28" Padding="0" Height="28" MinHeight="0" MaxHeight="28" x:Name="PART_ButtonSaveFilter" Content="&#xee00;" Style="{DynamicResource FilterPresetButtonAction}" />
                                <ComboBox Height="28" MinHeight="0" x:Name="PART_ComboFilterPresets" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          DockPanel.Dock="Top" Padding="0,0,0,16">
                                <StackPanel x:Name="PART_PanelItemsHost" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
