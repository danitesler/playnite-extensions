<!--
    Overlay on Playnite Default/Views/Library.xaml.
    The main menu's scene: the selected game's background art (when Playnite shows it: Settings, Appearance) fills the
    whole library, behind the top bar too, and is darkened the way the pause menu darkens gameplay: black at 55% over
    all of it, deeper toward the left where the list sits (black at 80% at the left edge, gone by 55% of the width),
    and a shade along the top and bottom. All of it is ScrimBrush through opacity masks, inside a bitmap cache.
    The library itself has no fill, so the list and the covers float on the scene as the menu does.
    PART_ImageBackground and the PART_View* names are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <FadeImage x:Name="PART_ImageBackground" Grid.Row="0" Grid.RowSpan="2"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                            <Grid.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                            </Grid.CacheMode>
                            <Rectangle Fill="{DynamicResource ScrimBrush}" Opacity="0.55" />
                            <Rectangle Fill="{DynamicResource ScrimBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#CC000000" />
                                        <GradientStop Offset="0.55" Color="#00000000" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle Fill="{DynamicResource ScrimBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#99000000" />
                                        <GradientStop Offset="0.18" Color="#00000000" />
                                        <GradientStop Offset="0.85" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#99000000" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>

                        <TopPanel Grid.Row="0" />

                        <DockPanel Grid.Row="1" Background="{DynamicResource ContentBackgroundBrush}">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}" />

                            <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                           DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}" />

                            <Grid DockPanel.Dock="Left">
                                <LibraryDetailsView x:Name="PART_ViewDetails" />
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
