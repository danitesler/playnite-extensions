<!--
    Overlay on Playnite Default/Views/TopPanel.xaml.
    The top bar is the main menu's list laid on its side, floating on the scene with no bar of its own (transparent;
    the art's top shade in Views/Library.xaml keeps it legible). The search field sits at the left; Playnite's own
    items gather in the middle, where the view switches are menu entries in title case (khaki at rest, ivory on the
    feathered smudge when current), split by the button prompt bar's thin "|" separators (1px khaki, 16px tall), and
    flanked by the grouping, sorting and random icon buttons. Filters, notifications and a running task sit on the
    right, and 150px stay clear for the caption buttons. With the sidebar docked at the top the sidebar is that list,
    so this bar steps down to 48px.
    TopPanelMenu, the toggles and the item templates keep Playnite's keys. All PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <!-- The view switches: menu entries, the item's localized title in title case, at the menus' row size. -->
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <TextBlock Margin="14,0,14,2" VerticalAlignment="Center"
                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                   Text="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=TopPanelItem}}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <TextBlock Margin="14,0,14,2" VerticalAlignment="Center"
                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                   Text="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=TopPanelItem}}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <TextBlock Margin="14,0,14,2" VerticalAlignment="Center"
                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                   Text="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=TopPanelItem}}" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" TextElement.Foreground="{DynamicResource WarningBrush}" Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <!-- Looked up from code for the main menu and the top bar's dropdowns; the surface from DefaultControls/ContextMenu.xaml. -->
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <!-- Filters: an icon button; while a filter applies, its label shows and both turn ivory on the smudge, like the
         current entry. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="{TemplateBinding Background}" Padding="8,0,8,0"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" VerticalAlignment="Center"
                                              Content="{DynamicResource IconFilter}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <ContentPresenter x:Name="TextFilter" Margin="8,0,2,0" VerticalAlignment="Center"
                                              Content="{DynamicResource LOCFilterActiveLabel}">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" />
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Notifications: the bell with a small count badge in ivory on rust; hidden while there is nothing to show. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                              Content="{DynamicResource IconNotifications}" ContentTemplate="{DynamicResource IconTemplate}" />
                            <Border MinWidth="15" Height="15" Padding="4,0,4,0" Margin="0,3,2,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    CornerRadius="{DynamicResource CornerRadiusFull}"
                                    Background="{DynamicResource DangerBrush}">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="10" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                           Foreground="{DynamicResource DangerForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The search field of CustomControls/SearchBox.xaml, 280px wide and 34px tall. -->
    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Width" Value="280" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Border x:Name="Bar" Height="64" Padding="12,0,150,0" Background="{DynamicResource TopPanelBackgroundBrush}">
                        <DockPanel>
                            <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource MainMenuButton}"
                                    DockPanel.Dock="Left" Width="44" Margin="0,0,4,0">
                                <ContentPresenter Width="24" Height="24"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch" DockPanel.Dock="Left" Margin="4,0,12,0"
                                       Style="{StaticResource TopPanelSearchBox}"
                                       WindowChrome.IsHitTestVisibleInChrome="True" />

                            <CheckBox x:Name="PART_ToggleNotifications" DockPanel.Dock="Right"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" />

                            <CheckBox x:Name="PART_ToggleFilter" DockPanel.Dock="Right"
                                      ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" />

                            <!-- A running task: its caption over a 4px bar, then Cancel. Playnite collapses the parts
                                 while nothing runs, so this takes no room then. -->
                            <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="240" MinWidth="60" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Name="PART_TextProgressText" Margin="0,0,0,5"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextBrushDarker}"
                                               Style="{DynamicResource BaseTextBlockStyle}" />
                                    <ProgressBar Name="PART_ProgressGlobal" Height="4" />
                                </StackPanel>
                                <Button Name="PART_ButtonProgressCancel" Grid.Column="1"
                                        Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Margin="10,0,0,0" />
                            </Grid>

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="4,0,4,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <!-- The middle of the bar. Playnite adds two plain Canvas separators around the view switches;
                                 the implicit style draws each as the prompt bar's 1px "|", centered in its width. -->
                            <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Resources>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Height" Value="16" />
                                        <Setter Property="Margin" Value="8,0,8,0" />
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <DrawingBrush Stretch="None" AlignmentX="Center" AlignmentY="Center">
                                                    <DrawingBrush.Drawing>
                                                        <GeometryDrawing Brush="{DynamicResource TopPanelSeparatorBrush}">
                                                            <GeometryDrawing.Geometry>
                                                                <RectangleGeometry Rect="0,0,1,16" />
                                                            </GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </StackPanel.Resources>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Height" Value="48" TargetName="Bar" />
                            <Setter Property="Padding" Value="12,0,12,0" TargetName="Bar" />
                            <Setter Property="Background" Value="{DynamicResource TabControlHeaderBackgroundBrush}" TargetName="Bar" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
