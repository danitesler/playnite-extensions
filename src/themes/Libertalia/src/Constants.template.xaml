<!--
    Libertalia: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    The placeholders name values sampled from the Uncharted 4 menus (tokens.css). Theme XAML reads brushes only, never
    Color keys, so ThemeModifier edits reach every control.

    The look: black and near-black framed panels, muted khaki text at rest, warm ivory for the selected item, titles
    and checks, a feathered warm smudge behind the selected row, hairline rules, square corners, no accent hue.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Typography (Playnite keys). The game's 1080p scale (values 20, descriptions 22, rows 26 to 28, titles 30) is
        set down to a desktop scale: 12 / 14 / 16 / 19 / 30. One humanist face everywhere, title case.
    -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">19</sys:Double>
    <sys:Double x:Key="FontSizeLargest">33</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Constantia}}, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Constantia}}, Segoe UI</FontFamily>

    <!-- Shape (Playnite keys). Square everywhere. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:radius-full}}</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor is the ivory of a selected item: the menus have no accent hue, selection is brightness.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{text-description}}</Color>
    <Color x:Key="TextColorDarker">{{text-rest}}</Color>
    <Color x:Key="TextColorDark">{{text-on-ivory}}</Color>
    <Color x:Key="MainColor">{{popup}}</Color>
    <Color x:Key="MainColorDark">{{panel}}</Color>
    <Color x:Key="HoverColor">{{smudge-hover}}</Color>
    <Color x:Key="GlyphColor">{{text-selected}}</Color>
    <Color x:Key="HighlightGlyphColor">{{text-selected/25}}</Color>
    <Color x:Key="PopupBackgroundColor">{{popup}}</Color>
    <Color x:Key="PopupBorderColor">{{hairline}}</Color>
    <Color x:Key="BackgroundToneColor">{{panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{panel}}</Color>
    <Color x:Key="PanelSeparatorColor">{{panel-frame}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{hairline}}</Color>
    <Color x:Key="DataChangeNotifColor">{{warning}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{text-rest}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{{smudge-hover}}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{positive}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{danger}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{warning}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{vram-red}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{page}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!--
        Shell. The menus float straight on the scene; the scene here is the game's background art (Views/Library.xaml)
        over black. The rail and the top bar are see-through; panels (game page, side panels) are the options panel,
        a near-black fill in the panel frame color.
    -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{panel-translucent}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{text-rest}}" />

    <!-- States: the smudge behind the selected row (faded through an OpacityMask where it is drawn), ivory text -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{smudge}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{smudge-pressed}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{text-selected}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{smudge-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{smudge}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{smudge}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{text-selected}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{danger}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{text-selected}}" />

    <!-- Buttons: rows of text, the save slot frame (1px khaki, ivory when it is the one) for plates -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{text-selected}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{text-rest}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{smudge-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{smudge}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{smudge}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{smudge-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{smudge-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{text-main-selected}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{text-selected}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{smudge}}" />

    <!-- Inputs: a framed near-black field -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{panel-translucent}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{hairline}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{text-rest}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{text-rest}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{text-selected}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{slider-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{text-rest}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{text-selected}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{text-rest}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{text-selected}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{slider-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{text-rest}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{text-description}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{scroll-track}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{text-rest}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{text-description}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{smudge}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{smudge-hover}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{text-rest}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{text-selected}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{smudge-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{smudge}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{text-description}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{smudge-hover}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{panel-frame}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{text-description}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{hairline}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{text-selected}}" />

    <!-- Main menu: the black that darkens the scene, section titles, the options panel frame (6px at 1080p), the game page surface -->
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{text-rest}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{text-selected}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{panel-frame}}" />
    <Thickness x:Key="FrameThickness">3</Thickness>
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{panel-translucent}}" />
</ResourceDictionary>
