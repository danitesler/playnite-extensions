<!--
    Libertalia: ContextMenu. Every popup menu and dropdown list (hamburger menu, top bar dropdowns via TopPanelMenu,
    GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select boxes) wears
    Uncharted 4's options panel (LocalOptionsPanelTemplate): near-black PopupBackgroundBrush inside a 1px hairline
    (PopupBorderBrush) with a 3px inner matte frame (PanelSeparatorBrush, the game's 6px frame at menu scale) and a
    quiet fading ivory hairline across the top edge (the rule under "Paused"). Rows start 8px down.
    Rows and the 10px compass-tick rule are in Menu.xaml.
    Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalOptionsPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1" />
            <!-- 3px inner matte frame (Uncharted 4's options panel frame at menu scale) -->
            <Border Margin="1" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="3" />
            <!-- Quiet fading ivory hairline along the top (the rule under "Paused") -->
            <Rectangle Height="1" Margin="14,5,14,0" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" Opacity="0.45">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="0.2" Color="#FF000000" />
                        <GradientStop Offset="0.8" Color="#FF000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalOptionsPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,9,0,7" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="5,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
