<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    Spacing follows the Uncharted 4 menus (1080p captures): rows of 26 to 28px type on a 43 to 48px pitch, so about
    10px above and below the text; the selected entry moves 45px in. Playnite's controls use 14px type, so paddings
    are the game's scaled by about 0.55 and the indent is 6 to 8px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menus and dropdowns: the options panel (near-black, square) with a 1px hairline edge instead of its 6px frame. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: the game shows focus as the selected row; here a 1px ivory edge inside the control (keyboard only). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: the same edge, 3px outside the box. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading: an options section header ("Display Settings"), ivory, title case, larger than the rows. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Component spacing, keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">16,5,16,5</Thickness>          <!-- save slot text inset, scaled (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">8,5,8,5</Thickness>             <!-- value field, 32px tall (height now set by ControlHeight) -->
    <Thickness x:Key="MenuPadding">0,8,0,8</Thickness>              <!-- options panel inset above and below the rows -->
    <Thickness x:Key="MenuItemPadding">14,8,14,8</Thickness>        <!-- pause menu rows: 10px around 26px type, scaled -->
    <Thickness x:Key="ComboBoxDropDownPadding">0,8,0,8</Thickness>  <!-- as MenuPadding -->
    <Thickness x:Key="ComboBoxItemPadding">16,8,16,8</Thickness>    <!-- as MenuItemPadding, a little wider -->
    <Thickness x:Key="ListBoxItemPadding">10,6,10,6</Thickness>     <!-- options rows, 30px -->
    <Thickness x:Key="GroupBoxPadding">8,0,0,12</Thickness>         <!-- rows sit in from their section header -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,10</Thickness>    <!-- header hairline to first row -->
    <Thickness x:Key="TooltipPadding">10,7,10,8</Thickness>         <!-- description line, boxed -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">20</sys:Double>                    <!-- prompt glyphs, about 24px at 1080p -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art band on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five 16:9
         thumbnails, so the real carousel replaces it without the page jumping. Square, like every frame in the menus. Each Viewbox scales a fixed 1600px layout to its column's width. The tiles are the host's Foreground
         at low opacity; the whole thing pulses while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="0"
                        Background="{TemplateBinding Foreground}" Opacity="0.14" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="2" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="4" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="6" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="8" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- menu-mark begin LocalLibertaliaMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a pirate spyglass, an eyepiece and two tubes ending in a lens lip. Hover (IsMouseOver): the spyglass telescopes out, the second tube 1.5px, the third 3px and the lens lip 4.5px, 30ms apart (BackEase 0.22s). Open (ContextMenu.IsOpen of the nearest Border): a four-point glint pops on the lens and twinkles (0.6s, auto-reversed) until the menu closes; exits restore every property. -->
    <ControlTemplate x:Key="LocalLibertaliaMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="29" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Rectangle x:Name="Eye" Canvas.Left="3" Canvas.Top="6.5" Width="5" Height="5" RadiusX="1" RadiusY="1" Fill="{TemplateBinding Foreground}" />
                <Rectangle x:Name="S2" Canvas.Left="9" Canvas.Top="5" Width="6" Height="8" RadiusX="1" RadiusY="1" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="S2T" X="0" Y="0" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="S3" Canvas.Left="16" Canvas.Top="3.5" Width="6" Height="11" RadiusX="1" RadiusY="1" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="S3T" X="0" Y="0" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="Lip" Canvas.Left="23" Canvas.Top="2" Width="3" Height="14" RadiusX="1" RadiusY="1" Fill="{TemplateBinding Foreground}">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="LipT" X="0" Y="0" /></Rectangle.RenderTransform>
                </Rectangle>
                <Canvas x:Name="Star" Width="29" Height="18" RenderTransformOrigin="0.948,0.5" Opacity="0">
                    <Canvas.RenderTransform><ScaleTransform x:Name="StarS" ScaleX="0.2" ScaleY="0.2" /></Canvas.RenderTransform>
                    <Path Data="M27.5,5 L28.4,8.1 L31.5,9 L28.4,9.9 L27.5,13 L26.6,9.9 L23.5,9 L26.6,8.1Z" Fill="{DynamicResource GlyphBrush}" />
                </Canvas>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="S2T" Storyboard.TargetProperty="X" To="1.5" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="S3T" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.220" BeginTime="0:0:0.030"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LipT" Storyboard.TargetProperty="X" To="4.5" Duration="0:0:0.220" BeginTime="0:0:0.060"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="S2T" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="S3T" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LipT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.176" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="StarS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.300"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StarS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.300"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Star" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.600" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="StarS" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.240" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="StarS" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.240" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Star" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.480" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalLibertaliaMenuMarkTemplate -->
</ResourceDictionary>
