<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    Spacing follows the Counter-Strike 2 Panorama rules each value is taken from (quoted per key). Panorama draws at a
    1080p reference with 16 to 28px type; Playnite's controls use 14px type, so paddings are the game's scaled by
    about 0.7 where noted and kept as they are where they are already small.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menus and dropdowns: SimpleContextMenu .ContextMenuBody (contextMenuBackground, border-radius btnBorderRadius)
         with the 1px edge WPF popups keep (.PopupPanel border rgb(65,65,65)). -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: the game draws none; a 1px selectedNavColor edge inside the control (keyboard only). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: the same edge, 3px outside the box. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading (.SettingsSectionTitleLabel: Stratum2 Black, italic, rgba(222,222,222,0.4)); callers pass capitals. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Component spacing, keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">14,7,14,7</Thickness>          <!-- .PopupButton Label margin 10px 12px 8px, x0.7 -->
    <Thickness x:Key="InputPadding">8,6,8,6</Thickness>             <!-- TextEntry padding 6px 16px 6px 6px, height 36 -->
    <Thickness x:Key="MenuPadding">0,8,0,8</Thickness>              <!-- .ContextMenuBody padding 8px 0px -->
    <Thickness x:Key="MenuItemPadding">14,8,14,8</Thickness>        <!-- .ContextMenuBody Button padding 8px 14px -->
    <Thickness x:Key="ComboBoxDropDownPadding">0,8,0,8</Thickness>  <!-- DropDownMenu padding 8px 0px -->
    <Thickness x:Key="ComboBoxItemPadding">16,8,16,8</Thickness>    <!-- DropDownMenu Label padding 8px 16px -->
    <Thickness x:Key="ListBoxItemPadding">10,6,10,6</Thickness>     <!-- .mainmenu-content__container__sidebar__btn Label padding 8px, 32px rows -->
    <Thickness x:Key="GroupBoxPadding">8,0,0,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>    <!-- .SettingsSectionTitleContianer margin-bottom 12px -->
    <Thickness x:Key="TooltipPadding">10,8,10,6</Thickness>         <!-- .ShortTextTooltip #Contents padding 8px 10px 6px 10px -->
    <sys:Double x:Key="IconSize">20</sys:Double>                    <!-- .mainmenu-top-navbar__radio-btn__icon 22px -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double> <!-- Height of the background art band on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five 16:9
         thumbnails, so the real carousel replaces it without the page jumping. Square 2px corners, like the game's
         tiles. Each Viewbox scales a fixed 1600px layout to its column's width. The tiles are the host's Foreground
         at low opacity; the whole thing pulses while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="4"
                        Background="{TemplateBinding Foreground}" Opacity="0.14" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="2" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="4" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="6" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="8" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
