<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    Spacing follows the Uncharted 4 menus (1080p captures): rows of 26 to 28px type on a 43 to 48px pitch, so about
    10px above and below the text; the selected entry moves 45px in. Playnite's controls use 14px type, so paddings
    are the game's scaled by about 0.55 and the indent is 6 to 8px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menus and dropdowns: the options panel (near-black, square) with a 1px hairline edge instead of its 6px frame. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: the game shows focus as the selected row; here a 1px ivory edge inside the control (keyboard only). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: the same edge, 3px outside the box. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading: an options section header ("Display Settings"), ivory, title case, larger than the rows. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Component spacing, keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">16,6,16,7</Thickness>          <!-- save slot text inset, scaled -->
    <Thickness x:Key="InputPadding">8,6,8,6</Thickness>             <!-- value field, 32px tall -->
    <Thickness x:Key="MenuPadding">0,8,0,8</Thickness>              <!-- options panel inset above and below the rows -->
    <Thickness x:Key="MenuItemPadding">14,8,14,8</Thickness>        <!-- pause menu rows: 10px around 26px type, scaled -->
    <Thickness x:Key="ComboBoxDropDownPadding">0,8,0,8</Thickness>  <!-- as MenuPadding -->
    <Thickness x:Key="ComboBoxItemPadding">16,8,16,8</Thickness>    <!-- as MenuItemPadding, a little wider -->
    <Thickness x:Key="ListBoxItemPadding">10,6,10,6</Thickness>     <!-- options rows, 30px -->
    <Thickness x:Key="GroupBoxPadding">8,0,0,12</Thickness>         <!-- rows sit in from their section header -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,10</Thickness>    <!-- header hairline to first row -->
    <Thickness x:Key="TooltipPadding">10,7,10,8</Thickness>         <!-- description line, boxed -->
    <sys:Double x:Key="IconSize">20</sys:Double>                    <!-- prompt glyphs, about 24px at 1080p -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double> <!-- Height of the background art band on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five 16:9
         thumbnails, so the real carousel replaces it without the page jumping. Square, like every frame in the menus. Each Viewbox scales a fixed 1600px layout to its column's width. The tiles are the host's Foreground
         at low opacity; the whole thing pulses while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="0"
                        Background="{TemplateBinding Foreground}" Opacity="0.14" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="2" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="4" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="6" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="8" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
