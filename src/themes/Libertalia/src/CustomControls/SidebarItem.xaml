<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    On the rail: a 40px cell with a 20px glyph, khaki (#7B725E) at rest, ivory under the pointer over the smudge at
    half strength, and the current item's glyph ivory (#F0E6C6) on the full feathered smudge (#2F2B22, a soft oval),
    the selected entry of the main menu. Library is a compass (IconLibrary), Statistics IconStatistics; add-on items
    keep their own icon, scaled into the 20px box. The title is the tooltip.
    Docked at the top or bottom, views become menu entries in title case (ivory on the smudge when current) and
    buttons stay icons. PART_ProgressStatus is a 2px bar along the bottom of the cell.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="48" />
        <Setter Property="ToolTip" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Grid x:Name="Plate" Width="48" Height="44">
                            <Rectangle x:Name="Smudge" Fill="{TemplateBinding Background}" IsHitTestVisible="False">
                                <Rectangle.OpacityMask>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Offset="0" Color="#FF000000" />
                                        <GradientStop Offset="0.55" Color="#B0000000" />
                                        <GradientStop Offset="1" Color="#00000000" />
                                    </RadialGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Grid>
                                <Grid x:Name="IconHost" Width="20" Height="20"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox x:Name="ItemIcon">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    </Viewbox>
                                    <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                    ContentTemplate="{DynamicResource IconTemplate}" />
                                </Grid>
                                <ProgressBar x:Name="PART_ProgressStatus" Height="2" VerticalAlignment="Bottom"
                                             BorderThickness="0" Background="Transparent" />
                            </Grid>
                        </Grid>
                        <Rectangle x:Name="LabelSmudge" Visibility="Collapsed" Fill="{TemplateBinding Background}" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                    <GradientStop Offset="0" Color="#FF000000" />
                                    <GradientStop Offset="0.55" Color="#B0000000" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </RadialGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock x:Name="Label" Visibility="Collapsed" Margin="16,0,16,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{Binding Title}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource SelectedBrush}" TargetName="Smudge" />
                            <Setter Property="Fill" Value="{DynamicResource SelectedBrush}" TargetName="LabelSmudge" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" TargetName="IconHost" />
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="Label" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <!-- Docked at the top or bottom: a view is a text tab over the full height of the strip. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings SidebarPosition}" Value="Top" />
                                <Condition Binding="{Binding Type}" Value="View" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Plate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Label" />
                            <Setter Property="Visibility" Value="Visible" TargetName="LabelSmudge" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings SidebarPosition}" Value="Bottom" />
                                <Condition Binding="{Binding Type}" Value="View" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Plate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Label" />
                            <Setter Property="Visibility" Value="Visible" TargetName="LabelSmudge" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Settings SidebarPosition}" Value="Top" />
                    <Condition Binding="{Binding Type}" Value="View" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="64" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Settings SidebarPosition}" Value="Bottom" />
                    <Condition Binding="{Binding Type}" Value="View" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="64" />
            </MultiDataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
