<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    On the rail: a navbar icon button (.mainmenu-top-navbar__radio-iconbtn), a 40px plate with a 20px glyph; the glyph
    in secondary text at rest, the plate washed rgba(255,255,255,0.10) under the pointer, and the current item's glyph in
    selectedNavColor on the content tabs' selected wash (#82d7ff1a). Library is the navbar's home glyph (IconLibrary),
    Statistics IconStatistics; add-on items keep their own icon, scaled into the 20px box. The title is the tooltip.
    Docked at the top or bottom, views become the navbar's text tabs (.mainmenu-top-navbar__radio-btn: condensed
    capitals, 18px side padding, selectedNavColor when current) and buttons stay icons.
    PART_ProgressStatus is a 2px bar along the bottom of the plate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="48" />
        <Setter Property="ToolTip" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="Plate" Width="40" Height="40" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Grid>
                                <Grid x:Name="IconHost" Width="20" Height="20"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox x:Name="ItemIcon">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    </Viewbox>
                                    <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                    ContentTemplate="{DynamicResource IconTemplate}" />
                                </Grid>
                                <ProgressBar x:Name="PART_ProgressStatus" Height="2" VerticalAlignment="Bottom"
                                             BorderThickness="0" Background="Transparent" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="Label" Visibility="Collapsed" Margin="16,0,16,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{Binding Title, Converter={StaticResource StringToUpperCaseConverter}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" TargetName="Plate" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" TargetName="IconHost" />
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="Label" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <!-- Docked at the top or bottom: a view is a text tab over the full height of the strip. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings SidebarPosition}" Value="Top" />
                                <Condition Binding="{Binding Type}" Value="View" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Plate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Label" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings SidebarPosition}" Value="Bottom" />
                                <Condition Binding="{Binding Type}" Value="View" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Plate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Label" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Settings SidebarPosition}" Value="Top" />
                    <Condition Binding="{Binding Type}" Value="View" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="64" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Settings SidebarPosition}" Value="Bottom" />
                    <Condition Binding="{Binding Type}" Value="View" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="64" />
            </MultiDataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
