<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml.
    Covers as the save slots of the Save Game screen: square, a 1px khaki edge (#7B725E) under the pointer and a 2px
    ivory edge (#F0E6C6) on the selected one. The edge sits just outside the cover so nothing gets clipped.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <ContentPresenter />
                        <Border x:Name="SelectionBorder" BorderThickness="1" Margin="-1" IsHitTestVisible="False" />
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="6" Opacity="0.16" />
                            <Rectangle x:Name="RunningScan" Visibility="Collapsed" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" IsHitTestVisible="False">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform x:Name="RunningScanShift" X="-0.75" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#00000000" Offset="0.25" />
                                        <GradientStop Color="#FF000000" Offset="0.5" />
                                        <GradientStop Color="#00000000" Offset="0.75" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                            <Grid Height="22" Margin="6,0,6,6" VerticalAlignment="Bottom">
                                <Border Background="{DynamicResource ScrimBrush}" Opacity="0.88" />
                                <Grid Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="15">
                                    <Path x:Name="RunningSparkA" Width="11" Height="11" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Fill"
                                          Data="M5,0 C5.4,3.6 6.4,4.6 10,5 C6.4,5.4 5.4,6.4 5,10 C4.6,6.4 3.6,5.4 0,5 C3.6,4.6 4.6,3.6 5,0 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform x:Name="RunningSparkAScale" ScaleX="0.7" ScaleY="0.7" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <Path x:Name="RunningSparkB" Width="7" Height="7" Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill"
                                          Data="M5,0 C5.4,3.6 6.4,4.6 10,5 C6.4,5.4 5.4,6.4 5,10 C4.6,6.4 3.6,5.4 0,5 C3.6,4.6 4.6,3.6 5,0 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform x:Name="RunningSparkBScale" ScaleX="0.7" ScaleY="0.7" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                                <Grid Height="2" Margin="28,0,6,4" VerticalAlignment="Bottom">
                                    <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                    <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemHoverBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="BorderThickness" Value="2" TargetName="SelectionBorder" />
                            <Setter Property="Margin" Value="-2" TargetName="SelectionBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.37,0 0.63,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanShift" Storyboard.TargetProperty="X" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.75" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.75" KeySpline="0.37,0 0.63,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.75" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningSparkAScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1.35" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningSparkAScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1.35" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningSparkA" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningSparkBScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.27" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.42" Value="1.2" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.82" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningSparkBScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.27" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.42" Value="1.2" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.82" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningSparkB" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.27" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.42" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.82" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningSparkAScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1.15" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.8" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.8" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningSparkAScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1.15" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.8" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.8" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningSparkA" Storyboard.TargetProperty="Opacity" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningSparkBScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.12" Value="1.15" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.82" Value="0.8" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.8" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningSparkBScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.12" Value="1.15" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.82" Value="0.8" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.8" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningSparkB" Storyboard.TargetProperty="Opacity" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.12" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.82" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the scan has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
