{
    "_comment": "Icons this theme ships: Material Symbols, Sharp style, filled (Apache-2.0, google/material-design-icons, symbols/web). Solid, square-cornered glyphs are the closest open set to the solid white navbar icons of the Counter-Strike 2 main menu, whose own icons are Valve's and are not bundled. The Geometry job writes icons.generated.xaml (not committed): paste its entries into src/Media.xaml; the geometries in Media.xaml are shifted onto a 0..960 grid (the SVGs draw on 0,-960..960,0), so IconTemplate needs no offset. The Png jobs write the menu icons Media.xaml maps to files, in baseText, t-color for the favorite star and negativeColor for quit and remove (src/tokens.css); re-run after changing them. Render with .\\scripts\\render-icons.ps1 -Extension clutch (Windows). IconMainMenu is not from the set: it is this theme's crosshair mark, drawn by hand in Media.xaml.",
    "jobs": [
        {
            "_comment": "Icon<Role> geometries drawn by IconTemplate.",
            "urlTemplate": "https://raw.githubusercontent.com/google/material-design-icons/{ref}/symbols/web/{name}/materialsymbolssharp/{name}_fill1_24px.svg",
            "ref": "master",
            "format": "Geometry",
            "keyPrefix": "Icon",
            "xamlOut": "icons.generated.xaml",
            "icons": [
                "search=Search", "close=Clear", "tune=ViewSettings", "bookmarks=FilterPresets", "stacks=Group",
                "sort=Sort", "vertical_split=DetailsView", "grid_view=GridView", "view_list=ListView",
                "download=Update", "account_tree=Explorer", "casino=Random", "shuffle=ViewRandom", "filter_alt=Filter",
                "notifications=Notifications", "home=Library", "leaderboard=Statistics", "remove=WindowMinimize",
                "check_box_outline_blank=WindowMaximize", "filter_none=WindowRestore", "close=WindowClose",
                "expand_more=DropDown", "chevron_right=Submenu", "check=Check", "add=Add", "edit=Edit",
                "delete=Remove", "settings=Options", "play_arrow=Play", "info=Info", "download=Download"
            ]
        },
        {
            "_comment": "Menu icons: Media.xaml maps Playnite's *Icon keys to these files. 48px in baseText.",
            "urlTemplate": "https://raw.githubusercontent.com/google/material-design-icons/{ref}/symbols/web/{name}/materialsymbolssharp/{name}_fill1_24px.svg",
            "ref": "master",
            "format": "Png",
            "outDir": "src/Images/Material",
            "size": 48,
            "color": "#cccccc",
            "icons": [
                "fullscreen", "add", "sync", "info", "settings", "extension", "play_arrow=play", "download", "link",
                "folder_open=folder", "hard_drive=storage", "desktop_windows=desktop", "visibility_off=hide",
                "visibility=unhide", "hdr_on=hdr", "edit", "casino=dice", "menu_book=manual", "archive=backup",
                "history=restore"
            ]
        },
        {
            "_comment": "The outlined star (add to favorites), from the unfilled file.",
            "urlTemplate": "https://raw.githubusercontent.com/google/material-design-icons/{ref}/symbols/web/{name}/materialsymbolssharp/{name}_24px.svg",
            "ref": "master",
            "format": "Png",
            "outDir": "src/Images/Material",
            "size": 48,
            "color": "#cccccc",
            "icons": [ "star" ]
        },
        {
            "_comment": "The filled star (remove from favorites), in the game's T gold.",
            "urlTemplate": "https://raw.githubusercontent.com/google/material-design-icons/{ref}/symbols/web/{name}/materialsymbolssharp/{name}_fill1_24px.svg",
            "ref": "master",
            "format": "Png",
            "outDir": "src/Images/Material",
            "size": 48,
            "color": "#eabe54",
            "icons": [ "star=star-fill" ]
        },
        {
            "_comment": "Quit (the game's navbar quit button is a power symbol) and remove, in negativeColor.",
            "urlTemplate": "https://raw.githubusercontent.com/google/material-design-icons/{ref}/symbols/web/{name}/materialsymbolssharp/{name}_fill1_24px.svg",
            "ref": "master",
            "format": "Png",
            "outDir": "src/Images/Material",
            "size": 48,
            "color": "#db4437",
            "suffix": "-danger",
            "icons": [ "power_settings_new=power", "delete" ]
        }
    ]
}
