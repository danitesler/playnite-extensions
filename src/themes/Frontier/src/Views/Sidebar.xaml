<!--
    Overlay on Playnite Default/Views/Sidebar.xaml. The Red Dead Redemption 2 pause menu: a red painted panel
    (ShellBackgroundBrush, panel red c00000) down the left edge of the window, its right side a ragged dry-brush edge,
    the menu items stacked on it as black glyphs with the current one in white (CustomControls/SidebarItem.xaml).
    Rail = 10px gutter + 44px items + 10px gutter = 64px, plus a 10px ragged edge (an original path, stretched to the
    window height) in the same brush. The main menu button (MainMenuButton, defined here, also used by
    Views/TopPanel.xaml when the sidebar is hidden) sits at the top like the game's pocket-watch emblem: a black glyph
    (MainMenuButtonForegroundBrush) that turns white on hover; items start 64px down.
    Right: the panel mirrors (edge on its left) and starts 56px down so the window buttons stay clear.
    Top and bottom: a 56px red strip without the ragged edge; the top strip keeps 160px clear for the window buttons.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid x:Name="Root" Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="EdgeLeftColumn" Width="0" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="EdgeRightColumn" Width="10" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BorderContentHolder" Grid.Column="1" Background="{DynamicResource ShellBackgroundBrush}">
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                        DockPanel.Dock="Top" Margin="10,10,10,10">
                                    <ContentPresenter Width="22" Height="22"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Content="{DynamicResource IconMainMenu}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Border>

                                <!-- The gutter is the panel's margin: the scroll presenter clips at its own edge. -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" Margin="10,0,10,10" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Path x:Name="Edge" Grid.Column="2" Stretch="Fill" SnapsToDevicePixels="False" IsHitTestVisible="False"
                              Fill="{DynamicResource ShellBackgroundBrush}"
                              Data="M 0,0 L 5.6,0 L 3.1,3.3 L 3.6,7.6 L 6.1,11.8 L 3.1,15.1 L 8.6,18.5 L 9.5,21.6 L 8.1,24.2 L 7.7,27.5 L 5.8,30.6 L 5.3,34.8 L 7.2,39.5 L 6.1,42 L 5.2,46.6 L 3.3,49.3 L 8.9,53.5 L 5.1,58.7 L 4.3,64.7 L 8.3,69.7 L 2.5,74.3 L 4.4,77.1 L 5.5,81.4 L 9.7,85.3 L 2.8,91.2 L 6.6,95.4 L 9.6,99.9 L 4.5,103.6 L 5.6,109.5 L 9.1,114.4 L 9.6,117.6 L 5,121.8 L 9.8,126.3 L 4,129.9 L 6.4,132.4 L 8.8,135.5 L 7.1,138.7 L 6.4,142 L 8.6,147.8 L 6.4,152.7 L 6.7,155.5 L 3.6,158.1 L 3,161.6 L 8.4,164.1 L 8.7,167.6 L 5.2,171.8 L 6.5,175.6 L 5.1,181.3 L 7.8,185.3 L 3.2,191 L 7.9,195.5 L 5.3,199.2 L 7.4,203.9 L 4.6,207.2 L 3.3,210.3 L 4.6,213.4 L 4.9,217 L 9.1,222.5 L 5.9,228.2 L 4.2,232.7 L 3.6,236 L 3.3,239 L 9.5,240 L 0,240 Z" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Main menu hidden (it is in the top bar): the items still start below the top bar. -->
                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemMainMenu}" Value="Collapsed">
                            <Setter Property="Margin" Value="0,64,0,0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,56,0,0" />
                            <Setter Property="Width" Value="10" TargetName="EdgeLeftColumn" />
                            <Setter Property="Width" Value="0" TargetName="EdgeRightColumn" />
                            <Setter Property="Grid.Column" Value="0" TargetName="Edge" />
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" TargetName="Edge" />
                            <Setter Property="RenderTransform" TargetName="Edge">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="-1" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Margin" Value="0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Width" Value="0" TargetName="EdgeRightColumn" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Edge" />
                            <Setter Property="Margin" Value="10,6,4,6" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,160,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="4,6,4,6" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Width" Value="0" TargetName="EdgeRightColumn" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Edge" />
                            <Setter Property="Margin" Value="10,6,4,6" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="4,6,4,6" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
