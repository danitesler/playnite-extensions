<!--
    Frontier: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    The Red Dead Redemption 2 menus: near-black pages (page 080808), flat dark list rows (row 1c1c1c), white type with
    light and dim greys, the red of the pause panel (red c00000) on the rail and the Play button, and the red selection
    frame (red-frame d80419) around whatever is selected or focused. Square corners throughout. Gold only for the star.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). Placeholder syntax: see reference.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): row labels 14, section headers 20, screen titles 30 (1080p sizes x 2/3). -->
    <sys:Double x:Key="FontSizeSmall">{{px:rdr-text-sm}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:rdr-text-md}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:rdr-text-lg}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:rdr-text-xl}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:rdr-text-2xl}}</sys:Double>
    <!-- Hapna Slab Serif (body) and RDR Lino (titles) when installed (a theme cannot ship fonts, and RDR Lino is
         Rockstar's); otherwise free slabs, then Rockwell and Georgia, which Windows has. -->
    <FontFamily x:Key="FontFamily">Hapna Slab Serif, Zilla Slab, Roboto Slab, Rockwell, Georgia</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">RDR Lino, Rockwell, Georgia</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys): square corners; hairline edges where the game has any. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">0</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:rdr-radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">0</CornerRadius>
    <!-- The selection frame: about 4px at 1080p -->
    <Thickness x:Key="FrameThickness">{{px:rdr-frame}}</Thickness>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor (selection, checked, links) is the frame red; TextColorDark is the black ink of the pause panel.
        MainColor is a list row, MainColorDark the page.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{rdr-text}}</Color>
    <Color x:Key="TextColorDarker">{{rdr-text-dim}}</Color>
    <Color x:Key="TextColorDark">{{rdr-ink}}</Color>
    <Color x:Key="MainColor">{{rdr-row}}</Color>
    <Color x:Key="MainColorDark">{{rdr-page}}</Color>
    <Color x:Key="HoverColor">{{rdr-row-hover}}</Color>
    <Color x:Key="GlyphColor">{{rdr-red-frame}}</Color>
    <Color x:Key="HighlightGlyphColor">{{rdr-red-frame/40}}</Color>
    <Color x:Key="PopupBackgroundColor">{{rdr-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{rdr-edge}}</Color>
    <Color x:Key="BackgroundToneColor">{{rdr-row}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{rdr-box}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{rdr-edge}}</Color>
    <Color x:Key="DataChangeNotifColor">{{rdr-gold}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{rdr-track}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{rdr-panel}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{rdr-row}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{rdr-good}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{rdr-red-frame}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{rdr-warning}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{rdr-warning}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{rdr-box}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{rdr-page}}" />

    <!-- Shell: the rail is the pause menu's red panel, the views sit on the sub-screen near-black -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{rdr-red}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{rdr-page}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{rdr-page}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{rdr-row}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{rdr-row-hover}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{rdr-rule}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{rdr-ink}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{rdr-page}}" />

    <!-- States: selection is the red frame around a dark row with white text; hover lifts the row -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{rdr-red-frame}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{rdr-text}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{rdr-row-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{rdr-row}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{rdr-row}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{rdr-red-frame}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{rdr-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{rdr-text}}" />

    <!-- Buttons: a dark row with white type; Play is the red slab with white type -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{rdr-text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{rdr-row-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{rdr-row-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{rdr-red}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{rdr-red-frame}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{rdr-red-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{rdr-text}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{rdr-row-hover}}" />

    <!-- Inputs: a list row; the frame red marks focus -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{rdr-row}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{rdr-row-hover}}" />

    <!-- Controls: white box and tick, white slider fill on the dark rail, white progress -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{rdr-text-soft}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{rdr-text}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{rdr-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{rdr-text}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{rdr-text}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{rdr-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{rdr-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{rdr-rule}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{rdr-track}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{rdr-rule}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{rdr-red-frame}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{rdr-rule}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{rdr-red-frame}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{rdr-row}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{rdr-row}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{rdr-text-soft}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{rdr-row-hover}}" />

    <!-- Popups: the inkroller panel -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{rdr-edge}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{rdr-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{rdr-edge}}" />

    <!-- Section headings: RDR Lino in white, with the short red underline of a sub-screen section -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{rdr-text}}" />
</ResourceDictionary>
