<!--
    Swallowtail: Common.xaml — Spacing tokens, shared FX white-mask brushes, Swallowtail Crest brand mark,
    Pause-menu golden skull divider, wavy swallowtail ribbon, Steam screenshots skeleton, and EmptyGameTemplate.
    ControlHeight=32 (4px vertical padding with 1.5px borders keeps every form row aligned).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared spacing & game-page layout keys (scripts/data/theme-keys.json) -->
    <Thickness x:Key="ButtonPadding">14,4</Thickness>
    <Thickness x:Key="InputPadding">10,4</Thickness>
    <Thickness x:Key="MenuPadding">6,6</Thickness>
    <Thickness x:Key="MenuItemPadding">8,4</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,4</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">12,10</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">15</sys:Double>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Shared white-mask FX ImageBrushes (deterministic Pillow+NumPy output in src/Images/fx/) -->
    <ImageBrush x:Key="LocalCurtainDrapeMask" ImageSource="{ThemeFile 'Images/fx/curtain-drape.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalParchmentGrainMask" ImageSource="{ThemeFile 'Images/fx/parchment-grain.png'}"
                TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute" Stretch="None" />
    <ImageBrush x:Key="LocalRibbonSwirlMask" ImageSource="{ThemeFile 'Images/fx/ribbon-swirl.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalGoldGlintMask" ImageSource="{ThemeFile 'Images/fx/gold-glint.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalStitchFrameMask" ImageSource="{ThemeFile 'Images/fx/stitch-frame.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalStageChartMask" ImageSource="{ThemeFile 'Images/fx/stage-chart.png'}"
                TileMode="Tile" Viewport="0,0,512,512" ViewportUnits="Absolute" Stretch="None" />

    <!-- Shared RTMI motif geometries -->
    <Geometry x:Key="LocalSkullPipGeometry">F1 M12,3 C7.6,3 4.5,6 4.5,10.2 C4.5,12.7 5.7,14.5 7.2,15.5 V19 H9.2 V17 H11 V19 H13 V17 H14.8 V19 H16.8 V15.5 C18.3,14.5 19.5,12.7 19.5,10.2 C19.5,6 16.4,3 12,3 Z M9,11.8 A1.7,1.7 0 1,1 9,8.4 A1.7,1.7 0 1,1 9,11.8 Z M15,11.8 A1.7,1.7 0 1,1 15,8.4 A1.7,1.7 0 1,1 15,11.8 Z</Geometry>
    <Geometry x:Key="LocalWingedColophonGeometry">M2,6 C10,2 18,8 24,18 C30,8 38,2 46,6 C40,14 31,16 24,23 C17,16 8,14 2,6 Z</Geometry>
    <Geometry x:Key="LocalNotchedOctagonGeometry">M7,2 H17 V5 H20 V7 H22 V17 H20 V19 H17 V22 H7 V19 H4 V17 H2 V7 H4 V5 H7 Z</Geometry>
    <Geometry x:Key="LocalShieldCrestGeometry">M48,16 L64,8 L80,16 L76,31 L64,36 L52,31 Z</Geometry>

    <!-- PopupBorder (Playnite key) -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard-only FocusVisual: Pirate Gold double-notched rim -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1.5"
                            SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading text: Constantia Title Case in Pirate Gold -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>

    <!-- Original Swallowtail Crest Brand Mark (used in Sidebar MainMenu, Settings Title Band, and Empty Game Page) -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="128" Height="128">
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M6,50 L36,44 L36,84 L6,78 L18,64 Z M122,50 L92,44 L92,84 L122,78 L110,64 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M48,16 L64,8 L80,16 L76,31 L64,36 L52,31 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="F0 M48,38 L80,38 L80,46 L88,46 L88,54 L96,54 L96,74 L88,74 L88,82 L80,82 L80,90 L48,90 L48,82 L40,82 L40,74 L32,74 L32,54 L40,54 L40,46 L48,46 Z M54,48 L74,48 L74,54 L80,54 L80,74 L74,74 L74,80 L54,80 L54,74 L48,74 L48,54 L54,54 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M64,52 L75,64 L64,76 L53,64 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M40,100 C48,96 56,102 64,114 C72,102 80,96 88,100 C82,108 72,110 64,120 C56,110 46,108 40,100 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Pause-Menu Golden Skull-Centered Tapered Hairline Divider (10px tall, safe inside GroupBox) -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="{x:Type Control}">
        <Grid Height="10" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Height="1.5" VerticalAlignment="Center" Fill="{DynamicResource MenuSeparatorBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Viewbox Grid.Column="1" Width="10" Height="10" Margin="6,0" VerticalAlignment="Center">
                <Path Fill="{DynamicResource GiltBrush}" Data="{DynamicResource LocalSkullPipGeometry}" Width="24" Height="24" Stretch="Uniform" />
            </Viewbox>
            <Rectangle Grid.Column="2" Height="1.5" VerticalAlignment="Center" Fill="{DynamicResource MenuSeparatorBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Sepia-Ink Skull Divider for Parchment Ledger Dossier -->
    <ControlTemplate x:Key="LocalParchmentDividerTemplate" TargetType="{x:Type Control}">
        <Grid Height="10" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Height="1.5" VerticalAlignment="Center" Fill="{DynamicResource ParchmentEdgeBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Viewbox Grid.Column="1" Width="10" Height="10" Margin="6,0" VerticalAlignment="Center">
                <Path Fill="{DynamicResource ParchmentTitleBrush}" Data="{DynamicResource LocalSkullPipGeometry}" Width="24" Height="24" Stretch="Uniform" />
            </Viewbox>
            <Rectangle Grid.Column="2" Height="1.5" VerticalAlignment="Center" Fill="{DynamicResource ParchmentEdgeBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Torn-Edge Monkey Island Parchment Sheet Backdrop (stacked sheet shadow, hand-cut notches, paper grain, leather corner stitches) -->
    <ControlTemplate x:Key="LocalParchmentSheetTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Offset stacked backing sheet peek (echoes TODO list & Scrapbook layered pages) -->
            <Path Stretch="Fill" Margin="4,4,-3,-3" Fill="{DynamicResource ParchmentEdgeBrush}" Opacity="0.52"
                  Data="M4,2 L140,0 L298,4 L300,260 L296,498 L160,500 L2,496 L0,240 Z" />

            <!-- Main hand-cut deckled parchment sheet with subtle triangular edge nicks -->
            <Path Stretch="Fill" Fill="{DynamicResource ParchmentBrush}"
                  Stroke="{DynamicResource ParchmentEdgeBrush}" StrokeThickness="1.5"
                  Data="M2,4 L92,2 L98,9 L104,2 L238,1 L244,7 L251,2 L298,4 L299,146 L293,152 L299,158 L298,372 L294,377 L298,382 L297,497 L196,499 L190,493 L184,499 L42,498 L36,492 L30,498 L3,496 L1,310 L7,304 L1,298 L2,108 L6,103 L2,98 Z" />

            <!-- Hand-painted paper fiber grain overlay -->
            <Rectangle Margin="3,3,3,3" Fill="{DynamicResource ParchmentEdgeBrush}" Opacity="0.16"
                       OpacityMask="{DynamicResource LocalParchmentGrainMask}" />

            <!-- Soft warm aged vignette along sheet edges -->
            <Border Margin="3,3,3,3" BorderBrush="{DynamicResource ParchmentEdgeBrush}" BorderThickness="8" Opacity="0.14" />

            <!-- Diagonal paper fold shadow (echoes Controls parchment crease) -->
            <Path Stretch="Fill" Margin="6,6,6,6" Opacity="0.08" Fill="{DynamicResource ParchmentTitleBrush}"
                  Data="M0,180 L300,115 L300,126 L0,192 Z" />

            <!-- Two dark leather-cord binding stitches in the upper-right corner (echoes TODO list binding) -->
            <Canvas Width="44" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0">
                <Ellipse Canvas.Left="10" Canvas.Top="14" Width="4" Height="4" Fill="{DynamicResource ParchmentTitleBrush}" />
                <Ellipse Canvas.Left="22" Canvas.Top="18" Width="4" Height="4" Fill="{DynamicResource ParchmentTitleBrush}" />
                <Path Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M12,16 Q20,6 28,2" />
                <Path Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M24,20 Q32,12 40,8" />
                <Path Stroke="{DynamicResource ParchmentTitleBrush}" StrokeThickness="1" Opacity="0.65"
                      Data="M12,16 Q20,6 28,2 M24,20 Q32,12 40,8" />
            </Canvas>

            <!-- Subtle sepia ink-dot splatter in lower-left corner margin -->
            <Canvas Width="26" Height="22" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8" Opacity="0.28">
                <Ellipse Canvas.Left="4" Canvas.Top="10" Width="4.5" Height="4.5" Fill="{DynamicResource ParchmentTitleBrush}" />
                <Ellipse Canvas.Left="11" Canvas.Top="14" Width="2.5" Height="2.5" Fill="{DynamicResource ParchmentTitleBrush}" />
                <Ellipse Canvas.Left="8" Canvas.Top="6" Width="2" Height="2" Fill="{DynamicResource ParchmentTitleBrush}" />
            </Canvas>

            <!-- Sketchy dotted treasure route + tiny anchor doodle in lower-right parchment margin -->
            <Canvas Width="72" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,6" Opacity="0.24">
                <Path Stroke="{DynamicResource ParchmentTitleBrush}" StrokeThickness="1.3" StrokeDashArray="3,3"
                      Data="M4,22 Q20,12 34,18" />
                <Path Stroke="{DynamicResource ParchmentTitleBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M37,14 L45,22 M45,14 L37,22" />
                <!-- Tiny sketched anchor -->
                <Ellipse Canvas.Left="57" Canvas.Top="5" Width="5" Height="5" Stroke="{DynamicResource ParchmentTitleBrush}" StrokeThickness="1.3" />
                <Path Stroke="{DynamicResource ParchmentTitleBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M59.5,10 L59.5,24 M54,14 L65,14 M53,20 Q59.5,27 66,20" />
            </Canvas>
        </Grid>
    </ControlTemplate>

    <!-- Hand-Drawn Sketchy Pirate Items for Game Stage Margin (compass rose, dotted X trail, sailing sloop, hanging lantern) -->
    <ControlTemplate x:Key="LocalStageSketchesTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" ClipToBounds="True">
            <!-- Sketchy nautical compass rose + sailing sloop + dotted treasure trail tucked cleanly along lower-left stage -->
            <Canvas Width="340" Height="116" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,10" Opacity="0.20">
                <!-- Hand-drawn compass rose -->
                <Ellipse Canvas.Left="10" Canvas.Top="44" Width="56" Height="56" Stroke="{DynamicResource LinkBrush}" StrokeThickness="1.4" StrokeDashArray="6,3" />
                <Ellipse Canvas.Left="17" Canvas.Top="51" Width="42" Height="42" Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.1" />
                <Path Fill="{DynamicResource GiltBrush}" Opacity="0.7"
                      Data="M38,40 L42,68 L38,72 L34,68 Z M38,104 L34,76 L38,72 L42,76 Z" />
                <Path Stroke="{DynamicResource LinkBrush}" StrokeThickness="1.3"
                      Data="M6,72 L70,72 M22,56 L54,88 M54,56 L22,88" />
                <!-- Dotted treasure-map route curving toward a hand-drawn X -->
                <Path Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.6" StrokeDashArray="4,4"
                      Data="M74,78 Q114,52 152,72 T222,64" />
                <Path Stroke="{DynamicResource GiltBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M226,56 L240,70 M240,56 L226,70" />
                <!-- Sketchy sailing sloop on scribbled waves -->
                <Path Stroke="{DynamicResource LinkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M258,76 L306,76 L298,89 L266,89 Z M282,76 L282,36 M282,40 Q301,54 282,72 M282,44 Q266,58 282,70" />
                <Path Fill="{DynamicResource GiltBrush}" Opacity="0.85" Data="M282,36 L296,39 L292,42 L296,45 L282,46 Z" />
                <Path Stroke="{DynamicResource LinkBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round"
                      Data="M250,94 Q260,89 270,94 T290,94 T312,94 M262,102 Q272,98 282,102 T302,102" />
            </Canvas>

            <!-- Sketchy hanging brass harbor lantern in lower-center-right margin -->
            <Canvas Width="64" Height="88" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,374,14" Opacity="0.18">
                <Path Stroke="{DynamicResource GiltBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M32,6 L32,18 M24,18 L40,18 L44,26 L20,26 Z M22,26 L20,56 L44,56 L42,26 M18,56 L46,56 L40,64 L24,64 Z" />
                <Path Fill="{DynamicResource GiltHotBrush}" Opacity="0.65" Data="M32,33 Q37,41 32,49 Q27,41 32,33 Z" />
                <Path Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round"
                      Data="M10,38 L15,38 M49,38 L54,38 M14,24 L18,27 M46,27 L50,24" />
            </Canvas>
        </Grid>
    </ControlTemplate>

    <!-- Hand-Drawn Sketchy Pirate Items for Settings Window (ship's helm wheel, spyglass, dotted X route) -->
    <ControlTemplate x:Key="LocalSettingsSketchesTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" ClipToBounds="True">
            <Canvas Width="230" Height="130" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,12" Opacity="0.18">
                <!-- Dotted route & X -->
                <Path Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.5" StrokeDashArray="4,4"
                      Data="M10,104 Q48,80 84,96 T128,84" />
                <Path Stroke="{DynamicResource GiltBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M16,96 L28,108 M28,96 L16,108" />
                <!-- Sketchy spyglass -->
                <Path Stroke="{DynamicResource LinkBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M48,66 L88,46 L94,58 L54,76 Z M88,46 L108,38 L112,47 L94,58 M68,56 L74,67 M86,47 L92,58" />
                <!-- Sketchy ship's helm wheel -->
                <Ellipse Canvas.Left="140" Canvas.Top="36" Width="64" Height="64" Stroke="{DynamicResource LinkBrush}" StrokeThickness="2" />
                <Ellipse Canvas.Left="149" Canvas.Top="45" Width="46" Height="46" Stroke="{DynamicResource LinkBrush}" StrokeThickness="1.3" />
                <Ellipse Canvas.Left="165" Canvas.Top="61" Width="14" Height="14" Stroke="{DynamicResource GiltBrush}" StrokeThickness="1.6" />
                <Path Stroke="{DynamicResource LinkBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                      Data="M172,22 L172,114 M126,68 L218,68 M139,35 L205,101 M205,35 L139,101" />
                <!-- Scribbled wave line -->
                <Path Stroke="{DynamicResource LinkBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round"
                      Data="M114,116 Q128,110 142,116 T170,116 T198,116 T222,116" />
            </Canvas>
        </Grid>
    </ControlTemplate>

    <!-- Wavy Deep Aqua Swallowtail Banner Ribbon (host sets Foreground for swirl highlight, Background for ribbon fill) -->
    <ControlTemplate x:Key="LocalSwallowtailRibbonTemplate" TargetType="{x:Type Control}">
        <Grid ClipToBounds="True" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Swallowtail forked ribbon body -->
            <Path Stretch="Fill" Fill="{TemplateBinding Background}"
                  Data="M0,2 L100,0 L200,2 L190,14 L200,26 L100,28 L0,26 L10,14 Z" />
            <!-- Calligraphic spiral swirl overlay from ribbon-swirl.png -->
            <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.34"
                       OpacityMask="{DynamicResource LocalRibbonSwirlMask}" Margin="10,2" />
            <!-- Subtle upper gold catchline -->
            <Rectangle Height="1" VerticalAlignment="Top" Margin="14,2,14,0" Fill="{DynamicResource GiltHotBrush}" Opacity="0.30" />
        </Grid>
    </ControlTemplate>

    <!-- Pinched Concave Save-Slot Frame Overlay (draws concave perimeter border without altering layout size) -->
    <ControlTemplate x:Key="LocalPinchFrameTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" Fill="Transparent"
                  Data="M1,1 Q50,3.2 99,1 Q97.2,50 99,99 Q50,96.8 1,99 Q2.8,50 1,1 Z" />
        </Grid>
    </ControlTemplate>

    <!-- Steam Screenshots Pulsing Save-Slot Skeleton (16:9 main preview over 5 thumbnails) -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False">
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="0.38" To="0.72" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>
            <Border Height="220" Background="{DynamicResource NormalBrushDark}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                    CornerRadius="{DynamicResource ControlCornerRadius}" Margin="0,0,0,8" />
            <UniformGrid Columns="5" Height="56">
                <Border Margin="0,0,6,0" Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Margin="3,0" Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Margin="3,0" Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Margin="3,0" Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Margin="6,0,0,0" Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}" />
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- Empty Game Page: Nocturnal Harbor Stage with draped teal curtains, pulsing Swallowtail Crest, gold serif message & winged colophon -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="{x:Type Control}">
        <Grid ClipToBounds="True" IsHitTestVisible="False">
            <!-- Draped dark-aqua stage curtains on left and right margins -->
            <Rectangle Width="150" HorizontalAlignment="Left" Fill="{DynamicResource NormalBrush}" Opacity="0.30"
                       OpacityMask="{DynamicResource LocalCurtainDrapeMask}" />
            <Rectangle Width="150" HorizontalAlignment="Right" Fill="{DynamicResource NormalBrush}" Opacity="0.30"
                       OpacityMask="{DynamicResource LocalCurtainDrapeMask}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </Rectangle.RenderTransform>
            </Rectangle>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <!-- Swallowtail Crest with gentle lantern breath (plain Opacity animation on child, safe on null Game) -->
                <Grid Width="84" Height="84" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Ellipse x:Name="LanternHalo" Width="80" Height="80" Fill="{DynamicResource HighlightGlyphBrush}" Opacity="0.32">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="LanternHalo" Storyboard.TargetProperty="Opacity"
                                                         From="0.16" To="0.46" Duration="0:0:2.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Control Width="64" Height="64" Template="{DynamicResource BrandMarkTemplate}"
                             Foreground="{DynamicResource GiltBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                           FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                           FontWeight="Bold" Foreground="{DynamicResource HeadingForegroundBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12" />

                <Control Template="{DynamicResource DividerTemplate}" Width="210" Margin="0,0,0,14" />

                <Viewbox Width="44" Height="22" HorizontalAlignment="Center" Opacity="0.55">
                    <Path Fill="{DynamicResource TextBrush}" Data="{DynamicResource LocalWingedColophonGeometry}" />
                </Viewbox>
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <!-- Local Notes ReadOnly TextBox style (stitched leather ledger card) -->
    <Style x:Key="LocalNotesTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ParchmentBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="IsReadOnly" Value="True" />
