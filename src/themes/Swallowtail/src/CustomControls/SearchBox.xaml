<!--
    Swallowtail: CustomControls/SearchBox.xaml.
    Stitched dark-espresso leather Inventory Satchel search well (InputBackgroundBrush + inner dashed stitch seam).
    Persistent magnifier Glyph outside PART_SeachIcon (TextBrushDarker when empty/unfocused; GlyphBrush when focused
    or nonempty); PART_ClearTextIcon keeps a full-hit transparent Border template.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Field" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="{DynamicResource ControlBorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <!-- Gouache leather grain + recessed inner shadow -->
                            <Rectangle Fill="{DynamicResource InputBorderBrush}" Opacity="0.16"
                                       OpacityMask="{DynamicResource LocalParchmentGrainMask}" IsHitTestVisible="False" />
                            <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource ScrimBrush}" Opacity="0.42" IsHitTestVisible="False" />
                            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource ParchmentEdgeBrush}" Opacity="0.22" IsHitTestVisible="False" />
                            <!-- Dashed leather satchel inner stitching -->
                            <Rectangle Margin="3" RadiusX="2" RadiusY="2"
                                       Stroke="{DynamicResource WindowPanelSeparatorBrush}"
                                       StrokeThickness="1" StrokeDashArray="4 3"
                                       IsHitTestVisible="False" />
                            <!-- Corner brass studs -->
                            <Polygon Width="3.5" Height="3.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                     Points="1.75,0 3.5,1.75 1.75,3.5 0,1.75" Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                            <Polygon Width="3.5" Height="3.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                     Points="1.75,0 3.5,1.75 1.75,3.5 0,1.75" Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                            <Polygon Width="3.5" Height="3.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                     Points="1.75,0 3.5,1.75 1.75,3.5 0,1.75" Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                            <Polygon Width="3.5" Height="3.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                     Points="1.75,0 3.5,1.75 1.75,3.5 0,1.75" Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                            <ContentControl x:Name="Glyph" Focusable="False" Content="{DynamicResource IconSearch}"
                                            ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{DynamicResource GlyphBrush}" Margin="10,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            IsHitTestVisible="False" Panel.ZIndex="1" />
                            <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                            <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     Padding="32,0,28,0" VerticalContentAlignment="Center" />
                            <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}"
                                            ContentTemplate="{DynamicResource IconSmallTemplate}"
                                            Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,5,0" Cursor="Hand"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ContentControl.Template>
                                    <ControlTemplate TargetType="ContentControl">
                                        <Border Background="Transparent" Padding="4">
                                            <ContentPresenter ContentSource="Content" />
                                        </Border>
                                    </ControlTemplate>
                                </ContentControl.Template>
                            </ContentControl>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TextInpuText" Property="Padding" Value="10,0,28,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
