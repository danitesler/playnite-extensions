<!--
    Swallowtail: Views/Sidebar.xaml.
    44px nocturnal harbor rail framed by a 1.5px Deep Aqua seam and subtle curtain-drape wash, crowned by a
    44x50 Curled Pirate Gold Main Menu Crest Tile (with folded dark-gold underside lip and Swallowtail Crest mark),
    and finished at the foot with Return to Monkey Island's winged-flourish colophon.
    Turns transparent when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,1.5,0"
                            Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <!-- Layered nocturnal theater curtain pleats + gouache wood grain + brass-stitched edge seam -->
                            <Grid x:Name="CurtainWash" IsHitTestVisible="False">
                                <Rectangle Fill="{DynamicResource NormalBrush}" Opacity="0.30"
                                           OpacityMask="{DynamicResource LocalCurtainDrapeMask}" />
                                <Rectangle Fill="{DynamicResource LinkBrush}" Opacity="0.12"
                                           OpacityMask="{DynamicResource LocalParchmentGrainMask}" />
                                <!-- Vertical dashed brass rope seam running along the right inner edge -->
                                <Line X1="40" Y1="56" X2="40" Y2="2000" Stroke="{DynamicResource GiltDimBrush}"
                                      StrokeThickness="1" StrokeDashArray="5 5" Opacity="0.42" />
                            </Grid>

                            <DockPanel x:Name="DockContentHolder">
                                <!-- Curled Pirate Gold Main Menu Crest Tile (44x50) -->
                                <Border x:Name="PART_ElemMainMenu" DockPanel.Dock="Top"
                                        Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                        BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="0,0,0,3"
                                        Width="44" Height="50" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Border x:Name="MenuHoverFill" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                        <Rectangle x:Name="MenuGlint" Fill="{DynamicResource TextBrush}" Opacity="0"
                                                   OpacityMask="{DynamicResource LocalGoldGlintMask}" Visibility="Collapsed" IsHitTestVisible="False" />
                                        <!-- Folded dark-gold ribbon shadow corner at bottom-right -->
                                        <Path x:Name="MenuFoldTail" Width="10" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                              Fill="{DynamicResource PrimaryButtonBorderBrush}" Data="M0,6 L10,0 L10,6 Z" IsHitTestVisible="False" />
                                        <Control x:Name="MenuMark" Width="24" Height="24"
                                                 Template="{DynamicResource BrandMarkTemplate}"
                                                 Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsHitTestVisible="False" />
                                    </Grid>
                                </Border>

                                <!-- Brass-diamond horizontal divider under the Main Menu crest -->
                                <Grid x:Name="RailTopDivider" DockPanel.Dock="Top" Height="12" Margin="4,4,4,0" IsHitTestVisible="False">
                                    <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource PanelSeparatorBrush}" Opacity="0.75" />
                                    <Polygon Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource GiltBrush}" />
                                </Grid>

                                <!-- Dotted nautical trail + tiny sketched anchor + winged-flourish colophon at rail foot -->
                                <StackPanel x:Name="RailFootColophon" DockPanel.Dock="Bottom" Margin="0,6,0,14"
                                            HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <Line X1="12" Y1="0" X2="12" Y2="34" Stroke="{DynamicResource GiltDimBrush}"
                                          StrokeThickness="1.2" StrokeDashArray="2 4" Opacity="0.55" Width="24" Height="36" />
                                    <Canvas Width="24" Height="24" Margin="0,2,0,8" Opacity="0.48">
                                        <Ellipse Canvas.Left="9.5" Canvas.Top="2" Width="5" Height="5" Stroke="{DynamicResource GiltBrush}" StrokeThickness="1.3" />
                                        <Path Stroke="{DynamicResource LinkBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M12,7 L12,21 M7,11 L17,11 M6,16 Q12,24 18,16" />
                                    </Canvas>
                                    <Grid Width="34" Height="8" Margin="0,0,0,6">
                                        <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource PanelSeparatorBrush}" Opacity="0.65" />
                                        <Polygon Width="5" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Points="2.5,0 5,2.5 2.5,5 0,2.5" Fill="{DynamicResource GiltDimBrush}" />
                                    </Grid>
                                    <Viewbox Width="22" Height="12" HorizontalAlignment="Center" Opacity="0.48">
                                        <Path Fill="{DynamicResource LinkBrush}" Data="{DynamicResource LocalWingedColophonGeometry}" />
                                    </Viewbox>
                                </StackPanel>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True" Margin="0,4,0,0"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="BorderThickness" Value="0" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="CurtainWash" />
                            <Setter Property="Background" Value="Transparent" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuFoldTail" />
                            <Setter Property="Foreground" Value="{DynamicResource GiltBrush}" TargetName="MenuMark" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailTopDivider" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootColophon" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuGlint" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="MenuGlint" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="MenuHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="MenuGlint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuGlint" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="BorderThickness" Value="1.5,0,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Padding" Value="0,25,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="BorderThickness" Value="0,0,0,1.5" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailTopDivider" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootColophon" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,136,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="BorderThickness" Value="0,1.5,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailTopDivider" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootColophon" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
