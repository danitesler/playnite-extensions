<!--
    Swallowtail: Views/TopPanel.xaml.
    50px nocturnal harbor top bar closed by a 1.5px Deep Aqua seam with a subtle golden skull centerpiece.
    Strict left-to-right order: MainMenu (only when sidebar hidden) -> Search (244px stitched leather satchel) ->
    Filter toggle (8x8px rotated Burnt Bronze diamond pip, zero text) -> PART_PanelMainItems (Sorting FIRST in column 0,
    icon-only view switches) -> Plugin items -> PART_ProgressGlobal (12px tall, >=12px side margin) -> Notifications ->
    136px window caption clearance. TopPanelMenu is BasedOn ContextMenu with no template of its own.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentControl Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentControl Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentControl Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentControl Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentControl Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentControl Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentControl Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentControl Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource DataChangeNotifBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentControl Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentControl Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <!-- Menus contract: TopPanelMenu inherits ContextMenu with no template of its own -->
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <!-- Filter toggle: 34x34 square with 8x8 rotated Burnt Bronze diamond pip (TextFilter) on top-right, zero text -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="IdleTile" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <Border x:Name="HoverPlate" Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="ActiveWash" Background="{DynamicResource TopPanelItemCheckedBackgroundBrush}"
                                BorderBrush="{DynamicResource GiltBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="26" Height="26">
                            <ContentControl Content="{DynamicResource IconFilter}" ContentTemplate="{DynamicResource IconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}" />
                            <!-- 8x8px rotated Burnt Bronze diamond pip when filter is active -->
                            <Polygon x:Name="TextFilter" Visibility="Collapsed" IsHitTestVisible="False"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
                                     Points="4.5,0 9,4.5 4.5,9 0,4.5"
                                     Fill="{DynamicResource DataChangeNotifBrush}"
                                     Stroke="{DynamicResource GiltHotBrush}" StrokeThickness="0.9" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="Background" Value="{DynamicResource NormalBrushDark}" TargetName="IdleTile" />
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="IdleTile" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="ActiveWash" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FilterHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="FilterHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.17" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.17" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource True}">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GiltBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Notifications toggle: 34x34 matching toolbar button height -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Border x:Name="HoverPlate" Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <ContentControl Content="{DynamicResource IconNotifications}" ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Grid Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1">
                            <Ellipse Fill="{DynamicResource DangerBrush}" Stroke="{DynamicResource ShellBackgroundBrush}" StrokeThickness="1" />
                            <TextBlock Text="{Api Notifications.Count}" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{DynamicResource DangerForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="NotifHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="NotifHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.17" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.17" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GiltBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Grid Height="50" Panel.ZIndex="2"
                          d:DesignWidth="1280"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource TopPanelBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- Textured nocturnal harbor fascia: gouache wood/paper grain + calligraphic swirl + upper brass catchlight -->
                        <Grid ClipToBounds="True" IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Rectangle Fill="{DynamicResource NormalBrush}" Opacity="0.24"
                                       OpacityMask="{DynamicResource LocalParchmentGrainMask}" />
                            <Rectangle Width="420" HorizontalAlignment="Right" Margin="0,2,144,4"
                                       Fill="{DynamicResource LinkBrush}" Opacity="0.14"
                                       OpacityMask="{DynamicResource LocalRibbonSwirlMask}" />
                            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource GiltDimBrush}" Opacity="0.38" />
                            <!-- Subtle dashed brass rope stitch line riding above the bottom seam -->
                            <Line X1="0" Y1="45" X2="2600" Y2="45" Stroke="{DynamicResource GiltDimBrush}"
                                  StrokeThickness="1" StrokeDashArray="5 4" Opacity="0.45" />
                        </Grid>

                        <!-- Double-trimmed Deep Aqua & brass molding + centered miniature swallowtail skull medallion -->
                        <Grid Height="14" VerticalAlignment="Bottom" Margin="0,0,0,-6" IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Rectangle Height="1.5" VerticalAlignment="Center" Fill="{DynamicResource TopPanelSeparatorBrush}" />
                            <Grid Width="92" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Control Template="{DynamicResource LocalSwallowtailRibbonTemplate}"
                                         Background="{DynamicResource HeaderBandBrush}"
                                         Foreground="{DynamicResource LinkBrush}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Polygon Width="4" Height="4" Points="2,0 4,2 2,4 0,2" Fill="{DynamicResource GiltDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Viewbox Width="9" Height="9" VerticalAlignment="Center">
                                        <Path Fill="{DynamicResource GiltBrush}" Data="{DynamicResource LocalSkullPipGeometry}" Width="24" Height="24" Stretch="Uniform" />
                                    </Viewbox>
                                    <Polygon Width="4" Height="4" Points="2,0 4,2 2,4 0,2" Fill="{DynamicResource GiltDimBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <DockPanel Margin="12,8,140,8">
                            <!-- Shown only when Sidebar is hidden -->
                            <Border x:Name="PART_ElemMainMenu" Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                    BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="1.5"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    DockPanel.Dock="Left" Margin="0,0,8,0" Cursor="Hand" Width="34" Height="34"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <Control Padding="7" Template="{DynamicResource LocalSwallowtailMenuMarkTemplate}"
                                         Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                         Focusable="False" IsTabStop="False" />
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch" Style="{DynamicResource TopPanelSearchBox}"
                                       Margin="0,0,2,0"
                                       WindowChrome.IsHitTestVisibleInChrome="True"
                                       Width="244" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" />

                            <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" DockPanel.Dock="Left" VerticalAlignment="Center" />

                            <!-- Sorting FIRST directly beside Filter despite Playnite's runtime insertion order -->
                            <Grid x:Name="PART_PanelMainItems" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="{x:Type TopPanelItem}" BasedOn="{StaticResource {x:Type TopPanelItem}}">
                                        <Style.Triggers>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSortSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="0" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSearchButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="1" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGeneralViewSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="2" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelFilterPresetsSelectionTemplate}">
                                                <Setter Property="Grid.Column" Value="3" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGroupSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="4" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchDetailsViewTemplate}">
                                                <Setter Property="Grid.Column" Value="6" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchGridViewTemplate}">
                                                <Setter Property="Grid.Column" Value="7" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchListViewTemplate}">
                                                <Setter Property="Grid.Column" Value="8" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelUpdateButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="9" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="10" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelViewSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="11" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelExplorerSwitchTemplate}">
                                                <Setter Property="Grid.Column" Value="12" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Grid.Column" Value="5" />
                                    </Style>
                                </Grid.Resources>
                            </Grid>

                            <CheckBox x:Name="PART_ToggleNotifications"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" DockPanel.Dock="Right" VerticalAlignment="Center" />

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="8,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
                                <Grid MaxWidth="520" MinWidth="220">
                                    <ProgressBar Name="PART_ProgressGlobal" Height="12"
                                                 Foreground="{DynamicResource ProgressBarForegroundBrush}"
                                                 Background="{DynamicResource ProgressBarTrackBrush}"
                                                 BorderBrush="{DynamicResource NormalBorderBrush}" />
                                    <TextBlock Name="PART_TextProgressText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"
                                               Style="{DynamicResource BaseTextBlockStyle}" Margin="16,0,16,0" />
                                </Grid>
                                <Button Name="PART_ButtonProgressCancel" Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True" Padding="10,0" Margin="6,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
