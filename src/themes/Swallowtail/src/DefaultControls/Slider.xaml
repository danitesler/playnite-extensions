<!--
    Swallowtail: DefaultControls/Slider.xaml.
    Return to Monkey Island Sound stepper aesthetic: Deep Aqua < > wedge caps flanking a 6px stitched-leather
    track (explicit CornerRadius="3", never CornerRadiusFull), Burnt Bronze filled range (SliderRangeButton),
    and a rotated Pirate Gold diamond thumb with crisp Ivory border (SliderThumb, declared last in Track).
    Includes ThemeModifier GameBannerHeight & GameBannerDarken disable triggers when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SliderTrackButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" Height="18" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderRangeButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid Background="Transparent" Height="18">
                        <Border Height="6" VerticalAlignment="Center" CornerRadius="3"
                                Background="{DynamicResource SliderHoverForegroundBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rotated Pirate Gold Diamond SliderThumb with Ivory rim -->
    <Style x:Key="SliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Polygon x:Name="Diamond" Width="16" Height="16"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Points="8,1 15,8 8,15 1,8"
                                 Fill="{DynamicResource SliderThumbBackgroundBrush}"
                                 Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Diamond" Property="Fill" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="Diamond" Property="Stroke" Value="{DynamicResource SliderThumbHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Diamond" Property="Fill" Value="{DynamicResource GiltHotBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left RTMI Deep Aqua < wedge cap -->
                        <Path x:Name="LeftWedge" Grid.Column="0" Width="8" Height="12" Margin="0,0,6,0"
                              VerticalAlignment="Center" Stretch="Uniform" IsHitTestVisible="False"
                              Fill="{DynamicResource NormalBorderBrush}" Data="M9,1 L1,7 L9,13 L6.8,7 Z" />

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Border Height="6" VerticalAlignment="Center" CornerRadius="3"
                                    Background="{DynamicResource ProgressBarTrackBrush}"
                                    BorderBrush="{DynamicResource SliderTrackBrush}" BorderThickness="1" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{DynamicResource SliderRangeButton}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{DynamicResource SliderTrackButton}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <!-- Track.Thumb set LAST so thumb renders over both range tracks -->
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <!-- Right RTMI Deep Aqua > wedge cap -->
                        <Path x:Name="RightWedge" Grid.Column="2" Width="8" Height="12" Margin="6,0,0,0"
                              VerticalAlignment="Center" Stretch="Uniform" IsHitTestVisible="False"
                              Fill="{DynamicResource NormalBorderBrush}" Data="M1,1 L9,7 L1,13 L3.2,7 Z" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LeftWedge" Property="Fill" Value="{DynamicResource LinkBrush}" />
                            <Setter TargetName="RightWedge" Property="Fill" Value="{DynamicResource LinkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Window background rule: grey out ThemeModifier banner sliders while ShowBackgroundImageOnWindow=True -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerHeight" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerDarken" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
