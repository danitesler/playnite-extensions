<!--
    Swallowtail: DefaultControls/ComboBox.xaml.
    32px stitched espresso-leather ComboBox with dedicated 28px right wedge-chevron column (ContentSite Margin 10,0,30,0
    reserves >=12px clear of the chevron). Popup reuses LocalSwallowtailMenuBoardTemplate with 30px ComboBoxItem rows
    matching Menu.xaml (harbor-teal plate framed in Pirate Gold hairlines + sliding gold diamond pip; IsSelected shows
    the white notched-octagon outline with Pirate Gold diamond core).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="Border"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    BorderThickness="1.5,1.5,1.5,2.5"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <Grid ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>

                    <!-- Left stitched leather satchel field with gouache grain & recessed top shadow -->
                    <Rectangle Grid.Column="0" Fill="{DynamicResource InputBorderBrush}" Opacity="0.16"
                               OpacityMask="{DynamicResource LocalParchmentGrainMask}" IsHitTestVisible="False" />
                    <Rectangle Grid.Column="0" Height="2" VerticalAlignment="Top" Fill="{DynamicResource ScrimBrush}" Opacity="0.40" IsHitTestVisible="False" />
                    <Rectangle Grid.Column="0" Margin="3,3,2,3" RadiusX="2" RadiusY="2"
                               Stroke="{DynamicResource WindowPanelSeparatorBrush}"
                               StrokeThickness="1" StrokeDashArray="4 3" IsHitTestVisible="False" />
                    <Polygon Grid.Column="0" Width="3.5" Height="3.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4.5"
                             Points="1.75,0 3.5,1.75 1.75,3.5 0,1.75" Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                    <Polygon Grid.Column="0" Width="3.5" Height="3.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4.5"
                             Points="1.75,0 3.5,1.75 1.75,3.5 0,1.75" Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />

                    <!-- Right carved Deep Aqua enamel latch tab with brass divider & notched wedge chevron -->
                    <Border x:Name="ChevronTab" Grid.Column="1" Background="{DynamicResource NormalBrush}"
                            BorderBrush="{DynamicResource GiltDimBrush}" BorderThickness="1.5,0,0,0">
                        <Grid>
                            <Rectangle Fill="{DynamicResource LinkBrush}" Opacity="0.16"
                                       OpacityMask="{DynamicResource LocalParchmentGrainMask}" IsHitTestVisible="False" />
                            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource LinkBrush}" Opacity="0.35" IsHitTestVisible="False" />
                            <ContentControl x:Name="Arrow" Width="11" Height="11"
                                            Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                            Foreground="{DynamicResource GiltBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" />
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                <Setter TargetName="ChevronTab" Property="Background" Value="{DynamicResource HeaderBandBrush}" />
                <Setter TargetName="ChevronTab" Property="BorderBrush" Value="{DynamicResource GiltBrush}" />
                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource GiltHotBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                <Setter TargetName="ChevronTab" Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter TargetName="ChevronTab" Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Harbor-teal highlight plate with tapered Pirate Gold hairlines -->
                        <Grid x:Name="HighlightPlate" Margin="2,1" Visibility="Collapsed" Opacity="0"
                              IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border Background="{DynamicResource MenuItemHoverBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource GiltBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource GiltBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>

                        <Grid Margin="10,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Chosen white notched-octagon + Pirate Gold diamond badge (persists on IsSelected) -->
                            <Grid x:Name="ChosenBadge" Grid.Column="0" Width="15" Height="15"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Visibility="Collapsed" IsHitTestVisible="False">
                                <Path Stretch="Uniform" Fill="{DynamicResource CheckBoxCheckMarkBkBrush}"
                                      Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                                      Data="{DynamicResource LocalNotchedOctagonGeometry}" />
                                <Polygon Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource GiltBrush}" />
                            </Grid>

                            <ContentPresenter x:Name="ContentHost" Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="LabelSlide" X="0" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ChosenBadge" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ComboHighlightIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ComboHighlightOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource LocalComboBoxToggleButton}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <!-- Reserve 40px on right: the 30px wedge column plus the 10px left inset, so the value is not glued to the arrow -->
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,40,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{DynamicResource BareTextBox}"
                                 MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 Margin="10,0,40,0" Focusable="True" Visibility="Hidden"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Control Template="{DynamicResource LocalSwallowtailMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                                <ScrollViewer Margin="4,13,4,6" CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
