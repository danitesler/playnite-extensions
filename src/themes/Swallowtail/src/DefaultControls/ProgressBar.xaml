<!--
    Swallowtail: DefaultControls/ProgressBar.xaml.
    Stitched leather progress trough with Pirate Gold fill (MinHeight=8, Height={TemplateBinding Height} so
    dialogs stay 8px and PART_ProgressGlobal stays 12px; explicit half-thickness CornerRadius=3, never CornerRadiusFull).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid MinHeight="8" Height="{TemplateBinding Height}" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                Background="{TemplateBinding Foreground}" Margin="1">
                            <Rectangle Fill="{DynamicResource GiltHotBrush}" Opacity="0.28"
                                       OpacityMask="{DynamicResource LocalGoldGlintMask}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
