<!--
    Swallowtail: DefaultControls/Menu.xaml.
    Unified Return to Monkey Island popup menu rows (30px height, shared with ContextMenu & TopPanelMenu):
    - Panel: LocalSwallowtailMenuBoardTemplate (deep harbor board, 4% gouache grain, wavy 7px Deep Aqua top ribbon
      with rising Pirate Gold shield crest, four flared Save-slot corner ticks).
    - Highlight: #154963 deep harbor-teal plate framed top/bottom by tapered Pirate Gold hairlines (ScaleX 0.90->1,
      120ms CubicEase out) while a golden compass-skull diamond pip slides in (-6->0), icon turns Pirate Gold
      (TextElement.Foreground on TargetName="Icon"), and label nudges +2px right in Ivory (9.2:1).
    - Group break: 10px Pause-menu golden skull-centered tapered hairline (DividerTemplate).
    - Shortcuts: Stitched dark-espresso leather tags (Consolas Burnt Bronze; gold rim + ivory text on highlight).
    - Marked rows: Exit (Alt+Q) in Save-slot Overwrite Crimson at rest, solid Crimson highlight plate with Ivory ink
      (5.1:1); checked rows draw the crisp white notched-octagon outline with a solid Pirate Gold diamond core.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 10px Pause-menu golden skull-centered group break -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Control Template="{DynamicResource DividerTemplate}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SubmenuItem (plain / checkable / Exit row, 30px compact height) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated harbor-teal highlight plate framed by tapered Pirate Gold hairlines -->
            <Grid x:Name="HighlightPlate" Margin="2,1" Visibility="Collapsed" Opacity="0"
                  IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" ScaleY="1" />
                </Grid.RenderTransform>
                <Border x:Name="HighlightFill" Background="{DynamicResource MenuItemHoverBrush}"
                        CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Rectangle x:Name="HighlightTopRule" Height="1" VerticalAlignment="Top" Fill="{DynamicResource GiltBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#CC000000" Offset="0.72" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle x:Name="HighlightBottomRule" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource GiltBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#CC000000" Offset="0.72" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>

            <!-- Sliding left compass diamond cursor pip -->
            <Polygon x:Name="CursorPip" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="4,0,0,0" Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource GiltBrush}"
                     Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Polygon.RenderTransform>
                    <TranslateTransform x:Name="CursorSlide" X="-6" />
                </Polygon.RenderTransform>
            </Polygon>

            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcutCol" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>

                <!-- Fixed 26px icon column (never collapses when item has no icon) -->
                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" TextElement.Foreground="{DynamicResource TextBrushDarker}" />

                <!-- Signature RTMI mini notched-octagon checked badge (when IsChecked=True) -->
                <Grid x:Name="CheckBadge" Grid.Column="0" Width="15" Height="15"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Visibility="Collapsed" IsHitTestVisible="False">
                    <Path Stretch="Uniform" Fill="{DynamicResource CheckBoxCheckMarkBkBrush}"
                          Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                          Data="{DynamicResource LocalNotchedOctagonGeometry}" />
                    <Polygon Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource GiltBrush}" />
                </Grid>

                <!-- Plain * label column (trims cleanly, nudges +2px on highlight) -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelSlide" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Stitched espresso-leather shortcut pill tag -->
                <Border x:Name="ShortcutTag" Grid.Column="2" Margin="12,0,0,0" Padding="6,1" VerticalAlignment="Center"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusSmall}">
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11"
                               Foreground="{DynamicResource TitleSuffixBrush}" />
                </Border>
            </Grid>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutTag" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutTag" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutTag" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource GiltBrush}" />
                <Setter TargetName="ShortcutTag" Property="BorderBrush" Value="{DynamicResource GiltBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHighlightIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="CursorSlide" Storyboard.TargetProperty="X" From="-6" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHighlightOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="CursorSlide" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <!-- Exit highlighted: solid Save-slot Overwrite Crimson plate with Ivory text/icon/pip (5.1:1) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="HighlightFill" Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="HighlightTopRule" Property="Fill" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="HighlightBottomRule" Property="Fill" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="CursorPip" Property="Fill" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutTag" Property="Background" Value="{DynamicResource ScrimBrush}" />
                <Setter TargetName="ShortcutTag" Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeader (row with submenu Popup, 30px compact height) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held open-submenu plate (setter-controlled so moving pointer into submenu never flickers) -->
            <Grid x:Name="OpenPlate" Margin="2,1" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource SelectedBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Rectangle Width="2.5" HorizontalAlignment="Left" Margin="0,3" Fill="{DynamicResource GiltBrush}" />
            </Grid>

            <!-- Animated highlight plate -->
            <Grid x:Name="HighlightPlate" Margin="2,1" Visibility="Collapsed" Opacity="0"
                  IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" ScaleY="1" />
                </Grid.RenderTransform>
                <Border Background="{DynamicResource MenuItemHoverBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource GiltBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#CC000000" Offset="0.72" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource GiltBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#CC000000" Offset="0.72" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>

            <Polygon x:Name="CursorPip" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="4,0,0,0" Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource GiltBrush}"
                     Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Polygon.RenderTransform>
                    <TranslateTransform x:Name="CursorSlide" X="-6" />
                </Polygon.RenderTransform>
            </Polygon>

            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcutCol" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" TextElement.Foreground="{DynamicResource TextBrushDarker}" />

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelSlide" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <Border x:Name="ShortcutTag" Grid.Column="2" Margin="12,0,0,0" Padding="6,1" VerticalAlignment="Center"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusSmall}">
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11"
                               Foreground="{DynamicResource TitleSuffixBrush}" />
                </Border>

                <!-- RTMI wedge submenu arrow on right edge -->
                <ContentControl x:Name="SubmenuArrow" Grid.Column="3" Width="10" Height="10"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource NormalBorderBrush}" IsHitTestVisible="False" />
            </Grid>

            <!-- Submenu Popup reusing LocalSwallowtailMenuBoardTemplate (VerticalOffset compensates 4px crown + 9px top inset) -->
            <Popup x:Name="Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-13"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade">
                <Grid MinWidth="210" Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalSwallowtailMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="4,13,4,6" CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutTag" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutTag" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource GiltBrush}" />
                <Setter TargetName="SubmenuArrow" Property="Foreground" Value="{DynamicResource GiltBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource GiltBrush}" />
                <Setter TargetName="SubmenuArrow" Property="Foreground" Value="{DynamicResource GiltHotBrush}" />
                <Setter TargetName="ShortcutTag" Property="BorderBrush" Value="{DynamicResource GiltBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubmenuHighlightIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="CursorSlide" Storyboard.TargetProperty="X" From="-6" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubmenuHighlightOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="CursorSlide" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorPip" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
