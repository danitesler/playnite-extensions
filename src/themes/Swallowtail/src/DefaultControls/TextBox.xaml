<!--
    Swallowtail: DefaultControls/TextBox.xaml.
    Stitched dark-espresso leather Inventory Satchel text input (ControlHeight=32; Padding applied once on TextBox,
    never doubled on PART_ContentHost or outer Border). Includes BareTextBox for SearchBox & editable ComboBox.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource GiltBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="CaretBrush" Value="{DynamicResource GiltBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Field" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid ClipToBounds="True">
                            <!-- Gouache leather grain texture -->
                            <Rectangle Fill="{DynamicResource InputBorderBrush}" Opacity="0.16"
                                       OpacityMask="{DynamicResource LocalParchmentGrainMask}" IsHitTestVisible="False" />
                            <!-- Recessed top inner shadow & bottom warm lip -->
                            <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource ScrimBrush}" Opacity="0.42" IsHitTestVisible="False" />
                            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource ParchmentEdgeBrush}" Opacity="0.22" IsHitTestVisible="False" />
                            <!-- Hand-stitched satchel inner seam -->
                            <Rectangle Margin="3" RadiusX="2" RadiusY="2"
                                       Stroke="{DynamicResource WindowPanelSeparatorBrush}"
                                       StrokeThickness="1" StrokeDashArray="4 3" IsHitTestVisible="False" />
                            <!-- Four tiny brass corner rivets -->
                            <Polygon x:Name="RivetTL" Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4.5"
                                     Points="2,0 4,2 2,4 0,2" Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                            <Polygon x:Name="RivetTR" Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4.5"
                                     Points="2,0 4,2 2,4 0,2" Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                            <Polygon x:Name="RivetBL" Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4.5"
                                     Points="2,0 4,2 2,4 0,2" Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                            <Polygon x:Name="RivetBR" Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4.5"
                                     Points="2,0 4,2 2,4 0,2" Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" />
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="RivetTL" Property="Fill" Value="{DynamicResource GiltBrush}" />
                            <Setter TargetName="RivetTR" Property="Fill" Value="{DynamicResource GiltBrush}" />
                            <Setter TargetName="RivetBL" Property="Fill" Value="{DynamicResource GiltBrush}" />
                            <Setter TargetName="RivetBR" Property="Fill" Value="{DynamicResource GiltBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
