<!--
    Swallowtail: DefaultControls/GroupBox.xaml.
    Content-sized Harbor Dossier card (no wide non-Canvas Path or fixed >=200px width so Playnite's Statistics
    sections wrap cleanly as compact cards). Flared Save-slot corner ticks + Constantia gold header + skull rule.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <!-- 4% gouache paper texture -->
                            <Rectangle Fill="{DynamicResource TextBrushDarker}" Opacity="0.035"
                                       OpacityMask="{DynamicResource LocalParchmentGrainMask}" IsHitTestVisible="False" />
                            <!-- Small corner ticks (7x7, never inflating card width) -->
                            <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3"
                                  Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.2" Data="M0,7 V0 H7" IsHitTestVisible="False" />
                            <Path Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"
                                  Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.2" Data="M0,0 H7 V7" IsHitTestVisible="False" />
                            <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3"
                                  Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.2" Data="M0,0 V7 H7" IsHitTestVisible="False" />
                            <Path Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3"
                                  Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.2" Data="M0,7 H7 V0" IsHitTestVisible="False" />

                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="{DynamicResource GroupBoxHeaderPadding}"
                                        Margin="{DynamicResource GroupBoxHeaderMargin}"
                                        BorderBrush="{DynamicResource NormalBrush}" BorderThickness="0,0,0,1.5">
                                    <StackPanel Orientation="Horizontal">
                                        <Polygon Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0"
                                                 Points="3,0 6,3 3,6 0,3" Fill="{DynamicResource GiltBrush}" IsHitTestVisible="False" />
                                        <TextBlock FontFamily="{DynamicResource HeadingFontFamily}"
                                                   FontSize="{DynamicResource GroupBoxHeaderFontSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SectionHeaderBrush}"
                                                   VerticalAlignment="Center">
                                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
