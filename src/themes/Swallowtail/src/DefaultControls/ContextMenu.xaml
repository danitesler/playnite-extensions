<!--
    Swallowtail: DefaultControls/ContextMenu.xaml.
    Unified Swallowtail popup board (LocalSwallowtailMenuBoardTemplate), shared by ContextMenu, TopPanelMenu,
    Menu submenus, and ComboBox dropdowns:
    - Panel: #0F2736 harbor night-stage board with 4% parchment-grain.png, 1.5px Deep Aqua perimeter rim, four
      flared Save-slot corner ticks in dim gold, crowned by a wavy 7px Deep Aqua swallowtail top ribbon and a
      centered Pirate Gold shield-crest pip rising 4px above the board.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Night-Harbor Swallowtail Board Template (menus, submenus, ComboBox dropdowns) -->
    <ControlTemplate x:Key="LocalSwallowtailMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid Margin="0,4,0,0" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Harbor night-stage panel body -->
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="{DynamicResource PopupBorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <Grid ClipToBounds="True">
                    <!-- 4% gouache paper grain -->
                    <Rectangle Fill="{DynamicResource TextBrushDarker}" Opacity="0.04"
                               OpacityMask="{DynamicResource LocalParchmentGrainMask}" />

                    <!-- 7px wavy Deep Aqua swallowtail ribbon strip along top edge -->
                    <Grid Height="7" VerticalAlignment="Top">
                        <Rectangle Fill="{DynamicResource HeaderBandBrush}" />
                        <Rectangle Fill="{DynamicResource LinkBrush}" Opacity="0.32"
                                   OpacityMask="{DynamicResource LocalRibbonSwirlMask}" />
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource GiltDimBrush}" Opacity="0.7" />
                    </Grid>

                    <!-- Four flared Save-slot corner ticks -->
                    <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,9,0,0"
                          Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.2" Data="M0,7 V0 H7" />
                    <Path Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,3,0"
                          Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.2" Data="M0,0 H7 V7" />
                    <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,3"
                          Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.2" Data="M0,0 V7 H7" />
                    <Path Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                          Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.2" Data="M0,7 H7 V0" />
                </Grid>
            </Border>

            <!-- Miniature Pirate Gold shield crest rising 4px above the top swallowtail ribbon -->
            <Viewbox Width="12" Height="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-4,0,0">
                <Path Fill="{DynamicResource GiltBrush}" Data="M2,3 L8,0 L14,3 L12.5,9 L8,11 L3.5,9 Z" />
            </Viewbox>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalSwallowtailMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="4,13,4,6" CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
