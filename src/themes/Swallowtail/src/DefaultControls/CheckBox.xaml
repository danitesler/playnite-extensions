<!--
    Swallowtail: DefaultControls/CheckBox.xaml.
    Return to Monkey Island's signature Display / Text & Language checkbox:
    bold crisp-white 8-point notched octagon outline over dark espresso leather (CheckBoxCheckMarkBkBrush),
    filling with a solid Pirate Gold (GlyphBrush) rotated diamond core springing in via BackEase on check.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource CheckBoxCheckMarkBkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 19x19 Notched 8-Point Octagon Frame -->
                        <Grid Grid.Column="0" Width="19" Height="19" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Ellipse x:Name="HoverHalo" Margin="-3" Fill="{DynamicResource CheckBoxCheckedHoverBackgroundBrush}"
                                     Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            <Path x:Name="OctagonFrame" Stretch="Uniform"
                                  Fill="{TemplateBinding Background}"
                                  Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.9"
                                  Data="{DynamicResource LocalNotchedOctagonGeometry}" />
                            <!-- Solid Pirate Gold diamond core -->
                            <Polygon x:Name="CheckDiamond" Width="9" Height="9"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Points="4.5,0 9,4.5 4.5,9 0,4.5"
                                     Fill="{DynamicResource GlyphBrush}"
                                     Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Polygon.RenderTransform>
                                    <ScaleTransform x:Name="DiamondScale" ScaleX="0.4" ScaleY="0.4" />
                                </Polygon.RenderTransform>
                            </Polygon>
                            <!-- Indeterminate bronze bar -->
                            <Rectangle x:Name="IndeterminateBar" Width="7" Height="2.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Fill="{DynamicResource WarningBrush}" Visibility="Collapsed" />
                        </Grid>

                        <ContentPresenter Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OctagonFrame" Property="Stroke" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ChkHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverHalo" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverHalo" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ChkHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverHalo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverHalo" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ChkOn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckDiamond" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="CheckDiamond" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="DiamondScale" Storyboard.TargetProperty="ScaleX" From="0.4" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.32" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="DiamondScale" Storyboard.TargetProperty="ScaleY" From="0.4" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.32" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ChkOff">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="CheckDiamond" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckDiamond" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="IndeterminateBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
