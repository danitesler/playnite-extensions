<!--
    Swallowtail: DefaultControls/Button.xaml.
    Dark Aqua harbor-teal button plate (ControlHeight=32 via Height=NaN trigger, ControlCornerRadius=4).
    - IsDefault=True switches to Curled Pirate Gold ribbon primary button (Constantia Bold, Sepia Ink).
    - Width=41 trigger scales ThemeModifier edit/restore icon buttons cleanly 32/41 via LayoutTransform.
    - SecondaryButton keyed style powers More & Edit equal fixed-square buttons on both game pages.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5,1.5,1.5,3" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <Border x:Name="HoverPlate" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="PressedPlate" Background="{DynamicResource ButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <!-- Hand-painted gouache grain & calligraphic swirl texture -->
                                <Rectangle x:Name="GrainLayer" Fill="{DynamicResource LinkBrush}" Opacity="0.14"
                                           OpacityMask="{DynamicResource LocalParchmentGrainMask}" IsHitTestVisible="False" />
                                <Rectangle x:Name="SwirlLayer" Fill="{DynamicResource LinkBrush}" Opacity="0.14"
                                           OpacityMask="{DynamicResource LocalRibbonSwirlMask}" Margin="4,1" IsHitTestVisible="False" />
                                <!-- Crisp upper catchlight -->
                                <Rectangle x:Name="TopRim" Height="1" VerticalAlignment="Top" Fill="{DynamicResource LinkBrush}" Opacity="0.35" IsHitTestVisible="False" />
                                <!-- Side brass diamond studs (secondary) / swallowtail notches (primary IsDefault) -->
                                <Polygon x:Name="StudL" Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                                         Points="2,0 4,2 2,4 0,2" Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                                <Polygon x:Name="StudR" Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                         Points="2,0 4,2 2,4 0,2" Fill="{DynamicResource GiltDimBrush}" IsHitTestVisible="False" />
                                <Path x:Name="NotchL" Width="5" Stretch="Fill" HorizontalAlignment="Left"
                                      Fill="{DynamicResource PrimaryButtonBorderBrush}" Data="M0,0 L5,12 L0,24 Z"
                                      Visibility="Collapsed" IsHitTestVisible="False" />
                                <Path x:Name="NotchR" Width="5" Stretch="Fill" HorizontalAlignment="Right"
                                      Fill="{DynamicResource PrimaryButtonBorderBrush}" Data="M5,0 L0,12 L5,24 Z"
                                      Visibility="Collapsed" IsHitTestVisible="False" />
                                <Rectangle x:Name="DefaultGlint" Fill="{DynamicResource TextBrush}" Opacity="0"
                                           OpacityMask="{DynamicResource LocalGoldGlintMask}"
                                           Visibility="Collapsed" IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="HoverPlate" Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="PressedPlate" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                            <Setter TargetName="GrainLayer" Property="Fill" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                            <Setter TargetName="GrainLayer" Property="Opacity" Value="0.16" />
                            <Setter TargetName="SwirlLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TopRim" Property="Fill" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="TopRim" Property="Opacity" Value="0.38" />
                            <Setter TargetName="StudL" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StudR" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="NotchL" Property="Visibility" Value="Visible" />
                            <Setter TargetName="NotchR" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DefaultGlint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DefaultGlint" Property="Opacity" Value="0.20" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource GiltBrush}" />
                            <Setter TargetName="StudL" Property="Fill" Value="{DynamicResource GiltBrush}" />
                            <Setter TargetName="StudR" Property="Fill" Value="{DynamicResource GiltBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BtnHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="BtnHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                            <Setter TargetName="DefaultGlint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DefaultGlint" Property="Opacity" Value="0.28" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BtnPressIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="BtnPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
            </Trigger>
            <!-- Required ThemeModifier 41px icon button scale trigger (32/41 = 0.7804878048780488) -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- SecondaryButton: Equal fixed-square game-page More & Edit plates -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5,1.5,1.5,3" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <Border x:Name="HoverPlate" Background="{DynamicResource SecondaryButtonHoverBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="PressedPlate" Background="{DynamicResource SecondaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Rectangle Fill="{DynamicResource LinkBrush}" Opacity="0.14"
                                           OpacityMask="{DynamicResource LocalParchmentGrainMask}" IsHitTestVisible="False" />
                                <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource LinkBrush}" Opacity="0.30" IsHitTestVisible="False" />
                                <!-- Subtle brass corner L-ticks -->
                                <Path Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2.5"
                                      Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.1" Data="M0,6 V0 H6" IsHitTestVisible="False" />
                                <Path Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2.5"
                                      Stroke="{DynamicResource GiltDimBrush}" StrokeThickness="1.1" Data="M0,6 H6 V0" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource GiltBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource GiltHotBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressedPlate" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
