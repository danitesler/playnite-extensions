<!--
    Swallowtail: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys follow the shared theme vocabulary (scripts/data/theme-keys.json). Return to Monkey Island (2022)
    inspired token names live exclusively in tokens.css and placeholders here. Theme XAML reads brushes only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys + HeadingFontFamily) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">36</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Nunito, {{text:rtmi-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Berkshire Swash, {{text:rtmi-font-heading|Georgia}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:rtmi-font-mono|Consolas}}</FontFamily>

    <!-- Usable metadata content width; applied inside horizontal padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape (Playnite keys + shared radius scale) -->
    <Thickness x:Key="PopupBorderThickness">1.5</Thickness>
    <Thickness x:Key="ControlBorderThickness">1.5</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:rtmi-radius-md}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:rtmi-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:rtmi-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:rtmi-radius-xl}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:rtmi-radius-full}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{rtmi-ivory}}</Color>
    <Color x:Key="TextColorDarker">{{rtmi-mist}}</Color>
    <Color x:Key="TextColorDark">{{rtmi-ink-dark}}</Color>
    <Color x:Key="MainColor">{{rtmi-aqua-dark}}</Color>
    <Color x:Key="MainColorDark">{{rtmi-curtain-shadow}}</Color>
    <Color x:Key="HoverColor">{{rtmi-hover-curtain}}</Color>
    <Color x:Key="GlyphColor">{{rtmi-gold}}</Color>
    <Color x:Key="HighlightGlyphColor">{{rtmi-gold-glow}}</Color>
    <Color x:Key="PopupBackgroundColor">{{rtmi-curtain-shadow}}</Color>
    <Color x:Key="PopupBorderColor">{{rtmi-aqua-deep}}</Color>
    <Color x:Key="BackgroundToneColor">{{rtmi-harbor-deep}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{rtmi-aqua-deep}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{rtmi-satchel-stitch}}</Color>
    <Color x:Key="DataChangeNotifColor">{{rtmi-bronze}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{rtmi-curtain-shadow}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{rtmi-aqua-dark}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{rtmi-satchel-leather}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{rtmi-ectoplasm-bright}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{rtmi-crimson}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{rtmi-bronze-bright}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{rtmi-bronze}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{rtmi-curtain-shadow}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{rtmi-stage-void}}" />

    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{rtmi-harbor-deep}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{rtmi-stage-void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{rtmi-harbor-deep}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{rtmi-satchel-leather}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{rtmi-satchel-hover}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{rtmi-ink-dark}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{rtmi-scrim}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{rtmi-aqua-dark}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{rtmi-selected-curtain}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{rtmi-selected-hover}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{rtmi-aqua-bright}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{rtmi-ectoplasm}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{rtmi-ivory}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{rtmi-hover-curtain}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{rtmi-selected-curtain}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{rtmi-menu-highlight}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{rtmi-gold-glow}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{rtmi-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{rtmi-ivory}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{rtmi-ivory}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{rtmi-ivory}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{rtmi-ivory}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{rtmi-curtain-shadow}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{rtmi-gold-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{rtmi-gold-bright}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{rtmi-gold-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{rtmi-ink-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{rtmi-gold-glow}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{rtmi-curtain-shadow}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{rtmi-aqua-dark}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{rtmi-harbor-deep}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{rtmi-aqua-deep}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{rtmi-satchel-leather}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{rtmi-satchel-hover}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{rtmi-satchel-rim}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{rtmi-aqua-bright}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{rtmi-ivory}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{rtmi-gold-bright}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{rtmi-gold-glow}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{rtmi-satchel-stitch}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{rtmi-gold-bright}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{rtmi-bronze-bright}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{rtmi-satchel-leather}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{rtmi-aqua-bright}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{rtmi-harbor-deep}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{rtmi-mist}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{rtmi-ivory}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{rtmi-aqua-bright}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{rtmi-harbor-deep}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{rtmi-ivory}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{rtmi-hover-curtain}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{rtmi-mist}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{rtmi-gold-glow}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{rtmi-parchment-chip}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{rtmi-parchment-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{rtmi-parchment-chip-hover}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{rtmi-aqua-pale}}" />

    <!-- Popups, Frames & Typography accents -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{rtmi-gold-dim}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{rtmi-ivory}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{rtmi-harbor-deep}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{rtmi-aqua-dark}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{rtmi-ivory}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="GiltBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="GiltHotBrush" Color="{{rtmi-gold-bright}}" />
    <SolidColorBrush x:Key="GiltDimBrush" Color="{{rtmi-gold-dim}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{rtmi-aqua-deep}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{rtmi-gold}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{rtmi-bronze-bright}}" />
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{rtmi-parchment}}" />
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{rtmi-parchment-edge}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{rtmi-parchment-ink}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{rtmi-parchment-title}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{rtmi-parchment-label}}" />
    <SolidColorBrush x:Key="ParchmentLinkBrush" Color="{{rtmi-parchment-link}}" />

    <!-- Game page -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{rtmi-aqua-dark}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{rtmi-stage-void}}" />
    <LinearGradientBrush x:Key="LocalGameTitleBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{rtmi-title-top}}" Offset="0" />
        <GradientStop Color="{{rtmi-title-mid}}" Offset="0.52" />
        <GradientStop Color="{{rtmi-title-bot}}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LocalGameTitleOutlineBrush" Color="{{rtmi-title-outline}}" />
</ResourceDictionary>
