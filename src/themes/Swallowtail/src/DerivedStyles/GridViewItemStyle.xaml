<!--
    Swallowtail: DerivedStyles/GridViewItemStyle.xaml.
    Return to Monkey Island Load/Save 3x3 pinched concave slot frames on cover tiles:
    - Idle: subtle Deep Aqua pinched Save-slot frame.
    - Hover: smooth BackEase scale (1.022) + crisp Storybook Ivory pinched Save-slot frame fading in (130ms).
    - Selected: bold Pirate Gold pinched Save-slot frame + flared gold corner ear-ticks + bottom-center miniature
      notched Deep Aqua ribbon tab settling in smoothly (180ms BackEase).
    - Running / Launching (inset Margin="4" above selection/hover layers): Ghost-Ship Emerald 2px frame + soft
      inner band + angled spectral comet sweep + bottom 16px tide bar holding RunningFill & 3 drifting lantern wisps.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Margin="{Settings ItemSpacingMargin}" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <!-- Cover content presenter -->
                        <ContentPresenter />

                        <!-- Idle subtle Deep Aqua pinched Save-slot border -->
                        <Control Template="{DynamicResource LocalPinchFrameTemplate}"
                                 BorderBrush="{DynamicResource SlotBorderBrush}" Opacity="0.72"
                                 IsHitTestVisible="False" />

                        <!-- Hover layer: crisp Storybook Ivory pinched Save-slot frame (Load/Save empty-slot hover) -->
                        <Control x:Name="HoverFrame" Template="{DynamicResource LocalPinchFrameTemplate}"
                                 BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}"
                                 Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                        <!-- Selected layer: Pirate Gold pinched Save-slot frame + flared corner ticks + bottom teal notch -->
                        <Grid x:Name="SelectedFrame" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Control Template="{DynamicResource LocalPinchFrameTemplate}"
                                     BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" />
                            <Path Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1"
                                  Stroke="{DynamicResource GiltHotBrush}" StrokeThickness="2" Data="M0,11 V0 H11" />
                            <Path Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-1"
                                  Stroke="{DynamicResource GiltHotBrush}" StrokeThickness="2" Data="M0,0 H11 V11" />
                            <Path Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-1"
                                  Stroke="{DynamicResource GiltHotBrush}" StrokeThickness="2" Data="M0,0 V11 H11" />
                            <Path Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-1"
                                  Stroke="{DynamicResource GiltHotBrush}" StrokeThickness="2" Data="M0,11 H11 V0" />
                            <Path Width="44" Height="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-2"
                                  Fill="{DynamicResource HeaderBandBrush}" Stroke="{DynamicResource GiltBrush}" StrokeThickness="1"
                                  Data="M0,0 H44 L40,4.5 L44,9 H0 L4,4.5 Z" />
                        </Grid>

                        <!-- Running / Launching Indicator (drawn ABOVE Hover & Selected layers, inset 4px inside cover) -->
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="1"
                              IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningBand" BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                    BorderThickness="6" CornerRadius="{DynamicResource CornerRadiusLarge}" Opacity="0.18" />
                            <Border x:Name="RunningScan" Visibility="Collapsed"
                                    Background="{DynamicResource PositiveRatingBrush}" Opacity="0.34"
                                    CornerRadius="{DynamicResource CornerRadiusLarge}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <!-- 2px Ghost-Ship Emerald inset frame -->
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                    BorderThickness="2" CornerRadius="{DynamicResource CornerRadiusLarge}">
                                <Border BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1" Opacity="0.65"
                                        CornerRadius="{DynamicResource ControlCornerRadius}" />
                            </Border>
                            <!-- 16px harbor tide strip at cover foot holding RunningFill & 3 lantern wisps -->
                            <Border Height="16" VerticalAlignment="Bottom" Margin="2"
                                    CornerRadius="0,0,4,4" Background="{DynamicResource ScrimBrush}" Opacity="0.82">
                                <Grid Margin="6,0">
                                    <Grid Height="2" VerticalAlignment="Center" Margin="0,0,32,0">
                                        <Border CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.36" />
                                        <Border x:Name="RunningFill" CornerRadius="1" Background="{DynamicResource PositiveRatingBrush}"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Polygon x:Name="CovWisp1" Width="5" Height="5" Margin="0,0,3,0" Points="2.5,0 5,2.5 2.5,5 0,2.5"
                                                 Fill="{DynamicResource PositiveRatingBrush}" Opacity="0.7">
                                            <Polygon.RenderTransform><TranslateTransform x:Name="CovWisp1Y" Y="1" /></Polygon.RenderTransform>
                                        </Polygon>
                                        <Polygon x:Name="CovWisp2" Width="6" Height="6" Margin="0,0,3,0" Points="3,0 6,3 3,6 0,3"
                                                 Fill="{DynamicResource TextBrush}" Opacity="0.95">
                                            <Polygon.RenderTransform><TranslateTransform x:Name="CovWisp2Y" Y="-1" /></Polygon.RenderTransform>
                                        </Polygon>
                                        <Polygon x:Name="CovWisp3" Width="5" Height="5" Points="2.5,0 5,2.5 2.5,5 0,2.5"
                                                 Fill="{DynamicResource PositiveRatingBrush}" Opacity="0.75">
                                            <Polygon.RenderTransform><TranslateTransform x:Name="CovWisp3Y" Y="0" /></Polygon.RenderTransform>
                                        </Polygon>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="10" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CoverHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.022" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.22" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.022" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.22" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CoverHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="8" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CoverSelectIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CoverSelectOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Running / Launching DataTriggers -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.58" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovWisp1Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="-2.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovWisp2Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.20" Value="-3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.52" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovWisp3Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.30" Value="-2.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.58" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovWisp1Y" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="-2" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovWisp2Y" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="-2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovWisp3Y" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="-2" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.5" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
