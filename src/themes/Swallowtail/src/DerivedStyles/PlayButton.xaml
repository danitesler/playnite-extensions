<!--
    Swallowtail: DerivedStyles/PlayButton.xaml (Curled Pirate-Gold Ribbon CTA + Ghost-Ship Emerald RunningActionIndicator).
    - PlayButton: ControlCornerRadius=4 Pirate Gold ribbon plate with folded dark-gold underside shadow corner,
      left swallowtail notch, Constantia Bold Title-Case Sepia Ink label; hover warms to Sunlit Gold (#F5CE4B)
      and sweeps gold-glint.png lantern sheen; press sinks into Ribbon Fold Gold (#B8870B).
    - Tag="ContextAction" hides Play-only glyphs (PlayGlyph, PlaySwallowNotch, PlayFoldTail).
    - IsLaunching / IsRunning switch the slab fill to solid Ghost-Ship Emerald (RunningIndicatorBrush, #137A59)
      with Ivory TextBrush (>=4.9:1 bare, 6.5-9.8:1 under RunningBreath scrim), collapse idle HoverPlate, reserve
      PlayRoom (0,0,34,0) for the 3 drifting ghost-lantern diamond wisps, sweep an angled spectral comet (RunningScan)
      while launching, and show LOCCancelLabel + RunningHoverDim only on IsRunning + RelativeSource Self IsMouseOver
      while keeping PlayContent Visibility="Hidden".
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinWidth" Value="156" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="18,0,20,0" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="BtnLiftY" Y="0" />
                        </Grid.RenderTransform>

                        <!-- Main Curled Pirate-Gold Ribbon Plate -->
                        <Border x:Name="PlayFill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <!-- Idle Play hover layer (collapsed while launching/running) -->
                                <Border x:Name="HoverPlate" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Sweeping warm lantern glint (gold-glint.png) on hover -->
                                <Rectangle x:Name="HoverGlint" Fill="{DynamicResource TextBrush}"
                                           OpacityMask="{DynamicResource LocalGoldGlintMask}"
                                           Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="GlintX" X="-120" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>

                                <!-- Separate Pressed layer -->
                                <Border x:Name="PressedPlate" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Play-only folded underside ribbon corner & left swallowtail notch -->
                                <Path x:Name="PlaySwallowNotch" Width="6" HorizontalAlignment="Left" Stretch="Fill"
                                      Fill="{DynamicResource PrimaryButtonBorderBrush}" Data="M0,0 L6,20 L0,40 Z"
                                      IsHitTestVisible="False" />
                                <Path x:Name="PlayFoldTail" Width="18" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Fill="{DynamicResource PrimaryButtonBorderBrush}" Data="M0,8 L18,0 L18,8 Z"
                                      IsHitTestVisible="False" />

                                <!-- RunningBreath scrim (darkens solid RunningIndicatorBrush plate for >=6.5:1 Ivory legibility) -->
                                <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}"
                                        CornerRadius="{DynamicResource CornerRadiusSmall}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- RunningScan angled spectral mist comet across the button slab while launching -->
                                <Border x:Name="RunningScan" Visibility="Collapsed"
                                        Background="{DynamicResource PositiveRatingBrush}" Opacity="0.65"
                                        IsHitTestVisible="False">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>

                                <!-- RunningHoverDim scrim shown strictly with Cancel on RUNNING + button hover -->
                                <Border x:Name="RunningHoverDim" Background="{DynamicResource ScrimBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- RunningMarkRoom left="0" right="34" -->
                                <Border x:Name="PlayRoom" Padding="0">
                                    <StackPanel x:Name="PlayContent" Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentControl x:Name="PlayGlyph" Width="13" Height="13" Margin="0,0,8,0"
                                                        VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False"
                                                        Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{TemplateBinding Foreground}">
                                            <ContentControl.RenderTransform>
                                                <TranslateTransform x:Name="GlyphNudgeX" X="0" />
                                            </ContentControl.RenderTransform>
                                        </ContentControl>
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                    </StackPanel>
                                </Border>

                                <!-- Cancel label: visible ONLY when IsRunning=True AND button Self IsMouseOver=True -->
                                <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                           FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlaySwallowNotch" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayFoldTail" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Idle Play hover: warm Sunlit Gold lift + lantern glint sweep -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlint" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="HoverGlint" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="GlintX" Storyboard.TargetProperty="X" From="-110" To="26" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BtnLiftY" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.24" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlyphNudgeX" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="HoverGlint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="BtnLiftY" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="GlyphNudgeX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlint" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Separate Pressed state -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayPressIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="BtnLiftY" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="BtnLiftY" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- LAUNCHING: Solid Ghost-Ship Emerald plate + RunningBreath + angled spectral comet sweep -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PlayFill" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource PositiveRatingBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverGlint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,34,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlaySlabLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="PlaySlabLaunchBreath">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.30" To="0.46" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlaySlabLaunching" />
                                <RemoveStoryboard BeginStoryboardName="PlaySlabLaunchBreath" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING: Solid Ghost-Ship Emerald plate + calm 3.2s breathing RunningBreath scrim -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PlayFill" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource PositiveRatingBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverGlint" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,34,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlaySlabRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.24" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.44" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.24" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlaySlabRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING + Button Self Hover: reveal CancelLabel & dim scrim while keeping PlayContent Hidden -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningHoverDim" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" From="0" To="0.46" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RunningActionIndicator overlay sitting over the Play / ContextAction cell in both game overviews -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="1" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                BorderThickness="1.5" CornerRadius="{DynamicResource ControlCornerRadius}" />

                        <!-- Double-notched seafoam tide foot line -->
                        <Grid Height="2" Margin="6,0,6,4" VerticalAlignment="Bottom">
                            <Border CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34" />
                            <Border x:Name="RunningFill" CornerRadius="1" Background="{DynamicResource PositiveRatingBrush}"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <!-- 3 Drifting Ghost-Ship Lantern Diamond Wisps on right edge (clear of label via 34px PlayRoom) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Polygon x:Name="BtnWisp1" Width="6" Height="6" Margin="0,0,3,0" Points="3,0 6,3 3,6 0,3"
                                     Fill="{DynamicResource PositiveRatingBrush}" Opacity="0.65">
                                <Polygon.RenderTransform><TranslateTransform x:Name="BtnWisp1Y" Y="1" /></Polygon.RenderTransform>
                            </Polygon>
                            <Polygon x:Name="BtnWisp2" Width="7" Height="7" Margin="0,0,3,0" Points="3.5,0 7,3.5 3.5,7 0,3.5"
                                     Fill="{DynamicResource TextBrush}" Opacity="0.92">
                                <Polygon.RenderTransform><TranslateTransform x:Name="BtnWisp2Y" Y="-1" /></Polygon.RenderTransform>
                            </Polygon>
                            <Polygon x:Name="BtnWisp3" Width="6" Height="6" Points="3,0 6,3 3,6 0,3"
                                     Fill="{DynamicResource PositiveRatingBrush}" Opacity="0.72">
                                <Polygon.RenderTransform><TranslateTransform x:Name="BtnWisp3Y" Y="0" /></Polygon.RenderTransform>
                            </Polygon>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.58" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnWisp1Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="-3.5" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.42" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnWisp2Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="-4.5" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.52" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnWisp3Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.28" Value="-3.5" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.58" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnWisp1Y" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="-2" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="1.5" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnWisp2Y" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="-2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BtnWisp3Y" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="-2.5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.5" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
