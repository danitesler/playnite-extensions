<!--
    Swallowtail: DerivedStyles/StandardWindowStyle.xaml.
    44px nocturnal harbor Settings & Dialog Title Band (CaptionHeight=44 == content top Margin=44).
    Crowned at center by Return to Monkey Island's signature wavy Deep Aqua swallowtail ribbon
    (LocalSwallowtailRibbonTemplate + ribbon-swirl.png) carrying the Pirate Gold Swallowtail Crest mark
    and Constantia Title-Case window title (WindowSettings trigger sets LOCSettingsLabel).
    WindowDesignStyle is defined standalone (never BasedOn StandardWindowStyle).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource NormalBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Nocturnal sea-chart texture, right-edge theater curtain drape & sketchy helm/spyglass doodles -->
                                <Grid Margin="0,44,0,0" ClipToBounds="True" IsHitTestVisible="False">
                                    <Rectangle Fill="{DynamicResource NormalBrush}" Opacity="0.18"
                                               OpacityMask="{DynamicResource LocalStageChartMask}" />
                                    <Rectangle Width="130" HorizontalAlignment="Right" Fill="{DynamicResource NormalBrush}" Opacity="0.22"
                                               OpacityMask="{DynamicResource LocalCurtainDrapeMask}" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform ScaleX="-1" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Control Template="{DynamicResource LocalSettingsSketchesTemplate}" />
                                </Grid>

                                <!-- Dialog content offset equals CaptionHeight (44px) -->
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px Nocturnal Harbor Title Band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}">
                                    <!-- Gouache grain, theater curtain pleats, calligraphic swirl & brass rope seam clipped in Canvas so small dialogs stay content-sized -->
                                    <Grid ClipToBounds="True" IsHitTestVisible="False">
                                        <Rectangle Fill="{DynamicResource NormalBrush}" Opacity="0.24"
                                                   OpacityMask="{DynamicResource LocalParchmentGrainMask}" />
                                        <Canvas>
                                            <Rectangle Width="120" Height="44" Canvas.Left="0" Canvas.Top="0"
                                                       Fill="{DynamicResource NormalBrush}" Opacity="0.30"
                                                       OpacityMask="{DynamicResource LocalCurtainDrapeMask}" />
                                            <Rectangle Width="360" Height="38" Canvas.Left="110" Canvas.Top="2"
                                                       Fill="{DynamicResource LinkBrush}" Opacity="0.14"
                                                       OpacityMask="{DynamicResource LocalRibbonSwirlMask}" />
                                            <Line X1="0" Y1="40" X2="2600" Y2="40" Stroke="{DynamicResource GiltDimBrush}"
                                                  StrokeThickness="1" StrokeDashArray="5 4" Opacity="0.45" />
                                        </Canvas>
                                        <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource GiltDimBrush}" Opacity="0.38" />
                                    </Grid>

                                    <!-- Left brass diamond + tapered aqua ornament -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                                        <Polygon Width="7" Height="7" Points="3.5,0 7,3.5 3.5,7 0,3.5" Fill="{DynamicResource GiltBrush}" VerticalAlignment="Center" />
                                        <Rectangle Width="28" Height="1" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}" Opacity="0.7" />
                                    </StackPanel>

                                    <!-- Centered wavy Deep Aqua swallowtail ribbon carrying BrandMark + Title -->
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="34" Margin="44,0,144,0" IsHitTestVisible="False">
                                        <Control Template="{DynamicResource LocalSwallowtailRibbonTemplate}"
                                                 Background="{DynamicResource HeaderBandBrush}"
                                                 Foreground="{DynamicResource LinkBrush}" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28,0,28,0">
                                            <Control Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Template="{DynamicResource BrandMarkTemplate}"
                                                     Foreground="{DynamicResource WindowTitleForegroundBrush}" />
                                            <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Caption buttons (46x44) -->
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Panel.ZIndex="3">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>

                                    <!-- 1.5px Deep Aqua closing rule -->
                                    <Rectangle Height="1.5" VerticalAlignment="Bottom" Fill="{DynamicResource NormalBorderBrush}" IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standalone WindowDesignStyle (never BasedOn StandardWindowStyle to avoid Window vs WindowBase Style.Seal crash) -->
    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
