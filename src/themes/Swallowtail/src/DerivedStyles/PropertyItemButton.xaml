<!--
    Swallowtail: DerivedStyles/PropertyItemButton.xaml.
    Metadata property values rendered on the warm torn-parchment dossier sheet:
    deep harbor-teal ink links (ParchmentLinkBrush) by default, and wooden/parchment keycap plaques
    with a dark sepia notched diamond pip when owning ItemsControl has Tag="Chip".
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ParchmentLinkBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <TextBlock x:Name="LinkLabel" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap">
                            <ContentPresenter />
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LinkLabel" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                            <Setter TargetName="LinkLabel" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="Margin" Value="0,0,5,5" />
                <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ChipPlate" Background="{DynamicResource PropertyItemBackgroundBrush}"
                                    BorderBrush="{DynamicResource ParchmentEdgeBrush}" BorderThickness="1,1,1,2"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="6,2,8,2" SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Polygon x:Name="ChipPip" Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,5,0"
                                             Points="2.5,0 5,2.5 2.5,5 0,2.5" Fill="{DynamicResource ParchmentTitleBrush}" IsHitTestVisible="False" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipPlate" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                                    <Setter TargetName="ChipPlate" Property="BorderBrush" Value="{DynamicResource ParchmentLinkBrush}" />
                                    <Setter TargetName="ChipPip" Property="Fill" Value="{DynamicResource ParchmentLinkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
