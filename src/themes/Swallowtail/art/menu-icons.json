{
  "_comment": "Swallowtail: 24 bare menu icons drawn like Return to Monkey Island's title lettering: solid gold-to-orange silhouettes with a dark varnish rim, a lantern gloss, Deep Aqua details and a jaunty tilt. Tones from src/tokens.css: danger = crimson, gold = pirate gold, ok = ghost-ship emerald. Render: node scripts/render-menu-icons.mjs Swallowtail --sheet",
  "dir": "Swallowtail",
  "mode": "solid",
  "glyph": {
    "ink": "#120A05",
    "body": ["#FFE268", "#F59B1A", "#D44E0E"],
    "acc": "#3CA3CC",
    "sw": 2.0,
    "cap": "round",
    "join": "round"
  },
  "gs": 0.95,
  "finish": "gloss",
  "finishOpacity": 0.3,
  "transform": { "rotate": -3, "scaleY": 1.02 },
  "halo": { "c": "#120A05", "w": 1.2 },
  "tones": { "danger": "#EA4C52", "gold": "#F5CE4B", "ok": "#34C796" },
  "toneStyles": {
    "danger": { "ink": "#120A05", "body": ["#EA4C52", "#9E1F25"], "acc": "#FFE268" },
    "ok": { "ink": "#120A05", "body": ["#34C796", "#137A59"], "acc": "#FFE268" }
  },
  "pick": {
    "FullscreenModeIcon": "f",
    "AddGameIcon": "d",
    "UpdateDbIcon": "e",
    "AboutPlayniteIcon": "c",
    "ExitIcon": "e",
    "SettingsIcon": "e",
    "AddonsIcon": "c",
    "DiceIcon": "f",
    "PlayIcon": "d",
    "InstallIcon": "a",
    "OpenFolderIcon": "b",
    "ManualIcon": "b",
    "RestoreBackupIcon": "b"
  },
  "plates": { "rest": "#0F2736", "hover": "#154963" }
}
