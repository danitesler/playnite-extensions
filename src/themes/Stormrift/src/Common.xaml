<!--
    Stormrift: spacing, focus and shared Nexus motifs. Measurements: ../RESEARCH.md & HotS Options/Ready HUD captures.
      BevelTemplate          sculpted cosmic-indigo plate: vertical depth shadow, top-center radial dome glow, fine hex-mesh
                             grain, 1px top specular flare, subtle bottom horizon bounce, and crisp rim
      ChamferTemplate        pointed-hex Ready slab: angled 12px hex wings with vertical depth, radial dome light, subtle hex
                             grain, top inner bevel gleam, and crisp perimeter rim
      FramedPlateTemplate    panel frame with 1px border and centered top glow flare
      SelectionBarTemplate   HotS active plate: magenta-violet dome glow, subtle hex grain, top specular hairline,
                             ice-periwinkle rim, and 2px cyan left bar
      GlowLineTemplate       16px rule fading at both ends with a bright centered ice-blue flare
      GlowFrameTemplate      9-slice cosmic bloom behind hovered plates (negative margin decided by host)
      TabItemIndicatorTemplate  centered glowing ice-blue bar for active tabs and view switches
      DividerTemplate        section heading rule fading out to the right
      CornerMarksTemplate    2px corner brackets (arm 8) for keyboard focus and target hover
      BrandMarkTemplate      the Stormrift faceted hexagon + 3-shard vortex emblem
    Sprites in Images/fx/ are white masks filled with theme brushes so ThemeModifier recolors them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">14,7,10,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">14,7,10,7</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,0</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Shared form field and button height across all themes (32px). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Sculpted cosmic bevelled plate: Background + depth shadow + top radial dome light + fine hex grain + top/bottom edge glints. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Background="{DynamicResource BevelShadowBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0D000000" Offset="0" />
                        <GradientStop Color="#45000000" Offset="0.58" />
                        <GradientStop Color="#78000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <Border Background="{DynamicResource ButtonHoverBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.45">
                <Border.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.12" GradientOrigin="0.5,0.08" RadiusX="0.72" RadiusY="0.88">
                        <GradientStop Color="#AA000000" Offset="0" />
                        <GradientStop Color="#38000000" Offset="0.55" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Border.OpacityMask>
            </Border>
            <Border Background="{DynamicResource BevelLightBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.055">
                <Border.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/hexgrid.png'}" TileMode="Tile" Viewport="0,0,14,24" ViewportUnits="Absolute" />
                </Border.OpacityMask>
            </Border>
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Rectangle Height="1" Margin="2,1,2,0" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Opacity="0.48">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" Margin="4,0,4,1" VerticalAlignment="Bottom" Fill="{DynamicResource FrameHoverBrush}" Opacity="0.22">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Pointed-hex Ready slab: angled 12px hex wings with vertical depth, top radial dome glow, faint hex grain, and crisp rim. -->
    <ControlTemplate x:Key="ChamferTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Stretch="Fill" Margin="0,0,-0.5,0" Fill="{TemplateBinding Background}" Data="M12,0 L12,48 L0,24 Z" />
                <Border Grid.Column="1" Background="{TemplateBinding Background}" />
                <Path Grid.Column="2" Stretch="Fill" Margin="-0.5,0,0,0" Fill="{TemplateBinding Background}" Data="M0,0 L12,24 L0,48 Z" />
            </Grid>
            <Grid>
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#08000000" Offset="0" />
                        <GradientStop Color="#44000000" Offset="0.6" />
                        <GradientStop Color="#72000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Stretch="Fill" Margin="0,0,-0.5,0" Fill="{DynamicResource BevelShadowBrush}" Data="M12,0 L12,48 L0,24 Z" />
                <Border Grid.Column="1" Background="{DynamicResource BevelShadowBrush}" />
                <Path Grid.Column="2" Stretch="Fill" Margin="-0.5,0,0,0" Fill="{DynamicResource BevelShadowBrush}" Data="M0,0 L12,24 L0,48 Z" />
            </Grid>
            <Grid Opacity="0.22">
                <Grid.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.14" GradientOrigin="0.5,0.08" RadiusX="0.65" RadiusY="0.85">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#55000000" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Grid.OpacityMask>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Stretch="Fill" Margin="0,0,-0.5,0" Fill="{DynamicResource BevelLightBrush}" Data="M12,0 L12,48 L0,24 Z" />
                <Border Grid.Column="1" Background="{DynamicResource BevelLightBrush}" />
                <Path Grid.Column="2" Stretch="Fill" Margin="-0.5,0,0,0" Fill="{DynamicResource BevelLightBrush}" Data="M0,0 L12,24 L0,48 Z" />
            </Grid>
            <Grid Opacity="0.08">
                <Grid.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/hexgrid.png'}" TileMode="Tile" Viewport="0,0,16,28" ViewportUnits="Absolute" />
                </Grid.OpacityMask>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Stretch="Fill" Margin="0,0,-0.5,0" Fill="{DynamicResource BevelLightBrush}" Data="M12,0 L12,48 L0,24 Z" />
                <Border Grid.Column="1" Background="{DynamicResource BevelLightBrush}" />
                <Path Grid.Column="2" Stretch="Fill" Margin="-0.5,0,0,0" Fill="{DynamicResource BevelLightBrush}" Data="M0,0 L12,24 L0,48 Z" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" StrokeLineJoin="Miter" Data="M12,0.6 L0.8,24 L12,47.4" />
                <Rectangle Grid.Column="1" Height="1.2" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}" />
                <Rectangle Grid.Column="1" Height="1.2" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}" />
                <Path Grid.Column="2" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" StrokeLineJoin="Miter" Data="M0,0.6 L11.2,24 L0,47.4" />
                <Rectangle Grid.Column="1" Height="1" Margin="0,1.2,0,0" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Opacity="0.55">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="0.5" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Grid.Column="1" Height="1" Margin="0,0,0,1.2" VerticalAlignment="Bottom" Fill="{DynamicResource FrameHoverBrush}" Opacity="0.24">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="0.5" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>
        </Grid>
    </ControlTemplate>

    <!-- Panel frame with 1px rim and centered top ice flare. -->
    <ControlTemplate x:Key="FramedPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Rectangle Height="1" VerticalAlignment="Top" Margin="16,0" Fill="{DynamicResource FrameHoverBrush}" Opacity="0.55">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Selection plate: magenta-violet radial dome flare fading smoothly, ice-periwinkle rim, top gleam, and 2px cyan left bar. -->
    <ControlTemplate x:Key="SelectionBarTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource ScrimBrush}" Opacity="0.4" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.92" Margin="1">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#D8000000" Offset="0.65" />
                        <GradientStop Color="#85000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Fill="{DynamicResource SelectedHoverBrush}" Margin="1" Opacity="0.85">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.16" GradientOrigin="0.5,0.08" RadiusX="0.68" RadiusY="0.9">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#44000000" Offset="0.55" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Fill="{DynamicResource BevelLightBrush}" Margin="1" Opacity="0.055">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/hexgrid.png'}" TileMode="Tile" Viewport="0,0,14,24" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" Margin="4,1,4,0" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Opacity="0.65">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource SidebarItemSelectedGlowBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Horizontal glowing rule: hairline in Foreground fading at ends, lit flare in BorderBrush at centre. -->
    <ControlTemplate x:Key="GlowLineTemplate" TargetType="Control">
        <Grid Height="16" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.16" />
                        <GradientStop Color="#FF000000" Offset="0.84" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" MaxWidth="360" VerticalAlignment="Center" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.35" />
                        <GradientStop Color="#FF000000" Offset="0.65" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="12" MaxWidth="280" VerticalAlignment="Center" Fill="{TemplateBinding BorderBrush}" Opacity="0.4">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/flare.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- 9-slice soft bloom using Images/fx/glow.png; host controls bleed via negative Margin. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="0,0,0.33,0.33" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="0.33,0,0.34,0.33" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="0.67,0,0.33,0.33" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="0,0.33,0.33,0.34" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="0.33,0.33,0.34,0.34" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="0.67,0.33,0.33,0.34" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="0,0.67,0.33,0.33" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="0.33,0.67,0.34,0.33" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="0.67,0.67,0.33,0.33" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="TabItemIndicatorTemplate" TargetType="Control">
        <Grid Height="4" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" />
            <Rectangle Height="4" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Opacity="0.42">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/flare.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Rectangle Height="1" VerticalAlignment="Center" IsHitTestVisible="False" Fill="{TemplateBinding Foreground}">
            <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF000000" Offset="0" />
                    <GradientStop Color="#66000000" Offset="0.7" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Corner brackets, arm 8, 2px. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,8 L0,0 8,0 8,2 2,2 2,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L8,0 8,8 6,8 6,2 0,2Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L2,0 2,6 8,6 8,8 0,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M6,0 L8,0 8,8 0,8 0,6 6,6Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource IconMainMenu}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
