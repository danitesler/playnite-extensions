<!--
    Stormrift: Slider. Glowing HotS azure/cyan energy beam fill (outer bloom + saturated bar + bright ice core filament)
    over a dark indigo track, topped by a tall 8x18 metallic silver-ice bevelled thumb with smooth hover/drag glow.
    Track.Thumb set last; disables ThemeModifier's GameBannerHeight / GameBannerDarken sliders when window background art
    is enabled. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SliderTrackButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderRangeButton" TargetType="RepeatButton" BasedOn="{StaticResource SliderTrackButton}" />

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="OuterHalo" Width="10" Height="20" CornerRadius="2" Background="{DynamicResource SliderThumbHoverBorderBrush}" Opacity="0" />
                        <Border x:Name="Plate" Width="8" Height="18" CornerRadius="1" Background="{DynamicResource SliderThumbBackgroundBrush}"
                                BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1" />
                        <Border Width="6" Height="16" CornerRadius="1" Background="{DynamicResource FrameHoverBrush}" Opacity="0.35">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF000000" Offset="0" />
                                    <GradientStop Color="#22000000" Offset="0.55" />
                                    <GradientStop Color="#66000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Border x:Name="Heat" Width="8" Height="18" CornerRadius="1" Background="{DynamicResource SliderThumbHoverBorderBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource SliderThumbHoverBorderBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OuterHalo" Storyboard.TargetProperty="Opacity" To="0.32" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="OuterHalo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Heat" Storyboard.TargetProperty="Opacity" To="0.52" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="OuterHalo" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Heat" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="OuterHalo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid x:Name="GridRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TickBar x:Name="TopTick" Visibility="Collapsed" Height="4" Placement="Top"
                                 SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Fill="{DynamicResource NormalBorderBrush}" />
                        <Grid Grid.Row="1">
                            <Border x:Name="Border" Height="4" CornerRadius="2" Margin="4,0" VerticalAlignment="Center"
                                    Background="{DynamicResource SliderTrackBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="0.6" />
                            <!-- Outer soft energy glow under the active track fill -->
                            <Border x:Name="FillGlow" Margin="4,0,0,0" Height="8" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Background="{DynamicResource SliderHoverForegroundBrush}" Opacity="0.28" Width="{Binding ActualWidth, ElementName=ButtonDecrease}" />
                            <Border x:Name="Fill" Margin="4,0,0,0" Height="4" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" Width="{Binding ActualWidth, ElementName=ButtonDecrease}" />
                            <!-- Crisp luminous energy filament inside the active bar (Gamma/Volume HotS look) -->
                            <Border x:Name="FillCore" Margin="4,0,0,0" Height="1.5" CornerRadius="1" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Background="{DynamicResource BevelLightBrush}" Opacity="0.72" Width="{Binding ActualWidth, ElementName=ButtonDecrease}" />
                            <Track x:Name="PART_Track" Height="{TemplateBinding Height}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="ButtonDecrease" Style="{DynamicResource SliderRangeButton}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="ButtonIncrease" Style="{StaticResource SliderTrackButton}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <TickBar x:Name="BottomTick" Visibility="Collapsed" Grid.Row="2" Height="4" Placement="Bottom"
                                 SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Fill="{DynamicResource NormalBorderBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SliderHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillGlow" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="FillCore" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="FillGlow" Storyboard.TargetProperty="Opacity" To="0.28" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="FillCore" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_Track" Property="FocusManager.FocusedElement" Value="{Binding ElementName=PART_Track}" />
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SliderHoverForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="TickPlacement" Value="TopLeft">
                            <Setter Property="Visibility" Value="Visible" TargetName="TopTick" />
                        </Trigger>
                        <Trigger Property="TickPlacement" Value="BottomRight">
                            <Setter Property="Visibility" Value="Visible" TargetName="BottomTick" />
                        </Trigger>
                        <Trigger Property="TickPlacement" Value="Both">
                            <Setter Property="Visibility" Value="Visible" TargetName="TopTick" />
                            <Setter Property="Visibility" Value="Visible" TargetName="BottomTick" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="LayoutTransform" TargetName="GridRoot">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerHeight" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerDarken" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
