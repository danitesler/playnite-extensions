<!--
    Overlay on Playnite Default/DefaultControls/Menu.xaml. Every popup menu (hamburger menu, top bar dropdowns, game
    and group menus, tray) is Heroes of the Storm's Nexus list on the cosmic panel of ContextMenu.xaml.
    Roles: TopLevelHeader and TopLevelItem (a horizontal Menu bar), SubmenuHeader and SubmenuItem (every popup menu).
    The Separator and MenuItem.SeparatorStyleKey are both redefined (the Default one points at its own sibling).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group break in every menu: Nexus centre-flared energy hairline (9px tall) split around a mini periwinkle hex. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="9" Margin="10,0,10,0" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource FrameBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="Transparent" />
                                    <GradientStop Offset="1" Color="Black" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Path Grid.Column="1" Width="6" Height="7" Margin="6,0" Stretch="Fill" VerticalAlignment="Center"
                              Data="M 3,0 L 6,1.8 L 6,5.2 L 3,7 L 0,5.2 L 0,1.8 Z"
                              Fill="{DynamicResource HeadingMarkerBrush}" Opacity="0.85" />
                        <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{DynamicResource FrameBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="Black" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Rows of every popup menu, compact: 30px on the cosmic Nexus panel.
        - Row: fixed 26px icon column (16px icon at 0.85 opacity at rest), ice-white label, shortcuts in recessed
          indigo chips with Sora SemiBold periwinkle text; checked rows draw a pointy-top magenta hex with a cyan rim
          and cyan check mark.
        - Highlight (pointer or keyboard): Stormrift's magenta-orchid radial dome SelectionBarTemplate (with hex grain,
          ice-periwinkle rim and 2px cyan left bar) fades in (0.12s) while a cyan mini hex pip slides in on the left;
          shortcut chip lights cyan. Out over 0.18s (FillBehavior=Stop).
        - Exit (gesture Alt+Q): crimson-rimmed shortcut chip at rest; on highlight, shows a deep crimson plate (72%
          DangerBrush over void-indigo for >6.6:1 contrast with white text), 1px DangerBrush rim, 2px crimson left bar
          and crisp white label/shortcut.
        - Submenu headers: IconSubmenu lit cyan when open or highlighted, with a held cosmic plate while open (no
          animation); submenus open on the same Nexus panel.
        Recipe: docs/themes/menus.md.
    -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <Control x:Name="MenuHover" Template="{DynamicResource SelectionBarTemplate}"
                     Foreground="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource SelectedBorderBrush}"
                     Margin="0,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
            <!-- Danger hover plate for Exit (Alt+Q): 72% crimson over void gives >6.6:1 contrast for white text -->
            <Grid x:Name="MenuDangerHover" Margin="0,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource DangerBrush}" Opacity="0.72" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource DangerBrush}" />
            </Grid>
            <Path x:Name="MenuHexPip" Width="5" Height="6" Margin="5,0,0,0" Stretch="Fill"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Data="M 2.5,0 L 5,1.5 L 5,4.5 L 2.5,6 L 0,4.5 L 0,1.5 Z" Fill="{DynamicResource GlyphBrush}"
                  Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="MenuPipShift" X="-4" />
                </Path.RenderTransform>
            </Path>
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.85" />
                <Grid x:Name="GlyphPanel" Width="14" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                    <Path Stretch="Fill" Data="M 7,0 L 14,3.8 L 14,11.2 L 7,15 L 0,11.2 L 0,3.8 Z"
                          Fill="{DynamicResource SelectedBrush}" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.1" />
                    <ContentControl Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{DynamicResource GlyphBrush}"
                                    Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}" Focusable="False" />
                </Grid>
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <Border x:Name="MenuKeycap" Grid.Column="2" Height="18" Margin="14,0,0,0" Padding="5,0" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                    <TextBlock x:Name="GestureText" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center"
                               FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold"
                               FontSize="11" Foreground="{DynamicResource SectionHeaderBrush}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuKeycap" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuKeycap" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" TargetName="MenuKeycap" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="GestureText" />
                <Setter Property="Fill" Value="{DynamicResource TextBrush}" TargetName="MenuHexPip" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Icon" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuHover" />
                <Setter Property="Visibility" Value="Visible" TargetName="MenuDangerHover" />
                <Setter Property="Opacity" Value="1" TargetName="MenuDangerHover" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="MenuLabel" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="GestureText" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" TargetName="MenuKeycap" />
                <Setter Property="Background" Value="Transparent" TargetName="MenuKeycap" />
            </MultiTrigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="MenuLabel" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="GestureText" />
                <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" TargetName="MenuKeycap" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHexPip" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="MenuHexPip" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="MenuPipShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHexPip" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuHexPip" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuPipShift" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held cosmic plate while submenu is open (no animation) -->
            <Border x:Name="MenuHeld" Margin="0,1" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="{DynamicResource MenuItemHoverBrush}" BorderBrush="{DynamicResource FrameBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Control x:Name="MenuHover" Template="{DynamicResource SelectionBarTemplate}"
                     Foreground="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource SelectedBorderBrush}"
                     Margin="0,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
            <Path x:Name="MenuHexPip" Width="5" Height="6" Margin="5,0,0,0" Stretch="Fill"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Data="M 2.5,0 L 5,1.5 L 5,4.5 L 2.5,6 L 0,4.5 L 0,1.5 Z" Fill="{DynamicResource GlyphBrush}"
                  Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="MenuPipShift" X="-4" />
                </Path.RenderTransform>
            </Path>
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.85" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <ContentControl x:Name="MenuArrow" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Foreground="{DynamicResource HighlightGlyphBrush}" Focusable="False"
                                Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}" />
            </Grid>
            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                   HorizontalOffset="6" VerticalOffset="-13" Focusable="False" AllowsTransparency="True">
                <Grid MinWidth="200" Margin="0,4,0,0" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="0,9,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" Margin="4,0"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="MenuHeld" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="MenuArrow" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="MenuLabel" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="MenuArrow" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHexPip" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="MenuHexPip" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="MenuPipShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHexPip" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuHexPip" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuPipShift" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="{TemplateBinding Background}">
            <Grid>
                <TextBlock VerticalAlignment="Center" Padding="{DynamicResource MenuItemPadding}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                    <Border Style="{DynamicResource PopupBorder}" Padding="{DynamicResource MenuPadding}" SnapsToDevicePixels="True">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="{TemplateBinding Background}">
            <TextBlock VerticalAlignment="Center" Padding="{DynamicResource MenuItemPadding}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{TemplateBinding Foreground}">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </TextBlock>
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
