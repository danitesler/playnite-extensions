<!--
    Stormrift: CheckBox. 16px/18px sunken indigo well (#09041d) with crisp border, smooth hover border glow (0.12s),
    and periwinkle-ice check fading in smoothly (100ms). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <DockPanel Background="Transparent">
                        <Grid Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Border x:Name="Box" Background="{DynamicResource CheckBoxCheckMarkBkBrush}" BorderBrush="{DynamicResource CheckBoxBorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                            <Border x:Name="HoverBox" BorderBrush="{DynamicResource CheckBoxHoverBorderBrush}" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                            <ContentControl x:Name="Mark" Opacity="0" Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                            Foreground="{DynamicResource HighlightGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                            <Rectangle x:Name="Dash" Width="8" Height="2" Fill="{DynamicResource HighlightGlyphBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBox" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverBox" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
