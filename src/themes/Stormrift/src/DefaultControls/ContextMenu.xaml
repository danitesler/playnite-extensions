<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu,
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is Heroes of the Storm's cosmic Nexus panel: void-indigo fill
    (PopupBackgroundBrush) with a subtle hex-lattice wash (hexgrid.png), FramedPlateTemplate periwinkle rim with
    centre-flared ice gleam, and a faceted pointy-top cyan hex crest perched on the top-centre edge
    (LocalMenuPanelTemplate, shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and
    CustomControls/FilterSelectionBox.xaml). The crest rises 4px above the panel, so every host reserves 4px top
    margin and starts rows 9px below the top. Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Rectangle Margin="1" Fill="{DynamicResource BevelLightBrush}" Opacity="0.045">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/hexgrid.png'}" TileMode="Tile"
                                Viewport="0,0,14,24" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Control Template="{DynamicResource FramedPlateTemplate}"
                     Foreground="{DynamicResource PopupBorderBrush}" Focusable="False" IsTabStop="False" />
            <!-- Faceted pointy-top Nexus hex crest on the top-centre rim -->
            <Path Width="10" Height="11" Margin="0,-5,0,0" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Data="M 5,0 L 10,2.8 L 10,8.2 L 5,11 L 0,8.2 L 0,2.8 Z"
                  Fill="{DynamicResource SelectedBrush}" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.2" />
            <Path Width="4" Height="4.5" Margin="0,-1.8,0,0" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Data="M 2,0 L 4,1.1 L 4,3.4 L 2,4.5 L 0,3.4 L 0,1.1 Z"
                  Fill="{DynamicResource GlyphBrush}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" Margin="0,4,0,0" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,9,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="4,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
