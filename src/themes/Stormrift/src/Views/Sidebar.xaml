<!--
    Stormrift: left rail, 44px void-indigo closed by a hairline. The main menu sits in a 32x34 pointy-top hexagon plate
    holding the Stormrift mark with a cosmic bloom on hover. Window art mode turns the rail background transparent.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="56" Margin="0,0,0,4"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Control x:Name="SealBloom" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource SidebarItemSelectedGlowBrush}"
                                                 Width="44" Height="44" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0" Focusable="False" />
                                        <Path Fill="{DynamicResource ShellBackgroundBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1"
                                              Width="36" Height="38" VerticalAlignment="Top" Margin="0,6,0,0" Stretch="Fill"
                                              Data="M16,1 L31,9 L31,25 L16,33 L1,25 L1,9 Z" SnapsToDevicePixels="True" />
                                        <Path x:Name="Seal" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1.2"
                                              Width="30" Height="32" VerticalAlignment="Top" Margin="0,9,0,0" Stretch="Fill"
                                              Data="M16,1 L31,9 L31,25 L16,33 L1,25 L1,9 Z" SnapsToDevicePixels="True" />
                                        <Control x:Name="MenuMark" Template="{DynamicResource LocalStormriftMenuMarkTemplate}" Foreground="{DynamicResource MainMenuButtonForegroundBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                                 Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" />
                                        <Rectangle x:Name="SealOrnament" Width="22" Height="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                   Fill="{DynamicResource NormalBorderBrush}" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                            <Border x:Name="EdgeRule" Width="1" HorizontalAlignment="Right" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                    Background="Transparent" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="1,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" TargetName="MenuMark" />
                            <Setter Property="Stroke" Value="{DynamicResource FrameHoverBrush}" TargetName="Seal" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SealBloom" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SealBloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                            <Setter Property="BorderThickness" Value="0,0,1,0" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SealOrnament" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Margin" Value="0,5,0,0" TargetName="Seal" />
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="SealBloom" />
                            <Setter Property="Margin" Value="0,11,0,0" TargetName="MenuMark" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SealOrnament" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Margin" Value="0,5,0,0" TargetName="Seal" />
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="SealBloom" />
                            <Setter Property="Margin" Value="0,11,0,0" TargetName="MenuMark" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
