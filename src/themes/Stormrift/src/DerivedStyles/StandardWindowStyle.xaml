<!--
    Stormrift: dialog windows (Settings, Add-ons, game editor). 44px cosmic title band (CaptionHeight 44 = content
    offset) with electric top-center HotS atmospheric flare, faint hex-lattice pattern, 26x26 double-bezel hex brand
    badge, uppercase Sora title, ghosted mark on the right, 46x44 caption buttons, and glowing bottom rule.
    PART_TextTitle sits in a Collapsed parent so Playnite cannot draw bare text over the band; Settings AutomationId sets
    LOCSettingsLabel. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid ClipToBounds="True">
                                <!-- Deep cosmic radial top atmosphere (matching HotS Options modal top-center sapphire mist) -->
                                <!-- Decor is clipped to the window's own height so its 240/160px art never forces small SizeToContent dialogs (Exiting Playnite, progress) tall -->
                                <Canvas ClipToBounds="True" IsHitTestVisible="False">
                                <Rectangle Height="240" Width="{Binding ActualWidth, ElementName=PART_WindowBody}" Fill="{DynamicResource ProgressBarForegroundBrush}" Opacity="0.14" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <RadialGradientBrush Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="0.65" RadiusY="0.95">
                                            <GradientStop Color="#FF000000" Offset="0" />
                                            <GradientStop Color="#44000000" Offset="0.5" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Rectangle Height="160" Width="{Binding ActualWidth, ElementName=PART_WindowBody}" Fill="{DynamicResource FrameHoverBrush}" Opacity="0.06" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/hexgrid.png'}" TileMode="Tile" Viewport="0,0,26,45" ViewportUnits="Absolute" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                </Canvas>
                                <Grid Height="44" VerticalAlignment="Top" ClipToBounds="True">
                                    <Border Background="{DynamicResource WindowTitleBackgroundBrush}" Opacity="0.92" />
                                    <Rectangle Height="44" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" Opacity="0.16" IsHitTestVisible="False">
                                        <Rectangle.OpacityMask>
                                            <RadialGradientBrush Center="0.5,0.1" GradientOrigin="0.5,0.05" RadiusX="0.55" RadiusY="1.0">
                                                <GradientStop Color="#FF000000" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <!-- Subtle hex-lattice strip across the title band -->
                                    <Rectangle Fill="{DynamicResource FrameBrush}" Opacity="0.18" IsHitTestVisible="False">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{ThemeFile 'Images/fx/hexgrid.png'}" TileMode="Tile" Viewport="0,0,26,45" ViewportUnits="Absolute" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <!-- Ghosted Stormrift mark in a zero-size Canvas so small dialogs never widen -->
                                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0" IsHitTestVisible="False">
                                        <Viewbox Canvas.Left="-216" Canvas.Top="-8" Width="62" Height="62" Opacity="0.08">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{DynamicResource IconMainMenu}" Fill="{DynamicResource HeadingMarkerBrush}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Canvas>
                                    <!-- Hex brand badge before the title -->
                                    <Grid Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                                        <Path Fill="{DynamicResource ShellBackgroundBrush}" Stroke="{DynamicResource FrameHoverBrush}" StrokeThickness="1"
                                              Stretch="Fill" Data="M13,0 L25,6.5 L25,19.5 L13,26 L1,19.5 L1,6.5 Z" />
                                        <Path Margin="2" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" Stroke="{DynamicResource FrameBrush}" StrokeThickness="0.8"
                                              Stretch="Fill" Data="M13,1 L24,7 L24,19 L13,25 L2,19 L2,7 Z" />
                                        <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource MainMenuButtonForegroundBrush}" Width="14" Height="14" />
                                    </Grid>
                                    <Border Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="{TemplateBinding Title}" x:Name="PART_TextTitle" Width="0" Height="0" Opacity="0" Foreground="Transparent" />
                                    </Border>
                                    <TextBlock Text="{Binding Text, ElementName=PART_TextTitle, Converter={StaticResource StringToUpperCaseConverter}}"
                                               Margin="50,0,150,0" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" FontWeight="Bold"
                                               Foreground="{DynamicResource WindowTitleForegroundBrush}" IsHitTestVisible="False"
                                               Style="{DynamicResource BaseTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </Grid>
                                <!-- Top rim centered azure-ice flare -->
                                <Rectangle Height="10" Margin="60,-4,60,0" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" Opacity="0.45" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/flare.png'}" Stretch="Fill" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <ContentPresenter x:Name="PART_WindowBody" Margin="0,44,0,0" />
                                <Control Template="{DynamicResource GlowLineTemplate}" Foreground="{DynamicResource FrameBrush}" BorderBrush="{DynamicResource FrameHoverBrush}"
                                         Height="16" VerticalAlignment="Top" Margin="0,35,0,0" Focusable="False" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
