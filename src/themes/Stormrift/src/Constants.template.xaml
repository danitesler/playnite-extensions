<!--
    Stormrift: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared vocabulary (scripts/data/theme-keys.json); each placeholder names the sr token that plays
    the key's role. Theme XAML reads brushes only, never Color keys.
    Shape: sharp 2px architectural corners paired with pointed-hex Ready slabs and pointy-top hex tiles.
    Selection: magenta-violet plate with an ice-periwinkle rim; Play: glowing arcane violet; Running: Boost teal.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: clean geometric caps for headers and buttons (Sora, bundled), humanist body (Segoe UI, ships with Windows). -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:sr-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Sora, {{text:sr-font-heading|Sora}}, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:sr-font-mono|Consolas}}</FontFamily>

    <!-- Usable metadata content width; applied inside the pane's horizontal padding and border. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Boolean x:Key="GameDetailsPaneOnLeft">False</sys:Boolean> <!-- Details view: True puts the metadata column on the left and stacks it above the description on narrow pages. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:sr-radius|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:sr-radius-sm|1}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:sr-radius-lg|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{sr-white}}</Color>
    <Color x:Key="TextColorDarker">{{sr-lavender}}</Color>
    <Color x:Key="TextColorDark">{{sr-ink}}</Color>
    <Color x:Key="MainColor">{{sr-well}}</Color>
    <Color x:Key="MainColorDark">{{sr-panel}}</Color>
    <Color x:Key="HoverColor">{{sr-plate-hi}}</Color>
    <Color x:Key="GlyphColor">{{sr-cyan}}</Color>
    <Color x:Key="HighlightGlyphColor">{{sr-periwinkle}}</Color>
    <Color x:Key="PopupBackgroundColor">{{sr-tooltip}}</Color>
    <Color x:Key="PopupBorderColor">{{sr-rim}}</Color>
    <Color x:Key="BackgroundToneColor">{{sr-panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{sr-line-dim}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{sr-line-dim}}</Color>
    <Color x:Key="DataChangeNotifColor">{{sr-gold}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{sr-line}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{sr-tooltip}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{sr-plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{sr-well-deep}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <!-- Running game: Boost teal (#0fe7d0), distinct from violet Play, magenta selection and gold filter/quest markers. -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{sr-boost}}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{sr-boost}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{sr-crimson}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{sr-gold}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{sr-gold}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{sr-panel-deep}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{sr-panel}}" />

    <!-- Surfaces and art -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{sr-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{sr-panel}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{sr-topbar}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{sr-panel}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{sr-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{sr-void}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening"): the deepest cosmic void-indigo behind menus so darkened banners keep the Nexus indigo cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{sr-void}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{sr-plate}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{sr-ice}}" />

    <!-- Selection and states -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{sr-sel}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{sr-sel-hi}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{sr-rim-lit}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{sr-white}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{sr-rim-lit}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{sr-plate-hi}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{sr-sel}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{sr-plate-hi}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{sr-cyan}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{sr-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{sr-white}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{sr-white}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{sr-white}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{sr-ice}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{sr-rim}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{sr-plate-hi}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{sr-plate-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{sr-ready}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{sr-ready-edge}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{sr-ready-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{sr-ready-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{sr-white}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{sr-ready-hot}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{sr-plate}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{sr-rim}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{sr-plate-hi}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{sr-plate-press}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{sr-tab}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{sr-well}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{sr-panel-lit}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{sr-line}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{sr-rim}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{sr-rim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{sr-rim-lit}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{sr-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{sr-white}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{sr-cyan}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{sr-cyan}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{sr-track}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{sr-ally}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{sr-rim}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{sr-rim-lit}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{sr-line-dim}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{sr-rim}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{sr-rim-lit}}" />

    <!-- Tabs, covers, shell items -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{sr-lavender}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{sr-white}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{sr-rim-lit}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{sr-cyan}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{sr-rim-lit}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{sr-plate-hi}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{sr-tab}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{sr-lavender}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{sr-white}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{sr-cyan}}" />

    <!-- Metadata, menus, tooltips, dialogs -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{sr-plate}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{sr-ice}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{sr-plate-hi}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{sr-line-dim}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{sr-white}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{sr-rim}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{sr-topbar}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{sr-white}}" />

    <!-- Frames and headings -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{sr-rim}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{sr-line-dim}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{sr-rim-lit}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{sr-line}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{sr-void}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{sr-white}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{sr-periwinkle}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{sr-line}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{sr-periwinkle}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{sr-periwinkle}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{sr-line}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{sr-rim-lit}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{sr-line}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{sr-well}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{sr-rim-lit}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{sr-void}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{sr-cyan}}" />
</ResourceDictionary>
