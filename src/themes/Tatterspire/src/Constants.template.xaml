<!--
    Tatterspire: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json); each placeholder names the token that plays the key's role.
    Slate paper over fog: slate is the dialog and HUD paper, night the page, abyss the frame. Gold is lettering and selection,
    cyan is the card glow (hover, focus, toggled), the red pair (flag, proceed) is ribbons and the Proceed hexagon.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Typography: a bold slab serif for titles and buttons, the same family regular for body text. Zilla Slab is bundled in src/Typography as the stand-in. -->
    <sys:Double x:Key="FontSizeSmall">{{px:size-caption}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:size-body}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:size-lead}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:size-title}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:size-display}}</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Zilla Slab, {{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Zilla Slab, {{text:font-heading|Segoe UI}}</FontFamily>
    <!-- Metadata width defaults (usable content, inside the pane's padding and frame). -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>
    <!-- Shape: 1px strokes (the ink outline is a second 1-2px layer in each template), 4px plates, 3 and 6px for chips and sheets. -->
    <Thickness x:Key="PopupBorderThickness">{{px:stroke-hair}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:stroke-hair}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:stroke-hair}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:corner-paper}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:corner-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:corner-large}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{paper}}</Color>
    <Color x:Key="TextColorDarker">{{paper-dim}}</Color>
    <Color x:Key="TextColorDark">{{gold-ink}}</Color>
    <Color x:Key="MainColor">{{slate-deep}}</Color>
    <Color x:Key="MainColorDark">{{night}}</Color>
    <Color x:Key="HoverColor">{{glass-bright}}</Color>
    <Color x:Key="GlyphColor">{{gold}}</Color>
    <Color x:Key="HighlightGlyphColor">{{gold/35}}</Color>
    <Color x:Key="PopupBackgroundColor">{{slate}}</Color>
    <Color x:Key="PopupBorderColor">{{ink}}</Color>
    <Color x:Key="BackgroundToneColor">{{slate-deep}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{slate-deep/75}}</Color>   <!-- the slot behind each cover -->
    <Color x:Key="PanelSeparatorColor">{{ink}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{ink}}</Color>
    <Color x:Key="DataChangeNotifColor">{{gold}}</Color>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <!-- Banner darkening color: the darkest slate the top bar and page use, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{night}}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{slate-rim}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{night}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{slate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{slate-deep}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{energy-lit}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{coral}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{cost}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{slate}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{abyss}}" />
    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->
    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{abyss}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{night}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{night}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{slate}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{abyss}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{{slate-lit}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{slate-rim}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{energy-lit}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{glass}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{slate}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{cyan}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{flag}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{slate-lit}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{slate-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{proceed}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{proceed-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{proceed-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{slate-lit}}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{slate-rim}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{slate-lit}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{gold-bright}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{gold-bright}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{hp-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{gold-deep}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{ink/70}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{slate-lit}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{cyan}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{slate-rim}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{cyan}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{glass-bright}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{slate-lit}}" />
    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{abyss}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{slate-rim}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{proceed-rim}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{slate-lit}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{paper-dim}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{slate-rim}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{gold-deep}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{slate-rim}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{gold-deep}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{slate-lit}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{slate}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{slate-rim}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{slate-deep}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{slate-lit}}" />
    <!-- Theme-only: the paper, the lettering and the glows (Local prefix = no ThemeModifier entry, no shared meaning). -->
    <SolidColorBrush x:Key="LocalInkBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="LocalAbyssBrush" Color="{{abyss}}" />
    <SolidColorBrush x:Key="LocalNightBrush" Color="{{night}}" />
    <SolidColorBrush x:Key="LocalSlateBrush" Color="{{slate}}" />
    <SolidColorBrush x:Key="LocalSlateDeepBrush" Color="{{slate-deep}}" />
    <SolidColorBrush x:Key="LocalSlateLitBrush" Color="{{slate-lit}}" />
    <SolidColorBrush x:Key="LocalSlateRimBrush" Color="{{slate-rim}}" />
    <SolidColorBrush x:Key="LocalPaperBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="LocalPaperDimBrush" Color="{{paper-dim}}" />
    <SolidColorBrush x:Key="LocalGoldBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="LocalGoldDeepBrush" Color="{{gold-deep}}" />
    <SolidColorBrush x:Key="LocalGoldBrightBrush" Color="{{gold-bright}}" />
    <SolidColorBrush x:Key="LocalGoldWashBrush" Color="{{gold/22}}" />
    <SolidColorBrush x:Key="LocalGoldInkBrush" Color="{{gold-ink}}" />
    <SolidColorBrush x:Key="LocalFlagBrush" Color="{{flag}}" />
    <SolidColorBrush x:Key="LocalFlagLitBrush" Color="{{flag-lit}}" />
    <SolidColorBrush x:Key="LocalProceedBrush" Color="{{proceed}}" />
    <SolidColorBrush x:Key="LocalProceedLitBrush" Color="{{proceed-lit}}" />
    <SolidColorBrush x:Key="LocalProceedRimBrush" Color="{{proceed-rim}}" />
    <SolidColorBrush x:Key="LocalProceedDeepBrush" Color="{{proceed-deep}}" />
    <SolidColorBrush x:Key="LocalCyanBrush" Color="{{cyan}}" />
    <SolidColorBrush x:Key="LocalCyanWashBrush" Color="{{cyan-wash}}" />
    <SolidColorBrush x:Key="LocalHpBrush" Color="{{hp}}" />
    <SolidColorBrush x:Key="LocalHpTrackBrush" Color="{{hp-track}}" />
    <SolidColorBrush x:Key="LocalEnergyBrush" Color="{{energy}}" />
    <SolidColorBrush x:Key="LocalEnergyLitBrush" Color="{{energy-lit}}" />
    <SolidColorBrush x:Key="LocalRustBrush" Color="{{rust}}" />
    <SolidColorBrush x:Key="LocalUmberBrush" Color="{{umber}}" />
    <SolidColorBrush x:Key="LocalParchmentBrush" Color="{{parchment}}" />
    <SolidColorBrush x:Key="LocalParchmentDarkBrush" Color="{{parchment-dark}}" />
    <SolidColorBrush x:Key="LocalPaperBlueBrush" Color="{{paper-blue}}" />
    <SolidColorBrush x:Key="LocalScrimBrush" Color="{{scrim}}" />
    <SolidColorBrush x:Key="LocalGlassBrush" Color="{{glass}}" />
    <SolidColorBrush x:Key="LocalGlassBrightBrush" Color="{{glass-bright}}" />
    <SolidColorBrush x:Key="LocalFogBrush" Color="{{fog}}" />
</ResourceDictionary>
