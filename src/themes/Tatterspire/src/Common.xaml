<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Tatterspire shared pieces. Everything torn is one sprite sheet (art/sprites.py): a 224px sheet with 48px corners and a
        128px tiled middle, drawn as an ink outline, the slate paper and a lighter inner rim. Hosts are plain Controls in a Grid:
        Background = outline, Foreground = paper, BorderBrush = rim.
    -->
    <Geometry x:Key="LocalSwashGeometry">M1,8 C5,8 6,3 11,3 C15,3 15,8 19,8 C23,8 24,4.5 21.8,3 C20,1.9 18,3.6 19.4,5</Geometry>
    <ImageBrush x:Key="LocalStainMask" ImageSource="{ThemeFile 'Images/fx/stain.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="Fill" />
    <ImageBrush x:Key="LocalTornFootMask" ImageSource="{ThemeFile 'Images/fx/torn-foot.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalTornLipMask" ImageSource="{ThemeFile 'Images/fx/torn-lip.png'}" Stretch="Fill" />
    <!-- The torn sheet: three 9-slice layers of the same sprite sheet. Background = outline, Foreground = paper, BorderBrush = rim (half strength). -->
    <ControlTemplate x:Key="LocalTornSheetTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>
            <!-- Outline (sheet-edge) -->
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Background}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-edge.png'}" Viewbox="0,0,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Background}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-edge.png'}" Viewbox="48,0,128,48" ViewboxUnits="Absolute" Viewport="0,0,128,48" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Background}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-edge.png'}" Viewbox="176,0,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Background}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-edge.png'}" Viewbox="0,48,48,128" ViewboxUnits="Absolute" Viewport="0,0,48,128" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Background}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-edge.png'}" Viewbox="176,48,48,128" ViewboxUnits="Absolute" Viewport="0,0,48,128" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Background}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-edge.png'}" Viewbox="0,176,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Background}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-edge.png'}" Viewbox="48,176,128,48" ViewboxUnits="Absolute" Viewport="0,0,128,48" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Background}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-edge.png'}" Viewbox="176,176,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <!-- Paper (sheet) -->
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet.png'}" Viewbox="0,0,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet.png'}" Viewbox="48,0,128,48" ViewboxUnits="Absolute" Viewport="0,0,128,48" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet.png'}" Viewbox="176,0,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet.png'}" Viewbox="0,48,48,128" ViewboxUnits="Absolute" Viewport="0,0,48,128" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <!-- the paper core: one solid rectangle 8px inside the tear (deeper than any notch) so no slice seam can show through -->
            <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="8" Fill="{TemplateBinding Foreground}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet.png'}" Viewbox="176,48,48,128" ViewboxUnits="Absolute" Viewport="0,0,48,128" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet.png'}" Viewbox="0,176,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet.png'}" Viewbox="48,176,128,48" ViewboxUnits="Absolute" Viewport="0,0,128,48" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet.png'}" Viewbox="176,176,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <!-- Stains: the paper's own mottling, faint -->
            <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="8" Fill="{DynamicResource LocalPaperBrush}" Opacity="0.06" OpacityMask="{DynamicResource LocalStainMask}" />
            <!-- Inner rim (sheet-rim) -->
            <Grid Grid.RowSpan="3" Grid.ColumnSpan="3" Opacity="0.5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>
                <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding BorderBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-rim.png'}" Viewbox="0,0,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
                <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding BorderBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-rim.png'}" Viewbox="48,0,128,48" ViewboxUnits="Absolute" Viewport="0,0,128,48" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
                <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding BorderBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-rim.png'}" Viewbox="176,0,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
                <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding BorderBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-rim.png'}" Viewbox="0,48,48,128" ViewboxUnits="Absolute" Viewport="0,0,48,128" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
                <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding BorderBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-rim.png'}" Viewbox="176,48,48,128" ViewboxUnits="Absolute" Viewport="0,0,48,128" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
                <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding BorderBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-rim.png'}" Viewbox="0,176,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
                <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding BorderBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-rim.png'}" Viewbox="48,176,128,48" ViewboxUnits="Absolute" Viewport="0,0,128,48" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
                <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding BorderBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/sheet-rim.png'}" Viewbox="176,176,48,48" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            </Grid>
        </Grid>
    </ControlTemplate>
    <!-- Ragged strips: the banner foot (opaque below the tear) and the top bar's lower lip (opaque above it). Foreground = fill. -->
    <ControlTemplate x:Key="LocalTornFootTemplate" TargetType="{x:Type Control}">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalTornFootMask}" IsHitTestVisible="False" SnapsToDevicePixels="True" />
    </ControlTemplate>
    <ControlTemplate x:Key="LocalTornLipTemplate" TargetType="{x:Type Control}">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalTornLipMask}" IsHitTestVisible="False" SnapsToDevicePixels="True" />
    </ControlTemplate>
    <!-- Swash: the main menu's flourish, a stroked curl 26x10. Mirror it with a ScaleTransform on the host. -->
    <ControlTemplate x:Key="LocalSwashTemplate" TargetType="{x:Type Control}">
        <Path Width="26" Height="10" Stretch="Fill" Data="{DynamicResource LocalSwashGeometry}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" IsHitTestVisible="False" SnapsToDevicePixels="False" />
    </ControlTemplate>
    <!-- Group break: a swash opening a hairline that fades out to the right. Content-sized height, no desired width. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="10" IsHitTestVisible="False">
            <Rectangle Height="1" Margin="32,0,0,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Path Width="26" Height="10" HorizontalAlignment="Left" Stretch="Fill" Data="{DynamicResource LocalSwashGeometry}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Grid>
    </ControlTemplate>
    <!-- Corner brackets: the gold L marks on the map cursor, the dropdown frame and a lit card. Foreground = bracket color. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Data="M0,7 V0 H7" />
            <Path Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Data="M1,0 H8 V7" />
            <Path Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Data="M0,1 V8 H7" />
            <Path Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Data="M8,1 V8 H1" />
        </Grid>
    </ControlTemplate>
    <!-- Red ribbon with a swallow tail: the Back flag. Foreground = ribbon, Background = the shaded fold under it. Tail is a fixed 8px column. -->
    <ControlTemplate x:Key="LocalFlagTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /></Grid.ColumnDefinitions>
            <Rectangle Fill="{TemplateBinding Foreground}" />
            <Path Grid.Column="1" Stretch="Fill" Fill="{TemplateBinding Foreground}" Data="M0,0 L8,0 L3,10 L8,20 L0,20 Z" />
            <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{TemplateBinding Background}" Opacity="0.5" />
        </Grid>
    </ControlTemplate>
    <!-- Notched ribbon tag used by metadata chips: fill = Foreground, swallow-tail notch on the right edge. -->
    <ControlTemplate x:Key="LocalTagPlateTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /></Grid.ColumnDefinitions>
            <Rectangle Fill="{TemplateBinding Foreground}" />
            <Path Grid.Column="1" Stretch="Fill" Fill="{TemplateBinding Foreground}" Data="M0,0 L8,0 L1.5,10 L8,20 L0,20 Z" />
            <Rectangle Width="3" HorizontalAlignment="Left" Fill="{TemplateBinding Background}" />
        </Grid>
    </ControlTemplate>
    <!-- Brand mark: a twisting tower with three lit windows and a pennant. Fill = Foreground. -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource LocalSpireMarkGeometry}" Fill="{TemplateBinding Foreground}" Stroke="{TemplateBinding Foreground}" StrokeThickness="0.6" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <!-- Energy orb: the hexagonal 3/3 gem. Foreground = face, Background = ink outline; the number is the host's content. -->
    <ControlTemplate x:Key="LocalEnergyOrbTemplate" TargetType="{x:Type ContentControl}">
        <Grid SnapsToDevicePixels="True">
            <Path Stretch="Fill" Fill="{TemplateBinding Background}" Data="M25,3 L75,3 L100,50 L75,97 L25,97 L0,50 Z" />
            <Path Stretch="Fill" Margin="3" Fill="{TemplateBinding Foreground}" Data="M25,3 L75,3 L100,50 L75,97 L25,97 L0,50 Z" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </ControlTemplate>
    <!-- Hexagon plate (Proceed, Play): pointed left and right, 14px caps, fill = Foreground. Host it at any width/height; layers inset with Margin. -->
    <ControlTemplate x:Key="LocalHexPlateTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions>
            <Path Stretch="Fill" Fill="{TemplateBinding Foreground}" Data="M14,0 L14,20 L0,10 Z" />
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Foreground}" />
            <Path Grid.Column="2" Stretch="Fill" Fill="{TemplateBinding Foreground}" Data="M0,0 L14,10 L0,20 Z" />
        </Grid>
    </ControlTemplate>
    <!-- The same hexagon as a 1.5px line (rim): slanted ends plus top and bottom rules. Foreground = line. -->
    <ControlTemplate x:Key="LocalHexRimTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions>
            <Path Stretch="Fill" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Miter" Data="M14,0.75 L0.4,10 L14,19.25" />
            <Grid Grid.Column="1">
                <Rectangle Height="1.5" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}" />
                <Rectangle Height="1.5" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" />
            </Grid>
            <Path Grid.Column="2" Stretch="Fill" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Miter" Data="M0,0.75 L13.6,10 L0,19.25" />
        </Grid>
    </ControlTemplate>
    <!-- Empty game page: the map sheet. A torn parchment (LocalTornSheetTemplate in the map's tan), a dotted route climbing between "?" nodes
         and the current node in the gold corner brackets of the map cursor, the tower mark inside it. Static: the empty page only needs to read. -->
    <ControlTemplate x:Key="LocalEmptyMapTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Control Template="{DynamicResource LocalTornSheetTemplate}" Background="{DynamicResource LocalInkBrush}" Foreground="{DynamicResource LocalParchmentBrush}"
                     BorderBrush="{DynamicResource LocalParchmentDarkBrush}" Focusable="False" IsTabStop="False" />
            <Canvas Margin="36,30,36,30">
                <Path Stroke="{DynamicResource LocalParchmentDarkBrush}" StrokeThickness="3" StrokeDashArray="0.1 3.2" StrokeDashCap="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M144,136 C138,112 112,104 96,84 C84,68 92,46 110,30" />
                <Path Stroke="{DynamicResource LocalParchmentDarkBrush}" StrokeThickness="3" StrokeDashArray="0.1 3.2" StrokeDashCap="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M144,136 C156,114 188,106 204,88 C214,74 206,48 188,30" />
                <Path Stroke="{DynamicResource LocalParchmentDarkBrush}" StrokeThickness="3" StrokeDashArray="0.1 3.2" StrokeDashCap="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M110,30 C128,20 150,16 188,30" />
                <Ellipse Canvas.Left="84" Canvas.Top="72" Width="24" Height="24" Stroke="{DynamicResource LocalParchmentDarkBrush}" StrokeThickness="3" />
                <TextBlock Canvas.Left="84" Canvas.Top="72" Width="24" Height="24" Text="?" TextAlignment="Center" FontWeight="Bold" FontSize="16" LineHeight="24" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource LocalParchmentDarkBrush}" />
                <Ellipse Canvas.Left="192" Canvas.Top="76" Width="24" Height="24" Stroke="{DynamicResource LocalParchmentDarkBrush}" StrokeThickness="3" />
                <TextBlock Canvas.Left="192" Canvas.Top="76" Width="24" Height="24" Text="?" TextAlignment="Center" FontWeight="Bold" FontSize="16" LineHeight="24" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource LocalParchmentDarkBrush}" />
                <Ellipse Canvas.Left="98" Canvas.Top="18" Width="24" Height="24" Stroke="{DynamicResource LocalParchmentDarkBrush}" StrokeThickness="3" />
                <Ellipse Canvas.Left="176" Canvas.Top="18" Width="24" Height="24" Stroke="{DynamicResource LocalParchmentDarkBrush}" StrokeThickness="3" />
                <Grid Canvas.Left="116" Canvas.Top="108" Width="56" Height="56">
                    <Ellipse Margin="11" Fill="{DynamicResource LocalParchmentDarkBrush}" />
                    <Control Template="{DynamicResource BrandMarkTemplate}" Margin="16" Foreground="{DynamicResource LocalParchmentBrush}" Focusable="False" IsTabStop="False" />
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource LocalGoldDeepBrush}" Margin="2" Focusable="False" IsTabStop="False" />
                </Grid>
            </Canvas>
        </Grid>
    </ControlTemplate>
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Margin="-2" IsHitTestVisible="False" Focusable="False"
                             Template="{DynamicResource CornerMarksTemplate}"
                             Foreground="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Component spacing: roomy plates (32px controls, 8px rhythm) like the game's own menus. -->
    <Thickness x:Key="ButtonPadding">16,5,16,5</Thickness> <!-- Button: 32px with the 1px edge (height set by ControlHeight) -->
    <Thickness x:Key="InputPadding">10,5,10,5</Thickness> <!-- Text box, password box, dropdown -->
    <Thickness x:Key="MenuPadding">8</Thickness> <!-- Menu surface inside the torn sheet -->
    <Thickness x:Key="MenuItemPadding">12,5,12,5</Thickness> <!-- Menu item: 30px row -->
    <Thickness x:Key="ComboBoxDropDownPadding">8</Thickness> <!-- Dropdown surface -->
    <Thickness x:Key="ComboBoxItemPadding">12,5,12,5</Thickness> <!-- Dropdown item -->
    <Thickness x:Key="ListBoxItemPadding">10,5,10,5</Thickness> <!-- List box item -->
    <Thickness x:Key="GroupBoxPadding">14</Thickness> <!-- Group box body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,10</Thickness> <!-- Gap under the group box header -->
    <Thickness x:Key="TooltipPadding">12,7,12,8</Thickness> <!-- Tooltip -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">18</sys:Double> <!-- Top bar and sidebar icons -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         torn foot. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Both views start on the right. Center and Stretch flow above media. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->
    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, so the real carousel replaces it without the page jumping. Each Viewbox scales a fixed 1600px
         layout to the width its column gives it (height is unbounded in a vertical stack). The tiles are the host's
         Foreground at low opacity; the whole thing pulses while visible. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the plugin's ContentControl, visible while that control has no height. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="16"
                        Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- Round action plate (More, Edit): a slate plate in an ink outline with the paper rim inside, gold glyph on hover. -->
    <Style x:Key="LocalGameActionSocket" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border Background="{DynamicResource LocalInkBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <Border x:Name="Plate" Margin="2" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource LocalSlateRimBrush}" BorderThickness="1" CornerRadius="2" IsHitTestVisible="False" />
                        <Border x:Name="HoverPlate" Margin="2" Opacity="0" Background="{DynamicResource ButtonHoverBackgroundBrush}" BorderBrush="{DynamicResource LocalCyanBrush}" BorderThickness="1" CornerRadius="2" IsHitTestVisible="False" />
                        <Border x:Name="PressedPlate" Margin="2" Opacity="0" Background="{DynamicResource ButtonPressedBackgroundBrush}" CornerRadius="2" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ActionHoverIn"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ActionHoverOut"><Storyboard>
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedPlate" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>
</ResourceDictionary>
