<!--
    Tatterspire: caption buttons. Bare 46x36 cells with 16px glyphs; hover fills the cell with a glass wash. Close is the red flag
    ribbon (LocalFlagTemplate, swallow tail on the right) hanging in the corner, brighter on hover. Playnite passes the Marlett codes
    0 / 1 / 2 / r as Content; triggers swap them for the theme's glyphs. MainWindowButton (46x36, the main window's top-right corner
    over the top bar) lives here so it is built on this file's WindowBarButton, not on Default's (files merge one by one).
    Colors: HoverBrush, ButtonPressedBackgroundBrush, LocalFlagBrush, LocalFlagLitBrush, DangerForegroundBrush.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WindowBarButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Plate" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid>
                        <Control x:Name="Flag" Visibility="Collapsed" Template="{DynamicResource LocalFlagTemplate}" Foreground="{DynamicResource LocalFlagBrush}" Background="{DynamicResource LocalInkBrush}"
                                 Margin="0,0,0,0" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Glyph" Width="16" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{DynamicResource IconWindowClose}"
                                          ContentTemplate="{DynamicResource IconTemplate}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="r">
                            <Setter Property="Visibility" Value="Visible" TargetName="Flag" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Glyph" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Content" Value="r" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource LocalFlagLitBrush}" TargetName="Flag" />
                        </MultiTrigger>
                        <Trigger Property="Content" Value="0">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMinimize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Content" Value="{DynamicResource IconWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="Content" Value="r" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MainWindowButton" TargetType="Button" BasedOn="{StaticResource WindowBarButton}" />
</ResourceDictionary>
