<!--
    Tatterspire: CheckBox. The settings screen's box: a dark teal well (CheckBoxCheckMarkBkBrush) in an ink outline with a slate rim
    inside, 20px. Checked: a gold check (IconCheck) pops in (scale 0.5 to 1, 140 ms). Hover turns the rim gold.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center">
                                <Border CornerRadius="3" Background="{DynamicResource LocalInkBrush}" />
                                <Border x:Name="BulletBorder" Margin="2" CornerRadius="2"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Background="{DynamicResource CheckBoxCheckMarkBkBrush}"
                                        BorderBrush="{TemplateBinding BorderBrush}" />
                                <ContentControl x:Name="CheckIcon" Visibility="Collapsed" Width="16" Height="16" Margin="0,-3,-1,0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False"
                                                Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconTemplate}"
                                                Foreground="{DynamicResource CheckMarkBrush}" RenderTransformOrigin="0.5,0.5">
                                    <ContentControl.RenderTransform>
                                        <ScaleTransform x:Name="CheckScale" ScaleX="1" ScaleY="1" />
                                    </ContentControl.RenderTransform>
                                </ContentControl>
                                <Rectangle x:Name="IndeterminateIcon" Visibility="Collapsed" Width="8" Height="3"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" RadiusX="1" RadiusY="1"
                                           Fill="{DynamicResource CheckMarkBrush}" />
                            </Grid>
                            <ContentPresenter DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" From="0.5" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" From="0.5" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="BulletBorder" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
