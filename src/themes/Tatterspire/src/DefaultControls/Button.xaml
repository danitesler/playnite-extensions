<!--
    Tatterspire: Button. The settings screen's plate: slate paper (ButtonBackgroundBrush) in a 2px ink outline with the slate rim inside,
    4px corners; hover lights the plate and turns the rim cyan (the tab's glow), the label gold; pressed sinks to the deep slate.
    The default button (Save, OK) is the Proceed hexagon: pointed left and right, the proceed red with a rose rim and gold lettering
    (LocalHexPlateTemplate, as Play). Keeps Default's Width == 41 trigger for ThemeModifier's icon buttons (32x32 by layout scaling).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" /> <!-- fixed-width buttons (ThemeModifier icon buttons) keep their glyph unclipped; auto-width ones get the padding below -->
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True" Background="Transparent">
                        <Border x:Name="Outline" Background="{DynamicResource LocalInkBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Plate" Margin="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" />
                        <Border x:Name="HoverPlate" Margin="2" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource LocalCyanBrush}" BorderThickness="1" CornerRadius="2" />
                        <Border x:Name="PressedPlate" Margin="2" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource ButtonPressedBackgroundBrush}" CornerRadius="2" />
                        <!-- the default button's hexagon -->
                        <Control x:Name="HexOutline" Visibility="Collapsed" Template="{DynamicResource LocalHexPlateTemplate}" Foreground="{DynamicResource LocalInkBrush}" Focusable="False" IsTabStop="False" />
                        <Control x:Name="HexPlate" Visibility="Collapsed" Template="{DynamicResource LocalHexPlateTemplate}" Margin="2" Foreground="{TemplateBinding Background}" Focusable="False" IsTabStop="False" />
                        <Control x:Name="HexRim" Visibility="Collapsed" Template="{DynamicResource LocalHexRimTemplate}" Margin="2" Foreground="{TemplateBinding BorderBrush}" Focusable="False" IsTabStop="False" />
                        <Control x:Name="HexHover" Visibility="Collapsed" Template="{DynamicResource LocalHexRimTemplate}" Margin="1" Foreground="{DynamicResource LocalGoldBrush}" Opacity="0" Focusable="False" IsTabStop="False" />
                        <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ButtonHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="HexHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ButtonHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="HexHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedPlate" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Outline" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Plate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HexOutline" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HexPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HexRim" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HexHover" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <!-- ThemeModifier icon buttons: the plugin sets Width=41 on them (editor and constants tabs).
                 Render at 32x32 via uniform 32/41 layout scaling, including glyphs and decoration; auto-width buttons keep ButtonPadding. -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Width" Value="NaN">
                <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Padding" Value="26,5,26,5" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalGoldBrightBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
