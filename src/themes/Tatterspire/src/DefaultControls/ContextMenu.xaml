<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu,
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is one panel: a sheet of slate paper torn from the same stock as Slay the Spire 2's
    dialogs. Panel lever: LocalTornSheetTemplate (art/sprites.py), an ink outline, the PopupBackgroundBrush paper with
    faint stains and a lighter inner rim; the ragged edge sits 1-8px inside the popup, so the rows are inset 10px.
    LocalMenuPanelTemplate is shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and
    CustomControls/FilterSelectionBox.xaml. Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Control Template="{DynamicResource LocalTornSheetTemplate}" Background="{DynamicResource LocalInkBrush}"
                 Foreground="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource LocalSlateRimBrush}"
                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
    </ControlTemplate>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="232" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,11,0,11" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="10,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
