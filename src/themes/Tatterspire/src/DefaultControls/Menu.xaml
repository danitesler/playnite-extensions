<!--
    Overlay on Playnite Default/DefaultControls/Menu.xaml. Every popup menu (hamburger menu, top bar dropdowns, game
    and group menus, tray) is the main menu of Slay the Spire 2 laid on a torn slate sheet (ContextMenu.xaml).
    Menu signature (docs/themes/menus.md levers):
    - Rows: 30px, a 14px gutter for the cursor, a fixed 26px icon column, label, keyboard hint and submenu arrow on the right edge.
    - Highlight: no slab. The row's label turns gold and slides 2px while a gold swash (the main menu's flourish) draws in from
      the left gutter (130ms ease-out, 200ms out), over a faint glass wash. Icons turn gold with the label.
    - Group break: 12px, a swash flanked by two hairlines that fade out toward the sheet's edges.
    - Keyboard hints: cyan bold 12px text on the right edge, the color the game prints "press F2" in (a hint, not a plate).
    - Submenu mark: a gold triangle, lit while open; the header keeps a held glass wash (no animation).
    - Checked rows: a gold check in the icon column. Exit (Alt+Q): coral text at rest, a red flag plate with cream text when highlighted.
    Roles: TopLevelHeader and TopLevelItem (a horizontal Menu bar), SubmenuHeader and SubmenuItem (every popup menu).
    The Separator and MenuItem.SeparatorStyleKey are both redefined (the Default one points at its own sibling).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="LocalMenuBreakTemplate" TargetType="Control">
        <Grid Height="12" Margin="6,0" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Height="1" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource LocalSlateRimBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="1" Color="#99000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Path Grid.Column="1" Width="26" Height="10" Stretch="Fill" Data="{DynamicResource LocalSwashGeometry}" Stroke="{DynamicResource LocalGoldDeepBrush}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            <Rectangle Grid.Column="2" Height="1" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource LocalSlateRimBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#99000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Foreground" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource LocalMenuBreakTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Foreground" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource LocalMenuBreakTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- SubmenuItem: a plain row. -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="MenuHover" Margin="0,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                    CornerRadius="2" Background="{DynamicResource LocalGlassBrightBrush}" />
            <Path x:Name="MenuSwash" Width="13" Height="6" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Stretch="Fill" Data="{DynamicResource LocalSwashGeometry}" Stroke="{DynamicResource MenuItemHoverBrush}" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="MenuSwashShift" X="-6" />
                </Path.RenderTransform>
            </Path>
            <Grid Margin="20,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.8" />
                <ContentControl x:Name="GlyphPanel" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                                Focusable="False" IsHitTestVisible="False" Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconTemplate}"
                                Foreground="{DynamicResource CheckMarkBrush}" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MenuLabelShift" X="0" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <TextBlock x:Name="GestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,1" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontWeight="Bold" FontSize="12" Foreground="{DynamicResource LocalCyanBrush}" Opacity="0.85" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GestureText" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GestureText" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource NegativeRatingBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" TargetName="GestureText" />
                <Setter Property="Background" Value="{DynamicResource DangerBrush}" TargetName="MenuHover" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MenuItemHoverBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MenuItemHoverBrush}" TargetName="Icon" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Setter Property="Opacity" Value="1" TargetName="GestureText" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuSwash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="MenuSwash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                            <DoubleAnimation Storyboard.TargetName="MenuSwashShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuLabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuSwash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuSwash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuSwashShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuLabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <!-- Cream on the red flag plate (8.4:1); the swash and hint follow -->
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="GestureText" />
                <Setter Property="Stroke" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuSwash" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- SubmenuHeader: a row that opens a submenu. The held wash shows while it is open. -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="MenuHeld" Margin="0,1" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="2" Background="{DynamicResource LocalGlassBrightBrush}" />
            <Border x:Name="MenuHover" Margin="0,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                    CornerRadius="2" Background="{DynamicResource LocalGlassBrightBrush}" />
            <Path x:Name="MenuSwash" Width="13" Height="6" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Stretch="Fill" Data="{DynamicResource LocalSwashGeometry}" Stroke="{DynamicResource MenuItemHoverBrush}" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="MenuSwashShift" X="-6" />
                </Path.RenderTransform>
            </Path>
            <Grid Margin="20,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.8" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MenuLabelShift" X="0" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <ContentControl x:Name="MenuArrow" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                Focusable="False" Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource LocalGoldDeepBrush}" />
            </Grid>
            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                   HorizontalOffset="-2" VerticalOffset="-12" Focusable="False" AllowsTransparency="True">
                <Grid MinWidth="208" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="0,11,0,11" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" Margin="10,0"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="MenuHeld" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="MenuArrow" />
                <Setter Property="Foreground" Value="{DynamicResource MenuItemHoverBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MenuItemHoverBrush}" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MenuItemHoverBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MenuItemHoverBrush}" TargetName="Icon" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="MenuArrow" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuSwash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="MenuSwash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                            <DoubleAnimation Storyboard.TargetName="MenuSwashShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuLabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuSwash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuSwash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuSwashShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuLabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- TopLevelHeader: a horizontal menu bar entry; highlighted it turns gold on a glass wash. -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="Transparent" CornerRadius="2">
            <Grid>
                <TextBlock VerticalAlignment="Center" Padding="8,5" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                    <Grid MinWidth="208" Margin="0,4,0,0" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <StackPanel Margin="10,11,10,11" Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Grid>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource LocalGlassBrightBrush}" TargetName="Border" />
                <Setter Property="Foreground" Value="{DynamicResource MenuItemHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- TopLevelItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Style="{DynamicResource PopupBorder}">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>
    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="true" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
