                                                        <Control Template="{DynamicResource DividerTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Width="170" HorizontalAlignment="Left" Margin="0,3,0,0"
                                                                 Foreground="{DynamicResource HeadingRuleBrush}" />
                                                    </StackPanel>
                                                    <TextBox x:Name="PART_TextNotes" IsReadOnly="True" TextWrapping="Wrap" Style="{DynamicResource BareTextBox}" Foreground="{DynamicResource TextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
</Grid>
</Grid>
                                    </StackPanel>
                                    <Grid Height="{Binding ViewportHeight, ElementName=PART_ScrollViewHost}" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"><Control Template="{DynamicResource LocalEmptyMapTemplate}" Width="360" Height="230" HorizontalAlignment="Center" Focusable="False" IsTabStop="False" IsHitTestVisible="False" /><TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLarger}" Foreground="{DynamicResource HeadingForegroundBrush}"/></StackPanel></Grid>
                                </Grid>
                            </ScrollViewer>
                            <Button x:Name="SidePanelCloseButton" Tag="{DynamicResource GameBannerHeight}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" Width="28" Height="28" Padding="0"
                                    Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}"
                                    Command="{MainViewModel CloseGameSideBarCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Collapsed` : `Visible`'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <!-- Close: the Back flag, 28x28: slate at rest with an ink outline and a cream X, the danger red flag fades in on hover. -->
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                                            <Control Template="{DynamicResource LocalFlagTemplate}" Foreground="{DynamicResource LocalInkBrush}" Background="{DynamicResource LocalInkBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                            <Control Template="{DynamicResource LocalFlagTemplate}" Margin="2" Foreground="{DynamicResource ButtonBackgroundBrush}" Background="{DynamicResource LocalInkBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                            <Control x:Name="HoverPlate" Template="{DynamicResource LocalFlagTemplate}" Margin="2" Foreground="{DynamicResource DangerBrush}" Background="{DynamicResource LocalInkBrush}" Opacity="0" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                            <ContentControl x:Name="Glyph" Width="12" Height="12" Margin="0,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                            Content="{DynamicResource IconWindowClose}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                    </Storyboard></BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard><Storyboard>
                                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                    </Storyboard></BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HoverPlate" Property="Opacity" Value="0.7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
