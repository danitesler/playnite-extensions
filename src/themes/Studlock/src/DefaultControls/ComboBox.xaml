<!--
    Studlock: DefaultControls/ComboBox.xaml.
    32px molded ABS dropdown (ControlHeight) with generous 28px right clearance reserved for the yellow chevron
    on both ContentSite and PART_EditableTextBox (MinHeight=0). Popup hosts LocalMenuBoardTemplate (Cerulean
    chamfered brick board + studded violet top strip); 30px ComboBoxItem rows share Studlock's Canary Yellow
    brick-seamed highlight + golden triangle cursor + Wardrobe Green circular checkmark on IsSelected.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
        <Grid Background="Transparent">
            <Border x:Name="Chrome" Background="{DynamicResource NormalBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    BorderThickness="1.5,1.5,1.5,2.5"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    SnapsToDevicePixels="True">
                <Border VerticalAlignment="Top" Height="1" Margin="2,0" Background="{DynamicResource BevelLightBrush}" IsHitTestVisible="False" />
            </Border>
            <ContentControl x:Name="Chevron" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                            Foreground="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid Height="30" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Animated Canary Yellow brick-seamed highlight plate (IsHighlighted = pointer or keyboard) -->
                        <Border x:Name="HoverPlate" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Background="{DynamicResource LocalYellowLipBrush}"
                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="HoverScale" ScaleX="0.92" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Border Margin="0,0,0,2" CornerRadius="3" Background="{DynamicResource MenuItemHoverBrush}" />
                                <Rectangle Margin="0,0,0,2" Fill="{DynamicResource FrameInnerBrush}" Opacity="0.16"
                                           OpacityMask="{DynamicResource LocalBrickSeamsMaskBrush}" />
                            </Grid>
                        </Border>

                        <!-- Sliding golden triangle cursor -->
                        <Path x:Name="CursorArrow" Data="{DynamicResource LocalCursorRightGeometry}"
                              Width="8" Height="10" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                              Fill="{DynamicResource LocalCursorGoldBrush}"
                              Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1.2" StrokeLineJoin="Round"
                              Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Path.RenderTransform>
                                <TranslateTransform x:Name="CursorSlide" X="-5" />
                            </Path.RenderTransform>
                        </Path>

                        <Grid Margin="13,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <!-- Chosen-item Wardrobe Equipped Green circular checkmark badge -->
                            <Border x:Name="ChosenBadge" Grid.Column="1" Width="15" Height="15"
                                    CornerRadius="{DynamicResource CornerRadiusFull}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{DynamicResource LocalGreenBrightBrush}"
                                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1.2"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                                <ContentControl Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                Foreground="{DynamicResource TextBrushDark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ChosenBadge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ComboItemIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.16" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="CursorSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ComboItemOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CursorSlide" Storyboard.TargetProperty="X" To="-5" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource LocalComboBoxToggleButton}"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" />
                        <!-- Generous 28px right clearance so selected text never collides with chevron -->
                        <Border Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                        </Border>
                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{DynamicResource BareTextBox}"
                                 MinHeight="0"
                                 Margin="8,2,28,2"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center"
                                 Focusable="True"
                                 Visibility="Hidden"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                                <ScrollViewer Margin="5,10,5,6" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
