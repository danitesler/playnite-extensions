<!--
    Studlock: DefaultControls/ScrollViewer.xaml.
    LEGO Party! Technic Axle vertical & horizontal ScrollBar:
    - Recessed narrow cylindrical axle rod track (x:Name="TrackFill" drops to Opacity=0.4 under ShowBackgroundImageOnWindow=True).
    - Grooved light-grey Technic brick pill thumb (half-thickness CornerRadius=4.5, never CornerRadiusFull).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LocalScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grooved Technic sliding brick thumb -->
    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBrick" CornerRadius="4.5" Margin="1"
                            Background="{DynamicResource ScrollBarThumbBrush}"
                            BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Rectangle Width="4" Height="1" Margin="0,0,0,2" Fill="{DynamicResource LocalAxleRodBrush}" />
                            <Rectangle Width="4" Height="1" Margin="0,0,0,2" Fill="{DynamicResource LocalAxleRodBrush}" />
                            <Rectangle Width="4" Height="1" Fill="{DynamicResource LocalAxleRodBrush}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBrick" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                            <Setter TargetName="ThumbBrick" Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBrick" Property="Background" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="ThumbBrick" Property="BorderBrush" Value="{DynamicResource FrameInnerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="LocalVerticalScrollBar" TargetType="{x:Type ScrollBar}">
        <Grid Width="12" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Cylindrical Technic axle shaft -->
            <Border x:Name="TrackFill" Width="4" HorizontalAlignment="Center" Margin="0,4"
                    CornerRadius="2" Background="{DynamicResource ScrollBarTrackBrush}"
                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" IsHitTestVisible="False" />
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource LocalScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{DynamicResource ScrollBarThumb}" MinHeight="28" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource LocalScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter TargetName="TrackFill" Property="Opacity" Value="0.4" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalHorizontalScrollBar" TargetType="{x:Type ScrollBar}">
        <Grid Height="12" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="TrackFill" Height="4" VerticalAlignment="Center" Margin="4,0"
                    CornerRadius="2" Background="{DynamicResource ScrollBarTrackBrush}"
                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" IsHitTestVisible="False" />
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource LocalScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{DynamicResource ScrollBarThumb}" MinWidth="28" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource LocalScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter TargetName="TrackFill" Property="Opacity" Value="0.4" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template" Value="{StaticResource LocalHorizontalScrollBar}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Template" Value="{StaticResource LocalVerticalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
