<!--
    Studlock: DefaultControls/TabControl.xaml.
    LEGO Party! Settings horizontal segmented tab strip: cool dark tiles snapping into solid Canary Yellow
    when selected. TabItem keeps Foreground=TextBrush so dialog tab pages inherit readable text;
    header colors target HeaderLabel inside ControlTemplate.Triggers (src/themes/AGENTS.md Tab colours).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource TabControlHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="3" Margin="0,0,0,8">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Panel.ZIndex="1"
                                      KeyboardNavigation.TabIndex="1" Background="Transparent" />
                        </Border>
                        <Border x:Name="ContentPanel" Grid.Row="1" Background="Transparent"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Padding" Value="14,6,14,6" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="IdleTile" Background="{DynamicResource NormalBrush}"
                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" IsHitTestVisible="False" />
                        <Border x:Name="HoverTile" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource TabItemHoverIndicatorBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="SelectedTile" Background="{DynamicResource LocalYellowLipBrush}"
                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <Grid>
                                <Border Margin="0,0,0,2" CornerRadius="3" Background="{DynamicResource TabItemIndicatorBrush}" />
                                <Rectangle Margin="0,0,0,2" Fill="{DynamicResource FrameInnerBrush}" Opacity="0.16"
                                           OpacityMask="{DynamicResource LocalBrickSeamsMaskBrush}" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="HeaderLabel" Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TabItemForegroundBrush}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderLabel" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TabHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverTile" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverTile" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TabHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverTile" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverTile" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="10" />
                            <Setter TargetName="IdleTile" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverTile" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SelectedTile" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderLabel" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="HeaderLabel" Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
