<!--
    Studlock: DefaultControls/ProgressBar.xaml.
    LEGO Party! Minigame segmented vertical-brick yellow countdown bar (brick-ticks.png white mask).
    Height="{TemplateBinding Height}" with MinHeight=8 so TopPanel's PART_ProgressGlobal Height=12 overrides cleanly.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FrameInnerBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid Height="{TemplateBinding Height}" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <!-- Grooved dark-grey background notch segments -->
                                <Rectangle Margin="1" Fill="{DynamicResource ScrollBarTrackBrush}" Opacity="0.4"
                                           OpacityMask="{DynamicResource LocalBrickTicksMaskBrush}" IsHitTestVisible="False" />
                                <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                                    <Rectangle Margin="1" Fill="{TemplateBinding Foreground}"
                                               OpacityMask="{DynamicResource LocalBrickTicksMaskBrush}" />
                                </Grid>
                                <Grid x:Name="PART_GlowRect" Visibility="Collapsed" HorizontalAlignment="Left" Width="90" IsHitTestVisible="False">
                                    <Rectangle Margin="1" Fill="{TemplateBinding Foreground}"
                                               OpacityMask="{DynamicResource LocalBrickTicksMaskBrush}">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="IndetSlide" X="-90" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_GlowRect" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ProgIndet">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndetSlide" Storyboard.TargetProperty="X"
                                                         From="-90" To="420" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="ProgIndet" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
