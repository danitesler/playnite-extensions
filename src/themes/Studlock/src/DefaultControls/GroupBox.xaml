<!--
    Studlock: DefaultControls/GroupBox.xaml.
    Content-sized ABS brick card with segmented Cerulean Blue header band (DISPLAY/GRAPHICS motif).
    No fixed widths or wide Paths so Playnite Statistics wraps GroupBoxes cleanly as compact cards.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True" ClipToBounds="True">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Background="{DynamicResource HeaderBandBrush}" ClipToBounds="True">
                                <Rectangle Fill="{DynamicResource FrameInnerBrush}" Opacity="0.18"
                                           OpacityMask="{DynamicResource LocalBrickSeamsMaskBrush}" IsHitTestVisible="False" />
                                <Rectangle Height="1.5" VerticalAlignment="Bottom" Fill="{DynamicResource FrameInnerBrush}" IsHitTestVisible="False" />
                                <TextBlock Margin="12,6,12,7"
                                           FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Black" FontSize="13"
                                           Foreground="{DynamicResource HeaderBandForegroundBrush}">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                </TextBlock>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
