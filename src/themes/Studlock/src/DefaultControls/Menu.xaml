<!--
    Studlock: DefaultControls/Menu.xaml.
    Menus signature (docs/themes/menus.md):
    - Rows: 30px height, fixed 26px icon column, plain * label column (shortcuts & arrows flush right), shared shortcut column.
    - Highlight: Canary Yellow (#FFE421) brick-seamed snap plate (ScaleX 0.92->1, 120ms BackEase) + black-outlined
      golden triangle cursor sliding in from left; label, icon & submenu arrow invert sharply to ABS ink (#161719, 13.85:1).
    - Group break: 10px recessed horizontal molded circular stud row (DividerTemplate / stud-row.png).
    - Shortcuts: dark controller-prompt brick keycaps (#1B1D20, Consolas bold), inverting to ABS ink with yellow text on highlight.
    - Marked rows: Exit (Alt+Q) wears Classic Brick Red (#C9242B) text/icon/cap rim at rest, flipping to solid Brick Red
      brick-seamed plate with crisp white text/icon/cursor (5.57:1) on highlight; checked rows show Wardrobe's Equipped
      Green circular checkmark disc.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group break: 10px recessed circular molded stud row (DISPLAY/GRAPHICS separator) -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="6,1,6,1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control VerticalAlignment="Center" Template="{DynamicResource DividerTemplate}"
                             Foreground="{DynamicResource MenuSeparatorBrush}" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}" />

    <!-- Plain menu row (30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated Canary Yellow brick-seamed highlight plate (collapsed at rest) -->
            <Border x:Name="HoverPlate" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Background="{DynamicResource LocalYellowLipBrush}"
                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="HoverScale" ScaleX="0.92" ScaleY="1" />
                </Border.RenderTransform>
                <Grid>
                    <Border Margin="0,0,0,2" CornerRadius="3" Background="{DynamicResource MenuItemHoverBrush}" />
                    <Rectangle Margin="0,0,0,2" Fill="{DynamicResource FrameInnerBrush}" Opacity="0.16"
                               OpacityMask="{DynamicResource LocalBrickSeamsMaskBrush}" />
                </Grid>
            </Border>

            <!-- Exit danger highlight plate (Classic Brick Red, collapsed at rest) -->
            <Border x:Name="DangerPlate" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Background="{DynamicResource DangerBrush}"
                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DangerScale" ScaleX="0.92" ScaleY="1" />
                </Border.RenderTransform>
                <Rectangle Fill="{DynamicResource FrameInnerBrush}" Opacity="0.18"
                           OpacityMask="{DynamicResource LocalBrickSeamsMaskBrush}" />
            </Border>

            <!-- Sliding black-outlined golden triangle cursor on leading edge -->
            <Path x:Name="CursorArrow" Data="{DynamicResource LocalCursorRightGeometry}"
                  Width="9" Height="11" Stretch="Uniform"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
                  Fill="{DynamicResource LocalCursorGoldBrush}"
                  Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1.3" StrokeLineJoin="Round"
                  Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="CursorSlide" X="-6" />
                </Path.RenderTransform>
            </Path>

            <Grid Margin="11,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <!-- Fixed 26px icon / Wardrobe Equipped Green checkmark column -->
                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentPresenter x:Name="Icon" ContentSource="Icon" MaxWidth="16" MaxHeight="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource TextBrush}" />
                    <Border x:Name="CheckBadge" Width="16" Height="16" CornerRadius="{DynamicResource CornerRadiusFull}"
                            Background="{DynamicResource LocalGreenBrightBrush}"
                            BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1.2"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <ContentControl Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{DynamicResource TextBrushDark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Label column (plain *, nudges +2px right on highlight) -->
                <Border Grid.Column="1" Margin="4,0,10,0" VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="LabelNudge" X="0" />
                    </Border.RenderTransform>
                    <TextBlock x:Name="HeaderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSize}">
                        <ContentPresenter x:Name="HeaderHost" ContentSource="Header" RecognizesAccessKey="True" />
                    </TextBlock>
                </Border>

                <!-- Controller-prompt brick shortcut keycap -->
                <Border x:Name="ShortcutCap" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,2,0"
                        Padding="6,1,6,1" CornerRadius="3"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrushDarker}" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutCap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutCap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- Exit row (Alt+Q) resting danger cue -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Trigger>
            <!-- Standard highlight: Canary Yellow brick-seamed snap plate + inverted dark ABS ink -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="HeaderText" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="ShortcutCap" Property="Background" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.16" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="CursorSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.22" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelNudge" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="CursorSlide" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="LabelNudge" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <!-- Exit highlighted: solid Brick Red danger plate + crisp white label/icon/cursor (5.57:1) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="CursorArrow" Property="Fill" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutCap" Property="Background" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="MenuDangerIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="DangerScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.16" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="MenuDangerOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="DangerPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="DangerScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Submenu header row (30px + held open plate + nested LocalMenuBoardTemplate popup) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held plate while submenu is open (setter-driven, no flicker) -->
            <Border x:Name="OpenPlate" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Background="{DynamicResource LocalCeruleanWashBrush}"
                    BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1"
                    Visibility="Collapsed" IsHitTestVisible="False" />

            <!-- Animated Canary Yellow brick-seamed highlight plate -->
            <Border x:Name="HoverPlate" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Background="{DynamicResource LocalYellowLipBrush}"
                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="HoverScale" ScaleX="0.92" ScaleY="1" />
                </Border.RenderTransform>
                <Grid>
                    <Border Margin="0,0,0,2" CornerRadius="3" Background="{DynamicResource MenuItemHoverBrush}" />
                    <Rectangle Margin="0,0,0,2" Fill="{DynamicResource FrameInnerBrush}" Opacity="0.16"
                               OpacityMask="{DynamicResource LocalBrickSeamsMaskBrush}" />
                </Grid>
            </Border>

            <!-- Sliding golden cursor triangle -->
            <Path x:Name="CursorArrow" Data="{DynamicResource LocalCursorRightGeometry}"
                  Width="9" Height="11" Stretch="Uniform"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
                  Fill="{DynamicResource LocalCursorGoldBrush}"
                  Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1.3" StrokeLineJoin="Round"
                  Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="CursorSlide" X="-6" />
                </Path.RenderTransform>
            </Path>

            <Grid Margin="11,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon" MaxWidth="16" MaxHeight="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource TextBrush}" />

                <Border Grid.Column="1" Margin="4,0,10,0" VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="LabelNudge" X="0" />
                    </Border.RenderTransform>
                    <TextBlock x:Name="HeaderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSize}">
                        <ContentPresenter x:Name="HeaderHost" ContentSource="Header" RecognizesAccessKey="True" />
                    </TextBlock>
                </Border>

                <ContentControl x:Name="SubmenuArrow" Grid.Column="3"
                                Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource GlyphBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>

            <Popup x:Name="Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-10"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Grid Grid.IsSharedSizeScope="True" MinWidth="210" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="5,10,5,6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
                <Setter TargetName="SubmenuArrow" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="HeaderText" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="SubmenuArrow" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.16" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="CursorSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.22" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelNudge" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="CursorSlide" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="LabelNudge" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
