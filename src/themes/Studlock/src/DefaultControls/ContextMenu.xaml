<!--
    Studlock: DefaultControls/ContextMenu.xaml.
    Panel signature: Chamfered Cerulean Brick Modal Board (LocalMenuBoardTemplate) inspired by LEGO Party!'s
    LEAVE PARTY? modal & Settings frame — dark matte charcoal ABS interior (#2B2E33), 2.5px Cerulean Brick outer rim
    (#2B8FC4) over a 1px ABS ink inner groove (#161719), crowned by a 6px Studded Stage Violet strip (#61459A)
    bearing miniature circular molded studs. Shared by ContextMenu, submenus, TopPanelMenu, and ComboBox lists.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared board chrome hosted by ContextMenu, SubmenuHeader popups, and ComboBox popups -->
    <ControlTemplate x:Key="LocalMenuBoardTemplate" TargetType="{x:Type Control}">
        <Border Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="2"
                CornerRadius="{DynamicResource CornerRadiusLarge}"
                SnapsToDevicePixels="True"
                IsHitTestVisible="False">
            <Border BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <!-- 6px Studded Stage Violet crown strip along the top edge -->
                    <Grid Height="6" VerticalAlignment="Top">
                        <Rectangle Fill="{DynamicResource LocalVioletBrush}" />
                        <Rectangle Fill="{DynamicResource TextBrush}" Opacity="0.28"
                                   OpacityMask="{DynamicResource LocalStudRowMaskBrush}" />
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource FrameInnerBrush}" />
                    </Grid>
                    <!-- Subtle bottom ABS rim shadow -->
                    <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.45" />
                </Grid>
            </Border>
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="5,10,5,6"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
