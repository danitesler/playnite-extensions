<!--
    Studlock: DefaultControls/Expander.xaml.
    Molded segmented Cerulean/charcoal Expander header for Library groups and collapsible sections.
    Header turns Transparent when ShowBackgroundImageOnWindow=True (required WindowBackground rule).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalExpanderToggleTemplate" TargetType="{x:Type ToggleButton}">
        <Border x:Name="HeaderBorder" Background="{DynamicResource HeaderBandBrush}"
                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1.5"
                CornerRadius="{DynamicResource CornerRadiusSmall}" Padding="10,5,10,5"
                SnapsToDevicePixels="True">
            <Grid>
                <Rectangle Margin="-10,-5" Fill="{DynamicResource FrameInnerBrush}" Opacity="0.18"
                           OpacityMask="{DynamicResource LocalBrickSeamsMaskBrush}" IsHitTestVisible="False" />
                <DockPanel>
                    <ContentControl x:Name="Arrow" DockPanel.Dock="Left" Margin="0,0,8,0"
                                    Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                    Foreground="{DynamicResource GlyphBrush}" VerticalAlignment="Center" />
                    <TextBlock FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Black" FontSize="12.5"
                               Foreground="{DynamicResource HeaderBandForegroundBrush}" VerticalAlignment="Center">
                        <ContentPresenter ContentSource="Content" RecognizesAccessKey="True" />
                    </TextBlock>
                </DockPanel>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter TargetName="HeaderBorder" Property="Background" Value="Transparent" />
                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="Transparent" />
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Arrow" Property="Content" Value="{DynamicResource IconDropDown}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel>
                        <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Template="{StaticResource LocalExpanderToggleTemplate}" />
                        <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                          Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
