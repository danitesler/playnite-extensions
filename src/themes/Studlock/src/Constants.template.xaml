<!--
    Studlock: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Molded charcoal ABS baseplate, studded Stage Violet header plaques & rail spine, chamfered Cerulean Brick frames,
    Canary Yellow brick-seamed selection & Play CTA, Equipped Brick Green running state, Wardrobe Aqua filter pip,
    and Classic Brick Red danger cues.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (bundled static Sora & Nunito in src/Typography/, Consolas native) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">13.5</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">30</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Sora, {{text:sl-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Nunito, {{text:sl-font-heading|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:sl-font-mono|Consolas}}</FontFamily>

    <!-- Usable metadata content width & switchable position -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape & bounded corner radius scale -->
    <Thickness x:Key="PopupBorderThickness">2</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:sl-radius-sm|4}}</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">{{px:sl-radius-md|6}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:sl-radius-lg|8}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:sl-radius-xl|10}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:sl-radius-full|999}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{sl-white}}</Color>
    <Color x:Key="TextColorDarker">{{sl-muted}}</Color>
    <Color x:Key="TextColorDark">{{sl-ink}}</Color>
    <Color x:Key="MainColor">{{sl-surface}}</Color>
    <Color x:Key="MainColorDark">{{sl-panel}}</Color>
    <Color x:Key="HoverColor">{{sl-surface-hover}}</Color>
    <Color x:Key="GlyphColor">{{sl-yellow}}</Color>
    <Color x:Key="HighlightGlyphColor">{{sl-yellow-tint}}</Color>
    <Color x:Key="PopupBackgroundColor">{{sl-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{sl-cerulean}}</Color>
    <Color x:Key="BackgroundToneColor">{{sl-baseplate}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{sl-border-subtle}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{sl-border-subtle}}</Color>
    <Color x:Key="DataChangeNotifColor">{{sl-aqua}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{sl-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{sl-surface}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{sl-surface-raised}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{sl-surface-deep}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{sl-green-run}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{sl-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{sl-amber}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{sl-amber}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{sl-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{sl-baseplate}}" />

    <!-- Shell & Game page -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{sl-baseplate}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{sl-canvas}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{sl-baseplate}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{sl-surface-deep}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{sl-baseplate}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{sl-violet}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{sl-white}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{sl-cerulean}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{sl-scrim}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{sl-canvas}}" />
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{sl-violet-tint}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{sl-yellow}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{sl-yellow-lit}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{sl-ink}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{sl-ink}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{sl-surface-raised}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{sl-yellow}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{sl-yellow}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{sl-green-run}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{sl-cerulean-lit}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{sl-cerulean-wash}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{sl-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{sl-white}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{sl-white}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{sl-white}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{sl-white}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{sl-surface-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{sl-surface-pressed}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{sl-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{sl-yellow}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{sl-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{sl-yellow-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{sl-yellow-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{sl-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{sl-yellow-tint}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{sl-surface-raised}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{sl-ink}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{sl-surface-hover}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{sl-surface-pressed}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{sl-yellow}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{sl-surface-deep}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{sl-baseplate}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{sl-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{sl-cerulean}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{sl-border}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{sl-cerulean-lit}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{sl-green-bright}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{sl-surface-deep}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{sl-white}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{sl-yellow}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{sl-cerulean-lit}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{sl-yellow}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{sl-surface-deep}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{sl-brick-grey}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{sl-white}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{sl-axle-track}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{sl-axle-rod}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{sl-brick-grey}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{sl-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{sl-white}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{sl-yellow}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{sl-cerulean-lit}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{sl-surface-deep}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{sl-cerulean-lit}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{sl-yellow}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{sl-surface-raised}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{sl-yellow}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{sl-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{sl-ink}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{sl-surface-raised}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{sl-white}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{sl-yellow}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{sl-cerulean-lit}}" />

    <!-- Popups, Frames & Typography -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{sl-axle-rod}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{sl-white}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{sl-ink}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{sl-violet}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{sl-white}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{sl-cerulean}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{sl-ink}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{sl-cerulean-lit}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{sl-cerulean-band}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{sl-white}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{sl-bevel-light}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{sl-bevel-shadow}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{sl-white}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{sl-cerulean-lit}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{sl-violet-lit}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{sl-border-subtle}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{sl-cerulean-lit}}" />
    <SolidColorBrush x:Key="TextOutlineBrush" Color="{{sl-ink}}" />

    <!-- Theme-local decorative brushes -->
    <SolidColorBrush x:Key="LocalYellowLipBrush" Color="{{sl-yellow-lip}}" />
    <SolidColorBrush x:Key="LocalCursorGoldBrush" Color="{{sl-cursor-gold}}" />
    <SolidColorBrush x:Key="LocalVioletBrush" Color="{{sl-violet}}" />
    <SolidColorBrush x:Key="LocalVioletLitBrush" Color="{{sl-violet-lit}}" />
    <SolidColorBrush x:Key="LocalVioletDeepBrush" Color="{{sl-violet-deep}}" />
    <SolidColorBrush x:Key="LocalCeruleanWashBrush" Color="{{sl-cerulean-wash}}" />
    <SolidColorBrush x:Key="LocalCeruleanHoverBrush" Color="{{sl-cerulean-hover}}" />
    <SolidColorBrush x:Key="LocalGreenBrightBrush" Color="{{sl-green-bright}}" />
    <SolidColorBrush x:Key="LocalBrickGreyBrush" Color="{{sl-brick-grey}}" />
    <SolidColorBrush x:Key="LocalAxleRodBrush" Color="{{sl-axle-rod}}" />
</ResourceDictionary>
