<!--
    Studlock: Views/TopPanel.xaml.
    50px matte charcoal ABS header bar crowned at the top-right corner by a Studded Stage Violet plaque and closed
    by a 2px Cerulean Brick joint rule.
    Order: menu (sidebar hidden only), search (PART_TextMainSearch), filter (PART_ToggleFilter with 9px Wardrobe Aqua
    circular badge pip, zero text label), PART_PanelMainItems (sorting first via Grid.Column=0, icon-only view switches),
    notifications, plugins, 12px segmented yellow brick PART_ProgressGlobal; 136px right caption clearance.
    TopPanelMenu inherits ContextMenu with no template of its own (docs/themes/menus.md).
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentControl Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentControl Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentControl Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentControl Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentControl Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentControl Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentControl Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentControl Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentControl Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentControl Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <!-- Menus rule: TopPanelMenu inherits Studlock's ContextMenu panel with no template of its own -->
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <!-- Filter toggle: 32x32 molded brick button with 9px Wardrobe Aqua circular pip (TextFilter) on top-right, no text label -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <!-- Idle molded ABS tile -->
                        <Border x:Name="IdlePlate" Background="{DynamicResource NormalBrush}"
                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1.5,1.5,1.5,2.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                            <Border VerticalAlignment="Top" Height="1" Margin="2,0" Background="{DynamicResource BevelLightBrush}" />
                        </Border>
                        <Border x:Name="HoverPlate" Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1.5,1.5,1.5,2.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="ActiveWash" Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1.5,1.5,1.5,2.5"
                                CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <Grid Width="32" Height="32">
                            <ContentControl Content="{DynamicResource IconFilter}" ContentTemplate="{DynamicResource IconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}" />
                            <!-- 9px Wardrobe Aqua circular active-filter badge pip -->
                            <Ellipse x:Name="TextFilter" Visibility="Collapsed" IsHitTestVisible="False"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                     Width="9" Height="9"
                                     Fill="{DynamicResource DataChangeNotifBrush}"
                                     Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1.5" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="Visibility" Value="Visible" TargetName="ActiveWash" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="IdlePlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FilterHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="FilterHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Background="Transparent" Width="32" Height="32">
                        <Border x:Name="NotifPlate" Background="{DynamicResource NormalBrush}"
                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1.5,1.5,1.5,2.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <ContentControl Content="{DynamicResource IconNotifications}" ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Grid Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0">
                            <Ellipse Fill="{DynamicResource DataChangeNotifBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1.5" />
                            <TextBlock Text="{Api Notifications.Count}" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrushDark}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" TargetName="NotifPlate" />
                            <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" TargetName="NotifPlate" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Grid Height="50" Panel.ZIndex="2"
                          d:DesignWidth="1280"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource TopPanelBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- Studded Stage Violet plaque tucked into the top-right corner, flush with the window edge, slanted on its left -->
                        <Grid x:Name="TopCrown" Width="210" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Path Fill="{DynamicResource LocalVioletBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1"
                                  Data="M 0,0 L 210,0 L 210,10 L 12,10 Z" />
                            <Rectangle Margin="14,0,3,1" Fill="{DynamicResource TextBrush}" Opacity="0.22"
                                       OpacityMask="{DynamicResource LocalStudRowMaskBrush}" />
                        </Grid>

                        <!-- Bottom 2px Cerulean Brick joint rule -->
                        <Rectangle x:Name="BottomRule" Height="2" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource TopPanelSeparatorBrush}" IsHitTestVisible="False" />

                        <DockPanel Margin="12,8,136,10">
                            <Border x:Name="PART_ElemMainMenu" Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1.5"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    DockPanel.Dock="Left" Margin="0,0,8,0" Cursor="Hand" Width="32" Height="32"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <Control Template="{DynamicResource LocalStudlockMenuMarkTemplate}" Focusable="False" IsTabStop="False" Foreground="{DynamicResource MainMenuButtonForegroundBrush}" />
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch" Style="{DynamicResource TopPanelSearchBox}"
                                       Margin="0,0,2,0"
                                       WindowChrome.IsHitTestVisibleInChrome="True"
                                       Width="240" DockPanel.Dock="Left" HorizontalAlignment="Left" />

                            <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" DockPanel.Dock="Left" />

                            <!-- Sorting FIRST directly beside Filter despite Playnite's runtime insertion order -->
                            <Grid x:Name="PART_PanelMainItems" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="{x:Type TopPanelItem}" BasedOn="{StaticResource {x:Type TopPanelItem}}">
                                        <Style.Triggers>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSortSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="0" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSearchButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="1" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGeneralViewSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="2" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelFilterPresetsSelectionTemplate}">
                                                <Setter Property="Grid.Column" Value="3" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGroupSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="4" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchDetailsViewTemplate}">
                                                <Setter Property="Grid.Column" Value="6" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchGridViewTemplate}">
                                                <Setter Property="Grid.Column" Value="7" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchListViewTemplate}">
                                                <Setter Property="Grid.Column" Value="8" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelUpdateButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="9" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="10" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelViewSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="11" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelExplorerSwitchTemplate}">
                                                <Setter Property="Grid.Column" Value="12" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Grid.Column" Value="5" />
                                    </Style>
                                </Grid.Resources>
                            </Grid>

                            <CheckBox x:Name="PART_ToggleNotifications"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" DockPanel.Dock="Left" />

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Stretch" Margin="10,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <!-- Segmented yellow brick 12px global progress bar -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Center" Margin="4,0">
                                <Grid MaxWidth="540" MinWidth="260" VerticalAlignment="Center">
                                    <ProgressBar Name="PART_ProgressGlobal" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Name="PART_TextProgressText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Style="{DynamicResource BaseTextBlockStyle}" FontSize="11" FontWeight="SemiBold"
                                               Margin="16,0,16,0" />
                                </Grid>
                                <Button Name="PART_ButtonProgressCancel" Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True" Height="28" MinHeight="28"
                                        Padding="10,0" Margin="6,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter TargetName="TopCrown" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BottomRule" Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
