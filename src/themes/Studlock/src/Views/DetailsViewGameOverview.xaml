<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                                <Border x:Name="MetaProgress"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,6,0,0" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource LocalAxleRodBrush}" Margin="0,0,0,8" Focusable="False" IsTabStop="False" />
</Border>
<Border x:Name="PART_ElemCompletionStatus" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
