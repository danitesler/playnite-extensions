<Border x:Name="PART_ElemLinks" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                                                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCLinksLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                                        <Border Grid.Column="2"><ItemsControl x:Name="PART_ItemsLinks" Tag="">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <WrapPanel />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                </ItemsControl></Border>
                                                                                    </Grid>
                                                                                </Border>
                                                                    </WrapPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DockPanel>
                                                </Border>
                                            </Grid>
</Grid>
<Grid x:Name="GridMainColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="MaxWidth"><Setter.Value><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="z == true ? x : Max(0, x - y - 24)"><Binding Path="ActualWidth" ElementName="GridOverviewBody" /><Binding Path="ActualWidth" ElementName="GridMetadataColumn" /><Binding Path="Tag" ElementName="GridOverviewBody" /></MultiBinding></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="1" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="1" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="1" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<StackPanel VerticalAlignment="Top">
                                                <Grid x:Name="SteamScreenshotsGameScope">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.Source.Name}" Value="Steam">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" Margin="0,0,0,18">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Game.PluginId}" Value="CB91DFC9-B977-43BF-8E70-55F46E410FAB" />
                                                                            <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Control x:Name="SteamScreenshotsSkeleton" Tag="{Binding Game.Id, NotifyOnTargetUpdated=True}" Visibility="Collapsed"
                                                                 Margin="0,0,0,18" Template="{DynamicResource SteamScreenshotsSkeletonTemplate}"
                                                                 Foreground="{DynamicResource FrameBrush}" Focusable="False">
                                                            <Control.Triggers>
                                                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Control.Triggers>
                                                        </Control>
                                                    </Grid>
                                                </Grid>
                                                <StackPanel x:Name="PART_ElemDescription">
                                                    <DockPanel Margin="0,0,0,10">
                                                        <Border DockPanel.Dock="Left" Width="8" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" CornerRadius="2"
                                                                Background="{DynamicResource HeadingMarkerAltBrush}"
                                                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" IsHitTestVisible="False" />
                                                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource LOCGameDescriptionTitle}" Style="{DynamicResource HeadingTextBlock}" Margin="0,0,10,0" />
                                                        <Rectangle Height="2" VerticalAlignment="Center" Fill="{DynamicResource HeadingRuleBrush}" IsHitTestVisible="False" />
                                                    </DockPanel>
                                                    <Border Padding="0,2,0,0">
                                                        <HtmlTextView x:Name="PART_HtmlDescription" HtmlFontFamily="{DynamicResource FontFamily}" HtmlFontSize="{DynamicResource FontSize}"
                                                                      TextElement.Foreground="{DynamicResource TextBrush}"
                                                                      Tag="{DynamicResource LinkBrush}"
                                                                      HtmlForeground="{Binding Path=(TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                      LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel x:Name="PART_ElemNotes" Margin="0,20,0,0">
                                                    <DockPanel Margin="0,0,0,10">
                                                        <Border DockPanel.Dock="Left" Width="8" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" CornerRadius="2"
                                                                Background="{DynamicResource HeadingMarkerBrush}"
                                                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" IsHitTestVisible="False" />
                                                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource LOCNotesLabel}" Style="{DynamicResource HeadingTextBlock}" Margin="0,0,10,0" />
                                                        <Rectangle Height="2" VerticalAlignment="Center" Fill="{DynamicResource HeadingRuleBrush}" IsHitTestVisible="False" />
                                                    </DockPanel>
                                                    <TextBox x:Name="PART_TextNotes" IsReadOnly="True" TextWrapping="Wrap" Style="{DynamicResource LocalNotesTextBox}" />
                                                </StackPanel>
                                            </StackPanel>
</Grid>
</Grid>
                                    </StackPanel>
                                    <Grid VerticalAlignment="Top" Height="{Binding ViewportHeight, ElementName=PART_ScrollViewHost}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Control Template="{DynamicResource EmptyGameTemplate}" Foreground="{DynamicResource FrameBrush}" Focusable="False" />
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                            <Button x:Name="SidePanelCloseButton" Tag="{DynamicResource GameBannerHeight}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" Width="28" Height="28" Padding="0"
                                    Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}"
                                    Command="{MainViewModel CloseGameSideBarCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Collapsed` : `Visible`'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                                            <Path x:Name="Lip" Data="M 4,0 L 24,0 L 28,4 L 28,24 L 24,28 L 4,28 L 0,24 L 0,4 Z"
                                                  Fill="{DynamicResource FrameInnerBrush}" IsHitTestVisible="False" />
                                            <Path x:Name="Face" Data="M 5,1.5 L 23,1.5 L 26.5,5 L 26.5,22 L 23,25.5 L 5,25.5 L 1.5,22 L 1.5,5 Z"
                                                  Fill="{DynamicResource ButtonBackgroundBrush}" IsHitTestVisible="False" />
                                            <Rectangle Height="1" Width="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                                       Fill="{DynamicResource BevelLightBrush}" IsHitTestVisible="False" />
                                            <Path x:Name="HoverPlate" Data="M 5,1.5 L 23,1.5 L 26.5,5 L 26.5,22 L 23,25.5 L 5,25.5 L 1.5,22 L 1.5,5 Z"
                                                  Fill="{DynamicResource DangerBrush}" Opacity="0" IsHitTestVisible="False" />
                                            <ContentControl x:Name="Glyph" Width="13" Height="13" Margin="0,0,0,1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            IsHitTestVisible="False" Content="{DynamicResource IconWindowClose}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                    </Storyboard></BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard><Storyboard>
                                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                    </Storyboard></BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HoverPlate" Property="Opacity" Value="0.72" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
