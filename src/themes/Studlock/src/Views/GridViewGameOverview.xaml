<!--
    Studlock: Views/GridViewGameOverview.xaml (generated by art/gen-overviews.mjs).
    - Chamfered Cerulean Brick hero bezel (GameBannerHeight=320, spacer x * 198 / 320 floor 14) with GameBannerDarken + 50% floor.
    - CloseGameSideBarCommand: custom 28x28 chamfered molded ABS brick cap with Brick Red hover;
      inline sticky left of icon when GameBannerHeight < 120 or ShowBackgroundImageOnWindow=True, corner 12,12 otherwise.
    - Actions under title: PlayButton + RunningActionIndicator + equal 40x40 SecondaryButton More & Edit.
    - Chamfered Cerulean ABS Metadata Dossier (GridDetailsPaneWidth=300 usable width, 2*:3* columns, GameDetailsPanePosition).
    - Empty state: Studlock Golden 2x2 Brick EmptyGameTemplate centered in ViewportHeight when Game is null.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="GridViewGameOverview">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewGameOverview">
                    <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1.5,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left"><Setter Property="BorderThickness" Value="0,0,1.5,0" /></DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False"><Setter Property="BorderThickness" Value="0" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <ScrollViewer CanContentScroll="False" x:Name="PART_ScrollViewHost" Visibility="Visible" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                                <Grid x:Name="PageRoot" UseLayoutRounding="True">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                    <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                            <Setter Property="Height" Value="0" />
                                                        </DataTrigger>
                                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                        <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                        <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                        <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <!-- Chamfered Cerulean Brick top/side upper bezel with modular brick-seam highlight -->
                                        <Border Margin="20,10,20,0" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="3,3,3,0"
                                                CornerRadius="8,8,0,0" Opacity="0.9">
                                            <Rectangle Height="3" VerticalAlignment="Top" Fill="{DynamicResource TextBrush}" Opacity="0.22"
                                                       OpacityMask="{DynamicResource LocalBrickSeamsMaskBrush}" />
                                        </Border>
                                        <!-- Clean page-matched gradient fade (no OpacityMask behind animated PlayButton) -->
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0.24" />
                                                    <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.82" />
                                                    <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                    <StackPanel Panel.ZIndex="2" Margin="24,0,24,26">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border x:Name="GridBannerSpacer" MinHeight="14" IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 198 / 320'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="14" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
                                                            <Setter Property="Height" Value="14" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Panel.ZIndex="2" Margin="0,10,0,14">
                                            <DockPanel Panel.ZIndex="2">
                                                <Button x:Name="InlineSidePanelCloseButton" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Margin="0,0,10,0" Width="28" Height="28" Padding="0" Focusable="False" Cursor="Hand"
                                                        ToolTip="{DynamicResource LOCCloseLabel}" Command="{MainViewModel CloseGameSideBarCommand}"
                                                        Template="{Binding Template, ElementName=SidePanelCloseButton}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="{Binding Tag, ElementName=SidePanelCloseButton, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Visible` : `Collapsed`'}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.RenderTransform>
                                                        <TranslateTransform Y="{Binding ContentVerticalOffset, ElementName=PART_ScrollViewHost}" />
                                                    </Button.RenderTransform>
                                                </Button>
                                                <Image x:Name="PART_ImageIcon" MaxWidth="44" MaxHeight="44" Margin="0,0,14,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="PART_TextDisplayName"
                                                               FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Black" FontStyle="Italic"
                                                               FontSize="{DynamicResource FontSizeLargest}" Foreground="{DynamicResource HeadingForegroundBrush}"
                                                               TextWrapping="Wrap" />
                                                    <Border Height="3" Width="96" HorizontalAlignment="Left" Margin="0,5,0,0" CornerRadius="1.5"
                                                            Background="{DynamicResource GlyphBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Grid MinWidth="156" Height="42">
                                                    <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                    <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                                    <Control Style="{DynamicResource RunningActionIndicator}" />
                                                </Grid>
                                                <Button x:Name="PART_ButtonMoreActions" Width="40" Height="40" Padding="0" Style="{DynamicResource SecondaryButton}" Margin="10,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                                    <ContentControl Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                                <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0" ToolTip="{DynamicResource LOCEditGame}">
                                                    <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Margin="0,14,0,0" x:Name="GridOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="GridMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="GridMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
<Grid Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                                <!-- Studlock Chamfered Cerulean Brick ABS Dossier (300px usable inner content width) -->
                                                <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                                        Background="{DynamicResource NormalBrushDark}"
                                                        BorderBrush="{DynamicResource FrameBrush}" BorderThickness="2"
                                                        CornerRadius="{DynamicResource CornerRadiusLarge}" ClipToBounds="True">
                                                    <DockPanel>
                                                        <!-- Segmented Cerulean Brick top header cap -->
                                                        <Grid DockPanel.Dock="Top" Height="24" Background="{DynamicResource HeaderBandBrush}" ClipToBounds="True">
                                                            <Rectangle Fill="{DynamicResource FrameInnerBrush}" Opacity="0.2"
                                                                       OpacityMask="{DynamicResource LocalBrickSeamsMaskBrush}" IsHitTestVisible="False" />
                                                            <Rectangle Height="1.5" VerticalAlignment="Bottom" Fill="{DynamicResource FrameInnerBrush}" IsHitTestVisible="False" />
                                                            <DockPanel Margin="12,0,10,0">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                    <Ellipse Width="6" Height="6" Margin="0,0,4,0" Fill="{DynamicResource FrameHoverBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1" />
                                                                    <Ellipse Width="6" Height="6" Margin="0,0,4,0" Fill="{DynamicResource FrameHoverBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1" />
                                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource FrameHoverBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1" />
                                                                </StackPanel>
                                                                <TextBlock Text="{DynamicResource LOCGameDetails}" VerticalAlignment="Center"
                                                                           FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Black" FontSize="11"
                                                                           Foreground="{DynamicResource HeaderBandForegroundBrush}" />
                                                            </DockPanel>
                                                        </Grid>
                                                        <Border Padding="14,10,14,12">
                                                            <StackPanel Tag="{DynamicResource GridDetailsPaneWidth}" HorizontalAlignment="Stretch" x:Name="GridMetadataContent">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GridDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GridDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Center"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Stretch"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                                <Grid ClipToBounds="True" x:Name="GridMetadataViewport">
                                                                    <WrapPanel x:Name="GridMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-24,0,-4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-24,-24,-4" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Center"><Setter Property="Margin" Value="0,-4,0,-4" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Center" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-4,-24,-4" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Stretch"><Setter Property="Margin" Value="0,-4,0,-4" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Stretch" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-4,-24,-4" /></MultiDataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                                        <Border x:Name="MetaProgress"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,6,0,0" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource LocalAxleRodBrush}" Margin="0,0,0,8" Focusable="False" IsTabStop="False" />
</Border>
<Border x:Name="PART_ElemCompletionStatus" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                                                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                                        <Border Grid.Column="2"><Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PropertyItemButton}" /></Border>
                                                                                    </Grid>
                                                                                </Border>
<Border x:Name="PART_ElemPlayTime" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                                                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                                        <Border Grid.Column="2"><TextBlock x:Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" /></Border>
                                                                                    </Grid>
                                                                                </Border>
<Border x:Name="PART_ElemLastPlayed" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                                                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                                        <Border Grid.Column="2"><TextBlock x:Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" /></Border>
                                                                                    </Grid>
                                                                                </Border>
<Border x:Name="PART_ElemRecentActivity" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                                                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCRecentActivityLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                                        <Border Grid.Column="2"><TextBlock x:Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" /></Border>
                                                                                    </Grid>
                                                                                </Border>
<Border x:Name="PART_ElemAdded" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                                                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCDateAddedLabel}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                                        <Border Grid.Column="2"><TextBlock x:Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" /></Border>
                                                                                    </Grid>
                                                                                </Border>
<Border x:Name="MetaScores"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,6,0,0" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource LocalAxleRodBrush}" Margin="0,0,0,8" Focusable="False" IsTabStop="False" />
</Border>
<Border x:Name="PART_ElemCommunityScore" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                                    <Grid>
