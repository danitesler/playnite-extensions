<!--
    Studlock: Common.xaml.
    Spacing & form control sizing (ControlHeight=32px, IconSize=16px, GameBannerHeight=320px, GameBannerDarken=0),
    PopupBorder, FocusVisual, shared ImageBrush white-mask FX resources, BrandMarkTemplate (2x2 isometric studded brick),
    DividerTemplate (10px molded stud-row break), SteamScreenshotsSkeletonTemplate, and EmptyGameTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing & sizing keys (32px form controls, 16px icons, 320px hero banner) -->
    <Thickness x:Key="ButtonPadding">12,5,12,5</Thickness>
    <Thickness x:Key="InputPadding">9,5,9,5</Thickness>
    <Thickness x:Key="MenuPadding">4,5,4,5</Thickness>
    <Thickness x:Key="MenuItemPadding">8,4,10,4</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4,4,4,4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,4,8,4</Thickness>
    <Thickness x:Key="ListBoxItemPadding">8,5,8,5</Thickness>
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>
    <Thickness x:Key="TooltipPadding">10,7,10,7</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Shared procedural white-mask FX brushes (recolored dynamically by ThemeModifier) -->
    <ImageBrush x:Key="LocalStudWallMaskBrush" ImageSource="{ThemeFile 'Images/fx/stud-wall.png'}"
                TileMode="Tile" Viewport="0,0,36,36" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalStudWallCompactMaskBrush" ImageSource="{ThemeFile 'Images/fx/stud-wall.png'}"
                TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalStudRowMaskBrush" ImageSource="{ThemeFile 'Images/fx/stud-row.png'}"
                TileMode="Tile" Viewport="0,0,20,10" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBrickSeamsMaskBrush" ImageSource="{ThemeFile 'Images/fx/brick-seams.png'}"
                TileMode="Tile" Viewport="0,0,84,8" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBrickSheenMaskBrush" ImageSource="{ThemeFile 'Images/fx/brick-sheen.png'}"
                Stretch="Fill" />
    <!-- Vector tiled DrawingBrush for razor-sharp segmented brick ticks at any DPI (ProgressBar & RunningScan) -->
    <DrawingBrush x:Key="LocalBrickTicksMaskBrush" TileMode="Tile" Viewport="0,0,10,12" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,10,12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="1,0,7.5,12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Shared golden cursor triangle geometries (right-pointing for rows/menus/Play, down-pointing for covers) -->
    <Geometry x:Key="LocalCursorRightGeometry">M 1,1.5 L 12,8 L 1,14.5 Z</Geometry>
    <Geometry x:Key="LocalCursorDownGeometry">M 1.5,1 L 13.5,1 L 7.5,10 Z</Geometry>

    <!-- PopupBorder (Cerulean chamfered brick popup style used by Playnite generic popups) -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Keyboard FocusVisual: crisp Cerulean focus outline (keyboard navigation only) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2"
                            SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BrandMarkTemplate: original Studlock isometric 2x2 studded brick silhouette -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="64" Height="64">
                <Path Fill="{TemplateBinding Foreground}"
                      Data="F0 M32,9 L58,22 L58,43.5 L32,57 L6,43.5 L6,22 Z M32,13.4 L11.4,23.8 L32,34.2 L52.6,23.8 Z M10,27.4 L10,41.2 L30,51.6 L30,37.2 Z M54,27.4 L34,37.2 L34,51.6 L54,41.2 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M32,16.0 C34.8,16.0 37.0,17.1 37.0,18.5 C37.0,19.9 34.8,21.0 32,21.0 C29.2,21.0 27.0,19.9 27.0,18.5 C27.0,17.1 29.2,16.0 32,16.0 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M22.2,21.3 C25.0,21.3 27.2,22.4 27.2,23.8 C27.2,25.2 25.0,26.3 22.2,26.3 C19.4,26.3 17.2,25.2 17.2,23.8 C17.2,22.4 19.4,21.3 22.2,21.3 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M41.8,21.3 C44.6,21.3 46.8,22.4 46.8,23.8 C46.8,25.2 44.6,26.3 41.8,26.3 C39.0,26.3 36.8,25.2 36.8,23.8 C36.8,22.4 39.0,21.3 41.8,21.3 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M32,26.6 C34.8,26.6 37.0,27.7 37.0,29.1 C37.0,30.5 34.8,31.6 32,31.6 C29.2,31.6 27.0,30.5 27.0,29.1 C27.0,27.7 29.2,26.6 32,26.6 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M14.5,34.2 L25.5,39.9 L25.5,43.1 L14.5,37.4 Z M49.5,34.2 L38.5,39.9 L38.5,43.1 L49.5,37.4 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- DividerTemplate: 10px recessed channel with tiled molded circular ABS studs (DISPLAY/GRAPHICS separator) -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Border Height="10" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="3"
                SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.72"
                       OpacityMask="{DynamicResource LocalStudRowMaskBrush}" />
        </Border>
    </ControlTemplate>

    <!-- HeadingTextBlock style for game page section titles -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>

    <!-- SecondaryButton: 40x40 icon-only molded ABS slate button (More, Edit) matching PlayButton geometry -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Lip" Background="{DynamicResource FrameInnerBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <Border x:Name="Face" Margin="0,0,0,2.5" CornerRadius="4.5"
                                        Background="{TemplateBinding Background}" />
                                <Rectangle Height="1" Margin="3,1,3,0" VerticalAlignment="Top"
                                           Fill="{DynamicResource BevelLightBrush}" IsHitTestVisible="False" />
                                <Border x:Name="HoverOverlay" Margin="0,0,0,2.5" CornerRadius="4.5"
                                        Background="{DynamicResource SecondaryButtonHoverBackgroundBrush}"
                                        BorderBrush="{DynamicResource FrameHoverBrush}" BorderThickness="1"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="PressedOverlay" Margin="0,1,0,0" CornerRadius="4.5"
                                        Background="{DynamicResource SecondaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter Margin="0,0,0,2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecPressIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LocalNotesTextBox: read-only ABS slate notes surface -->
    <Style x:Key="LocalNotesTextBox" TargetType="TextBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource NormalBrushDark}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SteamScreenshotsSkeletonTemplate: brick-framed loading placeholder -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False">
            <Border Height="220" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource NormalBrushDark}"
                    BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1.5" Margin="0,0,0,8">
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.08"
                           OpacityMask="{DynamicResource LocalStudWallMaskBrush}" />
            </Border>
            <UniformGrid Columns="5" Height="56">
                <Border Margin="0,0,6,0" CornerRadius="{DynamicResource CornerRadiusSmall}" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" />
                <Border Margin="0,0,6,0" CornerRadius="{DynamicResource CornerRadiusSmall}" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" />
                <Border Margin="0,0,6,0" CornerRadius="{DynamicResource CornerRadiusSmall}" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" />
                <Border Margin="0,0,6,0" CornerRadius="{DynamicResource CornerRadiusSmall}" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" />
                <Border CornerRadius="{DynamicResource CornerRadiusSmall}" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" />
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- LocalEmptyBrickTemplate: one molded 2x3 brick (three studs on a body with a lower lip); Foreground paints it. -->
    <ControlTemplate x:Key="LocalEmptyBrickTemplate" TargetType="Control">
        <Grid Width="140" Height="62">
            <Border Width="30" Height="14" CornerRadius="7" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{TemplateBinding Foreground}" />
            <Border Width="30" Height="14" CornerRadius="7" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{TemplateBinding Foreground}" />
            <Border Width="30" Height="14" CornerRadius="7" Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{TemplateBinding Foreground}" />
            <Border Margin="0,10,0,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" BorderBrush="{DynamicResource NormalBrushDark}" BorderThickness="2">
                <Grid>
                    <Border VerticalAlignment="Bottom" Height="10" CornerRadius="0,0,4,4" Background="#55000000" />
                    <Border VerticalAlignment="Top" Height="12" Margin="6,4,6,0" CornerRadius="4" Background="{DynamicResource TextBrush}" Opacity="0.16" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- EmptyGameTemplate: Loading-screen dark interlocking tile mosaic + breathing Golden 2x2 Brick -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid Background="Transparent" IsHitTestVisible="False">
            <!-- Subtle molded stud baseplate backdrop in sparse empty state -->
            <Rectangle Fill="{DynamicResource TextBrush}" Opacity="0.045"
                       OpacityMask="{DynamicResource LocalStudWallMaskBrush}" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource NormalBrushDark}"
                    BorderBrush="{DynamicResource FrameBrush}" BorderThickness="2"
                    CornerRadius="{DynamicResource CornerRadiusLarge}"
                    Padding="44,30,44,28" MinWidth="380">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Studded violet accent bar across empty card top -->
                    <Border Height="6" Width="120" CornerRadius="3" Margin="0,0,0,18"
                            Background="{DynamicResource LocalVioletBrush}" HorizontalAlignment="Center">
                        <Rectangle Fill="{DynamicResource TextBrush}" Opacity="0.22"
                                   OpacityMask="{DynamicResource LocalStudRowMaskBrush}" />
                    </Border>
                    <Grid Width="260" Height="196" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Ellipse x:Name="EmptyHalo" Width="200" Height="26" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                 Fill="{DynamicResource HighlightGlyphBrush}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.OpacityMask>
                                <RadialGradientBrush><GradientStop Color="#FF000000" Offset="0" /><GradientStop Color="#00000000" Offset="1" /></RadialGradientBrush>
                            </Ellipse.OpacityMask>
                            <Ellipse.RenderTransform><ScaleTransform x:Name="EmptyHaloScale" ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Control x:Name="EmptyBrickLo" Template="{DynamicResource LocalEmptyBrickTemplate}" Foreground="{DynamicResource PrimaryButtonBackgroundBrush}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-18,0,0,14" Opacity="0"><Control.RenderTransform><TranslateTransform x:Name="EmptyBrickLoY" Y="-150" /></Control.RenderTransform></Control>
                        <Control x:Name="EmptyBrickMid" Template="{DynamicResource LocalEmptyBrickTemplate}" Foreground="{DynamicResource LocalVioletBrush}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="22,0,0,62" Opacity="0"><Control.RenderTransform><TranslateTransform x:Name="EmptyBrickMidY" Y="-150" /></Control.RenderTransform></Control>
                        <Control x:Name="EmptyBrickHi" Template="{DynamicResource LocalEmptyBrickTemplate}" Foreground="{DynamicResource FrameBrush}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-4,0,0,110" Opacity="0"><Control.RenderTransform><TranslateTransform x:Name="EmptyBrickHiY" Y="-150" /></Control.RenderTransform></Control>
                        <Path x:Name="EmptyPopA" Data="M 6,0 L 7.6,4.4 L 12,6 L 7.6,7.6 L 6,12 L 4.4,7.6 L 0,6 L 4.4,4.4 Z" Fill="{DynamicResource GlyphBrush}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,22,0,0" />
                        <Path x:Name="EmptyPopB" Data="M 6,0 L 7.6,4.4 L 12,6 L 7.6,7.6 L 6,12 L 4.4,7.6 L 0,6 L 4.4,4.4 Z" Fill="{DynamicResource DataChangeNotifBrush}" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,22,0" />
                    </Grid>
                    <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                               FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Black" FontStyle="Italic"
                               FontSize="26" Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                    <Control Margin="0,16,0,0" Width="220" Template="{DynamicResource DividerTemplate}"
                             Foreground="{DynamicResource LocalAxleRodBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
            <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyBrickBuild">
                        <Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyBrickLoY" Storyboard.TargetProperty="Y" Duration="0:0:6.0" RepeatBehavior="Forever"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-150" /><EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0"><EasingDoubleKeyFrame.EasingFunction><BounceEase EasingMode="EaseOut" Bounces="2" Bounciness="2.2" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><LinearDoubleKeyFrame KeyTime="0:0:5.4" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:5.45" Value="-150" /><LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="-150" /></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyBrickLo" Storyboard.TargetProperty="Opacity" Duration="0:0:6.0" RepeatBehavior="Forever"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:5.0" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:5.45" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="0" /></DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyBrickMidY" Storyboard.TargetProperty="Y" Duration="0:0:6.0" RepeatBehavior="Forever"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-150" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.9" Value="-150" /><EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0"><EasingDoubleKeyFrame.EasingFunction><BounceEase EasingMode="EaseOut" Bounces="2" Bounciness="2.2" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><LinearDoubleKeyFrame KeyTime="0:0:5.4" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:5.45" Value="-150" /><LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="-150" /></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyBrickMid" Storyboard.TargetProperty="Opacity" Duration="0:0:6.0" RepeatBehavior="Forever"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.9" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:5.0" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:5.45" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="0" /></DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyBrickHiY" Storyboard.TargetProperty="Y" Duration="0:0:6.0" RepeatBehavior="Forever"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-150" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.8" Value="-150" /><EasingDoubleKeyFrame KeyTime="0:0:2.7" Value="0"><EasingDoubleKeyFrame.EasingFunction><BounceEase EasingMode="EaseOut" Bounces="2" Bounciness="2.2" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><LinearDoubleKeyFrame KeyTime="0:0:5.4" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:5.45" Value="-150" /><LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="-150" /></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyBrickHi" Storyboard.TargetProperty="Opacity" Duration="0:0:6.0" RepeatBehavior="Forever"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.8" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:1.95" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:5.0" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:5.45" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="0" /></DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimation Storyboard.TargetName="EmptyHaloScale" Storyboard.TargetProperty="ScaleX" From="1" To="0.8" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyPopA" Storyboard.TargetProperty="Opacity" Duration="0:0:6.0" RepeatBehavior="Forever"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.95" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:3.7" Value="0" KeySpline="0.4,0,0.2,1" /><LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="0" /></DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyPopB" Storyboard.TargetProperty="Opacity" Duration="0:0:6.0" RepeatBehavior="Forever"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.95" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:4.3" Value="0" KeySpline="0.4,0,0.2,1" /><LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="0" /></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyBrickBuild" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
