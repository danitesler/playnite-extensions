<!--
    Studlock: DerivedStyles/PropertyItemButton.xaml.
    Default: Cerulean text link (brightening to Canary Yellow on hover).
    Tag="Chip" (on owning ItemsControl): Molded 1x2 ABS brick tile tag (CornerRadiusSmall=4px, ABS ink border,
    2px lower dark lip, left circular Cerulean stud pip) flipping to Canary Yellow with ABS ink on hover.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PropertyItemButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LinkText" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="Margin" Value="0,0,5,5" />
                <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ChipPlate" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Background="{DynamicResource PropertyItemBackgroundBrush}"
                                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1,1,1,2.5"
                                    Padding="7,2.5,8,2.5" SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ChipStud" Width="5" Height="5" Margin="0,0,5,0"
                                             Fill="{DynamicResource FrameHoverBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipPlate" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                                    <Setter TargetName="ChipPlate" Property="BorderBrush" Value="{DynamicResource LocalYellowLipBrush}" />
                                    <Setter TargetName="ChipStud" Property="Fill" Value="{DynamicResource SelectedForegroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
