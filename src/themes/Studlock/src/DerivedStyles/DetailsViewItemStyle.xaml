<!--
    Studlock: DerivedStyles/DetailsViewItemStyle.xaml (Details View Library Rows).
    - Hover (IsMouseOver): molded slate ABS brick plate + 3px Cerulean left stud-notch (110ms fade) + transparent
      RowHoverAction Play / Install icon with RowHoverRoom right padding (38px).
    - Click/Selection (IsSelected): LEGO Party! Canary Yellow (#FFE421) brick-seamed snap plate (ScaleX 0.90->1,
      150ms BackEase 0.16) + gold lower plastic lip + ABS ink rim + black-outlined golden triangle cursor sliding in
      + bold ABS ink label nudging +3px right.
    - RunningIndicator (AFTER hover & selection, BEFORE content): Equipped Brick Green (#198840) 2px frame + 1px dark
      ABS keyline + 0.16 wash + segmented vertical-brick launch scan + segmented foot fill + RunningMarkPlate +
      3 circular molded green studs inside 44px RowRoom.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Margin" Value="10,1.5,6,1.5" />
        <Setter Property="Padding" Value="10,6,10,6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="RowRoot" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Hover layer: molded slate ABS plate + 3px Cerulean left stud notch (collapsed at rest) -->
                        <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Background="{DynamicResource ListItemHoverBrush}"
                                    BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border x:Name="HoverNotch" Width="3" Margin="0,5,0,5" HorizontalAlignment="Left"
                                    CornerRadius="0,2,2,0" Background="{DynamicResource FrameHoverBrush}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="HoverNotchScaleY" ScaleY="0.2" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <!-- Selected layer: Canary Yellow brick-seamed snap plate + gold lower lip + ABS ink rim -->
                        <Grid x:Name="SelectedLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SelectedScaleX" ScaleX="0.90" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border Background="{DynamicResource LocalYellowLipBrush}"
                                    BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1.5"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Grid ClipToBounds="True">
                                    <Border Margin="0,0,0,2.5" CornerRadius="4" Background="{DynamicResource ListItemSelectedBrush}" />
                                    <Rectangle Margin="0,0,0,2.5" Fill="{DynamicResource FrameInnerBrush}" Opacity="0.2"
                                               OpacityMask="{DynamicResource LocalBrickSeamsMaskBrush}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Floating black-outlined golden triangle cursor on selected row's left edge -->
                        <Path x:Name="SelectedCursor" Data="{DynamicResource LocalCursorRightGeometry}"
                              Width="11" Height="13" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,1"
                              Fill="{DynamicResource LocalCursorGoldBrush}"
                              Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Path.RenderTransform>
                                <TranslateTransform x:Name="CursorSlideX" X="-7" />
                            </Path.RenderTransform>
                        </Path>

                        <!-- Running / Launching Equipped Brick Green Indicator (AFTER hover & selection, BEFORE content) -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.94" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.16"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <!-- Faded green backing strip behind the 3 circular studs -->
                            <Border x:Name="RunningMarkPlate" Width="44" HorizontalAlignment="Right" Margin="2"
                                    CornerRadius="0,4,4,0" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.36">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <!-- Segmented vertical-brick launching sweep -->
                            <Grid x:Name="RunningScanHost" Visibility="Collapsed"
                                  OpacityMask="{DynamicResource LocalBrickTicksMaskBrush}">
                                <Border x:Name="RunningScan" Background="{DynamicResource LocalGreenBrightBrush}" Opacity="0.54"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.42" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                            <!-- Segmented green foot track -->
                            <Grid Height="2" Margin="5,0,5,3" VerticalAlignment="Bottom"
                                  OpacityMask="{DynamicResource LocalBrickTicksMaskBrush}">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.32" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalGreenBrightBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <!-- 2px Equipped Brick Green frame with 1px dark ABS keyline inside -->
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1" Opacity="0.72"
                                        CornerRadius="{DynamicResource CornerRadiusSmall}" />
                            </Border>
                            <!-- 3 molded circular green studs at the far right edge -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse x:Name="RowStud1" Width="6" Height="6" Margin="0,0,3,0"
                                         Fill="{DynamicResource LocalGreenBrightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1"
                                         Opacity="0.55">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="RowStud1Y" Y="0" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="RowStud2" Width="6" Height="6" Margin="0,0,3,0"
                                         Fill="{DynamicResource LocalGreenBrightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1"
                                         Opacity="0.7">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="RowStud2Y" Y="0" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="RowStud3" Width="6" Height="6"
                                         Fill="{DynamicResource LocalGreenBrightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1"
                                         Opacity="0.55">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="RowStud3Y" Y="0" /></Ellipse.RenderTransform>
                                </Ellipse>
                            </StackPanel>
                        </Grid>

                        <!-- Content Host inside RowRoom (RunningIndicator) + RowHoverRoom (RowHoverAction) -->
                        <Border x:Name="RowRoom" Padding="0">
                            <Border x:Name="RowHoverRoom" Padding="0">
                                <ContentPresenter x:Name="ContentHost" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="ContentSlideX" X="0" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Border>

                        <!-- RowHoverAction: transparent Play / Install hover glyphs inheriting row Foreground -->
                        <Button x:Name="RowHoverPlay" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                Width="26" Height="26" MinWidth="26" MinHeight="26" Padding="0" Focusable="False" Cursor="Hand"
                                Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}"
                                ToolTip="{DynamicResource LOCPlayGame}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                        Foreground="{TemplateBinding Foreground}" Focusable="False" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Width" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Height" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="RowHoverInstall" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                Width="26" Height="26" MinWidth="26" MinHeight="26" Padding="0" Focusable="False" Cursor="Hand"
                                Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}"
                                ToolTip="{DynamicResource LOCInstallGame}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl Content="{DynamicResource IconDownload}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                        Foreground="{TemplateBinding Foreground}" Focusable="False" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Width" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Height" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="HoverNotchScaleY" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.18" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="HoverNotchScaleY" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowSelectIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedCursor" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedScaleX" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.16" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelectedCursor" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="CursorSlideX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.22" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ContentSlideX" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowSelectOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedScaleX" Storyboard.TargetProperty="ScaleX" To="0.90" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedCursor" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CursorSlideX" Storyboard.TargetProperty="X" To="-7" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="ContentSlideX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedCursor" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- LAUNCHING trigger -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScanHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,44,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.42" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.42" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.42" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.422" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.422" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowStud1Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="-3.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowStud1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowStud2Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="-3.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowStud2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowStud3Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-3.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowStud3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING trigger -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,44,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowStud1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowStud2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.65" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowStud3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
