<!--
    Studlock: DerivedStyles/GridViewItemStyle.xaml (Grid View Cover Tiles).
    LEGO Party! Wardrobe tile language:
    - Hover (IsMouseOver): smooth cover lift (Scale 1.024, 140ms) + Cerulean brick outline (GridViewItemHoverBorderBrush).
    - Click/Selection (IsSelected): solid 3px Canary Yellow Wardrobe frame + crisp white inner keyline + lower gold lip
      + floating black-outlined golden downward triangle cursor dropping cleanly onto top center edge (BackEase 0.22).
    - RunningIndicator (AFTER hover & selection, inset Margin=4 so it remains bright inside the yellow selected frame):
      2px Equipped Brick Green frame + inner soft green band + segmented launch sweep + 16px dark foot tape holding
      segmented green foot bar and 3 circular molded green studs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Margin="{Settings ItemSpacingMargin}" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <ContentPresenter />

                        <!-- Hover Cerulean Brick frame (collapsed at rest) -->
                        <Border x:Name="HoverFrame" Margin="-2" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" BorderThickness="2"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                        <!-- Selected Wardrobe Canary Yellow molded frame + white inner keyline + top downward triangle cursor -->
                        <Grid x:Name="SelectedChrome" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Margin="-3" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                    BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" BorderThickness="3">
                                <Border BorderBrush="{DynamicResource TextBrush}" BorderThickness="1" CornerRadius="5" />
                            </Border>
                            <Path x:Name="TopCursor" Data="{DynamicResource LocalCursorDownGeometry}"
                                  Width="15" Height="11" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-9,0,0"
                                  Fill="{DynamicResource LocalCursorGoldBrush}"
                                  Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1.7" StrokeLineJoin="Round">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="CursorDropY" Y="-6" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>

                        <!-- Running / Launching Indicator (AFTER hover & selection, inset 4px inside the cover) -->
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.94"
                              IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <!-- Inner soft green edge band -->
                            <Border x:Name="RunningWash" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="6"
                                    Opacity="0.22" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <!-- Segmented vertical-brick launching sweep across cover -->
                            <Grid x:Name="RunningScanHost" Visibility="Collapsed"
                                  OpacityMask="{DynamicResource LocalBrickTicksMaskBrush}">
                                <Border x:Name="RunningScan" Background="{DynamicResource LocalGreenBrightBrush}" Opacity="0.44"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.42" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                            <!-- 2px Equipped Brick Green frame -->
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1" Opacity="0.65"
                                        CornerRadius="{DynamicResource CornerRadiusSmall}" />
                            </Border>
                            <!-- 16px dark foot tape holding segmented fill bar & 3 circular green studs -->
                            <Border Height="16" Margin="2" VerticalAlignment="Bottom"
                                    CornerRadius="0,0,4,4" Background="{DynamicResource ScrimBrush}" Opacity="0.86">
                                <Grid Margin="6,0,6,0">
                                    <Grid Height="3" Margin="0,0,34,0" VerticalAlignment="Center"
                                          OpacityMask="{DynamicResource LocalBrickTicksMaskBrush}">
                                        <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                                        <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalGreenBrightBrush}" RenderTransformOrigin="0,0.5">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse x:Name="CovStud1" Width="6" Height="6" Margin="0,0,3,0"
                                                 Fill="{DynamicResource LocalGreenBrightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1"
                                                 Opacity="0.55">
                                            <Ellipse.RenderTransform><TranslateTransform x:Name="CovStud1Y" Y="0" /></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse x:Name="CovStud2" Width="6" Height="6" Margin="0,0,3,0"
                                                 Fill="{DynamicResource LocalGreenBrightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1"
                                                 Opacity="0.7">
                                            <Ellipse.RenderTransform><TranslateTransform x:Name="CovStud2Y" Y="0" /></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse x:Name="CovStud3" Width="6" Height="6"
                                                 Fill="{DynamicResource LocalGreenBrightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1"
                                                 Opacity="0.55">
                                            <Ellipse.RenderTransform><TranslateTransform x:Name="CovStud3Y" Y="0" /></Ellipse.RenderTransform>
                                        </Ellipse>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Panel.ZIndex" Value="5" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CoverHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.024" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.16" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.024" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.16" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CoverHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="6" />
                            <Setter TargetName="HoverFrame" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CoverSelectIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedChrome" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedChrome" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CursorDropY" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.24" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CoverSelectOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedChrome" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="CursorDropY" Storyboard.TargetProperty="Y" To="-6" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedChrome" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScanHost" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.42" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.42" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.42" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.422" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.422" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovStud1Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="-3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovStud2Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="-3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovStud3Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovStud1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovStud2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.65" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovStud3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
