<!--
    Studlock: DerivedStyles/PlayButton.xaml (PlayButton + RunningActionIndicator).
    Hero Play Button: molded Canary Yellow (#FFE421) brick-seamed slab (ControlCornerRadius=6px) with 2px ABS ink rim,
    3px lower gold lip, vertical modular brick joints, and bold-italic ABS ink label.
    - Hover: fades lit yellow plate + yellow rim glow + diagonal white glossy plastic sheen sweep (brick-sheen.png)
      while snapping the black-outlined golden triangle cursor in from left (BackEase 0.2, 150ms).
    - Press: separate PressedPlate depresses cleanly onto the lip (90ms).
    - Launching / Running: plate keeps its exact molded shape in Equipped Brick Green (#198840) with crisp white label
      (>= 4.53:1 un-scrimmed, 6.1-9.2:1 under RunningBreath scrim). Launching runs a segmented vertical-brick scan sweep
      (brick-ticks.png) + filling segmented foot bar + 3 circular green studs popping sequentially. Running breathes
      quietly via RunningBreath (0.22-0.42, 3.0s) with staggered green stud idle; hovering the button itself
      (RelativeSource Self) darkens via RunningHoverDim and swaps label to Cancel without resizing (PlayContent=Hidden).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinWidth" Value="156" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="18,0,18,0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="16.5" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Soft outer Canary Yellow hover rim halo (parent IdleGlowHost collapsed while launching/running) -->
                        <Grid x:Name="IdleGlowHost" IsHitTestVisible="False">
                            <Border x:Name="GlowBorder" Margin="-3" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                    BorderBrush="{DynamicResource PrimaryButtonGlowBrush}" BorderThickness="3"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        </Grid>

                        <!-- Outer ABS ink frame + molded lower plastic lip -->
                        <Border x:Name="LipBorder"
                                Background="{DynamicResource LocalYellowLipBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <!-- Solid molded brick face (sits 3px above lower lip) -->
                                <Border x:Name="PlayPlate" Margin="0,0,0,3" CornerRadius="4"
                                        Background="{TemplateBinding Background}" />

                                <!-- Top 1px glossy ABS catchlight -->
                                <Rectangle Height="1.5" Margin="3,1,3,0" VerticalAlignment="Top"
                                           Fill="{DynamicResource BevelLightBrush}" IsHitTestVisible="False" />

                                <!-- Vertical modular brick-joint seams across the face -->
                                <Rectangle Margin="0,0,0,3" Fill="{DynamicResource FrameInnerBrush}" Opacity="0.2"
                                           OpacityMask="{DynamicResource LocalBrickSeamsMaskBrush}" IsHitTestVisible="False" />

                                <!-- Idle hover host (collapsed by IsLaunching/IsRunning so PlayHoverIn never paints yellow over green) -->
                                <Grid x:Name="IdleHoverHost" IsHitTestVisible="False">
                                    <!-- Idle hover lit yellow plate -->
                                    <Border x:Name="HoverPlate" Margin="0,0,0,3" CornerRadius="4"
                                            Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                            Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                        <Rectangle Fill="{DynamicResource FrameInnerBrush}" Opacity="0.2"
                                                   OpacityMask="{DynamicResource LocalBrickSeamsMaskBrush}" />
                                    </Border>

                                    <!-- Diagonal glossy ABS specular sheen sweep on hover -->
                                    <Rectangle x:Name="SheenLayer" Margin="0,0,0,3"
                                               Fill="{DynamicResource TextBrush}" Opacity="0" Visibility="Collapsed"
                                               OpacityMask="{DynamicResource LocalBrickSheenMaskBrush}" IsHitTestVisible="False">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="SheenSlide" X="-120" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>

                                <!-- Separate pressed depression layer -->
                                <Border x:Name="PressedPlate" Margin="0,1,0,0" CornerRadius="4"
                                        Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- RunningBreath scrim (darkens green plate during launching & running; never fades plate) -->
                                <Border x:Name="RunningBreath" CornerRadius="4"
                                        Background="{DynamicResource ScrimBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- RunningScan: segmented vertical-brick progress sweep during launching -->
                                <Grid x:Name="RunningScanHost" Visibility="Collapsed" IsHitTestVisible="False"
                                      OpacityMask="{DynamicResource LocalBrickTicksMaskBrush}">
                                    <Border x:Name="RunningScan" CornerRadius="4"
                                            Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.82">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                                <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                                <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                </Grid>

                                <!-- RunningHoverDim: second scrim faded in ONLY with Cancel label (below label) -->
                                <Border x:Name="RunningHoverDim" CornerRadius="4"
                                        Background="{DynamicResource ScrimBrush}"
                                        Opacity="0" IsHitTestVisible="False" />

                                <!-- Content room: reserves 34px right strip during launching/running so 3 studs never touch text -->
                                <!-- RunningMarkRoom left="0" right="34" -->
                                <Border x:Name="PlayRoom" Margin="0,0,0,2" Padding="0">
                                    <StackPanel x:Name="PlayContent" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}">
                                        <ContentControl x:Name="PlayGlyph" Margin="0,0,8,0"
                                                        Content="{DynamicResource IconPlay}"
                                                        ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{TemplateBinding Foreground}"
                                                        VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False" />
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                    </StackPanel>
                                </Border>

                                <!-- Cancel label: shown ONLY while IsRunning=True AND button itself IsMouseOver=True -->
                                <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,0,34,2"
                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                           FontSize="16" FontWeight="Black" FontStyle="Italic"
                                           Foreground="{DynamicResource DangerForegroundBrush}"
                                           Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <!-- Floating black-outlined golden triangle cursor snapping in on left edge on idle Play hover -->
                        <Grid x:Name="IdleCursorHost" IsHitTestVisible="False">
                            <Path x:Name="PlayCursor" Data="{DynamicResource LocalCursorRightGeometry}"
                                  Width="13" Height="15" Stretch="Uniform"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,2"
                                  Fill="{DynamicResource LocalCursorGoldBrush}"
                                  Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="PlayCursorSlide" X="-8" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Idle Play hover animation (glossy plastic sheen + golden cursor snap) -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SheenLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlayCursor" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="PlayCursor" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PlayCursorSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.22" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SheenLayer" Storyboard.TargetProperty="Opacity" From="0" To="0.58" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SheenSlide" Storyboard.TargetProperty="X" From="-110" To="24" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="SheenLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="PlayCursor" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="PlayCursorSlide" Storyboard.TargetProperty="X" To="-8" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.24" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SheenLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlayCursor" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Separate pressed plate trigger -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayPressIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- LAUNCHING state: solid Equipped Brick Green plate + segmented brick sweep -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                            <Setter TargetName="LipBorder" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleGlowHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleCursorHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScanHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity"
                                                         From="0.34" To="0.54" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.42" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.42" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.42" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.422" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.422" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING state: solid Equipped Brick Green plate + quiet RunningBreath idle pulse -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                            <Setter TargetName="LipBorder" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleGlowHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleCursorHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.22" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.22" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING + hover ON THE BUTTON ITSELF (RelativeSource Self): Cancel without resize -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="PlayCancelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RunningActionIndicator: overlaid on the game page Play / ContextAction cell -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.94" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <!-- Subtle overlay wash (<= 0.12 so white label contrast stays high) -->
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.1"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <!-- 1.5px RunningFrame copying PlayButton's exact corner radius -->
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <!-- Segmented brick foot track 4px above bottom -->
                        <Grid Height="3" Margin="6,0,6,4" VerticalAlignment="Bottom"
                              OpacityMask="{DynamicResource LocalBrickTicksMaskBrush}">
                            <Rectangle Fill="{DynamicResource LocalGreenBrightBrush}" Opacity="0.3" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalGreenBrightBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <!-- 3 molded circular green brick studs in the reserved 34px right strip -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,2">
                            <Ellipse x:Name="ActStud1" Width="6" Height="6" Margin="0,0,3,0"
                                     Fill="{DynamicResource LocalGreenBrightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1"
                                     Opacity="0.55" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="ActStud1Y" Y="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="ActStud2" Width="6" Height="6" Margin="0,0,3,0"
                                     Fill="{DynamicResource LocalGreenBrightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1"
                                     Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="ActStud2Y" Y="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="ActStud3" Width="6" Height="6"
                                     Fill="{DynamicResource LocalGreenBrightBrush}" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1"
                                     Opacity="0.55" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="ActStud3Y" Y="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <!-- 3 circular green studs pop sequentially as the brick sweep lands -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActStud1Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="-3.5" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActStud1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActStud2Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="-3.5" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActStud2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActStud3Y" Storyboard.TargetProperty="Y" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-3.5" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActStud3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActStud1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActStud2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.6" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActStud3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
