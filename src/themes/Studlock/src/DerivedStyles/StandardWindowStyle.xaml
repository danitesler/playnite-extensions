<!--
    Studlock: DerivedStyles/StandardWindowStyle.xaml.
    44px Studded Stage Violet title band (CaptionHeight=44 == ContentPresenter top margin 44),
    bearing the centered violet trapezoid echo, subtle circular stud relief, ghosted 2x2 brick brand mark,
    22px Canary Yellow brick mark before Nunito Black Italic title, and 2px Cerulean closing rail.
    WindowSettings trigger sets PART_TextTitle to LOCSettingsLabel directly (no duplicate hidden copy).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource FrameBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Dialog body pushed strictly by CaptionHeight=44 -->
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px Studded Stage Violet title band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}" ClipToBounds="True">
                                    <!-- Circular molded stud relief across the violet header band -->
                                    <Rectangle Fill="{DynamicResource WindowTitleForegroundBrush}" Opacity="0.14"
                                               OpacityMask="{DynamicResource LocalStudWallMaskBrush}" IsHitTestVisible="False" />

                                    <!-- Centered trapezoid highlight & ghosted brand mark in a zero-desired-size Canvas -->
                                    <Canvas IsHitTestVisible="False">
                                        <Path Fill="{DynamicResource LocalVioletLitBrush}" Opacity="0.28"
                                              Data="M 220,0 L 680,0 L 656,44 L 244,44 Z" />
                                    </Canvas>
                                    <Control Width="64" Height="64" Margin="0,-10,148,0"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Template="{DynamicResource BrandMarkTemplate}"
                                             Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                             Opacity="0.11" IsHitTestVisible="False" />

                                    <!-- Bottom 2px Cerulean Brick closing rail -->
                                    <Rectangle Height="2" VerticalAlignment="Bottom"
                                               Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />

                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,2">
                                            <Control Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Template="{DynamicResource BrandMarkTemplate}"
                                                     Foreground="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                                            <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontWeight="Black" FontStyle="Italic"
                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowDesignStyle" TargetType="WindowBase" BasedOn="{StaticResource StandardWindowStyle}" />
</ResourceDictionary>
