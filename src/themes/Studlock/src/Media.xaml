<!--
    Studlock: Media.xaml.
    Bespoke chunky toy-brick vector geometries authored in Studlock's bold interlocking ABS silhouette style
    (24x24 canvas, heavy crisp strokes & modular brick blocks). Menu item icons are the theme's own PNG set (art/menu-icons.json, docs/themes/menu-icons.md).
-->
<ResourceDictionary xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Uniform scaling IconTemplate fitting smallest host up to IconSize -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox MaxWidth="{DynamicResource IconSize}" MaxHeight="{DynamicResource IconSize}" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox MaxWidth="12" MaxHeight="12" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

