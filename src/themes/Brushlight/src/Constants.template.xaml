<!--
    Brushlight: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json); each placeholder names the token that plays the key's role.
    Painted smoke and charcoal plates: void is the page and frame, plate the charcoal rows and buttons, card the plum-black
    description cards and popups. Plum is selection, cream the capitals and accents, ochre the paint smear and active marks,
    blood the danger red, lumina the running cyan (nothing else uses it).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Typography: Cinzel capitals for titles and headings (bundled), Palatino Linotype body (Windows), Oswald numerals (bundled). -->
    <sys:Double x:Key="FontSizeSmall">{{px:size-caption}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:size-body}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:size-lead}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:size-title}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:size-display}}</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Palatino Linotype}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Cinzel, {{text:font-heading|Cinzel}}</FontFamily>
    <FontFamily x:Key="LocalNumeralFontFamily">./Typography/#Oswald, {{text:font-numeral|Oswald}}</FontFamily>
    <!-- Metadata width defaults (usable content, inside the pane's padding and frame). -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>
    <!-- Shape: hairlines, a 1.5px broken brush rim on plates, 2-4px corners on the few square things (key prompts, frames). -->
    <Thickness x:Key="PopupBorderThickness">{{px:stroke-hair}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:stroke-hair}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:stroke-hair}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:corner-medium}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:corner-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:corner-large}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{white}}</Color>
    <Color x:Key="TextColorDarker">{{muted}}</Color>
    <Color x:Key="TextColorDark">{{ink}}</Color>
    <Color x:Key="MainColor">{{plate}}</Color>
    <Color x:Key="MainColorDark">{{void}}</Color>
    <Color x:Key="HoverColor">{{glass-bright}}</Color>
    <Color x:Key="GlyphColor">{{cream}}</Color>
    <Color x:Key="HighlightGlyphColor">{{cream/35}}</Color>
    <Color x:Key="PopupBackgroundColor">{{card}}</Color>
    <Color x:Key="PopupBorderColor">{{bronze}}</Color>
    <Color x:Key="BackgroundToneColor">{{plate-deep}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{plate/75}}</Color>   <!-- the slot behind each cover -->
    <Color x:Key="PanelSeparatorColor">{{bronze}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{bronze}}</Color>
    <Color x:Key="DataChangeNotifColor">{{ochre}}</Color>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <!-- Banner darkening color: the plum-black of the character select cards, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{card}}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{rim-dim}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{card}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{ochre-lit}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{coral}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{cream-dim}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{ochre}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{void}}" />
    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->
    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{plate-lit}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{{plum}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{plum-lit}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{lumina}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{plum}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{plum}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{blood}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{plate-lit}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{plate-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{plum}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{plum-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{card-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{plum}}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{plate-deep}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{rim}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{rim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{plate-lit}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{hp-deep}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{rim-dim}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{cream-dim}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{plate-deep/70}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{rim-dim}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{rim-dim}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{rim}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{plum}}" />
    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{bronze-lit}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{rim-dim}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{rim}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{rim-dim}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{bronze}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{rim-dim}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{bronze}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{bronze-lit}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{rim-dim}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{cream-dim}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{bronze-lit}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{rim-dim}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{bronze}}" />
    <!-- Theme-only: the paint, the plates and the lettering (Local prefix = no ThemeModifier entry, no shared meaning). -->
    <SolidColorBrush x:Key="LocalVoidBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="LocalSmokeBrush" Color="{{smoke}}" />
    <SolidColorBrush x:Key="LocalPlateBrush" Color="{{plate}}" />
    <SolidColorBrush x:Key="LocalPlateDeepBrush" Color="{{plate-deep}}" />
    <SolidColorBrush x:Key="LocalPlateLitBrush" Color="{{plate-lit}}" />
    <SolidColorBrush x:Key="LocalCardBrush" Color="{{card}}" />
    <SolidColorBrush x:Key="LocalCardLitBrush" Color="{{card-lit}}" />
    <SolidColorBrush x:Key="LocalBronzeBrush" Color="{{bronze}}" />
    <SolidColorBrush x:Key="LocalBronzeLitBrush" Color="{{bronze-lit}}" />
    <SolidColorBrush x:Key="LocalPlumBrush" Color="{{plum}}" />
    <SolidColorBrush x:Key="LocalPlumLitBrush" Color="{{plum-lit}}" />
    <SolidColorBrush x:Key="LocalPlumRimBrush" Color="{{plum-rim}}" />
    <SolidColorBrush x:Key="LocalCreamBrush" Color="{{cream}}" />
    <SolidColorBrush x:Key="LocalCreamDimBrush" Color="{{cream-dim}}" />
    <SolidColorBrush x:Key="LocalWhiteBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="LocalMutedBrush" Color="{{muted}}" />
    <SolidColorBrush x:Key="LocalRimBrush" Color="{{rim}}" />
    <SolidColorBrush x:Key="LocalRimDimBrush" Color="{{rim-dim}}" />
    <SolidColorBrush x:Key="LocalInkBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="LocalOchreBrush" Color="{{ochre}}" />
    <SolidColorBrush x:Key="LocalOchreLitBrush" Color="{{ochre-lit}}" />
    <SolidColorBrush x:Key="LocalOchreDeepBrush" Color="{{ochre-deep}}" />
    <SolidColorBrush x:Key="LocalGiltBrush" Color="{{gilt}}" />
    <SolidColorBrush x:Key="LocalHpBrush" Color="{{hp}}" />
    <SolidColorBrush x:Key="LocalHpDeepBrush" Color="{{hp-deep}}" />
    <SolidColorBrush x:Key="LocalBloodBrush" Color="{{blood}}" />
    <SolidColorBrush x:Key="LocalCoralBrush" Color="{{coral}}" />
    <SolidColorBrush x:Key="LocalLuminaBrush" Color="{{lumina}}" />
    <SolidColorBrush x:Key="LocalLuminaDeepBrush" Color="{{lumina-deep}}" />
    <SolidColorBrush x:Key="LocalLuminaWashBrush" Color="{{lumina/20}}" />
    <SolidColorBrush x:Key="LocalTealDeepBrush" Color="{{teal-deep}}" />
    <SolidColorBrush x:Key="LocalGlassBrush" Color="{{glass}}" />
    <SolidColorBrush x:Key="LocalGlassBrightBrush" Color="{{glass-bright}}" />
    <SolidColorBrush x:Key="LocalScrimBrush" Color="{{scrim}}" />
</ResourceDictionary>
