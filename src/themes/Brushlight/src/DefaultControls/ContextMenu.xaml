<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu,
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is one panel: Clair Obscur's description card (the Camera Shake / Festival Token panels).
    Panel lever: LocalMenuPanelTemplate, a plum-black card (PopupBackgroundBrush) in a bronze hairline with cream corner ticks at
    the top left and bottom right, crowned by a 7px strip of the bronze Art Deco lattice that fades out to the right.
    Shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml.
    Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" />
            <Rectangle Height="7" Margin="1,1,1,0" VerticalAlignment="Top" Fill="{DynamicResource LocalBronzeLitBrush}" Opacity="0.7"
                       OpacityMask="{DynamicResource LocalLatticeMask}" />
            <Rectangle Height="7" Margin="1,1,1,0" VerticalAlignment="Top" Fill="{DynamicResource PopupBackgroundBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="0.25" Color="#00000000" />
                        <GradientStop Offset="0.85" Color="#FF000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" Margin="1,8,1,0" VerticalAlignment="Top" Fill="{DynamicResource LocalBronzeBrush}" />
            <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource LocalCreamBrush}" Focusable="False" IsTabStop="False" />
        </Grid>
    </ControlTemplate>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="232" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,12,0,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="6,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
