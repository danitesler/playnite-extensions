<!--
    Brushlight: Button. The merchant screen's bottom buttons (Buy Item / Fight Merchant / Back): a trapezoid plate, wider at the top
    (LocalTrapTemplate), charcoal with a broken dry-brush rim. Hover lifts the plate to plate-lit, brightens the rim and turns the label
    cream (120ms); pressed sinks to plate-deep and nudges the label 1px down. The default button (Save, OK) is the selected tab:
    plum fill, bright rim, cream label. Keeps Default's Width == 41 trigger for ThemeModifier's icon buttons (32x32 by layout scaling).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" /> <!-- fixed-width buttons (ThemeModifier icon buttons) keep their glyph unclipped; auto-width ones get the padding below -->
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True" Background="Transparent">
                        <Control x:Name="Plate" Template="{DynamicResource LocalTrapTemplate}" Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}" Focusable="False" IsTabStop="False" />
                        <Control x:Name="HoverPlate" Opacity="0" Template="{DynamicResource LocalTrapTemplate}" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                 BorderBrush="{DynamicResource LocalRimBrush}" Focusable="False" IsTabStop="False" />
                        <Control x:Name="PressedPlate" Opacity="0" Template="{DynamicResource LocalTrapTemplate}" Background="{DynamicResource ButtonPressedBackgroundBrush}"
                                 BorderBrush="{DynamicResource LocalRimBrush}" Focusable="False" IsTabStop="False" />
                        <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ButtonHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ButtonHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedPlate" Property="Opacity" Value="1" />
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="HoverPlate" Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="PressedPlate" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <!-- ThemeModifier icon buttons: the plugin sets Width=41 on them (editor and constants tabs).
                 Render at 32x32 via uniform 32/41 layout scaling, including glyphs and decoration; auto-width buttons keep ButtonPadding. -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Width" Value="NaN">
                <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource LocalWhiteBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
