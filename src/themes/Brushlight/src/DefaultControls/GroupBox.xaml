<!--
    Brushlight: GroupBox, the Statistics page's card and the settings groups. Clair Obscur's description card (Camera Shake, Colour of Lumina):
    a content-sized plum-black card (LocalCardTemplate, LocalCardBrush) in a bronze hairline with cream corner
    ticks at the top left and bottom right, the title centered in cream Cinzel capitals. No fixed widths: the card sizes to its content.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource LocalCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalCardTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                 Foreground="{DynamicResource LocalCreamBrush}" Focusable="False" IsTabStop="False" />
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <StackPanel x:Name="HeaderHost" DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                <TextBlock Style="{DynamicResource HeadingTextBlock}" HorizontalAlignment="Center" TextAlignment="Center">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </TextBlock>
                            </StackPanel>
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderHost" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
