<!--
    Brushlight: SearchBox. A Clair Obscur settings field: the charcoal plate with an arrow point on the left and a slanted cut on the
    right (LocalPlateTemplate, InputBackgroundBrush fill, InputBorderBrush broken rim). Hover brightens the rim, keyboard focus turns it
    cream. The magnifier lives outside PART_SeachIcon so it stays while typing: muted when empty, cream when focused or filled.
    Keeps PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon. Brushes: InputBackgroundBrush, InputBorderBrush,
    InputHoverBorderBrush, GlyphBrush, TextBrushDarker. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid x:Name="Field" Background="Transparent">
                        <Control x:Name="Plate" Template="{DynamicResource LocalPlateTemplate}" Background="{DynamicResource InputBackgroundBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" Focusable="False" IsTabStop="False" />
                        <ContentControl x:Name="Glyph" Focusable="False" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{DynamicResource GlyphBrush}" Margin="15,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" />
                        <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                        <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                 Padding="38,0,30,0" VerticalContentAlignment="Center" />
                        <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,12,0" Cursor="Hand"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ContentControl.Template>
                                <ControlTemplate TargetType="ContentControl">
                                    <Border Background="Transparent">
                                        <ContentPresenter ContentSource="Content" />
                                    </Border>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <!-- Keep the magnifier visible while Playnite hides its placeholder. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
