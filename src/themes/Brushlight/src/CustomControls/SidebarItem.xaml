<!--
    Brushlight: SidebarItem. A 44x40 cell with a 16px hairline glyph. Idle glyphs are muted; hover fades in a charcoal lozenge (an
    inventory tab) and brightens the glyph. Current: a plum lozenge with a bright broken rim slides in from the rail's outer edge
    (10px, 200 ms power ease) behind a cream glyph. Fixed 14,12 padding sizes the glyph; IconPadding is not added on top (it would
    collapse the Viewbox). Library and Statistics use the theme's glyphs. Colors: SidebarItemForegroundBrush,
    SidebarItemSelectedForegroundBrush, TopPanelItemHoverBackgroundBrush, SelectedBrush. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="Plate" Width="32" Height="32" SnapsToDevicePixels="True" Background="{TemplateBinding Background}" />
                        <!-- Hover: a charcoal lozenge. -->
                        <Control x:Name="HoverPlate" Width="38" Height="28" Template="{DynamicResource LocalLozengeTemplate}" Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                 BorderBrush="{DynamicResource LocalRimDimBrush}" Opacity="0" IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                        <!-- Current: a plum lozenge slides in from the rail's outer edge. -->
                        <Grid x:Name="Marks" Visibility="Collapsed" IsHitTestVisible="False" Width="38" Height="28" HorizontalAlignment="Center" SnapsToDevicePixels="True">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="MarkShift" X="0" />
                            </Grid.RenderTransform>
                            <Control Template="{DynamicResource LocalLozengeTemplate}" Background="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource LocalRimBrush}" Focusable="False" IsTabStop="False" />
                        </Grid>
                        <Border x:Name="GlyphHost" Padding="14,12" Margin="0,0,2,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="GlyphShift" X="0" />
                            </Border.RenderTransform>
                            <Viewbox x:Name="ItemIcon">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                        </Border>
                        <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                        Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ContentTemplate="{DynamicResource IconTemplate}" />
                        <ProgressBar x:Name="PART_ProgressStatus" Height="2" Margin="10,0,10,2" BorderThickness="0" Background="Transparent"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Hidden" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Marks" />
                                                        <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MarkShift" Storyboard.TargetProperty="X" From="-10" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <PowerEase Power="3" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Marks" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="GlyphShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GlyphShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
