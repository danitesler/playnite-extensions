<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Brushlight shared pieces, drawn from Clair Obscur: Expedition 33's camp menus (RESEARCH.md).
        Plates: a charcoal fill and a 1.5px white rim broken by a dry-brush grain (chalk.png as OpacityMask). Three silhouettes:
          LocalPlateTemplate     arrow point on the left, slanted cut on the right (settings rows, item rows, search, combo)
          LocalLozengeTemplate   pointed at both ends (inventory tabs, chips, toggled view switches)
          LocalTrapTemplate      wider at the top (Buy Item / Fight Merchant / Back buttons)
          LocalRectPlateTemplate square, for text you type into
        Hosts are plain Controls behind the content: Background = fill, BorderBrush = rim.
        Paint sprites (art/sprites.py, white masks): stroke (combat command), smear (ochre splatter), brush-foot (banner dissolve),
        lattice (Art Deco bronze), chalk (the rim grain).
    -->
    <ImageBrush x:Key="LocalChalkMask" ImageSource="{ThemeFile 'Images/fx/chalk.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,128,128" Stretch="Fill" />
    <ImageBrush x:Key="LocalLatticeMask" ImageSource="{ThemeFile 'Images/fx/lattice.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,48,48" Stretch="Fill" />
    <ImageBrush x:Key="LocalStrokeMask" ImageSource="{ThemeFile 'Images/fx/stroke.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalSmearMask" ImageSource="{ThemeFile 'Images/fx/smear.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalBrushFootMask" ImageSource="{ThemeFile 'Images/fx/brush-foot.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,1024,120" Stretch="Fill" />

    <!-- Settings row / item row: arrow point left (10px), slanted cut right (7px). -->
    <ControlTemplate x:Key="LocalPlateTemplate" TargetType="{x:Type Control}">
        <Canvas IsHitTestVisible="False">
            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Margin="0,0,-0.6,0" Stretch="Fill" Data="M1,0 L1,1 L0,0.5 Z" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Background}" />
            <Path Grid.Column="2" Margin="-0.6,0,0,0" Stretch="Fill" Data="M0,0 L1,0 L0,1 Z" Fill="{TemplateBinding Background}" />
            <Grid Grid.ColumnSpan="3" OpacityMask="{DynamicResource LocalChalkMask}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Stretch="Fill" Data="M1,0 L0,0.5 L1,1" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" />
                <Border Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1.5,0,1.5" />
                <Path Grid.Column="2" Stretch="Fill" Data="M0,0 L1,0 L0,1" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" />
            </Grid>
        </Grid>
        </Canvas>
    </ControlTemplate>
    <!-- Inventory tab / chip: pointed at both ends. -->
    <ControlTemplate x:Key="LocalLozengeTemplate" TargetType="{x:Type Control}">
        <Canvas IsHitTestVisible="False">
            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Margin="0,0,-0.6,0" Stretch="Fill" Data="M1,0 L1,1 L0,0.5 Z" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Background}" />
            <Path Grid.Column="2" Margin="-0.6,0,0,0" Stretch="Fill" Data="M0,0 L1,0.5 L0,1 Z" Fill="{TemplateBinding Background}" />
            <Grid Grid.ColumnSpan="3" OpacityMask="{DynamicResource LocalChalkMask}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Stretch="Fill" Data="M1,0 L0,0.5 L1,1" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" />
                <Border Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1.5,0,1.5" />
                <Path Grid.Column="2" Stretch="Fill" Data="M0,0 L1,0.5 L0,1" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" />
            </Grid>
        </Grid>
        </Canvas>
    </ControlTemplate>
    <!-- Bottom-bar button: a trapezoid, wider at the top. -->
    <ControlTemplate x:Key="LocalTrapTemplate" TargetType="{x:Type Control}">
        <Canvas IsHitTestVisible="False">
            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Margin="0,0,-0.6,0" Stretch="Fill" Data="M0,0 L1,0 L1,1 Z" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Background}" />
            <Path Grid.Column="2" Margin="-0.6,0,0,0" Stretch="Fill" Data="M0,0 L1,0 L0,1 Z" Fill="{TemplateBinding Background}" />
            <Grid Grid.ColumnSpan="3" OpacityMask="{DynamicResource LocalChalkMask}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Stretch="Fill" Data="M1,0 L0,0 L1,1" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" />
                <Border Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1.5,0,1.5" />
                <Path Grid.Column="2" Stretch="Fill" Data="M0,0 L1,0 L0,1" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" />
            </Grid>
        </Grid>
        </Canvas>
    </ControlTemplate>
    <!-- Text input well: square, same broken rim. -->
    <ControlTemplate x:Key="LocalRectPlateTemplate" TargetType="{x:Type Control}">
        <Canvas IsHitTestVisible="False">
            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}">
            <Rectangle Fill="{TemplateBinding Background}" />
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" OpacityMask="{DynamicResource LocalChalkMask}" />
        </Grid>
        </Canvas>
    </ControlTemplate>
    <!-- Skill tree node: a square turned 45 degrees. Background = fill, BorderBrush = hairline. -->
    <ControlTemplate x:Key="LocalNodeTemplate" TargetType="{x:Type Control}">
        <Path IsHitTestVisible="False" Stretch="Fill" Data="M0.5,0 L1,0.5 L0.5,1 L0,0.5 Z" Fill="{TemplateBinding Background}"
              Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" StrokeLineJoin="Miter" />
    </ControlTemplate>
    <!-- Keyboard prompt box (F, Esc, Q): a rounded hairline square. -->
    <ControlTemplate x:Key="LocalKeyPromptTemplate" TargetType="{x:Type Control}">
        <Border IsHitTestVisible="False" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
    </ControlTemplate>
    <!-- Description card (Camera Shake, Festival Token): plum-black card, bronze hairline, cream corner ticks top left and bottom right. -->
    <ControlTemplate x:Key="LocalCardTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
            <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{TemplateBinding Foreground}" Focusable="False" IsTabStop="False" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False">
            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0.5,10 L0.5,0.5 L10,0.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M0,9.5 L9.5,9.5 L9.5,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
        </Grid>
    </ControlTemplate>
    <!-- Victory / Battle Loot rule: a hairline that fades out to the right, crossed by a short tick 10px in. Background = rule, Foreground = tick. 11px tall. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" Height="11">
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="0.7" Color="#FF000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="1" HorizontalAlignment="Left" Margin="10,0,0,0" Fill="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>
    <!-- Art Deco lattice in Foreground. Use behind sparse surfaces only (bands, corners, the empty page). -->
    <ControlTemplate x:Key="LocalLatticeTemplate" TargetType="{x:Type Control}">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalLatticeMask}" />
    </ControlTemplate>
    <!-- The brand mark: the Chroma lozenge split by a hairline, a node each side (Foreground), a brush stroke across it (Background). -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox IsHitTestVisible="False" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource LocalBrushMarkStroke}" Fill="{TemplateBinding Background}" Opacity="0.8" />
                <Path Data="{DynamicResource LocalBrushMarkGeometry}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" StrokeLineJoin="Miter" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <!-- Empty game page: the start screen. The mark large over a faint lattice, red and white petals drifting slowly while visible. -->
    <ControlTemplate x:Key="LocalEmptyCanvasTemplate" TargetType="{x:Type Control}">
        <Grid x:Name="Root" IsHitTestVisible="False" Width="320" Height="220" ClipToBounds="True">
            <Control Template="{DynamicResource LocalLatticeTemplate}" Foreground="{DynamicResource LocalBronzeBrush}" Opacity="0.5" Focusable="False" IsTabStop="False">
                <Control.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Control.OpacityMask>
            </Control>
            <Control Template="{DynamicResource BrandMarkTemplate}" Width="96" Height="96" Margin="0,0,0,24" Foreground="{DynamicResource LocalCreamBrush}"
                     Background="{DynamicResource LocalOchreBrush}" Focusable="False" IsTabStop="False" />
            <Canvas>
                <Path x:Name="PetalA" Canvas.Left="70" Canvas.Top="20" Data="M0,3 C2,0 6,0 8,2 C6,4 2,5 0,3 Z" Fill="{DynamicResource LocalBloodBrush}">
                    <Path.RenderTransform><TranslateTransform x:Name="PetalAMove" /></Path.RenderTransform>
                </Path>
                <Path x:Name="PetalB" Canvas.Left="230" Canvas.Top="8" Data="M0,3 C2,0 6,0 8,2 C6,4 2,5 0,3 Z" Fill="{DynamicResource LocalWhiteBrush}" Opacity="0.8">
                    <Path.RenderTransform><TranslateTransform x:Name="PetalBMove" /></Path.RenderTransform>
                </Path>
                <Path x:Name="PetalC" Canvas.Left="150" Canvas.Top="-10" Data="M0,3 C2,0 6,0 8,2 C6,4 2,5 0,3 Z" Fill="{DynamicResource LocalBloodBrush}" Opacity="0.85">
                    <Path.RenderTransform><TranslateTransform x:Name="PetalCMove" /></Path.RenderTransform>
                </Path>
                <Path x:Name="PetalD" Canvas.Left="270" Canvas.Top="60" Data="M0,2 C1.5,0 4.5,0 6,1.5 C4.5,3 1.5,3.5 0,2 Z" Fill="{DynamicResource LocalBloodBrush}" Opacity="0.7">
                    <Path.RenderTransform><TranslateTransform x:Name="PetalDMove" /></Path.RenderTransform>
                </Path>
                <Path x:Name="PetalE" Canvas.Left="30" Canvas.Top="80" Data="M0,2 C1.5,0 4.5,0 6,1.5 C4.5,3 1.5,3.5 0,2 Z" Fill="{DynamicResource LocalWhiteBrush}" Opacity="0.6">
                    <Path.RenderTransform><TranslateTransform x:Name="PetalEMove" /></Path.RenderTransform>
                </Path>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="PetalDrift">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="PetalAMove" Storyboard.TargetProperty="Y" From="0" To="210" Duration="0:0:9" />
                            <DoubleAnimation Storyboard.TargetName="PetalAMove" Storyboard.TargetProperty="X" From="0" To="40" Duration="0:0:9" />
                            <DoubleAnimation Storyboard.TargetName="PetalBMove" Storyboard.TargetProperty="Y" From="0" To="220" Duration="0:0:12" />
                            <DoubleAnimation Storyboard.TargetName="PetalBMove" Storyboard.TargetProperty="X" From="0" To="-50" Duration="0:0:12" />
                            <DoubleAnimation Storyboard.TargetName="PetalCMove" Storyboard.TargetProperty="Y" From="0" To="240" Duration="0:0:10.5" />
                            <DoubleAnimation Storyboard.TargetName="PetalCMove" Storyboard.TargetProperty="X" From="0" To="30" Duration="0:0:10.5" />
                            <DoubleAnimation Storyboard.TargetName="PetalDMove" Storyboard.TargetProperty="Y" From="0" To="170" Duration="0:0:8" />
                            <DoubleAnimation Storyboard.TargetName="PetalDMove" Storyboard.TargetProperty="X" From="0" To="-30" Duration="0:0:8" />
                            <DoubleAnimation Storyboard.TargetName="PetalEMove" Storyboard.TargetProperty="Y" From="0" To="150" Duration="0:0:11" />
                            <DoubleAnimation Storyboard.TargetName="PetalEMove" Storyboard.TargetProperty="X" From="0" To="60" Duration="0:0:11" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="PetalDrift" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Margin="-3" IsHitTestVisible="False" Focusable="False"
                             Template="{DynamicResource CornerMarksTemplate}"
                             Foreground="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Component spacing, from the captures: 30px settings rows, 32px fields, plates padded past their arrow point. -->
    <Thickness x:Key="ButtonPadding">20,5,20,5</Thickness> <!-- Button: trapezoid plate, 7px slant each side plus 13px air -->
    <Thickness x:Key="InputPadding">10,5,10,5</Thickness> <!-- Text box, password box; 32px with ControlHeight -->
    <Thickness x:Key="MenuPadding">6,6,6,8</Thickness> <!-- Menu rows inside the card, under the lattice strip -->
    <Thickness x:Key="MenuItemPadding">12,5,12,5</Thickness> <!-- Menu item: 30px row -->
    <Thickness x:Key="ComboBoxDropDownPadding">6</Thickness> <!-- Dropdown card -->
    <Thickness x:Key="ComboBoxItemPadding">16,5,12,5</Thickness> <!-- Dropdown item: room for the arrow point -->
    <Thickness x:Key="ListBoxItemPadding">14,5,10,5</Thickness> <!-- List box item -->
    <Thickness x:Key="GroupBoxPadding">16,12,16,14</Thickness> <!-- Description card body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness> <!-- Gap under the card's centered caps title -->
    <Thickness x:Key="TooltipPadding">12,7,12,8</Thickness> <!-- Tooltip card -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double> <!-- Top bar and sidebar icons -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         brush dissolve. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Both views start on the right. Center and Stretch flow above media. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->
    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, so the real carousel replaces it without the page jumping. Each Viewbox scales a fixed 1600px
         layout to the width its column gives it (height is unbounded in a vertical stack). The tiles are the host's
         Foreground at low opacity; the whole thing pulses while visible. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the plugin's ContentControl, visible while that control has no height. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="8"
                        Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="6" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" CornerRadius="6" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" CornerRadius="6" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" CornerRadius="6" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" CornerRadius="6" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- More / Edit: a key prompt square (the game's F / Esc boxes): charcoal, hairline rim, the rim and glyph turn cream on hover. -->
    <Style x:Key="LocalGameActionSocket" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Plate" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource LocalRimDimBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <Border x:Name="HoverPlate" Opacity="0" Background="{DynamicResource ButtonHoverBackgroundBrush}" BorderBrush="{DynamicResource LocalCreamBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <Border x:Name="PressedPlate" Opacity="0" Background="{DynamicResource ButtonPressedBackgroundBrush}" BorderBrush="{DynamicResource LocalCreamBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ActionHoverIn"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ActionHoverOut"><Storyboard>
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedPlate" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): three cream brush swashes, each a drag of paint with round ends, stacked like menu rows. Hover: a coral petal peels off each swash tip in turn and drifts up and out, turning (the Gommage). Open (ContextMenu.IsOpen of the nearest Border): an ochre lozenge blooms around the swashes with a springy overshoot and breathes while the swashes sway sideways at different paces until the menu closes. -->
    <ControlTemplate x:Key="LocalBrushlightMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="26" Height="26" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform x:Name="LozengeScale" ScaleX="0.3" ScaleY="0.3" /></Canvas.RenderTransform>
                    <Path x:Name="Lozenge" Data="M13,1.2 L24.8,13 L13,24.8 L1.2,13Z" Stroke="{DynamicResource LocalOchreLitBrush}" StrokeThickness="1.2" StrokeLineJoin="Miter" Opacity="0" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="SwayA" X="0" /></Canvas.RenderTransform>
                    <Path Data="M3.5,8 C8,4.8 13,11.2 22.5,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="SwayB" X="0" /></Canvas.RenderTransform>
                    <Path Data="M3.5,13 C8,9.8 13,16.2 22.5,12" Stroke="{TemplateBinding Foreground}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="SwayC" X="0" /></Canvas.RenderTransform>
                    <Path Data="M3.5,18 C8,14.8 13,21.2 22.5,17" Stroke="{TemplateBinding Foreground}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Path x:Name="PetalA" Data="M0,0 C1.6,-1.7 3.8,-1.7 5.4,0 C3.8,1.7 1.6,1.7 0,0Z" Canvas.Left="20.5" Canvas.Top="7" Fill="{DynamicResource LocalCoralBrush}" Opacity="0" RenderTransformOrigin="0,0.5">
