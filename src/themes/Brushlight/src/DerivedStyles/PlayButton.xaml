<!--
    Brushlight: Play, the combat command of Clair Obscur (Aim / Items / Skills / Attack). Structure: Playnite Default 10.60 (PlayButton);
    every Default state is kept.
    Brushes: Background (the stroke, ButtonBackgroundBrush), LocalOchreBrush (the paint smear), LocalOchreDeepBrush (the smear pressed),
    GlyphBrush (the key prompt and the hover label), TextBrush (the rest label), TextBrushDark (the triangle in the filled prompt),
    LocalPlateDeepBrush (the press), RunningIndicatorBrush, ScrimBrush, ShellBackgroundBrush.
    Rest: a ragged dry-brush stroke (stroke.png as OpacityMask) in charcoal over a half-swept ochre smear (smear.png, 62%, 70% of its
    length), a key prompt box (rounded hairline square) holding the play triangle on the left, the label in Cinzel capitals.
    Hover, both ways (power ease): the ochre smear sweeps the rest of the way in under the stroke from the left (0.38s, full strength),
    the key prompt fills cream with a dark triangle, the label turns cream. The hit area never moves.
    Press, its own layer: the stroke darkens, slides 1.5px right and 2px down the slant, the smear deepens; release recovers in 0.2s.
    Running and launching: the stroke fills with RunningIndicatorBrush (Lumina cyan) with a dark label; the smear and hover layers drop
    out. Launching: a dark band sweeps the stroke. Running: a light scrim breathes over it. The RUNNING label shows Cancel only while
    the button itself is hovered (RelativeSource Self), and the hover layers stay off while it runs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite
        swaps Play for the context action (RUNNING). The overlay carries a faint Lumina wash in the stroke's own shape, a frame of
        Lumina hairlines along the cell's top and bottom edges with an ink-ringed Chroma lozenge at each end, and a foot band of
        little lozenges passing along the bottom edge. Launching: the lozenges run fast (0.5s per step) and the end lozenges blink.
        Running: slow (2.4s) while the frame breathes 0.72 to 1. The band and the end lozenges never reach the label, which sits
        in the middle. DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching).
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Rectangle x:Name="RunningWash" Margin="-4,-3,-4,-3" Fill="{DynamicResource RunningIndicatorBrush}" OpacityMask="{DynamicResource LocalStrokeMask}" Opacity="0.2" />
                        <Border x:Name="RunningFrame" Margin="10,0" BorderThickness="0,1.5,0,1.5" BorderBrush="{DynamicResource RunningIndicatorBrush}" />
                        <Grid>
                            <Path x:Name="RunningEndLeft" Width="9" Height="14" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Fill"
                                  Data="M4.5,0 L9,7 L4.5,14 L0,7 Z" Fill="{DynamicResource RunningIndicatorBrush}" Stroke="{DynamicResource TextBrushDark}" StrokeThickness="1.2" />
                            <Path x:Name="RunningEndRight" Width="9" Height="14" Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="Fill"
                                  Data="M4.5,0 L9,7 L4.5,14 L0,7 Z" Fill="{DynamicResource RunningIndicatorBrush}" Stroke="{DynamicResource TextBrushDark}" StrokeThickness="1.2" />
                        </Grid>
                        <Grid Height="6" Margin="20,0,20,4" VerticalAlignment="Bottom" ClipToBounds="True">
                            <Border Background="{DynamicResource ScrimBrush}" Opacity="0.82" />
                            <Canvas>
                                <Rectangle x:Name="MarchFoot" Canvas.Left="-12" Width="600" Height="6">
                                    <Rectangle.Fill>
                                        <DrawingBrush TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,12,6" ViewboxUnits="Absolute" Viewbox="0,0,12,6">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="{DynamicResource RunningIndicatorBrush}" Geometry="M4,0 L8,3 L4,6 L0,3 Z" />
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="MarchFootShift" X="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="MarchFootShift" Storyboard.TargetProperty="X" From="0" To="12" Duration="0:0:0.5" />
                                        <DoubleAnimation Storyboard.TargetName="RunningEndLeft" Storyboard.TargetProperty="Opacity" From="1" To="0.5" Duration="0:0:0.25" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RunningEndRight" Storyboard.TargetProperty="Opacity" From="0.5" To="1" Duration="0:0:0.25" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MarchFootShift" Storyboard.TargetProperty="X" From="0" To="12" Duration="0:0:2.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="54,0,26,2" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- The ochre smear under the stroke: half swept at rest, the rest of the way on hover. -->
                        <Grid x:Name="SmearHost" Margin="-22,-14,-28,-16" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="-3" />
                            </Grid.RenderTransform>
                            <Rectangle x:Name="Smear" Fill="{DynamicResource LocalOchreBrush}" OpacityMask="{DynamicResource LocalSmearMask}" Opacity="0.62" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="SmearSweep" ScaleX="0.7" ScaleY="1" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="SmearPressed" Fill="{DynamicResource LocalOchreDeepBrush}" OpacityMask="{DynamicResource LocalSmearMask}" Opacity="0" />
                        </Grid>
                        <Grid x:Name="Face" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="PressShift" X="0" Y="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <!-- The stroke and its state layers, all cut by the same dry-brush mask. -->
                            <Rectangle x:Name="Plate" Margin="-6,-4,-6,-4" Fill="{TemplateBinding Background}" OpacityMask="{DynamicResource LocalStrokeMask}" />
                            <Rectangle x:Name="RunningBreath" Margin="-6,-4,-6,-4" Fill="{DynamicResource ScrimBrush}" OpacityMask="{DynamicResource LocalStrokeMask}" Opacity="0" />
                            <Grid Margin="-6,-4,-6,-4" OpacityMask="{DynamicResource LocalStrokeMask}" IsHitTestVisible="False">
                                <Rectangle x:Name="RunningScan" Visibility="Collapsed" Fill="{DynamicResource ShellBackgroundBrush}" Opacity="0.25">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                            <Rectangle x:Name="RunningHoverDim" Margin="-6,-4,-6,-4" Fill="{DynamicResource ScrimBrush}" OpacityMask="{DynamicResource LocalStrokeMask}" Opacity="0" />
                            <Rectangle x:Name="PressedPlate" Margin="-6,-4,-6,-4" Fill="{DynamicResource LocalPlateDeepBrush}" OpacityMask="{DynamicResource LocalStrokeMask}" Opacity="0" />
                            <!-- The key prompt: a rounded hairline box holding the play triangle; it fills cream on hover. -->
                            <Grid x:Name="Gem" Width="26" Height="26" Margin="18,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Border x:Name="KeyFill" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource GlyphBrush}" Opacity="0" />
                                <Border x:Name="GemRing" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" />
                                <Path x:Name="PlayGlyph" Data="M0,0 L9,5.5 L0,11 Z" Width="9" Height="11" Margin="2,0,0,0" Fill="{TemplateBinding BorderBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="PlayGlyphHover" Data="M0,0 L9,5.5 L0,11 Z" Width="9" Height="11" Margin="2,0,0,0" Fill="{DynamicResource TextBrushDark}" Opacity="0"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <StackPanel x:Name="LabelRow" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="PlayContent" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </StackPanel>
                            </Viewbox>
                            <StackPanel x:Name="LabelRowHover" Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Opacity="0" IsHitTestVisible="False">
                                <ContentPresenter x:Name="PlayContentHover" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource GlyphBrush}" />
                            </StackPanel>
                            <ContentPresenter x:Name="CancelLabel" Content="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="54,0,0,2" TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type sys:String}">
                                        <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="Gem" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Padding" Value="28,0,28,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,0,2" />
                            <Setter TargetName="CancelLabel" Property="HorizontalAlignment" Value="Center" />
                        </Trigger>
                        <!-- Hover and press: only while the game is not launching or running. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SmearSweep" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.38">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Smear" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="KeyFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PlayGlyphHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="LabelRowHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="LabelRow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SmearSweep" Storyboard.TargetProperty="ScaleX" To="0.7" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Smear" Storyboard.TargetProperty="Opacity" To="0.62" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="KeyFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PlayGlyphHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="LabelRowHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="LabelRow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayPressIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="SmearPressed" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="X" To="1.5" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="2" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="PlayPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="SmearPressed" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SmearHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="KeyFill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayGlyphHover" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.1" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SmearHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="KeyFill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayGlyphHover" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.04" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.12" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.04" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING stroke is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Hidden" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Launching and running keep Play's stroke; it fills with the running colour (Lumina cyan) with dark text and prompt. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
