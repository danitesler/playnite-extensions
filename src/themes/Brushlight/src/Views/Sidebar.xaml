<!--
    Brushlight: left rail, 44px of the void (HeaderBandBrush) closed by a 1px bronze hairline, the bronze Art Deco lattice rising faintly
    from its foot (sparse decor, hidden while the sidebar sits at the top or bottom and while window art is on). The main menu is the
    brand mark (cream lozenge over an ochre brush stroke); a plum lozenge fades in under it on hover (200 ms). The current item sits on a
    plum lozenge (SidebarItem.xaml). Colors: HeaderBandBrush, MainMenuButtonForegroundBrush, SelectedBrush, LocalBronzeBrush.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource HeaderBandBrush}" Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <!-- The lattice rising from the rail's foot, and its 1px bronze edge. -->
                            <Control x:Name="RailLattice" Template="{DynamicResource LocalLatticeTemplate}" Height="220" VerticalAlignment="Bottom" Margin="0,0,1,0"
                                     Foreground="{DynamicResource LocalBronzeBrush}" Opacity="0.7" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                <Control.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#FF000000" />
                                    </LinearGradientBrush>
                                </Control.OpacityMask>
                            </Control>
                            <Rectangle x:Name="EdgeLine" Width="1" HorizontalAlignment="Right" Fill="{DynamicResource LocalBronzeBrush}" IsHitTestVisible="False" />
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="52" Margin="0,0,0,0"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid x:Name="MenuSocketHost" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- a plum lozenge, collapsed at rest -->
                                        <Control x:Name="MenuGlow" Width="40" Height="28" Template="{DynamicResource LocalLozengeTemplate}" Visibility="Collapsed" Opacity="0"
                                                 IsHitTestVisible="False" Focusable="False" IsTabStop="False" Background="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource LocalRimBrush}" />
                                        <Control x:Name="MenuMark" Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                 Background="{DynamicResource LocalOchreBrush}" Width="26" Height="26" Focusable="False" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailLattice" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuGlowIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="MenuGlowIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailLattice" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="1" TargetName="EdgeLine" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailLattice" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="1" TargetName="EdgeLine" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="EdgeLine" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
