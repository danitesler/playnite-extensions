<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml: the game page beside the game list.
    Built like a Terraria menu screen on the select screens' list panel (33, 43, 79 at 80%):
      - the background art is a band at the top, fading into the night sky color (ScrimBrush) toward the title;
      - the name in the bold heading font with the game's black border (four offset copies of PART_TextDisplayName),
        the Play button (title panel blue, gold edge) at the right with the other actions as square menu buttons
        (Options for Playnite's More menu, edit);
      - Steam screenshots, then description and notes under outlined section titles with a 2px rule, and at the
        right the cover over one metadata pane, a menu panel (blue at 70%, 2px black edge), groups split by 1px
        rules, captions beside values.
    Every PART_ element of Playnite's file is kept. HtmlTextView takes Colors: its HtmlForeground and LinkForeground
    read the Color of the brushes set on TextElement.Foreground and Tag, so ThemeModifier edits reach them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <Grid Background="{DynamicResource GameOverviewBackgroundBrush}"
                          d:DesignWidth="1280" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Style="{DynamicResource DetailsScrollViewer}">
                            <Grid>
                                <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.CacheMode>
                                        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                    </Grid.CacheMode>
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="Black" Offset="0" />
                                            <GradientStop Color="Black" Offset="0.45" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- The night sky closing in under the art: the zenith color, clear at the top, 70% toward the title. -->
                                    <Rectangle Fill="{DynamicResource ScrimBrush}">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#00000000" Offset="0.2" />
                                                <GradientStop Color="#B2000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                                <StackPanel Margin="32,0,32,32" MaxWidth="1400">
                                    <Border IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 190 / 320'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <!-- Header: icon and outlined name at the left, Play and the other actions at the right. -->
                                    <DockPanel Margin="0,24,0,28">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="24,0,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" MinWidth="180" Height="48" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" MinWidth="180" Height="48" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Width="48" Height="48" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                                <ContentControl Width="24" Height="24" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Width="48" Height="48" Padding="0" Margin="8,0,0,0" Focusable="False" ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Width="24" Height="24" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                        <Image x:Name="PART_ImageIcon" MaxHeight="48" MaxWidth="48" DockPanel.Dock="Left" Margin="0,0,16,0"
                                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                        <Grid>
                                            <!-- The game's bordered name: four black copies 2px off, then Playnite's text on top. -->
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextOutlineBrush}"><TextBlock.RenderTransform><TranslateTransform X="-2" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextOutlineBrush}"><TextBlock.RenderTransform><TranslateTransform X="2" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextOutlineBrush}"><TextBlock.RenderTransform><TranslateTransform Y="-2" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextOutlineBrush}"><TextBlock.RenderTransform><TranslateTransform Y="2" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}"
                                                   FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                    </DockPanel>
                                    <DockPanel>
                                        <!-- Metadata pane: a menu panel (blue at 70%, 2px black edge) with the cover on top. -->
                                        <StackPanel DockPanel.Dock="Right" Width="{DynamicResource GameDetailsPaneWidth}" Margin="32,0,0,0">
                                            <Image x:Name="PART_ImageCover" Height="{Settings GameDetailsCoverHeight}" HorizontalAlignment="Left"
                                                   StretchDirection="Both" Stretch="Uniform" Margin="0,0,0,16"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                            <Border Background="{DynamicResource ExpanderBackgroundBrush}" Padding="16,12,16,12"
                                                    BorderThickness="{DynamicResource ControlBorderThickness}" BorderBrush="{DynamicResource NormalBorderBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <Border ClipToBounds="True">
                                                    <StackPanel Margin="0,-31,0,-6">
                                                        <Border x:Name="MetaProgress" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCompletionStatus" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPlayTime" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextPlayTime" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemLastPlayed" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextLastActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemRecentActivity" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAdded" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" Grid.Column="1" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCommunityScore" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemCriticScore" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemUserScore" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCUserScore}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" Grid.Column="1" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemDevelopers" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDevelopersLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsDevelopers" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPublishers" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCPublishersLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsPublishers" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemReleaseDate" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemSeries" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCSeriesLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsSeries" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAgeRating" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsAgeRatings" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemRegion" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRegionLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsRegions" Grid.Column="1" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaTags" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemPlatform" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCPlatformsTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,2,0,-8" Grid.Column="1">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemGenres" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGenresLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,2,0,-8" Grid.Column="1">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemCategories" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCategoriesLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,2,0,-8" Grid.Column="1">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemFeatures" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,2,0,-8" Grid.Column="1">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemTags" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCTagsLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsTags" Tag="Chip" Margin="0,2,0,-8" Grid.Column="1">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaLibrary" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemLibrary" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemSource" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCSourceLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <Button x:Name="PART_ButtonSource" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemVersion" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCVersionLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <Button x:Name="PART_ButtonVersion" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemInstallSize" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <TextBlock x:Name="PART_TextInstallSize" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" Grid.Column="1" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemInstallDirectory" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <Button x:Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" Grid.Column="1" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaLinks" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemLinks" Margin="0,6,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="128" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCLinksLabel}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                                    <ItemsControl x:Name="PART_ItemsLinks" Grid.Column="1" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel>
                                    <Grid Margin="0,0,0,24">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library or Steam source games in that gap; give up after 12s. With the plugin missing or disabled the binding falls back to PluginUnavailable, which matches neither True nor False. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                            <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                        <MultiDataTrigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                        </MultiDataTrigger.ExitActions>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                            <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                        <MultiDataTrigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                        </MultiDataTrigger.ExitActions>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <StackPanel>
                                            <ContentControl Content="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" Focusable="False" IsTabStop="False" Margin="0,0,0,12">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate>
                                                        <Border BorderThickness="0,0,0,2" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" Padding="0,0,0,6">
                                                            <ContentControl Content="{Binding}" Template="{DynamicResource OutlinedTextTemplate}" Focusable="False"
                                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                                                       FontWeight="Bold" Foreground="{DynamicResource HeadingForegroundBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                            <Grid>
                                                <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}"
                                                         Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                    <Control.Style>
                                                        <Style TargetType="Control">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Control.Style>
                                                </Control>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                            <StackPanel x:Name="PART_ElemDescription" Margin="0,0,0,24">
                                                <ContentControl Content="{DynamicResource LOCGameDescriptionTitle}" Focusable="False" IsTabStop="False" Margin="0,0,0,12">
                                                    <ContentControl.ContentTemplate>
                                                        <DataTemplate>
                                                            <Border BorderThickness="0,0,0,2" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" Padding="0,0,0,6">
                                                                <ContentControl Content="{Binding}" Template="{DynamicResource OutlinedTextTemplate}" Focusable="False"
                                                                           FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                                                           FontWeight="Bold" Foreground="{DynamicResource HeadingForegroundBrush}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ContentControl.ContentTemplate>
                                                </ContentControl>
                                                <HtmlTextView x:Name="PART_HtmlDescription"
                                                              TextElement.Foreground="{DynamicResource TextBrush}" Tag="{DynamicResource GlyphBrush}"
                                                              HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                              LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                              HtmlFontSize="{DynamicResource FontSize}"
                                                              HtmlFontFamily="{DynamicResource FontFamily}"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                              pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                            </StackPanel>
                                            <StackPanel x:Name="PART_ElemNotes" Margin="0,0,0,24">
                                                <ContentControl Content="{DynamicResource LOCNotesLabel}" Focusable="False" IsTabStop="False" Margin="0,0,0,12">
                                                    <ContentControl.ContentTemplate>
                                                        <DataTemplate>
                                                            <Border BorderThickness="0,0,0,2" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" Padding="0,0,0,6">
                                                                <ContentControl Content="{Binding}" Template="{DynamicResource OutlinedTextTemplate}" Focusable="False"
                                                                           FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                                                           FontWeight="Bold" Foreground="{DynamicResource HeadingForegroundBrush}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ContentControl.ContentTemplate>
                                                </ContentControl>
                                                <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Margin="-1,0,-1,0" Padding="0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>