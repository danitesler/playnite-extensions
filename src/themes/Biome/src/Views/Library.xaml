<!--
    Overlay on Playnite Default/Views/Library.xaml.
    The title screen's night sky behind everything, the top bar included: the window color (WindowBackgourndBrush,
    the zenith) with the horizon color (ContentBackgroundBrush) rising from the bottom edge. The selected game's
    background art (when Playnite shows it: Settings, Appearance) hangs faintly in that sky (45%), shaded under the
    top bar in the zenith color (ScrimBrush) so the menu words stay readable. Both gradients are
    masks inside a bitmap cache. The library itself has no fill: its panels and tiles sit on the sky like the
    game's menu panels.
    PART_ImageBackground and the PART_View* names are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Rectangle Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"
                                   Fill="{DynamicResource ContentBackgroundBrush}">
                            <Rectangle.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                            </Rectangle.CacheMode>
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="0.55" Color="#59000000" />
                                    <GradientStop Offset="1" Color="#FF000000" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>

                        <FadeImage x:Name="PART_ImageBackground" Grid.Row="0" Grid.RowSpan="2" Opacity="0.45"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                            <Grid.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                            </Grid.CacheMode>
                            <Rectangle Fill="{DynamicResource ScrimBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#E6000000" />
                                        <GradientStop Offset="0.3" Color="#00000000" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>

                        <TopPanel Grid.Row="0" />

                        <DockPanel Grid.Row="1">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}" />

                            <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                           DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}" />

                            <Grid DockPanel.Dock="Left">
                                <LibraryDetailsView x:Name="PART_ViewDetails" />
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
