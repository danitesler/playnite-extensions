    <!-- Content = one of the geometries above, drawn in the inherited foreground. The host sets the size. -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" RenderOptions.EdgeMode="Aliased"
                      Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- The search and clear glyphs of Playnite's SearchBox. -->
    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentPresenter Width="18" Height="18"
                          Content="{DynamicResource IconSearch}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource IconClear}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <sys:String x:Key="FullscreenModeIcon">Images/Pixel/fullscreen.png</sys:String>
