<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    The select screens' search bar: a dark menu panel with the 2px black edge and rounded corners, white text; the
    edge turns the hover blue under the pointer and gold while typing. PART_SeachIcon doubles as the placeholder
    (Playnite hides it while the field has focus or text): the pixel magnifier and "Search" in the muted text color.
    PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Field" Background="{TemplateBinding Background}" BorderThickness="{DynamicResource ControlBorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <ContentControl Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                  Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" x:Name="Glyph" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource GlyphBrush}" IsHitTestVisible="False" Focusable="False" IsTabStop="False" Panel.ZIndex="1" />
                            <TextBlock x:Name="PART_SeachIcon" Text="{DynamicResource LOCSearchLabel}" Foreground="{DynamicResource TextBrushDarker}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="34,0,30,0" IsHitTestVisible="False" />
                            <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     VerticalContentAlignment="Center" Padding="34,0,30,0" />
                            <ContentControl x:Name="PART_ClearTextIcon" Width="12" Height="12" Cursor="Hand"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"
                                            Foreground="{DynamicResource TextBrushDarker}"
                                            Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}">
                                <ContentControl.Template>
                                    <ControlTemplate TargetType="ContentControl">
                                        <Border Background="Transparent">
                                            <ContentPresenter ContentSource="Content" />
                                        </Border>
                                    </ControlTemplate>
                                </ContentControl.Template>
                            </ContentControl>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Field" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Field" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ClearTextIcon">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="PART_ClearTextIcon" />
                        </Trigger>

                        <!-- Keep the magnifier visible while Playnite hides its placeholder. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
