<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    On the rail every item is a hotbar slot: a 36px plate with a 24px pixel glyph. At rest only the glyph shows, in the
    muted text color; under the pointer the slot appears as a menu panel (UIPanel: blue at 70%, 2px black edge,
    rounded); the current view is the hovered menu button (brighter blue 73, 94, 171 with the gold 255, 231, 69 edge)
    and its glyph turns white. Library is IconLibrary (a gamepad), Statistics IconStatistics; add-on items keep their
    own icon, scaled into the 24px box. The title is the tooltip.
    Docked at the top or bottom, views become menu words (bold heading font, gold when current) and buttons stay slots.
    PART_ProgressStatus is a 3px bar along the bottom of the slot.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="ToolTip" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="Plate" Width="36" Height="36" CornerRadius="{DynamicResource ControlCornerRadius}"
                                BorderThickness="{DynamicResource ControlBorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Grid>
                                <Grid x:Name="IconHost" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox x:Name="ItemIcon">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    </Viewbox>
                                    <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                    ContentTemplate="{DynamicResource IconTemplate}" />
                                </Grid>
                                <ProgressBar x:Name="PART_ProgressStatus" Height="3" VerticalAlignment="Bottom"
                                             BorderThickness="0" Background="Transparent" />
                            </Grid>
                        </Border>
                        <ContentControl x:Name="Label" Visibility="Collapsed" Margin="14,0,14,0" Focusable="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                        FontWeight="Bold" Foreground="{TemplateBinding Foreground}"
                                        Template="{DynamicResource OutlinedTextTemplate}"
                                        Content="{Binding Title}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" TargetName="Plate" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Plate" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="IconHost" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Label" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <!-- Docked at the top or bottom: a view is a menu word over the full height of the strip. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings SidebarPosition}" Value="Top" />
                                <Condition Binding="{Binding Type}" Value="View" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Plate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Label" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings SidebarPosition}" Value="Bottom" />
                                <Condition Binding="{Binding Type}" Value="View" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Plate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Label" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Settings SidebarPosition}" Value="Top" />
                    <Condition Binding="{Binding Type}" Value="View" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="64" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Settings SidebarPosition}" Value="Bottom" />
                    <Condition Binding="{Binding Type}" Value="View" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="64" />
            </MultiDataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
