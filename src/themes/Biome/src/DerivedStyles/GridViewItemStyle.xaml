<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml.
    Covers as inventory slots: each sits in the panels' 2px black edge with rounded corners, just outside the cover so
    nothing gets clipped, on the panel blue where the cover leaves room (GridItemBackgroundBrush, Playnite's "show
    item background" setting). The selected cover gets the menu buttons' 3px gold edge, like the selected hotbar slot
    (static).
    Hover, animated both ways (no setters on animated parts, so nothing snaps): in 0.15s the slot edge turns the list
    items' hover blue (89, 116, 213) and a faint wash of the panel hover blue lights the cover; a gold pixel sparkle
    (sparkle.png, a fallen star's glint) blinks in the cover's top right corner in discrete frames while the pointer
    stays. Out: 0.2s fade; exit animations use FillBehavior Stop. All drawn within the item's own spacing margin
    (2px outside the cover), no OpacityMask behind it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <ContentPresenter />
                        <Border x:Name="HoverWash" Background="{DynamicResource SelectedBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Rectangle x:Name="Sparkle" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                   Opacity="0" IsHitTestVisible="False" Fill="{DynamicResource FocusBrush}" RenderOptions.BitmapScalingMode="NearestNeighbor">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/sparkle.png'}" Stretch="Fill" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Border x:Name="SelectionBorder" BorderThickness="2" Margin="-2" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" BorderBrush="{DynamicResource SlotBorderBrush}" />
                        <Border x:Name="HoverBorder" BorderThickness="2" Margin="-2" IsHitTestVisible="False" Opacity="0"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                        <Border x:Name="SelectedBorder" BorderThickness="3" Margin="-3" IsHitTestVisible="False" Visibility="Collapsed"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sparkle" Storyboard.TargetProperty="Opacity" Duration="0:0:1.5">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1.0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <!-- Replaces the endless blink (default SnapshotAndReplace). -->
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Sparkle" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
