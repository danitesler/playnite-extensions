<!--
    Biome: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    The title screen as a 44px band: the night sky (window color) with the horizon blue rising toward the bottom edge,
    ten pixel stars on it, and the title in the "Select Player" panel of the character-select screen (blue plate, 2px
    black edge, 6px corners) at the left. The band closes with the separator blue over a 2px black line. Caption
    buttons are the 38x32 WindowBarButton, so the caption and the content offset are 44 (Default 25). PART_TextTitle
    and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource NormalBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowBackgourndBrush}" ClipToBounds="True">
                                    <!-- The night sky of the title screen: the horizon blue rising from the bottom edge, pixel stars on it. -->
                                    <Rectangle IsHitTestVisible="False" Fill="{DynamicResource ContentBackgroundBrush}">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="Transparent" Offset="0" />
                                                <GradientStop Color="Black" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Canvas IsHitTestVisible="False" SnapsToDevicePixels="True">
                                        <Rectangle Canvas.Left="250" Canvas.Top="8" Width="2" Height="2" Fill="{DynamicResource TextBrush}" Opacity="0.9" />
                                        <Rectangle Canvas.Left="318" Canvas.Top="26" Width="2" Height="2" Fill="{DynamicResource TextBrush}" Opacity="0.5" />
                                        <Rectangle Canvas.Left="402" Canvas.Top="12" Width="2" Height="2" Fill="{DynamicResource TextBrush}" Opacity="0.7" />
                                        <Rectangle Canvas.Left="470" Canvas.Top="30" Width="2" Height="2" Fill="{DynamicResource TextBrush}" Opacity="0.4" />
                                        <Rectangle Canvas.Left="548" Canvas.Top="7" Width="2" Height="2" Fill="{DynamicResource TextBrush}" Opacity="0.8" />
                                        <Rectangle Canvas.Left="610" Canvas.Top="22" Width="2" Height="2" Fill="{DynamicResource TextBrush}" Opacity="0.55" />
                                        <Rectangle Canvas.Left="688" Canvas.Top="11" Width="2" Height="2" Fill="{DynamicResource TextBrush}" Opacity="0.9" />
                                        <Rectangle Canvas.Left="742" Canvas.Top="28" Width="2" Height="2" Fill="{DynamicResource TextBrush}" Opacity="0.45" />
                                        <Rectangle Canvas.Left="815" Canvas.Top="9" Width="2" Height="2" Fill="{DynamicResource TextBrush}" Opacity="0.7" />
                                        <Rectangle Canvas.Left="905" Canvas.Top="24" Width="2" Height="2" Fill="{DynamicResource TextBrush}" Opacity="0.5" />
                                    </Canvas>
                                    <!-- Closing rule: the separator blue over the 2px black panel edge. -->
                                    <StackPanel VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <Rectangle Height="2" Fill="{DynamicResource PanelSeparatorBrush}" />
                                        <Rectangle Height="2" Fill="{DynamicResource NormalBorderBrush}" />
                                    </StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <!-- The title panel of the character-select screen: blue plate, 2px black edge, 6px corners. -->
                                        <Border DockPanel.Dock="Left" Margin="8,5,0,9" Padding="18,0,18,0"
                                                Background="{DynamicResource WindowTitleBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="2"
                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                        </Border>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,4,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
