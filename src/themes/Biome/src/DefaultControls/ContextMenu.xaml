<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is a Terraria UIPanel (LocalUIPanelTemplate, shared by ComboBox.xaml,
    CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: the opaque tooltip navy under the list panel blue (63, 82, 151 at 70%), the panel's 2px black edge with the
      world list items' lighter blue rim (89, 116, 213 at 70%) just inside it, 6px corners like UIPanel. Rows sit 6px
      inside. No shadow (WPF popups are layered windows).
    Rows, rules and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalUIPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Background="{DynamicResource ListItemHoverBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="2" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}" />
            <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="230" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalUIPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
