<!--
    Biome: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    The Terraria menu values keep their own names in tokens.css; each placeholder here names the token that plays
    the key's role. Theme XAML reads brushes only, never Color keys.

    The look in one line: the game's menu panels (UIPanel, blue at 70% with a 2px black edge and rounded corners)
    over a night sky; under the pointer a panel turns the brighter blue with the gold edge of the menu buttons, and
    menu words go from white at 60% to gold. Translucent panel colors are flattened onto the sky where Playnite needs
    an opaque Color.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Typography (Playnite keys). The game draws everything in Andy Bold: MouseText for body text (16px line) and
        DeathText for the title screen's menu (32px line). Andy is used where it is installed; otherwise headings and
        menu words fall back to Segoe UI Black and body text is Segoe UI.
    -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">22</sys:Double>
    <sys:Double x:Key="FontSizeLargest">32</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Segoe UI Black}}, Segoe UI</FontFamily>

    <!-- Shape: the panel's 2px edge and rounded corner -->
    <Thickness x:Key="PopupBorderThickness">{{px:border-panel}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:border-panel}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius-panel}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">10</Thickness>

    <!-- Radius scale -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-large}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:radius-full}}</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor is the gold of the menu buttons' hover edge; text on it is black.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{text}}</Color>
    <Color x:Key="TextColorDarker">{{text-muted}}</Color>
    <Color x:Key="TextColorDark">#FF000000</Color>
    <Color x:Key="MainColor">{{panel@sky-top}}</Color>
    <Color x:Key="MainColorDark">{{panel-outer@sky-top}}</Color>
    <Color x:Key="HoverColor">{{panel-hover}}</Color>
    <Color x:Key="GlyphColor">{{fancy-gold}}</Color>
    <Color x:Key="HighlightGlyphColor">{{fancy-gold/35}}</Color>
    <Color x:Key="PopupBackgroundColor">{{tooltip-back@sky-top}}</Color>
    <Color x:Key="PopupBorderColor">{{list-item-border@tooltip-back@sky-top}}</Color>
    <Color x:Key="BackgroundToneColor">{{panel-outer@sky-top}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{panel@sky-top}}</Color>
    <Color x:Key="PanelSeparatorColor">#00000000</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{separator@panel-outer@sky-top}}</Color>
    <Color x:Key="DataChangeNotifColor">{{rarity-amber}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{panel-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{{panel-hover}}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{tooltip-back}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{panel-outer}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{rarity-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{rarity-light-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{rarity-orange}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{rarity-red}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{sky-top}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!--
        Shell. The window is the night sky (WindowBackgourndBrush at the top, ContentBackgroundBrush rising from the
        horizon, Views/Library.xaml); the rail is the menu screens' darker list panel; the top bar is see-through, so
        its menu words sit on the sky like the title screen's.
    -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{panel-outer}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{sky-horizon}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{panel-hover}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{sky-top}}" />

    <!-- States: the panel's mouse-over pair (brighter blue, gold edge) and the menu's gold words -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{panel-hover}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{list-item-border-hover}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{menu-selected}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{panel-hover}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{panel-hover}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{fancy-gold}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{hardcore}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFFFFFF" />

    <!-- Buttons: UITextPanel (Back / New). The Play button is the select screen's title panel blue with the gold edge. -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{panel-border}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{panel-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{panel-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{title-pill}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{list-item-border-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{panel-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{menu-selected}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{fancy-gold}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{panel-hover}}" />

    <!-- Inputs: the search bar of the select screens, a dark panel with the black edge -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{panel-outer}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{panel-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{list-item-border-hover}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{panel-border}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{fancy-gold}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{panel-outer}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{fancy-gold}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{fancy-gold}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{fancy-gold}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{panel-outer}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{scrollbar-thumb}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{scrollbar-thumb-hover}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{scrollbar-track}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{scrollbar-thumb}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{scrollbar-thumb-hover}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{fancy-gold}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{list-item-border-hover}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{list-item-border-hover}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{fancy-gold}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{panel-border}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{panel-hover}}" />

    <!-- Popups: the opaque tooltip box navy for menus and tooltips, the list items' blue edge -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{separator}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{list-item-border@tooltip-back@sky-top}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{title-pill}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{text}}" />

    <!-- Main menu: the menu words, their black border, separators in the top bar, the game page surface -->
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{separator}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="TextOutlineBrush" Color="{{text-outline}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{panel-outer}}" />
</ResourceDictionary>
