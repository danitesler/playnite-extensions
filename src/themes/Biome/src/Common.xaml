<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    Spacing follows the Terraria menu screens (UIPanel padding 12, list item padding 6, Back/New buttons 50px tall at
    a 1080p-sized menu), scaled to Playnite's 14px type where noted.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menus and dropdowns: the opaque tooltip box navy (23, 25, 81 at 92.5%) with the list items' blue edge,
         2px like every panel edge, rounded like UIPanel. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: the menu buttons' gold hover edge (FancyUIFatButtonMouseOver), 2px, keyboard only. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: the same edge, 3px outside the box. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The game's bordered text (Utils.DrawBorderString): the string drawn four times in black, 2px left, right, up
        and down, then once on top. Used for the menu words in the top bar, the game title and section headings. The
        host's font, size, weight and Foreground apply; Content is the text. 1.5px offsets at Playnite's sizes, like
        the game's 1.5px shadow spread for mouse text.
    -->
    <ControlTemplate x:Key="OutlinedTextTemplate" TargetType="{x:Type ContentControl}">
        <Grid>
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                       Foreground="{DynamicResource TextOutlineBrush}" TextTrimming="CharacterEllipsis">
                <TextBlock.RenderTransform><TranslateTransform X="-1.5" /></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                       Foreground="{DynamicResource TextOutlineBrush}" TextTrimming="CharacterEllipsis">
                <TextBlock.RenderTransform><TranslateTransform X="1.5" /></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                       Foreground="{DynamicResource TextOutlineBrush}" TextTrimming="CharacterEllipsis">
                <TextBlock.RenderTransform><TranslateTransform Y="-1.5" /></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                       Foreground="{DynamicResource TextOutlineBrush}" TextTrimming="CharacterEllipsis">
                <TextBlock.RenderTransform><TranslateTransform Y="1.5" /></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                       Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
        </Grid>
    </ControlTemplate>

    <!-- Section heading: the list items' white Andy name text, bold; outlined where it uses OutlinedTextTemplate. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Component spacing, keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">16,8,16,8</Thickness>          <!-- UITextPanel, 50px tall at 1080p: about 36px here -->
    <Thickness x:Key="InputPadding">10,7,10,7</Thickness>           <!-- UISearchBar in a 36px panel -->
    <Thickness x:Key="MenuPadding">0,6,0,6</Thickness>              <!-- list item padding 6 -->
    <Thickness x:Key="MenuItemPadding">14,7,14,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,6,0,6</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">14,7,14,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6,10,6</Thickness>     <!-- list item padding 6 -->
    <Thickness x:Key="GroupBoxPadding">12,12,12,12</Thickness>      <!-- UIPanel padding 12 -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,10</Thickness>
    <Thickness x:Key="TooltipPadding">10,7,10,7</Thickness>
    <sys:Double x:Key="IconSize">24</sys:Double>                    <!-- pixelarticons' own grid, one icon pixel per screen pixel -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double> <!-- Height of the background art band on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five 16:9
         thumbnails, so the real carousel replaces it without the page jumping. Rounded like the menu panels. Each
         Viewbox scales a fixed 1600px layout to its column's width (corner radii are in that layout's units). The
         tiles are the host's Foreground at low opacity; the whole thing pulses while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="24"
                        Background="{TemplateBinding Foreground}" Opacity="0.14" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="24" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="2" CornerRadius="24" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="4" CornerRadius="24" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="6" CornerRadius="24" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="8" CornerRadius="24" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
