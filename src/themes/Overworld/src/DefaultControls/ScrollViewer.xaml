<!--
    Overlay on Playnite Default/DefaultControls/ScrollViewer.xaml.
    Only the ScrollBar changes. The dashboard's scroll bar ([CSS] dotastyles.css VerticalScrollBar .ScrollThumb):
    no rail, no arrows, an 8px slate thumb (#566767: ScrollBarThumbBrush) with a faint light top edge and a dark
    right edge, a little lighter under the pointer or while dragged. The hit area is 12px. The thumb has its own keyed
    style (ScrollBarThumb) so the implicit Thumb style stays free; the whole bar rotates for horizontal scrolling.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent">
                        <Grid Width="8" HorizontalAlignment="Center" SnapsToDevicePixels="True">
                            <Border x:Name="Bar" Background="{DynamicResource ScrollBarThumbBrush}" />
                            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Opacity="0.5" />
                            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.65" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" TargetName="Bar" />
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" TargetName="Bar" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Root" Width="12" Background="{TemplateBinding Background}">
                        <Border Width="8" HorizontalAlignment="Center" IsHitTestVisible="False"
                                Background="{DynamicResource ScrollBarTrackBrush}" />
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.Resources>
                                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">32</sys:Double>
                            </Track.Resources>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="UpButton" Style="{DynamicResource ScrollBarTrackButton}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="DownButton" Style="{DynamicResource ScrollBarTrackButton}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="LayoutTransform" TargetName="Root">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="UpButton" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="DownButton" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
