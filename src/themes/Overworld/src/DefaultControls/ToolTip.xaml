<!--
    Overlay on Playnite Default/DefaultControls/ToolTip.xaml.
    The game's item tooltip ([src] TooltipRenderUtil; tooltip/background and tooltip/frame sprites in 1.21.4): a near
    black violet panel (0xF0100010: TooltipBackgroundBrush) and, inset by one sprite pixel, a 1-pixel violet frame
    fading from #5000FF at the top to #28007F at the bottom (both at alpha 0x50: TooltipBorderBrush, the frame's top
    flattened onto the panel, darkened toward the bottom by TopPanelSeparatorBrush through a mask). 2px each at GUI
    scale 2. White text (TooltipForegroundBrush), TooltipPadding. No shadow, no arrow, square corners.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource TooltipBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TooltipForegroundBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TooltipBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="{DynamicResource TooltipPadding}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border SnapsToDevicePixels="True" Background="{TemplateBinding Background}" Padding="2">
                        <Grid>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <Border BorderBrush="{DynamicResource TopPanelSeparatorBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0" />
                                        <GradientStop Color="#A0000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
