<!--
    Overlay on Playnite Default/DefaultControls/Menu.xaml.
    Overworld menu rows (Minecraft Java Edition 1.21+):
      - Rows: 30px height, 24px icon column, plain * label column, shared Auto MenuGestureColumn.
      - Highlight (stepped 90ms): black selection plate (SelectedBrush) in a 2px white pixel outline (FocusBrush) +
        6x6 splash-yellow (GlyphBrush) pixel cursor on the left; label and icon turn white.
      - Submenu open: held black plate with 1px unfocused grey outline (FocusHaloBrush) + splash-yellow pixel arrow.
      - Group break: 10px Minecraft header_separator pair (1px light over 1px dark) with 2px pixel end-caps.
      - Shortcuts: Minecraft stone keybind micro-buttons (ButtonBackgroundBrush, pixel bevel, pixel font).
      - Exit (Alt+Q): §c red icon/keycap at rest; solid §4 dark-red (DangerBrush) plate + 2px white outline + white
        label on highlight (7.66:1 contrast).
      - Checked: 14x14 dark slot with splash-yellow (GlyphBrush) pixel checkmark.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <StackPanel Margin="0,3,0,3" SnapsToDevicePixels="True">
                        <Rectangle Height="1" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
                        <Rectangle Height="1" Fill="{TemplateBinding Background}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" Margin="6,0,6,0" SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Width="2" Height="2" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Fill="{DynamicResource FocusHaloBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Rectangle Height="1" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
                            <Rectangle Height="1" Fill="{DynamicResource MenuSeparatorBrush}" />
                        </StackPanel>
                        <Rectangle Grid.Column="2" Width="2" Height="2" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Fill="{DynamicResource FocusHaloBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TopLevelHeader (preserved) -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border">
            <Grid>
                <Border x:Name="HoverBorder" Background="{DynamicResource HoverBrush}" Visibility="Collapsed" />
                <TextBlock VerticalAlignment="Center" Padding="{DynamicResource MenuItemPadding}" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>
                <Popup Placement="Bottom" VerticalOffset="0" IsOpen="{TemplateBinding IsSubmenuOpen}"
                       AllowsTransparency="True" Focusable="False">
                    <Grid MinWidth="180" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Control Template="{DynamicResource LocalOverworldMenuPanelTemplate}"
                                 Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="6,6,6,6">
                            <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="HoverBorder" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- TopLevelItem (preserved) -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Padding="{DynamicResource MenuItemPadding}" Background="Transparent">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" TargetName="Border" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeader -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- Held open plate while child submenu is open (unfocused Minecraft selection frame) -->
            <Border x:Name="OpenPlate" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="{DynamicResource SelectedBrush}"
                    BorderBrush="{DynamicResource FocusHaloBrush}" BorderThickness="1" />

            <!-- Animated stepped Minecraft focused selection frame -->
            <Border x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource SelectedBrush}"
                    BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" />
            <Rectangle x:Name="HoverCursor" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                       Width="4" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                       Fill="{DynamicResource GlyphBrush}" />

            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon"
                                  TextElement.Foreground="{DynamicResource TextBrush}" />

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center" Margin="2,0,14,0"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                <!-- Blocky 2px-cell pixel arrow -->
                <Path x:Name="Arrow" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="4,0,2,0" Width="6" Height="10"
                      Data="M 0,0 L 2,0 L 2,2 L 4,2 L 4,4 L 6,4 L 6,6 L 4,6 L 4,8 L 2,8 L 2,10 L 0,10 Z"
                      Fill="{DynamicResource TextBrushDarker}">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="ArrowShift" X="0" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Right" HorizontalOffset="2" VerticalOffset="-6"
                   Focusable="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Grid MinWidth="180" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Control Template="{DynamicResource LocalOverworldMenuPanelTemplate}"
                             Focusable="False" IsTabStop="False" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Margin="6,6,6,6">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.55" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverCursor" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.5" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="X">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="2" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.08" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.08" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverCursor" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.3" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="X">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MenuRow" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- Animated stepped Minecraft focused selection frame -->
            <Border x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource SelectedBrush}"
                    BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" />
            <Rectangle x:Name="HoverCursor" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                       Width="4" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                       Fill="{DynamicResource GlyphBrush}" />

            <!-- Danger highlight layers for Exit (Alt+Q): §4 dark red (#aa0000) with white text (7.66:1) -->
            <Border x:Name="DangerPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource DangerBrush}"
                    BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" />
            <Rectangle x:Name="DangerCursor" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                       Width="4" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                       Fill="{DynamicResource NegativeRatingBrush}" />

            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon"
                                  TextElement.Foreground="{DynamicResource TextBrush}" />

                <!-- 14x14 Minecraft slot with splash-yellow pixel checkmark -->
                <Border x:Name="GlyphPanel" Grid.Column="0" Width="14" Height="14"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                        Background="{DynamicResource CheckBoxCheckMarkBkBrush}"
                        BorderBrush="{DynamicResource FocusHaloBrush}" BorderThickness="1">
                    <Path Width="10" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0,4 L 2,4 L 2,6 L 4,6 L 4,4 L 6,4 L 6,2 L 8,2 L 8,0 L 10,0 L 10,2 L 8,2 L 8,4 L 6,4 L 6,6 L 4,6 L 4,8 L 2,8 L 2,6 L 0,6 Z"
                          Fill="{DynamicResource GlyphBrush}" />
                </Border>

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center" Margin="2,0,14,0"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                <!-- Minecraft stone keybind micro-button -->
                <Grid x:Name="GesturePlate" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border x:Name="GestureBg" Background="{DynamicResource ButtonBackgroundBrush}"
                            BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
                            <Rectangle Width="1" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" />
                            <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" />
                            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BevelShadowBrush}" />
                            <TextBlock x:Name="GestureText" Text="{TemplateBinding InputGestureText}"
                                       Margin="5,1,5,2"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ButtonForegroundBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GesturePlate" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GesturePlate" />
            </Trigger>

            <!-- Normal stepped highlight -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="GestureBg" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter TargetName="GestureBg" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="RowHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.55" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverCursor" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.5" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="RowHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.08" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.08" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverCursor" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.3" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Exit danger row (Alt+Q) at rest -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource NegativeRatingBrush}" />
                <Setter TargetName="GestureBg" Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="GestureBg" Property="BorderBrush" Value="{DynamicResource NegativeRatingBrush}" />
                <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </Trigger>
            <!-- Exit danger row highlighted -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                    <Condition Property="IsHighlighted" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HoverPlate" Property="Opacity" Value="0" />
                <Setter TargetName="HoverCursor" Property="Opacity" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="GestureBg" Property="Background" Value="{DynamicResource SelectedBrush}" />
                <Setter TargetName="GestureBg" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="DangerHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DangerPlate" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.6" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DangerCursor" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.6" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="DangerHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.08" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DangerPlate" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.08" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DangerCursor" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.3" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MenuRow" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
