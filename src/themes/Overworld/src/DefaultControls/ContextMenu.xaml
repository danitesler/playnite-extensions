<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml.
    Overworld menus (Minecraft Java Edition 1.21+ GUI):
      - Panel (LocalOverworldMenuPanelTemplate): #1e1e1e dark GUI panel (PopupBackgroundBrush) with 2px black pixel
        border (PopupBorderBrush), 2px pixel bevel (BevelLightBrush top/left, BevelShadowBrush bottom/right), and a
        subtle 1px violet tooltip inner hairline (TooltipBorderBrush). Shared by ContextMenu, submenu popups,
        ComboBox lists, ComboBoxList and FilterSelectionBox.
      - Rows: 30px tall, 24px icon column, plain * label column, shared Auto MenuGestureColumn.
      - Highlight (stepped 90ms): Minecraft AbstractSelectionList focused selection — black fill (SelectedBrush) in a
        2px white pixel outline (FocusBrush) + 6px splash-yellow (GlyphBrush) pixel cursor on the left edge; white text.
      - Group break: 10px Minecraft header_separator pair (1px light over 1px dark) with 2px pixel end-caps.
      - Shortcuts: Minecraft stone keybind micro-buttons (ButtonBackgroundBrush, black/white pixel bevel, pixel font).
      - Marked rows: Exit (Alt+Q) uses §c red icon/keycap at rest and solid §4 dark-red (DangerBrush) plate with 2px
        white pixel outline + white label on highlight (7.66:1 contrast); checked/selected rows show a 14x14 Minecraft
        slot with a splash-yellow (GlyphBrush) pixel checkmark.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalOverworldMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
            <Rectangle Fill="{DynamicResource PopupBackgroundBrush}" />
            <Rectangle Height="2" Margin="2,2,2,0" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Width="2" Margin="2,4,0,4" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Height="2" Margin="2,0,2,2" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" />
            <Rectangle Width="2" Margin="0,4,2,4" HorizontalAlignment="Right" Fill="{DynamicResource BevelShadowBrush}" />
            <Border Margin="4" BorderThickness="1" BorderBrush="{DynamicResource TooltipBorderBrush}" />
            <Border BorderThickness="2" BorderBrush="{DynamicResource PopupBorderBrush}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="MinWidth" Value="210" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Control Template="{DynamicResource LocalOverworldMenuPanelTemplate}"
                                 Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="6,6,6,6">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
