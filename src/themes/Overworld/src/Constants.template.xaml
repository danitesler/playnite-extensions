<!--
    Overworld: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from tokens.css and
    writes the result to the build as Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json): Playnite's palette keys, then shared keys for
    roles Playnite has none for. Each placeholder names the Minecraft menu token that plays the role. Theme XAML reads
    brushes only, so ThemeModifier edits reach every control.

    Layers, deepest first: void (window), deck (library, under the blurred art), rail (navigation), list veil (panels),
    popup (menus). Widgets are the game's sprites redrawn: a 1px black outline (white when highlighted), a flat fill,
    a translucent light edge top and left and a dark edge bottom and right.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography. HeadingFontFamily is the pixel font (buttons, tabs, titles); nothing is bundled. -->
    <sys:Double x:Key="FontSizeSmall">{{px:size-caption}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:size-body}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:size-lead}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:size-title}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:size-display}}</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-pixel|Consolas}}</FontFamily>

    <!-- Shape: square corners everywhere, 1px outlines, 2px frames around the current cover. -->
    <Thickness x:Key="PopupBorderThickness">{{px:stroke}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:stroke}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:stroke}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:corner-none}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Thickness x:Key="InputBorderThickness">{{px:stroke-frame}}</Thickness>
    <Thickness x:Key="FrameThickness">{{px:stroke-frame}}</Thickness>

    <!--
        Playnite palette. GlyphColor is the splash text yellow (links, selection, accents); TextColorDark is black ink
        on it. TextColor is the game's label grey #E0E0E0, TextColorDarker its inactive text #A0A0A0. HoverColor is a
        white veil so one value works on every surface.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{text}}</Color>
    <Color x:Key="TextColorDarker">{{text-soft}}</Color>
    <Color x:Key="TextColorDark">{{ink}}</Color>
    <Color x:Key="MainColor">{{panel}}</Color>
    <Color x:Key="MainColorDark">{{deck}}</Color>
    <Color x:Key="HoverColor">{{row-hover}}</Color>
    <Color x:Key="GlyphColor">{{splash}}</Color>
    <Color x:Key="HighlightGlyphColor">{{splash-soft}}</Color>
    <Color x:Key="PopupBackgroundColor">{{popup}}</Color>
    <Color x:Key="PopupBorderColor">{{popup-edge}}</Color>
    <Color x:Key="BackgroundToneColor">{{panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{panel}}</Color>
    <Color x:Key="PanelSeparatorColor">{{separator-light@panel}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{separator-light@void}}</Color>
    <Color x:Key="DataChangeNotifColor">{{splash}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{field-edge}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{tooltip}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{button}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{track}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{gold}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{red}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{void}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell: the navigation rail, the tab strip, the library layer -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{rail}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{deck}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{tab-body}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{separator-dark}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{field}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{field}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{button}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{menu-veil}}" />

    <!-- States: a white outline marks what is current or hovered, as in the game's lists and buttons -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{row-fill}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{row-fill}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{row-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{row-fill}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{row-hover}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{row-focus}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{row-unfocused}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{danger}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{white}}" />

    <!-- Buttons: the stone widget/button, Bedrock's green Play -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{button-outline}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{button-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{button}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{play}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{play-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{play-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{button-hover}}" />

    <!-- Inputs: widget/text_field, a black well with a grey 1px edge, white when focused -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{field}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{field}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{field-edge}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{field-edge-focus}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{button-outline}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{button-outline-hover}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{track}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{button}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{button-outline-hover}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{xp}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{field}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{scroller}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{field}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{scroller}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{text-soft}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{row-unfocused}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{row-focus}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{track}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{track}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{separator-dark}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{tooltip-edge@tooltip-solid}}" />

    <!-- Frames and bevels: the widget outline (black, white when highlighted), its light and dark edges, the label shadow -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{button-outline-hover}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{button-outline}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{bevel-light}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{bevel-shadow}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{text-shadow}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{white}}" />
</ResourceDictionary>
