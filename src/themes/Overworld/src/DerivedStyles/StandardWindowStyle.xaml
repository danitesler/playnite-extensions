<!--
    Overworld: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    The game's screen header turned into a 40px band: the title sits in the active tab (black body, 2px white underline, as
    the options tab bar draws it) in the pixel face with the game's 2px label shadow. The rest of the band is the menu's
    dark rail with a few 4px pixel blocks dithered into the right end, and the header separator pair (black over a 20%
    white line) closes it. Caption buttons are the 44x38 WindowBarButton pixel icons, so the caption and the content offset
    are 40 (Default: 25). PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="40" VerticalAlignment="Top" Background="{DynamicResource ShellBackgroundBrush}" ClipToBounds="True">
                                    <!-- Pixel blocks dithered into the right end, in a Canvas so they add no desired width. -->
                                    <Canvas IsHitTestVisible="False">
                                        <Path Canvas.Right="156" Canvas.Top="0" Fill="{DynamicResource TextBrush}" Opacity="0.07"
                                              Data="M0,14 h4 v4 h-4 z M8,6 h4 v4 h-4 z M12,14 h4 v4 h-4 z M12,18 h4 v4 h-4 z M16,10 h4 v4 h-4 z M20,6 h4 v4 h-4 z M20,10 h4 v4 h-4 z M24,18 h4 v4 h-4 z M32,10 h4 v4 h-4 z M40,18 h4 v4 h-4 z M44,6 h4 v4 h-4 z M44,14 h4 v4 h-4 z M52,6 h4 v4 h-4 z M56,14 h4 v4 h-4 z M72,14 h4 v4 h-4 z M84,10 h4 v4 h-4 z" />
                                        <Path Canvas.Right="156" Canvas.Top="0" Fill="{DynamicResource TextBrush}" Opacity="0.13"
                                              Data="M0,6 h4 v4 h-4 z M4,6 h4 v4 h-4 z M4,18 h4 v4 h-4 z M8,14 h4 v4 h-4 z M8,18 h4 v4 h-4 z M12,6 h4 v4 h-4 z M20,14 h4 v4 h-4 z M20,18 h4 v4 h-4 z M40,6 h4 v4 h-4 z M44,10 h4 v4 h-4 z M52,14 h4 v4 h-4 z M60,14 h4 v4 h-4 z M76,6 h4 v4 h-4 z M76,14 h4 v4 h-4 z" />
                                    </Canvas>
                                    <!-- Header separator pair: black, then 20% white. -->
                                    <StackPanel VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <Rectangle Height="1" Fill="{DynamicResource TopPanelSeparatorBrush}" />
                                        <Rectangle Height="1" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
                                    </StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <!-- The active tab: black body, 2px white underline, the pixel face with its 2px shadow. -->
                                        <Grid DockPanel.Dock="Left" Height="38" VerticalAlignment="Top" Background="{DynamicResource SelectedBrush}">
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" Margin="22,2,-2,-2" VerticalAlignment="Center" MaxWidth="440" IsHitTestVisible="False"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                                       Foreground="{DynamicResource TextShadowBrush}" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource BaseTextBlockStyle}" />
                                            <TextBlock Text="{TemplateBinding Title}" Margin="20,0,24,0" VerticalAlignment="Center" MaxWidth="440"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                                       Foreground="{DynamicResource FrameBrush}" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                            <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,2,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,40,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
