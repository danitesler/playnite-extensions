<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml.
    A cover as an entry of the game's selection lists ([src] AbstractSelectionList): it sits in a 1px black outline
    (SlotBorderBrush). Under the pointer the outline turns the unfocused selection grey (#808080:
    GridViewItemHoverBorderBrush); the current game gets the focused selection, a 2px white outline
    (GridViewItemSelectedBorderBrush) around a 1px black ring.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <ContentPresenter />
                        <Border x:Name="SelectionBorder" BorderThickness="1" Margin="-1" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource SlotBorderBrush}" />
                        <Border x:Name="SelectionRing" BorderThickness="2" Margin="-3" IsHitTestVisible="False" Visibility="Collapsed"
                                BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" />
                        <!-- Running game: the XP bar, nine XP-green segments on a black track across the cover's foot, inside the
                             cover where the outlines never reach. Fills in steps while launching. -->
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="8" Opacity="0.18" />
                            <Grid RenderOptions.EdgeMode="Aliased">
                                <Grid.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,8,6" ViewportUnits="Absolute" Viewbox="0,0,8,6" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#FF000000">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,8,4" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Grid.OpacityMask>
                                <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.3">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.31" />
                                            <GradientStop x:Name="RunningScanLead" Color="#FF000000" Offset="-0.308" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.01" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="-0.008" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                            <Grid Height="5" Margin="6,0,6,6" VerticalAlignment="Bottom" RenderOptions.EdgeMode="Aliased">
                                <Rectangle Fill="{DynamicResource SlotBorderBrush}" />
                                <UniformGrid x:Name="RunningFill" Margin="1" Rows="1" Columns="9">
                                    <UniformGrid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningFillHead" Color="#FF000000" Offset="1" />
                                            <GradientStop x:Name="RunningFillEdge" Color="#00000000" Offset="1.002" />
                                        </LinearGradientBrush>
                                    </UniformGrid.OpacityMask>
                                    <Rectangle Margin="0,0,1,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                                    <Rectangle Margin="0,0,1,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                                    <Rectangle Margin="0,0,1,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                                    <Rectangle Margin="0,0,1,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                                    <Rectangle Margin="0,0,1,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                                    <Rectangle Margin="0,0,1,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                                    <Rectangle Margin="0,0,1,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                                    <Rectangle Margin="0,0,1,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                                    <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" />
                                </UniformGrid>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemHoverBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="BorderThickness" Value="2" TargetName="SelectionBorder" />
                            <Setter Property="Margin" Value="-2" TargetName="SelectionBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource SlotBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="BorderThickness" Value="1" TargetName="SelectionBorder" />
                            <Setter Property="Margin" Value="-1" TargetName="SelectionBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectionRing" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.31" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.0" KeySpline="0.6,0,0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanLead" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.308" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.002" KeySpline="0.6,0,0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.002" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.01" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.3" KeySpline="0.6,0,0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.008" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.302" KeySpline="0.6,0,0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.302" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.6,0,0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.002" KeySpline="0.6,0,0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.002" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
