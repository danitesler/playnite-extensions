<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemTemplate.xaml: the cover and its hover controls.
    The Play and Info buttons are the game's square icon buttons ([px] widget/button at GUI scale 2, 40px): BevelTemplate
    stone plates, Play in Bedrock's green (PrimaryButtonBackgroundBrush), Info in plain stone (ButtonBackgroundBrush).
    Info shows the plain stone fill through name triggers in the template. Solid pixel glyphs (play, info, download: 2px cells, drawn here because Pixelarticons only has outlines at this size) with the game's label shadow, 2px down and right (TextShadowBrush).
    Like the game, nothing fades: the buttons pop in over three 60ms steps, rising 6, 3, then 0px; the highlight
    (white outline, lighter fill) is instant; the glyph hops 4px and settles to 2px; two gold pixels glint and blink out
    (the splash text color); pressing drops the glyph 2px onto its shadow. Hover motion follows the Windows
    animation setting, and every storyboard targets names inside the template that owns its trigger.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="GridTileButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SlotBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Control x:Name="Plate" Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False"
                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                        <Grid x:Name="Glyph" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform />
                            </Grid.RenderTransform>
                            <ContentControl x:Name="Shadow" Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{DynamicResource TextShadowBrush}" Margin="2,2,-2,-2" Focusable="False" />
                            <ContentControl Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{TemplateBinding Foreground}" Focusable="False" />
                        </Grid>
                        <!-- Two gold pixels, the splash text color, that blink at opposite corners of the plate on hover. -->
                        <Rectangle x:Name="GlintA" Width="4" Height="4" Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource MixedRatingBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Rectangle x:Name="GlintB" Width="4" Height="4" Margin="5,0,0,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource MixedRatingBrush}" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Info is plain stone with the same highlight ramp as every other button; Play keeps the green. -->
                        <Trigger Property="Name" Value="PART_ButtonInfo">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Name" Value="PART_ButtonInfo" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Name" Value="PART_ButtonInfo" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                        </MultiTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="-2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlintA" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.16" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.28" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlintB" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.40" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.48" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="GlintA" Property="Opacity" Value="0" />
                            <Setter TargetName="GlintB" Property="Opacity" Value="0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlintA" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlintB" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shadow" Property="Margin" Value="0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="2" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-2" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="{DynamicResource GridItemBackgroundBrush}">
                        <StackPanel Name="PART_PanelHost" d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                            <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}">
                                <Image Name="PART_ImageCover" RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="{Settings CoverArtStretch}" />
                                <Border Background="{DynamicResource ScrimBrush}" x:Name="TextGameName" Visibility="Collapsed">
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Margin="5" Style="{StaticResource BaseTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Background="{DynamicResource ScrimBrush}" Opacity="0.65" x:Name="UninstalledShade" Visibility="Collapsed" />
                                <Border Background="{DynamicResource ScrimBrush}" Opacity="0" x:Name="BorderMouseOver" IsHitTestVisible="False" />
                                <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" Name="GameControls" MaxWidth="124" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Name="PART_ButtonPlay" Opacity="0" Style="{StaticResource GridTileButton}" Margin="20,0,2,0" VerticalAlignment="Center">
                                            <Button.Content>
                                                <StreamGeometry>F1 M7 2h2v20H7z M9 4h2v16H9z M11 6h2v12h-2z M13 8h2v8h-2z M15 10h2v4h-2z</StreamGeometry>
                                            </Button.Content>
                                            <Button.RenderTransform>
                                                <TranslateTransform Y="6" />
                                            </Button.RenderTransform>
                                        </Button>
                                        <Button Name="PART_ButtonInfo" Opacity="0" Style="{StaticResource GridTileButton}" Margin="2,0,20,0" VerticalAlignment="Center">
                                            <Button.Content>
                                                <StreamGeometry>F1 M10 3h4v4h-4z M8 9h6v10h2v2H8v-2h2v-8H8z</StreamGeometry>
                                            </Button.Content>
                                            <Button.RenderTransform>
                                                <TranslateTransform Y="6" />
                                            </Button.RenderTransform>
                                        </Button>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource BaseTextBlockStyle}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Padding="2,5,2,5" Grid.Row="1" Grid.Column="0" Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" TargetName="PART_ButtonPlay">
                                <Setter.Value>
                                    <StreamGeometry>F1 M10 3h4v9h4v2h-2v2h-2v2h-4v-2H8v-2H6v-2h4z M5 20h14v2H5z</StreamGeometry>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="UninstalledShade" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <!-- Pop in over three 60ms steps, no fade: 6px low and half there, 3px low and full, then in place. -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="6" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="6" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
