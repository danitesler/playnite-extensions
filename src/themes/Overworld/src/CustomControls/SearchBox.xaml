<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    The dashboard's search field ([CSS] dashboard.css #TopBarSearchBox, #SearchTextEntry, #SearchButton): a
    transparent well with an edge (2px faint teal in the top strip, set by TopPanelSearchBox; 1px grey elsewhere),
    black on hover, placeholder text in the muted grey, the search glyph at the right like the game's button
    ([CSS] #SearchButton wash #667774, hover lighter). Keyboard focus brightens the edge.
    PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon are Playnite's parts (all three must exist); Playnite
    hides PART_SeachIcon while the box has focus or text, so it carries the placeholder.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource InputBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Chrome" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock x:Name="PART_SeachIcon" Margin="10,0,36,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Foreground="{DynamicResource TextBrushDarker}" Opacity="0.75"
                                       Text="{DynamicResource LOCSearchLabel}" />
                            <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                     Padding="8,0,58,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                <ContentControl x:Name="PART_ClearTextIcon" Margin="0,0,8,0" Focusable="False" IsTabStop="False"
                                                VerticalAlignment="Center" Cursor="Hand" Background="Transparent"
                                                Foreground="{DynamicResource TextBrushDarker}"
                                                ContentTemplate="{DynamicResource ClearTextIconTemplate}" />
                                <ContentControl x:Name="Glyph" Focusable="False" IsTabStop="False"
                                                VerticalAlignment="Center" IsHitTestVisible="False"
                                                Foreground="{DynamicResource TextBrushDarker}"
                                                ContentTemplate="{DynamicResource SearchTextIconTemplate}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Chrome" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Chrome" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glyph" />
                            <Setter Property="Padding" Value="8,0,32,0" TargetName="PART_TextInpuText" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
