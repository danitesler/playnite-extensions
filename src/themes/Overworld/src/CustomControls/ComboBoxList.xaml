<!--
    Overworld ComboBoxList: multi-select dropdown wearing LocalOverworldMenuPanelTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ComboBoxList}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SlotBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxList}">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False"
                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                        <DockPanel>
                            <Button x:Name="PART_ButtonClearFilter" DockPanel.Dock="Right"
                                    Style="{DynamicResource PropertyItemButton}"
                                    Content="r" FontFamily="Marlett" Margin="0,0,4,0" FontSize="12"
                                    Visibility="{TemplateBinding ShowClearButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid DockPanel.Dock="Left">
                                <ToggleButton x:Name="PART_ToggleDropDown" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <DockPanel LastChildFill="False" Background="Transparent">
                                                <ContentPresenter x:Name="Chevron" DockPanel.Dock="Right" Margin="0,0,8,0" Width="12" Height="12"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource ButtonForegroundBrush}"
                                                                  Content="{DynamicResource IconDropDown}"
                                                                  ContentTemplate="{DynamicResource IconSmallTemplate}" />
                                            </DockPanel>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBlock x:Name="PART_TextFilterString" IsHitTestVisible="False" VerticalAlignment="Center"
                                           Margin="8,0,26,0" Style="{DynamicResource BaseTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <Popup x:Name="PART_Popup" IsOpen="{Binding IsChecked, ElementName=PART_ToggleDropDown}"
                                       Placement="Bottom" VerticalOffset="2" Focusable="False" AllowsTransparency="True" StaysOpen="False">
                                    <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                          SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Control Template="{DynamicResource LocalOverworldMenuPanelTemplate}"
                                                 Focusable="False" IsTabStop="False" />
                                        <ItemsControl x:Name="PART_ItemsPanel" Margin="8,8,8,8"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ItemsControl.Template>
                                                <ControlTemplate TargetType="{x:Type ItemsControl}">
                                                    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </ControlTemplate>
                                            </ItemsControl.Template>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
                        </Trigger>
                        <Trigger SourceName="PART_ToggleDropDown" Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
