<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    One of the title screen's icon buttons ([src] TitleScreen Language / Accessibility buttons, 20x20; [px]
    button.png): a 40x40 stone plate (BevelTemplate: ButtonBackgroundBrush, 2px black outline SlotBorderBrush) with
    the pixel icon in white, centred in a 64x52 cell of the rail.
    - Hover and current: the game's highlighted sprite ([px] button_highlighted.png): white outline (FrameBrush),
      lighter fill (ButtonHoverBackgroundBrush). The current item also keeps a 2px white marker on the rail's outer
      edge, so it stays clear while another item is hovered.
    - Top or bottom bar (fallback): the same plate with the title in the pixel font, at least 120px wide.
    Library and Statistics get this theme's icons; add-on items keep their own icon; the title is the tooltip.
    PART_ProgressStatus is a 2px bar along the edge facing the library.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SlotBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Marker" Width="2" Height="24" HorizontalAlignment="Left" Visibility="Collapsed"
                                   Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />

                        <Grid x:Name="Plate" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Control Template="{DynamicResource BevelTemplate}" Focusable="False" IsTabStop="False"
                                     Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                            <Grid x:Name="IconHost" Width="16" Height="16" Margin="0,0,0,2">
                                <Viewbox x:Name="ItemIcon">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Viewbox>
                                <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                ContentTemplate="{DynamicResource IconTemplate}" />
                            </Grid>
                            <Grid x:Name="Title" Visibility="Collapsed" Margin="18,0,18,2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Margin="1,1,-1,-1" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                           Foreground="{DynamicResource TextShadowBrush}" Text="{Binding Title}" />
                                <TextBlock FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                           Text="{Binding Title}" />
                            </Grid>
                        </Grid>

                        <ProgressBar x:Name="PART_ProgressStatus" Width="2" HorizontalAlignment="Right"
                                     BorderThickness="0" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Marker" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="PART_ProgressStatus" />
                            <Setter Property="HorizontalAlignment" Value="Right" TargetName="Marker" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Visible" TargetName="Title" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="IconHost" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Marker" />
                            <Setter Property="Width" Value="{x:Static sys:Double.NaN}" TargetName="Plate" />
                            <Setter Property="MinWidth" Value="120" TargetName="Plate" />
                            <Setter Property="Margin" Value="4,0,4,0" TargetName="Plate" />
                            <Setter Property="Width" Value="{x:Static sys:Double.NaN}" TargetName="PART_ProgressStatus" />
                            <Setter Property="Height" Value="2" TargetName="PART_ProgressStatus" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="PART_ProgressStatus" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="PART_ProgressStatus" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Visible" TargetName="Title" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="IconHost" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Marker" />
                            <Setter Property="Width" Value="{x:Static sys:Double.NaN}" TargetName="Plate" />
                            <Setter Property="MinWidth" Value="120" TargetName="Plate" />
                            <Setter Property="Margin" Value="4,0,4,0" TargetName="Plate" />
                            <Setter Property="Width" Value="{x:Static sys:Double.NaN}" TargetName="PART_ProgressStatus" />
                            <Setter Property="Height" Value="2" TargetName="PART_ProgressStatus" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="PART_ProgressStatus" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="PART_ProgressStatus" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="62" />
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Height" Value="62" />
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
