<!--
    Overlay on Playnite Default/CustomControls/SliderEx.xaml (grid zoom slider, settings). Theme files load one by one
    after DefaultControls, so the StaticResource resolves to this theme's Slider style (DefaultControls/Slider.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SliderEx}" BasedOn="{StaticResource {x:Type Slider}}" />
</ResourceDictionary>
