<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    The Minecraft menus are built from a few marks, all drawn here from brushes of the hosting Control:
    - BevelTemplate: widget/button, the stone plate. At GUI scale 2 (the sizes this theme uses): a 2px outline
      (black; white when highlighted), the flat fill, a 2px light edge top and left, a 4px dark edge at the bottom and
      2px at the right ([px] button.png rows 1, 17-18, column 1 and 18).
    - DividerTemplate: header_separator.png, a 1px light line over a 1px dark line.
    - HeadingTextBlock: the pixel font in white.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- widget/button ([px] button.png, button_highlighted.png): host Background is the fill, host BorderBrush the
         outline. Host: a Control stretched behind the content, hit testing off. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle Height="2" Margin="2,2,2,0" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Width="2" Margin="2,4,0,6" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Height="4" Margin="2,0,2,2" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" />
            <Rectangle Width="2" Margin="0,4,2,6" HorizontalAlignment="Right" Fill="{DynamicResource BevelShadowBrush}" />
            <Border BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- header_separator.png ([px] white at 20% over black at 75%), as wide as its parent. Host: a Control. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="{x:Type Control}">
        <StackPanel Height="2" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Rectangle Height="1" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
            <Rectangle Height="1" Fill="{DynamicResource TopPanelSeparatorBrush}" />
        </StackPanel>
    </ControlTemplate>

    <!-- Caption above a block: the pixel font in the inactive grey ([src] #A0A0A0). -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
    </Style>

    <!-- Keyboard focus (keyboard only): the game's highlighted outline, 2px white just outside the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="2" Stroke="{DynamicResource FocusBrush}"
                               SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing, at GUI scale 2: 40px buttons ([src] Button height 20), 40px text fields ([src] EditBox
         height 20, text inset 4), list rows of the selection lists. -->
    <Thickness x:Key="ButtonPadding">18,4,18,4</Thickness> <!-- widget/button: 40px, centered label (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">8,4,8,4</Thickness> <!-- widget/text_field: 36 to 40px, text inset 8 (height now set by ControlHeight) -->
    <Thickness x:Key="MenuPadding">2</Thickness> <!-- popup: rows inside the 2px outline -->
    <Thickness x:Key="MenuItemPadding">14,7,14,7</Thickness> <!-- list row -->
    <Thickness x:Key="ComboBoxDropDownPadding">2</Thickness> <!-- popup -->
    <Thickness x:Key="ComboBoxItemPadding">12,7,12,7</Thickness> <!-- list row -->
    <Thickness x:Key="ListBoxItemPadding">12,6,12,6</Thickness> <!-- list row -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness> <!-- Group box body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness> <!-- Gap under the group box header -->
    <Thickness x:Key="TooltipPadding">8,6,8,6</Thickness> <!-- [src] TooltipRenderUtil padding 3 (4 at scale 2, plus line gap) -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">24</sys:Double> <!-- Pixelarticons' own grid: one icon pixel per screen pixel -->
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails. The tiles are the host's Foreground at low opacity; the whole thing pulses while visible.
         Host: a Control with Foreground set and hit testing off, next to the plugin's ContentControl. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" Background="{TemplateBinding Foreground}" Opacity="0.15" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <UniformGrid Width="1600" Height="173" Rows="1" Columns="5">
                    <Border Margin="0,0,13,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="6,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="6,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="6,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Margin="13,0,0,0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                </UniformGrid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- menu-mark begin LocalOverworldMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a crafting grid, nine pixel cells, the centre one solid. Hover (IsMouseOver): the stone button presses in, the grid jumps 1px down and right and the eight outer cells brighten to full, all in one discrete step (the game has no easing). Open (ContextMenu.IsOpen of the nearest Border): the centre cell becomes the accent item and bobs like a dropped item in four stepped 1px moves (1s loop) until the menu closes; exits restore every property. -->
    <ControlTemplate x:Key="LocalOverworldMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Canvas x:Name="Press" Width="20" Height="20">
                    <Canvas.RenderTransform><TranslateTransform x:Name="PressT" X="0" Y="0" /></Canvas.RenderTransform>
                    <Canvas x:Name="Cells" Width="20" Height="20" Opacity="0.6">
                        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="6" Height="6" Fill="{TemplateBinding Foreground}" />
                        <Rectangle Canvas.Left="7" Canvas.Top="0" Width="6" Height="6" Fill="{TemplateBinding Foreground}" />
                        <Rectangle Canvas.Left="14" Canvas.Top="0" Width="6" Height="6" Fill="{TemplateBinding Foreground}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="7" Width="6" Height="6" Fill="{TemplateBinding Foreground}" />
                        <Rectangle Canvas.Left="14" Canvas.Top="7" Width="6" Height="6" Fill="{TemplateBinding Foreground}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="14" Width="6" Height="6" Fill="{TemplateBinding Foreground}" />
                        <Rectangle Canvas.Left="7" Canvas.Top="14" Width="6" Height="6" Fill="{TemplateBinding Foreground}" />
                        <Rectangle Canvas.Left="14" Canvas.Top="14" Width="6" Height="6" Fill="{TemplateBinding Foreground}" />
                    </Canvas>
                    <Rectangle Canvas.Left="7" Canvas.Top="7" Width="6" Height="6" Fill="{TemplateBinding Foreground}" />
                    <Rectangle x:Name="Item" Canvas.Left="7" Canvas.Top="7" Width="6" Height="6" Fill="{DynamicResource GlyphBrush}" Opacity="0">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="ItemT" X="0" Y="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressT" Storyboard.TargetProperty="X"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="1" /></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressT" Storyboard.TargetProperty="Y"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="1" /></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Cells" Storyboard.TargetProperty="Opacity"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="1" /></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.060" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.060" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Cells" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.060" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Item" Storyboard.TargetProperty="Opacity"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="1" /></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ItemT" Storyboard.TargetProperty="Y" RepeatBehavior="Forever"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.250" Value="-1" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.500" Value="-2" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.750" Value="-1" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.000" Value="0" /></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Item" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.060" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ItemT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.060" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalOverworldMenuMarkTemplate -->
</ResourceDictionary>
