<!--
    Overlay on Playnite Default/Views/ExplorerPanel.xaml: Playnite's panel on the game's list background
    (menu_list_background.png flattened: NormalBrush), so it reads over the blurred library art. Layout, parts and keyed
    styles stay Playnite's (BasedOn the Default style, which loads before this file).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ExplorerPanel}" BasedOn="{StaticResource {x:Type ExplorerPanel}}">
        <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
    </Style>
</ResourceDictionary>
