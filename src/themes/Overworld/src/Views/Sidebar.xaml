<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    The title screen's icon buttons ([src] TitleScreen: the 20x20 Language and Accessibility buttons beside the main
    column) stacked into a navigation rail on the left (repo rule, Playnite's default Sidebar position): a 64px rail on
    the darkest surface (ShellBackgroundBrush) closed on the library side by header_separator.png turned on its side
    (a 1px light line, then a 1px dark line). At the top the main menu button, a stone widget/button (BevelTemplate
    look: ButtonBackgroundBrush, 2px black outline, white when highlighted) with the pixel menu icon; under it a short
    separator, then the items (SidebarItem.xaml), one stone icon button each.
    Fallbacks: right mirrors the rail; top and bottom lay the same buttons out in a row (146px kept clear for the
    caption buttons at the top).
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Main menu button: the stone plate drawn by the Border itself (fill and 2px outline) plus the bevel edges and
         the icon from its content. Also used by Views/TopPanel.xaml when the sidebar is hidden. -->
    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SlotBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid x:Name="Root" Width="44" Background="{DynamicResource ShellBackgroundBrush}">
                        <!-- header_separator.png on the edge facing the library: light, then dark. -->
                        <Border x:Name="RuleOuter" BorderBrush="{DynamicResource TopPanelSeparatorBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                        <Border x:Name="RuleInner" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,1,0"
                                Margin="0,0,1,0" IsHitTestVisible="False" />

                        <DockPanel x:Name="DockContentHolder" Margin="0,0,2,0">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}" DockPanel.Dock="Top"
                                    Margin="0,6,0,0">
                                <Grid>
                                    <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
                                    <Rectangle Width="2" Margin="0,2,0,4" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" />
                                    <Rectangle Height="4" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" />
                                    <Rectangle Width="2" Margin="0,2,0,4" HorizontalAlignment="Right" Fill="{DynamicResource BevelShadowBrush}" />
                                    <ContentPresenter Width="16" Height="16" Margin="0,0,0,2"
                                                      Content="{DynamicResource IconMainMenu}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Grid>
                            </Border>

                            <StackPanel x:Name="Separator" DockPanel.Dock="Top" Orientation="Vertical" Width="28"
                                        HorizontalAlignment="Center" Margin="0,10,0,4" IsHitTestVisible="False">
                                <Rectangle x:Name="SeparatorLight" Height="1" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
                                <Rectangle x:Name="SeparatorDark" Height="1" Fill="{DynamicResource TopPanelSeparatorBrush}" />
                            </StackPanel>

                            <ScrollViewer x:Name="ScrollSidebarItems" DockPanel.Dock="Top"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="True">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="RuleOuter" />
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="RuleInner" />
                            <Setter Property="Margin" Value="1,0,0,0" TargetName="RuleInner" />
                            <Setter Property="Margin" Value="2,0,0,0" TargetName="DockContentHolder" />
                            <Setter Property="Margin" Value="0,46,0,0" TargetName="PART_ElemMainMenu" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="RuleOuter" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="RuleInner" />
                            <Setter Property="Margin" Value="0,0,0,1" TargetName="RuleInner" />
                            <Setter Property="Margin" Value="0,0,0,2" TargetName="DockContentHolder" />
                            <Setter Property="Margin" Value="12,0,0,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="Separator" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="Separator" />
                            <Setter Property="Width" Value="2" TargetName="Separator" />
                            <Setter Property="Height" Value="40" TargetName="Separator" />
                            <Setter Property="Margin" Value="10,0,6,0" TargetName="Separator" />
                            <Setter Property="VerticalAlignment" Value="Center" TargetName="Separator" />
                            <Setter Property="Width" Value="1" TargetName="SeparatorDark" />
                            <Setter Property="Height" Value="40" TargetName="SeparatorDark" />
                            <Setter Property="Width" Value="1" TargetName="SeparatorLight" />
                            <Setter Property="Height" Value="40" TargetName="SeparatorLight" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,146,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="RuleOuter" />
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="RuleInner" />
                            <Setter Property="Margin" Value="0,1,0,0" TargetName="RuleInner" />
                            <Setter Property="Margin" Value="0,2,0,0" TargetName="DockContentHolder" />
                            <Setter Property="Margin" Value="12,0,0,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Separator" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
