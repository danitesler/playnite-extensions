<!--
    Mann Co spacing and focus. The spec is the TF2 menu: tight, square, a little cramped. Buttons are short and wide,
    list rows are one text line plus 6px, nothing breathes more than it has to.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Keyboard focus: a dashed tan rectangle just outside the control, like the dotted marquee on a TF2 button. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="1" StrokeDashArray="2 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section headings on the game page: bold HeadingFontFamily over a one-line margin, in HeadingForegroundBrush. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Thickness x:Key="ButtonPadding">14,6</Thickness>
    <Thickness x:Key="InputPadding">8,5</Thickness>
    <Thickness x:Key="MenuPadding">3</Thickness>
    <Thickness x:Key="MenuItemPadding">10,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">3</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">12</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <sys:Double x:Key="IconSize">18</sys:Double>

    <!-- Default banner height; ThemeModifier edits it (0 turns the banner off). -->
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
</ResourceDictionary>
