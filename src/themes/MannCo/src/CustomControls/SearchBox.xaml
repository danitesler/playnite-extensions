<!--
    Mann Co SearchBox: the entry box with a search glyph at its left and a clear glyph at its right. Keeps all three
    PART_ names. TopPanelSearchBox is the top bar's variant (a washed strip that darkens on hover and focus).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <ContentControl x:Name="Glyph"
                                        ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"
                                        Foreground="{DynamicResource GlyphBrush}" Panel.ZIndex="1" IsHitTestVisible="False" />
                            <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                        <TextBox MinHeight="0" x:Name="PART_TextInpuText"
                                 VerticalContentAlignment="Center" Padding="28,0,28,0"/>
                        <ContentControl x:Name="PART_ClearTextIcon"
                                        ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                        FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                                        Foreground="{DynamicResource TextBrushDarker}">
                            <ContentControl.Template>
                                <ControlTemplate TargetType="ContentControl">
                                    <Border Background="Transparent">
                                        <ContentPresenter ContentSource="Content" />
                                    </Border>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>
                    </Grid>
                <ControlTemplate.Triggers>
                        <!-- Keep the magnifier visible while Playnite hides its placeholder. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Strip" Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <ContentControl x:Name="Glyph"
                                            ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"
                                            Foreground="{DynamicResource GlyphBrush}" Panel.ZIndex="1" IsHitTestVisible="False" />
                            <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                            <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     VerticalContentAlignment="Center" Padding="30,0,28,0"/>
                            <ContentControl x:Name="PART_ClearTextIcon"
                                            ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                            FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                                            Foreground="{DynamicResource TextBrushDarker}">
                                <ContentControl.Template>
                                    <ControlTemplate TargetType="ContentControl">
                                        <Border Background="Transparent">
                                            <ContentPresenter ContentSource="Content" />
                                        </Border>
                                    </ControlTemplate>
                                </ContentControl.Template>
                            </ContentControl>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" TargetName="Strip" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Strip" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" TargetName="Strip" />
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Strip" />
                        </Trigger>

                        <!-- Keep the magnifier visible while Playnite hides its placeholder. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
