<!--
    Mann Co grid view game panel. The side panel of the grid view: the details view skeleton in a narrower column, captions beside values.
    Skeleton: banner (HeroArt, GameBannerHeight), spacer scaled from the banner by MathConverter, header, then two
    columns: Steam screenshots, notes and description on the left; the metadata pane on the right in six collapsing
    groups (MetaProgress, MetaScores, MetaAbout, MetaTags, MetaLibrary, MetaLinks). The pane is a paper-edged card on
    ExpanderBackgroundBrush; captions are bold HeadingFontFamily in muted text; tags are small square chips.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Steam Screenshots skeleton: a 16:9 main frame over five thumbnails, flat 2px-radius plates, pulsing in the host foreground. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Pulse" Width="320" Height="220" Opacity="0.25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" />
                <UniformGrid Grid.Row="2" Rows="1" Columns="5">
                    <Border Margin="0,0,3,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" />
                    <Border Margin="1.5,0,1.5,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" />
                    <Border Margin="1.5,0,1.5,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" />
                    <Border Margin="1.5,0,1.5,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" />
                    <Border Margin="3,0,0,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" />
                </UniformGrid>
            </Grid>
        </Viewbox>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                             From="0.25" To="0.6" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                       Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ScrollViewer CanContentScroll="False" x:Name="PART_ScrollViewHost" HorizontalAlignment="Stretch"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"
                                          Style="{DynamicResource DetailsScrollViewer}">
                                <Grid>
                                    <Border x:Name="HeroArt" VerticalAlignment="Top" ClipToBounds="True"
                                            Height="{DynamicResource GameBannerHeight}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border>
                                            <Border.CacheMode>
                                                <BitmapCache />
                                            </Border.CacheMode>
                                            <Grid>
                                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                           HorizontalAlignment="Center" VerticalAlignment="Top">
                                                    <FadeImage.ImageOpacityMask>
                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                            <GradientStop Color="Black" Offset="0.35" />
                                                            <GradientStop Color="Transparent" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </FadeImage.ImageOpacityMask>
                                                </FadeImage>
                                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                                <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                                <Rectangle Fill="{DynamicResource GameOverviewBackgroundBrush}" Opacity="0.8">
                                                    <Rectangle.OpacityMask>
                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                            <GradientStop Color="Transparent" Offset="0.45" />
                                                            <GradientStop Color="Black" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                            </Grid>
                                        </Border>
                                    </Border>
                                    <Grid Margin="20,0,20,20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="GridBannerSpacer" Grid.Row="0" MinHeight="20">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 80 / 340'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="20" />
                                                        </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="20" />
</DataTrigger>
</Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <DockPanel Panel.ZIndex="2" Grid.Row="1" Margin="0,0,0,16">
                                            <DockPanel Panel.ZIndex="2" DockPanel.Dock="Top">
                                                <Button x:Name="InlineSidePanelCloseButton" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" Width="28" Height="28" Padding="0"
                                                    Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}" Command="{MainViewModel CloseGameSideBarCommand}"
                                                    Template="{Binding Template, ElementName=SidePanelCloseButton}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="{Binding Tag, ElementName=SidePanelCloseButton, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Visible` : `Collapsed`'}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                        <Button.RenderTransform>
                                                            <TranslateTransform Y="{Binding ContentVerticalOffset, ElementName=PART_ScrollViewHost}" />
                                                        </Button.RenderTransform>
                                                </Button>
                                                <Image Name="PART_ImageIcon" DockPanel.Dock="Left" MaxHeight="32" MaxWidth="32"
                                                       RenderOptions.BitmapScalingMode="Fant" Margin="0,0,10,0" />
                                                <TextBlock Name="PART_TextDisplayName" DockPanel.Dock="Left" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                                           FontSize="{DynamicResource FontSizeLargest}" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource HeadingForegroundBrush}" />
                                            </DockPanel>
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                                        HorizontalAlignment="Left" Margin="0,12,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Name="PART_ButtonPlayAction" Width="150" Height="40"
                                                            Style="{DynamicResource PlayButton}" />
                                                    <Button Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" Grid.Column="1" Width="150" Height="40" />
                                                    <Control Grid.ColumnSpan="2" Style="{DynamicResource RunningActionIndicator}" />
                                                </Grid>
                                                <Button Width="40" Name="PART_ButtonMoreActions"
                                                        Height="40" Margin="8,0,0,0"
                                                ToolTip="{DynamicResource LOCMoreAction}" Padding="0">
                                            <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                            Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                        </Button>
                                                <Button Padding="0" Width="40" x:Name="PART_ButtonEditGame"
                                                        Margin="8,0,0,0" Height="40" Focusable="False"
                                                        Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}" ToolTip="{DynamicResource LOCEditGame}">
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Two columns: screenshots, notes and description on the left, the narrower metadata pane on the right -->
                                        <Grid Grid.Row="2" x:Name="GridOverviewBody">
<Grid.Tag>
    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400">
        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Tag" ElementName="GridMetadataContent" />
    </MultiBinding>
</Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                            <Grid x:Name="GridMetadataColumn" VerticalAlignment="Top">
<Grid.Style><Style TargetType="Grid">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="Margin" Value="24,0,0,0" />
    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </DataTrigger></Style.Triggers>
</Style></Grid.Style>
<Border Margin="0,0,0,0" Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                                                    BorderThickness="{DynamicResource ControlBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="16,4,16,4" VerticalAlignment="Top">
                                                <Border.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                        <Style.Triggers>
                                                            <Trigger Property="Tag" Value="Caption">
                                                                <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                                <Setter Property="VerticalAlignment" Value="Top" />
                                                                <Setter Property="Margin" Value="0,1,8,0" />
                                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                </Border.Resources>
                                                <Border ClipToBounds="True" Tag="{DynamicResource GridDetailsPaneWidth}" x:Name="GridMetadataContent" HorizontalAlignment="Stretch">
<Border.Style>
    <Style TargetType="Border">
        <Setter Property="Width" Value="{DynamicResource GridDetailsPaneWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource GridDetailsPaneWidth}" /><Style.Triggers>
            <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /></DataTrigger>
        <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers>
    </Style>
</Border.Style>
                                                    <WrapPanel x:Name="GridMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-1,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-1,-24,0" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="GridMetadataContent" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                        <Border x:Name="MetaProgress"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataContent" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                    <Setter Property="Padding" Value="0,8,0,8" />
                                                                    <Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCompletionStatus" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" Tag="Caption" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <Button Grid.Column="2" Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPlayTime" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" Tag="Caption" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemLastPlayed" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" Tag="Caption" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemRecentActivity" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Tag="Caption" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAdded" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Tag="Caption" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataContent" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                    <Setter Property="Padding" Value="0,8,0,8" />
                                                                    <Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCommunityScore" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" Tag="Caption" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" Name="PART_TextCommunityScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemCriticScore" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCriticScore}" Tag="Caption" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" Name="PART_TextCriticScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemUserScore" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCUserScore}" Tag="Caption" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="2" Name="PART_TextUserScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataContent" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                    <Setter Property="Padding" Value="0,8,0,8" />
                                                                    <Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemDevelopers" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDeveloperLabel}" Tag="Caption" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <ItemsControl Grid.Column="2" Name="PART_ItemsDevelopers" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPublishers" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="3*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCPublisherLabel}" Tag="Caption" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                    <ItemsControl Grid.Column="2" Name="PART_ItemsPublishers" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemReleaseDate" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="12" />
