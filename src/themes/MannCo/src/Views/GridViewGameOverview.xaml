<!--
    Mann Co grid view game panel. The side panel of the grid view: the details view skeleton in a narrower column, captions above values.
    Skeleton: banner (HeroArt, GameBannerHeight), spacer scaled from the banner by MathConverter, header, then two
    columns: Steam screenshots, notes and description on the left; the metadata pane on the right in six collapsing
    groups (MetaProgress, MetaScores, MetaAbout, MetaTags, MetaLibrary, MetaLinks). The pane is a paper-edged card on
    ExpanderBackgroundBrush; captions are bold HeadingFontFamily in muted text; tags are small square chips.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Steam Screenshots skeleton: a 16:9 main frame over five thumbnails, flat 2px-radius plates, pulsing in the host foreground. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Pulse" Width="320" Height="220" Opacity="0.25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" />
                <UniformGrid Grid.Row="2" Rows="1" Columns="5">
                    <Border Margin="0,0,3,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" />
                    <Border Margin="1.5,0,1.5,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" />
                    <Border Margin="1.5,0,1.5,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" />
                    <Border Margin="1.5,0,1.5,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" />
                    <Border Margin="3,0,0,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Foreground}" />
                </UniformGrid>
            </Grid>
        </Viewbox>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                         From="0.25" To="0.6" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            Background="{DynamicResource GameOverviewBackgroundBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                       Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalAlignment="Stretch"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          Style="{DynamicResource DetailsScrollViewer}">
                                <Grid>
                                    <Border x:Name="HeroArt" VerticalAlignment="Top" ClipToBounds="True"
                                            Height="{DynamicResource GameBannerHeight}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border>
                                            <Border.CacheMode>
                                                <BitmapCache />
                                            </Border.CacheMode>
                                            <Grid>
                                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                           HorizontalAlignment="Center" VerticalAlignment="Top">
                                                    <FadeImage.ImageOpacityMask>
                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                            <GradientStop Color="Black" Offset="0.35" />
                                                            <GradientStop Color="Transparent" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </FadeImage.ImageOpacityMask>
                                                </FadeImage>
                                                <Rectangle Fill="{DynamicResource GameOverviewBackgroundBrush}" Opacity="0.8">
                                                    <Rectangle.OpacityMask>
                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                            <GradientStop Color="Transparent" Offset="0.45" />
                                                            <GradientStop Color="Black" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                            </Grid>
                                        </Border>
                                    </Border>
                                    <Grid Margin="20,0,20,20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="BannerSpacer" Grid.Row="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 80 / 340'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="40" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <DockPanel Grid.Row="1" Margin="0,0,0,16">
                                            <DockPanel DockPanel.Dock="Top">
                                                <Image Name="PART_ImageIcon" DockPanel.Dock="Left" MaxHeight="32" MaxWidth="32"
                                                       RenderOptions.BitmapScalingMode="Fant" Margin="0,0,10,0" />
                                                <TextBlock Name="PART_TextDisplayName" DockPanel.Dock="Left" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                                           FontSize="{DynamicResource FontSizeLarger}" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource HeadingForegroundBrush}" />
                                            </DockPanel>
                                            <Grid DockPanel.Dock="Top" Margin="0,12,0,0" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MaxWidth="150" />
                                                    <ColumnDefinition Width="*" MaxWidth="150" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Name="PART_ButtonPlayAction" Grid.Column="0" Height="40"
                                                        Style="{DynamicResource PlayButton}" />
                                                <Button Name="PART_ButtonContextAction" Grid.Column="0" Height="40" />
                                                <Button Name="PART_ButtonMoreActions" Content="{DynamicResource LOCMoreAction}"
                                                        Grid.Column="1" Height="40" Margin="8,0,0,0" />
                                                <Button x:Name="PART_ButtonEditGame" Grid.Column="2"
                                                        Margin="8,0,0,0" Height="40" Focusable="False"
                                                        Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </DockPanel>

                                        <!-- Two columns: screenshots, notes and description on the left, the narrower metadata pane on the right -->
                                        <DockPanel Grid.Row="2">
                                            <Border DockPanel.Dock="Right" Width="{DynamicResource GridDetailsPaneWidth}" Margin="24,0,0,0" Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                                                    BorderThickness="{DynamicResource ControlBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="16,4,16,4" VerticalAlignment="Top">
                                                <Border.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                        <Style.Triggers>
                                                            <Trigger Property="Tag" Value="Caption">
                                                                <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                                <Setter Property="VerticalAlignment" Value="Top" />
                                                                <Setter Property="Margin" Value="0,1,8,0" />
                                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                </Border.Resources>
                                                <Border ClipToBounds="True">
                                                    <StackPanel Margin="0,-1,0,0">
                                                        <Border x:Name="MetaProgress">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                    <Setter Property="Padding" Value="0,8,0,8" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemCompletionStatus" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <Button Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemPlayTime" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <TextBlock Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemLastPlayed" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <TextBlock Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemRecentActivity" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <TextBlock Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemAdded" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <TextBlock Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                    <Setter Property="Padding" Value="0,8,0,8" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemCommunityScore" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <TextBlock Name="PART_TextCommunityScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemCriticScore" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCCriticScore}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <TextBlock Name="PART_TextCriticScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemUserScore" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCUserScore}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <TextBlock Name="PART_TextUserScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                    <Setter Property="Padding" Value="0,8,0,8" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemDevelopers" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCDeveloperLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <ItemsControl Name="PART_ItemsDevelopers" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemPublishers" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCPublisherLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <ItemsControl Name="PART_ItemsPublishers" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemReleaseDate" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <Button Name="PART_ButtonReleaseDate" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemSeries" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCSeriesLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <ItemsControl Name="PART_ItemsSeries" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemAgeRating" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <ItemsControl Name="PART_ItemsAgeRatings" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemRegion" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCRegionLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <ItemsControl Name="PART_ItemsRegions" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaTags">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                    <Setter Property="Padding" Value="0,8,0,8" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemPlatform" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCPlatformTitle}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <ItemsControl Name="PART_ItemsPlatforms" Tag="Chip">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemGenres" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCGenreLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <ItemsControl Name="PART_ItemsGenres" Tag="Chip">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemCategories" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCGameCategoriesTitle}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <ItemsControl Name="PART_ItemsCategories" Tag="Chip">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemFeatures" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <ItemsControl Name="PART_ItemsFeatures" Tag="Chip">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemTags" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCTagsLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <ItemsControl Name="PART_ItemsTags" Tag="Chip">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaLibrary">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                    <Setter Property="Padding" Value="0,8,0,8" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemLibrary" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <Button Name="PART_ButtonLibrary" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemSource" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCSourceLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <Button Name="PART_ButtonSource" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemVersion" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCVersionLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <Button Name="PART_ButtonVersion" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemInstallSize" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <TextBlock Name="PART_TextInstallSize" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemInstallDirectory" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <Button Name="PART_ButtonInstallDirectory" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaLinks">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                    <Setter Property="Padding" Value="0,8,0,8" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemLinks" Margin="0,4,0,4">
                                                                    <TextBlock Text="{DynamicResource LOCLinksLabel}" Tag="Caption" Margin="0,0,0,3" />
                                                                    <ItemsControl Name="PART_ItemsLinks" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                            <StackPanel DockPanel.Dock="Left">
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second. The skeleton shows for Steam games in that gap, for at most 12s. With the plugin missing or disabled the binding falls back to PluginUnavailable, which matches neither value. -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                        <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                            <Storyboard>
                                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <StackPanel Margin="0,0,0,16">
                                                        <Grid>
                                                            <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" Focusable="False" />
                                                            <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}"
                                                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                                <Control.Style>
                                                                    <Style TargetType="Control">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Control.Style>
                                                            </Control>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Name="PART_ElemNotes" Margin="0,0,0,16">
                                                    <TextBlock Text="{DynamicResource LOCNotesLabel}" Style="{DynamicResource HeadingTextBlock}" />
                                                    <TextBox Name="PART_TextNotes" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                         Background="Transparent" BorderThickness="0" Padding="0" />
                                                </StackPanel>
                                                <StackPanel Name="PART_ElemDescription">
                                                    <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Style="{DynamicResource HeadingTextBlock}" />
                                                    <HtmlTextView Name="PART_HtmlDescription"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"
                                                                  Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>

                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Content="r" FontFamily="Marlett"
                                    Style="{DynamicResource SimpleButton}"
                                    Command="{MainViewModel CloseGameSideBarCommand}"
                                    Margin="0,10,15,0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
