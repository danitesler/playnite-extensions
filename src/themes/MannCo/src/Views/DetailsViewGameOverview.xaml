<!--
    Mann Co details view game page. The right pane of the details view.
    Skeleton: banner (HeroArt, GameBannerHeight), spacer scaled from the banner by MathConverter, header, then two
    columns: Steam screenshots, notes and description on the left; the metadata pane on the right in six collapsing
    groups (MetaProgress, MetaScores, MetaAbout, MetaTags, MetaLibrary, MetaLinks). The pane is a paper-edged card on
    ExpanderBackgroundBrush; captions are bold HeadingFontFamily in muted text; tags are small square chips.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1280"
                                  d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid Background="{DynamicResource GameOverviewBackgroundBrush}">
                            <Border x:Name="HeroArt" VerticalAlignment="Top" ClipToBounds="True"
                                    Height="{DynamicResource GameBannerHeight}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border>
                                    <Border.CacheMode>
                                        <BitmapCache />
                                    </Border.CacheMode>
                                    <Grid>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <FadeImage.ImageOpacityMask>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="Black" Offset="0.35" />
                                                    <GradientStop Color="Transparent" Offset="1" />
                                                </LinearGradientBrush>
                                            </FadeImage.ImageOpacityMask>
                                        </FadeImage>
                                        <Rectangle Fill="{DynamicResource GameOverviewBackgroundBrush}" Opacity="0.8">
                                            <Rectangle.OpacityMask>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="Transparent" Offset="0.45" />
                                                    <GradientStop Color="Black" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Grid>
                                </Border>
                            </Border>
                            <Grid HorizontalAlignment="Stretch" Margin="24,0,24,24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="BannerSpacer" Grid.Row="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 180 / 340'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <DockPanel Margin="0,0,0,20" MaxWidth="1100" Grid.Row="1" Background="Transparent">
                                    <Border DockPanel.Dock="Right" VerticalAlignment="Bottom"
                                            BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="2">
                                        <Image Name="PART_ImageCover" Height="{Settings GameDetailsCoverHeight}"
                                               StretchDirection="Both" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="Fant" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom" DockPanel.Dock="Left">
                                        <DockPanel>
                                            <Image Name="PART_ImageIcon" MaxHeight="48" MaxWidth="48"
                                                   DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock Name="PART_TextDisplayName" DockPanel.Dock="Left" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                                       FontSize="{DynamicResource FontSizeLargest}" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource HeadingForegroundBrush}" />
                                        </DockPanel>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Name="PART_ButtonPlayAction" Width="150" Height="40"
                                                    Style="{DynamicResource PlayButton}" />
                                            <Button Name="PART_ButtonContextAction" Width="150" Height="40" />
                                            <Button Name="PART_ButtonMoreActions" Content="{DynamicResource LOCMoreAction}"
                                                    Width="150" Height="40" Margin="8,0,0,0" />
                                            <Button x:Name="PART_ButtonEditGame"
                                                    Margin="8,0,0,0" Height="40" Focusable="False"
                                                    Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <DockPanel MaxWidth="1100" Grid.Row="2">
                                    <StackPanel DockPanel.Dock="Right" Width="{DynamicResource GameDetailsPaneWidth}" Margin="24,0,0,0">
                                        <Border Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                                                BorderThickness="{DynamicResource ControlBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="16,4,16,4" VerticalAlignment="Top">
                                            <Border.Resources>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Tag" Value="Caption">
                                                            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                            <Setter Property="VerticalAlignment" Value="Top" />
                                                            <Setter Property="Margin" Value="0,1,8,0" />
                                                            <Setter Property="TextWrapping" Value="Wrap" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </Border.Resources>
                                            <Border ClipToBounds="True">
                                                <StackPanel Margin="0,-1,0,0">
                                                    <Border x:Name="MetaProgress">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                <Setter Property="Padding" Value="0,8,0,8" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemCompletionStatus" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCompletionStatus}" Tag="Caption" />
                                                                <Button Name="PART_ButtonCompletionStatus" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemPlayTime" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCTimePlayed}" Tag="Caption" />
                                                                <TextBlock Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemLastPlayed" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCLastPlayed}" Tag="Caption" />
                                                                <TextBlock Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemRecentActivity" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Tag="Caption" />
                                                                <TextBlock Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemAdded" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Tag="Caption" />
                                                                <TextBlock Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="1" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaScores">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                <Setter Property="Padding" Value="0,8,0,8" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemCommunityScore" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCommunityScore}" Tag="Caption" />
                                                                <TextBlock Name="PART_TextCommunityScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemCriticScore" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCriticScore}" Tag="Caption" />
                                                                <TextBlock Name="PART_TextCriticScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemUserScore" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCUserScore}" Tag="Caption" />
                                                                <TextBlock Name="PART_TextUserScore" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" Grid.Column="1" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaAbout">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                <Setter Property="Padding" Value="0,8,0,8" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemDevelopers" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCDeveloperLabel}" Tag="Caption" />
                                                                <ItemsControl Name="PART_ItemsDevelopers" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemPublishers" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCPublisherLabel}" Tag="Caption" />
                                                                <ItemsControl Name="PART_ItemsPublishers" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemReleaseDate" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Tag="Caption" />
                                                                <Button Name="PART_ButtonReleaseDate" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemSeries" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCSeriesLabel}" Tag="Caption" />
                                                                <ItemsControl Name="PART_ItemsSeries" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemAgeRating" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Tag="Caption" />
                                                                <ItemsControl Name="PART_ItemsAgeRatings" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemRegion" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCRegionLabel}" Tag="Caption" />
                                                                <ItemsControl Name="PART_ItemsRegions" Grid.Column="1" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaTags">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                <Setter Property="Padding" Value="0,8,0,8" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemPlatform" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCPlatformTitle}" Tag="Caption" />
                                                                <ItemsControl Name="PART_ItemsPlatforms" Tag="Chip">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Grid.Column="1" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemGenres" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGenreLabel}" Tag="Caption" />
                                                                <ItemsControl Name="PART_ItemsGenres" Tag="Chip">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Grid.Column="1" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemCategories" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGameCategoriesTitle}" Tag="Caption" />
                                                                <ItemsControl Name="PART_ItemsCategories" Tag="Chip">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Grid.Column="1" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemFeatures" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Tag="Caption" />
                                                                <ItemsControl Name="PART_ItemsFeatures" Tag="Chip">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Grid.Column="1" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemTags" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCTagsLabel}" Tag="Caption" />
                                                                <ItemsControl Name="PART_ItemsTags" Tag="Chip">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Grid.Column="1" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaLibrary">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                <Setter Property="Padding" Value="0,8,0,8" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemLibrary" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Tag="Caption" />
                                                                <Button Name="PART_ButtonLibrary" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemSource" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCSourceLabel}" Tag="Caption" />
                                                                <Button Name="PART_ButtonSource" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemVersion" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCVersionLabel}" Tag="Caption" />
                                                                <Button Name="PART_ButtonVersion" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemInstallSize" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" Tag="Caption" />
                                                                <TextBlock Name="PART_TextInstallSize" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="1" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemInstallDirectory" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" Tag="Caption" />
                                                                <Button Name="PART_ButtonInstallDirectory" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaLinks">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                                                                <Setter Property="Padding" Value="0,8,0,8" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemLinks" Margin="0,4,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCLinksLabel}" Tag="Caption" />
                                                                <ItemsControl Name="PART_ItemsLinks" Grid.Column="1" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                            <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" Margin="0,0,0,16" Focusable="False"
                                                            Visibility="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=PluginUnavailable}" />
                                            <StackPanel Name="PART_ElemNotes" Margin="0,0,0,16">
                                                <TextBlock Text="{DynamicResource LOCNotesLabel}" Style="{DynamicResource HeadingTextBlock}" />
                                                <TextBox Name="PART_TextNotes" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                     Background="Transparent" BorderThickness="0" Padding="0" />
                                            </StackPanel>
                                            <StackPanel Name="PART_ElemDescription">
                                                <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Style="{DynamicResource HeadingTextBlock}" />
                                                <HtmlTextView Name="PART_HtmlDescription"
                                                              HtmlFontSize="{DynamicResource FontSize}"
                                                              HtmlFontFamily="{DynamicResource FontFamily}"
                                                              HtmlForeground="{DynamicResource TextColor}"
                                                              LinkForeground="{DynamicResource GlyphColor}"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                              pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                            </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
