<!--
    Mann Co: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). TF2's token names stay in tokens.css; each
    placeholder here names the token that plays the key's role.
    Dark brown surfaces, tan paper for the things you press, rust for hover, orange for the accent, RED and BLU for
    the two sides of the top bar rule. Theme XAML reads brushes only, never Color keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys) -->
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSize">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">14</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">31</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Verdana}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Trebuchet MS}}</FontFamily>

    <!-- Shape (Playnite keys) -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-large}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:radius-xlarge}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{tan-light}}</Color>                  <!-- label text: S1 Label.TextColor -->
    <Color x:Key="TextColorDarker">{{gray}}</Color>                 <!-- muted text -->
    <Color x:Key="TextColorDark">{{tan-darker}}</Color>             <!-- ink on tan or orange fills -->
    <Color x:Key="MainColor">{{brown-mid}}</Color>                  <!-- control fill -->
    <Color x:Key="MainColorDark">{{brown-dark}}</Color>             <!-- raised surface -->
    <Color x:Key="HoverColor">{{rust}}</Color>                      <!-- S1 Button.ArmedBgColor -->
    <Color x:Key="GlyphColor">{{orange}}</Color>                    <!-- accent: checked, links, progress -->
    <Color x:Key="HighlightGlyphColor">{{orange/55}}</Color>
    <Color x:Key="PopupBackgroundColor">{{brown-dark}}</Color>
    <Color x:Key="PopupBorderColor">{{tan-dark}}</Color>            <!-- S1 DarkComboBoxBorder -->
    <Color x:Key="BackgroundToneColor">{{brown-lighter}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{brown-mid}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{tan-dark/50}}</Color>
    <Color x:Key="DataChangeNotifColor">{{amber}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{tan-dark}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{tan-light}}" />   <!-- paper tooltip with ink text -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{tan-dark}}" />     <!-- S1 Button.BgColor -->
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{transparent-black}}" />   <!-- S1 CheckButton.BgColor -->
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{success}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{red-bright}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{quality-unique}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{amber}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{brown-lighter}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{brown-darkest}}" />

    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{brown-dark}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{brown-dark}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{black-wash}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{transparent-black}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{tan-darker}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{team-red}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{team-blu}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{tan-darker}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{rust}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{red-solid}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{tan-light}}" />

    <!-- Buttons: tan-dark rest, rust hover, tan flash while pressed, red Play -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{rust}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{tan-darker}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{team-red}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{tan-darker}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{rust-bright}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{tan-light}}" />

    <!-- Inputs: black-washed boxes with a tan-dark edge that turns tan when hot -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{black-wash}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{transparent-black}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{tan-dark}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{tan-light}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{yellow}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{slider-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{slider-knob}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{rust-bright}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{rust}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{black-wash}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{tan-dark}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{black-wash}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{tan-dark}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{team-red}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{tan-dark}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{brown-dark}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{rust}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{tan-darker}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{brown-mid}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{tan-light}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{rust}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{tan-dark/60}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{tan-darker}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{tan-darker}}" />

    <!-- Typography colors -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{tan-light}}" />

    <!-- Game page -->
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{brown-darkest}}" />
    <sys:Double x:Key="GameDetailsPaneWidth">340</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double>

</ResourceDictionary>
