<!--
    Starlane: DerivedStyles/StandardWindowStyle.xaml (Settings, Add-ons, Game Editor, every dialog).
    Pure OLED #000000 space with subtle starfield backdrop and a 44px minimalist title band
    (CaptionHeight=44, ContentPresenter Margin="0,44,0,0"):
    Crawl-Yellow Astrogation Star-Compass mark, Hollow-Yellow Outlined Star Wars movie title
    (OutlinedTextTemplate bound to hidden PART_TextTitle inside a Collapsed parent), glowing Blue
    Lightsaber underline beam, ghosted watermark, and 46x43 WindowBarButton caption keys.
    WindowDesignStyle is standalone (never BasedOn StandardWindowStyle).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource FrameBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Subtle OLED deep-space starfield across dialog backdrop -->
                                <Rectangle Fill="{DynamicResource TextBrush}" Opacity="0.22"
                                           OpacityMask="{DynamicResource LocalStarfieldMaskBrush}"
                                           IsHitTestVisible="False" />

                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- Hidden PART_TextTitle wrapped inside Collapsed parent so Playnite never leaks bare text -->
                                <Border Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                               Width="0" Height="0" Opacity="0" Foreground="Transparent" />
                                </Border>

                                <!-- 44px Minimalist OLED Star Wars Opening Title Band -->
                                <Grid Height="44" VerticalAlignment="Top"
                                      Background="{DynamicResource WindowTitleBackgroundBrush}"
                                      ClipToBounds="True" SnapsToDevicePixels="True">
                                    <!-- Ghosted Astrogation Star-Compass watermark in zero-size Canvas -->
                                    <Grid HorizontalAlignment="Right" Margin="0,0,152,0" Width="64" IsHitTestVisible="False">
                                        <Canvas Width="0" Height="44" HorizontalAlignment="Right">
                                            <Control Canvas.Left="-64" Canvas.Top="-10" Width="64" Height="64"
                                                     Template="{DynamicResource BrandMarkTemplate}"
                                                     Foreground="{DynamicResource GlyphBrush}" Opacity="0.09" />
                                        </Canvas>
                                    </Grid>

                                    <!-- Whisper hairline + glowing white-cored Blue Lightsaber underline under title -->
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource WindowPanelSeparatorBrush}" IsHitTestVisible="False" />
                                    <Rectangle Height="12" Width="170" Margin="14,0,0,-5" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                               Fill="{DynamicResource BeamBrush}" Opacity="0.88"
                                               OpacityMask="{DynamicResource LocalSaberBeamHMaskBrush}" IsHitTestVisible="False" />
                                    <Rectangle Height="1.5" Width="140" Margin="18,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                               Fill="{DynamicResource LocalWhiteCoreBrush}" IsHitTestVisible="False" />

                                    <DockPanel LastChildFill="True" Height="43" VerticalAlignment="Top">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>

                                        <Control DockPanel.Dock="Left" Width="20" Height="20" Margin="16,0,12,0"
                                                 Template="{DynamicResource BrandMarkTemplate}"
                                                 Foreground="{DynamicResource GlyphBrush}"
                                                 VerticalAlignment="Center" IsHitTestVisible="False" />

                                        <!-- Hollow-Yellow Outlined Star Wars Title -->
                                        <ContentControl VerticalAlignment="Center" Margin="0,0,12,0"
                                                        Content="{Binding Text, ElementName=PART_TextTitle}"
                                                        FontFamily="{DynamicResource PosterFontFamily}"
                                                        FontSize="16" FontWeight="Bold"
                                                        Template="{DynamicResource OutlinedTextTemplate}"
                                                        IsHitTestVisible="False" />
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter Property="Text" Value="{DynamicResource LOCSettingsLabel}" TargetName="PART_TextTitle" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource BeamBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
