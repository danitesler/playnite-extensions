<!--
    Starlane: DerivedStyles/PlayButton.xaml (+ RunningActionIndicator).
    Hero Moment — Full-Width Igniting Lightsaber Blade:
    - Idle: sleek full-width obsidian-blue blade plate framed in Jedi Blue (#28A8FF) with Orbitron Bold label.
    - Hover: lightsaber ignition — white-hot top/bottom plasma core rails, Jedi Blue outer beams (saber-beam-h.png),
      perimeter aura (saber-frame.png), and deep blue interior wash extend left-to-right (ScaleX 0 -> 1) over 220ms
      while an ignition tip flash surges across the blade, then transitions into a subtle living plasma hum + drifting
      energy shimmer while hovered; mouse-leave smoothly retracts the blade back to the left edge.
    - Press: crisp +1px mechanical press + bright white-hot lightsaber clash flash.
    - Launching / Running: plate switches to solid Consular Green (RunningIndicatorBrush #18C958) darkened
      by RunningBreath scrim (>= 4.5:1 label contrast), sweeping bright emerald lightsaber core (RunningScan),
      and RunningActionIndicator draws the glowing foot blade + 3 staggered Consular Green lightsaber power pips
      in reserved PlayRoom right padding (28px, zero overlap).
    - Running + Hover (RelativeSource Self): switches to Sith Red Lightsaber (DangerBrush #E52222) Cancel
      (PlayContent Visibility="Hidden", never Collapsed).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BeamBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="148" />
        <Setter Property="Padding" Value="22,0,22,0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PressShift" Y="0" />
                        </Grid.RenderTransform>

                        <!-- Ignited Jedi Blue Lightsaber Outer Aura & Extending Beams (Collapsed at rest; host suppressed while launching/running) -->
                        <Grid x:Name="HoverOuterHost" IsHitTestVisible="False">
                            <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                <Grid x:Name="HoverHumLayer" Opacity="1">
                                    <!-- Full-width outer perimeter plasma bloom -->
                                    <Rectangle Margin="-12,-9" Fill="{DynamicResource BeamBrush}" Opacity="0.90"
                                               OpacityMask="{DynamicResource LocalSaberFrameMaskBrush}"
                                               RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="HoverAuraScale" ScaleX="0.08" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <!-- Top extending lightsaber beam halo -->
                                    <Rectangle Height="18" VerticalAlignment="Top" Margin="-6,-9,-6,0"
                                               Fill="{DynamicResource BeamBrush}" Opacity="0.96"
                                               OpacityMask="{DynamicResource LocalSaberBeamHMaskBrush}"
                                               RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="SaberTopScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <!-- Bottom extending lightsaber beam halo -->
                                    <Rectangle Height="18" VerticalAlignment="Bottom" Margin="-6,0,-6,-9"
                                               Fill="{DynamicResource BeamBrush}" Opacity="0.86"
                                               OpacityMask="{DynamicResource LocalSaberBeamHMaskBrush}"
                                               RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="SaberBotScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Main Full-Width Blade Plate -->
                        <Border x:Name="PlayFill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <!-- Idle beam tint over OLED black (recolors live with ThemeModifier BeamBrush) -->
                                <Border x:Name="IdleBeamWash" Background="{DynamicResource BeamBrush}"
                                        Opacity="0.16" IsHitTestVisible="False" />

                                <!-- Inner hover plasma host (suppressed cleanly while launching/running) -->
                                <Grid x:Name="HoverInnerHost" IsHitTestVisible="False">
                                    <!-- Hover interior plasma wash (ignites left-to-right) -->
                                    <Border x:Name="HoverWash" Background="{DynamicResource BeamBrush}"
                                            Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="HoverWashScale" ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>

                                    <!-- Continuous living plasma current drifting across blade while hovered -->
                                    <Border x:Name="PlasmaCurrent" Visibility="Collapsed" Opacity="0.22" IsHitTestVisible="False"
                                            Background="{DynamicResource LocalWhiteCoreBrush}">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop x:Name="PlasmaTail" Color="#00000000" Offset="-0.45" />
                                                <GradientStop x:Name="PlasmaMid" Color="#FF000000" Offset="-0.20" />
                                                <GradientStop x:Name="PlasmaHead" Color="#00000000" Offset="0.05" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>

                                    <!-- One-shot white-hot lightsaber ignition flare sweeping left-to-right on hover -->
                                    <Border x:Name="IgniteFlare" Visibility="Collapsed" Opacity="0.62" IsHitTestVisible="False"
                                            Background="{DynamicResource LocalWhiteCoreBrush}">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop x:Name="FlareTail" Color="#00000000" Offset="-0.38" />
                                                <GradientStop x:Name="FlareCore" Color="#FF000000" Offset="-0.12" />
                                                <GradientStop x:Name="FlareEdge" Color="#00000000" Offset="0.02" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>

                                    <!-- Top & bottom white-hot lightsaber core rails extending left-to-right inside rim -->
                                    <Rectangle x:Name="SaberCoreTop" Height="1.5" VerticalAlignment="Top"
                                               Visibility="Collapsed" Opacity="0.95" IsHitTestVisible="False"
                                               Fill="{DynamicResource LocalWhiteCoreBrush}" RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="SaberCoreTopScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle x:Name="SaberCoreBot" Height="1.5" VerticalAlignment="Bottom"
                                               Visibility="Collapsed" Opacity="0.95" IsHitTestVisible="False"
                                               Fill="{DynamicResource LocalWhiteCoreBrush}" RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="SaberCoreBotScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>

                                <!-- Running / Launching scrim darkening solid RunningIndicatorBrush for >= 4.5:1 white text -->
                                <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}"
                                        Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

                                <!-- Launching horizontal Consular Green plasma ignition sweep -->
                                <Border x:Name="RunningScan" Visibility="Collapsed" IsHitTestVisible="False"
                                        Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>

                                <!-- Running + Hover Sith Red Cancel plate & dim scrim (below label) -->
                                <Border x:Name="RunningHoverDim" Background="{DynamicResource DangerBrush}"
                                        Opacity="0" IsHitTestVisible="False" />

                                <!-- Press clash flash layer -->
                                <Border x:Name="PressFlash" Background="{DynamicResource LocalWhiteCoreBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Label Room: reserves right strip for RunningActionIndicator pips while launching/running -->
                                <Border x:Name="PlayRoom">
                                    <Grid>
                                        <ContentPresenter x:Name="PlayContent" Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                                   Visibility="Collapsed" Opacity="0"
                                                   Margin="{TemplateBinding Padding}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="Bold" Foreground="{DynamicResource DangerForegroundBrush}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource LocalWhiteCoreBrush}" />
                            <Trigger.EnterActions>
                                <!-- Lightsaber snap-hiss ignition (extends left-to-right + tip flare surge) -->
                                <BeginStoryboard Name="PlayHoverIgnite">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlasmaCurrent" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IgniteFlare" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.34" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SaberCoreTop" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SaberCoreBot" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>

                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="0.48" Duration="0:0:0.16" />

                                        <DoubleAnimation Storyboard.TargetName="HoverAuraScale" Storyboard.TargetProperty="ScaleX" From="0.08" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberTopScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberBotScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberCoreTopScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberCoreBotScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverWashScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <!-- White-hot ignition plasma surge racing left-to-right -->
                                        <DoubleAnimation Storyboard.TargetName="FlareTail" Storyboard.TargetProperty="Offset" From="-0.38" To="1.05" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="FlareCore" Storyboard.TargetProperty="Offset" From="-0.12" To="1.32" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="FlareEdge" Storyboard.TargetProperty="Offset" From="0.02" To="1.45" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>

                                <!-- Living lightsaber kyber hum + drifting plasma current while hovered -->
                                <BeginStoryboard Name="PlayHoverHum">
                                    <Storyboard BeginTime="0:0:0.22" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverHumLayer" Storyboard.TargetProperty="Opacity" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="0.78" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.62" Value="0.97" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.02" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.0" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlasmaTail" Storyboard.TargetProperty="Offset" Duration="0:0:2.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.05" KeySpline="0.35,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1.05" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlasmaMid" Storyboard.TargetProperty="Offset" Duration="0:0:2.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.20" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.30" KeySpline="0.35,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1.30" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlasmaHead" Storyboard.TargetProperty="Offset" Duration="0:0:2.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.05" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.55" KeySpline="0.35,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1.55" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayHoverHum" />
                                <!-- Smooth lightsaber blade retraction back to left edge -->
                                <BeginStoryboard Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SaberTopScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberBotScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberCoreTopScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberCoreBotScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverWashScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverAuraScale" Storyboard.TargetProperty="ScaleX" To="0.08" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.19" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlasmaCurrent" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IgniteFlare" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SaberCoreTop" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.17" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SaberCoreBot" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.17" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="PlayPressIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressFlash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressFlash" Storyboard.TargetProperty="Opacity" Duration="0:0:0.14">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.04" Value="0.38" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="0.18" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.07" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="PlayPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressFlash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressFlash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- RunningMarkRoom left="0" right="28" -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PlayFill" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource LocalSaberGreenBrightBrush}" />
                            <Setter TargetName="IdleBeamWash" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverOuterHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverInnerHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,28,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,28,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="LaunchingScrimHold">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.54" To="0.64" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                                <RemoveStoryboard BeginStoryboardName="LaunchingScrimHold" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PlayFill" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource LocalSaberGreenBrightBrush}" />
                            <Setter TargetName="IdleBeamWash" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverOuterHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverInnerHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,28,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,28,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.44" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.58" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.44" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Running + Self Hover: Sith Red Cancel Saber -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource LocalWhiteCoreBrush}" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="CancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="CancelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Overlay laid over the Play / ContextAction cell: Consular Green frame, foot blade & 3 staggered lightsaber pips -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.95" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                BorderThickness="1.5" CornerRadius="{DynamicResource ControlCornerRadius}" />

                        <!-- Glowing Consular Green foot progress blade -->
                        <Grid Height="2" Margin="6,0,6,4" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalWhiteCoreBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <!-- Three staggered vertical Consular Green Lightsaber power pips (right end, clear of label) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Height="14">
                            <Border x:Name="Pip1" Width="3" Height="10" Margin="0,0,3,0" CornerRadius="1.5"
                                    Background="{DynamicResource LocalWhiteCoreBrush}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="Pip1Y" ScaleY="0.55" /></Border.RenderTransform>
                            </Border>
                            <Border x:Name="Pip2" Width="3" Height="14" Margin="0,0,3,0" CornerRadius="1.5"
                                    Background="{DynamicResource LocalWhiteCoreBrush}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="Pip2Y" ScaleY="0.95" /></Border.RenderTransform>
                            </Border>
                            <Border x:Name="Pip3" Width="3" Height="10" CornerRadius="1.5"
                                    Background="{DynamicResource LocalWhiteCoreBrush}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="Pip3Y" ScaleY="0.7" /></Border.RenderTransform>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.58" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip1Y" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0.45" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="1.1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip2Y" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.5" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.15" Value="1.15" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.6" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip3Y" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="0.45" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.25" Value="1.1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.58" Value="0.55" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip1Y" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip2Y" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.95" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.6" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.95" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip3Y" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.05" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
