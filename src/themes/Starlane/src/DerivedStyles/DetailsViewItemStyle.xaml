<!--
    Starlane: DerivedStyles/DetailsViewItemStyle.xaml.
    Minimalist OLED game rows:
    - Hover: smooth whisper wash + RowHoverAction (26x26 transparent Play/Install glyph) with 38px RowHoverRoom.
    - Selected: ignites vertical Jedi Blue Lightsaber beam (2px white core + saber-beam-v.png blue aura)
      over a calm #081826 wash with crisp white text.
    - Launching / Running: Consular Green Lightsaber ignition sweep (RunningScan), glowing foot blade
      (RunningFill), RunningMarkPlate, and 3 staggered green lightsaber power pips inside 32px RowRoom.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="6,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Animated Hover Wash (Collapsed at rest) -->
                        <Border x:Name="HoverPlate" Background="{DynamicResource ListItemHoverBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                        <!-- Animated Selected Layer: Vertical Lightsaber Beam (recolors live with ThemeModifier BeamBrush) -->
                        <Grid x:Name="SelectedPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Background="{DynamicResource BeamBrush}" Opacity="0.16"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Rectangle Width="26" HorizontalAlignment="Left" Margin="0,1"
                                       Fill="{DynamicResource BeamBrush}" Opacity="0.92"
                                       OpacityMask="{DynamicResource LocalSaberBeamVMaskBrush}" />
                            <Border x:Name="SelectedCore" Width="2" HorizontalAlignment="Left" Margin="1,5" CornerRadius="1"
                                    Background="{DynamicResource LocalWhiteCoreBrush}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SelectedCoreY" ScaleY="0.25" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <!-- Running / Launching Consular Green Lightsaber Indicator (above hover/selection) -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.95" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.16" />
                            <Border x:Name="RunningMarkPlate" Width="36" HorizontalAlignment="Right" Margin="1"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningScan" Visibility="Collapsed" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource LocalSaberGreenBrightBrush}" Opacity="0.42">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid Height="2" Margin="4,0,4,1" VerticalAlignment="Bottom">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.32" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalSaberGreenBrightBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                    BorderThickness="3,1,1,1" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Height="12">
                                <Border Width="2.5" Height="8" Margin="0,0,2.5,0" CornerRadius="1" Background="{DynamicResource LocalWhiteCoreBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="RowPip1Y" ScaleY="0.55" /></Border.RenderTransform>
                                </Border>
                                <Border Width="2.5" Height="12" Margin="0,0,2.5,0" CornerRadius="1" Background="{DynamicResource LocalWhiteCoreBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="RowPip2Y" ScaleY="0.95" /></Border.RenderTransform>
                                </Border>
                                <Border Width="2.5" Height="9" CornerRadius="1" Background="{DynamicResource LocalWhiteCoreBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="RowPip3Y" ScaleY="0.7" /></Border.RenderTransform>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Content with RowRoom (running) and RowHoverRoom (hover action) -->
                        <Border x:Name="RowRoom">
                            <Border x:Name="RowHoverRoom">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Border>

                        <!-- RowHoverAction -->
                        <Button x:Name="RowHoverPlay" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0" Focusable="False" Cursor="Hand"
                                Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{TemplateBinding Foreground}" Focusable="False" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Width" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Height" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="RowHoverInstall" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0" Focusable="False" Cursor="Hand"
                                Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl Content="{DynamicResource IconDownload}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{TemplateBinding Foreground}" Focusable="False" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Width" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Height" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0.68" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowSelIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedCoreY" Storyboard.TargetProperty="ScaleY" From="0.25" To="1" Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowSelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,32,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalWhiteCoreBrush}" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowPip1Y" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0.45" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="1.15" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.45" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowPip2Y" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.5" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.15" Value="1.15" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.55" Value="0.6" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,32,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalWhiteCoreBrush}" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RowPip2Y" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.95" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.95" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
