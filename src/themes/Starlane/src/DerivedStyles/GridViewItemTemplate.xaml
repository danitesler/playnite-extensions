<!--
    Starlane: DerivedStyles/GridViewItemTemplate.xaml.
    Minimalist OLED cover template + 50x50 (>= 48x48 mandate) lightsaber-igniting GridTileButton overlay controls:
    - PART_ButtonPlay (left): Jedi Blue lightsaber igniting right-to-left (RenderTransform ScaleX="-1" on FX hosts)
      with white-hot core rails, outer plasma beams, ignition flare, living kyber hum, plasma current, and clash press.
    - PART_ButtonInfo (right): Consular Green lightsaber igniting left-to-right with the same plasma ignition & hum.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="GridTileButton" TargetType="Button">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource LocalSaberBlueWashBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalSaberBlueBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LocalWhiteCoreBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid UseLayoutRounding="True" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PressShift" Y="0" />
                        </Grid.RenderTransform>

                        <!-- Outer Lightsaber Aura & Extending Beams (mirrored right-to-left for Play; unflipped left-to-right for Info) -->
                        <Grid x:Name="HoverDirHost" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </Grid.RenderTransform>
                            <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                <Grid x:Name="HoverHumLayer" Opacity="1">
                                    <Rectangle x:Name="TileAura" Margin="-10,-9" Fill="{DynamicResource LocalSaberBlueBrush}" Opacity="0.90"
                                               OpacityMask="{DynamicResource LocalSaberFrameMaskBrush}"
                                               RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="HoverAuraScale" ScaleX="0.08" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle x:Name="SaberTop" Height="16" VerticalAlignment="Top" Margin="-5,-8,-5,0"
                                               Fill="{DynamicResource LocalSaberBlueBrush}" Opacity="0.96"
                                               OpacityMask="{DynamicResource LocalSaberBeamHMaskBrush}"
                                               RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="SaberTopScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle x:Name="SaberBot" Height="16" VerticalAlignment="Bottom" Margin="-5,0,-5,-8"
                                               Fill="{DynamicResource LocalSaberBlueBrush}" Opacity="0.86"
                                               OpacityMask="{DynamicResource LocalSaberBeamHMaskBrush}"
                                               RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="SaberBotScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Main Tile Blade Plate -->
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                            <Grid ClipToBounds="True">
                                <!-- Inner Lightsaber Ignition FX (mirrored right-to-left for Play; unflipped left-to-right for Info) -->
                                <Grid x:Name="HoverInnerDirHost" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                    <Grid.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </Grid.RenderTransform>
                                    <Border x:Name="HoverFill" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                            Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="HoverWashScale" ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>

                                    <Border x:Name="PlasmaCurrent" Visibility="Collapsed" Opacity="0.26" IsHitTestVisible="False"
                                            Background="{DynamicResource LocalSaberBlueBrightBrush}">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop x:Name="PlasmaTail" Color="#00000000" Offset="-0.45" />
                                                <GradientStop x:Name="PlasmaMid" Color="#FF000000" Offset="-0.20" />
                                                <GradientStop x:Name="PlasmaHead" Color="#00000000" Offset="0.05" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>

                                    <Border x:Name="IgniteFlare" Visibility="Collapsed" Opacity="0.65" IsHitTestVisible="False"
                                            Background="{DynamicResource LocalWhiteCoreBrush}">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop x:Name="FlareTail" Color="#00000000" Offset="-0.38" />
                                                <GradientStop x:Name="FlareCore" Color="#FF000000" Offset="-0.12" />
                                                <GradientStop x:Name="FlareEdge" Color="#00000000" Offset="0.02" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>

                                    <Rectangle x:Name="SaberCoreTop" Height="1.5" VerticalAlignment="Top"
                                               Visibility="Collapsed" Opacity="0.95" IsHitTestVisible="False"
                                               Fill="{DynamicResource LocalWhiteCoreBrush}" RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="SaberCoreTopScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle x:Name="SaberCoreBot" Height="1.5" VerticalAlignment="Bottom"
                                               Visibility="Collapsed" Opacity="0.95" IsHitTestVisible="False"
                                               Fill="{DynamicResource LocalWhiteCoreBrush}" RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="SaberCoreBotScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>

                                <!-- Press clash flash -->
                                <Border x:Name="PressFlash" Background="{DynamicResource LocalWhiteCoreBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <!-- Crisp unflipped glyph -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="GlyphScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Viewbox Width="20" Height="20">
                                <ContentControl Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}"
                                                Foreground="{TemplateBinding Foreground}" Focusable="False" />
                            </Viewbox>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Info tile button: Consular Green lightsaber igniting left-to-right -->
                        <Trigger Property="Name" Value="PART_ButtonInfo">
                            <Setter TargetName="HoverDirHost" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="HoverInnerDirHost" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource LocalSaberGreenWashBrush}" />
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource LocalSaberGreenBrush}" />
                            <Setter TargetName="TileAura" Property="Fill" Value="{DynamicResource LocalSaberGreenBrush}" />
                            <Setter TargetName="SaberTop" Property="Fill" Value="{DynamicResource LocalSaberGreenBrush}" />
                            <Setter TargetName="SaberBot" Property="Fill" Value="{DynamicResource LocalSaberGreenBrush}" />
                            <Setter TargetName="HoverFill" Property="Background" Value="{DynamicResource LocalSaberGreenDeepBrush}" />
                            <Setter TargetName="PlasmaCurrent" Property="Background" Value="{DynamicResource LocalSaberGreenBrightBrush}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource LocalWhiteCoreBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="TileHoverIgnite">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlasmaCurrent" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IgniteFlare" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.32" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SaberCoreTop" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SaberCoreBot" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>

                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0.86" Duration="0:0:0.16" />

                                        <DoubleAnimation Storyboard.TargetName="HoverAuraScale" Storyboard.TargetProperty="ScaleX" From="0.08" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberTopScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberBotScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberCoreTopScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.19">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberCoreBotScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.21">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverWashScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation Storyboard.TargetName="FlareTail" Storyboard.TargetProperty="Offset" From="-0.38" To="1.05" Duration="0:0:0.30">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="FlareCore" Storyboard.TargetProperty="Offset" From="-0.12" To="1.32" Duration="0:0:0.30">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="FlareEdge" Storyboard.TargetProperty="Offset" From="0.02" To="1.45" Duration="0:0:0.30">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation Storyboard.TargetName="GlyphScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="GlyphScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>

                                <BeginStoryboard Name="TileHoverHum">
                                    <Storyboard BeginTime="0:0:0.22" RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverHumLayer" Storyboard.TargetProperty="Opacity" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="0.78" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.62" Value="0.97" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.02" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.0" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlasmaTail" Storyboard.TargetProperty="Offset" Duration="0:0:2.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.05" KeySpline="0.35,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1.05" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlasmaMid" Storyboard.TargetProperty="Offset" Duration="0:0:2.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.20" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.30" KeySpline="0.35,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1.30" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlasmaHead" Storyboard.TargetProperty="Offset" Duration="0:0:2.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.05" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.55" KeySpline="0.35,0 0.25,1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="1.55" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="TileHoverHum" />
                                <BeginStoryboard Name="TileHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SaberTopScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberBotScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberCoreTopScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SaberCoreBotScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverWashScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverAuraScale" Storyboard.TargetProperty="ScaleX" To="0.08" Duration="0:0:0.17" />
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.19" />
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="GlyphScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="GlyphScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlasmaCurrent" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IgniteFlare" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SaberCoreTop" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SaberCoreBot" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.19" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.19" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="TilePressIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressFlash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressFlash" Storyboard.TargetProperty="Opacity" Duration="0:0:0.14">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.04" Value="0.38" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="0.18" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.07" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="TilePressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressFlash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressFlash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border Name="PART_PanelHost" Background="{DynamicResource GridItemBackgroundBrush}"
                            BorderBrush="{DynamicResource SlotBorderBrush}"
                            BorderThickness="{Settings GridItemBorderWidth}">
                        <StackPanel>
                            <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}">
                                <Border x:Name="CoverClipMask" CornerRadius="4" Background="Black" />
                                <Grid>
                                    <Grid.OpacityMask>
                                        <VisualBrush Visual="{Binding ElementName=CoverClipMask}" />
                                    </Grid.OpacityMask>
                                    <Border Background="{DynamicResource PopupBackgroundBrush}" />
                                    <Image Name="PART_ImageCover"
                                           RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Stretch="{Settings CoverArtStretch}" />
                                    <Border Background="{DynamicResource PopupBackgroundBrush}" Opacity="0.94" x:Name="TextGameName" Visibility="Collapsed">
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Margin="10"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GlyphBrush}"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Background="{DynamicResource ScrimBrush}" Opacity="0.62" x:Name="BorderUninstalled" Visibility="Collapsed" />
                                    <Border Background="{DynamicResource ScrimBrush}" x:Name="BorderMouseOver" Opacity="0" Visibility="Collapsed" />
                                </Grid>

                                <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="160"
                                         Name="GameControls" Visibility="Hidden">
                                    <StackPanel Orientation="Horizontal" Margin="14">
                                        <Button Name="PART_ButtonPlay" Style="{StaticResource GridTileButton}" Margin="0,0,8,0"
                                                Content="{DynamicResource IconPlay}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="PlayScale" ScaleX="0.90" ScaleY="0.90" />
                                                    <TranslateTransform x:Name="PlayRise" Y="6" />
                                                </TransformGroup>
                                            </Button.RenderTransform>
                                        </Button>
                                        <Button Name="PART_ButtonInfo" Style="{StaticResource GridTileButton}" Margin="8,0,0,0"
                                                Content="{DynamicResource IconInfo}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="InfoScale" ScaleX="0.90" ScaleY="0.90" />
                                                    <TranslateTransform x:Name="InfoRise" Y="6" />
                                                </TransformGroup>
                                            </Button.RenderTransform>
                                        </Button>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                            <TextBlock x:Name="CoverCaption" Text="{Binding DisplayName}"
                                       FontFamily="{DynamicResource FontFamily}" FontWeight="Medium"
                                       FontSize="13.5" Foreground="{DynamicResource TextBrush}"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Padding="3,6,3,4"
                                       Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="{DynamicResource IconDownload}" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderUninstalled" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="CoverControlsIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
