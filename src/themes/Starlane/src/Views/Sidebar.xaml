<!--
    Starlane: Views/Sidebar.xaml.
    Minimalist 44px pure OLED #000000 rail with subtle deep-space starfield, frameless Crawl-Yellow
    Astrogation Star-Compass main menu trigger (PART_ElemMainMenu), and a quiet tri-color
    Blue / Green / Red lightsaber crystal foot stack. Turns transparent when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,1,0"
                            Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <Rectangle x:Name="RailStars" Fill="{DynamicResource TextBrush}" Opacity="0.28"
                                       OpacityMask="{DynamicResource LocalStarfieldMaskBrush}" IsHitTestVisible="False" />

                            <DockPanel x:Name="DockContentHolder">
                                <!-- Minimalist 44x48 Crawl-Yellow Astrogation Star-Compass Main Menu -->
                                <StackPanel x:Name="TopCrownGroup" DockPanel.Dock="Top" Orientation="Vertical" Margin="0,0,0,6">
                                    <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                            BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1"
                                            Width="44" Height="48" Padding="0" Cursor="Hand"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Grid>
                                            <Border x:Name="MenuHoverFill" Background="{DynamicResource LocalYellowWashBrush}"
                                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                            <Control x:Name="MenuMark" Width="22" Height="22"
                                                     Template="{DynamicResource BrandMarkTemplate}"
                                                     Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Subtle tri-color Blue / Green / Red lightsaber crystal pips at rail foot -->
                                <StackPanel x:Name="RailFootStack" DockPanel.Dock="Bottom" Orientation="Vertical"
                                            Margin="0,8,0,14" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <Border Width="3" Height="10" Margin="0,0,0,6" CornerRadius="1.5" Background="{DynamicResource LocalSaberBlueBrush}" />
                                    <Border Width="3" Height="10" Margin="0,0,0,6" CornerRadius="1.5" Background="{DynamicResource LocalSaberGreenBrush}" />
                                    <Border Width="3" Height="10" CornerRadius="1.5" Background="{DynamicResource LocalSaberRedBrush}" />
                                </StackPanel>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="BorderThickness" Value="0" TargetName="BorderContentHolder" />
                            <Setter Property="BorderThickness" Value="0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailStars" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootStack" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Foreground" Value="{DynamicResource LocalYellowBrightBrush}" TargetName="MenuMark" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="MenuHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Padding" Value="0,25,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="TopCrownGroup" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="TopCrownGroup" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootStack" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,136,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="TopCrownGroup" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="TopCrownGroup" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootStack" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
