<!--
    Starlane: Common.xaml — spacing keys, pure-white procedural FX ImageBrushes (OLED starfield,
    horizontal/vertical lightsaber plasma beams, 9-slice saber aura), hollow-yellow OutlinedTextTemplate
    for Star Wars opening-title display typography, BrandMarkTemplate, minimalist DividerTemplate,
    EmptyGameTemplate, SteamScreenshotsSkeletonTemplate, HeadingTextBlock, and SecondaryButton.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Spacing & Metric Keys -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">280</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <Thickness x:Key="ButtonPadding">14,5</Thickness>
    <Thickness x:Key="InputPadding">9,5</Thickness>
    <Thickness x:Key="MenuPadding">6,8,6,6</Thickness>
    <Thickness x:Key="MenuItemPadding">8,4</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">6,8,6,6</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,4</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,5</Thickness>
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>

    <!-- Pure-White Procedural FX ImageBrushes (recolored live via OpacityMask + ThemeModifier brushes) -->
    <ImageBrush x:Key="LocalStarfieldMaskBrush" ImageSource="{ThemeFile 'Images/fx/starfield.png'}"
                TileMode="Tile" Viewport="0,0,512,512" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalSaberBeamHMaskBrush" ImageSource="{ThemeFile 'Images/fx/saber-beam-h.png'}"
                Stretch="Fill" />
    <ImageBrush x:Key="LocalSaberBeamVMaskBrush" ImageSource="{ThemeFile 'Images/fx/saber-beam-v.png'}"
                Stretch="Fill" />
    <ImageBrush x:Key="LocalSaberFrameMaskBrush" ImageSource="{ThemeFile 'Images/fx/saber-frame.png'}"
                Stretch="Fill" />

    <!-- Popup Border -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard Focus Visual (Jedi Blue lightsaber hairline) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="1.5" BorderBrush="{DynamicResource BeamBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Iconic Hollow-Yellow Outlined Star Wars Opening Title Template
         8-direction TextOutlineBrush (#FFE81F) rim around pure OLED black (#000000) core fill -->
    <ControlTemplate x:Key="OutlinedTextTemplate" TargetType="ContentControl">
        <Grid SnapsToDevicePixels="False">
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform X="-1.5" Y="0" /></TextBlock.RenderTransform></TextBlock>
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform X="1.5" Y="0" /></TextBlock.RenderTransform></TextBlock>
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform X="0" Y="-1.5" /></TextBlock.RenderTransform></TextBlock>
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform X="0" Y="1.5" /></TextBlock.RenderTransform></TextBlock>
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform X="-1.1" Y="-1.1" /></TextBlock.RenderTransform></TextBlock>
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform X="1.1" Y="-1.1" /></TextBlock.RenderTransform></TextBlock>
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform X="-1.1" Y="1.1" /></TextBlock.RenderTransform></TextBlock>
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource GlyphBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform X="1.1" Y="1.1" /></TextBlock.RenderTransform></TextBlock>
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource WindowBackgourndBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
        </Grid>
    </ControlTemplate>

    <!-- Original Brand Mark: Perfect 1:1 Round Orbital Station Silhouette (no inner dot) -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="64" Height="64">
                <Path Fill="{TemplateBinding Foreground}"
                      Data="F0 M6.04,30.5 C6.84,16.75 18.22,6 32,6 C45.78,6 57.16,16.75 57.96,30.5 Z M57.96,33.5 C57.16,47.25 45.78,58 32,58 C18.22,58 6.84,47.25 6.04,33.5 Z M42.5,12.7 C46.26,12.7 49.3,15.74 49.3,19.5 C49.3,23.26 46.26,26.3 42.5,26.3 C38.74,26.3 35.7,23.26 35.7,19.5 C35.7,15.74 38.74,12.7 42.5,12.7 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Minimalist Hairline Group Break led by a subtle Crawl-Yellow spark -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="10" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource MenuSeparatorBrush}" />
            <Rectangle Width="14" Height="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource GlyphBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Minimalist OLED Empty Game State (clean icon + tri-saber accent + standard Playnite empty state text) -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center" MinWidth="240" MaxWidth="380">
                <Control Width="52" Height="52" Margin="0,0,0,16"
                         Template="{DynamicResource BrandMarkTemplate}"
                         Foreground="{DynamicResource GlyphBrush}"
                         HorizontalAlignment="Center" Opacity="0.88" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Rectangle Width="20" Height="2" Fill="{DynamicResource BeamBrush}" Margin="0,0,8,0" />
                    <Rectangle Width="20" Height="2" Fill="{DynamicResource LocalSaberGreenBrush}" Margin="0,0,8,0" />
                    <Rectangle Width="20" Height="2" Fill="{DynamicResource LocalSaberRedBrush}" />
                </StackPanel>
                <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSize}"
                           Foreground="{DynamicResource TextBrushDarker}" />
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <!-- Minimalist OLED Skeleton for Steam Screenshots Plugin -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Height="210" Background="{DynamicResource NormalBrushDark}"
                    BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}" Margin="0,0,0,8" />
            <UniformGrid Columns="5">
                <Border Height="42" Margin="0,0,6,0" Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1" CornerRadius="2" />
                <Border Height="42" Margin="0,0,6,0" Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1" CornerRadius="2" />
                <Border Height="42" Margin="0,0,6,0" Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1" CornerRadius="2" />
                <Border Height="42" Margin="0,0,6,0" Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1" CornerRadius="2" />
                <Border Height="42" Background="{DynamicResource NormalBrushDark}" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1" CornerRadius="2" />
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- Section Heading Typography (Orbitron sci-fi Star Wars headings in Crawl Yellow) -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
    </Style>

    <!-- Minimalist OLED Secondary Action Button (More / Edit 36x36 squares) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="{DynamicResource BeamBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource BeamBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalWhiteCoreBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.20" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource SecondaryButtonPressedBackgroundBrush}" />
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource LocalWhiteCoreBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calm Read-Only Notes TextBox on Game Overview Pages -->
    <Style x:Key="LocalNotesTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): three lightsaber hilts with short crawl-yellow blades, stacked like menu rows. Hover: the blades ignite to full length in turn, each in its own colour (Jedi blue, Consular green, Sith red), scaling out from the hilt. Open (ContextMenu.IsOpen of the nearest Border): the outer sabers swing out around their hilts into a fan and all three blades hum with a white core that pulses at its own pace until the menu closes. -->
    <ControlTemplate x:Key="LocalStarlaneMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="26" Height="26" RenderTransformOrigin="0.1,0.273">
                    <Canvas.RenderTransform><RotateTransform x:Name="SwingA" Angle="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="2" Canvas.Top="5.6" Width="5" Height="3" RadiusX="0.6" RadiusY="0.6" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="7.6" Canvas.Top="6" Width="12" Height="2.2" RadiusX="1.1" RadiusY="1.1" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="7.6" Canvas.Top="6" Width="17" Height="2.2" RadiusX="1.1" RadiusY="1.1" Fill="{DynamicResource LocalSaberBlueBrightBrush}" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform><ScaleTransform x:Name="IgniteA" ScaleX="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="HumA" Canvas.Left="8.4" Canvas.Top="6.6" Width="14" Height="1" Fill="{DynamicResource LocalWhiteCoreBrush}" Opacity="0" />
                </Canvas>
                <Canvas Width="26" Height="26" RenderTransformOrigin="0.1,0.504">
                    <Canvas.RenderTransform><RotateTransform x:Name="SwingB" Angle="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="2" Canvas.Top="11.6" Width="5" Height="3" RadiusX="0.6" RadiusY="0.6" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="7.6" Canvas.Top="12" Width="12" Height="2.2" RadiusX="1.1" RadiusY="1.1" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="7.6" Canvas.Top="12" Width="17" Height="2.2" RadiusX="1.1" RadiusY="1.1" Fill="{DynamicResource LocalSaberGreenBrightBrush}" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform><ScaleTransform x:Name="IgniteB" ScaleX="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="HumB" Canvas.Left="8.4" Canvas.Top="12.6" Width="14" Height="1" Fill="{DynamicResource LocalWhiteCoreBrush}" Opacity="0" />
                </Canvas>
                <Canvas Width="26" Height="26" RenderTransformOrigin="0.1,0.735">
                    <Canvas.RenderTransform><RotateTransform x:Name="SwingC" Angle="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="2" Canvas.Top="17.6" Width="5" Height="3" RadiusX="0.6" RadiusY="0.6" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="7.6" Canvas.Top="18" Width="12" Height="2.2" RadiusX="1.1" RadiusY="1.1" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="7.6" Canvas.Top="18" Width="17" Height="2.2" RadiusX="1.1" RadiusY="1.1" Fill="{DynamicResource LocalSaberRedBrightBrush}" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform><ScaleTransform x:Name="IgniteC" ScaleX="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="HumC" Canvas.Left="8.4" Canvas.Top="18.6" Width="14" Height="1" Fill="{DynamicResource LocalWhiteCoreBrush}" Opacity="0" />
                </Canvas>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="IgniteA" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="IgniteB" Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.07" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="IgniteC" Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.14" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="IgniteA" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="IgniteB" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="IgniteC" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SwingA" Storyboard.TargetProperty="Angle" To="-24" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SwingC" Storyboard.TargetProperty="Angle" To="24" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HumA" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HumA" Storyboard.TargetProperty="Opacity" From="1" To="0.35" BeginTime="0:0:0.4" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HumB" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.2" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HumB" Storyboard.TargetProperty="Opacity" From="1" To="0.35" BeginTime="0:0:0.4" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HumC" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.3" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HumC" Storyboard.TargetProperty="Opacity" From="1" To="0.35" BeginTime="0:0:0.4" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SwingA" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SwingC" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HumA" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HumB" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HumC" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
