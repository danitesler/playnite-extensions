<!--
    Starlane: DefaultControls/Menu.xaml.
    Compact 30px OLED Star Wars popup menu rows:
    - Panel: LocalStarlaneMenuBoardTemplate (shared with ContextMenu and ComboBox).
    - Highlight: glowing vertical Jedi Blue Lightsaber beam (1.5px white core + saber-beam-v.png blue aura)
      over a subtle blue wash + thin bottom saber wipe (ScaleX 0.85 -> 1, 120ms CubicEase); label, icon
      (TextElement.Foreground), and submenu arrow brighten to pure #FFFFFF (+2px nudge).
    - Group break: whisper hairline led by a 14x2 Crawl-Yellow saber spark (DividerTemplate).
    - Shortcuts: clean right-aligned Consolas text illuminating to bright saber blue on highlight.
    - Marked rows: Exit (Alt+Q) ignites a solid Sith Red Lightsaber blade (#E52222 + white left core + #FFFFFF ink, 5.1:1);
      checked rows show a Consular Green check mark.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource DividerTemplate}" Focusable="False" IsTabStop="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain Menu Row (30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated Jedi Blue Lightsaber Highlight Layer (Collapsed at rest) -->
            <Grid x:Name="HighlightLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border x:Name="HighlightPlate" Background="{DynamicResource BeamBrush}" Opacity="0.18" CornerRadius="2" />
                <Rectangle x:Name="SaberAura" Width="28" HorizontalAlignment="Left" Margin="0,1"
                           Fill="{DynamicResource BeamBrush}" Opacity="0.92"
                           OpacityMask="{DynamicResource LocalSaberBeamVMaskBrush}" />
                <Border x:Name="SaberCore" Width="2" HorizontalAlignment="Left" Margin="0,5" CornerRadius="1"
                        Background="{DynamicResource LocalWhiteCoreBrush}" />
                <Rectangle x:Name="BottomSweep" Height="1" VerticalAlignment="Bottom"
                           Fill="{DynamicResource BeamBrush}" Opacity="0.7" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="SweepScale" ScaleX="0.85" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>

            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <!-- Fixed 26px Icon / Check Column -->
                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource TextBrushDarker}" />
                <ContentControl x:Name="CheckMark" Grid.Column="0" Width="14" Height="14"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="Collapsed" IsHitTestVisible="False"
                                Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconTemplate}"
                                Foreground="{DynamicResource LocalSaberGreenBrightBrush}" />

                <!-- Plain * Label Column -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </Grid.RenderTransform>
                    <ContentPresenter x:Name="HeaderHost" ContentSource="Header" RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>

                <!-- Shared-Size Right-Aligned Minimalist Shortcut -->
                <TextBlock x:Name="ShortcutText" Grid.Column="2" Margin="14,0,2,0"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{TemplateBinding InputGestureText}"
                           FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11.5"
                           Foreground="{DynamicResource TextBrushDarker}" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource LocalSaberRedBrightBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalSaberRedBrightBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource LocalSaberRedBrightBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LocalWhiteCoreBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalWhiteCoreBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource BeamBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightLayer" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="SweepScale" Storyboard.TargetProperty="ScaleX" From="0.85" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightLayer" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <!-- Sith Red Lightsaber Blade on Exit (Alt+Q) Highlight -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HighlightPlate" Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="SaberAura" Property="Fill" Value="{DynamicResource LocalSaberRedBrush}" />
                <Setter TargetName="BottomSweep" Property="Fill" Value="{DynamicResource LocalWhiteCoreBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Submenu Header Row (30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held open-submenu steady wash (by setter, never flickers) -->
            <Grid x:Name="OpenPlate" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource BeamBrush}" Opacity="0.18" CornerRadius="2" />
                <Border Width="2" HorizontalAlignment="Left" Margin="0,5" CornerRadius="1" Background="{DynamicResource BeamBrush}" />
            </Grid>

            <!-- Animated Highlight Layer -->
            <Grid x:Name="HighlightLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border Background="{DynamicResource BeamBrush}" Opacity="0.18" CornerRadius="2" />
                <Rectangle Width="28" HorizontalAlignment="Left" Margin="0,1"
                           Fill="{DynamicResource BeamBrush}" Opacity="0.92"
                           OpacityMask="{DynamicResource LocalSaberBeamVMaskBrush}" />
                <Border Width="2" HorizontalAlignment="Left" Margin="0,5" CornerRadius="1"
                        Background="{DynamicResource LocalWhiteCoreBrush}" />
            </Grid>

            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource TextBrushDarker}" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </Grid.RenderTransform>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
                <ContentControl x:Name="SubArrow" Grid.Column="3" Width="10" Height="10"
                                HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                                Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource TextBrushDarker}" />
            </Grid>

            <Popup x:Name="Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-8"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade">
                <Grid MinWidth="208" Grid.IsSharedSizeScope="True">
                    <Control Template="{DynamicResource LocalStarlaneMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="{DynamicResource MenuPadding}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource BeamBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalWhiteCoreBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalWhiteCoreBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LocalWhiteCoreBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalWhiteCoreBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource LocalWhiteCoreBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightLayer" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightLayer" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
