<!-- Starlane: DefaultControls/ProgressBar.xaml — glowing white-cored Blue Lightsaber progress beam. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid SnapsToDevicePixels="True" ClipToBounds="True">
                        <Border x:Name="PART_Track" Height="6" VerticalAlignment="Center" CornerRadius="3"
                                Background="{TemplateBinding Background}" />
                        <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" Height="12" VerticalAlignment="Center">
                            <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.95"
                                       OpacityMask="{DynamicResource LocalSaberBeamHMaskBrush}" />
                            <Border Height="3" VerticalAlignment="Center" CornerRadius="1.5"
                                    Background="{DynamicResource LocalWhiteCoreBrush}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
