<!--
    Starlane: DefaultControls/ContextMenu.xaml.
    Unified OLED Star Wars popup menu board (LocalStarlaneMenuBoardTemplate) reused by ContextMenu,
    Menu submenus, ComboBox dropdowns, and TopPanelMenu (BasedOn ContextMenu, no template of its own).
    Panel: pure near-OLED #090B0F floating sheet in a crisp 1px #232936 hairline, subtle starfield
    specks, crowned by a glowing white-cored Jedi Blue Lightsaber top emitter edge.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalStarlaneMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="{DynamicResource PopupBorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <Grid ClipToBounds="True">
                    <Rectangle Fill="{DynamicResource TextBrush}" Opacity="0.16"
                               OpacityMask="{DynamicResource LocalStarfieldMaskBrush}" />
                    <!-- Glowing white-cored Jedi Blue Lightsaber top edge -->
                    <Rectangle Height="10" VerticalAlignment="Top" Margin="8,-4,44,0"
                               Fill="{DynamicResource BeamBrush}" Opacity="0.88"
                               OpacityMask="{DynamicResource LocalSaberBeamHMaskBrush}" />
                    <Rectangle Height="1.5" VerticalAlignment="Top" Margin="12,0,52,0"
                               Fill="{DynamicResource LocalWhiteCoreBrush}" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="216" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="{DynamicResource MenuPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalStarlaneMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
