<!--
    Starlane: DefaultControls/TreeView.xaml (Settings & Add-ons section tree + Explorer/Filter trees).
    Minimalist bare 28px body-font rows (no idle plate/outline/border), opacity-animated hover wash,
    selected = soft blue wash + glowing 2px white-cored Blue Lightsaber left edge + bright label.
    WindowSettings (Width=244) & WindowExtensions (Width=280) reserve the vertical scrollbar lane (Visible).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LocalTreeExpanderToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Background="Transparent" Width="16" Height="16">
                        <ContentControl x:Name="Arrow" Width="10" Height="10"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Content="{DynamicResource IconSubmenu}"
                                        ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{DynamicResource GlyphBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="Content" Value="{DynamicResource IconDropDown}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="RowGrid" Grid.Row="0" MinHeight="28" Margin="0,0.5" Background="Transparent">
                            <!-- Opacity-animated Hover Wash -->
                            <Border x:Name="HoverPlate" Background="{DynamicResource ListItemHoverBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />

                            <!-- Opacity-animated Selected Wash + Glowing Lightsaber Bar -->
                            <Border x:Name="SelectedPlate" Background="{DynamicResource BeamBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <Grid x:Name="SelectedBar" Opacity="0" IsHitTestVisible="False">
                                <Rectangle Width="20" HorizontalAlignment="Left" Margin="0,1"
                                           Fill="{DynamicResource BeamBrush}" Opacity="0.9"
                                           OpacityMask="{DynamicResource LocalSaberBeamVMaskBrush}" />
                                <Border Width="2" HorizontalAlignment="Left" Margin="0,4" CornerRadius="1"
                                        Background="{DynamicResource LocalWhiteCoreBrush}" />
                            </Grid>

                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Grid.Column="0" Width="16" Height="16"
                                              Style="{StaticResource LocalTreeExpanderToggle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press" VerticalAlignment="Center" />
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" MaxWidth="195"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Grid>

                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="18,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="RowGrid" Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeSelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeSelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding Header.Tag, RelativeSource={RelativeSource Self}}" Value="TreeSeparator">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter TargetName="RowGrid" Property="MinHeight" Value="10" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style TargetType="{x:Type Separator}">
                <Setter Property="Tag" Value="TreeSeparator" />
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Style>
        </Style.Resources>
    </Style>

    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,6" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding (AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowSettings">
                <Setter Property="Width" Value="244" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
            <DataTrigger Binding="{Binding (AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowExtensions">
                <Setter Property="Width" Value="280" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
