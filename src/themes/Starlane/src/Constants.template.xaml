<!--
    Starlane: Constants.xaml template (Minimalist OLED Black Star Wars Opening-Title & Lightsaber theme).
    scripts/build-theme.ps1 renders tokens.css placeholders into Constants.xaml.
    True #000000 OLED space + twinkling starfield, hollow-outlined #FFE81F Opening Title typography,
    and white-cored Jedi Blue (#28A8FF), Consular Green (#18C958), and Sith Red (#E52222) lightsaber glows.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Unbounded Bold (wide Star Wars logo outlined titles), Orbitron (sci-fi headings, unmodified OFL),
         Barlow (News Gothic / Opening Crawl clean UI body), Consolas (monospace telemetry) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">32</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow, Barlow, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Orbitron, Orbitron, Barlow, Segoe UI</FontFamily>
    <FontFamily x:Key="PosterFontFamily">./Typography/#Unbounded, Unbounded, Orbitron, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Game page metadata pane defaults (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape: razor-clean minimalist 3px corners -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:sw-radius-md}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:sw-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:sw-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{sw-text}}</Color>
    <Color x:Key="TextColorDarker">{{sw-text-muted}}</Color>
    <Color x:Key="TextColorDark">{{sw-text-ink}}</Color>
    <Color x:Key="MainColor">{{sw-surface}}</Color>
    <Color x:Key="MainColorDark">{{sw-panel}}</Color>
    <Color x:Key="HoverColor">{{sw-hover}}</Color>
    <Color x:Key="GlyphColor">{{sw-yellow}}</Color>
    <Color x:Key="HighlightGlyphColor">{{sw-yellow-wash}}</Color>
    <Color x:Key="PopupBackgroundColor">{{sw-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{sw-border}}</Color>
    <Color x:Key="BackgroundToneColor">{{sw-space}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{sw-hairline}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{sw-hairline}}</Color>
    <Color x:Key="DataChangeNotifColor">{{sw-cyan}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{sw-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{sw-panel}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{sw-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{sw-surface}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{sw-well}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{sw-saber-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{sw-saber-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{sw-yellow}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{sw-yellow}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{sw-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{sw-oled}}" />

    <!-- True OLED Shell & Game Page Surfaces -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{sw-oled}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{sw-oled}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{sw-oled}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{sw-oled}}" />
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{sw-banner-tint}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{sw-oled}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{sw-oled}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{sw-yellow}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{sw-well}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{sw-panel}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{sw-hairline}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{sw-hairline}}" />

    <!-- States (Multi-Color Lightsaber Semantics) -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{sw-saber-blue-wash}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{sw-saber-blue-wash}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{sw-white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{sw-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{sw-saber-blue-wash}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{sw-saber-blue-wash}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{sw-saber-green}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{sw-saber-blue-wash}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{sw-saber-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{sw-white}}" />

    <!-- Buttons (Blue Lightsaber Play, Minimalist OLED Secondary) -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{sw-text}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{sw-white}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{sw-text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{sw-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{sw-pressed}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{sw-border}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{sw-saber-blue-wash}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{sw-saber-blue-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{sw-white}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{sw-panel}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{sw-border}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{sw-hover}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{sw-pressed}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{sw-saber-blue-wash}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{sw-well}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{sw-panel}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{sw-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{sw-border-lit}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{sw-border-lit}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{sw-saber-green}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{sw-hairline}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{sw-white}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{sw-saber-blue-bright}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{sw-saber-blue-bright}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{sw-hairline}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{sw-border}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{sw-oled}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{sw-border}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{sw-text-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{sw-text}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{sw-yellow}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{sw-oled}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{sw-yellow}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{sw-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{sw-saber-blue-wash}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{sw-text-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{sw-white}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{sw-panel}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{sw-text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{sw-saber-blue-wash}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{sw-cyan}}" />

    <!-- Popups, Frames & Typography -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{sw-hairline}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{sw-oled}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{sw-yellow}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{sw-yellow}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{sw-saber-green}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{sw-hairline}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{sw-cyan}}" />
    <SolidColorBrush x:Key="TextOutlineBrush" Color="{{sw-yellow}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{sw-border}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{sw-hairline}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{sw-hairline}}" />

    <!-- Theme-only Local* Multi-Color Lightsaber Brushes -->
    <SolidColorBrush x:Key="LocalSaberBlueBrush" Color="{{sw-saber-blue}}" />
    <SolidColorBrush x:Key="LocalSaberBlueBrightBrush" Color="{{sw-saber-blue-bright}}" />
    <SolidColorBrush x:Key="LocalSaberBlueDeepBrush" Color="{{sw-saber-blue-deep}}" />
    <SolidColorBrush x:Key="LocalSaberBlueWashBrush" Color="{{sw-saber-blue-wash}}" />
    <SolidColorBrush x:Key="LocalSaberGreenBrush" Color="{{sw-saber-green}}" />
    <SolidColorBrush x:Key="LocalSaberGreenBrightBrush" Color="{{sw-saber-green-bright}}" />
    <SolidColorBrush x:Key="LocalSaberGreenDeepBrush" Color="{{sw-saber-green-deep}}" />
    <SolidColorBrush x:Key="LocalSaberGreenWashBrush" Color="{{sw-saber-green-wash}}" />
    <SolidColorBrush x:Key="LocalSaberRedBrush" Color="{{sw-saber-red}}" />
    <SolidColorBrush x:Key="LocalSaberRedBrightBrush" Color="{{sw-saber-red-bright}}" />
    <SolidColorBrush x:Key="LocalSaberRedDeepBrush" Color="{{sw-saber-red-deep}}" />
    <SolidColorBrush x:Key="LocalSaberRedWashBrush" Color="{{sw-saber-red-wash}}" />
    <SolidColorBrush x:Key="LocalYellowBrightBrush" Color="{{sw-yellow-bright}}" />
    <SolidColorBrush x:Key="LocalYellowWashBrush" Color="{{sw-yellow-wash}}" />
    <SolidColorBrush x:Key="LocalCyanBrush" Color="{{sw-cyan}}" />
    <SolidColorBrush x:Key="LocalWhiteCoreBrush" Color="{{sw-white}}" />
</ResourceDictionary>
