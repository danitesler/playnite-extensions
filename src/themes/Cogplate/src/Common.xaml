<!--
    Cogplate: spacing, focus, shared FX white-mask brushes, and architectural chrome templates.
    All FX brushes share frozen ImageBrush resources so controls avoid per-instance brush allocation.
    No template exposes desired width >= 200 so Statistics cards remain compact.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">12,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">12,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,0</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Every form field and button: shared 32px height across themes (filter sidebar uses 28px). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Shared white-mask FX brushes (recolored dynamically by host brushes) -->
    <ImageBrush x:Key="LocalChainTrimMaskBrush" ImageSource="{ThemeFile 'Images/fx/chain-trim.png'}" TileMode="Tile" Viewport="0,0,24,8" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalScanlinesMaskBrush" ImageSource="{ThemeFile 'Images/fx/scanlines.png'}" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlassCracksMaskBrush" ImageSource="{ThemeFile 'Images/fx/glass-cracks.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlareMaskBrush" ImageSource="{ThemeFile 'Images/fx/glare.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalParchmentGrainMaskBrush" ImageSource="{ThemeFile 'Images/fx/parchment-grain.png'}" TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalParchmentStainMaskBrush" ImageSource="{ThemeFile 'Images/fx/parchment-stain.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalDropGlowMaskBrush" ImageSource="{ThemeFile 'Images/fx/drop-glow.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalDropGlowSquareMaskBrush" ImageSource="{ThemeFile 'Images/fx/drop-glow-square.png'}" Stretch="Fill" />
    <!-- Fine CRT scanline tiles compensated for host ScaleTransform so every glow shares a crisp ~2.6px raster pitch on screen. -->
    <ImageBrush x:Key="LocalScanlinesDenseMaskBrush" ImageSource="{ThemeFile 'Images/fx/scanlines.png'}" TileMode="Tile" Viewport="0,0,2.6,2.6" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalDropGlowScanlinesMaskBrush" ImageSource="{ThemeFile 'Images/fx/scanlines.png'}" TileMode="Tile" Viewport="0,0,2.5,1.25" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalDropGlowSquareScanlinesMaskBrush" ImageSource="{ThemeFile 'Images/fx/scanlines.png'}" TileMode="Tile" Viewport="0,0,2.2,1.6" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalLedGlowMaskBrush" ImageSource="{ThemeFile 'Images/fx/led-glow.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalVignetteMaskBrush" ImageSource="{ThemeFile 'Images/fx/vignette.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalSegmentedCellsMaskBrush" ImageSource="{ThemeFile 'Images/fx/segmented-cells.png'}" TileMode="Tile" Viewport="0,0,16,8" ViewportUnits="Absolute" Stretch="Fill" />

    <!-- 9-slice mint LED bloom (Images/fx/bloom.png 96x96, pad 36 drawn at 14). Host Foreground = glow color. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,0,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="36,0,24,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="60,0,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,36,36,24" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="36,36,24,24" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="60,36,36,24" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,60,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="36,60,24,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="60,60,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Scanlined CRT drop glow: the hover glow for every plate except Play and the cover buttons (which use the drop-glow sprites).
         A soft 16px bloom sitting 3px low, a faint haze under tight 3px scan lines. Host Foreground = glow colour,
         Opacity = strength (0.4-0.45 on hover); host margin about -11 so the bloom's solid centre stays under the plate. -->
    <ControlTemplate x:Key="LocalGlowFrameSoftTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,0,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="36,0,24,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="60,0,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,36,36,24" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="36,36,24,24" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="60,36,36,24" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,60,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="36,60,24,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="60,60,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="LocalScanGlowTemplate" TargetType="Control">
        <Grid x:Name="TerminalField" IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform Y="2" />
            </Grid.RenderTransform>
            <Grid.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="RevealFill" Color="#FF000000" Offset="1" />
                    <GradientStop x:Name="RevealEdge" Color="#00000000" Offset="1.15" />
                </LinearGradientBrush>
            </Grid.OpacityMask>
            <Control Template="{DynamicResource LocalGlowFrameSoftTemplate}" Foreground="{TemplateBinding Foreground}" Opacity="0.54" Focusable="False" />
            <Grid OpacityMask="{StaticResource LocalScanlinesDenseMaskBrush}">
                <Control Template="{DynamicResource LocalGlowFrameSoftTemplate}" Foreground="{TemplateBinding Foreground}" Opacity="0.48" Focusable="False" />
                <Control x:Name="BeamSweep" Template="{DynamicResource LocalGlowFrameSoftTemplate}" Foreground="{TemplateBinding Foreground}" Opacity="0.62" Focusable="False">
                    <Control.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="BeamTop" Color="#00000000" Offset="-0.32" />
                            <GradientStop x:Name="BeamPeak" Color="#FF000000" Offset="-0.16" />
                            <GradientStop x:Name="BeamBot" Color="#00000000" Offset="0" />
                        </LinearGradientBrush>
                    </Control.OpacityMask>
                </Control>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="TerminalBoot">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RevealFill" Storyboard.TargetProperty="Offset" From="-0.22" To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RevealEdge" Storyboard.TargetProperty="Offset" From="0.02" To="1.22" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TerminalField" Storyboard.TargetProperty="Opacity" Duration="0:0:0.26">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.045" Value="0.92" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.085" Value="0.36" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.145" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.19" Value="0.74" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.26" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BeamTop" Storyboard.TargetProperty="Offset" RepeatBehavior="Forever" Duration="0:0:1.8">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.35" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="1" KeySpline="0.35,0 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BeamPeak" Storyboard.TargetProperty="Offset" RepeatBehavior="Forever" Duration="0:0:1.8">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.17" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="1.18" KeySpline="0.35,0 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.18" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BeamBot" Storyboard.TargetProperty="Offset" RepeatBehavior="Forever" Duration="0:0:1.8">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="1.35" KeySpline="0.35,0 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.35" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="TerminalBoot" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Soft diffused CRT drop aura for the hero Play plate (Images/fx/drop-glow.png, art/sprites.py): a soft Gaussian
         phosphor haze blended with a fine scanlined terminal layer that sweeps top-to-bottom with 90s CRT sync-flicker
         and continuous Matrix scanline drift on hover. Host is enlarged with ScaleTransform (1.289 x 2.2, origin 0.5,0.375). -->
    <ControlTemplate x:Key="LocalDropGlowTemplate" TargetType="Control">
        <Grid x:Name="TerminalField" IsHitTestVisible="False">
            <Grid.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="RevealFill" Color="#FF000000" Offset="1" />
                    <GradientStop x:Name="RevealEdge" Color="#00000000" Offset="1.15" />
                </LinearGradientBrush>
            </Grid.OpacityMask>
            <Grid OpacityMask="{StaticResource LocalDropGlowMaskBrush}" ClipToBounds="True">
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.54" />
                <Rectangle Margin="0,-4,0,-4" Fill="{TemplateBinding Foreground}" Opacity="0.48"
                           OpacityMask="{StaticResource LocalDropGlowScanlinesMaskBrush}">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="ScanDrift" Y="0" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.58">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="BeamTop" Color="#00000000" Offset="-0.32" />
                            <GradientStop x:Name="BeamPeak" Color="#FF000000" Offset="-0.16" />
                            <GradientStop x:Name="BeamBot" Color="#00000000" Offset="0" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="TerminalBoot">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RevealFill" Storyboard.TargetProperty="Offset" From="-0.22" To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RevealEdge" Storyboard.TargetProperty="Offset" From="0.02" To="1.22" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TerminalField" Storyboard.TargetProperty="Opacity" Duration="0:0:0.26">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.045" Value="0.92" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.085" Value="0.36" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.145" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.19" Value="0.74" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.26" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="ScanDrift" Storyboard.TargetProperty="Y" From="0" To="1.25" Duration="0:0:0.42" RepeatBehavior="Forever" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BeamTop" Storyboard.TargetProperty="Offset" RepeatBehavior="Forever" Duration="0:0:1.7">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.35" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="1" KeySpline="0.35,0 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BeamPeak" Storyboard.TargetProperty="Offset" RepeatBehavior="Forever" Duration="0:0:1.7">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.17" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="1.18" KeySpline="0.35,0 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.18" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BeamBot" Storyboard.TargetProperty="Offset" RepeatBehavior="Forever" Duration="0:0:1.7">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="1.35" KeySpline="0.35,0 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.35" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="TerminalBoot" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Square version for the 48px cover Play / Info buttons (drop-glow-square.png). Host covers the tile and is
         enlarged with ScaleTransform 1.583 x 1.667 around origin 0.5,0.375 to the sprite's box. -->
    <ControlTemplate x:Key="LocalDropGlowSquareTemplate" TargetType="Control">
        <Grid x:Name="TerminalField" IsHitTestVisible="False">
            <Grid.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="RevealFill" Color="#FF000000" Offset="1" />
                    <GradientStop x:Name="RevealEdge" Color="#00000000" Offset="1.15" />
                </LinearGradientBrush>
            </Grid.OpacityMask>
            <Grid OpacityMask="{StaticResource LocalDropGlowSquareMaskBrush}" ClipToBounds="True">
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.54" />
                <Rectangle Margin="0,-4,0,-4" Fill="{TemplateBinding Foreground}" Opacity="0.48"
                           OpacityMask="{StaticResource LocalDropGlowSquareScanlinesMaskBrush}">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="ScanDrift" Y="0" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.58">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="BeamTop" Color="#00000000" Offset="-0.32" />
                            <GradientStop x:Name="BeamPeak" Color="#FF000000" Offset="-0.16" />
                            <GradientStop x:Name="BeamBot" Color="#00000000" Offset="0" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="TerminalBoot">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RevealFill" Storyboard.TargetProperty="Offset" From="-0.22" To="1" Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RevealEdge" Storyboard.TargetProperty="Offset" From="0.02" To="1.22" Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TerminalField" Storyboard.TargetProperty="Opacity" Duration="0:0:0.24">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.04" Value="0.92" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="0.36" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.18" Value="0.74" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.24" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="ScanDrift" Storyboard.TargetProperty="Y" From="0" To="1.6" Duration="0:0:0.42" RepeatBehavior="Forever" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BeamTop" Storyboard.TargetProperty="Offset" RepeatBehavior="Forever" Duration="0:0:1.7">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.35" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" KeySpline="0.35,0 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BeamPeak" Storyboard.TargetProperty="Offset" RepeatBehavior="Forever" Duration="0:0:1.7">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.17" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1.18" KeySpline="0.35,0 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.18" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BeamBot" Storyboard.TargetProperty="Offset" RepeatBehavior="Forever" Duration="0:0:1.7">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1.35" KeySpline="0.35,0 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.35" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="TerminalBoot" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Octagonal chamfered CRT steel plate (6px corner chamfers). Host Background = fill, BorderBrush = edge. -->
    <ControlTemplate x:Key="ChamferTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
                <RowDefinition Height="6" />
            </Grid.RowDefinitions>
            <Path Grid.Row="0" Grid.Column="0" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 6,0 L 6,6 L 0,6 Z" />
            <Border Grid.Row="0" Grid.Column="1" Background="{TemplateBinding Background}" />
            <Path Grid.Row="0" Grid.Column="2" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 0,0 L 6,6 L 0,6 Z" />
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="{TemplateBinding Background}" />
            <Path Grid.Row="2" Grid.Column="0" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 0,0 L 6,0 L 6,6 Z" />
            <Border Grid.Row="2" Grid.Column="1" Background="{TemplateBinding Background}" />
            <Path Grid.Row="2" Grid.Column="2" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 0,0 L 6,0 L 0,6 Z" />

            <Path Grid.Row="0" Grid.Column="0" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" Data="M 0,6 L 6,0" />
            <Border Grid.Row="0" Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1.2,0,0" />
            <Path Grid.Row="0" Grid.Column="2" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" Data="M 0,0 L 6,6" />
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2,0,0,0" />
            <Border Grid.Row="1" Grid.Column="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1.2,0" />
            <Path Grid.Row="2" Grid.Column="0" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" Data="M 0,0 L 6,6" />
            <Border Grid.Row="2" Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1.2" />
            <Path Grid.Row="2" Grid.Column="2" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" Data="M 0,6 L 6,0" />
        </Grid>
    </ControlTemplate>

    <!-- Chain-link border strip (24x8 seamless tile). Host Foreground = chain metal color, Background = trough backing. -->
    <ControlTemplate x:Key="LocalChainTrimTemplate" TargetType="Control">
        <Grid Height="8" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.88" OpacityMask="{StaticResource LocalChainTrimMaskBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- CRT scanlines overlay (4x4 tile). Host Foreground + Opacity. -->
    <ControlTemplate x:Key="LocalScanlinesTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" OpacityMask="{StaticResource LocalScanlinesMaskBrush}" />
    </ControlTemplate>

    <!-- Shattered corner glass crack hairline (160x110). Host Foreground + Opacity. -->
    <ControlTemplate x:Key="LocalGlassCracksTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" OpacityMask="{StaticResource LocalGlassCracksMaskBrush}" />
    </ControlTemplate>

    <!-- Parchment paper tooth grain (256x256 tile). Host Foreground + Opacity. -->
    <ControlTemplate x:Key="LocalParchmentGrainTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" OpacityMask="{StaticResource LocalParchmentGrainMaskBrush}" />
    </ControlTemplate>

    <!-- Aged parchment corner stain (128x96). Host Foreground + Opacity. -->
    <ControlTemplate x:Key="LocalParchmentStainTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" OpacityMask="{StaticResource LocalParchmentStainMaskBrush}" />
    </ControlTemplate>

    <!-- Glowing vertical LED capsule (24x40). Host Foreground = hot mint glow. -->
    <ControlTemplate x:Key="LocalLedGlowTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" OpacityMask="{StaticResource LocalLedGlowMaskBrush}" />
    </ControlTemplate>

    <!-- Selection bar: CRT green glass plate with crisp ivory rim and glowing left mint LED bar. -->
    <ControlTemplate x:Key="SelectionBarTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Rectangle Fill="{DynamicResource GlyphBrush}" Opacity="0.06" OpacityMask="{StaticResource LocalScanlinesMaskBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Options-row selection from the game: a 1px ivory outline with a rounded left end and a pointed chevron
         on the right, over lit CRT glass. Host Foreground = fill, BorderBrush = outline. -->
    <ControlTemplate x:Key="LocalChevronRowTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="11" />
            </Grid.ColumnDefinitions>
            <Border Background="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1,1,0,1" CornerRadius="5,0,0,5" />
            <Path Grid.Column="1" Margin="-1,0,0,0" Stretch="Fill" Fill="{TemplateBinding Foreground}" Stroke="{TemplateBinding BorderBrush}"
                  StrokeThickness="1" StrokeLineJoin="Round" Data="M 0,0 L 4,0 L 10,5 L 4,10 L 0,10" />
            <Rectangle Grid.ColumnSpan="2" Margin="1,1,6,1" Fill="{DynamicResource GlyphBrush}" Opacity="0.06"
                       OpacityMask="{StaticResource LocalScanlinesMaskBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Engraved bezel groove: a dark cut over a lit bronze lip, the seam the game runs between panel sections.
         Host BorderBrush = lip color. No centre pip (a lone LED floating mid-rule read as a stray element). -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="8" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <StackPanel VerticalAlignment="Center">
                <Rectangle Height="1" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.85" />
                <Rectangle Height="1" Fill="{TemplateBinding BorderBrush}" Opacity="0.7" />
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <!-- Bronze bezel plate, the game's menu / modal button: dark keyline, 3px worn bronze band with a lit outer edge,
         dark inner keyline, scanlined CRT glass. Host Background = glass, BorderBrush = bronze band. -->
    <ControlTemplate x:Key="LocalBezelTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="False">
            <Control Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource BevelShadowBrush}"
                     BorderBrush="{DynamicResource BevelShadowBrush}" Focusable="False" />
            <Control Margin="1" Template="{DynamicResource ChamferTemplate}" Background="{TemplateBinding BorderBrush}"
                     BorderBrush="{DynamicResource LocalBezelLitBrush}" Focusable="False" />
            <Control Margin="4" Template="{DynamicResource ChamferTemplate}" Background="{TemplateBinding Background}"
                     BorderBrush="{DynamicResource LocalBezelDarkBrush}" Focusable="False" />
            <Rectangle Margin="5" Fill="{DynamicResource GlyphBrush}" Opacity="0.09" IsHitTestVisible="False">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.62" GradientOrigin="0.5,0.62" RadiusX="0.62" RadiusY="0.95">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Margin="6" Fill="{DynamicResource GlyphBrush}" Opacity="0.07" OpacityMask="{StaticResource LocalScanlinesMaskBrush}" />
            <Rectangle Margin="8,5,8,0" Height="1" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" Opacity="0.12" />
        </Grid>
    </ControlTemplate>

    <!-- Recessed CRT input & selector well (ComboBox, TextBox, PasswordBox, SearchBox, ComboBoxList, FilterSelectionBox):
         dark shadow keyline, 2px chamfered bronze bezel (BorderBrush = rim fill, Foreground = outer lit edge),
         recessed deep CRT glass (Background) with radial phosphor glow, scanlines, and top glass sheen. -->
    <ControlTemplate x:Key="LocalInputWellTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="False">
            <Control Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource BevelShadowBrush}"
                     BorderBrush="{DynamicResource BevelShadowBrush}" Focusable="False" />
            <Control Margin="1" Template="{DynamicResource ChamferTemplate}" Background="{TemplateBinding BorderBrush}"
                     BorderBrush="{TemplateBinding Foreground}" Focusable="False" />
            <Control Margin="3" Template="{DynamicResource ChamferTemplate}" Background="{TemplateBinding Background}"
                     BorderBrush="{DynamicResource LocalBezelDarkBrush}" Focusable="False" />
            <Rectangle Margin="4" Fill="{DynamicResource GlyphBrush}" Opacity="0.06" IsHitTestVisible="False">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.6" GradientOrigin="0.5,0.6" RadiusX="0.65" RadiusY="0.95">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Margin="4" Fill="{DynamicResource GlyphBrush}" Opacity="0.07" OpacityMask="{StaticResource LocalScanlinesMaskBrush}" />
            <Rectangle Margin="8,4,8,0" Height="1" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" Opacity="0.1" />
        </Grid>
    </ControlTemplate>

    <!-- Short LED stub at a plate's end (the game's menu plates carry one at each end, dark when idle, mint when lit). -->
    <ControlTemplate x:Key="LocalLedStubTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" Width="14">
            <Control x:Name="Halo" Template="{DynamicResource LocalLedGlowTemplate}" Foreground="{TemplateBinding Foreground}"
                     Opacity="0.55" Margin="0,-6" Focusable="False" />
            <Border Width="3" Margin="0,2" HorizontalAlignment="Center" CornerRadius="1.5"
                    Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="0.5" />
        </Grid>
    </ControlTemplate>

    <!-- Ordnance CRT score readout plate (Community / Critic / User scores in the parchment dossier):
         chamfered bronze bezel, recessed scanlined CRT glass, radial phosphor bloom, and twin vertical LED end-capsules
         colored by ScoreRating (Positive = acid-lime/mint, Mixed = tarnished brass-gold, Negative = conduit crimson). -->
    <ControlTemplate x:Key="LocalScorePlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="False">
            <Control Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource BevelShadowBrush}"
                     BorderBrush="{DynamicResource BevelShadowBrush}" Focusable="False" />
            <Control x:Name="BezelRim" Margin="1" Template="{DynamicResource ChamferTemplate}"
                     Background="{DynamicResource LocalBezelBrush}" BorderBrush="{DynamicResource LocalBezelLitBrush}" Focusable="False" />
            <Control x:Name="CrtGlass" Margin="2.5" Template="{DynamicResource ChamferTemplate}"
                     Background="{DynamicResource PropertyItemBackgroundBrush}" BorderBrush="{DynamicResource LocalBezelDarkBrush}" Focusable="False" />
            <Rectangle x:Name="PhosphorGlow" Margin="3.5" Fill="{DynamicResource PositiveRatingBrush}" Opacity="0.16" IsHitTestVisible="False">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.58" GradientOrigin="0.5,0.58" RadiusX="0.65" RadiusY="0.95">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle x:Name="Scanlines" Margin="4" Fill="{DynamicResource GlyphBrush}" Opacity="0.09"
                       OpacityMask="{StaticResource LocalScanlinesMaskBrush}" />
            <Rectangle Margin="7,3.5,7,0" Height="1" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" Opacity="0.14" />
            <Control x:Name="LeftLedHalo" Template="{DynamicResource LocalLedGlowTemplate}"
                     Foreground="{DynamicResource PositiveRatingBrush}" Width="11" Height="18"
                     Margin="0.5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.48" Focusable="False" />
            <Border x:Name="LeftLedCore" Width="2.2" Height="9" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    CornerRadius="1.1" Background="{DynamicResource PositiveRatingBrush}" />
            <Control x:Name="RightLedHalo" Template="{DynamicResource LocalLedGlowTemplate}"
                     Foreground="{DynamicResource PositiveRatingBrush}" Width="11" Height="18"
                     Margin="0,0,0.5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.48" Focusable="False" />
            <Border x:Name="RightLedCore" Width="2.2" Height="9" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="1.1" Background="{DynamicResource PositiveRatingBrush}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Mixed}">
                <Setter TargetName="CrtGlass" Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
                <Setter TargetName="PhosphorGlow" Property="Fill" Value="{DynamicResource MixedRatingBrush}" />
                <Setter TargetName="Scanlines" Property="Fill" Value="{DynamicResource MixedRatingBrush}" />
                <Setter TargetName="LeftLedHalo" Property="Foreground" Value="{DynamicResource MixedRatingBrush}" />
                <Setter TargetName="RightLedHalo" Property="Foreground" Value="{DynamicResource MixedRatingBrush}" />
                <Setter TargetName="LeftLedCore" Property="Background" Value="{DynamicResource MixedRatingBrush}" />
                <Setter TargetName="RightLedCore" Property="Background" Value="{DynamicResource MixedRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Negative}">
                <Setter TargetName="CrtGlass" Property="Background" Value="{DynamicResource LocalBloodStainBrush}" />
                <Setter TargetName="PhosphorGlow" Property="Fill" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="Scanlines" Property="Fill" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="LeftLedHalo" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="RightLedHalo" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="LeftLedCore" Property="Background" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="RightLedCore" Property="Background" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Brass corner miters & bolts over a panel frame (no desired width >= 200). -->
    <ControlTemplate x:Key="RivetsTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" Fill="{DynamicResource LocalBrassBrush}" Data="M0,0 L10,0 L0,10 Z" />
            <Path Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Fill" Fill="{DynamicResource LocalBrassBrush}" Data="M0,0 L10,0 L10,10 Z" />
            <Path Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Fill" Fill="{DynamicResource LocalBrassBrush}" Data="M0,0 L0,10 L10,10 Z" />
            <Path Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stretch="Fill" Fill="{DynamicResource LocalBrassBrush}" Data="M10,0 L10,10 L0,10 Z" />
        </Grid>
    </ControlTemplate>

    <!-- Corner brackets for keyboard focus and cover selections. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,9 L0,0 9,0 9,2 2,2 2,9Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L9,0 9,9 7,9 7,2 0,2Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L2,0 2,7 9,7 9,9 0,9Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M7,0 L9,0 9,9 0,9 0,7 7,7Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <!-- Original Cogplate 12-tooth cogwheel + octagonal phosphor aperture mark. -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource IconMainMenu}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Title capsule text (Description, Notes): condensed ivory caps like the game's SELECT DIFFICULTY plate. -->
    <DataTemplate x:Key="LocalCapsHeadingTemplate">
        <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" FontFamily="{DynamicResource HeadingFontFamily}"
                   FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" Foreground="{DynamicResource HeadingForegroundBrush}"
                   TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <!-- Dossier field caption: condensed sepia stencil, same optical size as the value beside it. -->
    <Style x:Key="LocalDossierLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ParchmentLabelBrush}" />
    </Style>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBoxFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Steam Screenshots loading placeholder: breathes calmly while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel x:Name="Root" IsHitTestVisible="False" Opacity="0.4">
            <Border Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Grid.Column="2" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="4" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="6" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="8" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}" />
            </Grid>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Breathe">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0.45" To="0.95" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Breathe" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- EmptyGameTemplate: bolted CRT viewport with phosphor scanlines, corner crack hairline, pulsing cogwheel reticle & LOCErrorNoGameSelected. -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Border Width="340" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="2"
                Padding="4" IsHitTestVisible="False">
            <Grid>
                <Border Background="{DynamicResource LocalCrtDeepBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" Padding="24,22">
                    <Grid ClipToBounds="True">
                        <Rectangle Fill="{DynamicResource GlyphBrush}" Opacity="0.06" OpacityMask="{StaticResource LocalScanlinesMaskBrush}" />
                        <Rectangle Fill="{DynamicResource ScrimBrush}" Opacity="0.45" OpacityMask="{StaticResource LocalVignetteMaskBrush}" />
                        <Rectangle Width="120" Height="82" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-8"
                                   Fill="{DynamicResource GlyphBrush}" Opacity="0.16" OpacityMask="{StaticResource LocalGlassCracksMaskBrush}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="130" Height="110" HorizontalAlignment="Center">
                                <Ellipse x:Name="OrbitalRing" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" StrokeDashArray="6 4" Opacity="0.35" />
                                <Control x:Name="CogCrest" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource LocalBrassLitBrush}" Opacity="0.88" Focusable="False" />
                            </Grid>
                            <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" BorderBrush="{DynamicResource FrameBrush}"
                                     Margin="0,6,0,10" Focusable="False" />
                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                       FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Opacity="0.92" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Control Template="{DynamicResource RivetsTemplate}" Focusable="False" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyCrtLoop">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OrbitalRing" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.22" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.58" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.22" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CogCrest" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.72" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyCrtLoop" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
