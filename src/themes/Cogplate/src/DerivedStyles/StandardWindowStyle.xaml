<!--
    Cogplate: dialog windows (Settings, game editor, add-ons). A 44px armored gunmetal header (CaptionHeight 44 = content offset)
    trimmed at top by chain links and flanked by crimson shoulder conduits, opening with the chamfered CRT cog-badge,
    uppercase Barlow Condensed title (Settings window gets LOCSettingsLabel via trigger), ghosted cogwheel watermark on the right,
    and a steel closing rule carrying a phosphor mint center LED pip. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>
    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" ClipToBounds="True">
                                    <Border Background="{DynamicResource WindowTitleBackgroundBrush}" />
                                    <Control Template="{DynamicResource LocalChainTrimTemplate}" VerticalAlignment="Top" Height="5" Margin="0,-1,0,0"
                                             Foreground="{DynamicResource LocalBrassBrush}" Background="{DynamicResource ScrimBrush}" Opacity="0.55" Focusable="False" />
                                    <Path Width="22" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7,0,0"
                                          Stroke="{DynamicResource LocalConduitBrush}" StrokeThickness="2" Opacity="0.7" IsHitTestVisible="False"
                                          Data="M0,4 C10,4 8,24 20,24" />
                                    <Control Template="{DynamicResource BrandMarkTemplate}" Width="48" Height="48"
                                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,126,0"
                                             Foreground="{DynamicResource LocalBrassBrush}" Opacity="0.08" Focusable="False" />
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />
                                    <Rectangle Width="96" Height="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource TopPanelRuleStartBrush}" IsHitTestVisible="False" />
                                    <!-- PART_TextTitle keeps the real title (Playnite and the Settings trigger set it); the band shows an uppercase copy.
                                         Playnite makes this element visible once a window has a Title, so it lives in a Collapsed parent. -->
                                    <Border Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="{TemplateBinding Title}" x:Name="PART_TextTitle" Width="0" Height="0" Opacity="0" Foreground="Transparent" />
                                    </Border>
                                    <DockPanel Margin="14,0,148,0" LastChildFill="False" IsHitTestVisible="False">
                                        <Grid DockPanel.Dock="Left" Height="26" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                            <Control Template="{DynamicResource LocalBezelTemplate}" Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                                                     BorderBrush="{DynamicResource LocalBezelBrush}" Focusable="False" />
                                            <StackPanel Orientation="Horizontal" Margin="10,0,10,0">
                                                <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource LocalLedHotBrush}"
                                                         Width="15" Height="15" VerticalAlignment="Center" Focusable="False" />
                                                <Border Width="2" Height="10" Margin="6,0,0,0" VerticalAlignment="Center" CornerRadius="1"
                                                        Background="{DynamicResource LocalLedHotBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Left" Margin="11,0,0,1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Text, ElementName=PART_TextTitle, Converter={StaticResource StringToUpperCaseConverter}}"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLarger}"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
