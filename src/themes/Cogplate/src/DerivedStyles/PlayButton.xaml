<!--
    Cogplate: Hero PlayButton and RunningActionIndicator.
    PlayButton: octagonal chamfered CRT green display (PrimaryButtonBackgroundBrush) recessed inside a dark armored gunmetal bezel
    (ScrimBrush / LocalBrassBrush corner bevels), 9-slice mint bloom (GlowFrameTemplate), and twin glowing vertical mint LED
    end-capsules (LocalLedGlowTemplate + LocalLedHotBrush). Hover ignites bright CRT green + surging LEDs; Tag="ContextAction" hides PlayGlyph.
    LAUNCHING / RUNNING: plate switches to HUD Armor Cobalt (RunningIndicatorBrush #245CE0), darkened by RunningBreath (ScrimBrush)
    for >= 4.5:1 bone text contrast. Launching sweeps an angled cobalt scan + segmented HUD charge bar; Running breathes calmly with
    3 pulsing cobalt chevron motes; hovering RUNNING (Self) swaps to Cancel. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.9" IsHitTestVisible="False" SnapsToDevicePixels="False">
                        <Control x:Name="RunningWash" Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource RunningIndicatorBrush}"
                                 BorderBrush="Transparent" Opacity="0.16" Focusable="False" />
                        <Control x:Name="RunningFrame" Template="{DynamicResource ChamferTemplate}" Background="Transparent"
                                 BorderBrush="{DynamicResource RunningIndicatorBrush}" Focusable="False" />
                        <Grid Height="3" Margin="14,0,14,4" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.32" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalArmorLitBrush}" RenderTransformOrigin="0,0.5"
                                       OpacityMask="{DynamicResource LocalSegmentedCellsMaskBrush}">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <StackPanel Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Path x:Name="RunningMote1" Width="4" Height="6" Stretch="Fill" Fill="{DynamicResource LocalArmorLitBrush}" Opacity="0.35" Data="M0,0 L4,3 L0,6 L1.5,3 Z" />
                            <Path x:Name="RunningMote2" Width="5" Height="7" Margin="2,0,0,0" Stretch="Fill" Fill="{DynamicResource TextBrush}" Opacity="0.45" Data="M0,0 L5,3.5 L0,7 L1.8,3.5 Z" />
                            <Path x:Name="RunningMote3" Width="4" Height="6" Margin="2,0,0,0" Stretch="Fill" Fill="{DynamicResource LocalArmorLitBrush}" Opacity="0.35" Data="M0,0 L4,3 L0,6 L1.5,3 Z" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.95" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.95" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.12" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.24" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.7" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.7" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalBezelDarkBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="24,5" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="False">
                        <!-- 9-slice mint CRT bloom aura (rasterized FX mask, no BlurEffect) -->
                        <!-- Scaled with a RenderTransform, not negative margins: margins this large make WPF clip the plate to its slot -->
                        <Control x:Name="Bloom" Template="{DynamicResource LocalDropGlowTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                 Opacity="0" IsHitTestVisible="False" Focusable="False" RenderTransformOrigin="0.5,0.375">
                            <Control.RenderTransform>
                                <ScaleTransform ScaleX="1.289" ScaleY="2.2" />
                            </Control.RenderTransform>
                        </Control>

                        <!-- Worn bronze bezel around the glass (same bezel as every Cogplate plate): dark keyline, lit bronze band -->
                        <Control Margin="-4" Template="{DynamicResource ChamferTemplate}"
                                 Background="{DynamicResource BevelShadowBrush}" BorderBrush="{DynamicResource BevelShadowBrush}"
                                 IsHitTestVisible="False" Focusable="False" />
                        <Control x:Name="OuterCradle" Margin="-3" Template="{DynamicResource ChamferTemplate}"
                                 Background="{DynamicResource LocalBezelBrush}" BorderBrush="{DynamicResource LocalBezelLitBrush}"
                                 IsHitTestVisible="False" Focusable="False" />

                        <!-- Base chamfered CRT plate -->
                        <Control x:Name="BasePlate" Template="{DynamicResource ChamferTemplate}"
                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                 IsHitTestVisible="False" Focusable="False" />

                        <!-- Subtle phosphor scanline texture inside plate -->
                        <Rectangle Margin="3" Fill="{DynamicResource GlyphBrush}" Opacity="0.12" IsHitTestVisible="False">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.62" GradientOrigin="0.5,0.62" RadiusX="0.62" RadiusY="0.95">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
                        <Rectangle Margin="3" Fill="{DynamicResource GlyphBrush}" Opacity="0.08" IsHitTestVisible="False"
                                   OpacityMask="{DynamicResource LocalScanlinesMaskBrush}" />

                        <!-- Scrim darkening for Running / Launching contrast -->
                        <Control x:Name="RunningBreath" Template="{DynamicResource ChamferTemplate}"
                                 Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent"
                                 Opacity="0" IsHitTestVisible="False" Focusable="False" />

                        <!-- Launching diagonal cobalt sweep band -->
                        <Grid x:Name="RunningScan" Visibility="Collapsed" Opacity="0.65" IsHitTestVisible="False">
                            <Grid.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                    <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                </LinearGradientBrush>
                            </Grid.OpacityMask>
                            <Control Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource LocalArmorLitBrush}"
                                     BorderBrush="Transparent" Focusable="False" />
                        </Grid>

                        <!-- Hover CRT surge plate (Collapsed at rest) -->
                        <Control x:Name="HoverLayer" Template="{DynamicResource ChamferTemplate}"
                                 Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                 BorderBrush="{DynamicResource LocalBezelDarkBrush}"
                                 Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False" />

                        <!-- Pressed sink plate (Collapsed at rest) -->
                        <Control x:Name="PressLayer" Template="{DynamicResource ChamferTemplate}"
                                 Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                 BorderBrush="{DynamicResource PrimaryButtonBorderBrush}"
                                 Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False" />

                        <!-- Twin glowing vertical mint LED end-capsules (signature Boltgun 2 terminal CTA flanks) -->
                        <Grid x:Name="LedCapsules" IsHitTestVisible="False">
                            <!-- Unlit LED tubes at rest: dark glass in a bronze sleeve, like the idle menu plates in the source -->
                            <Border Width="3" Height="16" Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="1.5"
                                    Background="{DynamicResource LocalBezelDarkBrush}" BorderBrush="{DynamicResource LocalBezelBrush}" BorderThickness="0.5" />
                            <Border Width="3" Height="16" Margin="0,0,7,0" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="1.5"
                                    Background="{DynamicResource LocalBezelDarkBrush}" BorderBrush="{DynamicResource LocalBezelBrush}" BorderThickness="0.5" />
                            <!-- Lit cores and halos, faded in only while hovered -->
                            <Control x:Name="LeftLedHalo" Template="{DynamicResource LocalLedGlowTemplate}"
                                     Foreground="{DynamicResource GlyphBrush}" Width="16" Height="26"
                                     Margin="-1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" Focusable="False" />
                            <Border x:Name="LeftLedCore" Width="3" Height="16" Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    CornerRadius="1.5" Background="{DynamicResource LocalLedHotBrush}" Opacity="0" />
                            <Control x:Name="RightLedHalo" Template="{DynamicResource LocalLedGlowTemplate}"
                                     Foreground="{DynamicResource GlyphBrush}" Width="16" Height="26"
                                     Margin="0,0,-1,0" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0" Focusable="False" />
                            <Border x:Name="RightLedCore" Width="3" Height="16" Margin="0,0,7,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    CornerRadius="1.5" Background="{DynamicResource LocalLedHotBrush}" Opacity="0" />
                        </Grid>

                        <!-- Running + hover Cancel dim scrim -->
                        <Control x:Name="RunningHoverDim" Template="{DynamicResource ChamferTemplate}"
                                 Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent"
                                 Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False" />

                        <!-- Content & Cancel label -->
                        <Border x:Name="PlayRoom" Padding="0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                <StackPanel x:Name="PlayContent" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentControl x:Name="PlayGlyph" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"
                                                    Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}"
                                                    Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock x:Name="PlayLabel"
                                               Text="{TemplateBinding Content, Converter={StaticResource StringToUpperCaseConverter}}"
                                               FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                           Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                           FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Game.IsInstalled}" Value="False">
                            <Setter TargetName="PlayGlyph" Property="Content" Value="{DynamicResource IconDownload}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LedCapsules" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.3" To="0.5" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LedCapsules" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.42" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.22" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: ONLY while RUNNING button itself is hovered (Self, never TemplatedParent). -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RunningHoverDim" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.42" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="LeftLedHalo" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="RightLedHalo" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="LeftLedCore" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RightLedCore" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="LeftLedHalo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="RightLedHalo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="LeftLedCore" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="RightLedCore" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- RunningMarkRoom left="0" right="30": reserve space for the 3 HUD Armor Cobalt chevron motes. -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,30,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,30,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,30,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,30,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalArmorLitBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalArmorLitBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
