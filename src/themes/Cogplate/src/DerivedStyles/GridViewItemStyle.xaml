<!--
    Cogplate: GridViewItemStyle (cover tiles).
    Selected, static: tarnished brass-gold 1.5px frame (GridViewItemSelectedBorderBrush #D8A84E) with 3px void shadow,
    brass corner brackets, and top/bottom glowing phosphor mint LED pips.
    Hover, animated: phosphor mint GlowFrameTemplate + crisp mint outline + corner brackets fading cleanly.
    Running / Launching: HUD Armor Cobalt (RunningIndicatorBrush #245CE0) 2px frame inset 4px inside the cover,
    inner wash, angled cobalt RunningScan, segmented HUD foot bar, and 3 pulsing cobalt chevron motes at top-center.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}" Margin="{Settings ItemSpacingMargin}" x:Name="ItemGrid" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="SelectScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Grid x:Name="LightWrap" Margin="-11" IsHitTestVisible="False">
                            <Control x:Name="HoverLight" Template="{DynamicResource LocalScanGlowTemplate}" Foreground="{DynamicResource GridViewItemHoverBorderBrush}"
                                     Opacity="0" Visibility="Collapsed" Focusable="False" />
                        </Grid>
                        <Border x:Name="SelectionShadow" Opacity="0" BorderThickness="3" Margin="-3" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelShadowBrush}" Visibility="Collapsed" />
                        <ContentPresenter />
                        <Border x:Name="SelectionBorder" Visibility="Collapsed" Opacity="0" BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" BorderThickness="1.5" Margin="-2" IsHitTestVisible="False" />
                        <Border x:Name="HoverFrame" BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" BorderThickness="1"
                                Margin="-2" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Control x:Name="HoverMarks" Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource GlyphBrush}"
                                 Margin="-7" Opacity="0" Visibility="Collapsed" Focusable="False" />
                        <Grid x:Name="SelectedChrome" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                            <Control x:Name="SelectedMarks" Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource GridViewItemSelectedBorderBrush}"
                                     Margin="-7" Focusable="False" />
                            <Border Width="18" Height="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0"
                                    CornerRadius="1" Background="{DynamicResource LocalLedHotBrush}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="0.5" />
                            <Border Width="18" Height="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3"
                                    CornerRadius="1" Background="{DynamicResource LocalLedHotBrush}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="0.5" />
                        </Grid>

                        <!-- Running game indicator inset 4px inside cover so selection never hides it -->
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.88" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="5" Opacity="0.2" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource LocalArmorLitBrush}" Opacity="0.34">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.4">
                                        <GradientStop x:Name="RunningScanA" Color="#00000000" Offset="-0.36" />
                                        <GradientStop x:Name="RunningScanB" Color="#FF000000" Offset="-0.22" />
                                        <GradientStop x:Name="RunningScanC" Color="#FF000000" Offset="-0.10" />
                                        <GradientStop x:Name="RunningScanD" Color="#00000000" Offset="0" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2">
                                <Border BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1" Opacity="0.65" />
                            </Border>
                            <Grid Height="9" Margin="8,0,8,8" VerticalAlignment="Bottom">
                                <Border Background="{DynamicResource BevelShadowBrush}" Opacity="0.88" />
                                <Grid Height="3" Margin="3,0" VerticalAlignment="Center">
                                    <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                    <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalArmorLitBrush}" RenderTransformOrigin="0,0.5"
                                               OpacityMask="{DynamicResource LocalSegmentedCellsMaskBrush}">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Padding="7,3"
                                    Background="{DynamicResource BevelShadowBrush}" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="RunningMote1" Width="4" Height="6" Stretch="Fill" Fill="{DynamicResource LocalArmorLitBrush}" Opacity="0.35" Data="M0,0 L4,3 L0,6 L1.5,3 Z" />
                                    <Path x:Name="RunningMote2" Width="5" Height="7" Margin="3,0,0,0" Stretch="Fill" Fill="{DynamicResource TextBrush}" Opacity="0.45" Data="M0,0 L5,3.5 L0,7 L1.8,3.5 Z" />
                                    <Path x:Name="RunningMote3" Width="4" Height="6" Margin="3,0,0,0" Stretch="Fill" Fill="{DynamicResource LocalArmorLitBrush}" Opacity="0.35" Data="M0,0 L4,3 L0,6 L1.5,3 Z" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="HoverExit" />
                                <BeginStoryboard Name="HoverEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLight" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLight" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <ThicknessAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Margin" To="-4" Duration="0:0:0.16">
                                            <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="HoverExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <ThicknessAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Margin" To="-7" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLight" Storyboard.TargetProperty="Visibility" Duration="0:0:0.22">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility" Duration="0:0:0.2">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Visibility" Duration="0:0:0.2">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="HoverEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="SelectExit" />
                                <BeginStoryboard Name="SelectEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionShadow" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedChrome" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectionShadow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelectedChrome" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <ThicknessAnimation Storyboard.TargetName="SelectedMarks" Storyboard.TargetProperty="Margin" From="-7" To="-5" Duration="0:0:0.16">
                                            <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.985" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1">
                                                <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectScale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.985" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1">
                                                <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="SelectExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectionShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedChrome" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionShadow" Storyboard.TargetProperty="Visibility" Duration="0:0:0.14">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Visibility" Duration="0:0:0.14">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedChrome" Storyboard.TargetProperty="Visibility" Duration="0:0:0.14">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="SelectEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanA" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.36" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.5,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanB" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.22" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.14" KeySpline="0.5,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.14" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanC" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.10" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.26" KeySpline="0.5,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.26" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanD" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.36" KeySpline="0.5,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.36" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.5,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.3" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
