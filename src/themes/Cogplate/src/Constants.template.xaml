<!--
    Cogplate: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json) and Playnite palette keys.
    Cogplate's token names (cg-*) stay in tokens.css; here each placeholder maps a key to its role.
    Theme XAML reads brushes only, never Color keys. No double braces in comments.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography. Barlow Condensed (SemiBold, Bold) and Barlow Semi Condensed (Regular, SemiBold, Bold) are SIL OFL
         and bundled in src/Typography, leading their stacks as ./Typography/#Family. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow Semi Condensed, {{text:font-body|Barlow Semi Condensed}}, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Barlow Condensed, {{text:font-heading|Barlow Condensed}}, Arial Narrow, Segoe UI</FontFamily>
    <FontFamily x:Key="PosterFontFamily">./Typography/#Barlow Condensed, {{text:font-heading|Barlow Condensed}}, Arial Narrow, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width; applied inside the dossier frame & horizontal padding. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape: crisp architectural gunmetal corners; hero buttons use chamfered bevel templates. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-small|1}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-large|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{cg-ivory}}</Color>
    <Color x:Key="TextColorDarker">{{cg-sage}}</Color>
    <Color x:Key="TextColorDark">{{cg-void}}</Color>
    <Color x:Key="MainColor">{{cg-steel-plate}}</Color>
    <Color x:Key="MainColorDark">{{cg-crt}}</Color>
    <Color x:Key="HoverColor">{{cg-steel-lit}}</Color>
    <Color x:Key="GlyphColor">{{cg-mint}}</Color>
    <Color x:Key="HighlightGlyphColor">{{cg-crt-lit}}</Color>
    <Color x:Key="PopupBackgroundColor">{{cg-crt}}</Color>
    <Color x:Key="PopupBorderColor">{{cg-steel-rim}}</Color>
    <Color x:Key="BackgroundToneColor">{{cg-crt}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">#00000000</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{cg-steel-rim}}</Color>
    <Color x:Key="DataChangeNotifColor">{{cg-lime-lit}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{cg-crt-deep}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{cg-steel-plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{cg-void}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{cg-lime-lit}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{cg-conduit-lit}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{cg-brass-lit}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{cg-brass-lit}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{cg-crt}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{cg-iron}}" />

    <!-- Shell & Surfaces -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{cg-iron-dark}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{cg-iron}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{cg-iron-dark}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{cg-iron}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{cg-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{cg-crt-deep}}" />
    <!-- Banner darkening color: deep CRT phosphor glass (#0B1B0E) cools hero art into Cogplate's emerald terminal mood. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{cg-crt-deep}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{cg-crt-deep}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{cg-brass-lit}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{cg-crt-deep}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{cg-crt}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{cg-brass}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{cg-void}}" />

    <!-- States & Selection -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{cg-crt-lit}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{cg-ivory}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{cg-ivory}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{cg-mint-hot}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{cg-steel-lit}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{cg-crt-lit}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{cg-crt-lit}}" />
    <!-- HUD Armor Cobalt: completely distinct blue hue reserved solely for running/launching games. -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{cg-armor}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{cg-mint}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{cg-mint-hot}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{cg-conduit}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{cg-ivory}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{cg-sage}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{cg-ivory}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{cg-sage}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{cg-steel-lit}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{cg-steel-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{cg-crt-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{cg-crt-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{cg-crt-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{cg-ivory}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{cg-mint}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{cg-steel-plate}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{cg-steel-lit}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{cg-steel-press}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{cg-crt-lit}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{cg-crt-deep}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{cg-crt}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{cg-steel-hi}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{cg-steel-hi}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{cg-lime}}" />

    <!-- Tracks, Thumbs, Tabs & Shell Controls -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{cg-void}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{cg-steel-hi}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{cg-mint}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{cg-mint-hot}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{cg-void}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{cg-lime-lit}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{cg-steel-hi}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{cg-mint}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{cg-void}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{cg-steel-hi}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{cg-mint}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{cg-sage}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{cg-ivory}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{cg-mint}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{cg-iron-dark}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{cg-mint}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{cg-brass-lit}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{cg-steel-lit}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{cg-crt-lit}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{cg-sage}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{cg-mint-hot}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{cg-mint-hot}}" />

    <!-- Metadata Chips, Tooltips, Dialog Chrome -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{cg-crt}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{cg-ivory}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{cg-crt-lit}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{cg-ivory}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{cg-iron-dark}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{cg-ivory}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{cg-mint}}" />

    <!-- Nailed Parchment Dossier -->
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{cg-parchment}}" />
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{cg-parchment-edge}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{cg-ink}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{cg-blood-stain}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{cg-ink-dim}}" />
    <SolidColorBrush x:Key="ParchmentLinkBrush" Color="{{cg-ink-link}}" />

    <!-- Frames, Headings & Bevels -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{cg-steel-plate}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{cg-steel-hi}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{cg-brass-lit}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{cg-void}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{cg-crt}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{cg-ivory}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{cg-ivory}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{cg-brass}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{cg-mint}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{cg-ivory}}" />
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{cg-brass-lit}}" />

    <!-- Theme-local decorative accent brushes -->
    <SolidColorBrush x:Key="LocalLedHotBrush" Color="{{cg-mint-hot}}" />
    <SolidColorBrush x:Key="LocalBrassBrush" Color="{{cg-brass}}" />
    <SolidColorBrush x:Key="LocalBrassLitBrush" Color="{{cg-brass-lit}}" />
    <SolidColorBrush x:Key="LocalConduitBrush" Color="{{cg-conduit}}" />
    <SolidColorBrush x:Key="LocalLimeLitBrush" Color="{{cg-lime-lit}}" />
    <SolidColorBrush x:Key="LocalBloodStainBrush" Color="{{cg-blood-stain}}" />
    <SolidColorBrush x:Key="LocalArmorLitBrush" Color="{{cg-armor-lit}}" />
    <SolidColorBrush x:Key="LocalCrtDeepBrush" Color="{{cg-crt-deep}}" />
    <SolidColorBrush x:Key="LocalCrtBrush" Color="{{cg-crt}}" />
    <SolidColorBrush x:Key="LocalCrtHoverBrush" Color="{{cg-crt-hover}}" />
    <SolidColorBrush x:Key="LocalBezelBrush" Color="{{cg-steel-rim}}" />
    <SolidColorBrush x:Key="LocalBezelLitBrush" Color="{{cg-steel-hi}}" />
    <SolidColorBrush x:Key="LocalBezelDarkBrush" Color="{{cg-bezel-dark}}" />
</ResourceDictionary>
