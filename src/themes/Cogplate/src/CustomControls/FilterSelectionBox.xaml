<!--
    Cogplate copy of the shared default (Playnite's filter dropdowns at ControlHeight); only the popup uses Cogplate's
    ordnance CRT panel (LocalOrdnanceCrtPanelTemplate, ContextMenu.xaml). Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="FilterSelectionBoxTemplate" TargetType="{x:Type FilterSelectionBoxBase}">
        <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="False">
            <Control x:Name="HoverGlow" Template="{DynamicResource LocalScanGlowTemplate}"
                     Foreground="{DynamicResource PrimaryButtonGlowBrush}" Margin="-8"
                     Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False" />
            <Control x:Name="Well" Template="{DynamicResource LocalInputWellTemplate}"
                     Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource LocalBezelBrush}"
                     Foreground="{DynamicResource LocalBezelLitBrush}" Focusable="False" />
            <Grid>
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right" Width="30" Height="28" Margin="0,0,-5,0" Background="Transparent" BorderThickness="0" Padding="0"
                                  Style="{DynamicResource ExpanderDownHeaderStyle}" IsChecked="True"
                                  Focusable="False" IsHitTestVisible="False" />
                    <TextBlock x:Name="PART_TextFilterString"
                               Style="{StaticResource BaseTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch"
                               VerticalAlignment="Center" DockPanel.Dock="Left"
                               Margin="10,0,0,0" />
                </DockPanel>
                <ToggleButton x:Name="MainToggle"
                              BorderThickness="0" Focusable="False" Cursor="Hand"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <TextBox x:Name="PART_TextFilterInput" Style="{DynamicResource BareTextBox}" BorderThickness="0" MinHeight="0"
                         VerticalAlignment="Center" Margin="10,0,54,0" />
                <Button x:Name="PART_ButtonClearFilter"
                        Margin="0,0,30,0" Width="24" FontSize="18" MinHeight="0" Height="28"
                        Background="Transparent" HorizontalAlignment="Right"
                        BorderThickness="0" Padding="3,0,3,0"
                        ContentTemplate="{DynamicResource ClearTextIconTemplate}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True" Name="Popup"
                       IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False"
                       MaxHeight="300" MinWidth="{Binding ActualWidth, ElementName=MainToggle}">
                    <Grid Margin="0,2,0,0" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalOrdnanceCrtPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <Grid Margin="5,11,5,6">
                            <ItemsControl x:Name="PART_ItemsPanel" />
                        </Grid>
                    </Grid>
                </Popup>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Well" Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard Name="FilterSelHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Name="FilterSelHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                    <RemoveStoryboard BeginStoryboardName="FilterSelHoverIn" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type FilterEnumSelectionBox}" BasedOn="{StaticResource {x:Type FilterEnumSelectionBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
    <Style TargetType="{x:Type FilterStringSelectionBox}" BasedOn="{StaticResource {x:Type FilterStringSelectionBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
    <Style TargetType="{x:Type FilterSelectionBox}" BasedOn="{StaticResource {x:Type FilterSelectionBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
</ResourceDictionary>
