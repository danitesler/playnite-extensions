            <Control x:Name="HoverGlow" Template="{DynamicResource LocalScanGlowTemplate}"
                     Foreground="{DynamicResource PrimaryButtonGlowBrush}" Margin="-9"
                     Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False" />
            <Control x:Name="Well" Template="{DynamicResource LocalInputWellTemplate}"
                     Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource LocalBezelBrush}"
                     Foreground="{DynamicResource LocalBezelLitBrush}" Focusable="False" />
            <Grid>
                <DockPanel>
                    <Grid x:Name="ArrowLane" DockPanel.Dock="Right" Width="28" Margin="0,3,3,3">
                        <Border x:Name="ChevronLane" Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource LocalBezelBrush}" BorderThickness="1,0,0,0" />
                        <ContentControl x:Name="ChevronGlyph" Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{DynamicResource LocalBrassLitBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                    </Grid>
                    <TextBlock x:Name="PART_TextFilterString"
                               Style="{StaticResource BaseTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch"
                               VerticalAlignment="Center" DockPanel.Dock="Left"
                               Margin="10,0,6,0" />
                </DockPanel>
                <ToggleButton x:Name="MainToggle"
                              BorderThickness="0" Focusable="False" Cursor="Hand"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Button x:Name="PART_ButtonClearFilter"
                        Margin="0,0,32,0" FontSize="18"
                        Background="Transparent" HorizontalAlignment="Right"
                        BorderThickness="0" Padding="3,0,3,0"
                        ContentTemplate="{DynamicResource ClearTextIconTemplate}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True" Name="Popup"
                       IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False"
                       MaxHeight="300" MinWidth="{Binding ActualWidth, ElementName=MainToggle}">
                    <Grid Margin="0,2,0,0" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalOrdnanceCrtPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <Grid Margin="5,11,5,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="5" Name="PART_ElemSearchHost">
                                    <CheckBox DockPanel.Dock="Right"
                                              x:Name="PART_ToggleSelectedOnly"
                                              ToolTip="{DynamicResource LOCOnlyItemsSelectedTooltip}"
                                              FontFamily="{DynamicResource FontIcoFont}" />
                                    <SearchBox DockPanel.Dock="Left" Margin="0,0,5,0" x:Name="PART_SearchBox" />
                                </DockPanel>
                                <ItemsControl x:Name="PART_ItemsPanel" Grid.Row="1" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Popup>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Well" Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
                <Setter TargetName="ChevronLane" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter TargetName="ChevronGlyph" Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard Name="FilterListBoxHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0.32" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Name="FilterListBoxHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                    <RemoveStoryboard BeginStoryboardName="FilterListBoxHoverIn" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ComboBoxList}" BasedOn="{StaticResource {x:Type ComboBoxList}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
    <Style TargetType="{x:Type DdItemListSelectionBox}" BasedOn="{StaticResource {x:Type DdItemListSelectionBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
</ResourceDictionary>
