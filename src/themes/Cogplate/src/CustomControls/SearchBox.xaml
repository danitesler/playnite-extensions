<!--
    Cogplate: SearchBox. Deep CRT glass well with persistent magnifier outside PART_SeachIcon.
    Keyboard focus illuminates the border in phosphor mint.
    Keeps PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid SnapsToDevicePixels="False">
                        <Control x:Name="HoverGlow" Template="{DynamicResource LocalScanGlowTemplate}"
                                 Foreground="{DynamicResource PrimaryButtonGlowBrush}" Margin="-8"
                                 Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False" />
                        <Control x:Name="Field" Template="{DynamicResource LocalInputWellTemplate}"
                                 Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource LocalBezelBrush}"
                                 Foreground="{DynamicResource LocalBezelLitBrush}" Focusable="False" />
                        <Grid>
                            <ContentControl x:Name="Glyph" Focusable="False" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{DynamicResource GlyphBrush}" Margin="10,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" />
                            <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                            <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     Padding="32,0,28,0" VerticalContentAlignment="Center" />
                            <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                            Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,9,0" Cursor="Hand"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ContentControl.Template>
                                    <ControlTemplate TargetType="ContentControl">
                                        <Border Background="Transparent" Padding="2">
                                            <ContentPresenter ContentSource="Content" />
                                        </Border>
                                    </ControlTemplate>
                                </ContentControl.Template>
                            </ContentControl>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="SearchHoverExit" />
                                <BeginStoryboard Name="SearchHoverEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="SearchHoverExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="SearchHoverEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
