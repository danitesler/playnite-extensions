<!--
    Cogplate: TabControl & TabItem. Keeps TextBrush on TabItem so tab page labels inherit readable ivory ink;
    HeaderText TextBlock handles idle/hover/selected colors. Selected tab ignites a luminous CRT green wash
    plus glowing phosphor mint LED bar and center capacitor notch. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnDefinition0" />
                            <ColumnDefinition x:Name="ColumnDefinition1" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" x:Name="RowDefinition0" />
                            <RowDefinition Height="*" x:Name="RowDefinition1" />
                        </Grid.RowDefinitions>
                        <Border x:Name="HeaderBorder" Background="{DynamicResource ControlBackgroundBrush}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Panel.ZIndex="1" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <Border x:Name="ContentPanel" Grid.Column="0" Grid.Row="1"
                                KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local" Background="{DynamicResource ControlBackgroundBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition1" Value="Auto" />
                            <Setter Property="Grid.Row" TargetName="HeaderBorder" Value="1" />
                            <Setter Property="BorderThickness" TargetName="HeaderBorder" Value="0,1,0,0" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter Property="Grid.Row" TargetName="HeaderBorder" Value="0" />
                            <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Grid.Column" TargetName="ContentPanel" Value="1" />
                            <Setter Property="Width" TargetName="ColumnDefinition0" Value="Auto" />
                            <Setter Property="Width" TargetName="ColumnDefinition1" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition1" Value="0" />
                            <Setter Property="BorderThickness" TargetName="HeaderBorder" Value="0,0,1,0" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter Property="Grid.Row" TargetName="HeaderBorder" Value="0" />
                            <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Grid.Column" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Grid.Column" TargetName="HeaderBorder" Value="1" />
                            <Setter Property="Width" TargetName="ColumnDefinition0" Value="*" />
                            <Setter Property="Width" TargetName="ColumnDefinition1" Value="Auto" />
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition1" Value="0" />
                            <Setter Property="BorderThickness" TargetName="HeaderBorder" Value="1,0,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Plate" Background="Transparent" Margin="0,0,5,2" MinHeight="34" SnapsToDevicePixels="False">
                        <Control x:Name="HoverGlow" Template="{DynamicResource LocalScanGlowTemplate}"
                                 Foreground="{DynamicResource PrimaryButtonGlowBrush}" Margin="-9"
                                 Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False" />
                        <Control x:Name="IdlePlate" Template="{DynamicResource LocalBezelTemplate}"
                                 Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource LocalBezelBrush}"
                                 Opacity="0.82" Focusable="False" />
                        <Control x:Name="HoverWash" Margin="3" Template="{DynamicResource ChamferTemplate}"
                                 Background="{DynamicResource ButtonHoverBackgroundBrush}" BorderBrush="{DynamicResource LocalBezelDarkBrush}"
                                 Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" />
                        <Grid x:Name="SelectedMark" Visibility="Collapsed" IsHitTestVisible="False">
                            <Control Template="{DynamicResource LocalBezelTemplate}"
                                     Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                                     BorderBrush="{DynamicResource LocalBezelLitBrush}" Focusable="False" />
                            <Control Template="{DynamicResource LocalLedStubTemplate}" HorizontalAlignment="Left" Margin="3.5,8"
                                     Background="{DynamicResource LocalLedHotBrush}" Foreground="{DynamicResource PrimaryButtonGlowBrush}" Focusable="False" />
                            <Control Template="{DynamicResource LocalLedStubTemplate}" HorizontalAlignment="Right" Margin="3.5,8"
                                     Background="{DynamicResource LocalLedHotBrush}" Foreground="{DynamicResource PrimaryButtonGlowBrush}" Focusable="False" />
                            <Rectangle Height="2" Margin="6,0,6,-2" VerticalAlignment="Bottom" Fill="{DynamicResource TabItemIndicatorBrush}" />
                            <Border Width="22" Height="3" Margin="0,0,0,-2.5" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    CornerRadius="1" Background="{DynamicResource LocalLedHotBrush}" />
                        </Grid>
                        <!-- Keep this TextBlock: game edit dialog headers bind Foreground to their ancestor TextBlock. -->
                        <TextBlock x:Name="HeaderText" Margin="18,6,18,7" VerticalAlignment="Center" FontWeight="Bold"
                                   Foreground="{DynamicResource TabItemForegroundBrush}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverWash" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IdlePlate" Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="TabHoverExit" />
                                <BeginStoryboard Name="TabHoverEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" Duration="0:0:0.18">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.04" Value="0.88" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="0.4" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.18" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0.32" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="TabHoverExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="TabHoverEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IdlePlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverWash" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
