<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is Boltgun 2's ordnance CRT visor panel (LocalOrdnanceCrtPanelTemplate, shared by
    ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: recessed CRT phosphor glass (PopupBackgroundBrush) with 4x4 scanlines (LocalScanlinesMaskBrush), 2px armored
      steel bezel (PopupBorderBrush) with dark inner bevel, topped by a 6px tarnished brass chain-link strip
      (LocalChainTrimMaskBrush) and four 4px brass corner rivets. No DropShadowEffect.
    - Rows, rules and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalOrdnanceCrtPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="2" BorderBrush="{DynamicResource ScrimBrush}" BorderThickness="1" />
            <!-- CRT phosphor scanlines -->
            <Rectangle Margin="3" Fill="{DynamicResource GlyphBrush}" Opacity="0.05"
                       OpacityMask="{DynamicResource LocalScanlinesMaskBrush}" />
            <!-- 6px tarnished brass chain-link strip along the top inner edge -->
            <Grid Height="6" Margin="2,2,2,0" VerticalAlignment="Top">
                <Rectangle Fill="{DynamicResource ShellBackgroundBrush}" />
                <Rectangle Fill="{DynamicResource LocalBrassBrush}" Opacity="0.9"
                           OpacityMask="{DynamicResource LocalChainTrimMaskBrush}" />
            </Grid>
            <!-- Four 4px brass corner rivets -->
            <Rectangle Width="4" Height="4" Margin="4,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource HeadingMarkerBrush}" />
            <Rectangle Width="4" Height="4" Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource HeadingMarkerBrush}" />
            <Rectangle Width="4" Height="4" Margin="4,0,0,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource LocalBrassBrush}" />
            <Rectangle Width="4" Height="4" Margin="0,0,4,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource LocalBrassBrush}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="232" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalOrdnanceCrtPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="5,11,5,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
