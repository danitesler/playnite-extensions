<!--
    Cogplate: Button. The game's menu plate: scanlined CRT glass (#121C15) inside a worn bronze bezel (LocalBezelTemplate),
    condensed sage label that turns ivory on hover while the end LED stubs light. IsDefault=True is the lit PLAY GAME plate
    (#1A3022 glass, ivory label, mint LEDs). Width == 41 trigger scales ThemeModifier icon buttons to 32x32 proportionally.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="False">
                        <Control x:Name="HoverGlow" Template="{DynamicResource LocalScanGlowTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                 Margin="-11" Visibility="Collapsed" Opacity="0" Focusable="False" />
                        <Control x:Name="Plate" Template="{DynamicResource LocalBezelTemplate}" Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}" Focusable="False" />
                        <Rectangle x:Name="HoverScan" Margin="5" Fill="{DynamicResource GlyphBrush}" Visibility="Collapsed" Opacity="0.22" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop x:Name="HoverScanTop" Color="#00000000" Offset="-0.4" />
                                    <GradientStop x:Name="HoverScanPeak" Color="#FF000000" Offset="-0.2" />
                                    <GradientStop x:Name="HoverScanBot" Color="#00000000" Offset="0" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Control x:Name="LeftLed" Template="{DynamicResource LocalLedStubTemplate}" HorizontalAlignment="Left" Margin="4,9"
                                 Background="{DynamicResource LocalLedHotBrush}" Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                 Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5" Focusable="False">
                            <Control.RenderTransform>
                                <ScaleTransform x:Name="LeftLedScale" ScaleY="0.2" />
                            </Control.RenderTransform>
                        </Control>
                        <Control x:Name="RightLed" Template="{DynamicResource LocalLedStubTemplate}" HorizontalAlignment="Right" Margin="4,9"
                                 Background="{DynamicResource LocalLedHotBrush}" Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                 Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5" Focusable="False">
                            <Control.RenderTransform>
                                <ScaleTransform x:Name="RightLedScale" ScaleY="0.2" />
                            </Control.RenderTransform>
                        </Control>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LeftLed" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RightLed" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="BtnHoverExit" />
                                <BeginStoryboard Name="BtnHoverEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverScan" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftLed" Storyboard.TargetProperty="Opacity" Duration="0:0:0.22">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.04" Value="0.92" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="0.35" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightLed" Storyboard.TargetProperty="Opacity" Duration="0:0:0.22">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.04" Value="0.92" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="0.35" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="LeftLedScale" Storyboard.TargetProperty="ScaleY" From="0.2" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RightLedScale" Storyboard.TargetProperty="ScaleY" From="0.2" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverScanTop" Storyboard.TargetProperty="Offset" RepeatBehavior="Forever" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.28" Value="1" KeySpline="0.35,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverScanPeak" Storyboard.TargetProperty="Offset" RepeatBehavior="Forever" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.28" Value="1.2" KeySpline="0.35,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverScanBot" Storyboard.TargetProperty="Offset" RepeatBehavior="Forever" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.28" Value="1.4" KeySpline="0.35,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="BtnHoverExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="LeftLed" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="RightLed" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverScan" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="BtnHoverEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 72'}" Value="True">
                            <Setter TargetName="LeftLed" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RightLed" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Padding" Value="22,5" />
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonPressedForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
