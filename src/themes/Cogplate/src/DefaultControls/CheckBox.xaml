<!--
    Cogplate: CheckBox. Chamfered ordnance CRT toggle switch (38x20) in a worn bronze bezel: recessed deep CRT chamber
    with scanlines at rest, igniting acid-lime / phosphor green with radial glow when checked, and a chamfered octagonal
    actuator shuttle carrying a vertical glowing LED core. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource CheckBoxFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <DockPanel Background="Transparent">
                        <Grid Width="38" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" SnapsToDevicePixels="False">
                            <Control x:Name="HoverGlow" Template="{DynamicResource LocalScanGlowTemplate}"
                                     Foreground="{DynamicResource PrimaryButtonGlowBrush}" Margin="-9"
                                     Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False" />

                            <!-- Outer dark shadow keyline + chamfered bronze bezel + recessed CRT chamber -->
                            <Control Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource BevelShadowBrush}"
                                     BorderBrush="{DynamicResource BevelShadowBrush}" IsHitTestVisible="False" Focusable="False" />
                            <Control x:Name="Bezel" Margin="1" Template="{DynamicResource ChamferTemplate}"
                                     Background="{DynamicResource LocalBezelBrush}" BorderBrush="{DynamicResource LocalBezelLitBrush}"
                                     IsHitTestVisible="False" Focusable="False" />
                            <Control x:Name="Track" Margin="2.5" Template="{DynamicResource ChamferTemplate}"
                                     Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource LocalBezelDarkBrush}"
                                     IsHitTestVisible="False" Focusable="False" />
                            <Rectangle Margin="3.5" Fill="{DynamicResource GlyphBrush}" Opacity="0.06" IsHitTestVisible="False"
                                       OpacityMask="{DynamicResource LocalScanlinesMaskBrush}" />

                            <!-- Checked lit CRT phosphor / acid-lime chamber -->
                            <Grid x:Name="Fill" Margin="2.5" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                <Control Template="{DynamicResource ChamferTemplate}"
                                         Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                                         BorderBrush="{DynamicResource CheckMarkBrush}" Focusable="False" />
                                <Rectangle Margin="1" Fill="{DynamicResource LocalLimeLitBrush}" Opacity="0.36">
                                    <Rectangle.OpacityMask>
                                        <RadialGradientBrush Center="0.45,0.55" GradientOrigin="0.45,0.55" RadiusX="0.7" RadiusY="0.95">
                                            <GradientStop Color="#FF000000" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Rectangle Margin="1" Fill="{DynamicResource LocalLimeLitBrush}" Opacity="0.14"
                                           OpacityMask="{DynamicResource LocalScanlinesMaskBrush}" />
                            </Grid>

                            <!-- Indeterminate dash -->
                            <Rectangle x:Name="Dash" Width="12" Height="2.5" RadiusX="1" RadiusY="1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Fill="{DynamicResource LocalLimeLitBrush}" Visibility="Collapsed" IsHitTestVisible="False" />

                            <!-- Chamfered octagonal ordnance actuator shuttle (clean, no vertical stripes) -->
                            <Grid x:Name="Knob" Width="15" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="3.5,0,0,0" IsHitTestVisible="False">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="KnobSlide" X="0" />
                                </Grid.RenderTransform>
                                <Path Data="M3,0 L12,0 L15,3 L15,10 L12,13 L3,13 L0,10 L0,3 Z"
                                      Fill="{DynamicResource BevelShadowBrush}" />
                                <Path x:Name="KnobBody" Data="M3.2,0.8 L11.8,0.8 L14.2,3.2 L14.2,9.8 L11.8,12.2 L3.2,12.2 L0.8,9.8 L0.8,3.2 Z"
                                      Fill="{DynamicResource ButtonBackgroundBrush}"
                                      Stroke="{DynamicResource LocalBezelLitBrush}" StrokeThickness="1.1" />
                            </Grid>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bezel" Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                            <Setter TargetName="KnobBody" Property="Stroke" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="SwitchHoverExit" />
                                <BeginStoryboard Name="SwitchHoverEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0.32" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="SwitchHoverExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="SwitchHoverEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="KnobBody" Property="Fill" Value="{DynamicResource LocalLimeLitBrush}" />
                            <Setter TargetName="KnobBody" Property="Stroke" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobSlide" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" Duration="0:0:0.2">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.04" Value="0.92" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="0.45" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Knob" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
