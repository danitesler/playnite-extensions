<!--
    Cogplate: RadioButton. Octagonal CRT phosphor aperture socket matching Cogplate's HUD telemetry ports.
    Checked ignites phosphor mint rim and glowing octagonal core. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource CheckBoxFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <DockPanel Background="Transparent">
                        <Grid Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Socket" Width="16" Height="16" Stretch="Fill"
                                  Fill="{DynamicResource CheckBoxCheckMarkBkBrush}" Stroke="{DynamicResource CheckBoxBorderBrush}" StrokeThickness="1.2"
                                  Data="M5,0 L11,0 L16,5 L16,11 L11,16 L5,16 L0,11 L0,5 Z" />
                            <Path x:Name="Gem" Width="8" Height="8" Stretch="Fill" Visibility="Collapsed"
                                  Fill="{DynamicResource LocalLedHotBrush}"
                                  Data="M2.5,0 L5.5,0 L8,2.5 L8,5.5 L5.5,8 L2.5,8 L0,5.5 L0,2.5 Z" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Socket" Property="Stroke" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Socket" Property="Stroke" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                            <Setter TargetName="Gem" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
