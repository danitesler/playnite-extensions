<!--
    Cogplate: RadioButton. Octagonal CRT phosphor aperture socket matching Cogplate's HUD telemetry ports.
    Checked ignites phosphor mint rim and glowing octagonal core. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource CheckBoxFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <DockPanel Background="Transparent">
                        <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" SnapsToDevicePixels="False">
                            <Control x:Name="HoverGlow" Template="{DynamicResource LocalScanGlowTemplate}"
                                     Foreground="{DynamicResource PrimaryButtonGlowBrush}" Margin="-8"
                                     Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False" />
                            <Path Data="M6,0 L14,0 L20,6 L20,14 L14,20 L6,20 L0,14 L0,6 Z"
                                  Fill="{DynamicResource BevelShadowBrush}" />
                            <Path x:Name="Bezel" Data="M6.4,1 L13.6,1 L19,6.4 L19,13.6 L13.6,19 L6.4,19 L1,13.6 L1,6.4 Z"
                                  Fill="{DynamicResource LocalBezelBrush}" Stroke="{DynamicResource LocalBezelLitBrush}" StrokeThickness="1" />
                            <Path x:Name="Socket" Data="M7,3 L13,3 L17,7 L17,13 L13,17 L7,17 L3,13 L3,7 Z"
                                  Fill="{DynamicResource InputBackgroundBrush}" Stroke="{DynamicResource LocalBezelDarkBrush}" StrokeThickness="1" />
                            <Control x:Name="CoreHalo" Template="{DynamicResource LocalLedGlowTemplate}"
                                     Foreground="{DynamicResource LocalLimeLitBrush}" Width="14" Height="14"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0.7" Focusable="False" />
                            <Path x:Name="Gem" Width="8" Height="8" Stretch="Fill" Visibility="Collapsed"
                                  Fill="{DynamicResource LocalLimeLitBrush}" Stroke="{DynamicResource LocalLedHotBrush}" StrokeThickness="0.8"
                                  Data="M2.5,0 L5.5,0 L8,2.5 L8,5.5 L5.5,8 L2.5,8 L0,5.5 L0,2.5 Z" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bezel" Property="Stroke" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="RadioHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0.32" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="RadioHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="RadioHoverIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Socket" Property="Fill" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                            <Setter TargetName="Socket" Property="Stroke" Value="{DynamicResource CheckMarkBrush}" />
                            <Setter TargetName="CoreHalo" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Gem" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
