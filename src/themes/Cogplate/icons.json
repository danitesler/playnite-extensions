{
    "_comment": "Streamline Cyber Free Icons (CC-BY-4.0, info/LICENSE-streamline-cyber.txt). Geometry job updates matching chamfered stroke icons in src/Media.xaml; IconMainMenu and small UI primitives stay in Media.xaml. Png jobs render Playnite's 24 menu icons at 48px using src/tokens.css colors.",
    "jobs": [
        {
            "urlTemplate": "https://api.iconify.design/streamline-cyber/{name}.svg",
            "format": "Geometry",
            "strokeGeometry": true,
            "keyPrefix": "Icon",
            "xamlOut": "src/Media.xaml",
            "updateXaml": true,
            "icons": [
                "remove-hexagon-1=Clear",
                "bookmark-favorite-star=FilterPresets",
                "package-stack-2=Group",
                "upload-download-traffic-data-transfer-hexagon=Sort",
                "window-application-6=DetailsView",
                "focus-3=GridView",
                "server=ListView",
                "synchronize-hexagon-2=Update",
                "hierarchy-business-2=Explorer",
                "cards-2=Random",
                "loop-diamond-1=ViewRandom",
                "filter-1=Filter",
                "alarm=Notifications",
                "controller-wireless=Library",
                "business-chart-4=Statistics",
                "check-double=Check",
                "add-hexagon-1=Add",
                "pen-2=Edit",
                "bin-2=Remove",
                "control-play=Play",
                "report-problem-warning-hexagon=Info",
                "download-2=Download"
            ]
        },
        {
            "urlTemplate": "https://api.iconify.design/streamline-cyber/{name}.svg",
            "format": "Png",
            "outDir": "src/Images/Cyber",
            "size": 48,
            "colorToken": "cg-ivory",
            "icons": [
                "window-tabs-1=fullscreen",
                "add-hexagon-1=add",
                "synchronize-hexagon-2=sync",
                "report-problem-warning-hexagon=info",
                "cog=settings",
                "computer-chips-32-bit=addons",
                "play-media-video-hexagon=play",
                "download-2=install",
                "globe-1=links",
                "transfer-folder=folder",
                "harddisk-1=storage",
                "computer-pc-4=desktop",
                "badge-star-2=star-off",
                "layer-hide=hide",
                "view-2=unhide",
                "sun-1=hdr",
                "pen-2=edit",
                "cards-2=random",
                "book-open-1=manual",
                "safe-1=backup",
                "clock-1=restore"
            ]
        },
        {
            "urlTemplate": "https://api.iconify.design/streamline-cyber/{name}.svg",
            "format": "Png",
            "outDir": "src/Images/Cyber",
            "size": 48,
            "colorToken": "cg-conduit-lit",
            "icons": [
                "door-exit=exit-danger",
                "bin-2=remove-danger"
            ]
        },
        {
            "urlTemplate": "https://api.iconify.design/streamline-cyber/{name}.svg",
            "format": "Png",
            "outDir": "src/Images/Cyber",
            "size": 48,
            "colorToken": "cg-brass-lit",
            "icons": [
                "badge-star-2=star-gold"
            ]
        }
    ]
}
