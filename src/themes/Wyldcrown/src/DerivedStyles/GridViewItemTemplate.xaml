<!--
    Wyldcrown: Grid view game tile content template.
    Clean cover frame with 1px inner bevel rule + subtle top-and-bottom filigree accent.
    Hover opens obsidian veil + staggered BackEase-rising controls. Play is a 56px Royal Sapphire diamond gem (the quilt
    diamond of the tapestry menus) in a gold bezel: hover swells it 1.1 with an overshoot, lights its core and blooms a
    gold glow. Info is a 48px obsidian iron medallion ringed with gold studs that turn slowly while hovered.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="GridTilePlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Polygon x:Name="Glow" Points="50,0 100,50 50,100 0,50" Stretch="Fill" Margin="-7" Opacity="0" IsHitTestVisible="False"
                                 Fill="{DynamicResource PrimaryButtonGlowBrush}" />
                        <Polygon x:Name="Gem" Points="50,0 100,50 50,100 0,50" Stretch="Fill" Margin="1"
                                 Fill="{DynamicResource PrimaryButtonBackgroundBrush}" Stroke="{DynamicResource PrimaryButtonBorderBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                        <Polygon Points="50,0 100,50 50,100 0,50" Stretch="Fill" Margin="1" IsHitTestVisible="False" Opacity="0.28">
                            <Polygon.Fill>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/sapphire-quilt.png'}" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute" />
                            </Polygon.Fill>
                        </Polygon>
                        <Polygon x:Name="Core" Points="50,0 100,50 50,100 0,50" Stretch="Fill" Margin="11" Opacity="0" IsHitTestVisible="False" Fill="{DynamicResource PrimaryButtonGlowBrush}" />
                        <Polygon Points="50,0 100,50 50,100 0,50" Stretch="Fill" Margin="6" IsHitTestVisible="False" Stroke="{DynamicResource BevelLightBrush}" StrokeThickness="1" Opacity="0.5" />
                        <ContentControl x:Name="Glyph" Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gem" Property="Fill" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="Gem" Property="Stroke" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.25"/><DoubleAnimation Storyboard.TargetName="Core" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.25"/><DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" FillBehavior="Stop"/><DoubleAnimation Storyboard.TargetName="Core" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" FillBehavior="Stop"/><DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25" FillBehavior="Stop"/><DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25" FillBehavior="Stop"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Gem" Property="Fill" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridTileButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Ellipse x:Name="OuterRing" Fill="{DynamicResource ButtonBackgroundBrush}"
                                 Stroke="{DynamicResource ButtonBorderBrush}" StrokeThickness="1.5" />
                        <Ellipse x:Name="Studs" Margin="4" IsHitTestVisible="False" Opacity="0.55" RenderTransformOrigin="0.5,0.5"
                                 Stroke="{DynamicResource GlyphBrush}" StrokeThickness="2.2" StrokeDashArray="0.01 3.4" StrokeDashCap="Round">
                            <Ellipse.RenderTransform><RotateTransform x:Name="StudSpin" Angle="0" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Margin="9" IsHitTestVisible="False" Stroke="{DynamicResource BevelLightBrush}" StrokeThickness="1" Opacity="0.3" />
                        <ContentControl Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterRing" Property="Fill" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Setter TargetName="OuterRing" Property="Stroke" Value="{DynamicResource GlyphBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Studs" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/></Storyboard></BeginStoryboard>
                                <BeginStoryboard Name="StudLoop"><Storyboard><DoubleAnimation Storyboard.TargetName="StudSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Studs" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.25" FillBehavior="Stop"/></Storyboard></BeginStoryboard>
                                <StopStoryboard BeginStoryboardName="StudLoop" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterRing" Property="Fill" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="{DynamicResource GridItemBackgroundBrush}"
                            Background="{DynamicResource ContentBackgroundBrush}">
                        <StackPanel Name="PART_PanelHost"
                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                            <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}" ClipToBounds="True">
                                <Image Name="PART_ImageCover"
                                       RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="{Settings CoverArtStretch}" />

                                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="1" Opacity="0.22" />

                                <Grid x:Name="TextGameName" Visibility="Collapsed">
                                    <Border Background="{DynamicResource ScrimBrush}" Opacity="0.82" />
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextWrapping="Wrap" Margin="10,8"
                                               FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <Border x:Name="BorderMouseOver" Background="{DynamicResource ScrimBrush}" Opacity="0.62" Visibility="Collapsed" />

                                <Viewbox MaxWidth="136" MaxHeight="62" VerticalAlignment="Center" HorizontalAlignment="Center"
                                         Name="GameControls" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Margin="10,6">
                                        <Button Name="PART_ButtonPlay" Style="{StaticResource GridTilePlayButton}"
                                                Margin="0,0,10,0" VerticalAlignment="Center"
                                                Content="{DynamicResource IconPlay}" Opacity="0">
                                            <Button.RenderTransform>
                                                <TranslateTransform x:Name="PlayMove" Y="10" />
                                            </Button.RenderTransform>
                                        </Button>
                                        <Button Name="PART_ButtonInfo" Style="{StaticResource GridTileButton}"
                                                VerticalAlignment="Center"
                                                Content="{DynamicResource IconInfo}" Opacity="0">
                                            <Button.RenderTransform>
                                                <TranslateTransform x:Name="InfoMove" Y="10" />
                                            </Button.RenderTransform>
                                        </Button>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Padding="4,6,4,6"
                                       Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="{DynamicResource IconDownload}" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderMouseOver" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderMouseOver" />
                            <Setter Property="Visibility" Value="Visible" TargetName="GameControls" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="MedallionsIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="PlayMove" Storyboard.TargetProperty="Y"
                                                         From="10" To="0" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity"
                                                         BeginTime="0:0:0.06" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="InfoMove" Storyboard.TargetProperty="Y"
                                                         BeginTime="0:0:0.06" From="10" To="0" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="MedallionsIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
