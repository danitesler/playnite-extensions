<!--
    Wyldcrown: Hexagonal Royal Sapphire Play / Primary CTA & Wyld Emerald Running indicator.
    - RunningActionIndicator: inset Wyld Emerald frame, bottom track, emerald fill bar & right-docked Wyld Star (right 40px strip).
    - PlayButton: ChamferTemplate hexagonal medallion with sapphire-quilt damask, bright gold bezel, soft crown Bloom beneath,
      left/right specular diamond shimmer streaks on hover, plus Wyld Emerald Running state w/ Self-hover Cancel state.
      PlayRoom and CancelLabel keep 0,0,40,0 right clearance whenever IsLaunching or IsRunning is True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.88" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Margin="2" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" Margin="2" CornerRadius="{DynamicResource ControlCornerRadius}"
                                BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5" />
                        <Grid Height="3" Margin="14,0,46,6" VerticalAlignment="Bottom">
                            <Rectangle Height="2" VerticalAlignment="Center" RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.34" />
                            <Rectangle x:Name="RunningFill" Height="3" VerticalAlignment="Center" RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource PositiveRatingBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <!-- Dedicated right 38px Wyld Star emblem & upward drifter motes -->
                        <Grid Width="34" Height="28" Margin="0,0,8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Rectangle Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Fill="{DynamicResource PrimaryButtonForegroundBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/wyld-star.png'}" Stretch="Uniform" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Path x:Name="RunningMote1" Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                  Fill="{DynamicResource PrimaryButtonForegroundBrush}" Stretch="Fill" Opacity="0"
                                  Data="M2.5,0 L5,2.5 L2.5,5 L0,2.5 Z">
                                <Path.RenderTransform><TranslateTransform x:Name="RunningMote1Move" Y="0" /></Path.RenderTransform>
                            </Path>
                            <Path x:Name="RunningMote2" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,2"
                                  Fill="{DynamicResource PrimaryButtonForegroundBrush}" Stretch="Fill" Opacity="0"
                                  Data="M3,0 L6,3 L3,6 L0,3 Z">
                                <Path.RenderTransform><TranslateTransform x:Name="RunningMote2Move" Y="0" /></Path.RenderTransform>
                            </Path>
                            <Path x:Name="RunningMote3" Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,2"
                                  Fill="{DynamicResource PrimaryButtonForegroundBrush}" Stretch="Fill" Opacity="0"
                                  Data="M2,0 L4,2 L2,4 L0,2 Z">
                                <Path.RenderTransform><TranslateTransform x:Name="RunningMote3Move" Y="0" /></Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.28" Value="0.95" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1Move" Storyboard.TargetProperty="Y" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="-11" KeySpline="0.2,0.5 0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="-11" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.43" Value="0.95" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.95" Value="0" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2Move" Storyboard.TargetProperty="Y" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.95" Value="-11" KeySpline="0.2,0.5 0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="-11" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.58" Value="0.95" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" KeySpline="0.3,0 0.7,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3Move" Storyboard.TargetProperty="Y" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="-10" KeySpline="0.2,0.5 0.4,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.74" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.74" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1Move" Storyboard.TargetProperty="Y" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-11" KeySpline="0.3,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="-11" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.5" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2Move" Storyboard.TargetProperty="Y" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.5" Value="-11" KeySpline="0.3,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="-11" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3Move" Storyboard.TargetProperty="Y" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="-11" KeySpline="0.3,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="-11" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="24,6" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="MinWidth" Value="164" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Grid" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Sun crown aureole behind hexagonal Play plate -->
                        <ContentControl x:Name="Bloom" IsTabStop="False" Focusable="False" IsHitTestVisible="False"
                                        Template="{DynamicResource GlowFrameTemplate}" Margin="-26"
                                        Foreground="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0.16" />

                        <ContentControl x:Name="Plate" IsTabStop="False" Focusable="False"
                                        Template="{DynamicResource ChamferTemplate}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" />

                        <!-- Diamond-quilted tapestry sheen inside chamfered plate -->
                        <Border x:Name="Quilt" Margin="10,3" IsHitTestVisible="False" Opacity="0.28">
                            <Border.Background>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/sapphire-quilt.png'}" TileMode="Tile"
                                            Viewport="0,0,28,28" ViewportUnits="Absolute" />
                            </Border.Background>
                        </Border>

                        <!-- Running/Launching ScrimBrush darkens Wyld Emerald so ivory label maintains > 5.0:1 contrast on every frame -->
                        <ContentControl x:Name="RunningBreath" IsTabStop="False" Focusable="False" IsHitTestVisible="False"
                                        Template="{DynamicResource ChamferTemplate}"
                                        Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent" Opacity="0" />

                        <ContentControl x:Name="RunningScan" IsTabStop="False" Focusable="False" IsHitTestVisible="False"
                                        Template="{DynamicResource ChamferTemplate}"
                                        Background="{DynamicResource PositiveRatingBrush}" BorderBrush="Transparent"
                                        Opacity="0.24" Visibility="Collapsed">
                            <ContentControl.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="RunningScanA" Color="#00000000" Offset="-0.5" />
                                    <GradientStop x:Name="RunningScanB" Color="#8C000000" Offset="-0.40" />
                                    <GradientStop x:Name="RunningScanC" Color="#F2000000" Offset="-0.15" />
                                    <GradientStop x:Name="RunningScanD" Color="#F2000000" Offset="-0.002" />
                                    <GradientStop x:Name="RunningScanE" Color="#00000000" Offset="0" />
                                </LinearGradientBrush>
                            </ContentControl.OpacityMask>
                        </ContentControl>

                        <ContentControl x:Name="HoverPlate" IsTabStop="False" Focusable="False" IsHitTestVisible="False"
                                        Template="{DynamicResource ChamferTemplate}"
                                        Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                        BorderBrush="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0" />

                        <ContentControl x:Name="PressedPlate" IsTabStop="False" Focusable="False" IsHitTestVisible="False"
                                        Template="{DynamicResource ChamferTemplate}"
                                        Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                        BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" Opacity="0" />

                        <!-- RunningCancel scrim faded in only while RUNNING button is hovered -->
                        <ContentControl x:Name="RunningHoverDim" IsTabStop="False" Focusable="False" IsHitTestVisible="False"
                                        Template="{DynamicResource ChamferTemplate}"
                                        Background="{DynamicResource ScrimBrush}" BorderBrush="{DynamicResource RunningIndicatorBrush}" Opacity="0" />

                        <!-- Left and right diamond tip accents glowing brighter on hover -->
                        <Path x:Name="LeftTip" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                              IsHitTestVisible="False" Fill="{DynamicResource PrimaryButtonBorderBrush}" Stretch="Fill"
                              Data="M3,0 L6,3 L3,6 L0,3 Z" Opacity="0.85" />
                        <Path x:Name="RightTip" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                              IsHitTestVisible="False" Fill="{DynamicResource PrimaryButtonBorderBrush}" Stretch="Fill"
                              Data="M3,0 L6,3 L3,6 L0,3 Z" Opacity="0.85" />

                        <Grid x:Name="Content" Margin="{TemplateBinding Padding}">
                            <Border x:Name="PlayRoom">
                                <ContentPresenter x:Name="PlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                        </Grid>

                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource TextBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Grid" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Bloom" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Quilt" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RightTip" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.46" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="4,0,40,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="4,0,40,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.46" To="0.54" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanA" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanB" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.40" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.10" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.10" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanC" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.35" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanD" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.498" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.498" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanE" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.5" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Bloom" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Quilt" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RightTip" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.46" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="4,0,40,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="4,0,40,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.56" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.46" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.56" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RunningHoverDim" Property="Opacity" Value="0.88" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" From="0.72" To="0.92" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.82" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.32" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Content" Property="Margin" Value="24,7,24,5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
