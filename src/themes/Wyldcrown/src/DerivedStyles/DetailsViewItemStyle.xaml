<!--
    Wyldcrown: Details view library list rows.
    Selected: indigo tapestry swath, bright gold 3px edge + gold diamond marker.
    Hover: twilight slate wash.
    Launching / Running: Wyld Emerald frame, fill track, spirit comet sweep & right-docked Wyld Star in RowRoom (34px reserved right pad).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Padding" Value="15,4,10,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid>
                        <Border x:Name="HoverPlate" IsHitTestVisible="False" Visibility="Collapsed"
                                Background="{DynamicResource ListItemHoverBrush}"
                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="0,1" />
                        <Grid x:Name="SelectedPlate" IsHitTestVisible="False" Visibility="Collapsed">
                            <Border Background="{DynamicResource ListItemSelectedBrush}"
                                    BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="3,0,0,0" />
                            <Border BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="0,1" Opacity="0.35" />
                            <Path Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                                  Fill="{DynamicResource HighlightGlyphBrush}" Stretch="Fill"
                                  Data="M2.5,0 L5,2.5 L2.5,5 L0,2.5 Z" />
                        </Grid>

                        <Border x:Name="RowRoom" Padding="0">
                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </Border>

                        <!-- Running / Launching overlay (right 34px owned by Wyld Star & motes when active). -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.94">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.14" />
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="3,1,1,1"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" />
                            <Rectangle x:Name="RunningScan" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.34" Visibility="Collapsed">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanA" Color="#00000000" Offset="-0.36" />
                                        <GradientStop x:Name="RunningScanB" Color="#99000000" Offset="-0.20" />
                                        <GradientStop x:Name="RunningScanC" Color="#FF000000" Offset="-0.08" />
                                        <GradientStop x:Name="RunningScanD" Color="#00000000" Offset="0" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Border Height="2" VerticalAlignment="Bottom">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.28" />
                            </Border>
                            <Border Height="2" VerticalAlignment="Bottom">
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>
                            <Grid Width="28" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                                <Rectangle x:Name="RunningStar" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Fill="{DynamicResource RunningIndicatorBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/wyld-star.png'}" Stretch="Uniform" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Path x:Name="RunningMote1" Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,-4,0,0"
                                      Fill="{DynamicResource RunningIndicatorBrush}" Stretch="Fill" Opacity="0.35"
                                      Data="M2,0 L4,2 L2,4 L0,2 Z" />
                                <Path x:Name="RunningMote2" Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,4,0,0"
                                      Fill="{DynamicResource RunningIndicatorBrush}" Stretch="Fill" Opacity="0.4"
                                      Data="M2.5,0 L5,2.5 L2.5,5 L0,2.5 Z" />
                                <Path x:Name="RunningMote3" Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,-3,0,0"
                                      Fill="{DynamicResource RunningIndicatorBrush}" Stretch="Fill" Opacity="0.35"
                                      Data="M2,0 L4,2 L2,4 L0,2 Z" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="HoverPlate" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,34,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanA" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.36" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.5,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanB" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.20" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.16" KeySpline="0.5,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.16" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanC" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.08" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.28" KeySpline="0.5,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.28" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanD" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.36" KeySpline="0.5,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.36" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.5,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,34,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.3" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
