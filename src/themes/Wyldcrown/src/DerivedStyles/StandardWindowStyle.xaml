<!--
    Wyldcrown: Dialog windows (Settings, Add-ons, Game Edit, ThemeModifier).
    44px obsidian-damask title band (CaptionHeight 44 = ContentPresenter top margin 44) featuring:
      - Wyld Crown mark ghosted softly on the right side
      - Heraldic gold diamond ornaments framing PART_TextTitle in bold Cinzel display serif (kept directly visible, never inside a collapsed parent)
      - Gold filigree corner brackets inside the outer dialog rim
      - Diamond-seam gold closing rule across the bottom of the band
      - WindowSettings automation trigger assigns LOCSettingsLabel to PART_TextTitle
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource FrameBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Title Band (44px) -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}" ClipToBounds="True">
                                    <Control Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource FrameBrush}"
                                             Opacity="0.045" IsHitTestVisible="False" Focusable="False" />
                                    <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource HeadingMarkerBrush}"
                                             Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center"
                                             Margin="0,0,144,0" Opacity="0.14" IsHitTestVisible="False" Focusable="False" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,150,0" IsHitTestVisible="False">
                                        <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource HighlightGlyphBrush}"
                                                 Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Focusable="False" />
                                        <Path Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Fill"
                                              Stroke="{DynamicResource FrameBrush}" StrokeThickness="1.25" Data="M4.5,0 L9,4.5 L4.5,9 L0,4.5 Z" />
                                        <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLarger}"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                   Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                        <Path Width="9" Height="9" Margin="10,0,0,0" VerticalAlignment="Center" Stretch="Fill"
                                              Stroke="{DynamicResource FrameBrush}" StrokeThickness="1.25" Data="M4.5,0 L9,4.5 L4.5,9 L0,4.5 Z" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </Grid>

                                <!-- Atmospheric tapestry vignette & damask weave behind dialog body -->
                                <Control Template="{DynamicResource LocalTapestryBackdropTemplate}" Margin="0,44,0,0" Opacity="0.82"
                                         IsHitTestVisible="False" Focusable="False" />

                                <!-- Main Window Content (44px top offset matching CaptionHeight) -->
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- Gold filigree corner accents + diamond-seam closing rule -->
                                <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FrameBrush}"
                                         Margin="3" Opacity="0.7" Focusable="False" IsHitTestVisible="False" />
                                <Control Template="{DynamicResource GlowLineTemplate}" Foreground="{DynamicResource TopPanelRuleStartBrush}"
                                         Height="11" VerticalAlignment="Top" Margin="6,39,6,0"
                                         Focusable="False" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
