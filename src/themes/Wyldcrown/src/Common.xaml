<!--
    Wyldcrown Common: spacing, form rules, focus visual, and Armello-inspired ornament templates.
    Sprites in Images/fx/ are procedural white masks colored via DynamicResource theme brushes, so ThemeModifier
    recolors every filigree border, diamond quilt, torn parchment edge, damask weave, bloom, and Wyld star.
    Rules observed: ControlHeight = 32, compact templates for Statistics GroupBoxes (zero fixed width >= 200),
    EmptyGameTemplate loop animates Opacity on named internal elements only (never RenderTransform on Style trigger).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="BaseStyle" TargetType="Control">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Layered obsidian popup border with 1px antique gold trim -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Spacing & Form Rhythm (ControlHeight = 32; vertical padding = 5) -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">5</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">5</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">12,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">12,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">0</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">14</sys:Double>
    <Thickness x:Key="TooltipPadding">12,8</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Wyldcrown vector brand mark (5-spire Sun Crown + nested diamond jewel) -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource IconMainMenu}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Heading style for sections (Cinzel engraved display font) -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Ornate 4-corner heraldic gold brackets (Images/fx/filigree-corner.png, 40x40 DIP) -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Rectangle Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/filigree-corner.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="1" /></Rectangle.RenderTransform>
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/filigree-corner.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="1" ScaleY="-1" /></Rectangle.RenderTransform>
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/filigree-corner.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Rectangle.RenderTransform>
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/filigree-corner.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="1.25" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource CornerRadiusSmall}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBoxFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="1.25" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource CornerRadiusSmall}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 9-slice aurora halo (Images/fx/glow-frame.png, 128 DIP square, slice 44+40+44 drawn at 22px pad) -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,44,40,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,84,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- 9-slice deckled manuscript parchment (Images/fx/plate-torn.png, 72 DIP, corners 20, tile 32).
         Solid core interior fills behind cells so 9-slice seams never show at 125%/150% DPI scaling. -->
    <ControlTemplate x:Key="TornPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="5" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="0,0,20,20" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="20,0,32,20" ViewboxUnits="Absolute" Viewport="0,0,32,20" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="52,0,20,20" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="0,20,20,32" ViewboxUnits="Absolute" Viewport="0,0,20,32" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="52,20,20,32" ViewboxUnits="Absolute" Viewport="0,0,20,32" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="0,52,20,20" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="20,52,32,20" ViewboxUnits="Absolute" Viewport="0,0,32,20" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="52,52,20,20" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- 6-sided pointed royal hexagonal bevel plaque (Play & Primary CTA). Background = fill, BorderBrush = gold rim.
         Zero-size Canvas prevents Path Stretch="Fill" from inflating Auto-sized containers to availableSize during Measure. -->
    <ControlTemplate x:Key="ChamferTemplate" TargetType="Control">
        <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                  Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}"
                  SnapsToDevicePixels="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="9" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 9,0 L 0,20 L 9,40 Z" />
                <Border Grid.Column="1" Background="{TemplateBinding Background}" />
                <Path Grid.Column="2" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 0,0 L 9,20 L 0,40 Z" />
                <Path Grid.Column="0" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" Data="M 9,0.75 L 0.75,20 L 9,39.25" />
                <Border Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1.5" />
                <Path Grid.Column="2" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" Data="M 0,0.75 L 8.25,20 L 0,39.25" />
            </Grid>
        </Canvas>
    </ControlTemplate>

    <!-- 8-sided chamfered obsidian damask plate (Secondary buttons, regular buttons). Background = fill, BorderBrush = rim. -->
    <ControlTemplate x:Key="FramedPlateTemplate" TargetType="Control">
        <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                  Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}"
                  SnapsToDevicePixels="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 6,0 L 0,6 L 0,34 L 6,40 Z" />
                <Border Grid.Column="1" Background="{TemplateBinding Background}" />
                <Path Grid.Column="2" Stretch="Fill" Fill="{TemplateBinding Background}" Data="M 0,0 L 6,6 L 6,34 L 0,40 Z" />
                <Path Grid.Column="0" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.25" Data="M 6,0.65 L 0.65,6 L 0.65,34 L 6,39.35" />
                <Border Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1.25" />
                <Path Grid.Column="2" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.25" Data="M 0,0.65 L 5.35,6 L 5.35,34 L 0,39.35" />
            </Grid>
        </Canvas>
    </ControlTemplate>

    <!-- Horizontal diamond-tapered selection swath with top & bottom burnished gold hairlines -->
    <ControlTemplate x:Key="SelectionBarTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Foreground}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#CC000000" Offset="0.65" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#99000000" Offset="0.72" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#99000000" Offset="0.72" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Diamond seam light rule (Images/fx/diamond-seam.png, 512x12 DIP) -->
    <ControlTemplate x:Key="GlowLineTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" Height="12">
            <Rectangle Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/diamond-seam.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Heraldic diamond-ended dividing rule (compact for GroupBoxes) -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="10" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Width="8" Height="8" Stretch="Fill" Data="M4,0 L8,4 L4,8 L0,4 Z" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Margin="4,0" Fill="{TemplateBinding BorderBrush}" />
            <Path Grid.Column="2" Width="8" Height="8" Stretch="Fill" Data="M4,0 L8,4 L4,8 L0,4 Z" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" />
        </Grid>
    </ControlTemplate>

    <!-- Pointed heraldic ribbon pennant bookmark (Metadata Tome header, sidebar tag). Background = fill, BorderBrush = gold rim. -->
    <ControlTemplate x:Key="BookmarkTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Stretch="Fill" Fill="{TemplateBinding Background}" Data="M0,0 L20,0 20,20 10,27 0,20 Z" />
            <Path Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.25" Data="M0.6,0 L0.6,19.7 10,26.2 19.4,19.7 19.4,0" />
        </Grid>
    </ControlTemplate>

    <!-- Seamless fleur-de-lis & diamond damask texture (Images/fx/damask-tile.png, 128x128 DIP). Host sets Opacity. -->
    <ControlTemplate x:Key="GrainTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/damask-tile.png'}" TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Atmospheric twilight tapestry vignette + subtle damask weave for sparse page backgrounds (Details, Grid, Dialogs). -->
    <ControlTemplate x:Key="LocalTapestryBackdropTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Rectangle Fill="{DynamicResource HeaderBandBrush}" Opacity="0.34">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/tapestry-vignette.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Fill="{DynamicResource FrameBrush}" Opacity="0.06">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/damask-tile.png'}" TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Calm library backdrop for Details list & Grid cover well: soft twilight corner vignette + subtle damask weave. -->
    <ControlTemplate x:Key="LocalLibraryBackdropTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Rectangle Fill="{DynamicResource HeaderBandBrush}" Opacity="0.26">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/tapestry-vignette.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Fill="{DynamicResource FrameBrush}" Opacity="0.032">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/damask-tile.png'}" TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Aged vellum/parchment fiber grain + watermark diamond lattice (Images/fx/parchment-grain.png, 128x128 DIP). -->
    <ControlTemplate x:Key="LocalParchmentTextureTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" Opacity="0.22">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/parchment-grain.png'}" TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Faceted metallic bevel sheen & center glint for heraldic buttons and active plates (Images/fx/button-bevel-sheen.png). -->
    <ControlTemplate x:Key="LocalButtonSheenTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/button-bevel-sheen.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Heraldic crowned-diamond section divider (Images/fx/crest-divider.png, 512x20 DIP). -->
    <ControlTemplate x:Key="LocalCrestDividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" Height="20">
            <Rectangle Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/crest-divider.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Soft elliptical solar bloom (Images/fx/bloom.png, 256x128 DIP) -->
    <ControlTemplate x:Key="BloomTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Steam Screenshots loading skeleton (pulsing 16:9 card + 5 thumbnails) -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel x:Name="Root" IsHitTestVisible="False" Opacity="0.45">
            <Border Background="{TemplateBinding Foreground}" Opacity="0.28" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{TemplateBinding Foreground}" Opacity="0.28" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Grid.Column="2" Background="{TemplateBinding Foreground}" Opacity="0.28" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="4" Background="{TemplateBinding Foreground}" Opacity="0.28" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="6" Background="{TemplateBinding Foreground}" Opacity="0.28" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="8" Background="{TemplateBinding Foreground}" Opacity="0.28" CornerRadius="{DynamicResource ControlCornerRadius}" />
            </Grid>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Breathe">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0.45" To="0.92" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Breathe" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- EmptyGameTemplate: Wyld Sun Crown medallion over pulsing golden halo + diamond-seam rule + LOCErrorNoGameSelected. -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Grid Width="240" Height="138" HorizontalAlignment="Center" ClipToBounds="True">
                <Control x:Name="CrownAura" Width="210" Height="116" Template="{DynamicResource BloomTemplate}"
                         Foreground="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0.32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Width="108" Height="108" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{DynamicResource FrameBrush}" StrokeThickness="1" StrokeDashArray="6 4" Opacity="0.42" />
                <Ellipse Width="86" Height="86" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1" Opacity="0.55" />
                <Control x:Name="CrownCrest" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource HeadingForegroundBrush}" Opacity="0.86" Focusable="False" />
            </Grid>
            <Control Width="280" Template="{DynamicResource LocalCrestDividerTemplate}" Foreground="{DynamicResource FrameBrush}" Margin="0,2,0,10" Opacity="0.9" />
            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center"
                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                       FontWeight="Bold" Foreground="{DynamicResource HeadingForegroundBrush}" Opacity="0.9" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyCrownLoop">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrownAura" Storyboard.TargetProperty="Opacity" Duration="0:0:3.4">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.22" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.52" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.22" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrownCrest" Storyboard.TargetProperty="Opacity" Duration="0:0:3.4">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyCrownLoop" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Main menu mark (Sidebar seal and TopPanel PART_ElemMainMenu): a three-point crown with orbs on its tips, a band and a spirit-cyan gem,
         in the host Foreground (bright gold), 20x18. The Control is not hit-testable: the nearest Border (the button) carries
         hover and the open state. Hover (IsMouseOver of that Border): the crown lifts 1.2px (BackEase, 0.2s) and the gem throws
         one four-point flare (a gold-glow star that swells 0.2 to 1.1 while it turns a quarter and fades, 0.5s); the lift
         reverses on exit. Open (the menu ContextMenu.IsOpen on the same Border, which is PART_ElemMainMenu): the court assembles: the
         three tip orbs light wyld green one after another (a 1.8s chase, 0.3s apart), the gem burns gold-glow and breathes, and
         the whole crown swells 6% (BackEase) until the menu closes. The crown lifts in an inner canvas, the swell scales an
         outer one, so hover and open never animate the same element. -->
    <ControlTemplate x:Key="LocalWyldcrownMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="False">
            <Canvas Width="20" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="20" Height="18" RenderTransformOrigin="0.5,0.9">
                    <Canvas.RenderTransform><ScaleTransform x:Name="Swell" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                    <Canvas Width="20" Height="18">
                        <Canvas.RenderTransform><TranslateTransform x:Name="Lift" Y="0" /></Canvas.RenderTransform>
                        <Path Data="M2.5,13 L2,5.5 L6,9 L10,3 L14,9 L18,5.5 L17.5,13 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Miter" />
                        <Path Data="M3,15.8 H17" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" />
                        <Ellipse Canvas.Left="0.8" Canvas.Top="3.4" Width="2.4" Height="2.4" Fill="{TemplateBinding Foreground}" />
                        <Ellipse Canvas.Left="8.8" Canvas.Top="0.8" Width="2.4" Height="2.4" Fill="{TemplateBinding Foreground}" />
                        <Ellipse Canvas.Left="16.8" Canvas.Top="3.4" Width="2.4" Height="2.4" Fill="{TemplateBinding Foreground}" />
                        <Ellipse x:Name="OrbL" Canvas.Left="0.8" Canvas.Top="3.4" Width="2.4" Height="2.4" Fill="{DynamicResource PositiveRatingBrush}" Opacity="0" />
                        <Ellipse x:Name="OrbM" Canvas.Left="8.8" Canvas.Top="0.8" Width="2.4" Height="2.4" Fill="{DynamicResource PositiveRatingBrush}" Opacity="0" />
                        <Ellipse x:Name="OrbR" Canvas.Left="16.8" Canvas.Top="3.4" Width="2.4" Height="2.4" Fill="{DynamicResource PositiveRatingBrush}" Opacity="0" />
                        <Path Data="M10,9.2 L11.8,11.2 L10,13.2 L8.2,11.2 Z" Fill="{DynamicResource FrameHoverBrush}" />
                        <Path x:Name="GemHot" Data="M10,9.2 L11.8,11.2 L10,13.2 L8.2,11.2 Z" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0" />
                        <Path x:Name="Flare" Data="M10,6.2 L11.1,10.1 L15,11.2 L11.1,12.3 L10,16.2 L8.9,12.3 L5,11.2 L8.9,10.1 Z" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="FlareScale" CenterX="10" CenterY="11.2" ScaleX="0.2" ScaleY="0.2" />
                                    <RotateTransform x:Name="FlareTurn" CenterX="10" CenterY="11.2" Angle="0" />
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Canvas>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-1.2" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flare" Storyboard.TargetProperty="Opacity">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="FlareScale" Storyboard.TargetProperty="ScaleX" From="0.2" To="1.1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="FlareScale" Storyboard.TargetProperty="ScaleY" From="0.2" To="1.1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="FlareTurn" Storyboard.TargetProperty="Angle" From="0" To="45" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Flare" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.01" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FlareScale" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.01" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FlareScale" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.01" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FlareTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.01" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GemHot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="GemHot" Storyboard.TargetProperty="Opacity" From="1" To="0.35" BeginTime="0:0:0.3" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OrbL" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OrbM" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.3" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OrbR" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.6" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GemHot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="OrbL" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="OrbM" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="OrbR" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
