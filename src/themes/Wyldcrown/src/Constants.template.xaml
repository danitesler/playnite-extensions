<!--
    Wyldcrown: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Unofficial fan theme inspired by Armello UI (no game assets, logos, or copyrighted fonts).
    Keys belong strictly to Playnite's vocabulary and scripts/data/theme-keys.json.
    Armello token placeholders live exclusively in tokens.css and template substitutions.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Cinzel display capitals for titles/medallions (bundled), Georgia serif for storybook body & folios. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Georgia}}, Palatino Linotype, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Cinzel, {{text:font-display|Cinzel}}, Georgia, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}, Consolas</FontFamily>

    <!-- Metadata pane defaults (300px usable inner width; Left/Center/Stretch/Right switchable in ThemeModifier). -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape: notched chamfered bevels; CornerRadiusFull strictly reserved for 1:1 medallions. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-sm|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-lg|6}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:radius-xl|8}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Thickness x:Key="FrameThickness">1</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{ar-ivory}}</Color>
    <Color x:Key="TextColorDarker">{{ar-parchment-mute}}</Color>
    <Color x:Key="TextColorDark">{{ar-abyss}}</Color>
    <Color x:Key="MainColor">{{ar-drawer}}</Color>
    <Color x:Key="MainColorDark">{{ar-obsidian}}</Color>
    <Color x:Key="HoverColor">{{ar-indigo-wash}}</Color>
    <Color x:Key="GlyphColor">{{ar-gold}}</Color>
    <Color x:Key="HighlightGlyphColor">{{ar-gold-bright}}</Color>
    <Color x:Key="PopupBackgroundColor">{{ar-drawer}}</Color>
    <Color x:Key="PopupBorderColor">{{ar-gold@ar-drawer}}</Color>
    <Color x:Key="BackgroundToneColor">{{ar-obsidian}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{ar-rule-dim}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{ar-rule-dim}}</Color>
    <Color x:Key="DataChangeNotifColor">{{ar-crimson-bright}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{ar-bronze}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{ar-drawer}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{ar-drawer}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{ar-drawer}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{ar-wyld-lit}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{ar-crimson-bright}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{ar-amber}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{ar-amber}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{ar-obsidian}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{ar-velvet}}" />

    <!-- Surfaces & Banner darkening (GameBannerTintBrush = deep twilight indigo tapestry cast) -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{ar-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{ar-obsidian}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{ar-velvet}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{ar-obsidian}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{ar-abyss}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{ar-indigo-deep}}" />
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{ar-indigo-deep}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{ar-sapphire-deep}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{ar-gold-bright}}" />

    <!-- States & Selection -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{ar-indigo-select}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{ar-gold}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{ar-ivory}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{ar-wyld}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{ar-indigo-wash}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{ar-indigo-select}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{ar-indigo-wash}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{ar-gold-glow}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{ar-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{ar-cream-bright}}" />

    <!-- Buttons: Obsidian damask secondary vs Royal Sapphire diamond-quilted Play / Primary -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{ar-ivory}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{ar-bronze}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{ar-indigo-wash}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{ar-indigo-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{ar-sapphire}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{ar-sapphire-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{ar-sapphire-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{ar-cream-bright}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{ar-gold-glow}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{ar-indigo-select}}" />

    <!-- Inputs & Frames -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{ar-void}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{ar-bronze}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{ar-gold}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{ar-bronze}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{ar-gold}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{ar-bronze}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{ar-spirit-cyan}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{ar-rule-dim}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{ar-abyss}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{ar-abyss}}" />

    <!-- Tracks & Thumbs -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{ar-void}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{ar-sapphire}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{ar-void}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{ar-wyld}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{ar-gold}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{ar-gold}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{ar-gold-bright}}" />

    <!-- Tabs, Covers, Top Panel & Sidebar -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{ar-parchment-mute}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{ar-ivory}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{ar-gold}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{ar-void}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{ar-spirit-cyan}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{ar-indigo-wash}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{ar-indigo-select}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{ar-bronze}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{ar-parchment-mute}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{ar-gold-glow}}" />

    <!-- Paper (Illuminated Metadata Tome & Heraldic Bookmarks) -->
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{ar-parchment}}" />
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{ar-parchment-edge}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{ar-ink}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{ar-ink}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{ar-ink-muted}}" />
    <SolidColorBrush x:Key="ParchmentLinkBrush" Color="{{ar-ink-link}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{ar-spirit-cyan}}" />

    <!-- Headings, Metadata Chips, Menus, Tooltips & Dialogs -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{ar-gold}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{ar-gold}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{ar-drawer}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{ar-gold-bright}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{ar-chip-bg}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{ar-ivory}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{ar-indigo-select}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{ar-rule-dim}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{ar-ivory}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{ar-gold}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{ar-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{ar-ivory}}" />
</ResourceDictionary>
