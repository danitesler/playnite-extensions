<!--
    Wyldcrown: ContextMenu and the shared Armello obsidian-damask panel (LocalMenuPanelTemplate).
    Levers: 30px rows; obsidian drawer (PopupBackgroundBrush) with fleur-de-lis damask (GrainTemplate),
    1px antique bronze outer rim, inset burnished gold inner keyline, 4-corner heraldic gold filigree
    brackets (CornerMarksTemplate) and centered top gold crown pip; SelectionBarTemplate twilight-indigo
    ribbon with bright gold top/bottom hairlines, 2px gold lance and 6px gold diamond cursor sliding in
    6px (130ms); heraldic diamond-ended bronze dividing rule (DividerTemplate, 10px); Cinzel shortcut
    plaques illuminating from obsidian-bronze into cream parchment with sepia ink on highlight; crimson
    wax-seal Exit row with cream-bright ink (6.32:1); royal sapphire & gold diamond check mark.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    BorderThickness="{DynamicResource PopupBorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Control Template="{DynamicResource GrainTemplate}"
                     Foreground="{DynamicResource NormalBorderBrush}"
                     Opacity="0.16" Margin="1" Focusable="False" IsHitTestVisible="False" />
            <Border BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                    Margin="3" Opacity="0.55" CornerRadius="{DynamicResource CornerRadiusSmall}" />
            <Control Template="{DynamicResource CornerMarksTemplate}"
                     Foreground="{DynamicResource GlyphBrush}"
                     Margin="2" Focusable="False" IsHitTestVisible="False" />
            <!-- Centered top gold crown diamond pip -->
            <Path Data="M4,0 L8,3.5 L4,7 L0,3.5 Z" Fill="{DynamicResource HeadingMarkerBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0.5,0,0" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="8,10,8,10">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
