<!--
    Wyldcrown: ComboBox. 32px sunken obsidian/bronze well with 36px reserved right margin so selected values never
    overlap the dedicated 28px gold dropdown chevron cell; swaps seamlessly to FilterGroupIndicator inside FilterPanel.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Border" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <DockPanel LastChildFill="False" Background="Transparent">
                                        <ToggleButton x:Name="FilterGroupIndicator" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                      Margin="0,0,-5,0" Background="Transparent" BorderThickness="0" Padding="0" Width="30" Height="28" VerticalAlignment="Center" Visibility="Collapsed"
                                                      IsHitTestVisible="False" Focusable="False" IsChecked="True"
                                                      Style="{DynamicResource ExpanderDownHeaderStyle}" />
                                        <Grid x:Name="FilterOriginalArrow" DockPanel.Dock="Right" Width="28" VerticalAlignment="Stretch" Margin="0,1,1,1">
                                            <Border x:Name="ChevronLane" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="1,0,0,0" Background="Transparent" />
                                            <ContentControl x:Name="ChevronGlyph" Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                            Foreground="{DynamicResource HeadingMarkerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                                        </Grid>
                                    </DockPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ChevronLane" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            <Setter TargetName="ChevronGlyph" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType={x:Type FilterPanel}}, FallbackValue=False}" Value="True">
                                            <Setter TargetName="FilterOriginalArrow" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="FilterGroupIndicator" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border Margin="0,0,36,0" IsHitTestVisible="False">
                            <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        </Border>
                        <TextBox MinHeight="0" x:Name="PART_EditableTextBox" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 Margin="0,0,36,0" Focusable="True" BorderThickness="0" Background="Transparent" Style="{DynamicResource BareTextBox}" Padding="{DynamicResource InputPadding}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" Foreground="{DynamicResource TextBrush}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               Focusable="False" AllowsTransparency="True">
                            <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                  Margin="0,3,0,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Margin="8,10,8,10">
                                    <ItemsPresenter Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Border" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Border" />
                        </MultiTrigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="ContentSite" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="MenuHover" Grid.ColumnSpan="2" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="HoverShift" X="-6" />
                            </Grid.RenderTransform>
                            <Control Template="{DynamicResource SelectionBarTemplate}"
                                     Foreground="{DynamicResource MenuItemHoverBrush}"
                                     BorderBrush="{DynamicResource HeadingMarkerBrush}"
                                     Focusable="False" IsHitTestVisible="False" />
                            <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource HeadingMarkerBrush}" />
                            <Path Data="M0,0 L4,3 L0,6 Z" Fill="{DynamicResource HeadingMarkerBrush}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </Grid>
                        <Grid x:Name="GlyphPanel" Grid.Column="0" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed" IsHitTestVisible="False">
                            <Path Data="M6.5,0.5 L12.5,6.5 L6.5,12.5 L0.5,6.5 Z"
                                  Fill="{DynamicResource PrimaryButtonBackgroundBrush}"
                                  Stroke="{DynamicResource HeadingMarkerBrush}" StrokeThickness="1.1" />
                            <Path Data="M3.6,6.6 L5.7,8.7 L9.4,4.2"
                                  Stroke="{DynamicResource DangerForegroundBrush}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="HoverShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="MenuHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" TargetName="RowRoot" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
