<!--
    Wyldcrown: GroupBox. Content-sized obsidian card (no fixed widths >= 200 so Statistics cards wrap cleanly)
    framed in tarnished bronze with a tapered indigo/gold header band and heraldic diamond ornament.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{DynamicResource ExpanderBackgroundBrush}"
                            BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" MinHeight="28" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                <Border Background="{DynamicResource HeaderBandBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="2,0,0,0">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF000000" Offset="0" />
                                            <GradientStop Color="#88000000" Offset="0.68" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <DockPanel Margin="10,5,14,5" LastChildFill="True">
                                    <Path DockPanel.Dock="Left" Width="7" Height="7" Margin="0,1,8,0" VerticalAlignment="Center"
                                          Stroke="{DynamicResource HeadingMarkerBrush}" StrokeThickness="1.25" Stretch="Fill" Data="M3.5,0 L7,3.5 L3.5,7 L0,3.5 Z" />
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                      TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                      TextElement.FontWeight="Bold"
                                                      TextElement.Foreground="{DynamicResource HeaderBandForegroundBrush}" />
                                </DockPanel>
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
