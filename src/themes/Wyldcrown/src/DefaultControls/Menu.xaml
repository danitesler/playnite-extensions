<!--
    Wyldcrown: Menu, MenuItem and Separator.
    Levers: 30px rows; fixed 26px icon column, plain * label column, shared Auto shortcut column; Armello
    twilight-indigo SelectionBarTemplate ribbon with gold hairlines, 2px bright gold lance and 6px gold
    diamond cursor sliding in 6px (130ms); held SelectionBrush + gold edge on open submenus; diamond-ended
    bronze dividing rule (DividerTemplate, 10px); Cinzel shortcut plaques illuminating into cream parchment
    with sepia ink on highlight; carved gold submenu triangle; crimson wax Exit banner with cream-bright
    ink (6.32:1); royal sapphire & gold diamond check mark. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Heraldic diamond-ended bronze dividing rule (10px). -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource DividerTemplate}"
                             Foreground="{DynamicResource GlyphBrush}"
                             BorderBrush="{DynamicResource NormalBorderBrush}"
                             Margin="8,0,8,0" Focusable="False" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="{TemplateBinding Background}">
            <Grid>
                <TextBlock VerticalAlignment="Center" Padding="{DynamicResource MenuItemPadding}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" Margin="8,10,8,10"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Grid>
                </Popup>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="{TemplateBinding Background}">
            <TextBlock VerticalAlignment="Center" Padding="{DynamicResource MenuItemPadding}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{TemplateBinding Foreground}">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </TextBlock>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
            </Grid.ColumnDefinitions>

            <!-- Held plate when submenu is open (setter only, no animation). -->
            <Grid x:Name="MenuHeld" Grid.ColumnSpan="3" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource SelectedBrush}" Opacity="0.72" />
                <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}" />
            </Grid>

            <!-- Armello twilight-indigo ribbon with bright gold hairlines, lance and diamond cursor. -->
            <Grid x:Name="MenuHover" Grid.ColumnSpan="3" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HoverShift" X="-6" />
                </Grid.RenderTransform>
                <Control Template="{DynamicResource SelectionBarTemplate}"
                         Foreground="{DynamicResource MenuItemHoverBrush}"
                         BorderBrush="{DynamicResource HeadingMarkerBrush}"
                         Focusable="False" IsHitTestVisible="False" />
                <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource HeadingMarkerBrush}" />
                <Path Data="M0,0 L4,3 L0,6 Z" Fill="{DynamicResource HeadingMarkerBrush}"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
            </Grid>

            <ContentPresenter x:Name="Icon" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                              MaxHeight="16" MaxWidth="16" ContentSource="Icon" />
            <Grid x:Name="GlyphPanel" Grid.Column="0" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="Collapsed" IsHitTestVisible="False">
                <Path Data="M6.5,0.5 L12.5,6.5 L6.5,12.5 L0.5,6.5 Z"
                      Fill="{DynamicResource PrimaryButtonBackgroundBrush}"
                      Stroke="{DynamicResource HeadingMarkerBrush}" StrokeThickness="1.1" />
                <Path Data="M3.6,6.6 L5.7,8.7 L9.4,4.2"
                      Stroke="{DynamicResource DangerForegroundBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>

            <TextBlock x:Name="HeaderText" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0"
                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{TemplateBinding Foreground}">
                <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
            </TextBlock>

            <Path x:Name="SubArrow" Grid.Column="2" Data="M0,0 L5,4 L0,8 L1.5,4 Z" Fill="{DynamicResource GlyphBrush}"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,8,0" SnapsToDevicePixels="True" />

            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Right" HorizontalOffset="2" Focusable="False" AllowsTransparency="True">
                <Grid SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Margin="8,10,8,10">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="MenuHeld" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="HeaderText" />
                <Setter Property="Fill" Value="{DynamicResource HeadingMarkerBrush}" TargetName="SubArrow" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                            <DoubleAnimation Storyboard.TargetName="HoverShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="HoverShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="RowRoot" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
            </Grid.ColumnDefinitions>

            <!-- Twilight-indigo highlight ribbon -->
            <Grid x:Name="MenuHover" Grid.ColumnSpan="3" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HoverShift" X="-6" />
                </Grid.RenderTransform>
                <Control Template="{DynamicResource SelectionBarTemplate}"
                         Foreground="{DynamicResource MenuItemHoverBrush}"
                         BorderBrush="{DynamicResource HeadingMarkerBrush}"
                         Focusable="False" IsHitTestVisible="False" />
                <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource HeadingMarkerBrush}" />
                <Path Data="M0,0 L4,3 L0,6 Z" Fill="{DynamicResource HeadingMarkerBrush}"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
            </Grid>

            <!-- Crimson wax-seal danger banner for Exit (Alt+Q) -->
            <Grid x:Name="DangerHover" Grid.ColumnSpan="3" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="DangerShift" X="-6" />
                </Grid.RenderTransform>
                <Border Background="{DynamicResource DangerBrush}" />
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource HeadingMarkerBrush}" Opacity="0.8" />
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource HeadingMarkerBrush}" Opacity="0.8" />
                <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource HeadingMarkerBrush}" />
                <Path Data="M0,0 L4,3 L0,6 Z" Fill="{DynamicResource HeadingMarkerBrush}"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
            </Grid>

            <!-- Rest crimson wax lance on Exit row -->
            <Rectangle x:Name="ExitEdge" Grid.Column="0" Width="2" HorizontalAlignment="Left" Margin="0,5"
                       Fill="{DynamicResource DangerBrush}" Visibility="Collapsed" IsHitTestVisible="False" />

            <ContentPresenter x:Name="Icon" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                              MaxHeight="16" MaxWidth="16" ContentSource="Icon" />
            <Grid x:Name="GlyphPanel" Grid.Column="0" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="Collapsed" IsHitTestVisible="False">
                <Path Data="M6.5,0.5 L12.5,6.5 L6.5,12.5 L0.5,6.5 Z"
                      Fill="{DynamicResource PrimaryButtonBackgroundBrush}"
                      Stroke="{DynamicResource HeadingMarkerBrush}" StrokeThickness="1.1" />
                <Path Data="M3.6,6.6 L5.7,8.7 L9.4,4.2"
                      Stroke="{DynamicResource DangerForegroundBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>

            <TextBlock x:Name="HeaderText" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0"
                       Style="{DynamicResource BaseTextBlockStyle}" Foreground="{TemplateBinding Foreground}">
                <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
            </TextBlock>

            <Border x:Name="GestureBadge" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{DynamicResource PropertyItemBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusSmall}" Padding="5,1,5,1" Margin="4,0,8,0">
                <TextBlock x:Name="GestureText" Text="{TemplateBinding InputGestureText}"
                           FontFamily="{DynamicResource HeadingFontFamily}" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrushDarker}" VerticalAlignment="Center" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GestureBadge" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GestureBadge" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Visibility" Value="Visible" TargetName="ExitEdge" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" TargetName="GestureBadge" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="GestureText" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="HeaderText" />
                <Setter Property="Background" Value="{DynamicResource ParchmentBrush}" TargetName="GestureBadge" />
                <Setter Property="BorderBrush" Value="{DynamicResource HeadingMarkerBrush}" TargetName="GestureBadge" />
                <Setter Property="Foreground" Value="{DynamicResource ParchmentTextBrush}" TargetName="GestureText" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                            <DoubleAnimation Storyboard.TargetName="HoverShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="HoverShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Icon" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="ExitEdge" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="HeaderText" />
                <Setter Property="Background" Value="{DynamicResource ParchmentBrush}" TargetName="GestureBadge" />
                <Setter Property="BorderBrush" Value="{DynamicResource HeadingMarkerBrush}" TargetName="GestureBadge" />
                <Setter Property="Foreground" Value="{DynamicResource ParchmentTextBrush}" TargetName="GestureText" />
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="DangerHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                            <DoubleAnimation Storyboard.TargetName="DangerShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="DangerHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="DangerShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="RowRoot" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
