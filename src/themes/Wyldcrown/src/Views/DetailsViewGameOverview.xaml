<!--
    Wyldcrown: Details view game page.
    Banner: HeroArt (GameBannerHeight 320 default) with GameBannerDarken tint + 50% floor, soft vignette & page fade;
    proportional spacer (x * 168 / 300, 20 floor when collapsed/0).
    Header: crest icon, Cinzel hero title over diamond-seam divider, hexagonal Royal Sapphire PlayButton + RunningActionIndicator +
    42x42 SecondaryButton actions.
    Body: SteamScreenshotsGameScope (bounded w/ 12s skeleton), Description & Notes beneath obsidian/gold bands,
    and deckled-parchment Character Tome metadata card (TornPlateTemplate + top heraldic BookmarkTemplate pennants, GameDetailsPaneWidth 300,
    responsive Left/Center/Stretch/Right placement & multi-column breakpoints via scripts/game-page-breakpoints.mjs).
    Empty state: EmptyGameTemplate centered in ViewportHeight when Game is null (PART_ScrollViewHost stays Visible).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost" Visibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                  mc:Ignorable="d">
                        <Grid x:Name="PageRoot" UseLayoutRounding="True">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- Atmospheric tapestry vignette + obsidian damask weave + heraldic corner filigree (hidden when ShowBackgroundImageOnWindow=True) -->
                            <Control Template="{DynamicResource LocalTapestryBackdropTemplate}" IsHitTestVisible="False" Focusable="False">
                                <Control.Style>
                                    <Style TargetType="Control">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Control.Style>
                            </Control>
                            <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FrameBrush}"
                                     Margin="10" IsHitTestVisible="False" Focusable="False">
                                <Control.Style>
                                    <Style TargetType="Control">
                                        <Setter Property="Opacity" Value="0.28" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Control.Style>
                            </Control>

                            <!-- Hero banner backdrop -->
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Border Background="{DynamicResource ArtTintBrush}" Opacity="0.24" />
                                <Rectangle Height="100" VerticalAlignment="Top" Opacity="0.65">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.2" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>

                            <StackPanel Margin="30,0,30,30">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Border x:Name="DetailsBannerSpacer" MinHeight="20">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 168 / 300'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="20" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
                                                    <Setter Property="Height" Value="20" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Title and Play action row -->
                                <DockPanel Margin="0,10,0,18">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                                        <Grid MinWidth="172" Height="42">
                                            <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                            <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                            <Control Style="{DynamicResource RunningActionIndicator}" />
                                        </Grid>
                                        <Button x:Name="PART_ButtonMoreActions" Width="42" Height="42" Padding="0" Margin="12,0,0,0"
                                                ToolTip="{DynamicResource LOCMoreAction}">
                                            <ContentControl Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                        <Button x:Name="PART_ButtonEditGame" Width="42" Height="42" Padding="0" Margin="8,0,0,0"
                                                ToolTip="{DynamicResource LOCEditGame}">
                                            <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>
                                    <DockPanel>
                                        <Image x:Name="PART_ImageIcon" MaxWidth="44" MaxHeight="44" Margin="0,0,14,0"
                                               DockPanel.Dock="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold"
                                                       Foreground="{DynamicResource HeadingForegroundBrush}" TextWrapping="Wrap" />
                                            <Control Template="{DynamicResource DividerTemplate}"
                                                     Foreground="{DynamicResource HeadingMarkerBrush}" BorderBrush="{DynamicResource HeadingRuleBrush}"
                                                     Focusable="False" Height="10" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                                                <Control.Style>
                                                    <Style TargetType="Control">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Control.Style>
                                            </Control>
                                        </StackPanel>
                                    </DockPanel>
                                </DockPanel>

                                <!-- Responsive body: Main column + Deckled Parchment Character Tome metadata folio -->
                                <Grid Margin="0,16,0,0" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataViewport" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
<Grid Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                        <Control Template="{DynamicResource TornPlateTemplate}"
                                                 Background="{DynamicResource ParchmentBrush}"
                                                 BorderBrush="{DynamicResource ParchmentEdgeBrush}"
                                                 IsTabStop="False" Focusable="False" />
                                        <Control Template="{DynamicResource LocalParchmentTextureTemplate}"
                                                 Margin="6" Foreground="{DynamicResource ParchmentEdgeBrush}"
                                                 IsTabStop="False" Focusable="False" />
                                        <Border Margin="10" BorderBrush="{DynamicResource ParchmentEdgeBrush}" BorderThickness="1"
                                                Opacity="0.45" IsHitTestVisible="False" />
                                        <Control Template="{DynamicResource CornerMarksTemplate}"
                                                 Margin="10" Foreground="{DynamicResource ParchmentEdgeBrush}" Opacity="0.45"
                                                 IsHitTestVisible="False" Focusable="False" />

                                        <!-- Heraldic clan bookmark pennants along top right rim -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,1,20,0" IsHitTestVisible="False">
                                            <Control Template="{DynamicResource BookmarkTemplate}" Width="16" Height="22" Margin="0,0,5,0"
                                                     Foreground="{DynamicResource PrimaryButtonBackgroundBrush}" Focusable="False" />
                                            <Control Template="{DynamicResource BookmarkTemplate}" Width="16" Height="22"
                                                     Foreground="{DynamicResource DangerBrush}" Focusable="False" />
                                        </StackPanel>

                                        <Border Padding="20,22,20,22">
                                            <StackPanel>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="{DynamicResource LOCGameDetails}" Style="{DynamicResource HeadingTextBlock}"
                                                               Foreground="{DynamicResource ParchmentTitleBrush}" />
                                                    <Control Template="{DynamicResource DividerTemplate}" Height="8" Margin="0,5,0,0"
                                                             Foreground="{DynamicResource ParchmentLabelBrush}" BorderBrush="{DynamicResource ParchmentEdgeBrush}"
                                                             Focusable="False" IsTabStop="False" />
                                                </StackPanel>

                                                <Border x:Name="DetailsMetadataViewport" ClipToBounds="True" HorizontalAlignment="Stretch" Tag="{DynamicResource GameDetailsPaneWidth}">
<Border.Style><Style TargetType="Border"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,0,-24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Margin" Value="0,-5,0,-5" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-5,-24,-5" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Margin" Value="0,-5,0,-5" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-5,-24,-5" /></MultiDataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                        <WrapPanel.Resources>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                        </WrapPanel.Resources>

                                                        <Border x:Name="MetaProgress" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ParchmentEdgeBrush}"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,10,0,0" /><Style.Triggers><MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
</Border>
<Border x:Name="PART_ElemCompletionStatus" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,5,0,5" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,5,24,5" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                        <Border Grid.Column="1" Margin="8,0,0,0">
                                                                            <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
<Border x:Name="PART_ElemPlayTime" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,5,0,5" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,5,24,5" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                        <Border Grid.Column="1" Margin="8,0,0,0">
                                                                            <TextBlock x:Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ParchmentTextBrush}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
<Border x:Name="PART_ElemLastPlayed" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,5,0,5" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,5,24,5" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                        <Border Grid.Column="1" Margin="8,0,0,0">
                                                                            <TextBlock x:Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ParchmentTextBrush}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
<Border x:Name="PART_ElemRecentActivity" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,5,0,5" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,5,24,5" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                        <Border Grid.Column="1" Margin="8,0,0,0">
                                                                            <TextBlock x:Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ParchmentTextBrush}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
<Border x:Name="PART_ElemAdded" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,5,0,5" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,5,24,5" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCDateAddedLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                        <Border Grid.Column="1" Margin="8,0,0,0">
                                                                            <TextBlock x:Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ParchmentTextBrush}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
<Border x:Name="MetaScores" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ParchmentEdgeBrush}"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,10,0,0" /><Style.Triggers><MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
</Border>
<Border x:Name="PART_ElemCommunityScore" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,5,0,5" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,5,24,5" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{DynamicResource LOCCommunityScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                        <Border Grid.Column="1" Margin="8,0,0,0">
                                                                            <TextBlock x:Name="PART_TextCommunityScore" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
<Border x:Name="PART_ElemCriticScore" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,5,0,5" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,5,24,5" /></DataTrigger></Style.Triggers></Style></Border.Style>
