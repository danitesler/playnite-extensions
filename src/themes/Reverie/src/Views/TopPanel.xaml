<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:sys="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d">
  <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
    <ContentControl Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
  </DataTemplate>
  <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
    <ContentControl Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
  </DataTemplate>
  <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
    <ContentControl Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
  </DataTemplate>
  <DataTemplate x:Key="TopPanelSortSettingsTemplate">
    <ContentControl Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
  </DataTemplate>
  <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
    <ContentControl Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
  </DataTemplate>
  <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
    <ContentControl Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
  </DataTemplate>
  <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
    <ContentControl Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
  </DataTemplate>
  <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
    <ContentControl Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
  </DataTemplate>
  <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
    <ContentControl Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
  </DataTemplate>
  <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
    <ContentControl Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
  </DataTemplate>
  <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
    <ContentControl Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
  </DataTemplate>
  <DataTemplate x:Key="TopPanelSearchButtonTemplate">
    <ContentControl Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
  </DataTemplate>
  <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Padding="5" CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Grid.IsSharedSizeScope="True">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="2,0,0,0" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid>
              <ContentControl Content="{DynamicResource IconFilter}" ContentTemplate="{DynamicResource IconTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
              <Ellipse x:Name="ActiveMark" Width="8" Height="8" Fill="{DynamicResource DataChangeNotifBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource True}">
              <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="2,0,0,0" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid>
              <ContentControl Content="{DynamicResource IconNotifications}" ContentTemplate="{DynamicResource IconTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
              <Ellipse x:Name="ActiveMark" Width="8" Height="8" Fill="{DynamicResource DataChangeNotifBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{StaticResource True}">
              <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Api Notifications.Count}" Value="0">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type TopPanel}">
    <Setter Property="Background" Value="{DynamicResource TopPanelBackgroundBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TopPanel}">
          <Border Height="52" BorderBrush="{DynamicResource PanelSeparatorBrush}" d:DesignWidth="1280" d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
            <Border.Style>
              <Style TargetType="Border">
                  <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Style.Triggers>
                  <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                    <Setter Property="BorderThickness" Value="0" />
                  </DataTrigger>
                      <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                          <Setter Property="Background" Value="Transparent" />
                      </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel Margin="8,0,120,0">
              <Border x:Name="PART_ElemMainMenu" Background="Transparent" DockPanel.Dock="Left" Margin="5,0,0,0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="15" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5" Background="{DynamicResource ButtonBackgroundBrush}">
                  <ContentControl Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource GlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Border>
              </Border>
              <SearchBox x:Name="PART_TextMainSearch" Margin="0,0,6,0" VerticalAlignment="Center" Height="36" DockPanel.Dock="Left" WindowChrome.IsHitTestVisibleInChrome="True" Width="220" />
              <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}" Style="{DynamicResource TopPanelFilterToggle}" DockPanel.Dock="Left" />
              <Grid x:Name="PART_PanelMainItems" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Height="36">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                  <Style TargetType="{x:Type TopPanelItem}" BasedOn="{StaticResource {x:Type TopPanelItem}}">
                    <Style.Triggers>
                      <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSortSettingsTemplate}">
                        <Setter Property="Grid.Column" Value="0" />
                      </Trigger>
                      <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSearchButtonTemplate}">
                        <Setter Property="Grid.Column" Value="1" />
                      </Trigger>
                      <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGeneralViewSettingsTemplate}">
                        <Setter Property="Grid.Column" Value="2" />
                      </Trigger>
                      <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelFilterPresetsSelectionTemplate}">
                        <Setter Property="Grid.Column" Value="3" />
                      </Trigger>
                      <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGroupSettingsTemplate}">
                        <Setter Property="Grid.Column" Value="4" />
                      </Trigger>
                      <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchDetailsViewTemplate}">
                        <Setter Property="Grid.Column" Value="5" />
                      </Trigger>
                      <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchGridViewTemplate}">
                        <Setter Property="Grid.Column" Value="6" />
                      </Trigger>
                      <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchListViewTemplate}">
                        <Setter Property="Grid.Column" Value="7" />
                      </Trigger>
                      <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelUpdateButtonTemplate}">
                        <Setter Property="Grid.Column" Value="8" />
                      </Trigger>
                      <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSelectRandomGameButtonTemplate}">
                        <Setter Property="Grid.Column" Value="9" />
                      </Trigger>
                      <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelViewSelectRandomGameButtonTemplate}">
                        <Setter Property="Grid.Column" Value="10" />
                      </Trigger>
                      <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelExplorerSwitchTemplate}">
                        <Setter Property="Grid.Column" Value="11" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                  <Style TargetType="Canvas">
                    <Setter Property="Grid.Column" Value="12" />
                  </Style>
                </Grid.Resources>
              </Grid>
              <CheckBox x:Name="PART_ToggleNotifications" Style="{DynamicResource TopPanelNotificationsToggle}" DockPanel.Dock="Left" />
              <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="15,6,15,6" DockPanel.Dock="{Settings PluginTopPanelAlignment}" />
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Center" Margin="0,5,0,5">
                <Grid MaxWidth="600" MinWidth="300">
                  <ProgressBar Name="PART_ProgressGlobal" />
                  <TextBlock Name="PART_TextProgressText" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}" Margin="5,0,5,0" />
                </Grid>
                <Button Name="PART_ButtonProgressCancel" Content="{DynamicResource LOCCancelLabel}" WindowChrome.IsHitTestVisibleInChrome="True" Margin="5,0,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>