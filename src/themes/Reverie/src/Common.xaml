<!-- Reverie: Dreams-inspired capsule plates, violet haze and orbital light. Playnite 10.60 parts. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <Thickness x:Key="ButtonPadding">18,5</Thickness>
  <Thickness x:Key="InputPadding">14,5</Thickness>
  <Thickness x:Key="MenuPadding">4</Thickness>
  <Thickness x:Key="MenuItemPadding">12,6</Thickness>
  <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
  <Thickness x:Key="ComboBoxItemPadding">10,5</Thickness>
  <Thickness x:Key="ListBoxItemPadding">10,5</Thickness>
  <Thickness x:Key="GroupBoxPadding">16</Thickness>
  <Thickness x:Key="TooltipPadding">10,6</Thickness>
  <sys:Double x:Key="ControlHeight">32</sys:Double>
  <sys:Double x:Key="IconSize">16</sys:Double>
  <sys:Double x:Key="GameBannerHeight">340</sys:Double>
  <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
       theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
  <sys:Double x:Key="GameBannerDarken">0</sys:Double>
  <Style x:Key="PopupBorder" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
  </Style>
  <Style x:Key="FocusVisual" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="19" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}" IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
    <Grid Height="6" Background="Transparent">
      <!-- Dreams divider: a row of round lilac beads, the first one in the accent. -->
      <Rectangle Height="3" VerticalAlignment="Center" Margin="10,0,0,0" StrokeThickness="3" Stroke="{DynamicResource WindowPanelSeparatorBrush}" StrokeDashArray="0.01,2" StrokeDashCap="Round" />
      <Ellipse Width="6" Height="6" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
    </Grid>
  </ControlTemplate>

    <!-- EmptyGameTemplate (no game selected): a dreamscape. Cloudy haze and a bloom breathe behind two orbits that rock in opposite
         directions; three motes bob and twinkle. Named transforms started from ControlTemplate.Triggers only, honouring ClientAreaAnimation. -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid Width="360" Height="230" IsHitTestVisible="False">
            <Rectangle x:Name="EmptyHaze" Width="360" Height="190" Fill="{DynamicResource HighlightGlyphBrush}" Opacity="0.14"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/haze.png'}" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle x:Name="EmptyBloom" Width="170" Height="170" Fill="{DynamicResource GlyphBrush}" Opacity="0.3" RenderTransformOrigin="0.5,0.5"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                <Rectangle.RenderTransform><ScaleTransform x:Name="EmptyBloomScale" ScaleX="0.92" ScaleY="0.92" /></Rectangle.RenderTransform></Rectangle>
            <Rectangle Width="224" Height="224" Fill="{DynamicResource HighlightGlyphBrush}" Opacity="0.85" RenderTransformOrigin="0.5,0.5"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/orbit.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                <Rectangle.RenderTransform><RotateTransform x:Name="EmptyOrbitA" Angle="-10" /></Rectangle.RenderTransform></Rectangle>
            <Rectangle Width="148" Height="148" Fill="{DynamicResource DataChangeNotifBrush}" Opacity="0.75" RenderTransformOrigin="0.5,0.5"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/orbit.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                <Rectangle.RenderTransform><RotateTransform x:Name="EmptyOrbitB" Angle="12" /></Rectangle.RenderTransform></Rectangle>
            <Ellipse x:Name="EmptyCore" Width="16" Height="16" Fill="{DynamicResource GlyphBrush}" Opacity="0.9"><Ellipse.RenderTransform><TranslateTransform x:Name="EmptyCoreY" Y="0" /></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="EmptyMote1" Width="8" Height="8" Fill="{DynamicResource GlyphBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="52,58,0,0" Opacity="0"><Ellipse.RenderTransform><TranslateTransform x:Name="EmptyMote1Y" Y="0" /></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="EmptyMote2" Width="6" Height="6" Fill="{DynamicResource HighlightGlyphBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,60,0" Opacity="0"><Ellipse.RenderTransform><TranslateTransform x:Name="EmptyMote2Y" Y="0" /></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="EmptyMote3" Width="7" Height="7" Fill="{DynamicResource DataChangeNotifBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,84,34" Opacity="0"><Ellipse.RenderTransform><TranslateTransform x:Name="EmptyMote3Y" Y="0" /></Ellipse.RenderTransform></Ellipse>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions><BeginStoryboard x:Name="EmptyIdle"><Storyboard><DoubleAnimation Storyboard.TargetName="EmptyHaze" Storyboard.TargetProperty="Opacity" From="0.1" To="0.26" Duration="0:0:4.6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyBloom" Storyboard.TargetProperty="Opacity" From="0.2" To="0.42" Duration="0:0:3.6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyBloomScale" Storyboard.TargetProperty="ScaleX" From="0.92" To="1.1" Duration="0:0:3.6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyBloomScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1.1" Duration="0:0:3.6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyOrbitA" Storyboard.TargetProperty="Angle" From="-10" To="10" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyOrbitB" Storyboard.TargetProperty="Angle" From="12" To="-12" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyCoreY" Storyboard.TargetProperty="Y" From="0" To="-7" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyMote1Y" Storyboard.TargetProperty="Y" From="0" To="-10" Duration="0:0:3.4" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyMote2Y" Storyboard.TargetProperty="Y" From="0" To="9" Duration="0:0:4.2" BeginTime="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyMote3Y" Storyboard.TargetProperty="Y" From="0" To="-8" Duration="0:0:3.8" BeginTime="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:4" RepeatBehavior="Forever"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.95" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:4" Value="0" KeySpline="0.4,0,0.2,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6" BeginTime="0:0:1" RepeatBehavior="Forever"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.9" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0" KeySpline="0.4,0,0.2,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:4.4" BeginTime="0:0:2" RepeatBehavior="Forever"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0.9" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="0" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:4.4" Value="0" KeySpline="0.4,0,0.2,1" /></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="EmptyIdle" /></MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): the 30px capsule plate (orange rim) holding a four-point dream spark at the centre of a
         tilted orbit with one pink bead resting on it, 22x22. Rest: gold spark, thin gold orbit, pink bead on the orbit's
         right end. Hover (IsMouseOver): the spark twirls a quarter turn and swells (BackEase, 0.3s) and settles back on exit.
         Open (the menu's ContextMenu.IsOpen on the nearest Border, which is PART_ElemMainMenu): the orbit turns pink and the
         bead sails round it, one lap every 2.4s at constant speed (the orbit is a squashed, tilted circle with a counter-scaled
         bead, so the bead really follows the ellipse), while a pink and a cyan sparkle twinkle in and out in turn, until the
         menu closes. Hover animates the spark's turn and scale; open animates the orbit's pink layer, the bead's spin and the
         sparkles. -->
    <ControlTemplate x:Key="LocalReverieMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="False">
            <Border Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="15" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5" Background="{DynamicResource ButtonBackgroundBrush}" IsHitTestVisible="False" />
            <Canvas Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Ellipse Canvas.Left="1" Canvas.Top="6.8" Width="20" Height="8.4" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.2" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform Angle="-24" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="OrbitHot" Canvas.Left="1" Canvas.Top="6.8" Width="20" Height="8.4" Stroke="{DynamicResource HighlightGlyphBrush}" StrokeThickness="1.2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform Angle="-24" /></Ellipse.RenderTransform>
                </Ellipse>
                <Path Canvas.Left="0" Canvas.Top="0" Data="M11,5 L12.6,9.4 L17,11 L12.6,12.6 L11,17 L9.4,12.6 L5,11 L9.4,9.4Z" Fill="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SparkScale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="SparkTurn" Angle="0" />
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>
                <Canvas Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="0.42" />
                            <RotateTransform Angle="-24" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Canvas Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><RotateTransform x:Name="BeadSpin" Angle="0" /></Canvas.RenderTransform>
                        <Ellipse Canvas.Left="19.5" Canvas.Top="9.5" Width="3" Height="3" Fill="{DynamicResource HighlightGlyphBrush}" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="2.38" /></Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                </Canvas>
                <Path x:Name="Twinkle1" Data="M3.5,0.5 L4.3,2.7 L6.5,3.5 L4.3,4.3 L3.5,6.5 L2.7,4.3 L0.5,3.5 L2.7,2.7Z" Fill="{DynamicResource HighlightGlyphBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5" Canvas.Left="0" Canvas.Top="0">
                    <Path.RenderTransform><ScaleTransform x:Name="Twinkle1Scale" ScaleX="0.3" ScaleY="0.3" /></Path.RenderTransform>
                </Path>
                <Path x:Name="Twinkle2" Data="M3.5,0.5 L4.3,2.7 L6.5,3.5 L4.3,4.3 L3.5,6.5 L2.7,4.3 L0.5,3.5 L2.7,2.7Z" Fill="{DynamicResource FocusBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5" Canvas.Left="15" Canvas.Top="15">
                    <Path.RenderTransform><ScaleTransform x:Name="Twinkle2Scale" ScaleX="0.3" ScaleY="0.3" /></Path.RenderTransform>
                </Path>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SparkTurn" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SparkScale" Storyboard.TargetProperty="ScaleX" To="1.28" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SparkScale" Storyboard.TargetProperty="ScaleY" To="1.28" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SparkTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SparkScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SparkScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OrbitHot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetName="BeadSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:2.4" RepeatBehavior="Forever" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Twinkle1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Twinkle1Scale" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Twinkle1Scale" Storyboard.TargetProperty="ScaleY" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Twinkle2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.9" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Twinkle2Scale" Storyboard.TargetProperty="ScaleX" BeginTime="0:0:0.9" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Twinkle2Scale" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.9" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="OrbitHot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BeadSpin" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.01" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Twinkle1" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Twinkle1Scale" Storyboard.TargetProperty="ScaleX" To="0.3" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Twinkle1Scale" Storyboard.TargetProperty="ScaleY" To="0.3" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Twinkle2" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Twinkle2Scale" Storyboard.TargetProperty="ScaleX" To="0.3" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Twinkle2Scale" Storyboard.TargetProperty="ScaleY" To="0.3" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>