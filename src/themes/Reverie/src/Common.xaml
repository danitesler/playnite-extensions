<!-- Reverie: Dreams-inspired capsule plates, violet haze and orbital light. Playnite 10.60 parts. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <Thickness x:Key="ButtonPadding">18,5</Thickness>
  <Thickness x:Key="InputPadding">14,5</Thickness>
  <Thickness x:Key="MenuPadding">4</Thickness>
  <Thickness x:Key="MenuItemPadding">12,6</Thickness>
  <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
  <Thickness x:Key="ComboBoxItemPadding">10,5</Thickness>
  <Thickness x:Key="ListBoxItemPadding">10,5</Thickness>
  <Thickness x:Key="GroupBoxPadding">16</Thickness>
  <Thickness x:Key="TooltipPadding">10,6</Thickness>
  <sys:Double x:Key="ControlHeight">32</sys:Double>
  <sys:Double x:Key="IconSize">16</sys:Double>
  <sys:Double x:Key="GameBannerHeight">340</sys:Double>
  <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
       theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
  <sys:Double x:Key="GameBannerDarken">0</sys:Double>
  <Style x:Key="PopupBorder" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
  </Style>
  <Style x:Key="FocusVisual" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="19" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}" IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
    <Grid Height="6" Background="Transparent">
      <!-- Dreams divider: a row of round lilac beads, the first one in the accent. -->
      <Rectangle Height="3" VerticalAlignment="Center" Margin="10,0,0,0" StrokeThickness="3" Stroke="{DynamicResource WindowPanelSeparatorBrush}" StrokeDashArray="0.01,2" StrokeDashCap="Round" />
      <Ellipse Width="6" Height="6" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
    </Grid>
  </ControlTemplate>
</ResourceDictionary>