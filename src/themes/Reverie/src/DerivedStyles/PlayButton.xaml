<!-- Reverie: original Dreams-inspired soft plates and orbital light. Playnite 10.60 parts. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    RunningActionIndicator: laid over the Play / context action cell on both game pages (Playnite shows RUNNING or
    LAUNCHING there). A dream spark: a mint mote circling a small orbit at the capsule's right end over a mint hairline
    along its foot; one slow turn every 3.6s while running, a quick flickering 0.8s turn while launching.
    DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching). Never hit-testable.
  -->
  <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Control}">
          <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.12" />
                        <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.4">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.9" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.45" />
                                    <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Rectangle Height="1" Margin="20,0,20,1" VerticalAlignment="Bottom" Fill="{DynamicResource RunningIndicatorBrush}" />
            <Grid Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="15" Height="15">
              <Ellipse Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="1" Opacity="0.45" />
              <Ellipse x:Name="RunningRing" Margin="0.75" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="1.5" StrokeDashArray="29.27 29.27" StrokeDashOffset="0" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <RotateTransform Angle="-90" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="5" Height="5" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.6" />
              <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <RotateTransform x:Name="RunningOrbit" />
                </Grid.RenderTransform>
                <Ellipse Width="4" Height="4" Margin="0,-2,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="{DynamicResource RunningIndicatorBrush}" />
              </Grid>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="RunningIndicatorLaunching">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:2.6">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.9" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1" KeySpline="0.37,0 0.63,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:2.6">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.45" KeySpline="0.37,0 0.63,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="1.45" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:2.6">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.9" KeySpline="0.37,0 0.63,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="1.9" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRing" Storyboard.TargetProperty="StrokeDashOffset" Duration="0:0:2.6">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="29.27" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0" KeySpline="0.37,0 0.63,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningOrbit" Storyboard.TargetProperty="Angle" Duration="0:0:2.6">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="720" KeySpline="0.37,0 0.63,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="720" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="RunningIndicatorRunning">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.72" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningOrbit" Storyboard.TargetProperty="Angle" Duration="0:0:3.6">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="360" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                </DataTrigger.ExitActions>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Border x:Name="Halo" Margin="-2" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="4" BorderBrush="{DynamicResource NormalBorderBrush}" Opacity="0.67" IsHitTestVisible="False">
              <Border.Effect><BlurEffect Radius="10" /></Border.Effect>
            </Border>
            <Grid x:Name="Fringe" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><SkewTransform /></Grid.RenderTransform>
              <Border x:Name="FringeC" Margin="-1,-1,1,1" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="2" BorderBrush="{DynamicResource DataChangeNotifBrush}" RenderTransformOrigin="0.5,0.5"><Border.Effect><BlurEffect Radius="0.8" /></Border.Effect><Border.RenderTransform><RotateTransform /></Border.RenderTransform></Border>
              <Border x:Name="FringeP" Margin="1,1,-1,-1" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="2" BorderBrush="{DynamicResource HighlightGlyphBrush}" RenderTransformOrigin="0.5,0.5"><Border.Effect><BlurEffect Radius="0.8" /></Border.Effect><Border.RenderTransform><RotateTransform /></Border.RenderTransform></Border>
            </Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"  x:Name="PlayFill"/><Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.4" IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.9" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningHoverDim" Background="{DynamicResource ScrimBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
            <Border x:Name="Hover" Opacity="0" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
            <Border x:Name="Press" Opacity="0" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
              <Grid x:Name="PlayGlyph" Width="24" Height="24" Margin="0,0,9,0" IsHitTestVisible="False">
                <Ellipse Stroke="{DynamicResource PrimaryButtonForegroundBrush}" StrokeThickness="1" Opacity="0.55" />
                <ContentControl Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                <Grid x:Name="Mote" RenderTransformOrigin="0.5,0.5">
                  <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                  <Ellipse Width="4" Height="4" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{DynamicResource PrimaryButtonForegroundBrush}" />
                </Grid>
              </Grid>
              <ContentPresenter x:Name="PlayContent" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
              <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
          <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Hover" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter Property="Opacity" Value="0.08" TargetName="RunningBreath" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1" KeySpline="0.37,0 0.63,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.45" KeySpline="0.37,0 0.63,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.9" KeySpline="0.37,0 0.63,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="1.9" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Hover" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.05" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.14" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.05" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" From="0" To="0.18" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
            <Trigger Property="Tag" Value="ContextAction">
              <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
              <MultiDataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.EnterActions>
              <MultiDataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.67" Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetName="FringeC" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.25" /><DoubleAnimation Storyboard.TargetName="FringeP" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.25" /><ThicknessAnimation Storyboard.TargetName="FringeC" Storyboard.TargetProperty="Margin" To="-1,-1,1,1" Duration="0:0:0.25" /><ThicknessAnimation Storyboard.TargetName="FringeP" Storyboard.TargetProperty="Margin" To="1,1,-1,-1" Duration="0:0:0.25" /><DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="10" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
<MultiDataTrigger>
<MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" /><Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" /></MultiDataTrigger.Conditions>
<MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="FringeC" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="0:0:1.7" RepeatBehavior="Forever"><SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.9" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="-0.7" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.5" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" KeySpline="0.4,0,0.6,1" /></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="FringeP" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="0:0:1.9" RepeatBehavior="Forever"><SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="-0.8" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.9" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="-0.4" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0" KeySpline="0.4,0,0.6,1" /></DoubleAnimationUsingKeyFrames><ThicknessAnimationUsingKeyFrames Storyboard.TargetName="FringeC" Storyboard.TargetProperty="Margin" Duration="0:0:1.7" RepeatBehavior="Forever"><SplineThicknessKeyFrame KeyTime="0:0:0" Value="-1,-1,1,1" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:0.5" Value="-2.4,-0.4,2.0,1.6" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.1" Value="-1.2,-2.0,1.6,0.8" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.7" Value="-1,-1,1,1" KeySpline="0.4,0,0.6,1" /></ThicknessAnimationUsingKeyFrames><ThicknessAnimationUsingKeyFrames Storyboard.TargetName="FringeP" Storyboard.TargetProperty="Margin" Duration="0:0:1.9" RepeatBehavior="Forever"><SplineThicknessKeyFrame KeyTime="0:0:0" Value="1,1,-1,-1" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:0.6" Value="2.2,0.6,-2.4,-0.6" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.2" Value="0.8,2.2,-0.6,-2.0" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.9" Value="1,1,-1,-1" KeySpline="0.4,0,0.6,1" /></ThicknessAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Halo" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" Duration="0:0:2.2" RepeatBehavior="Forever"><SplineDoubleKeyFrame KeyTime="0:0:0" Value="10" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="15" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="10" KeySpline="0.4,0,0.6,1" /></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
</MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <MultiDataTrigger.EnterActions>
                <BeginStoryboard Name="EdgeRipple">
                  <Storyboard FillBehavior="Stop">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Fringe" Storyboard.TargetProperty="(UIElement.RenderTransform).(SkewTransform.AngleX)">
                      <EasingDoubleKeyFrame KeyTime="0:0:0.09" Value="8" />
                      <EasingDoubleKeyFrame KeyTime="0:0:0.19" Value="-4" />
                      <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetName="Mote" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.42" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.EnterActions>
              <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="EdgeRipple" /></MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
          <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
        
            <!-- LAUNCHING and RUNNING come last, so the plate stays the running colour under the pointer. -->
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>