<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
  </Style>
  <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
    <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    <Setter Property="WindowChrome.WindowChrome">
      <Setter.Value>
        <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4" NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type WindowBase}">
          <ControlTemplate.Resources>
            <sys:Boolean x:Key="True">True</sys:Boolean>
          </ControlTemplate.Resources>
          <AdornerDecorator>
            <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
              <Grid>
                <!-- Orbital sun behind the title, on the flat page. Below the content, never clickable. -->
                <Grid IsHitTestVisible="False" ClipToBounds="True" Height="56" VerticalAlignment="Top">
                  <Rectangle Width="260" Height="260" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-40,-118,0,0" Fill="{DynamicResource NormalBorderBrush}" Opacity="0.6">
                    <Rectangle.OpacityMask>
                      <ImageBrush ImageSource="{ThemeFile 'Images/fx/orbit.png'}" />
                    </Rectangle.OpacityMask>
                  </Rectangle>
                  <Rectangle Width="190" Height="190" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,-92,0,0" Fill="{DynamicResource HighlightGlyphBrush}" Opacity="0.4" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                      <RotateTransform Angle="72" />
                    </Rectangle.RenderTransform>
                    <Rectangle.OpacityMask>
                      <ImageBrush ImageSource="{ThemeFile 'Images/fx/orbit.png'}" />
                    </Rectangle.OpacityMask>
                  </Rectangle>
                </Grid>
                <ContentPresenter Margin="0,44,0,0" />
                <DockPanel Height="44" VerticalAlignment="Top" LastChildFill="False">
                  <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                    <Grid DockPanel.Dock="Left" Margin="22,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                      <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" VerticalAlignment="Center" Opacity="0.8" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="26" Foreground="{DynamicResource NormalBorderBrush}" Style="{DynamicResource BaseTextBlockStyle}">
                        <TextBlock.Effect><BlurEffect Radius="9" /></TextBlock.Effect>
                      </TextBlock>
                      <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="26" Foreground="{DynamicResource PrimaryButtonBackgroundBrush}" Style="{DynamicResource BaseTextBlockStyle}" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0">
                      <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                      <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                      <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                    </StackPanel>
                  </DockPanel>
                </DockPanel>
              </Grid>
            </Border>
          </AdornerDecorator>
          <ControlTemplate.Triggers>
            <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
              <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
            </Trigger>
            <Trigger Property="WindowState" Value="Maximized">
              <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
              <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
            </Trigger>
            <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
              <Setter Property="Opacity" Value="0.4" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>