<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="WindowBarButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="Transparent">
            <Border x:Name="Plate" Width="28" Height="28" CornerRadius="14" Background="Transparent" BorderThickness="1.5" BorderBrush="Transparent">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Marlett" Foreground="{TemplateBinding Foreground}" FontSize="14" Text="{TemplateBinding Content}" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
              <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
      </Trigger>
      <Trigger Property="IsFocused" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>