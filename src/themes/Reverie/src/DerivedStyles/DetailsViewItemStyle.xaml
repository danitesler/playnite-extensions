<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid>
            <Border x:Name="SelectedRectangle" IsHitTestVisible="False" Visibility="Collapsed" Background="{DynamicResource PrimaryButtonBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1.5" BorderBrush="{DynamicResource NormalBorderBrush}" />
            <Border x:Name="HoverRectangle" IsHitTestVisible="False" Visibility="Collapsed" Background="{DynamicResource ButtonBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1.5" BorderBrush="{DynamicResource NormalBorderBrush}" />
            <Border x:Name="FringeC" Margin="0,0,0,0" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource DataChangeNotifBrush}" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform /></Border.RenderTransform></Border>
<Border x:Name="FringeP" Margin="0,0,0,0" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource HighlightGlyphBrush}" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform /></Border.RenderTransform></Border>
            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Visibility" Value="Visible" TargetName="HoverRectangle" />
              <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
              <Setter TargetName="FringeC" Property="Opacity" Value="0.8" /><Setter TargetName="FringeP" Property="Opacity" Value="0.8" /><Setter TargetName="FringeC" Property="Effect"><Setter.Value><BlurEffect Radius="1.2" /></Setter.Value></Setter><Setter TargetName="FringeP" Property="Effect"><Setter.Value><BlurEffect Radius="1.2" /></Setter.Value></Setter><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="FringeC" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.25" /><DoubleAnimation Storyboard.TargetName="FringeP" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.25" /><ThicknessAnimation Storyboard.TargetName="FringeC" Storyboard.TargetProperty="Margin" To="0,0,0,0" Duration="0:0:0.25" /><ThicknessAnimation Storyboard.TargetName="FringeP" Storyboard.TargetProperty="Margin" To="0,0,0,0" Duration="0:0:0.25" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <MultiDataTrigger>
<MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" /><Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" /></MultiDataTrigger.Conditions>
<MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="FringeC" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="0:0:1.7" RepeatBehavior="Forever"><SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.9" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="-0.7" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.5" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" KeySpline="0.4,0,0.6,1" /></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="FringeP" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="0:0:1.9" RepeatBehavior="Forever"><SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="-0.8" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.9" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="-0.4" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0" KeySpline="0.4,0,0.6,1" /></DoubleAnimationUsingKeyFrames><ThicknessAnimationUsingKeyFrames Storyboard.TargetName="FringeC" Storyboard.TargetProperty="Margin" Duration="0:0:1.7" RepeatBehavior="Forever"><SplineThicknessKeyFrame KeyTime="0:0:0" Value="0,0,0,0" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:0.5" Value="-1.8199999999999998,0.78,1.3,0.78" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.1" Value="-0.26,-1.3,0.78,-0.26" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.7" Value="0,0,0,0" KeySpline="0.4,0,0.6,1" /></ThicknessAnimationUsingKeyFrames><ThicknessAnimationUsingKeyFrames Storyboard.TargetName="FringeP" Storyboard.TargetProperty="Margin" Duration="0:0:1.9" RepeatBehavior="Forever"><SplineThicknessKeyFrame KeyTime="0:0:0" Value="0,0,0,0" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:0.6" Value="1.56,-0.52,-1.8199999999999998,0.52" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.2" Value="-0.26,1.56,0.52,-1.3" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.9" Value="0,0,0,0" KeySpline="0.4,0,0.6,1" /></ThicknessAnimationUsingKeyFrames></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
</MultiDataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Visibility" Value="Visible" TargetName="SelectedRectangle" />
              <Setter Property="Visibility" Value="Collapsed" TargetName="HoverRectangle" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>