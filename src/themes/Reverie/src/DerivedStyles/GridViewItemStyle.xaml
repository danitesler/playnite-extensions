<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Background="{DynamicResource GridItemBackgroundBrush}" Margin="{Settings ItemSpacingMargin}" x:Name="ItemGrid">
            <Border CornerRadius="10" x:Name="SelectionBorder" BorderThickness="3" Margin="-3" />
            <ContentPresenter />
            <Border x:Name="FringeC" Margin="-1.5,-1.5,1.5,1.5" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource DataChangeNotifBrush}" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform /></Border.RenderTransform></Border>
<Border x:Name="FringeP" Margin="1.5,1.5,-1.5,-1.5" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource HighlightGlyphBrush}" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform /></Border.RenderTransform></Border>
            <Border x:Name="HoverRing" Opacity="0" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="2" CornerRadius="10" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}" TargetName="SelectionBorder" />
              <Setter Property="Canvas.ZIndex" Value="90" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Canvas.ZIndex" Value="91" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetName="FringeC" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetName="FringeP" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.18" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetName="FringeC" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetName="FringeP" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetName="FringeC" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.25" /><DoubleAnimation Storyboard.TargetName="FringeP" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.25" /><ThicknessAnimation Storyboard.TargetName="FringeC" Storyboard.TargetProperty="Margin" To="-1.5,-1.5,1.5,1.5" Duration="0:0:0.25" /><ThicknessAnimation Storyboard.TargetName="FringeP" Storyboard.TargetProperty="Margin" To="1.5,1.5,-1.5,-1.5" Duration="0:0:0.25" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
<MultiDataTrigger>
<MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" /><Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" /></MultiDataTrigger.Conditions>
<MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="FringeC" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="0:0:1.7" RepeatBehavior="Forever"><SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.9" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="-0.7" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.5" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" KeySpline="0.4,0,0.6,1" /></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="FringeP" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="0:0:1.9" RepeatBehavior="Forever"><SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="-0.8" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.9" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="-0.4" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0" KeySpline="0.4,0,0.6,1" /></DoubleAnimationUsingKeyFrames><ThicknessAnimationUsingKeyFrames Storyboard.TargetName="FringeC" Storyboard.TargetProperty="Margin" Duration="0:0:1.7" RepeatBehavior="Forever"><SplineThicknessKeyFrame KeyTime="0:0:0" Value="-1.5,-1.5,1.5,1.5" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:0.5" Value="-3.1799999999999997,-0.78,2.7,2.2199999999999998" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.1" Value="-1.74,-2.7,2.2199999999999998,1.26" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.7" Value="-1.5,-1.5,1.5,1.5" KeySpline="0.4,0,0.6,1" /></ThicknessAnimationUsingKeyFrames><ThicknessAnimationUsingKeyFrames Storyboard.TargetName="FringeP" Storyboard.TargetProperty="Margin" Duration="0:0:1.9" RepeatBehavior="Forever"><SplineThicknessKeyFrame KeyTime="0:0:0" Value="1.5,1.5,-1.5,-1.5" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:0.6" Value="2.94,1.02,-3.1799999999999997,-1.02" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.2" Value="1.26,2.94,-1.02,-2.7" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.9" Value="1.5,1.5,-1.5,-1.5" KeySpline="0.4,0,0.6,1" /></ThicknessAnimationUsingKeyFrames></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
</MultiDataTrigger>
            <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
              <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>