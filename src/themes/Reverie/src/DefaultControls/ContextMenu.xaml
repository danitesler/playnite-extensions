<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu,
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is Dreams' My Preferences violet panel: deep violet fill (PopupBackgroundBrush)
    in 10px rounded corners (CornerRadiusLarge) with a 1px lilac rim (PopupBorderBrush), a split-lens pink/cyan
    chromatic accent line along the top edge and a small gold-rimmed bead at top centre (LocalMenuPanelTemplate,
    shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml).
    Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusLarge}" />
            <!-- Split-lens chromatic rim whisper along the top edge -->
            <Border Height="2" Margin="18,1,46,0" VerticalAlignment="Top" CornerRadius="1"
                    Background="{DynamicResource HighlightGlyphBrush}" Opacity="0.65" />
            <Border Height="2" Margin="46,1,18,0" VerticalAlignment="Top" CornerRadius="1"
                    Background="{DynamicResource FocusBrush}" Opacity="0.55" />
            <!-- Small orbital bead centred on the top edge -->
            <Ellipse Width="7" Height="7" Margin="0,-2,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Fill="{DynamicResource PrimaryButtonBackgroundBrush}"
                     Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" Margin="0,2,0,0" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,7,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="5,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
