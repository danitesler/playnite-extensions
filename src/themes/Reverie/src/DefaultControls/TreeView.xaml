<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:sys="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d">
  <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TreeView}">
          <Border BorderThickness="0" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
            <ScrollViewer Focusable="False" Padding="4,2,6,4" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding (AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowSettings">
        <Setter Property="Width" Value="250" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      </DataTrigger>
      <DataTrigger Binding="{Binding (AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType=Window}}" Value="WindowExtensions">
        <Setter Property="Width" Value="250" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseStyle}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="Padding" Value="12,0,12,0" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TreeViewItem}">
          <StackPanel>
            <!-- Dreams preference row: maroon capsule with an orange rim; selected turns cream with a glow and a bead. -->
            <Grid Margin="{TemplateBinding Margin}" MinHeight="30">
              <Border x:Name="Glow" Margin="-2" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="3" BorderBrush="{DynamicResource NormalBorderBrush}" Opacity="0" IsHitTestVisible="False">
                <Border.Effect><BlurEffect Radius="8" /></Border.Effect>
              </Border>
              <Border x:Name="FringeC" Margin="-1,-1,1,1" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource DataChangeNotifBrush}" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform /></Border.RenderTransform></Border>
<Border x:Name="FringeP" Margin="1,1,-1,-1" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource HighlightGlyphBrush}" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform /></Border.RenderTransform></Border>
              <Border x:Name="Plate" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
              <Border x:Name="SelectionBorder" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}" MinHeight="30" Padding="{TemplateBinding Padding}">
                <DockPanel>
                  <ToggleButton Width="14" Height="14" Margin="0,0,6,0" x:Name="Expander" ClickMode="Press" DockPanel.Dock="Left" IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Style>
                      <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseStyle}">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                              <Grid>
                                <Viewbox x:Name="IsExpandedPath" Visibility="Visible">
                                  <TextBlock Text="4" FontFamily="Marlett" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Viewbox>
                                <Viewbox x:Name="ExpandPath" Visibility="Collapsed">
                                  <TextBlock Text="6" FontFamily="Marlett" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Viewbox>
                              </Grid>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter Property="Visibility" Value="Visible" TargetName="ExpandPath" />
                                  <Setter Property="Visibility" Value="Collapsed" TargetName="IsExpandedPath" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ToggleButton.Style>
                  </ToggleButton>
                  <Ellipse x:Name="Seed" Width="6" Height="6" Margin="0,0,7,0" Fill="{DynamicResource NormalBorderBrush}" Visibility="Collapsed" DockPanel.Dock="Left" />
                  <ContentPresenter x:Name="PART_Header" ContentSource="Header" Height="Auto" DockPanel.Dock="Left" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
            </Grid>
            <ItemsPresenter x:Name="ItemsHost" Margin="20,0,0,0" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <Setter Property="Visibility" Value="Collapsed" TargetName="ItemsHost" />
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter Property="Visibility" Value="Hidden" TargetName="Expander" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
              <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True" SourceName="SelectionBorder">
              <Setter TargetName="PART_Header" Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" />
              <Setter TargetName="Glow" Property="Opacity" Value="0.35" />
              <Setter TargetName="FringeC" Property="Opacity" Value="0.85" /><Setter TargetName="FringeP" Property="Opacity" Value="0.85" /><Setter TargetName="FringeC" Property="Effect"><Setter.Value><BlurEffect Radius="1.2" /></Setter.Value></Setter><Setter TargetName="FringeP" Property="Effect"><Setter.Value><BlurEffect Radius="1.2" /></Setter.Value></Setter><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.16" /></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" /><DoubleAnimation Storyboard.TargetName="FringeC" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.25" /><DoubleAnimation Storyboard.TargetName="FringeP" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.25" /><ThicknessAnimation Storyboard.TargetName="FringeC" Storyboard.TargetProperty="Margin" To="-1,-1,1,1" Duration="0:0:0.25" /><ThicknessAnimation Storyboard.TargetName="FringeP" Storyboard.TargetProperty="Margin" To="1,1,-1,-1" Duration="0:0:0.25" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <MultiDataTrigger>
<MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, ElementName=SelectionBorder}" Value="True" /><Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" /></MultiDataTrigger.Conditions>
<MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="FringeC" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="0:0:1.7" RepeatBehavior="Forever"><SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.9" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="-0.7" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.5" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" KeySpline="0.4,0,0.6,1" /></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="FringeP" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="0:0:1.9" RepeatBehavior="Forever"><SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="-0.8" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.9" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="-0.4" KeySpline="0.4,0,0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0" KeySpline="0.4,0,0.6,1" /></DoubleAnimationUsingKeyFrames><ThicknessAnimationUsingKeyFrames Storyboard.TargetName="FringeC" Storyboard.TargetProperty="Margin" Duration="0:0:1.7" RepeatBehavior="Forever"><SplineThicknessKeyFrame KeyTime="0:0:0" Value="-1,-1,1,1" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:0.5" Value="-2.4,-0.4,2.0,1.6" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.1" Value="-1.2,-2.0,1.6,0.8" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.7" Value="-1,-1,1,1" KeySpline="0.4,0,0.6,1" /></ThicknessAnimationUsingKeyFrames><ThicknessAnimationUsingKeyFrames Storyboard.TargetName="FringeP" Storyboard.TargetProperty="Margin" Duration="0:0:1.9" RepeatBehavior="Forever"><SplineThicknessKeyFrame KeyTime="0:0:0" Value="1,1,-1,-1" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:0.6" Value="2.2,0.6,-2.4,-0.6" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.2" Value="0.8,2.2,-0.6,-2.0" KeySpline="0.4,0,0.6,1" /><SplineThicknessKeyFrame KeyTime="0:0:1.9" Value="1,1,-1,-1" KeySpline="0.4,0,0.6,1" /></ThicknessAnimationUsingKeyFrames></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
</MultiDataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectionBorder" Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
              <Setter TargetName="PART_Header" Property="TextElement.Foreground" Value="{DynamicResource TextBrushDark}" />
              <Setter TargetName="Seed" Property="Visibility" Value="Visible" />
              <Setter TargetName="Glow" Property="Opacity" Value="0.9" />
              <Setter TargetName="FringeC" Property="Opacity" Value="0.6" />
              <Setter TargetName="FringeP" Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>