<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="SearchBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="SearchBox">
          <Grid Background="Transparent">
            <TextBox x:Name="PART_TextInpuText" MinHeight="0" Padding="30,5,28,5" VerticalContentAlignment="Center" />
            <ContentControl x:Name="PART_SeachIcon" Opacity="0" IsHitTestVisible="False" />
            <ContentControl x:Name="Glyph" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource GlyphBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" Focusable="False" />
            <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextBrushDarker}" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value="" />
                <Condition Property="IsKeyboardFocusWithin" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
            <Trigger Property="ShowImage" Value="False">
              <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TopPanelSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
    <Setter Property="Height" Value="36" />
  </Style>
</ResourceDictionary>