<!--
    Ditherwake: DefaultControls/Menu.xaml.
    Menus signature levers (docs/themes/menus.md):
    - Panel: LocalLedgerMenuBoardTemplate (#212329 IBM-8503 ledger board with 3.5% vellum-stipple.png, double-ruled
      copperplate border, four corner rosette squares, 6px top Bayer-dithered woodcut frieze, and a hanging top-right
      Zenith Amber swallowtail bookmark ribbon).
    - Highlight: 30px rows; True 1-Bit Monochrome Inversion — solid Vellum Cream (#EBE5CE) ledger strip with a 4px
      Zenith Amber left binding spine and top/bottom 1px iron-gall ink registration hairlines wipes in (ScaleX 0.90->1,
      115ms CubicEase) while a pointed fountain-pen nib pointer slides in (-5->0), inverting label, icon
      (TextElement.Foreground on TargetName="Icon"), arrow, and movable-type shortcut block to #18191D ink (12.8:1) + 2px nudge.
    - Group break: 10px copperplate rule tapering from a centered hollow nautical compass diamond flanked by twin Bayer pixel dots.
    - Shortcuts: notched movable-type printing blocks (#18191D well, 1px Vellum rim, Consolas Zenith Amber digits at rest;
      inverting to #18191D block with Vellum digits on Vellum highlight).
    - Submenu mark: engraved compass chevron (IconSubmenu); open submenus hold a steady #362F22 brass-umber wash.
    - Marked rows: Exit (Alt+Q) wears bright Sealing-Wax Red text + crimson diamond at rest, highlighting as a solid
      E.I.C. Sealing-Wax Crimson (#B83228) double-ruled stamp plate with Vellum Bright ink (6.1:1); checked rows show
      a 14x14 rotated Zenith Amber diamond seal with #18191D check.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group Break: 10px Copperplate Rule centered on a hollow compass diamond + twin Bayer pixel dots -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="6,0,6,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource DividerTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SubmenuItem (plain leaf row, 30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- True 1-Bit Inverted Vellum Cream (#EBE5CE) Ledger Strip + 4px Zenith Amber Spine -->
            <Grid x:Name="HighlightPlate" Margin="2,1.5,2,1.5" Visibility="Collapsed" Opacity="0"
                  IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" ScaleY="1" />
                </Grid.RenderTransform>
                <Border x:Name="HighlightFill" CornerRadius="0"
                        Background="{DynamicResource MenuItemHoverBrush}"
                        BorderBrush="{DynamicResource LocalZenithDeepBrush}" BorderThickness="0,1,0,1" />
                <Rectangle x:Name="HighlightSpine" Width="4" HorizontalAlignment="Left"
                           Fill="{DynamicResource LocalZenithAmberBrush}" />
                <Rectangle x:Name="HighlightSeam" Width="1" HorizontalAlignment="Left" Margin="4,0,0,0"
                           Fill="{DynamicResource TextBrushDark}" />
                <!-- Top & bottom inset copperplate registration hairlines -->
                <Rectangle x:Name="HighlightTopRule" Height="1" VerticalAlignment="Top" Margin="6,2,5,0"
                           Fill="{DynamicResource TextBrushDark}" Opacity="0.38" />
                <Rectangle x:Name="HighlightBotRule" Height="1" VerticalAlignment="Bottom" Margin="6,0,5,2"
                           Fill="{DynamicResource TextBrushDark}" Opacity="0.38" />
            </Grid>

            <!-- Quiet resting Wax-Red diamond tick on Exit (Alt+Q) -->
            <Path x:Name="ExitRestPip" Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                  Stretch="Fill" Data="M2.5,0 L5,2.5 L2.5,5 L0,2.5 Z"
                  Fill="{DynamicResource LocalDangerBrightBrush}"
                  Visibility="Collapsed" IsHitTestVisible="False" />

            <Grid Margin="10,0,8,0">
                <Grid.ColumnDefinitions>
                    <!-- Fixed icon column (16px icon + 8px gap = 24px) -->
                    <ColumnDefinition Width="24" />
                    <!-- Plain * label column (never SharedSizeGroup on star column) -->
                    <ColumnDefinition Width="*" />
                    <!-- Shared shortcut column flush right -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                    <!-- Arrow spacer column matching SubmenuHeader -->
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <!-- Icon (Pixelarticons 48px PNG scaled NearestNeighbor; sits in crisp dark badge on 1-bit inverted highlight) -->
                <Border x:Name="IconPlate" Grid.Column="0" Width="20" Height="20" Margin="-2,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <ContentPresenter x:Name="Icon" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ContentSource="Icon" TextElement.Foreground="{DynamicResource TextBrushDarker}" />
                </Border>

                <Grid x:Name="CheckBoxMark" Grid.Column="0" Width="14" Height="14"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Visibility="Collapsed" IsHitTestVisible="False">
                    <Path Stretch="Fill" Data="M7,0 L14,7 L7,14 L0,7 Z"
                          Fill="{DynamicResource CheckBoxCheckMarkBkBrush}"
                          Stroke="{DynamicResource TextBrushDark}" StrokeThickness="1" />
                    <ContentControl x:Name="CheckGlyph" Width="8" Height="8"
                                    Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                    Foreground="{DynamicResource TextBrushDark}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Label (nudges +2px right on highlight) -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{DynamicResource TextBrush}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelSlide" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Movable-Type Printing-Block Shortcut Keycap -->
                <Border x:Name="ShortcutCap" Grid.Column="2" Margin="12,0,0,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        CornerRadius="0" Background="{DynamicResource ShellBackgroundBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1,1,1,1.5">
                    <TextBlock x:Name="ShortcutText" Padding="6,1" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource LocalZenithAmberBrush}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutCap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutCap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPlate" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="IconPlate" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckBoxMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter TargetName="ExitRestPip" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource LocalDangerBrightBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalDangerBrightBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource LocalDangerBrightBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource TextBrushDark}" />
                <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalVellumBrush}" />
                <Setter TargetName="ShortcutCap" Property="Background" Value="{DynamicResource TextBrushDark}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource TextBrushDark}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource LocalVellumBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuItemHlIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.115" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.115">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.115" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuItemHlOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <!-- E.I.C. Sealing-Wax Crimson Exit Stamp on highlight (Vellum Bright on #B83228 = 6.1:1) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ExitRestPip" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="HighlightSpine" Property="Fill" Value="{DynamicResource LocalVellumBrightBrush}" />
                <Setter TargetName="HighlightFill" Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="HighlightFill" Property="BorderBrush" Value="{DynamicResource LocalVellumBrightBrush}" />
                <Setter TargetName="HighlightTopRule" Property="Fill" Value="{DynamicResource LocalVellumBrightBrush}" />
                <Setter TargetName="HighlightBotRule" Property="Fill" Value="{DynamicResource LocalVellumBrightBrush}" />
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalVellumBrush}" />
                <Setter TargetName="ShortcutCap" Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource LocalVellumBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeader (row opening a nested popup, 30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held warm brass-umber wash while submenu stays open (no flicker) -->
            <Grid x:Name="OpenPlate" Margin="2,1.5,2,1.5" Visibility="Collapsed" IsHitTestVisible="False">
                <Border CornerRadius="0" Background="{DynamicResource SelectedBrush}"
                        BorderBrush="{DynamicResource LocalZenithDeepBrush}" BorderThickness="1" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource LocalZenithAmberBrush}" />
            </Grid>

            <!-- True 1-Bit Inverted Vellum Cream highlight strip -->
            <Grid x:Name="HighlightPlate" Margin="2,1.5,2,1.5" Visibility="Collapsed" Opacity="0"
                  IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" ScaleY="1" />
                </Grid.RenderTransform>
                <Border CornerRadius="0" Background="{DynamicResource MenuItemHoverBrush}"
                        BorderBrush="{DynamicResource LocalZenithDeepBrush}" BorderThickness="0,1,0,1" />
                <Rectangle Width="4" HorizontalAlignment="Left" Fill="{DynamicResource LocalZenithAmberBrush}" />
                <Rectangle Width="1" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{DynamicResource TextBrushDark}" />
                <Rectangle Height="1" VerticalAlignment="Top" Margin="6,2,5,0" Fill="{DynamicResource TextBrushDark}" Opacity="0.38" />
                <Rectangle Height="1" VerticalAlignment="Bottom" Margin="6,0,5,2" Fill="{DynamicResource TextBrushDark}" Opacity="0.38" />
            </Grid>

            <Grid Margin="10,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconPlate" Grid.Column="0" Width="20" Height="20" Margin="-2,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <ContentPresenter x:Name="Icon" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ContentSource="Icon" TextElement.Foreground="{DynamicResource TextBrushDarker}" />
                </Border>

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{DynamicResource TextBrush}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelSlide" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <ContentControl x:Name="SubArrow" Grid.Column="3" Width="10" Height="10"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource LocalZenithAmberBrush}" />
            </Grid>

            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-11"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade">
                <Grid MinWidth="210" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalLedgerMenuBoardTemplate}"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    <ScrollViewer Margin="8,11,8,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle"
                                        Grid.IsSharedSizeScope="True" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPlate" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource LocalZenithAmberBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalZenithAmberBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource LocalZenithAmberBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource TextBrushDark}" />
                <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalVellumBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubmenuHlIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.115" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.115">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.115" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubmenuHlOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
