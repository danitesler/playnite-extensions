<!--
    Ditherwake: DefaultControls/GroupBox.xaml.
    Content-sized copperplate ledger card (no child width >= 200px; horizontal header track sits in a clipped Grid)
    crowned by a rotated Zenith Amber compass diamond, Cinzel Bold header, and copperplate rule.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="{DynamicResource GroupBoxHeaderMargin}" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Stretch="Fill"
                                      Data="M3.5,0 L7,3.5 L3.5,7 L0,3.5 Z"
                                      Stroke="{DynamicResource LocalZenithAmberBrush}" StrokeThickness="1.3"
                                      Fill="{DynamicResource ShellBackgroundBrush}" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="8,0,8,0"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"
                                                  TextElement.Foreground="{DynamicResource HeadingForegroundBrush}"
                                                  TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.FontSize="{DynamicResource FontSizeLarge}" />
                                <Rectangle Grid.Column="2" Height="1.5" VerticalAlignment="Center"
                                           Fill="{DynamicResource NormalBorderBrush}" />
                            </Grid>
                            <ContentPresenter Grid.Row="1" ContentSource="Content" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
