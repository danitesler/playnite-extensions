<!--
    Ditherwake: DefaultControls/ComboBox.xaml.
    32px double-ruled copperplate ComboBox with dedicated 30px right chevron lane holding a Vellum Cream
    square stamp keycap (ContentSite right margin = 32px >= 12px rule). Popup hosts LocalLedgerMenuBoardTemplate
    with 30px ComboBoxItem rows wearing 1-Bit Inverted Vellum Cream strips on IsHighlighted and rotated
    Zenith Amber diamond seals on IsSelected.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ControlTemplate x:Key="LocalComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Border" Grid.ColumnSpan="2"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="{DynamicResource ControlBorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border x:Name="ChevronSeal" Grid.Column="1" Width="18" Height="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0"
                    CornerRadius="0" Background="{DynamicResource LocalVellumBrush}"
                    BorderBrush="{DynamicResource LocalZenithDeepBrush}" BorderThickness="1">
                <ContentControl x:Name="Arrow" Width="9" Height="9"
                                Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource TextBrushDark}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                <Setter TargetName="ChevronSeal" Property="Background" Value="{DynamicResource LocalZenithAmberBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                <Setter TargetName="ChevronSeal" Property="Background" Value="{DynamicResource LocalZenithAmberBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- True 1-Bit Inverted Vellum Cream strip + 4px Zenith Amber spine -->
                        <Grid x:Name="HighlightPlate" Margin="2,1.5,2,1.5" Visibility="Collapsed" Opacity="0"
                              IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border CornerRadius="0" Background="{DynamicResource MenuItemHoverBrush}"
                                    BorderBrush="{DynamicResource LocalZenithDeepBrush}" BorderThickness="0,1,0,1" />
                            <Rectangle Width="4" HorizontalAlignment="Left" Fill="{DynamicResource LocalZenithAmberBrush}" />
                            <Rectangle Width="1" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{DynamicResource TextBrushDark}" />
                            <Rectangle Height="1" VerticalAlignment="Top" Margin="6,2,5,0" Fill="{DynamicResource TextBrushDark}" Opacity="0.38" />
                            <Rectangle Height="1" VerticalAlignment="Bottom" Margin="6,0,5,2" Fill="{DynamicResource TextBrushDark}" Opacity="0.38" />
                        </Grid>

                        <Grid Margin="10,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Chosen rotated Zenith Amber diamond check seal (persists while another row is highlighted) -->
                            <Grid x:Name="ChosenBadge" Grid.Column="0" Width="14" Height="14"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Visibility="Collapsed" IsHitTestVisible="False">
                                <Path Stretch="Fill" Data="M7,0 L14,7 L7,14 L0,7 Z"
                                      Fill="{DynamicResource CheckBoxCheckMarkBkBrush}"
                                      Stroke="{DynamicResource TextBrushDark}" StrokeThickness="1" />
                                <ContentControl x:Name="ChosenCheck" Width="8" Height="8"
                                                Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                Foreground="{DynamicResource TextBrushDark}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <ContentPresenter x:Name="ContentHost" Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="LabelSlide" X="0" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ChosenBadge" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ComboHighlightIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.115" />
                                        <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.115">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.115" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ComboHighlightOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource LocalComboBoxToggleButton}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,4,32,4"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{DynamicResource BareTextBox}"
                                 MinHeight="0" Margin="10,4,32,4"
                                 VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 Focusable="True" Background="Transparent"
                                 Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="3"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Control Template="{DynamicResource LocalLedgerMenuBoardTemplate}"
                                         Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                <ScrollViewer Margin="8,11,8,8" SnapsToDevicePixels="True"
                                              CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDown" Property="MinHeight" Value="72" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
