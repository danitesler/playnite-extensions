<!--
    Ditherwake: DefaultControls/ContextMenu.xaml.
    Signature menu panel (LocalLedgerMenuBoardTemplate) shared by ContextMenu, TopPanelMenu, submenus, and ComboBox lists:
    IBM 8503 dark iron-gall ledger board (#212329) with 3.5% 1-bit copperplate stipple (LocalVellumStippleMaskBrush),
    framed in a double-ruled copperplate border (1.5px Vellum Cream outer rule + 2px ink gap + 1px inner rule) with
    four carved corner rosette squares, crowned along the top by a 6px Bayer-dithered woodcut frieze
    (LocalDitherBandMaskBrush) and a hanging top-right Zenith Amber swallowtail bookmark ribbon. Zero DropShadowEffect.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared 1807 E.I.C. Double-Ruled Copperplate Ledger Board Panel Template -->
    <ControlTemplate x:Key="LocalLedgerMenuBoardTemplate" TargetType="{x:Type Control}">
        <Border Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource LocalVellumBrush}"
                BorderThickness="1.5"
                CornerRadius="0"
                Padding="2"
                IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1">
                <Grid ClipToBounds="True">
                    <!-- Subtle 3.5% 1-bit copperplate stipple grain -->
                    <Rectangle Fill="{DynamicResource LocalVellumBrush}" Opacity="0.12"
                               OpacityMask="{DynamicResource LocalVellumStippleMaskBrush}" />

                    <!-- Top 6px Bayer 4x4 ordered-dither woodcut frieze -->
                    <Rectangle Height="6" VerticalAlignment="Top"
                               Fill="{DynamicResource LocalZenithAmberBrush}" Opacity="0.48"
                               OpacityMask="{DynamicResource LocalDitherBandMaskBrush}" />
                    <Rectangle Height="1" VerticalAlignment="Top" Margin="0,6,0,0"
                               Fill="{DynamicResource PopupBorderBrush}" Opacity="0.75" />

                    <!-- Hanging Swallowtail Book-Ribbon Bookmark at top-right -->
                    <Path Width="11" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,14,0"
                          Stretch="Fill" Fill="{DynamicResource LocalZenithAmberBrush}"
                          Data="M0,0 H11 V16 L5.5,12 L0,16 Z" />

                    <!-- Four carved corner woodcut rosette ticks -->
                    <Border Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2"
                            Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource LocalZenithAmberBrush}" BorderThickness="1.2" />
                    <Border Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                            Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource LocalZenithAmberBrush}" BorderThickness="1.2" />
                    <Border Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2"
                            Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource LocalZenithAmberBrush}" BorderThickness="1.2" />
                    <Border Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2"
                            Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource LocalZenithAmberBrush}" BorderThickness="1.2" />
                </Grid>
            </Border>
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="MinWidth" Value="224" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalLedgerMenuBoardTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ScrollViewer Margin="8,11,8,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle"
                                            Grid.IsSharedSizeScope="True" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
