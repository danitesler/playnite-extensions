<!--
    Ditherwake: Views/Sidebar.xaml.
    44px 1807 E.I.C. Ledger Spine & Pocket-Watch Rail: crowned by a 44x50 Vellum Cream watch-bezel main menu tile
    (PART_ElemMainMenu) with a 4px Zenith Amber collar, inset double-ruled copperplate keyline, and the
    Ditherwake Watch-Compass Emblem in iron-gall ink; closed on the right by a double-ruled copperplate seam
    (1.5px outer rule + 2px ink gap + 1px inner rule), an 8px Bayer-dithered woodcut frieze strip, scrollable
    44x40 sidebar items, and a lower-left compass diamond & "1807 / E.I.C. / LX" engraved registry plaque.
    Turns transparent when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource LocalSidebarBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <DockPanel x:Name="DockContentHolder">
                                <!-- Upper-left 44x50 Memento Mortem Pocket-Watch Crown Tile -->
                                <StackPanel x:Name="TopWatchGroup" DockPanel.Dock="Top" Orientation="Vertical" Margin="0,0,0,6">
                                    <Border x:Name="PART_ElemMainMenu" Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                            BorderThickness="0"
                                            Width="44" Height="50"
                                            Padding="0" Cursor="Hand"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Grid>
                                            <Border x:Name="MenuHoverFill"
                                                    Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                            <Border x:Name="MenuInnerRule" Margin="3"
                                                    BorderBrush="{DynamicResource MainMenuButtonForegroundBrush}"
                                                    BorderThickness="1" IsHitTestVisible="False" />
                                            <Control x:Name="MenuMark" Width="24" Height="24"
                                                     Template="{DynamicResource BrandMarkTemplate}"
                                                     Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Lower E.I.C. 1807 Registry Cartouche & Compass Diamond -->
                                <StackPanel x:Name="RailFootStack" DockPanel.Dock="Bottom" Orientation="Vertical"
                                            Margin="0,6,3,10" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <Path Width="8" Height="8" Margin="0,0,0,6" Stretch="Fill"
                                          Data="M4,0 L8,4 L4,8 L0,4 Z"
                                          Stroke="{DynamicResource LocalZenithAmberBrush}" StrokeThickness="1.3"
                                          Fill="{DynamicResource ShellBackgroundBrush}" />
                                    <Border Width="32" Padding="2,4"
                                            Background="{DynamicResource PopupBackgroundBrush}"
                                            BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="1807&#x0a;E.I.C.&#x0a;LX"
                                                   FontFamily="{DynamicResource MonospaceFontFamily}"
                                                   FontSize="8.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrushDarker}"
                                                   TextAlignment="Center" LineHeight="11" />
                                    </Border>
                                </StackPanel>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Background" Value="Transparent" TargetName="PART_ElemMainMenu" />
                            <Setter Property="BorderThickness" Value="0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuInnerRule" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="MenuMark" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootStack" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" TargetName="MenuMark" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="MenuHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="TopWatchGroup" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="TopWatchGroup" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootStack" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,136,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="TopWatchGroup" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="TopWatchGroup" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootStack" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
