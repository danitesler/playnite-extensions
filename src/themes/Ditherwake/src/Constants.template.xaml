<!--
    Ditherwake: Constants.xaml template (Return of the Obra Dinn-inspired 1-bit pixelated duotone theme).
    scripts/build-theme.ps1 renders tokens.css placeholders into Constants.xaml.
    Strict Macintosh 1-bit duotone palette: deep olive-ink (#333319 / #2A2A14 / #222210) and pale cyan-cream (#E5FFFF),
    with chunky 2px Bayer 1-bit dithering, 0px pixel corners, and pure 1-bit inversion states.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Pixelify Sans static OFL TTF bundled in src/Typography/ + Consolas monospace) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">22</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">Consolas</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Pixelify Sans, Pixelify Sans, Consolas</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Game page metadata pane defaults (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape & radii: strict 0px pixel-sharp 1-bit Macintosh / Obra Dinn corners -->
    <Thickness x:Key="PopupBorderThickness">1.5</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{od-vellum}}</Color>
    <Color x:Key="TextColorDarker">{{od-vellum-muted}}</Color>
    <Color x:Key="TextColorDark">{{od-ink-void}}</Color>
    <Color x:Key="MainColor">{{od-slate-surface}}</Color>
    <Color x:Key="MainColorDark">{{od-slate-ledger}}</Color>
    <Color x:Key="HoverColor">{{od-slate-hover}}</Color>
    <Color x:Key="GlyphColor">{{od-zenith-amber}}</Color>
    <Color x:Key="HighlightGlyphColor">{{od-zenith-wash}}</Color>
    <Color x:Key="PopupBackgroundColor">{{od-slate-ledger}}</Color>
    <Color x:Key="PopupBorderColor">{{od-border-strong}}</Color>
    <Color x:Key="BackgroundToneColor">{{od-ink-void}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{od-border}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{od-border}}</Color>
    <Color x:Key="DataChangeNotifColor">{{od-comm-cyan}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{od-border-strong}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{od-slate-ledger}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{od-slate-surface}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{od-rating-pos}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{od-rating-neg}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{od-rating-mix}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{od-slate-ledger}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{od-ink-void}}" />

    <!-- Shell, Chrome & Game Page Brushes -->
    <SolidColorBrush x:Key="LocalSidebarBackgroundBrush" Color="{{od-sidebar-bg}}" />
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{od-ink-void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{od-ink-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{od-ink-void}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{od-ink-void}}" />
    <!-- Solid iron-gall midnight etching ground for banner darkening (no alpha) -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{od-banner-tint}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{od-ink-void}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{od-ink-void}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{od-slate-ledger}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{od-slate-surface}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{od-border-strong}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{od-ink-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{od-vellum-bright}}" />

    <!-- Obra Dinn Structural & Monitor Phosphor Accent Brushes (Local* + shared Stripe roles) -->
    <SolidColorBrush x:Key="StripeBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="StripeAltBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="StripeDeepBrush" Color="{{od-border-strong}}" />
    <SolidColorBrush x:Key="StripeAccentBrush" Color="{{od-comm-cyan}}" />
    <SolidColorBrush x:Key="LocalVellumBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="LocalVellumBrightBrush" Color="{{od-vellum-bright}}" />
    <SolidColorBrush x:Key="LocalVellumDimBrush" Color="{{od-vellum-dim}}" />
    <SolidColorBrush x:Key="LocalZenithAmberBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="LocalZenithDeepBrush" Color="{{od-zenith-deep}}" />
    <SolidColorBrush x:Key="LocalZenithWashBrush" Color="{{od-zenith-wash}}" />
    <SolidColorBrush x:Key="LocalMacFlashBrush" Color="{{od-mac-flash}}" />
    <SolidColorBrush x:Key="LocalCommCyanBrush" Color="{{od-comm-cyan}}" />
    <SolidColorBrush x:Key="LocalRunningHighlightBrush" Color="{{od-ibm-phosphor}}" />
    <SolidColorBrush x:Key="LocalDangerBrightBrush" Color="{{od-wax-red-hi}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{od-ink-void}}" />

    <!-- State Brushes: 1-Bit Vellum Cream inversion for library rows & menus; Brass wash for Settings tree; IBM 5151 Green for running -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{od-zenith-wash}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{od-zenith-hover}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{od-ink-void}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{od-slate-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{od-border-strong}}" />
    <!-- Dedicated IBM 5151 Phosphor Emerald running indicator (distinct from Vellum, Zenith Amber, Commodore Cyan, Wax Red) -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{od-ibm-green}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{od-comm-cyan}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{od-comm-halo}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{od-ink-void}}" />

    <!-- Button Brushes: Vellum Cream copperplate plaque -> Zenith Amber hover -> Macintosh Cyan-White press flash -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{od-vellum-bright}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{od-vellum-bright}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{od-slate-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{od-slate-press}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{od-border-strong}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{od-mac-flash}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{od-zenith-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{od-ink-void}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{od-slate-surface}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{od-border-strong}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{od-slate-hover}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{od-slate-press}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{od-vellum}}" />

    <!-- Input & Control Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{od-slate-ledger}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{od-slate-surface}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{od-border-strong}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{od-border-strong}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{od-slate-surface}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{od-slate-surface}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{od-border-strong}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{od-slate-ledger}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{od-border-strong}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{od-vellum-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{od-slate-ledger}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{od-zenith-amber}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{od-slate-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{od-vellum-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{od-ink-void}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{od-slate-surface}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{od-vellum}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{od-comm-cyan}}" />
</ResourceDictionary>
