<!--
    Ditherwake: DerivedStyles/WindowBarButton.xaml (dialog title bar caption buttons).
    44x40 copperplate keys matched to StandardWindowStyle's 44px band (40px above 4px double rule).
    Hover fills stippled slate with Zenith Amber glyph; Close ("r") stamps E.I.C. Sealing-Wax Crimson.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="WindowBarButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter x:Name="Glyph"
                                          Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{DynamicResource IconWindowClose}"
                                          ContentTemplate="{DynamicResource IconTemplate}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="0">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMinimize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Content" Value="{DynamicResource IconWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Content" Value="r">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalZenithAmberBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="Content" Value="r" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource LocalVellumBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
