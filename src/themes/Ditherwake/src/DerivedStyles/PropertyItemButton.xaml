<!--
    Ditherwake: DerivedStyles/PropertyItemButton.xaml.
    Commodore 1084 Cyan maritime glossary link by default (lights Zenith Amber on hover); inside Tag="Chip" WrapPanels
    renders as a notched book-ribbon index slip (#2E3037 slate fill, 1px copperplate border, 3px Zenith Amber left
    binding stitch, CornerRadius="{DynamicResource ControlCornerRadius}") inverting in 1-bit style to solid
    Vellum Cream (#EBE5CE) with #18191D iron-gall ink on hover.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="LinkText" Foreground="{TemplateBinding Foreground}"
                               TextWrapping="Wrap" VerticalAlignment="Center">
                        <ContentPresenter />
                    </TextBlock>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LocalZenithAmberBrush}" />
                            <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ChipPlate" Background="{DynamicResource PropertyItemBackgroundBrush}"
                                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Height="22" SnapsToDevicePixels="True">
                                <Grid ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3.5" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle x:Name="ChipStitch" Grid.Column="0"
                                               Fill="{DynamicResource LocalZenithAmberBrush}" />
                                    <Border x:Name="ChipHoverFill" Grid.Column="0" Grid.ColumnSpan="2"
                                            CornerRadius="0" Background="{DynamicResource PropertyItemHoverBackgroundBrush}"
                                            Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                    <Rectangle x:Name="ChipHoverStitch" Grid.Column="0"
                                               Fill="{DynamicResource TextBrushDark}"
                                               Visibility="Collapsed" IsHitTestVisible="False" />
                                    <ContentPresenter Grid.Column="1" Margin="6,0,8,0"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipPlate" Property="BorderBrush" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                                    <Setter TargetName="ChipHoverStitch" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="ChipHoverIn">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipHoverFill" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="ChipHoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard x:Name="ChipHoverOut">
                                            <Storyboard FillBehavior="Stop">
                                                <DoubleAnimation Storyboard.TargetName="ChipHoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipHoverFill" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
