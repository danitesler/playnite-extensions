<!--
    Ditherwake: DerivedStyles/PlayButton.xaml (+ RunningActionIndicator).
    Hero Moment (PlayButton): Memento Mortem Engraved Copperplate Plaque (Height=40, MinWidth=168):
    - Vellum Cream (#EBE5CE) plaque with 1.5px Zenith Deep brass border, inset 1px iron-gall ink keyline,
      left circular Memento Mortem pocket-watch dial emblem, Cinzel Bold #18191D ink label, and "III" fate tally
      (hidden on Tag="ContextAction", IsLaunching, and IsRunning).
    - Hover (gated off during IsLaunching/IsRunning): plaque illuminates to Zenith ZVM 1240 Amber (#FDCA55),
      outer Vellum Bright rim lights, 1-bit Bayer dithered soul-burst (LocalDitherGlintMaskBrush) sweeps across
      the face, and the pocket-watch hands rotate 0 deg -> 30 deg (180ms CubicEase).
    - Press: crisp Macintosh 1-bit cyan-white phosphor flash (#E5FFFF).
    - Launching / Running: plaque fills solid IBM 5151 Phosphor Emerald (#12824A) with Vellum Cream (#EBE5CE) label
      darkened by ScrimBrush RunningBreath (0.44 launching / 0.22..0.42 running -> >= 6.8:1 contrast across all
      frames), swept by 1-bit Bayer-stepped LocalDitherCellsMaskBrush RunningScan (1.6s loop), and framed by
      RunningActionIndicator with copperplate foot rule + Three-Fate Roman Tallies (I · II · III) inside 38px
      right PlayRoom strip.
    - Cancel on hover: single MultiDataTrigger on IsRunning + RelativeSource Self IsMouseOver (never TemplatedParent),
      hiding PlayContent with Visibility="Hidden" so button width never jumps.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinWidth" Value="168" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0,16,0" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Outer illuminated Vellum hover rim (Collapsed at rest) -->
                        <Border x:Name="HoverRim" Margin="-1.5" CornerRadius="0"
                                BorderBrush="{DynamicResource LocalVellumBrightBrush}" BorderThickness="1.5"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                        <!-- Main Copperplate Plaque -->
                        <Border x:Name="PlayFill" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid ClipToBounds="True">
                                <!-- Hover Layer: Zenith ZVM 1240 Amber illumination + 1-bit Bayer dithered soul-burst sweep -->
                                <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Border CornerRadius="0" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                                    <Rectangle x:Name="SoulGlint" Width="156" HorizontalAlignment="Left"
                                               Fill="{DynamicResource LocalVellumBrightBrush}" Opacity="0.76"
                                               OpacityMask="{DynamicResource LocalDitherGlintMaskBrush}">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="SoulSlideX" X="-120" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>

                                <!-- Pressed Layer: Macintosh 1-bit Cyan-White (#E5FFFF) phosphor flash -->
                                <Border x:Name="PressedLayer" CornerRadius="0"
                                        Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Running / Launching plate darkening scrim (keeps Vellum label >= 6.8:1) -->
                                <Border x:Name="RunningBreath" CornerRadius="0"
                                        Background="{DynamicResource ScrimBrush}"
                                        Visibility="Collapsed" Opacity="0.32" IsHitTestVisible="False" />

                                <!-- 1-Bit Bayer-Stepped Launching Sweep (RunningScan masked by LocalDitherCellsMaskBrush) -->
                                <Border x:Name="RunningScanHost" CornerRadius="0"
                                        OpacityMask="{DynamicResource LocalDitherCellsMaskBrush}"
                                        IsHitTestVisible="False">
                                    <Border x:Name="RunningScan" CornerRadius="0"
                                            Background="{DynamicResource LocalRunningHighlightBrush}"
                                            Visibility="Collapsed" Opacity="0.60">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                                <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                                <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                </Border>

                                <!-- Running hover darken scrim under Cancel label (below content) -->
                                <Border x:Name="RunningHoverDim" CornerRadius="0"
                                        Background="{DynamicResource ScrimBrush}"
                                        Opacity="0" IsHitTestVisible="False" />

                                <!-- Inset double-ruled copperplate keyline inside the plaque -->
                                <Border x:Name="InnerCopperRule" Margin="2"
                                        BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1"
                                        Opacity="0.65" IsHitTestVisible="False" />

                                <!-- Label host (PlayRoom reserves 38px right strip while Launching/Running) -->
                                <!-- RunningMarkRoom left="0" right="38" -->
                                <Border x:Name="PlayRoom" Margin="0">
                                    <StackPanel x:Name="PlayContent" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}">
                                        <!-- Memento Mortem Pocket-Watch Dial Seal (rotates hands 0 -> 30 deg on hover) -->
                                        <Border x:Name="WatchDialSeal" Width="22" Height="22" Margin="0,0,9,0"
                                                CornerRadius="11" Background="{DynamicResource TextBrushDark}"
                                                VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                                IsHitTestVisible="False">
                                            <Border.RenderTransform>
                                                <RotateTransform x:Name="WatchDialRotate" Angle="0" />
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Ellipse Margin="2" Stroke="{DynamicResource LocalZenithAmberBrush}" StrokeThickness="1.2" />
                                                <Path Data="M11,11 L7.5,7.2 M11,11 L15.2,8.5"
                                                      Stroke="{DynamicResource LocalZenithAmberBrush}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Grid>
                                        </Border>
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                        <TextBlock x:Name="PlayTally" Text="III" Margin="8,1,0,0"
                                                   FontFamily="{DynamicResource MonospaceFontFamily}"
                                                   FontSize="10" FontWeight="Bold" Opacity="0.72"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </StackPanel>
                                </Border>

                                <!-- Cancel hover label (shown ONLY while IsRunning AND button itself IsMouseOver) -->
                                <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                           FontFamily="{DynamicResource HeadingFontFamily}" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="WatchDialSeal" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayTally" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Idle Hover (gated off during IsLaunching/IsRunning) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SoulSlideX" Storyboard.TargetProperty="X" From="-110" To="55" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="WatchDialRotate" Storyboard.TargetProperty="Angle" To="30" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="WatchDialRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <!-- Pressed Macintosh 1-Bit Cyan-White Flash -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedLayer" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressedLayer" Property="Opacity" Value="1" />
                        </Trigger>

                        <!-- Launching state: IBM 5151 Phosphor Emerald plate + darkened RunningBreath + Bayer-stepped RunningScan -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverRim" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="WatchDialSeal" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayTally" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InnerCopperRule" Property="BorderBrush" Value="{DynamicResource LocalRunningHighlightBrush}" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,38,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,38,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.32" To="0.46" Duration="0:0:0.22" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Running state: IBM 5151 Phosphor Emerald plate + quiet breathing scrim -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverRim" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="WatchDialSeal" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayTally" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InnerCopperRule" Property="BorderBrush" Value="{DynamicResource LocalRunningHighlightBrush}" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,38,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,38,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.22" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.22" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Running + Button Self Hover: show Cancel, hide PlayContent without layout collapse -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="CancelHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="CancelHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalRunningHighlightBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalRunningHighlightBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Game Page Action Overlay: IBM 5151 Phosphor frame + copperplate foot line + Three-Fate Roman Tallies (I · II · III) -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.94" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" CornerRadius="{DynamicResource ControlCornerRadius}"
                                BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5" />
                        <!-- 2px Copperplate Foot Track (5px above bottom edge) -->
                        <Grid Height="2" Margin="10,0,12,5" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.34" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalRunningHighlightBrush}"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <!-- Three-Fate Roman Tallies (I · II · III) on right edge inside PlayRoom -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Height="14">
                            <Rectangle x:Name="TallyBar1" Width="2.5" Height="12" Margin="0,0,3,0"
                                       Fill="{DynamicResource LocalRunningHighlightBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="Tally1ScaleY" ScaleY="0.5" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="TallyBar2" Width="2.5" Height="14" Margin="0,0,3,0"
                                       Fill="{DynamicResource TextBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="Tally2ScaleY" ScaleY="0.9" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="TallyBar3" Width="2.5" Height="12"
                                       Fill="{DynamicResource LocalRunningHighlightBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="Tally3ScaleY" ScaleY="0.6" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.20" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Tally1ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.0" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Tally2ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="1.0" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Tally3ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.20" Value="1.0" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.52" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Tally1ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.95" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.60" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.55" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Tally2ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.95" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.60" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.95" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Tally3ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0.98" KeySpline="0.4,0 0.6,1" />
