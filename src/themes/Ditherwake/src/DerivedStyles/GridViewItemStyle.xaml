<!--
    Ditherwake: DerivedStyles/GridViewItemStyle.xaml (Engraved Crew Portrait Cover Tiles).
    - Hover (IsMouseOver): smooth 1.02 lift (ControlTemplate.Triggers RenderTransform) + Zenith Amber copperplate
      inner rule and top woodcut frieze bar illuminating from center (140ms CubicEase).
    - Click / Selection (IsSelected): signature E.I.C. Logbook Portrait Frame — bold Vellum Cream (#EBE5CE) outer
      border + inset Zenith Amber (#FDCA55) rule with four carved corner rosette squares and a hanging top-right
      Zenith Amber swallowtail bookmark ribbon (160ms CubicEase).
    - RunningIndicator (Margin="4" inset): IBM 5151 Phosphor Emerald frame + wash + Bayer-stepped RunningScan + 16px
      bottom ledger tape holding RunningFill + Three-Fate Roman Tallies (I · II · III).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="TileRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <ContentPresenter />

                        <!-- Hover Overlay: Zenith Amber copperplate border & top frieze bar -->
                        <Grid x:Name="HoverOverlay" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Margin="1" CornerRadius="6"
                                    BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" BorderThickness="1.5" />
                            <Border x:Name="HoverTopBar" Height="3" Margin="18,1,18,0" VerticalAlignment="Top"
                                    CornerRadius="0" Background="{DynamicResource LocalZenithAmberBrush}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="HoverBarScaleX" ScaleX="0.35" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <!-- Selected Overlay: Double-Ruled Vellum & Zenith Amber Portrait Frame + 4 Corner Rosettes + Swallowtail Bookmark Ribbon -->
                        <Grid x:Name="SelectedOverlay" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Margin="0" CornerRadius="6"
                                    BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" BorderThickness="2" />
                            <Border Margin="3" CornerRadius="0"
                                    BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1" />
                            <!-- Four carved corner rosette squares -->
                            <Border Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2"
                                    Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1.3" />
                            <Border Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                                    Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1.3" />
                            <Border Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2"
                                    Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1.3" />
                            <Border Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2"
                                    Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1.3" />
                            <!-- Hanging Swallowtail Book-Ribbon Bookmark at top-right -->
                            <Path Width="12" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,12,0"
                                  Stretch="Fill" Fill="{DynamicResource SelectedBorderBrush}"
                                  Data="M0,0 H12 V18 L6,13.5 L0,18 Z" />
                        </Grid>

                        <!-- Running / Launching IBM 5151 Phosphor Emerald Indicator (Margin="4" inset above selection/hover) -->
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.94"
                              IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" CornerRadius="0"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.18" />
                            <!-- Bayer-stepped scan sweep -->
                            <Border CornerRadius="0" OpacityMask="{DynamicResource LocalDitherCellsMaskBrush}">
                                <Border x:Name="RunningScan" Visibility="Collapsed" CornerRadius="0"
                                        Background="{DynamicResource LocalRunningHighlightBrush}" Opacity="0.34">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </Border>
                            <!-- 16px Footer Ledger Tape inside cover frame -->
                            <Border Height="16" VerticalAlignment="Bottom" Margin="1.5" CornerRadius="0,0,3,3"
                                    Background="{DynamicResource ShellBackgroundBrush}" Opacity="0.86">
                                <Grid Margin="6,0,6,0">
                                    <Grid Height="2" VerticalAlignment="Center" Margin="0,0,22,0">
                                        <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.34" />
                                        <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalRunningHighlightBrush}"
                                                   RenderTransformOrigin="0,0.5">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                    <!-- Three-Fate Roman Tallies (I · II · III) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="10">
                                        <Rectangle x:Name="CovTally1" Width="2" Height="9" Margin="0,0,2,0"
                                                   Fill="{DynamicResource LocalRunningHighlightBrush}" RenderTransformOrigin="0.5,0.5">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="CovTally1ScaleY" ScaleY="0.5" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Rectangle x:Name="CovTally2" Width="2" Height="10" Margin="0,0,2,0"
                                                   Fill="{DynamicResource TextBrush}" RenderTransformOrigin="0.5,0.5">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="CovTally2ScaleY" ScaleY="0.9" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Rectangle x:Name="CovTally3" Width="2" Height="9"
                                                   Fill="{DynamicResource LocalRunningHighlightBrush}" RenderTransformOrigin="0.5,0.5">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="CovTally3ScaleY" ScaleY="0.6" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="RunningFrame" CornerRadius="0"
                                    BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CoverHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="HoverBarScaleX" Storyboard.TargetProperty="ScaleX" From="0.35" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CoverHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CoverSelectIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CoverSelectOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.20" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovTally1ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.0" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovTally2ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="1.0" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovTally3ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.20" Value="1.0" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovTally1ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.92" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.5" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovTally2ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.92" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.92" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovTally3ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0.95" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.6" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
