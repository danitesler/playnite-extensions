<!--
    Ditherwake: Common.xaml — spacing keys, shared white-mask 1-bit Bayer dither FX ImageBrushes,
    and 1807 copperplate structural templates (BrandMarkTemplate, DividerTemplate, EmptyGameTemplate,
    SteamScreenshotsSkeletonTemplate, HeadingTextBlock, LocalNotesTextBox, SecondaryButton).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Spacing & Metric Keys (per repo FormControlHeight & Menu rules) -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>                <!-- Standard 32px inputs, combos, buttons -->
    <sys:Double x:Key="IconSize">16</sys:Double>                     <!-- Compact rail and top bar glyphs -->
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>            <!-- Default woodcut chapter banner height (0..600) -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>              <!-- Default banner darkening slider (0..1) -->
    <Thickness x:Key="ButtonPadding">14,5</Thickness>                <!-- 1px border + 5px v-pad = 32px -->
    <Thickness x:Key="InputPadding">9,5</Thickness>                  <!-- TextBox / PasswordBox / ComboBox -->
    <Thickness x:Key="MenuPadding">8,12,8,8</Thickness>              <!-- Copperplate ledger menu board inset -->
    <Thickness x:Key="MenuItemPadding">8,4</Thickness>               <!-- Compact 30px menu rows -->
    <Thickness x:Key="ComboBoxDropDownPadding">8,12,8,8</Thickness>  <!-- Copperplate ledger ComboBox popup inset -->
    <Thickness x:Key="ComboBoxItemPadding">8,4</Thickness>           <!-- 30px ComboBox rows -->
    <Thickness x:Key="ListBoxItemPadding">10,5</Thickness>           <!-- ListBox rows -->
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>       <!-- Double-ruled copperplate GroupBox inset -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>               <!-- Copperplate ledger tooltip inset -->

    <!-- Shared White-Mask 1-Bit Bayer Dither FX ImageBrushes (NearestNeighbor pixel-crisp, recolored live by ThemeModifier) -->
    <ImageBrush x:Key="LocalDitherBandMaskBrush" ImageSource="{ThemeFile 'Images/fx/dither-band.png'}"
                RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
    <ImageBrush x:Key="LocalDitherGlintMaskBrush" ImageSource="{ThemeFile 'Images/fx/dither-glint.png'}"
                RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
    <ImageBrush x:Key="LocalVellumStippleMaskBrush" ImageSource="{ThemeFile 'Images/fx/vellum-stipple.png'}"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalDitherCellsMaskBrush" ImageSource="{ThemeFile 'Images/fx/dither-cells.png'}"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalDitherCellsTightMaskBrush" ImageSource="{ThemeFile 'Images/fx/dither-cells.png'}"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Stretch="Fill" />

    <!-- Popup Border -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard Focus Visual (Commodore 1084 Cyan double-ruled copperplate outline) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="1.5" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Original Brand Mark: Ditherwake Watch-Compass Emblem (uses Foreground brush) -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="64" Height="64">
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M23,9 A9,6.5 0 0,1 41,9 H37.8 A5.8,4 0 0,0 26.2,9 Z" />
                <Rectangle Canvas.Left="28.5" Canvas.Top="7.5" Width="7" Height="4.5" RadiusX="1" RadiusY="1"
                           Fill="{TemplateBinding Foreground}" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="F0 M21,12 H43 L52,21 V43 L43,52 H21 L12,43 V21 Z M23,16 L16,23 V41 L23,48 H41 L48,41 V23 L41,16 Z" />
                <Rectangle Canvas.Left="30.5" Canvas.Top="17.5" Width="3" Height="3.5" Fill="{TemplateBinding Foreground}" />
                <Rectangle Canvas.Left="30.5" Canvas.Top="43" Width="3" Height="3.5" Fill="{TemplateBinding Foreground}" />
                <Rectangle Canvas.Left="17.5" Canvas.Top="30.5" Width="3.5" Height="3" Fill="{TemplateBinding Foreground}" />
                <Rectangle Canvas.Left="43" Canvas.Top="30.5" Width="3.5" Height="3" Fill="{TemplateBinding Foreground}" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="F0 M32,21.5 L34.6,29.4 L42.5,32 L34.6,34.6 L32,42.5 L29.4,34.6 L21.5,32 L29.4,29.4 Z M32,29.5 A2.5,2.5 0 1,0 32,34.5 A2.5,2.5 0 1,0 32,29.5 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M22.5,24.5 L24.5,22.5 L32,30 L30,32 Z M40.5,23.5 L42.2,25.5 L33.5,32.5 L31.8,30.5 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Copperplate Compass-Diamond & Bayer Stipple Divider -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="10" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center" Margin="0,0,6,0"
                       Fill="{DynamicResource MenuSeparatorBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle Width="2" Height="2" VerticalAlignment="Center" Fill="{DynamicResource LocalZenithAmberBrush}" Opacity="0.7" />
                <Path Width="7" Height="7" Margin="4,0" Stretch="Fill"
                      Data="M3.5,0 L7,3.5 L3.5,7 L0,3.5 Z"
                      Stroke="{DynamicResource LocalZenithAmberBrush}" StrokeThickness="1.2"
                      Fill="{DynamicResource ShellBackgroundBrush}" />
                <Rectangle Width="2" Height="2" VerticalAlignment="Center" Fill="{DynamicResource LocalZenithAmberBrush}" Opacity="0.7" />
            </StackPanel>
            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Margin="6,0,0,0"
                       Fill="{DynamicResource MenuSeparatorBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Designed Empty Game Page State (Falmouth Anchorage Manifest & Memento Mortem Cartouche) -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Outer double-ruled copperplate frame -->
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource LocalVellumBrush}" BorderThickness="1.5"
                    CornerRadius="0" Padding="3" MinWidth="320" MaxWidth="420">
                <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                    <Grid ClipToBounds="True">
                        <!-- Crisp 1-bit Bayer stipple texture -->
                        <Rectangle Fill="{DynamicResource LocalVellumBrush}" Opacity="0.12"
                                   OpacityMask="{DynamicResource LocalVellumStippleMaskBrush}" />

                        <!-- Top 8px Bayer-dithered horizon frieze -->
                        <Rectangle Height="8" VerticalAlignment="Top"
                                   Fill="{DynamicResource LocalVellumBrush}" Opacity="0.85"
                                   OpacityMask="{DynamicResource LocalDitherBandMaskBrush}" />

                        <!-- Four carved corner rosette ticks -->
                        <Border Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource LocalZenithAmberBrush}" BorderThickness="1.2" />
                        <Border Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource LocalZenithAmberBrush}" BorderThickness="1.2" />
                        <Border Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource LocalZenithAmberBrush}" BorderThickness="1.2" />
                        <Border Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource LocalZenithAmberBrush}" BorderThickness="1.2" />

                        <StackPanel Margin="26,24,26,22" HorizontalAlignment="Center">
                            <Grid Width="76" Height="76" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Ellipse x:Name="EmptyWatchHalo" Stroke="{DynamicResource LocalZenithAmberBrush}"
                                         StrokeThickness="1.5" StrokeDashArray="3 2" Opacity="0.55" />
                                <Border Margin="9" CornerRadius="0"
                                        Background="{DynamicResource ShellBackgroundBrush}"
                                        BorderBrush="{DynamicResource LocalVellumBrush}" BorderThickness="1.2" />
                                <Control Width="36" Height="36"
                                         Template="{DynamicResource BrandMarkTemplate}"
                                         Foreground="{DynamicResource LocalZenithAmberBrush}" />
                            </Grid>

                            <!-- Three-Fate Roman Tally Pips (I · II · III) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Rectangle x:Name="EmptyTally1" Width="3" Height="10" Fill="{DynamicResource LocalZenithAmberBrush}" />
                                <Rectangle x:Name="EmptyTally2" Width="3" Height="12" Margin="5,0,0,0" Fill="{DynamicResource LocalVellumBrush}" />
                                <Rectangle x:Name="EmptyTally3" Width="3" Height="10" Margin="5,0,0,0" Fill="{DynamicResource LocalZenithAmberBrush}" />
                            </StackPanel>

                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       FontSize="{DynamicResource FontSizeLarger}"
                                       Foreground="{DynamicResource HeadingForegroundBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="EmptyWatchIdle">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyWatchHalo" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.90" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.35" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyTally1" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyTally2" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.45" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyTally3" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.6" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyWatchIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SteamScreenshots Plugin Loading Skeleton (Copperplate woodcut sketch frames) -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Height="196" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource LocalVellumBrush}" BorderThickness="1.5"
                    CornerRadius="0" Padding="2" Margin="0,0,0,8">
                <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                    <Grid ClipToBounds="True">
                        <Rectangle Fill="{DynamicResource LocalVellumBrush}" Opacity="0.12"
                                   OpacityMask="{DynamicResource LocalVellumStippleMaskBrush}" />
                        <Rectangle Height="5" VerticalAlignment="Top"
                                   Fill="{DynamicResource LocalZenithAmberBrush}" Opacity="0.4"
                                   OpacityMask="{DynamicResource LocalDitherBandMaskBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7">
                            <Rectangle Width="3" Height="12" Fill="{DynamicResource LocalZenithAmberBrush}" />
                            <Rectangle Width="3" Height="14" Margin="5,0,0,0" Fill="{DynamicResource LocalVellumBrush}" />
                            <Rectangle Width="3" Height="12" Margin="5,0,0,0" Fill="{DynamicResource LocalZenithAmberBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
            <UniformGrid Columns="4">
                <Border Height="48" Margin="0,0,6,0" CornerRadius="0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.85" />
                <Border Height="48" Margin="0,0,6,0" CornerRadius="0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.72" />
                <Border Height="48" Margin="0,0,6,0" CornerRadius="0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.85" />
                <Border Height="48" CornerRadius="0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.72" />
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- Game Page Section Heading (Cinzel engraved capitals in Vellum Bright) -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Read-only Notes TextBox (double-ruled copperplate ledger reading well) -->
    <Style x:Key="LocalNotesTextBox" TargetType="TextBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0">
                        <Grid>
                            <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource LocalVellumBrush}" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0,0,0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Game Page Secondary Action Button (40x40 Double-Ruled Copperplate Square Plate) -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Border x:Name="HoverFill" CornerRadius="0"
                                        Background="{DynamicResource SecondaryButtonHoverBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="PressFill" CornerRadius="0"
                                        Background="{DynamicResource SecondaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <!-- Inset copperplate rule -->
                                <Border x:Name="InnerRule" Margin="2" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                                        BorderThickness="1" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource LocalZenithAmberBrush}" />
                            <Setter TargetName="InnerRule" Property="BorderBrush" Value="{DynamicResource LocalVellumBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalZenithAmberBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecBtnHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecBtnHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressFill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressFill" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a pocket watch, ring and crown in vellum ink with three menu bars on its face. Hover: the crown presses in and an amber hand ticks a quarter turn with a small overshoot. Open (ContextMenu.IsOpen of the nearest Border): a ring of eight 1-bit pixels radiates outward from the watch and fades, over and over, until the menu closes. -->
    <ControlTemplate x:Key="LocalDitherwakeMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Canvas Width="26" Height="26" RenderTransformOrigin="0.5,0.53">
                    <Canvas.RenderTransform><ScaleTransform x:Name="WaveScale" ScaleX="0.7" ScaleY="0.7" /></Canvas.RenderTransform>
                    <Canvas x:Name="Wave" Opacity="0"><Rectangle Canvas.Left="22.73" Canvas.Top="17.36" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="16.56" Canvas.Top="23.53" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="7.84" Canvas.Top="23.53" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="1.67" Canvas.Top="17.36" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="1.67" Canvas.Top="8.64" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="7.84" Canvas.Top="2.47" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="16.56" Canvas.Top="2.47" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="22.73" Canvas.Top="8.64" Width="1.6" Height="1.6" Fill="{TemplateBinding Foreground}" /></Canvas>
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="CrownPress" Y="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="11" Canvas.Top="2" Width="4" Height="2.8" Fill="{TemplateBinding Foreground}" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Ellipse Canvas.Left="5" Canvas.Top="5.800000000000001" Width="16" Height="16" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" />
                    <Rectangle Canvas.Left="8.5" Canvas.Top="10.6" Width="9" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="8.5" Canvas.Top="13.2" Width="9" Height="1.6" Fill="{TemplateBinding Foreground}" /><Rectangle Canvas.Left="8.5" Canvas.Top="15.8" Width="9" Height="1.6" Fill="{TemplateBinding Foreground}" />
                </Canvas>
                <Canvas Width="26" Height="26" RenderTransformOrigin="0.5,0.531" Opacity="1">
                    <Canvas.RenderTransform><RotateTransform x:Name="HandTurn" Angle="0" /></Canvas.RenderTransform>
                    <Path x:Name="Hand" Data="M13,13.8 L13,7.6" Stroke="{DynamicResource LocalZenithAmberBrush}" StrokeThickness="1.4" Opacity="0" />
                </Canvas>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hand" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HandTurn" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CrownPress" Storyboard.TargetProperty="Y" To="1.6" Duration="0:0:0.1"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Hand" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HandTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CrownPress" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
