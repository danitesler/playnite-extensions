<!--
    Ditherwake: Media.xaml — Pixelarticons 2.4.1 (MIT, info/LICENSE-pixelarticons.txt) 24x24 pixel-grid icon pack
    for all Playnite chrome geometries and menu PNG icons, keeping Ditherwake's original Watch-Compass IconMainMenu.
    Rendered aliased (RenderOptions.EdgeMode="Aliased") for authentic 1-bit pixelated Return of the Obra Dinn crispness.
    icons.json lists all Pixelarticons sources and tokens for scripts/render-icons.ps1.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Pixel-Aliased Icon DataTemplates -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox MaxWidth="{DynamicResource IconSize}" MaxHeight="{DynamicResource IconSize}" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" RenderOptions.EdgeMode="Aliased"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox MaxWidth="12" MaxHeight="12" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" RenderOptions.EdgeMode="Aliased"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" RenderOptions.EdgeMode="Aliased"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileSolidTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" RenderOptions.EdgeMode="Aliased"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource IconSearch}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource IconClear}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

