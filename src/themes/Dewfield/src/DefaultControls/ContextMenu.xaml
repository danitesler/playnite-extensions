<!--
    Dewfield: DefaultControls/ContextMenu.xaml.
    Menu Signature (docs/themes/menus.md):
    - Panel (LocalNoticeBoardTemplate): Pinned Notice-Board cream parchment slip (#FFF2CC) framed in a
      3-step carved cedar wood bevel (#5B2B2A / #B14E05 / #DC7B05 / #853605) with subtle 4% parchment grain,
      crowned at top-center by a steel thumbtack pin (#8A9CA8) drawn from Stardew's calendar notice board.
    - Shared across ContextMenu, TopPanelMenu, submenus, and ComboBox popups via LocalNoticeBoardTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Pinned Notice-Board Popup Board (hosted by ContextMenu, Submenu Popup, ComboBox Popup) -->
    <ControlTemplate x:Key="LocalNoticeBoardTemplate" TargetType="{x:Type Control}">
        <Grid Margin="0,5,0,0" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Outer mahogany outline + 3-step carved cedar bevel + cream parchment interior -->
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="2"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border BorderBrush="{DynamicResource LocalCedarBrush}" BorderThickness="2">
                    <Grid>
                        <Control Template="{DynamicResource LocalParchmentGrainTemplate}"
                                 Foreground="{DynamicResource LocalCedarShadowBrush}" Opacity="0.05"
                                 Focusable="False" IsHitTestVisible="False" />
                        <Border BorderBrush="{DynamicResource LocalCedarHiBrush}" BorderThickness="1.5,1.5,0,0" />
                        <Border BorderBrush="{DynamicResource LocalCedarShadowBrush}" BorderThickness="0,0,1.5,1.5" />
                    </Grid>
                </Border>
            </Border>
            <!-- Centered Calendar Steel Thumbtack Pin rising 5px above the top wood frame -->
            <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-5,0,0">
                <Ellipse Fill="{DynamicResource LocalThumbtackBrush}"
                         Stroke="{DynamicResource PopupBorderBrush}" StrokeThickness="1.8" />
                <Ellipse Width="5" Height="5" Margin="-3,-3,0,0"
                         Fill="{DynamicResource LocalCreamHiBrush}" Opacity="0.9" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource MenuPadding}" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid Grid.IsSharedSizeScope="True" MinWidth="{TemplateBinding MinWidth}" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalNoticeBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,5,0,0" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
