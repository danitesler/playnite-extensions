<!--
    Dewfield: DefaultControls/Menu.xaml.
    Menu Signature (docs/themes/menus.md):
    - Rows: Compact 30px height, fixed 26px icon column, plain * label column, shared shortcut column, right-edge arrow.
    - Highlight: Sun-amber wooden plank (#F2A844) with mahogany rim + cream top catchlight fades in (110ms) while
      a 7px mahogany pixel pointer slides in from the left and the label nudges 2px right; icon Foreground updates cleanly.
    - Group break: 10px cedar fence-post knot rule (4px rotated cedar diamond knots flanking a 1.5px cedar rail).
    - Shortcuts: Sunken hotbar-slot wood keycaps (#F2BE72, Consolas monospace, flip to cream cap on highlight).
    - Marked rows: Exit (Alt+Q) wears Crimson Red-X label/keycap at rest and solid Crimson plank (#B8240E) with cream ink
      and cream icon on highlight (5.94:1); checked rows show a 14x14 Harvest Meadow-Green square box with cream pixel check.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group Break: Cedar Fence-Post Knot Rule (max 12px tall) -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="26,0,8,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="6" Height="6" Stretch="Fill" VerticalAlignment="Center"
                              Data="M 3,0 L 6,3 L 3,6 L 0,3 Z" Fill="{DynamicResource LocalCedarBrush}" />
                        <Rectangle Grid.Column="1" Height="1.5" Margin="4,0" VerticalAlignment="Center"
                                   Fill="{DynamicResource PanelSeparatorBrush}" />
                        <Path Grid.Column="2" Width="6" Height="6" Stretch="Fill" VerticalAlignment="Center"
                              Data="M 3,0 L 6,3 L 3,6 L 0,3 Z" Fill="{DynamicResource LocalCedarBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SubmenuItemTemplateKey (Plain 30px Menu Row) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated Sun-Amber Wooden Plank Highlight (collapsed at rest) -->
            <Border x:Name="HighlightPlate" Background="{DynamicResource MenuItemHoverBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Grid>
                    <Border x:Name="HighlightBevelHi" BorderBrush="{DynamicResource LocalCreamHiBrush}"
                            BorderThickness="0,1.2,0,0" />
                    <Border x:Name="HighlightBevelLo" BorderBrush="{DynamicResource LocalCedarHiBrush}"
                            BorderThickness="0,0,0,1.2" />
                </Grid>
            </Border>

            <!-- Sliding 6px Pixel Pointer Arrow (left edge, clear of icon column) -->
            <Path x:Name="PointerArrow" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                  Width="6" Height="9" Stretch="Fill" Data="M 0,0 L 6,4.5 L 0,9 Z"
                  Fill="{DynamicResource SelectedForegroundBrush}" Visibility="Collapsed" Opacity="0"
                  IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="PointerShift" X="-6" />
                </Path.RenderTransform>
            </Path>

            <Grid Margin="13,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <!-- Fixed Icon / Check Column -->
                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                  ContentSource="Icon"
                                  TextElement.Foreground="{DynamicResource TextBrushDarker}" />
                <Border x:Name="CheckBoxWell" Grid.Column="0" Width="14" Height="14"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                        Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                        CornerRadius="{DynamicResource CornerRadiusSmall}" Visibility="Collapsed">
                    <ContentControl Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                    Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                                    Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                </Border>

                <!-- Label Column (plain *, trims cleanly) -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Sunken Hotbar-Slot Shortcut Keycap -->
                <Border x:Name="ShortcutCap" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                        Padding="5,1" Background="{DynamicResource NormalBrushDark}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusSmall}">
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11"
                               Foreground="{DynamicResource TextBrushDarker}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckBoxWell" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutCap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutCap" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!-- Exit (Alt+Q) resting Danger styling -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Trigger>

            <!-- Animated Highlight -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="ShortcutCap" Property="Background" Value="{DynamicResource LocalCreamBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard Name="MenuHiIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerArrow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="PointerArrow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="PointerShift" Storyboard.TargetProperty="X" From="-6" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Name="MenuHiOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="PointerArrow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="PointerShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerArrow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Exit (Alt+Q) Highlighted: Solid Crimson plank + Cream text & icon (5.94:1 contrast) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HighlightPlate" Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="HighlightBevelHi" Property="BorderBrush" Value="{DynamicResource LocalCrimsonHiBrush}" />
                <Setter TargetName="HighlightBevelLo" Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                <Setter TargetName="PointerArrow" Property="Fill" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutCap" Property="Background" Value="{DynamicResource NormalBorderBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeaderTemplateKey (30px Submenu Row + Pinned Notice-Board Child Popup) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held Plate while Submenu is Open (no flicker) -->
            <Border x:Name="OpenPlate" Background="{DynamicResource MenuItemHoverBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border BorderBrush="{DynamicResource LocalCreamHiBrush}" BorderThickness="0,1.2,0,0" />
            </Border>

            <!-- Animated Highlight Plate -->
            <Border x:Name="HighlightPlate" Background="{DynamicResource MenuItemHoverBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Grid>
                    <Border BorderBrush="{DynamicResource LocalCreamHiBrush}" BorderThickness="0,1.2,0,0" />
                    <Border BorderBrush="{DynamicResource LocalCedarHiBrush}" BorderThickness="0,0,0,1.2" />
                </Grid>
            </Border>

            <!-- Sliding 6px Pixel Pointer Arrow -->
            <Path x:Name="PointerArrow" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                  Width="6" Height="9" Stretch="Fill" Data="M 0,0 L 6,4.5 L 0,9 Z"
                  Fill="{DynamicResource SelectedForegroundBrush}" Visibility="Collapsed" Opacity="0"
                  IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="PointerShift" X="-6" />
                </Path.RenderTransform>
            </Path>

            <Grid Margin="13,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                  ContentSource="Icon"
                                  TextElement.Foreground="{DynamicResource TextBrushDarker}" />

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <ContentControl x:Name="SubArrow" Grid.Column="3" Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource GlyphBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False" />
            </Grid>

            <!-- Child Submenu Popup (aligned vertically for the 5px thumbtack margin + 12px top padding) -->
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right" HorizontalOffset="2" VerticalOffset="-17"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Focusable="False" PopupAnimation="Fade">
                <Grid Grid.IsSharedSizeScope="True" MinWidth="210" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalNoticeBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,5,0,0" Padding="{DynamicResource MenuPadding}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard Name="SubHiIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerArrow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="PointerArrow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="PointerShift" Storyboard.TargetProperty="X" From="-6" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Name="SubHiOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="PointerArrow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="PointerShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerArrow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
