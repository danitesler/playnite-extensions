<!--
    Dewfield: DefaultControls/GroupBox.xaml. Honey-parchment ledger box inside a carved wooden bevel rim
    with Pixelify Sans heading.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <Border BorderBrush="{DynamicResource LocalCreamHiBrush}" BorderThickness="1.5,1.5,0,0" IsHitTestVisible="False" />
                            <Border BorderBrush="{DynamicResource LocalCedarHiBrush}" BorderThickness="0,0,1.5,1.5" IsHitTestVisible="False" />
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <Border DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}"
                                        BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1.5" Padding="0,0,0,5">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                      TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                      TextElement.FontSize="{DynamicResource FontSize}"
                                                      TextElement.Foreground="{DynamicResource HeadingForegroundBrush}" />
                                </Border>
                                <ContentPresenter />
                            </DockPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
