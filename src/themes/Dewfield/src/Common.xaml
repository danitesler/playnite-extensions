<!--
    Dewfield: Common.xaml — spacing keys, shared white-mask ImageBrushes, Farmstead Wooden Ledger chrome
    templates (BrandMarkTemplate, LocalWoodBevelFrameTemplate, LocalScrollRibbonTemplate,
    LocalSkillPipDividerTemplate, LocalWoodPlanksHTemplate, LocalWoodPlanksVTemplate,
    LocalParchmentGrainTemplate, LocalPlayBevelGlowTemplate, LocalPixelSheenTemplate,
    LocalPixelCellsTemplate, EmptyGameTemplate, SteamScreenshotsSkeletonTemplate,
    HeadingTextBlock, SecondaryButton).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Spacing & Metric Keys (per repo FormControlHeight & Menu rules) -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>               <!-- Standard 32px inputs, combos, buttons -->
    <sys:Double x:Key="IconSize">16</sys:Double>                    <!-- Compact rail and top bar glyphs -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>           <!-- Default hero banner height (0..600) -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>             <!-- Default banner darkening slider (0..1) -->
    <Thickness x:Key="ButtonPadding">14,4</Thickness>               <!-- 2px wood border + 4px v-pad = 32px -->
    <Thickness x:Key="InputPadding">9,4</Thickness>                 <!-- TextBox / PasswordBox / ComboBox -->
    <Thickness x:Key="MenuPadding">8,12,8,8</Thickness>             <!-- Pinned Notice-Board menu inset -->
    <Thickness x:Key="MenuItemPadding">10,4</Thickness>             <!-- Compact 30px menu rows -->
    <Thickness x:Key="ComboBoxDropDownPadding">8,12,8,8</Thickness> <!-- Pinned ComboBox popup inset -->
    <Thickness x:Key="ComboBoxItemPadding">10,4</Thickness>         <!-- 30px ComboBox rows -->
    <Thickness x:Key="ListBoxItemPadding">10,5</Thickness>          <!-- ListBox rows -->
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>      <!-- Carved wooden GroupBox inset -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>              <!-- Cream wooden tooltip inset -->

    <!-- Shared White-Mask FX ImageBrushes (recolored live by ThemeModifier via Fill/Background) -->
    <ImageBrush x:Key="LocalWoodPlanksHMaskBrush" ImageSource="{ThemeFile 'Images/fx/wood-planks-h.png'}"
                TileMode="Tile" Viewport="0,0,256,64" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalWoodPlanksVMaskBrush" ImageSource="{ThemeFile 'Images/fx/wood-planks-v.png'}"
                TileMode="Tile" Viewport="0,0,64,256" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalParchmentGrainMaskBrush" ImageSource="{ThemeFile 'Images/fx/parchment-grain.png'}"
                TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalPixelSheenMaskBrush" ImageSource="{ThemeFile 'Images/fx/pixel-sheen.png'}"
                Stretch="Fill" />
    <ImageBrush x:Key="LocalPixelCellsMaskBrush" ImageSource="{ThemeFile 'Images/fx/pixel-cells.png'}"
                TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="Fill" />

    <!-- 9-Slice ImageBrushes for wood-bevel-glow.png (96x96 with 24px corners/edges) -->
    <ImageBrush x:Key="LocalBevelGlowTL" ImageSource="{ThemeFile 'Images/fx/wood-bevel-glow.png'}" Viewbox="0,0,24,24" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBevelGlowTC" ImageSource="{ThemeFile 'Images/fx/wood-bevel-glow.png'}" Viewbox="24,0,48,24" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBevelGlowTR" ImageSource="{ThemeFile 'Images/fx/wood-bevel-glow.png'}" Viewbox="72,0,24,24" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBevelGlowML" ImageSource="{ThemeFile 'Images/fx/wood-bevel-glow.png'}" Viewbox="0,24,24,48" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBevelGlowMR" ImageSource="{ThemeFile 'Images/fx/wood-bevel-glow.png'}" Viewbox="72,24,24,48" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBevelGlowBL" ImageSource="{ThemeFile 'Images/fx/wood-bevel-glow.png'}" Viewbox="0,72,24,24" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBevelGlowBC" ImageSource="{ThemeFile 'Images/fx/wood-bevel-glow.png'}" Viewbox="24,72,48,24" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBevelGlowBR" ImageSource="{ThemeFile 'Images/fx/wood-bevel-glow.png'}" Viewbox="72,72,24,24" ViewboxUnits="Absolute" Stretch="Fill" />

    <!-- Popup Border -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard Focus Visual (crisp Starwater-blue pixel focus frame) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Texture Mask Templates (recolored by Foreground) -->
    <ControlTemplate x:Key="LocalWoodPlanksHTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalWoodPlanksHMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalWoodPlanksVTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalWoodPlanksVMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalParchmentGrainTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalParchmentGrainMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalPixelSheenTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalPixelSheenMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalPixelCellsTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalPixelCellsMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- 9-Slice Sunlit Wood Bevel Glow (Play button hover & active highlight) -->
    <ControlTemplate x:Key="LocalPlayBevelGlowTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBevelGlowTL}" />
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBevelGlowTC}" />
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBevelGlowTR}" />
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBevelGlowML}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBevelGlowMR}" />
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBevelGlowBL}" />
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBevelGlowBC}" />
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBevelGlowBR}" />
        </Grid>
    </ControlTemplate>

    <!-- Dewfield Sprout-Star Brand Mark Template (original faceted star + twin sprout leaves) -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="64" Height="64">
                <Path Fill="{TemplateBinding Foreground}" Data="M29,16 L22,12 L15,7 L15,4 L24,4 L30,9 L30,16 Z" />
                <Path Fill="{TemplateBinding Foreground}" Data="M35,16 L42,12 L49,7 L49,4 L40,4 L34,9 L34,16 Z" />
                <Path Fill="{TemplateBinding Foreground}" Data="F0 M32,16 L38,28 L54,29 L42,39 L46,56 L32,47 L18,56 L22,39 L10,29 L26,28 Z M32,30 L27,35 L32,40 L37,35 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- 3-Step Carved Cedar Wood Bevel Frame Overlay (outer mahogany outline + cedar rim + top-left highlight / bottom-right shadow) -->
    <ControlTemplate x:Key="LocalWoodBevelFrameTemplate" TargetType="Control">
        <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="2"
                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{DynamicResource LocalCedarBrush}" BorderThickness="2">
                <Grid>
                    <Border BorderBrush="{DynamicResource LocalCedarHiBrush}" BorderThickness="1.5,1.5,0,0" />
                    <Border BorderBrush="{DynamicResource LocalCedarShadowBrush}" BorderThickness="0,0,1.5,1.5" />
                </Grid>
            </Border>
        </Border>
    </ControlTemplate>

    <!-- Skill-Level 4+1 Wooden Pip Group Divider (Metadata pane & sections) -->
    <ControlTemplate x:Key="LocalSkillPipDividerTemplate" TargetType="Control">
        <Grid Height="8" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <Border Width="8" Height="5" Margin="0,0,2,0" Background="{DynamicResource LocalCedarHiBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Width="8" Height="5" Margin="0,0,2,0" Background="{DynamicResource LocalCedarHiBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Width="8" Height="5" Margin="0,0,2,0" Background="{DynamicResource LocalSlotWoodBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Width="8" Height="5" Margin="0,0,2,0" Background="{DynamicResource LocalSlotWoodBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Width="14" Height="5" Background="{DynamicResource LocalRubyBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
            </StackPanel>
            <Rectangle Grid.Column="1" Height="1.5" VerticalAlignment="Center" Fill="{DynamicResource PanelSeparatorBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Section Heading TextBlock -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Secondary Wooden Bevel Button (More, Edit, secondary dialog actions) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <Border x:Name="BevelHi" BorderBrush="{DynamicResource LocalCreamHiBrush}"
                                        BorderThickness="1.5,1.5,0,0" IsHitTestVisible="False" />
                                <Border x:Name="BevelLo" BorderBrush="{DynamicResource NormalBrushDark}"
                                        BorderThickness="0,0,1.5,1.5" IsHitTestVisible="False" />
                                <Border x:Name="HoverWash" Background="{DynamicResource SecondaryButtonHoverBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="PressedWash" Background="{DynamicResource SecondaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="SecHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="SecHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedWash" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressedWash" Property="Opacity" Value="1" />
                            <Setter TargetName="BevelHi" Property="BorderBrush" Value="{DynamicResource LocalCedarShadowBrush}" />
                            <Setter TargetName="BevelLo" Property="BorderBrush" Value="{DynamicResource LocalCreamHiBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Designed Empty Game State (Wooden Signpost & Sprout-Star Emblem + LOCErrorNoGameSelected) -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <Border Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}"
                    BorderThickness="2.5" CornerRadius="{DynamicResource CornerRadiusLarge}" Padding="32,26" MinWidth="280">
                <Grid>
                    <Border Margin="-32,-26" BorderBrush="{DynamicResource LocalCedarBrush}" BorderThickness="2" IsHitTestVisible="False">
                        <Grid>
                            <Border BorderBrush="{DynamicResource LocalCedarHiBrush}" BorderThickness="1.5,1.5,0,0" />
                            <Border BorderBrush="{DynamicResource LocalCedarShadowBrush}" BorderThickness="0,0,1.5,1.5" />
                        </Grid>
                    </Border>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="54" Height="54" HorizontalAlignment="Center" Margin="0,0,0,14"
                                Background="{DynamicResource LocalCedarBrush}" BorderBrush="{DynamicResource NormalBorderBrush}"
                                BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Control x:Name="EmptyEmblem" Template="{DynamicResource BrandMarkTemplate}"
                                     Foreground="{DynamicResource LocalCreamHiBrush}" Width="34" Height="34"
                                     RenderTransformOrigin="0.5,0.5" Focusable="False">
                                <Control.RenderTransform>
                                    <ScaleTransform x:Name="EmblemPulse" ScaleX="1" ScaleY="1" />
                                </Control.RenderTransform>
                            </Control>
                        </Border>
                        <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" FontFamily="{DynamicResource HeadingFontFamily}"
                                   FontSize="{DynamicResource FontSizeLarger}" Foreground="{DynamicResource TextBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                        <Control Template="{DynamicResource LocalSkillPipDividerTemplate}" Width="140" Margin="0,12,0,0" Focusable="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="EmptyEmblemIdle">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="EmblemPulse" Storyboard.TargetProperty="ScaleX" From="1" To="1.06" Duration="0:0:1.6">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmblemPulse" Storyboard.TargetProperty="ScaleY" From="1" To="1.06" Duration="0:0:1.6">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyEmblemIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Steam Screenshots Loading Skeleton (recessed wooden inventory frames) -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <UniformGrid Rows="1" Columns="3" Height="110" Margin="0,6,0,0">
            <Border Margin="0,0,8,0" Background="{DynamicResource NormalBrushDark}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border x:Name="Skel1" Background="{DynamicResource LocalCreamBrush}" Opacity="0.35" />
            </Border>
            <Border Margin="4,0,4,0" Background="{DynamicResource NormalBrushDark}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border x:Name="Skel2" Background="{DynamicResource LocalCreamBrush}" Opacity="0.35" />
            </Border>
            <Border Margin="8,0,0,0" Background="{DynamicResource NormalBrushDark}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border x:Name="Skel3" Background="{DynamicResource LocalCreamBrush}" Opacity="0.35" />
            </Border>
        </UniformGrid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="SkelPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Skel1" Storyboard.TargetProperty="Opacity" From="0.2" To="0.55" Duration="0:0:0.9" />
                            <DoubleAnimation Storyboard.TargetName="Skel2" Storyboard.TargetProperty="Opacity" From="0.2" To="0.55" BeginTime="0:0:0.15" Duration="0:0:0.9" />
                            <DoubleAnimation Storyboard.TargetName="Skel3" Storyboard.TargetProperty="Opacity" From="0.2" To="0.55" BeginTime="0:0:0.3" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkelPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
