<!--
    Dewfield: Constants.xaml template (Stardew Valley-inspired Farmstead Wooden Ledger & Notice Board).
    scripts/build-theme.ps1 renders tokens.css placeholders into Constants.xaml.
    Light honey-parchment palette: warm cream/honey pages, dark walnut notice-board rail & top bar,
    3-step carved cedar wood bevels, deep mahogany ink, meadow-green harvest Play CTA,
    starwater-blue running indicator, and crimson Red-X danger/Exit.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Pixelify Sans bundled as static OFL TTF in Typography/) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">30</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Pixelify Sans, Pixelify Sans, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Game page metadata pane defaults (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape & radii: crisp 2-4px pixel wood corners; 9999 strictly for 1:1 circles -->
    <Thickness x:Key="PopupBorderThickness">2</Thickness>
    <Thickness x:Key="ControlBorderThickness">2</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:df-radius|3}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:df-radius-sm|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:df-radius-lg|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{df-ink}}</Color>
    <Color x:Key="TextColorDarker">{{df-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{df-ink-deep}}</Color>
    <Color x:Key="MainColor">{{df-parchment}}</Color>
    <Color x:Key="MainColorDark">{{df-parchment-well}}</Color>
    <Color x:Key="HoverColor">{{df-hover}}</Color>
    <Color x:Key="GlyphColor">{{df-cedar}}</Color>
    <Color x:Key="HighlightGlyphColor">{{df-amber}}</Color>
    <Color x:Key="PopupBackgroundColor">{{df-cream}}</Color>
    <Color x:Key="PopupBorderColor">{{df-wood-outline}}</Color>
    <Color x:Key="BackgroundToneColor">{{df-parchment-well}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{df-parchment-line}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{df-wood-outline}}</Color>
    <Color x:Key="DataChangeNotifColor">{{df-quest-gold}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{df-wood-outline}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{df-cream}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{df-ink}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{df-cream}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{df-cream}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{df-rating-pos}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{df-rating-neg}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{df-rating-mix}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{df-amber}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{df-parchment}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{df-parchment-page}}" />

    <!-- Shell & Game Page Surfaces -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{df-walnut}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{df-walnut-mid}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{df-parchment-page}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{df-parchment-page}}" />
    <!-- Banner darkening color: light honey parchment so darkened banner art blends into the ledger -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{df-parchment-page}}" />
    <!-- ScrimBrush: deep night-walnut scrim for darkening RunningIndicatorBrush plates (keeps cream text > 6:1) -->
    <SolidColorBrush x:Key="ScrimBrush" Color="{{df-sky-scrim}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{df-cedar}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{df-cream-hi}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{df-cream}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{df-cream-hi}}" />

    <!-- Light-Theme Window Background Art Flip (crisp cream text over game art) -->
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{df-cream-hi}}" />

    <!-- Wood Bevel & Farmstead Craft Brushes -->
    <SolidColorBrush x:Key="LocalWalnutDeepBrush" Color="{{df-walnut-deep}}" />
    <SolidColorBrush x:Key="LocalWalnutPlankBrush" Color="{{df-walnut-plank}}" />
    <SolidColorBrush x:Key="LocalWalnutHoverBrush" Color="{{df-walnut-hover}}" />
    <SolidColorBrush x:Key="LocalCedarShadowBrush" Color="{{df-cedar-shadow}}" />
    <SolidColorBrush x:Key="LocalCedarBrush" Color="{{df-cedar}}" />
    <SolidColorBrush x:Key="LocalCedarHiBrush" Color="{{df-cedar-hi}}" />
    <SolidColorBrush x:Key="LocalAmberBrush" Color="{{df-amber}}" />
    <SolidColorBrush x:Key="LocalQuestGoldBrush" Color="{{df-quest-gold}}" />
    <SolidColorBrush x:Key="LocalCreamHiBrush" Color="{{df-cream-hi}}" />
    <SolidColorBrush x:Key="LocalCreamBrush" Color="{{df-cream}}" />
    <SolidColorBrush x:Key="LocalSlotWoodBrush" Color="{{df-slot-wood}}" />
    <SolidColorBrush x:Key="LocalLinkBrush" Color="{{df-link}}" />
    <SolidColorBrush x:Key="LocalThumbtackBrush" Color="{{df-thumbtack}}" />
    <SolidColorBrush x:Key="LocalRubyBrush" Color="{{df-ruby}}" />
    <SolidColorBrush x:Key="LocalCrimsonHiBrush" Color="{{df-crimson-hi}}" />
    <SolidColorBrush x:Key="LocalEnergyBrush" Color="{{df-energy}}" />
    <SolidColorBrush x:Key="LocalEnergyHiBrush" Color="{{df-energy-hi}}" />
    <SolidColorBrush x:Key="LocalMeadowBevelBrush" Color="{{df-meadow-bevel}}" />

    <!-- State Brushes: Sun-Amber selection with deep mahogany ink; toasted honey hover -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{df-selected}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{df-selected-hi}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{df-wood-outline}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{df-ink-deep}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{df-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{df-selected}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{df-selected}}" />
    <!-- Dedicated Starwater Sky Blue running indicator (distinct from Meadow Green Play, Amber selection, Crimson danger) -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{df-sky-run}}" />
    <SolidColorBrush x:Key="LocalRunningHighlightBrush" Color="{{df-sky-hi}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{df-focus}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{df-focus-halo}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{df-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{df-cream-hi}}" />

    <!-- Button Brushes: Primary Play CTA is Harvest Meadow-Green wooden bevel plaque -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{df-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{df-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{df-pressed}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{df-wood-outline}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{df-meadow}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{df-meadow-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{df-meadow-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{df-wood-outline}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{df-cream-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{df-quest-gold}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{df-cream}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{df-wood-outline}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{df-hover}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{df-pressed}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{df-parchment}}" />

    <!-- Input & Control Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{df-cream}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{df-cream-hi}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{df-wood-outline}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{df-cedar-hi}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{df-wood-outline}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{df-cedar-hi}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{df-meadow-hi}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{df-parchment-well}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{df-amber}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{df-wood-outline}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{df-cedar-hi}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{df-energy}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{df-walnut-deep}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{df-cedar-hi}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{df-amber}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{df-parchment}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{df-cedar-hi}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{df-quest-gold}}" />

    <!-- Shared Accent & Section Typography Brushes -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{df-ink}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{df-link}}" />
</ResourceDictionary>
