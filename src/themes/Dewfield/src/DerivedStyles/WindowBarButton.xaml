<!--
    Dewfield: DerivedStyles/WindowBarButton.xaml. Dialog caption buttons sized to the 44px StandardWindowStyle
    title band (40x40 cell containing a 28x28 cream-and-mahogany wooden tile; close button wears Stardew's
    iconic Crimson X at rest and fills solid Crimson on hover).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WindowBarButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Tile" Width="28" Height="28" Background="{DynamicResource LocalCreamBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="2"
                                CornerRadius="{DynamicResource CornerRadiusSmall}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid>
                                <Border x:Name="BevelHi" BorderBrush="{DynamicResource LocalCreamHiBrush}" BorderThickness="1.5,1.5,0,0" IsHitTestVisible="False" />
                                <Border x:Name="BevelLo" BorderBrush="{DynamicResource NormalBrushDark}" BorderThickness="0,0,1.5,1.5" IsHitTestVisible="False" />
                                <ContentPresenter x:Name="Glyph" Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Content="{DynamicResource IconWindowClose}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="0">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMinimize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Content" Value="{DynamicResource IconWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="r">
                            <Setter Property="Foreground" Value="{DynamicResource LocalCrimsonHiBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Content" Value="r" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="BevelHi" Property="BorderBrush" Value="{DynamicResource LocalCrimsonHiBrush}" />
                            <Setter TargetName="BevelLo" Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
