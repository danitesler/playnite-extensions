<!--
    Dewfield: DerivedStyles/DetailsViewItemStyle.xaml.
    Stardew Store / Journal stacked parchment game rows:
    - Hover: toasted honey plate (#F7BC6B) fades in (110ms) with a 6px wooden pixel pointer sliding from the left.
    - Selected: golden-amber plank (#F2A844) with cream upper bevel & growing 4px crimson-cedar pin bar (BackEase).
    - RowHoverAction: right-edge transparent Play / Install glyph button (26x26, RowHoverRoom pads right by 38px;
      explicitly collapsed while IsRunning or IsLaunching).
    - RunningIndicator (Starwater Sky Blue #1162A8): drawn above hover & selection, below content; 2px frame +
      dark inner keyline, segmented pixel water sweep (RunningScan), 2px foot line (RunningFill), RunningMarkPlate
      right backing strip + 3 starwater diamond sparkles inside 36px RowRoom padding.
    - Light-theme window art flip: unselected rows take WindowArtForegroundBrush when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- RowHoverAction transparent glyph button style (no fill at rest or hover; grows 14 -> 17px on hover) -->
    <Style x:Key="LocalRowHoverActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl Content="{TemplateBinding Content}"
                                            ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{TemplateBinding Foreground}" Focusable="False" />
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            <Setter TargetName="Glyph" Property="Width" Value="17" />
                            <Setter TargetName="Glyph" Property="Height" Value="17" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="Margin" Value="6,1.5,6,1.5" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Hover Layer (collapsed at rest) -->
                        <Border x:Name="HoverPlate" Background="{DynamicResource ListItemHoverBrush}"
                                BorderBrush="{DynamicResource LocalCedarBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border BorderBrush="{DynamicResource LocalCreamBrush}" BorderThickness="0,1,0,0" />
                        </Border>
                        <Path x:Name="HoverArrow" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                              Width="6" Height="9" Stretch="Fill" Data="M 0,0 L 6,4.5 L 0,9 Z"
                              Fill="{DynamicResource LocalCedarShadowBrush}"
                              Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Path.RenderTransform>
                                <TranslateTransform x:Name="HoverArrowX" X="-6" />
                            </Path.RenderTransform>
                        </Path>

                        <!-- Selected Layer (collapsed at rest) -->
                        <Grid x:Name="SelectedPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Background="{DynamicResource ListItemSelectedBrush}"
                                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}">
                                <Grid>
                                    <Border BorderBrush="{DynamicResource LocalCreamBrush}" BorderThickness="0,1.5,0,0" />
                                    <Border BorderBrush="{DynamicResource LocalCedarHiBrush}" BorderThickness="0,0,0,1.5" />
                                </Grid>
                            </Border>
                            <Rectangle x:Name="SelectedPin" Width="4" Margin="2,4,0,4" HorizontalAlignment="Left"
                                       Fill="{DynamicResource LocalCrimsonHiBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="PinScaleY" ScaleY="0.2" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <!-- Running Game Indicator (Starwater Sky Blue; above hover & selection, below content) -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0.16" />

                            <!-- Segmented Pixel Water Sweep (Launching only) -->
                            <Grid x:Name="RunningScan" Visibility="Collapsed" ClipToBounds="True">
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <Border Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0.42">
                                    <Rectangle Fill="{DynamicResource LocalRunningHighlightBrush}" Opacity="0.55"
                                               OpacityMask="{DynamicResource LocalPixelCellsMaskBrush}" />
                                </Border>
                            </Grid>

                            <!-- 2px Starwater Frame with Dark Inner Keyline (readable on dark & bright selected fills) -->
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                    BorderThickness="2" CornerRadius="{DynamicResource CornerRadiusSmall}">
                                <Border BorderBrush="{DynamicResource ScrimBrush}" BorderThickness="1" Opacity="0.55" />
                            </Border>

                            <!-- 2px Irrigation Foot Progress Line inside keyline -->
                            <Grid Height="2" VerticalAlignment="Bottom" Margin="4,0,4,3">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="FillScaleX" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>

                            <!-- RunningMarkPlate backing strip + 3 Starwater Sparkles on far right -->
                            <Border x:Name="RunningMarkPlate" Width="36" HorizontalAlignment="Right" Margin="0,2,2,2"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34"
                                    CornerRadius="0,2,2,0">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.45" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid Width="24" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,1">
                                <Path x:Name="Spark1" Width="5" Height="5" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                      Data="M 2.5,0 L 5,2.5 L 2.5,5 L 0,2.5 Z" Fill="{DynamicResource RunningIndicatorBrush}">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="Spark1Y" Y="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="Spark2" Width="7" Height="7" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 3.5,0 L 7,3.5 L 3.5,7 L 0,3.5 Z" Fill="{DynamicResource LocalRunningHighlightBrush}">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="Spark2Y" Y="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="Spark3" Width="5" Height="5" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                                      Data="M 2.5,0 L 5,2.5 L 2.5,5 L 0,2.5 Z" Fill="{DynamicResource RunningIndicatorBrush}">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="Spark3Y" Y="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Grid>

                        <!-- Content Host inside RowRoom (for running sparkles) and RowHoverRoom (for RowHoverAction) -->
                        <Border x:Name="RowRoom" Padding="0">
                            <Border x:Name="RowHoverRoom" Padding="0">
                                <ContentPresenter x:Name="RowPresenter" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="RowShiftX" X="0" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Border>

                        <!-- RowHoverAction: Play (installed) / Install (uninstalled) buttons on right edge -->
                        <Button x:Name="RowHoverPlay" Content="{DynamicResource IconPlay}"
                                Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LocalRowHoverActionButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="RowHoverInstall" Content="{DynamicResource IconDownload}"
                                Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LocalRowHoverActionButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Row hover animation & RowHoverRoom padding -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="RowHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverArrow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="HoverArrow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="HoverArrowX" Storyboard.TargetProperty="X" From="-6" To="0" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RowShiftX" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="RowHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverArrow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverArrowX" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="RowShiftX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverArrow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Selected Row animation -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverArrow" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Padding" Value="11,4,8,4" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="RowSelIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="PinScaleY" Storyboard.TargetProperty="ScaleY" From="0.2" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RowSelIn" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- RunningMarkRoom left="0" right="36" -->
                        <!-- LAUNCHING State -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,36,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark1Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="-3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark2Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="-4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark3Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-2.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING State -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,36,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark2" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
