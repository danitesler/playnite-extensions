<!--
    Dewfield: DerivedStyles/PropertyItemButton.xaml.
    Default: rich cedar-mahogany wood-ink link (#9C3A06) underlining on hover.
    Tag="Chip" (ItemsControl ancestor): Stardew sunken warm-wood inventory tag chips (#F2BE72) inside
    1.5px mahogany borders with top-left wood shadow bevel that warm to sunlit honey gold on hover.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="ChipPlate" Visibility="Collapsed"
                                Background="{DynamicResource NormalBrushDark}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource CornerRadiusSmall}">
                            <Grid>
                                <Border x:Name="ChipBevelHi" BorderBrush="{DynamicResource LocalSlotWoodBrush}"
                                        BorderThickness="1,1,0,0" IsHitTestVisible="False" />
                                <Border x:Name="ChipBevelLo" BorderBrush="{DynamicResource LocalCreamBrush}"
                                        BorderThickness="0,0,1,1" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="Label" Margin="{TemplateBinding Padding}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                            <Setter TargetName="ChipPlate" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="Padding" Value="7,2,7,2" />
                            <Setter Property="Margin" Value="0,0,5,5" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Label" Property="TextDecorations" Value="{x:Null}" />
                            <Setter TargetName="ChipPlate" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            <Setter TargetName="ChipBevelHi" Property="BorderBrush" Value="{DynamicResource LocalCreamHiBrush}" />
                            <Setter TargetName="ChipBevelLo" Property="BorderBrush" Value="{DynamicResource LocalCedarHiBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
