<!--
    Dewfield: Media.xaml — Bespoke pixel-crafted geometric vector icons (24x24 snapped pixel-step silhouettes)
    inspired by Stardew Valley's rustic farmstead UI & tool iconography. IconMainMenu draws Dewfield's original
    Sprout-Star Emblem. Playnite's 22 icofont menu icons omit local Foreground so they inherit TextElement.Foreground
    on Sun-Amber honey hover and Crimson Exit highlight.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Icon DataTemplates -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox MaxWidth="{DynamicResource IconSize}" MaxHeight="{DynamicResource IconSize}" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox MaxWidth="12" MaxHeight="12" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileSolidTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <!-- Brand Mark: Original Dewfield Sprout-Star Emblem (scaled to 24x24) -->
    <Geometry x:Key="IconMainMenu">F0 M10.8,6.5 L8.2,4.8 L5.5,2.8 L5.5,1.5 L9,1.5 L11.2,3.5 L11.2,6.5 Z M13.2,6.5 L15.8,4.8 L18.5,2.8 L18.5,1.5 L15,1.5 L12.8,3.5 L12.8,6.5 Z M12,6.2 L14.4,10.8 L20.5,11.2 L15.8,15 L17.4,21.5 L12,18 L6.6,21.5 L8.2,15 L3.5,11.2 L9.6,10.8 Z M12,11.6 L10.1,13.5 L12,15.4 L13.9,13.5 Z</Geometry>

