<!--
    Overlay on Playnite Default/Media.xaml.
    Plumbline icon set: hand-drawn Icon<Role> geometries on a 24px grid (original drawings, nothing to license), each stroked by
    IconTemplate in the inherited foreground, 2.4px thick with round caps and joins: the chunky rounded glyphs of the game's menus.
    The host sets the size (IconSize). Dots are "h 0.01" segments that only show with a round cap. IconPlay is the one FILLED
    glyph: hosts that show it as a solid triangle fill the Path themselves (the Play button does), IconTemplate would only outline it.

    Menu icons Playnite copies (AddGameIcon, PlayIcon, ...) are not overridden: no PNG set is rendered yet, so Playnite's own
    glyph icons are kept and recolored by the palette (see AGENTS.md -> Deviations).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- search -->
    <Geometry x:Key="IconSearch">M 4.5 10.5 a 6 6 0 1 0 12 0 a 6 6 0 1 0 -12 0 Z M 15 15 l 5 5</Geometry>
    <!-- x -->
    <Geometry x:Key="IconClear">M 6 6 l 12 12 M 18 6 L 6 18</Geometry>
    <!-- sliders -->
    <Geometry x:Key="IconViewSettings">M 4 8 h 8 M 18 8 h 2 M 4 16 h 2 M 12 16 h 8 M 12.6 8 a 2.4 2.4 0 1 0 4.8 0 a 2.4 2.4 0 1 0 -4.8 0 Z M 6.6 16 a 2.4 2.4 0 1 0 4.8 0 a 2.4 2.4 0 1 0 -4.8 0 Z</Geometry>
    <!-- bookmark -->
    <Geometry x:Key="IconFilterPresets">M 7 3.5 h 10 a 1.5 1.5 0 0 1 1.5 1.5 v 15 l -6.5 -4 l -6.5 4 v -15 a 1.5 1.5 0 0 1 1.5 -1.5 Z</Geometry>
    <!-- layers -->
    <Geometry x:Key="IconGroup">M 12 3.5 l 8.5 4.6 l -8.5 4.6 l -8.5 -4.6 Z M 3.5 12.5 l 8.5 4.6 l 8.5 -4.6 M 3.5 16.8 L 12 21.4 l 8.5 -4.6</Geometry>
    <!-- up and down arrows -->
    <Geometry x:Key="IconSort">M 7 20 V 4 M 3.5 7.5 L 7 4 l 3.5 3.5 M 17 4 v 16 M 13.5 16.5 L 17 20 l 3.5 -3.5</Geometry>
    <!-- panel -->
    <Geometry x:Key="IconDetailsView">M 6 4.5 h 12 a 2.5 2.5 0 0 1 2.5 2.5 v 10 a 2.5 2.5 0 0 1 -2.5 2.5 h -12 a 2.5 2.5 0 0 1 -2.5 -2.5 v -10 a 2.5 2.5 0 0 1 2.5 -2.5 Z M 14.5 4.5 v 15</Geometry>
    <!-- four tiles -->
    <Geometry x:Key="IconGridView">M 5.6 4 h 3.3 a 1.6 1.6 0 0 1 1.6 1.6 v 3.3 a 1.6 1.6 0 0 1 -1.6 1.6 h -3.3 a 1.6 1.6 0 0 1 -1.6 -1.6 v -3.3 a 1.6 1.6 0 0 1 1.6 -1.6 Z M 15.1 4 h 3.3 a 1.6 1.6 0 0 1 1.6 1.6 v 3.3 a 1.6 1.6 0 0 1 -1.6 1.6 h -3.3 a 1.6 1.6 0 0 1 -1.6 -1.6 v -3.3 a 1.6 1.6 0 0 1 1.6 -1.6 Z M 5.6 13.5 h 3.3 a 1.6 1.6 0 0 1 1.6 1.6 v 3.3 a 1.6 1.6 0 0 1 -1.6 1.6 h -3.3 a 1.6 1.6 0 0 1 -1.6 -1.6 v -3.3 a 1.6 1.6 0 0 1 1.6 -1.6 Z M 15.1 13.5 h 3.3 a 1.6 1.6 0 0 1 1.6 1.6 v 3.3 a 1.6 1.6 0 0 1 -1.6 1.6 h -3.3 a 1.6 1.6 0 0 1 -1.6 -1.6 v -3.3 a 1.6 1.6 0 0 1 1.6 -1.6 Z</Geometry>
    <!-- list -->
    <Geometry x:Key="IconListView">M 9.5 6.5 H 20 M 9.5 12 H 20 M 9.5 17.5 H 20 M 4.5 6.5 h 0.01 M 4.5 12 h 0.01 M 4.5 17.5 h 0.01</Geometry>
    <!-- circle arrow down -->
    <Geometry x:Key="IconUpdate">M 3 12 a 9 9 0 1 0 18 0 a 9 9 0 1 0 -18 0 Z M 12 8 v 8 M 8.5 12.5 L 12 16 l 3.5 -3.5</Geometry>
    <!-- folder -->
    <Geometry x:Key="IconExplorer">M 3.5 7 a 2 2 0 0 1 2 -2 h 4 l 2 2.5 h 7 a 2 2 0 0 1 2 2 v 8 a 2 2 0 0 1 -2 2 h -13 a 2 2 0 0 1 -2 -2 Z</Geometry>
    <!-- die -->
    <Geometry x:Key="IconRandom">M 6.5 4 h 11 a 2.5 2.5 0 0 1 2.5 2.5 v 11 a 2.5 2.5 0 0 1 -2.5 2.5 h -11 a 2.5 2.5 0 0 1 -2.5 -2.5 v -11 a 2.5 2.5 0 0 1 2.5 -2.5 Z M 8.5 8.5 h 0.01 M 15.5 8.5 h 0.01 M 12 12 h 0.01 M 8.5 15.5 h 0.01 M 15.5 15.5 h 0.01</Geometry>
    <!-- shuffle -->
    <Geometry x:Key="IconViewRandom">M 4 7 h 3 c 4 0 5 10 9 10 h 4 M 17 14 l 3 3 l -3 3 M 4 17 h 3 c 1.6 0 2.7 -1.2 3.6 -2.7 M 13.4 9.7 C 14.3 8.2 15.4 7 17 7 h 3 M 17 4 l 3 3 l -3 3</Geometry>
    <!-- funnel -->
    <Geometry x:Key="IconFilter">M 4.5 5.5 h 15 l -5.8 7 v 6 l -3.4 -2 v -4 Z</Geometry>
    <!-- bell -->
    <Geometry x:Key="IconNotifications">M 6.5 17 V 11 a 5.5 5.5 0 0 1 11 0 v 6 l 1.7 2.2 H 4.8 Z M 10 21.2 h 4</Geometry>
    <!-- three bars -->
    <Geometry x:Key="IconMainMenu">M 4 7 h 16 M 4 12 h 16 M 4 17 h 16</Geometry>
    <!-- three books -->
    <Geometry x:Key="IconLibrary">M 5.2 5 h 2.1 a 1.2 1.2 0 0 1 1.2 1.2 v 11.6 a 1.2 1.2 0 0 1 -1.2 1.2 h -2.1 a 1.2 1.2 0 0 1 -1.2 -1.2 v -11.6 a 1.2 1.2 0 0 1 1.2 -1.2 Z M 11.2 3.5 h 2.1 a 1.2 1.2 0 0 1 1.2 1.2 v 13.1 a 1.2 1.2 0 0 1 -1.2 1.2 h -2.1 a 1.2 1.2 0 0 1 -1.2 -1.2 v -13.1 a 1.2 1.2 0 0 1 1.2 -1.2 Z M 16 6.2 l 3.9 -1 l 3.2 12.4 l -3.9 1 Z</Geometry>
    <!-- bars -->
    <Geometry x:Key="IconStatistics">M 5.5 20 v -8 M 12 20 V 4.5 M 18.5 20 v -5.5</Geometry>
    <!-- minimize -->
    <Geometry x:Key="IconWindowMinimize">M 6 12 h 12</Geometry>
    <!-- maximize -->
    <Geometry x:Key="IconWindowMaximize">M 7.5 6 h 9 a 1.5 1.5 0 0 1 1.5 1.5 v 9 a 1.5 1.5 0 0 1 -1.5 1.5 h -9 a 1.5 1.5 0 0 1 -1.5 -1.5 v -9 a 1.5 1.5 0 0 1 1.5 -1.5 Z</Geometry>
    <!-- restore -->
    <Geometry x:Key="IconWindowRestore">M 6.5 9.5 h 7 a 1 1 0 0 1 1 1 v 7 a 1 1 0 0 1 -1 1 h -7 a 1 1 0 0 1 -1 -1 v -7 a 1 1 0 0 1 1 -1 Z M 9.5 6.5 a 1 1 0 0 1 1 -1 h 7 a 1 1 0 0 1 1 1 v 7 a 1 1 0 0 1 -1 1</Geometry>
    <!-- x -->
    <Geometry x:Key="IconWindowClose">M 6.5 6.5 l 11 11 M 17.5 6.5 l -11 11</Geometry>
    <!-- three dots, thicker stroke in the host -->
    <Geometry x:Key="IconOptions">M 5.5 12 h 0.01 M 12 12 h 0.01 M 18.5 12 h 0.01</Geometry>
    <!-- pencil -->
    <Geometry x:Key="IconEdit">M 4.5 19.5 l 1 -4 L 16 5 l 3.5 3.5 L 9 19 Z M 13.8 7.3 l 3 3</Geometry>
    <!-- tick -->
    <Geometry x:Key="IconCheck">M 5 12.5 l 4.5 4.5 L 19 7.5</Geometry>
    <!-- chevron right -->
    <Geometry x:Key="IconSubmenu">M 9 6 l 6 6 l -6 6</Geometry>
    <!-- arrow down to a tray -->
    <Geometry x:Key="IconDownload">M 12 4 v 11 M 7.5 11 l 4.5 4.5 l 4.5 -4.5 M 5 20 h 14</Geometry>
    <!-- i in a circle -->
    <Geometry x:Key="IconInfo">M 3 12 a 9 9 0 1 0 18 0 a 9 9 0 1 0 -18 0 Z M 12 11 v 5.5 M 12 7.8 h 0.01</Geometry>
    <!-- Play triangle: the one filled glyph, fill and stroke both the Play green -->
    <Geometry x:Key="IconPlay">M 7.5 4.5 v 15 l 12.5 -7.5 Z</Geometry>

    <!-- chevron down -->
    <Geometry x:Key="IconDropDown">M 6 9.5 l 6 6 l 6 -6</Geometry>
    <!-- plus -->
    <Geometry x:Key="IconAdd">M 12 5 v 14 M 5 12 h 14</Geometry>
    <!-- bin -->
    <Geometry x:Key="IconRemove">M 5 7 h 14 M 9.5 7 V 4.8 a 1 1 0 0 1 1 -1 h 3 a 1 1 0 0 1 1 1 V 7 M 6.5 7 l 0.8 11.8 a 1.8 1.8 0 0 0 1.8 1.7 h 5.8 a 1.8 1.8 0 0 0 1.8 -1.7 L 17.5 7 M 10 11 v 5 M 14 11 v 5</Geometry>

    <!-- Content = one of the geometries above, stroked in the inherited foreground. -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                      StrokeThickness="2.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource IconSearch}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource IconClear}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <!-- Playnite menu icons: omit local Foreground so they inherit TextElement.Foreground from MenuItem and invert on highlight. -->
    <TextBlock x:Key="FullscreenModeIcon" Text="&#xea48;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="AddGameIcon" Text="&#xec3e;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="UpdateDbIcon" Text="&#xefd1;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="AboutPlayniteIcon" Text="&#xef4e;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="ExitIcon" Text="&#xef1d;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="SettingsIcon" Text="&#xefb0;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="AddonsIcon" Text="&#xeea0;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="PlayIcon" Text="&#xec74;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="InstallIcon" Text="&#xef08;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="LinksIcon" Text="&#xef71;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="OpenFolderIcon" Text="&#xec5b;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="InstallSizeIcon" Text="&#xef43;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="DesktopShortcutIcon" Text="&#xef20;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="AddFavoritesIcon" Text="&#xef25;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="RemoveFavoritesIcon" Text="&#xef25;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="HideIcon" Text="&#xef22;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="UnHideIcon" Text="&#xef21;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="HdrIcon" Text="&#xeef2;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="EditGameIcon" Text="&#xeded;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="RemoveGameIcon" Text="&#xec53;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="DiceIcon" Text="&#xef03;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
    <TextBlock x:Key="ManualIcon" Text="&#xead1;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
</ResourceDictionary>
