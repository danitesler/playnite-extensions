<!--
    Overlay on Playnite Default/Common.xaml. Plumbline's spacing and focus.
    The Sims menus use 6px plates and 32px capsules (CornerRadiusLarge = 16), so ControlHeight 32 is a true pill. Vertical
    padding stays at 5 so ControlHeight decides the height, whatever the font.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menus, dropdowns and popovers: a white plate, a pale rim, the 6px corner. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: a 2px FocusBrush ring 2px outside the control (capsule radius covers buttons, tabs and rows alike). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="18" RadiusY="18" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: the same ring around the 20px box and the round radio. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="8" RadiusY="8" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: 16 inline so the capsule ends clear the label -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <!-- Text box, password box, dropdown: 10 inline -->
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <!-- Menu: 4 inside the plate; items 28px (16 + 2 x 6) -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6</Thickness>
    <!-- Dropdown popup: the same plate and rows as menus -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,5</Thickness>
    <!-- List box item -->
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <!-- Card (group box): 14,10 body padding; the header is the grey-blue band -->
    <Thickness x:Key="GroupBoxPadding">14,10</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,10</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">14,0</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">11</sys:Double>
    <!-- Tooltip -->
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>

    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush (paper) over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu, on the white disc): the theme's plumb bob, a four-faced green gem hanging from
         a short thread, 16x22 (an original faceting, not a game asset). Rest: the gem hangs still, light facets to the left.
         Hover (IsMouseOver): the gem twirls once about its vertical axis (ScaleX 1 to -1 and back, SineEase, 0.6s) with a 2px
         lift at the half turn; it ends at rest, and leaving stops it. Open (the menu's ContextMenu.IsOpen on the nearest Border,
         which is PART_ElemMainMenu): the bob swings like a pendulum from the thread's top, 12 degrees either way every 1.4s, and a
         white sparkle glints on its upper facet at the end of each swing, until the menu closes. The swing turns the outer
         canvas (thread and gem), the twirl scales the inner one (gem only), the sparkle is its own element. -->
    <ControlTemplate x:Key="LocalPlumblineMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="False">
            <Canvas Width="16" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="16" Height="22">
                    <Canvas.RenderTransform><RotateTransform x:Name="Swing" CenterX="8" CenterY="0" Angle="0" /></Canvas.RenderTransform>
                    <Path Data="M8,0 V3.6" Stroke="{DynamicResource MainMenuButtonForegroundBrush}" StrokeThickness="1" />
                    <Canvas Width="16" Height="22">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Twirl" CenterX="8" CenterY="12" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="Lift" Y="0" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Path Data="M8,3.5 L1.5,10.5 L8,10.5 Z" Fill="{DynamicResource SelectedHoverBrush}" />
                        <Path Data="M8,3.5 L14.5,10.5 L8,10.5 Z" Fill="{DynamicResource SelectedBrush}" />
                        <Path Data="M1.5,10.5 L8,10.5 L8,21 Z" Fill="{DynamicResource SelectedBorderBrush}" />
                        <Path Data="M14.5,10.5 L8,10.5 L8,21 Z" Fill="{DynamicResource ProgressBarTrackBrush}" />
                        <Path Data="M8,3.5 L14.5,10.5 L8,21 L1.5,10.5 Z" Stroke="{DynamicResource MainMenuButtonForegroundBrush}" StrokeThickness="0.9" StrokeLineJoin="Miter" Opacity="0.55" />
                        <Path x:Name="Glint" Data="M5.6,6.6 L6.1,8.1 L7.6,8.6 L6.1,9.1 L5.6,10.6 L5.1,9.1 L3.6,8.6 L5.1,8.1 Z" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" Opacity="0" />
                    </Canvas>
                </Canvas>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Twirl" Storyboard.TargetProperty="ScaleX">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-2"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Twirl" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Swing" Storyboard.TargetProperty="Angle" To="-12" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="Swing" Storyboard.TargetProperty="Angle" From="-12" To="12" BeginTime="0:0:0.2" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glint" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.15" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.65" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Swing" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Glint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
