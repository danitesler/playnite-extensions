<!--
    Plumbline: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    A light theme after The Sims 4's menus: Sims-blue field with facets (rail, frame), white plates on a pale page, blue
    ink, green for whatever is selected, checked or filled, an orange lozenge for a running game. Token names (pl-*) live
    in tokens.css and are measured from captures (../RESEARCH.md). Keys are the shared vocabulary
    (scripts/data/theme-keys.json). Theme XAML reads brushes only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Type: Segoe UI (every Windows has it), Semibold for headings and tabs. The game's own face is proprietary; nothing is bundled. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Segoe UI Semibold}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- Usable metadata content width; apply inside the pane's horizontal padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: plates, rows, inputs and the dialog take the menus' 6px corner; 32px buttons are capsules (16); the 44px Play capsule is 22; discs are circles. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:pl-radius-card}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:pl-radius-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:pl-radius-pill}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:pl-radius-xlarge}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">10000</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">6</Thickness>

    <!-- Playnite palette. GlyphColor (selection, checked, accent fill) is the selected-tab green; TextColorDark is the deep ink printed on it (6.5:1). -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{pl-ink}}</Color>
    <Color x:Key="TextColorDarker">{{pl-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{pl-ink-deep}}</Color>
    <Color x:Key="MainColor">{{pl-white}}</Color>
    <Color x:Key="MainColorDark">{{pl-mist}}</Color>
    <Color x:Key="HoverColor">{{pl-hover}}</Color>
    <Color x:Key="GlyphColor">{{pl-green-bright}}</Color>
    <Color x:Key="HighlightGlyphColor">{{pl-green-bright/40}}</Color>
    <Color x:Key="PopupBackgroundColor">{{pl-white}}</Color>
    <Color x:Key="PopupBorderColor">{{pl-pill-rim}}</Color>
    <Color x:Key="BackgroundToneColor">{{pl-mist}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{pl-line}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{pl-line}}</Color>
    <Color x:Key="DataChangeNotifColor">{{pl-orange-mark}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{pl-pill-rim}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{pl-pill-hi}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{pl-green-ink}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{pl-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{pl-orange-text}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{pl-orange-mark}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{pl-paper}}" />

    <!-- Shared keys: shell layers. The rail and frame are the field blue, the top bar a white strip, the library a pale well. -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{pl-sky}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{pl-mist}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{pl-mist}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{pl-hover}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{pl-green-ink}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{pl-line}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{pl-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{pl-green-tool}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{pl-disc}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{pl-sky-pale}}" />

    <!-- States: green gloss selection with deep ink on it; the running game is the orange lozenge, never green (Play and selection are). -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{pl-green-bright}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{pl-green-hi}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{pl-green-hi}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{pl-green}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{pl-ink-deep}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{pl-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{pl-green-bright}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{pl-hover}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{pl-orange-mark}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{pl-ink-link}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{pl-sky/40}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{pl-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{pl-white}}" />

    <!-- Buttons: pale capsules with blue ink; Play is the white disc plate. -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{pl-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{pl-pill-lo}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{pl-pill-rim}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{pl-pill-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{pl-pill-lo}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{pl-pill-rim}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{pl-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{pl-sky-pale}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{pl-pill-hi}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{pl-pill-rim}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{pl-pill-lo}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{pl-green-tool}}" />

    <!-- Inputs and controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{pl-pill-rim}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{pl-ink-link}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{pl-pill-rim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{pl-green}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{pl-green-hi/50}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{pl-mist}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{pl-sky-hi}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{pl-green-bright}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{pl-green-deep}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{pl-green-bright}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{pl-band}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{pl-ink-label}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{pl-mist}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{pl-band}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{pl-ink-label}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{pl-ink}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{pl-ink-label}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{pl-green-bright}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{pl-sky-hi}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{pl-tab}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{pl-sky}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{pl-green-bright}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{pl-mist}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{pl-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{pl-hover}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{pl-line}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{pl-ink}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{pl-pill-rim}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{pl-white}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{pl-ink}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{pl-ink-label}}" />

    <!-- Section bands (VOLUME, OTHER): the grey-blue band carries deep ink, not the game's white (2.2:1). -->
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{pl-band}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{pl-ink-deep}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{pl-ink}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{pl-ink}}" />

    <!-- Game page. GameBannerTintBrush is paper: a light theme darkens (fades) its banner toward the page, never toward black. -->
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{pl-paper}}" />
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{pl-paper}}" />
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{pl-white}}" />
</ResourceDictionary>
