<!--
    Overlay on Playnite Default/DefaultControls/ListView.xaml (the row only; the list, its column headers and the header
    scroll viewer are Playnite's). Library list view rows: a pale sky hover wash, the green gloss for the selected row
    (SelectedBrush, SelectedSheenBrush lit top, SelectedBorderBrush foot), plus the running game indicator drawn above both
    fills and below the cells. Plumbline's running mark is the orange plumb bob at the far edge, as in DetailsViewItemStyle:
    a 2px frame, a 10 percent wash, a band crossing the row while launching, the bob dropping in as it lands and bobbing
    slowly while running. RowRoom reserves 40px for it and RunningMarkPlate backs it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,1,0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Grid>
                        <Rectangle x:Name="HoverRectangle" Visibility="Collapsed" Fill="{DynamicResource ListItemHoverBrush}" />
                        <Grid x:Name="SelectedRectangle" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle Fill="{DynamicResource SelectedBrush}" />
                            <Rectangle Fill="{DynamicResource SelectedSheenBrush}"><Rectangle.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D9000000" Offset="0" /><GradientStop Color="#00000000" Offset="0.62" /></LinearGradientBrush></Rectangle.OpacityMask></Rectangle>
                            <Rectangle Fill="{DynamicResource SelectedBorderBrush}"><Rectangle.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.4" /><GradientStop Color="#99000000" Offset="1" /></LinearGradientBrush></Rectangle.OpacityMask></Rectangle>
                        </Grid>
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.1" />
                            <Border x:Name="RunningMarkPlate" Visibility="Visible" Width="40" HorizontalAlignment="Right" Margin="2" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.4" CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid Height="2" Margin="10,0,44,2" VerticalAlignment="Bottom">
                                <Rectangle RadiusX="1" RadiusY="1" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" RadiusX="1" RadiusY="1" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Grid x:Name="RunningMarkHost" Width="9" Height="19" Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.9">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="RunningMark" Y="0" />
                                </Grid.RenderTransform>
                                <Viewbox Width="9" Height="19" Stretch="Fill" IsHitTestVisible="False">
                                    <Canvas Width="20" Height="42">
                                        <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 14,26 L 24,18 L 24,26 Z M 14,27.5 L 24,27.5 L 24,45 L 18,45 Z M 18,46.5 L 24,46.5 L 24,60 Z M 24,18 L 34,26 L 24,26 Z M 24,27.5 L 34,27.5 L 30,45 L 24,45 Z M 24,46.5 L 30,46.5 L 24,60 Z" Fill="{DynamicResource RunningIndicatorBrush}" />
                                        <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 14,26 L 24,18 L 24,26 Z M 14,27.5 L 24,27.5 L 24,45 L 18,45 Z M 18,46.5 L 24,46.5 L 24,60 Z" Fill="{DynamicResource PopupBackgroundBrush}" Opacity="0.4" />
                                        <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 24,18 L 34,26 L 24,26 Z M 24,27.5 L 34,27.5 L 30,45 L 24,45 Z M 24,46.5 L 30,46.5 L 24,60 Z" Fill="{DynamicResource TextBrushDark}" Opacity="0.3" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Grid>
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <Border x:Name="RowRoom">
                                <Grid ClipToBounds="True"><GridViewRowPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Stretch" /></Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="HoverRectangle" />
                        </Trigger>
                        <Trigger Property="Selector.IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedRectangle" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverRectangle" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.45" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.452" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" /><SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Y" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-7" /><EasingDoubleKeyFrame KeyTime="0:0:0.95" Value="0"><EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="-7"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMarkHost" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" /><SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Y" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-2" KeySpline="0.4,0 0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- RunningMarkRoom left="0" right="40": the running mark owns this strip of the row, so a long name stops before it. -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,40,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,40,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Selector.IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
