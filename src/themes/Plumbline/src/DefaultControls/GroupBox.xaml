<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml. A white card (ExpanderBackgroundBrush, 1px NormalBorderBrush rim,
    ControlCornerRadius 6) headed the way the Sims heads a settings group: a 24px grey-blue band (HeaderBandBrush) across
    the top with the title centered in uppercase, bold 11px HeaderBandForegroundBrush (Segoe UI has no small caps, no tracking).
    Content-sized: the band takes the card's width and has no width of its own, so Statistics cards still wrap.
    A group box without a header draws just the body.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border DockPanel.Dock="Top" Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <DockPanel>
                            <Border x:Name="HeaderBorder" DockPanel.Dock="Top" Padding="14,0" MinHeight="24"
                                    Background="{DynamicResource HeaderBandBrush}" CornerRadius="5,5,0,0">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                                  TextElement.Foreground="{DynamicResource HeaderBandForegroundBrush}"
                                                  TextElement.FontSize="{DynamicResource FontSizeSmall}" TextElement.FontWeight="Bold">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                              Margin="{TemplateBinding Padding}"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderBorder" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
