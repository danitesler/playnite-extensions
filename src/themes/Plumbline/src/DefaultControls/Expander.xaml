<!--
    Overlay on Playnite Default/DefaultControls/Expander.xaml. Playnite's Expander (also the group headers of the game list, through ExpanderEx
    and the sections of the filter panel). The header is the Sims section band (VOLUME, OTHER): a 24px grey-blue plate (HeaderBandBrush,
    ControlCornerRadius) with a bold HeaderBandForegroundBrush label (uppercase for text headers) and the group chevron
    (IconSubmenu closed, IconDropDown open, same ink). Hover lays a white wash over the band.
    While Playnite's "Use game background image as window background" is on, the header has no plate (Background Transparent
    instead of ExpanderBackgroundBrush, the band hidden) and its label and chevron turn WindowArtForegroundBrush (a light theme's
    ink would vanish on art), so the window art shows through group headers and filter sections.
    The Expander template is Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- The header toggle: Playnite looks it up by this key. Hit area is the whole row. -->
    <Style x:Key="ExpanderDownHeaderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,3,12,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Background="Transparent" Margin="0,2,0,2">
                        <Border x:Name="Face" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource HeaderBandBrush}" Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{DynamicResource HeaderBandForegroundBrush}" TextElement.FontWeight="Bold">
                            <Grid>
                                <Border x:Name="Wash" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False"
                                        Background="{DynamicResource SidebarItemForegroundBrush}" Opacity="0" Margin="-10,-3,-12,-3" />
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <ContentControl x:Name="Closed" Width="12" Height="12" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                                        Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconTemplate}" />
                                        <ContentControl x:Name="Open" Width="12" Height="12" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Visibility="Collapsed"
                                                        Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Grid>
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True">
                                        <ContentPresenter.Resources>
                                            <DataTemplate DataType="{x:Type sys:String}">
                                                <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}"
                                                           FontSize="{DynamicResource FontSizeSmall}" />
                                            </DataTemplate>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Closed" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Open" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.25" />
                        </Trigger>
                        <!-- After the hover trigger: window art on wins. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="Transparent" />
                            <Setter TargetName="Wash" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Face" Property="TextElement.Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Expander}">
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel>
                        <ToggleButton BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                      Style="{DynamicResource ExpanderDownHeaderStyle}"
                                      Padding="{TemplateBinding Padding}"
                                      MinHeight="24" DockPanel.Dock="Top"
                                      Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding Header}"
                                      IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Border" DockPanel.Dock="Top" Visibility="Collapsed"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter Focusable="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="true">
                            <Setter Property="Visibility" TargetName="Border" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
