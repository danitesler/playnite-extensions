<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is a Sims 4 options sheet: a white card (PopupBackgroundBrush, pale rim, 8px corners)
    capped by a 6px strip of the menu's sky facet field (ShellBackgroundBrush with two translucent white facets) and
    closed by a mist foot, the lit-from-the-top look of the game's pale plates. LocalMenuSheetTemplate is shared by
    ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml. Nothing rises above the
    card; rows start 10px below its top. Rows, highlight and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuSheetTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="8" />
            <!-- Sky facet cap -->
            <Grid Height="6" VerticalAlignment="Top" ClipToBounds="True">
                <Border Height="16" VerticalAlignment="Top" Background="{DynamicResource ShellBackgroundBrush}" CornerRadius="8" />
                <Path Data="M 14,0 L 64,0 L 30,6 Z" Fill="{DynamicResource PopupBackgroundBrush}" Opacity="0.22" />
                <Path Data="M 90,6 L 150,0 L 200,0 L 170,6 Z" Fill="{DynamicResource PopupBackgroundBrush}" Opacity="0.16" />
            </Grid>
            <!-- Mist foot, the shaded underside of a lit plate -->
            <Grid Height="3" VerticalAlignment="Bottom" ClipToBounds="True">
                <Border Height="16" VerticalAlignment="Bottom" Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="8" />
            </Grid>
            <Border BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="8" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuSheetTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,10,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="4,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
