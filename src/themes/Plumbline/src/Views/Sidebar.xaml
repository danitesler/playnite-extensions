<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    A 44px compact icon rail (repo shell rule) in the Sims-blue field (ShellBackgroundBrush) with the facet sprite
    (Images/facets-rail.png, a white mask stretched over the rail) laid over it. Rail = the 44x40 items
    (CustomControls/SidebarItem.xaml, 32px discs, 16px glyphs), no gutters. The main menu button (MainMenuButton, defined
    here, also used by Views/TopPanel.xaml when the sidebar is hidden) is a white disc with a 2px pale lip holding the green
    gem (IconMainMenu): 32px in the rail, 40px elsewhere. In the rail it is 6px from the top and either edge, in a 45px slot,
    so the first item (40px) is centered 65px down like the preview.
    Left and right: vertical rail. Right also starts 52px down so the window buttons (Views/TopPanel.xaml keeps the
    same corner clear) sit above it. Top and bottom: a 52px strip (6px above and below the 44x40 items) without the facets;
    the top strip keeps 128px clear on its right for the window buttons (3 x 28 + 2 x 6 gaps + 12 edge + 20 gap).
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts; Playnite collapses PART_ElemMainMenu when the
    main menu lives in the top bar.
    Window art on: the rail is see-through and the facets drop away; Views/Library.xaml draws the art under it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusFull}" />
        <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource NormalBorderBrush}"
                            Background="{DynamicResource TopPanelBackgroundBrush}"
                            x:Name="BorderContentHolder" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <!-- The facet field: a white mask over the sky, never hit-testable. -->
                            <Rectangle x:Name="Facets" Fill="{DynamicResource SidebarItemForegroundBrush}" Visibility="Collapsed"
                                       IsHitTestVisible="False" SnapsToDevicePixels="False">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/facets-rail.png'}" Stretch="Fill" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                        Width="32" Height="32" DockPanel.Dock="Top" Margin="6,6,6,7">
                                    <Control Template="{DynamicResource LocalPlumblineMenuMarkTemplate}" Focusable="False" IsTabStop="False" />
                                </Border>

                                <!-- No side gutter: the 44px items are the rail. 12px of room after the last item. -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" Margin="0,0,0,12" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Facets" />
                        </DataTrigger>
                        <!-- Main menu hidden (it is in the top bar): the items still start at the top bar's bottom edge. -->
                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemMainMenu}" Value="Collapsed">
                            <Setter Property="Margin" Value="0,52,0,0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,52,0,0" />
                            <Setter Property="Margin" Value="6,6,6,7" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Facets" />
                            <Setter Property="Margin" Value="12,10,4,10" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,128,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="4,6,4,6" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Facets" />
                            <Setter Property="Margin" Value="12,10,4,10" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="4,6,4,6" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
