<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details view, right pane).
    The pale page (GameOverviewBackgroundBrush). The banner (HeroArt) is the game's background art faded into the page; the title
    is the game's screen title: a white icon plate over a soft shadow, then the name in the heading face (Segoe UI Semibold, 29px).
    Skeleton as in src/themes/AGENTS.md: banner, proportional spacer, header (icon, name, actions), then the Steam screenshots
    host and skeleton, description and notes on the left and the metadata pane on the right (responsive:
    scripts/game-page-breakpoints.mjs). Cards are white plates (ExpanderBackgroundBrush, a NormalBorderBrush rim, ControlCornerRadius,
    a soft shadow sprite) headed by a 24px grey-blue band (inline: HeaderBandBrush, HeadingTextBlock caps). The metadata pane is one white card with six
    collapsing groups split by pale hairlines; captions 12px muted in a 112px column, values 14px text, links (PropertyItemButton)
    or chips, scores as need bars (a ProgressBar with a round cap holding the number). Actions: Play is the white capsule with the
    overhanging disc (PlayButton, 56px high with its shadow and lift); the context action takes its form; More and Edit are 40px
    white discs (SecondaryButton), always visible, labelled by ToolTip.
    With no game selected: the facet field (facets.png over ShellBackgroundBrush) in a rounded card, the green gem hanging from its
    cord and turning slowly (ControlTemplate.Triggers), LOCErrorNoGameSelected below.
    Every PART_ of Playnite's file is kept, each once. HtmlTextView takes Color-typed properties: the brushes are set on
    TextElement.Foreground and Tag and the Colors are bound from them (the one place theme XAML reads a Color).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Card title: the text of a section band (11px bold caps in the deep ink on the grey-blue band). Used by every overview. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource GroupBoxHeaderFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeaderBandForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Shared pieces of the game pages and Play: GlowFrameTemplate (the soft drop shadow, a 9-slice sprite mask drawn in the host's Foreground),
         BloomTemplate (the shadow of a disc, one stretched sprite) and SecondaryButton (More and Edit). They live in this file because every key must
         be a theme-keys.json role; DynamicResource finds them from every file, so PlayButton.xaml and the grid overview use them too. -->
    <!-- Drop shadows are sprites (Images/shadow-*.png, alpha masks from art/generate-sprites.py), never DropShadowEffect: a host Control
         sets Foreground to the shadow brush (TextBrushDark at 0.3 reads as blue ink) and Opacity, and places itself around the thing it
         shadows. GlowFrameTemplate is a 9-slice (slices 18 / 12 / 18) whose lit edge sits 14px inside the sprite: the host goes at
         Margin -14 around the plate (plus 3 down). Columns and rows are fixed cells plus one star, so it reports no large desired size.
         BloomTemplate is one stretched circle: its disc is 76 of 128px, so the host is 1.684 x the disc (94px for a 56px disc). -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/shadow-plate.png'}" Viewbox="0,0,18,18" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/shadow-plate.png'}" Viewbox="18,0,12,18" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/shadow-plate.png'}" Viewbox="30,0,18,18" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/shadow-plate.png'}" Viewbox="0,18,18,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/shadow-plate.png'}" Viewbox="30,18,18,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/shadow-plate.png'}" Viewbox="0,30,18,18" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/shadow-plate.png'}" Viewbox="18,30,12,18" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/shadow-plate.png'}" Viewbox="30,30,18,18" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="BloomTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Foreground}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/shadow-disc.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- SecondaryButton: More and Edit beside Play. A square 40x40 button drawn as a white disc (square, so a circle is allowed) with a soft
         shadow, a pale rim and an icon in ButtonForegroundBrush. Hover: the disc lifts 1.5px (BackEase) and turns white with a sky rim.
         Pressed: it sinks 1px. Root is transparent so the whole square takes the pointer. -->
    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource BloomTemplate}" Foreground="{DynamicResource TextBrushDark}" Opacity="0.25"
                                 Width="67" Height="67" Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
                        <Grid x:Name="Face" Width="40" Height="40" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="FaceShift" Y="0" />
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                            <Ellipse x:Name="HoverDisc" Fill="{DynamicResource ButtonHoverBackgroundBrush}" Stroke="{DynamicResource SliderThumbHoverBorderBrush}" StrokeThickness="2" Opacity="0" />
                            <Ellipse x:Name="PressedDisc" Fill="{DynamicResource ButtonPressedBackgroundBrush}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Ellipse x:Name="FocusRing" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"
                                     Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="Y" To="-1.5" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverDisc" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="HoverDisc" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedDisc" Property="Opacity" Value="1" />
                            <Setter TargetName="Face" Property="Margin" Value="0,2,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Placeholder for the Steam Screenshots control: a 16:9 main image over a row of five thumbnails (a muted
         fill, radius-md; here the host's Foreground at 15 percent, and a pulse instead of the shimmer, which needs a gradient).
         Each Viewbox scales a 1600px layout to the width its column gives it. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the add-on's ContentControl. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="24"
                        Background="{TemplateBinding Foreground}" Opacity="0.15" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="16" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="2" CornerRadius="16" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="4" CornerRadius="16" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="6" CornerRadius="16" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="8" CornerRadius="16" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible"
                                  Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible"
                                  d:DesignWidth="1280" d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Grid x:Name="PageRoot">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <!-- Banner: the game's background art as a band of GameBannerHeight (0 turns it off), faded into the page by a gradient on top
                                 (not a mask). Collapsed when the game has no background art or Playnite hides the image. -->
                            <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <!-- No OpacityMask on the banner: masked art repainted in part (behind the animated Play button) left dark patches on
                                     scaled displays. A plain gradient runs from transparent white (a light page must not pass through grey)
                                     to the page color (PageRoot). -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.82" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <Grid HorizontalAlignment="Stretch" MaxWidth="1280" Margin="32,0,32,32">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Room above the title: the title sits low on the banner; the spacer shrinks when there is no banner. -->
                                <Border Grid.Row="0" IsHitTestVisible="False" x:Name="DetailsBannerSpacer" MinHeight="32">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 100 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="32" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="32" />
</DataTrigger>
</Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="0,0,0,24" Background="Transparent">
                                    <!-- Cover, sized by Playnite's cover height setting: rounded to ControlCornerRadius by a mask, cached. -->
                                    <Border x:Name="CoverFrame" DockPanel.Dock="Right" Margin="24,0,0,0" VerticalAlignment="Bottom">
                                        <Border.CacheMode>
                                            <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                        </Border.CacheMode>
                                        <Border.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=CoverShape}" />
                                        </Border.OpacityMask>
                                        <Grid>
                                            <Border x:Name="CoverShape" Background="{DynamicResource ExpanderBackgroundBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                                            <Image x:Name="PART_ImageCover"
                                                   Height="{Settings GameDetailsCoverHeight}"
                                                   StretchDirection="Both" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Center" Width="56" Height="56">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageIcon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Control Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource TextBrushDark}" Opacity="0.22"
                                                         Margin="-14,-11,-14,-17" IsHitTestVisible="False" Focusable="False" />
                                                <Border Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" />
                                                <Image x:Name="PART_ImageIcon" MaxHeight="40" MaxWidth="40" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            </Grid>
                                            <TextBlock x:Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLargest}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       LineHeight="36" LineStackingStrategy="BlockLineHeight"
                                                       TextWrapping="Wrap" VerticalAlignment="Center">
<TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Style.Triggers><DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" Height="76" MinWidth="184" />
                                                <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" Height="76" MinWidth="184" />
                                                <Control Style="{DynamicResource RunningActionIndicator}" Margin="50,16,12,16" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Style="{DynamicResource SecondaryButton}" Width="40" Height="40" Padding="0" Margin="12,0,0,0"
                                                    VerticalAlignment="Center" ToolTip="{DynamicResource LOCMoreAction}" Focusable="False">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Style="{DynamicResource SecondaryButton}" Width="40" Height="40" Padding="0" Margin="10,0,0,0" Focusable="False"
                                                    VerticalAlignment="Center" ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Grid.Row="2" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
<Grid Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                        <Control Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource TextBrushDark}" Opacity="0.14"
                                                 Margin="-14,-11,-14,-17" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Stretch" />
                                        <Border x:Name="DetailsPanel" VerticalAlignment="Top"
                                                Background="{DynamicResource ExpanderBackgroundBrush}"
                                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="{DynamicResource ControlBorderThickness}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="16,12,16,14">
                                            <Border.Resources>
                                                <!-- Values are body text; a TextBlock with Tag="Caption" is the field caption (12px, medium, muted) -->
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Tag" Value="Caption">
                                                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                                                            <Setter Property="FontWeight" Value="Medium" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                            <Setter Property="TextWrapping" Value="Wrap" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
