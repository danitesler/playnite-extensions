                                </Grid.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,24">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="EmptyFadeIn">
                                                            <Storyboard>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1" KeySpline="0.25,1,0.5,1" />
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="EmptyFadeIn" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid Width="316" Height="200" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                        <Control Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource TextBrushDark}" Opacity="0.2"
                                                 Margin="-14,-11,-14,-17" IsHitTestVisible="False" Focusable="False" />
                                        <Border x:Name="EmptyFacetCard">
                                            <Border.CacheMode>
                                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                            </Border.CacheMode>
                                            <Border.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=EmptyFacetShape}" />
                                            </Border.OpacityMask>
                                            <Grid>
                                                <Border x:Name="EmptyFacetShape" Background="{DynamicResource ShellBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                <Rectangle Fill="{DynamicResource ExpanderBackgroundBrush}" Opacity="0.9">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="{ThemeFile 'Images/facets.png'}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                                <!-- The gem hangs from its cord and turns slowly (ScaleX 1 to 0.35 over 4s, in ControlTemplate.Triggers). -->
                                                <Viewbox Width="72" Height="96" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" Stretch="Uniform">
                                                    <Grid x:Name="EmptyGem" RenderTransformOrigin="0.5,0">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform x:Name="EmptyGemTurn" ScaleX="1" />
                                                        </Grid.RenderTransform>
                                                        <Canvas Width="48" Height="64">
