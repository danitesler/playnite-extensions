                                                                    <Grid x:Name="PART_ElemInstallSize" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Tag="Caption" Text="{DynamicResource LOCInstallSizeLabel}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="2" x:Name="PART_TextInstallSize" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemInstallDirectory" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Tag="Caption" Text="{DynamicResource LOCGameInstallDirTitle}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                        <Button Grid.Column="2" x:Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" />
