                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Tag="Caption" Text="{DynamicResource LOCGameProviderTitle}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                        <Button Grid.Column="2" x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemSource" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Tag="Caption" Text="{DynamicResource LOCSourceLabel}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                        <Button Grid.Column="2" x:Name="PART_ButtonSource" HorizontalAlignment="Left" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemVersion" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Tag="Caption" Text="{DynamicResource LOCVersionLabel}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                        <Button Grid.Column="2" x:Name="PART_ButtonVersion" HorizontalAlignment="Left" />
