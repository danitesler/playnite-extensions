<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml (grid view, side panel).
    The same page as DetailsViewGameOverview.xaml in a narrow panel: the pale page (GameOverviewBackgroundBrush), the banner faded into
    it, the title beside a white icon plate, the Play capsule with its overhanging disc under it, white cards headed by grey-blue bands,
    the metadata pane as one white card with need bars for the scores.
    The close button (CloseGameSideBarCommand) is the 28x28 plate in the top-left corner (inline left of the icon when the
    banner is below 120px), a DangerBrush plate fading in on hover.
    With no game selected: the facet field card with the green gem hanging from its cord and turning slowly, LOCErrorNoGameSelected below.
    Every PART_ of Playnite's file is kept, each once.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
<!-- Empty state (no game selected): the facet field card with the green gem, centered in the panel. It fades in over 0.45s;
                                 the gem's turn is in ControlTemplate.Triggers. -->
                            <Grid VerticalAlignment="Stretch">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,24">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="EmptyFadeIn">
                                                            <Storyboard>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1" KeySpline="0.25,1,0.5,1" />
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="EmptyFadeIn" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid Width="260" Height="180" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                        <Control Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource TextBrushDark}" Opacity="0.2"
                                                 Margin="-14,-11,-14,-17" IsHitTestVisible="False" Focusable="False" />
                                        <Border x:Name="EmptyFacetCard">
                                            <Border.CacheMode>
                                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                            </Border.CacheMode>
                                            <Border.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=EmptyFacetShape}" />
                                            </Border.OpacityMask>
                                            <Grid>
                                                <Border x:Name="EmptyFacetShape" Background="{DynamicResource ShellBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                <Rectangle Fill="{DynamicResource ExpanderBackgroundBrush}" Opacity="0.9">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="{ThemeFile 'Images/facets.png'}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                                <!-- The gem hangs from its cord and turns slowly (ScaleX 1 to 0.35 over 4s, in ControlTemplate.Triggers). -->
                                                <Viewbox Width="63" Height="84" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,18,0,0" Stretch="Uniform">
                                                    <Grid x:Name="EmptyGem" RenderTransformOrigin="0.5,0">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform x:Name="EmptyGemTurn" ScaleX="1" />
                                                        </Grid.RenderTransform>
                                                        <Canvas Width="48" Height="64">
                                                        <Path Data="M 29,6.5 A 5,5 0 1 0 19,6.5 A 5,5 0 1 0 29,6.5 Z M 24,11.5 L 24,18" Stroke="{DynamicResource ExpanderBackgroundBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        <Path Data="M 14,26 L 24,18 L 24,26 Z M 14,27.5 L 24,27.5 L 24,45 L 18,45 Z" Fill="{DynamicResource SelectedHoverBrush}" />
                                                        <Path Data="M 24,18 L 34,26 L 24,26 Z M 24,27.5 L 34,27.5 L 30,45 L 24,45 Z" Fill="{DynamicResource SelectedBorderBrush}" />
                                                        <Path Data="M 18,46.5 L 24,46.5 L 24,60 Z" Fill="{DynamicResource SelectedBrush}" />
                                                        <Path Data="M 24,46.5 L 30,46.5 L 24,60 Z" Fill="{DynamicResource ProgressBarTrackBrush}" />
                                                    </Canvas>
                                                    </Grid>
                                                </Viewbox>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240" Margin="0,22,0,0" IsHitTestVisible="False"
                                               FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer CanContentScroll="False" x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                                <Grid x:Name="PageRoot">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <Trigger Property="DataContext" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                <!-- Banner: the game's background art as a band of GameBannerHeight (0 turns it off), faded into the page by a gradient on top
                                     (not a mask). Collapsed when the game has no background art or Playnite hides the image. -->
                                <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                    <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <!-- No OpacityMask on the banner: masked art repainted in part (behind the animated Play button) left dark patches on
                                     scaled displays. A plain gradient runs from transparent white (a light page must not pass through grey)
                                     to the page color (PageRoot). -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.82" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                </Grid>
                                    <Grid Margin="24,0,24,24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                    <!-- Room above the title: the title sits low on the banner; the spacer shrinks when there is no banner. -->
                                    <Border Grid.Row="0" IsHitTestVisible="False" MinHeight="24" x:Name="GridBannerSpacer">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 72 / 320'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                        <Setter Property="Height" Value="24" />
                                                    </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="24" />
</DataTrigger>
</Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Panel.ZIndex="2" Grid.Row="1" Margin="0,0,0,20">
                                        <DockPanel Panel.ZIndex="2">
                                            <Button x:Name="InlineSidePanelCloseButton" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" Width="28" Height="28" Padding="0"
                                                Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}" Command="{MainViewModel CloseGameSideBarCommand}"
                                                Template="{Binding Template, ElementName=SidePanelCloseButton}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="{Binding Tag, ElementName=SidePanelCloseButton, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Visible` : `Collapsed`'}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                    <Button.RenderTransform>
                                                        <TranslateTransform Y="{Binding ContentVerticalOffset, ElementName=PART_ScrollViewHost}" />
                                                    </Button.RenderTransform>
                                            </Button>
                                            <Grid DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center" Width="48" Height="48">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageIcon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Control Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource TextBrushDark}" Opacity="0.22"
                                                         Margin="-14,-11,-14,-17" IsHitTestVisible="False" Focusable="False" />
                                                <Border Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" />
                                                <Image x:Name="PART_ImageIcon" MaxHeight="32" MaxWidth="32" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            </Grid>
                                            <TextBlock x:Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLargest}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       LineHeight="36" LineStackingStrategy="BlockLineHeight"
                                                       TextWrapping="Wrap" VerticalAlignment="Center">
<TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Style.Triggers><DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </DockPanel>
                                        <Grid Margin="0,12,0,0" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MaxWidth="180" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" Height="76" />
                                                <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" Height="76" />
                                                <Control Style="{DynamicResource RunningActionIndicator}" Margin="44,16,0,16" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Style="{DynamicResource SecondaryButton}" Grid.Column="1" Width="40" Height="40" Padding="0" Margin="12,0,0,0"
                                                    VerticalAlignment="Center" ToolTip="{DynamicResource LOCMoreAction}" Focusable="False">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                                                Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Style="{DynamicResource SecondaryButton}" Grid.Column="2" Width="40" Height="40" Padding="0" Margin="10,0,0,0" Focusable="False"
                                                    VerticalAlignment="Center" ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <Grid Grid.Row="2" x:Name="GridOverviewBody">
<Grid.Tag>
    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400">
        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Tag" ElementName="GridMetadataContent" />
    </MultiBinding>
</Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>


                                        <Grid x:Name="GridMainColumn" VerticalAlignment="Top">
<Grid.Style><Style TargetType="Grid">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
    </DataTrigger></Style.Triggers>
</Style></Grid.Style>
<Grid.MaxWidth>
    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="z == true ? x : Max(0, x - y - 24)">
        <Binding Path="ActualWidth" ElementName="GridOverviewBody" />
        <Binding Path="ActualWidth" ElementName="GridMetadataColumn" />
        <Binding Path="Tag" ElementName="GridOverviewBody" />
    </MultiBinding>
</Grid.MaxWidth>
<StackPanel>
                                            <!-- Steam Screenshots add-on: its host control, and a skeleton while it loads. The bindings use FallbackValue=PluginUnavailable
                                                 (not False): with the add-on missing or disabled neither the section nor the skeleton shows. The add-on hides its
                                                 control and clears IsControlVisible on every game change and needs about a second, so a Steam library game shows the
                                                 section (skeleton) in that gap, for at most 12 s. -->
                                            <Grid x:Name="SteamScreenshotsGameScope">
                                                <!-- Plugin visibility is shared: a late Steam load must never reveal a different game's section. -->
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Game.Source.Name}" Value="Steam">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                    <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                    <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid Margin="0,0,0,24">
                                                    <Control Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource TextBrushDark}" Opacity="0.14"
                                                     Margin="-14,-11,-14,-17" IsHitTestVisible="False" Focusable="False" />
                                                    <Border Background="{DynamicResource ExpanderBackgroundBrush}"
                                                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="{DynamicResource ControlBorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                    <StackPanel>
                                                        <Grid Height="24" SnapsToDevicePixels="True">
                                                        <Border Background="{DynamicResource HeaderBandBrush}" CornerRadius="5,5,0,0" />
                                                        <Border Background="{DynamicResource ButtonHoverBackgroundBrush}" Opacity="0.3" CornerRadius="5,5,0,0" IsHitTestVisible="False">
                                                            <Border.OpacityMask>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="Black" Offset="0" />
                                                                    <GradientStop Color="Transparent" Offset="0.7" />
                                                                </LinearGradientBrush>
                                                            </Border.OpacityMask>
                                                        </Border>
                                                        <ContentControl Content="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </Grid>
                                                        <Grid Margin="14,12,14,14">
                                                            <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                            <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}"
                                                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                                <Control.Style>
                                                                    <Style TargetType="Control">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Control.Style>
                                                            </Control>
                                                        </Grid>
                                                    </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                            </Grid>
                                            <Grid Margin="0,0,0,24">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemDescription}" Value="Collapsed">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Control Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource TextBrushDark}" Opacity="0.14"
                                                     Margin="-14,-11,-14,-17" IsHitTestVisible="False" Focusable="False" />
                                                <Border Background="{DynamicResource ExpanderBackgroundBrush}"
                                                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="{DynamicResource ControlBorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <StackPanel x:Name="PART_ElemDescription">
                                                    <Grid Height="24" SnapsToDevicePixels="True">
                                                        <Border Background="{DynamicResource HeaderBandBrush}" CornerRadius="5,5,0,0" />
                                                        <Border Background="{DynamicResource ButtonHoverBackgroundBrush}" Opacity="0.3" CornerRadius="5,5,0,0" IsHitTestVisible="False">
                                                            <Border.OpacityMask>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="Black" Offset="0" />
                                                                    <GradientStop Color="Transparent" Offset="0.7" />
                                                                </LinearGradientBrush>
                                                            </Border.OpacityMask>
                                                        </Border>
                                                        <ContentControl Content="{DynamicResource LOCGameDescriptionTitle}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </Grid>
                                                    <HtmlTextView x:Name="PART_HtmlDescription" Margin="14,12,14,14"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"
                                                                  Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Grid Margin="0,0,0,24">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemNotes}" Value="Collapsed">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Control Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource TextBrushDark}" Opacity="0.14"
