                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaLinks" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource PanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Grid x:Name="PART_ElemLinks" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Tag="Caption" Text="{DynamicResource LOCLinksLabel}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                        <ItemsControl Grid.Column="2" x:Name="PART_ItemsLinks" />
                                                                    </Grid>
