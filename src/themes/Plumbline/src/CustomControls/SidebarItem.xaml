<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    Rail item: a 44x40 compact item (repo shell rule) holding a 32px disc, the pack discs on the Sims menu's blue field:
    SidebarItemSelectedForegroundBrush (the deep disc blue) with a SidebarItemForegroundBrush (white) glyph. Hover: a white wash
    fades over the disc and the disc pops 1.08x with a small overshoot. The current item is a white disc with a deep blue
    glyph and a 2px SidebarItemSelectedGlowBrush (pale sky) ring. The whole 44x40 item is the hit target.
    Icons are scaled into a fixed 16x16 IconHost centered in the disc (no IconPadding); Library and Statistics use the
    theme's icons. PART_ProgressStatus (shown while an add-on reports progress) is a thin bar along the disc's bottom.
    An item with no content is a bare marker: WarningBrush fill.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Grid x:Name="Tile" SnapsToDevicePixels="True" Width="32" Height="32"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5"
                              TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                            <Ellipse x:Name="HoverWash" Fill="{DynamicResource TopPanelItemHoverBackgroundBrush}" Opacity="0"
                                     IsHitTestVisible="False" />
                            <Grid x:Name="IconHost" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox x:Name="ItemIcon">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Viewbox>
                                <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                IsHitTestVisible="False"
                                                ContentTemplate="{DynamicResource IconTemplate}" />
                            </Grid>
                        </Grid>
                        <ProgressBar x:Name="PART_ProgressStatus" Height="4" Padding="0" Margin="12,0,12,3"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource SidebarItemSelectedGlowBrush}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- The current item is a white disc: the wash would vanish on it, so it stays off. -->
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverWash" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
