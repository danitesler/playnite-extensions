<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml: the frame around a cover tile in the grid view.
    Covers are 6px rounded rectangles. Hover (animated layers): a 3px frame in GridViewItemHoverBorderBrush (the sky of
    the pack preview tile) fades in over 0.2s, and a white corner badge (NormalBrush) at the bottom-left pops in with a
    small green play circle (BackEase, 0.2s). Selected (static): the same 3px frame in GridViewItemSelectedBorderBrush
    (green). Leaving reverses the hover over 0.25s (FillBehavior Stop).
    Running (IsLaunching / IsRunning): a 2px RunningIndicatorBrush frame inset inside the selection frame, a wash, a band
    crossing the cover while launching, a foot line, and the orange plumb bob on a white disc at the top-right. The bob
    drops into place as the band lands (launching) and bobs 3px over 2.4s (running). The tile is GridViewItemTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <ContentPresenter />
                        <Border x:Name="HoverBorder" BorderThickness="3" Margin="0" IsHitTestVisible="False" Opacity="0"
                                BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}"
                                CornerRadius="6" />
                        <Border x:Name="SelectionBorder" BorderThickness="3" Margin="0" IsHitTestVisible="False"
                                CornerRadius="6" />
                        <Border x:Name="HoverBadge" Width="30" Height="30" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Background="{DynamicResource NormalBrush}" CornerRadius="0,12,0,3" Opacity="0" IsHitTestVisible="False">
                            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,2,0" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="BadgePop" ScaleX="0.4" ScaleY="0.4" />
                                </Grid.RenderTransform>
                                <Ellipse Fill="{DynamicResource SelectedBrush}" Stroke="{DynamicResource SelectedBorderBrush}" StrokeThickness="1" />
                                <ContentControl Width="9" Height="9" Margin="1,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                                                Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource SelectedForegroundBrush}" />
                            </Grid>
                        </Border>
                        <Grid x:Name="RunningIndicator" Margin="3" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Margin="3" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="8" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0.18" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" Margin="3" CornerRadius="{DynamicResource CornerRadiusSmall}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningFrame" Margin="3" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                            <Grid x:Name="RunningMarkHost" Width="26" Height="26" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="RunningMark" Y="0" />
                                </Grid.RenderTransform>
                                <Ellipse Fill="{DynamicResource PopupBackgroundBrush}" Opacity="0.94" />
                                <Ellipse Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" />
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" Width="9" Height="19" Stretch="Fill" IsHitTestVisible="False">
                                                            <Canvas Width="20" Height="42">
                                                                <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 14,26 L 24,18 L 24,26 Z M 14,27.5 L 24,27.5 L 24,45 L 18,45 Z M 18,46.5 L 24,46.5 L 24,60 Z M 24,18 L 34,26 L 24,26 Z M 24,27.5 L 34,27.5 L 30,45 L 24,45 Z M 24,46.5 L 30,46.5 L 24,60 Z" Fill="{DynamicResource RunningIndicatorBrush}" />
                                                                <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 14,26 L 24,18 L 24,26 Z M 14,27.5 L 24,27.5 L 24,45 L 18,45 Z M 18,46.5 L 24,46.5 L 24,60 Z" Fill="{DynamicResource PopupBackgroundBrush}" Opacity="0.4" />
                                                                <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 24,18 L 34,26 L 24,26 Z M 24,27.5 L 34,27.5 L 30,45 L 24,45 Z M 24,46.5 L 30,46.5 L 24,60 Z" Fill="{DynamicResource TextBrushDark}" Opacity="0.3" />
                                                            </Canvas>
                                                        </Viewbox>
                            </Grid>
                            <Grid Height="2" Margin="16,0,16,12" VerticalAlignment="Bottom">
                                <Rectangle RadiusX="1" RadiusY="1" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" RadiusX="1" RadiusY="1" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="HoverBadge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BadgePop" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BadgePop" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="HoverBadge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter TargetName="HoverBadge" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.45" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.452" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" /><SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Y" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-9" /><EasingDoubleKeyFrame KeyTime="0:0:0.95" Value="0"><EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="-9"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMarkHost" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter TargetName="HoverBadge" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" /><SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Y" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-3" KeySpline="0.4,0 0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
