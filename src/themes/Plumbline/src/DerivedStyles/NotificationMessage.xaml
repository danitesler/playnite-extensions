<!--
    Overlay on Playnite Default/DerivedStyles/NotificationMessage.xaml: a message in the notifications panel.
    The game's notification card: a deep blue plate (SidebarItemSelectedForegroundBrush, ControlCornerRadius) with white text
    (PopupBackgroundBrush), a white 34px tile at the left holding the green plumb bob, and a red round close button
    (DangerBrush, IconClear in DangerForegroundBrush) on the top-right corner. Hover lights the plate with a faint white wash.
    Commands and bindings are Playnite's. The preview's title and footer lines have no data in Playnite (a message is only
    Text), so they are not drawn.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="NotificationMessage" TargetType="Button">
        <Setter Property="Command" Value="{Binding ActivateCommand}" />
        <Setter Property="Margin" Value="10,8,10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Card" Background="{DynamicResource SidebarItemSelectedForegroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Wash" Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="34" Height="34" Margin="10,10,0,10" VerticalAlignment="Top" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource PopupBackgroundBrush}" IsHitTestVisible="False">
                                <Viewbox Width="12" Height="25" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="20" Height="42">
                                        <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 14,26 L 24,18 L 24,26 Z M 14,27.5 L 24,27.5 L 24,45 L 18,45 Z M 18,46.5 L 24,46.5 L 24,60 Z" Fill="{DynamicResource SelectedSheenBrush}" />
                                        <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 24,18 L 34,26 L 24,26 Z M 24,27.5 L 34,27.5 L 30,45 L 24,45 Z M 24,46.5 L 30,46.5 L 24,60 Z" Fill="{DynamicResource SelectedBorderBrush}" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <Button DockPanel.Dock="Right" Width="22" Height="22" Margin="0,6,6,0" VerticalAlignment="Top"
                                    Focusable="False" Cursor="Hand" Command="{Binding CloseCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Ellipse x:Name="Disc" Fill="{DynamicResource DangerBrush}" Stroke="{DynamicResource PopupBackgroundBrush}" StrokeThickness="0" IsHitTestVisible="False" />
                                            <ContentControl Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                                                            Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{DynamicResource DangerForegroundBrush}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Disc" Property="StrokeThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="{Binding Text}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Foreground="{DynamicResource PopupBackgroundBrush}"
                                       Margin="12,10,6,10" TextWrapping="Wrap"
                                       MinHeight="34" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
