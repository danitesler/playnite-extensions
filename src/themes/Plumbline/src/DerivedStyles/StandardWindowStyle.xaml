<!--
    Plumbline: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    A 48px white band (WindowTitleBackgroundBrush) with a 1px hairline under it: the title centered in the heading face
    (Segoe UI Semibold, 22px, WindowTitleForegroundBrush), the gem medallion at the left (a 40px white disc, a 2px
    SidebarItemSelectedGlowBrush ring, a disc shadow from shadow-disc.png, the green plumb bob drawn from SelectedSheenBrush
    and SelectedBorderBrush) and the round caption buttons (WindowBarButton, 26px discs) at the right. The two side
    columns share a 64px minimum so the title sits at the window's center whenever there is one caption button.
    The window body is the white dialog (PopupBackgroundBrush) with a 1px NormalBorderBrush edge.
    Caption height and the content offset are both 48 (Default 25). PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="48" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource NormalBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="48" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}">
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource PanelSeparatorBrush}" IsHitTestVisible="False" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="64" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The medallion: the theme's plumb bob in a white disc. -->
                                        <Grid Grid.Column="0" Width="40" Height="40" Margin="12,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <Rectangle Width="67" Height="67" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3" Fill="{DynamicResource TextBrushDark}">
                                                <Rectangle.RenderTransform>
                                                    <TranslateTransform Y="3" />
                                                </Rectangle.RenderTransform>
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="{ThemeFile 'Images/shadow-disc.png'}" Stretch="Fill" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                            <Ellipse Fill="{DynamicResource NormalBrush}" Stroke="{DynamicResource SidebarItemSelectedGlowBrush}" StrokeThickness="2" />
                                            <Viewbox Width="15" Height="20" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="20" Height="42">
                                                    <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 14,26 L 24,18 L 24,26 Z M 14,27.5 L 24,27.5 L 24,45 L 18,45 Z M 18,46.5 L 24,46.5 L 24,60 Z" Fill="{DynamicResource SelectedSheenBrush}" />
                                                    <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 24,18 L 34,26 L 24,26 Z M 24,27.5 L 34,27.5 L 30,45 L 24,45 Z M 24,46.5 L 30,46.5 L 24,60 Z" Fill="{DynamicResource SelectedBorderBrush}" />
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" x:Name="PART_TextTitle"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="22"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}" TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource BaseTextBlockStyle}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,48,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
