<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml: the Play / Install button on the game page.
    The game's Play disc: a 44px white capsule (PrimaryButtonBackgroundBrush face, CornerRadiusXLarge 22) with a 56px white disc
    overhanging its left end that holds a green triangle (IconPlay). The button is 56px high so the disc and the capsule's lift and
    shadow stay inside its bounds; the capsule starts 28px in and 6px down, and the label sits right of the disc.
    Layers, bottom to top: PlateShadow and DiscShadow (sprite masks, 3px lower), then in Face (the part that lifts): Rest plate,
    RunningLift (a white veil so the deep-ink label keeps 4.5:1 on the orange fill), RunningScan, HoverPlate, PressedPlate, Sweep
    (sheen.png through an OpacityMask, clipped to the capsule by the Rest plate's shape), RunningHoverLift, the label, then the
    disc: DiscRest, DiscHover, the triangle (SelectedBorderBrush with a PositiveRatingBrush rim; it has no key of its own for the
    game's #41a833, see AGENTS.md), and Bloom (bloom.png through an OpacityMask over PrimaryButtonGlowBrush, the lit sky ring).
    Hover (200ms, BackEase): Face lifts 2px, Bloom fades in and grows from 0.9 to 1, HoverPlate and DiscHover fade in, the triangle
    brightens (SelectedBrush), the sheen crosses once (380ms). Leaving drops it back. Pressed: its own PressShift sinks the Face 2px
    (110ms), Bloom contracts to 0.9, PressedPlate fades in. Keyboard focus: FocusVisual. Disabled: BaseStyle opacity.
    Launching and running keep the plate and fill it with RunningIndicatorBrush (orange, never green) under a deep-ink label; the
    overlay (RunningActionIndicator) draws the gem in the disc. Tag="ContextAction" (Install, Update, RUNNING): the triangle is
    swapped for the download glyph.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages (Playnite shows RUNNING or
        LAUNCHING there). The host sits at Margin="28,6,0,6" so the control is exactly the capsule: an orange frame and 10 percent wash
        around it, and the orange plumb-bob gem hanging in the disc (it overhangs the capsule's left end by 28px, via negative margins): it bobs 3px every 2.4s while running and drops into place while a white band sweeps the capsule while launching.
        The capsule's own label room (PlayRoom) keeps the label clear: the gem lives in the disc, left of the label.
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching). Never hit-testable.
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource CornerRadiusXLarge}" Opacity="0.1" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource ButtonHoverBackgroundBrush}" Opacity="0.4" CornerRadius="{DynamicResource CornerRadiusXLarge}" IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.5" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="0" CornerRadius="{DynamicResource CornerRadiusXLarge}" />
                        </Grid>
                        <!-- The disc ring and the gem (art/mark-path.txt, orange set): left facets lit, right shaded, a cord above. -->
                        <Ellipse Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="Transparent" Margin="-28,0,0,0"
                                 Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="0" />
                        <Viewbox Width="26" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-13,0,0,0" Stretch="Uniform">
                            <Viewbox.RenderTransform>
                                <TranslateTransform x:Name="RunningGemShift" Y="0" />
                            </Viewbox.RenderTransform>
                            <Canvas Width="48" Height="64">
                                <Path Data="M 24,11 L 24,18" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="2.5" />
                                <Path Data="M 14,26 L 24,18 L 24,26 Z M 14,27.5 L 24,27.5 L 24,45 L 18,45 Z M 18,46.5 L 24,46.5 L 24,60 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.78" />
                                <Path Data="M 24,18 L 34,26 L 24,26 Z M 24,27.5 L 34,27.5 L 30,45 L 24,45 Z M 24,46.5 L 30,46.5 L 24,60 Z" Fill="{DynamicResource RunningIndicatorBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.5" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.502" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.502" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <!-- The gem drops into the disc, overshoots a touch and settles while the band crosses. -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGemShift" Storyboard.TargetProperty="Y" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-12" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="1.5" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="-12" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGemShift" Storyboard.TargetProperty="Y" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="38,0,26,0" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True" Margin="22,10,12,10">
                        <!-- Shadows: the plate's lit edge is 14px inside its sprite; the disc is 76 of 128px. Both sit 3px lower. -->
                        <Grid x:Name="PlateShadow" IsHitTestVisible="False" Focusable="False">
                            <Border Margin="26,7,-2,1" CornerRadius="24" Background="{DynamicResource TextBrushDark}" Opacity="0.04" />
                            <Border Margin="27,8,-1,2" CornerRadius="23" Background="{DynamicResource TextBrushDark}" Opacity="0.05" />
                            <Border Margin="28,9,0,3" CornerRadius="{DynamicResource CornerRadiusXLarge}" Background="{DynamicResource TextBrushDark}" Opacity="0.10" />
                        </Grid>
                        <Control x:Name="DiscShadow" Template="{DynamicResource BloomTemplate}" Foreground="{DynamicResource TextBrushDark}" Opacity="0.3"
                                 Width="94" Height="94" Margin="-19,-16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 IsHitTestVisible="False" Focusable="False" />
                        <Grid x:Name="Face" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="FaceShift" Y="0" />
                                    <TranslateTransform x:Name="PressShift" Y="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <!-- The capsule: 44px tall, starting 28px in (under the disc's centre line). -->
                            <Grid x:Name="Capsule" Margin="28,6,0,6">
                                <Border x:Name="Rest" SnapsToDevicePixels="True" CornerRadius="{DynamicResource CornerRadiusXLarge}"
                                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" />
                                <Border x:Name="RunningLift" CornerRadius="{DynamicResource CornerRadiusXLarge}" Background="{DynamicResource ButtonHoverBackgroundBrush}" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource ButtonHoverBackgroundBrush}" Opacity="0.4" CornerRadius="{DynamicResource CornerRadiusXLarge}" IsHitTestVisible="False">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.5" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Grid x:Name="HoverFx">
                                    <Border x:Name="HoverPlate" CornerRadius="{DynamicResource CornerRadiusXLarge}" Opacity="0" IsHitTestVisible="False"
                                            Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                                    <Border x:Name="PressedPlate" CornerRadius="{DynamicResource CornerRadiusXLarge}" Opacity="0" IsHitTestVisible="False"
                                            Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                                    <!-- The sheen: sheen.png as the mask of a white rectangle that slides across; the Rest plate's shape clips it. -->
                                    <Grid x:Name="Sweep" ClipToBounds="True" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                                        <Grid.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=Rest}" Stretch="None" />
                                        </Grid.OpacityMask>
                                        <Canvas>
                                            <Rectangle Width="70" Height="44" Fill="{DynamicResource ButtonHoverBackgroundBrush}">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="{ThemeFile 'Images/sheen.png'}" Stretch="Fill" />
                                                </Rectangle.OpacityMask>
                                                <Rectangle.RenderTransform>
                                                    <TranslateTransform x:Name="SweepX" X="-70" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                        </Canvas>
                                    </Grid>
                                </Grid>
                                <Border x:Name="RunningHoverLift" CornerRadius="{DynamicResource CornerRadiusXLarge}" Background="{DynamicResource ButtonHoverBackgroundBrush}" Opacity="0" IsHitTestVisible="False" />
                                <!-- PlayRoom: the label's room. While launching or running it keeps 28px clear on the right for the focus of the state. -->
                                <Border x:Name="PlayRoom">
                                    <ContentPresenter x:Name="PlayContent" Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      RecognizesAccessKey="True" />
                                </Border>
                                <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28,0,0,0"
                                           FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                            <!-- Bloom: the lit sky ring around the disc (bloom.png is a ring at 0.78 of its half width, around a 0.70 disc: 56 / 0.70 = 80, drawn at 88). -->
                            <Rectangle x:Name="Bloom" Visibility="Collapsed" Width="76" Height="76" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-10,0,0,0"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/bloom.png'}" Stretch="Fill" />
                                </Rectangle.OpacityMask>
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="BloomScale" ScaleX="0.9" ScaleY="0.9" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <!-- The disc: 56px, overhanging the capsule's left end. -->
                            <Grid x:Name="Disc" Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Ellipse x:Name="DiscRest" Fill="{DynamicResource PrimaryButtonBackgroundBrush}" Stroke="{DynamicResource PrimaryButtonBorderBrush}" StrokeThickness="1" />
                                <Ellipse x:Name="DiscHover" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Opacity="0" />
                                <Ellipse x:Name="DiscPressed" Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0" />
                                <Grid x:Name="DiscGlyph" Margin="3,0,0,0" Width="22" Height="26">
                                    <Path x:Name="Triangle" Data="{DynamicResource IconPlay}" Stretch="Fill"
                                          Fill="{DynamicResource SelectedBorderBrush}" Stroke="{DynamicResource PositiveRatingBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" />
                                    <Path x:Name="TriangleHover" Data="{DynamicResource IconPlay}" Stretch="Fill" Opacity="0"
                                          Fill="{DynamicResource SelectedBrush}" Stroke="{DynamicResource PositiveRatingBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" />
                                </Grid>
                                <ContentPresenter x:Name="DiscContext" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                                  TextElement.Foreground="{DynamicResource PositiveRatingBrush}"
                                                  Content="{DynamicResource IconDownload}" ContentTemplate="{DynamicResource IconTemplate}" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="DiscGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DiscContext" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DiscGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DiscContext" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningLift" Property="Opacity" Value="0.22" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.5" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.502" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.502" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DiscGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DiscContext" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningLift" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.22" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.22" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverLift" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="PlayPressIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="2" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="DiscPressed" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="BloomScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="BloomScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="DiscPressed" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="HoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BloomScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BloomScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="DiscHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="TriangleHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="SweepX" Storyboard.TargetProperty="X" From="-70" To="260" Duration="0:0:0.38">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="BloomScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="BloomScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="DiscHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="TriangleHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- RunningMarkRoom: the state keeps 14px clear on the right of the label (the label never meets the capsule's end or a mark). -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,10,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="28,0,10,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,10,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="28,0,10,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Launching and running keep Play's plate, filled with the running colour under a deep-ink label (the white RunningLift veil keeps it at 4.5:1 and better). -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsRunning}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
