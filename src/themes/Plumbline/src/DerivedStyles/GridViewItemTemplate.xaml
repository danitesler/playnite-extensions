<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemTemplate.xaml: the cover tile of the grid view.
    Structure from Default 10.60 (PART_PanelHost, PART_ImageCover, PART_ButtonPlay, PART_ButtonInfo; the empty-cover name
    and darken-uninstalled rules are kept). Covers use a rounded transparency mask (radius 6) matching the frame
    GridViewItemStyle draws around them.
    Hover: the cover zooms to 1.03 (0.6s, ease out); a dark scrim at 0.3 settles it over 0.15s; the two round buttons
    fade in over 0.15s and pop in from 0.85 to 1 with a small overshoot (BackEase, 0.2s), Info 60ms after Play.
    Leaving reverses it in 0.15s (FillBehavior Stop, panel hidden by a Visibility keyframe).
    Buttons (GridTileButton): 36px white discs on a soft disc shadow (shadow-disc.png as a mask) with IconPlay (IconDownload
    for games that are not installed, green) and IconInfo (blue). Hover: the Play bloom (bloom.png as a mask over
    PrimaryButtonGlowBrush) fades in around the disc at small scale and the disc swells to 1.06 with an overshoot; pressed
    shrinks it to 0.94 and tightens the bloom. The root grid is transparent so the whole disc is the hit area.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="GridTileButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Swell" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Rectangle Width="61" Height="61" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.3" Fill="{DynamicResource TextBrushDark}">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform Y="3" />
                                </Rectangle.RenderTransform>
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/shadow-disc.png'}" Stretch="Fill" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle x:Name="Bloom" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="BloomScale" ScaleX="1" ScaleY="1" />
                                </Rectangle.RenderTransform>
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/bloom.png'}" Stretch="Fill" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Ellipse x:Name="Face" Fill="{DynamicResource NormalBrush}" Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1" IsHitTestVisible="False" />
                            <ContentPresenter Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleX" From="1" To="1.06" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleY" From="1" To="1.06" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BloomScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="BloomScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BloomScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BloomScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="BloomScale" Storyboard.TargetProperty="ScaleX" To="0.8" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="BloomScale" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleX" From="0.94" To="1.06" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleY" From="0.94" To="1.06" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="Transparent">
                        <StackPanel Name="PART_PanelHost"
                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">

                            <Grid Width="{Settings GridItemWidth}"
                                  Height="{Settings GridItemHeight}">
                                <!-- Rounded cover and scrims; controls remain outside the mask. -->
                                <Grid x:Name="CoverHost" ClipToBounds="True">
                                    <Grid.OpacityMask><VisualBrush Stretch="Fill"><VisualBrush.Visual><Border Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}" CornerRadius="6" Background="Black" /></VisualBrush.Visual></VisualBrush></Grid.OpacityMask>
                                    <Border x:Name="CoverShape" Background="{DynamicResource ExpanderBackgroundBrush}" />
                                    <Image Name="PART_ImageCover"
                                           RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Stretch="{Settings CoverArtStretch}" RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <ScaleTransform x:Name="CoverZoom" ScaleX="1" ScaleY="1" />
                                        </Image.RenderTransform>
                                    </Image>
                                    <Grid x:Name="TextGameName" Visibility="Collapsed">
                                        <Border Background="{DynamicResource WindowBackgourndBrush}" Opacity="0.6" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap" Margin="5"
                                                   Style="{StaticResource BaseTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <!-- Darken uninstalled (static) and the hover scrim (animated) are separate layers. -->
                                    <Border x:Name="BorderUninstalled" Background="{DynamicResource WindowBackgourndBrush}"
                                            Opacity="0.67" Visibility="Collapsed" />
                                    <Border x:Name="BorderMouseOver" Background="{DynamicResource TextBrushDark}" Opacity="0" />
                                </Grid>
                                <!-- Hairline edge of the card, over the cover -->
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                                        BorderThickness="{DynamicResource ControlBorderThickness}"
                                        CornerRadius="6" />
                                <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" StretchDirection="DownOnly"
                                         Name="GameControls" Visibility="Hidden">
                                    <StackPanel Orientation="Horizontal" Margin="16">
                                        <Button Name="PART_ButtonPlay" Style="{StaticResource GridTileButton}" Margin="0,0,10,0"
                                                Foreground="{DynamicResource SelectedBorderBrush}"
                                                Content="{DynamicResource IconPlay}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <ScaleTransform x:Name="PlayPop" ScaleX="0.85" ScaleY="0.85" />
                                            </Button.RenderTransform>
                                        </Button>
                                        <Button Name="PART_ButtonInfo" Style="{StaticResource GridTileButton}"
                                                Content="{DynamicResource IconInfo}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <ScaleTransform x:Name="InfoPop" ScaleX="0.85" ScaleY="0.85" />
                                            </Button.RenderTransform>
                                        </Button>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Padding="2,6,2,4" Grid.Row="1" Grid.Column="0"
                                       Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="{DynamicResource IconDownload}" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderUninstalled" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CoverZoom" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="1.03" KeySpline="0.25,1,0.5,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CoverZoom" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="1.03" KeySpline="0.25,1,0.5,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.3" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="PlayPop" Storyboard.TargetProperty="ScaleX" From="0.85" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlayPop" Storyboard.TargetProperty="ScaleY" From="0.85" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.06" Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation BeginTime="0:0:0.06" Storyboard.TargetName="InfoPop" Storyboard.TargetProperty="ScaleX" From="0.85" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation BeginTime="0:0:0.06" Storyboard.TargetName="InfoPop" Storyboard.TargetProperty="ScaleY" From="0.85" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="CoverZoom" Storyboard.TargetProperty="ScaleX"><SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1" KeySpline="0.25,1,0.5,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="CoverZoom" Storyboard.TargetProperty="ScaleY"><SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1" KeySpline="0.25,1,0.5,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PlayPop" Storyboard.TargetProperty="ScaleX" To="0.85" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PlayPop" Storyboard.TargetProperty="ScaleY" To="0.85" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="InfoPop" Storyboard.TargetProperty="ScaleX" To="0.85" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="InfoPop" Storyboard.TargetProperty="ScaleY" To="0.85" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
