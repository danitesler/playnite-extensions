<!--
    Overlay on Playnite Default/DerivedStyles/DetailsViewItemStyle.xaml: a row of the game list beside the game page.
    The Sims-menu list: white rows (NormalBrush) split by 1px hairlines (PanelSeparatorBrush), the label in TextBrush.
    Hover: a pale sky wash (ListItemHoverBrush) fades in over 0.12s. Selected: the green gloss (SelectedBrush body, the
    SelectedSheenBrush lit top, the SelectedBorderBrush shaded foot, a 1px SelectedBorderBrush rim), SelectedForegroundBrush
    label in SemiBold, fading in over 0.14s. Not installed games read in TextBrushDarker.
    Running (IsLaunching / IsRunning): a 2px RunningIndicatorBrush frame, a 10 percent wash and the orange plumb bob
    (the theme's mark) at the right. RowRoom reserves 28px for it and RunningMarkPlate backs it. Launching: a band crosses
    the row, the foot line fills and the bob drops into place as it lands (1.7s loop). Running: the frame breathes
    0.72 to 1 and the bob bobs 3px over 2.4s. The layer sits above hover and selection and below the label.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Padding" Value="8,5,10,5" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Margin="0" Background="Transparent">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1" />
                        <Border x:Name="HoverPlate" Background="{DynamicResource ListItemHoverBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Grid x:Name="SelectedLayer" Opacity="0" IsHitTestVisible="False">
                            <Border Background="{DynamicResource SelectedBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border Background="{DynamicResource SelectedSheenBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"><Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D9000000" Offset="0" /><GradientStop Color="#00000000" Offset="0.62" /></LinearGradientBrush></Border.OpacityMask></Border>
                            <Border Background="{DynamicResource SelectedBorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"><Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.4" /><GradientStop Color="#99000000" Offset="1" /></LinearGradientBrush></Border.OpacityMask></Border>
                            <Border BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        </Grid>
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.1" />
                            <Border x:Name="RunningMarkPlate" Visibility="Visible" Width="28" HorizontalAlignment="Right" Margin="2" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.4" CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid Height="2" Margin="8,0,36,3" VerticalAlignment="Bottom">
                                <Rectangle RadiusX="1" RadiusY="1" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" RadiusX="1" RadiusY="1" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Grid x:Name="RunningMarkHost" Width="12" Height="25" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.9">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="RunningMark" Y="0" />
                                </Grid.RenderTransform>
                                <Viewbox Width="12" Height="25" Stretch="Fill" IsHitTestVisible="False">
                                    <Canvas Width="20" Height="42">
                                        <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 14,26 L 24,18 L 24,26 Z M 14,27.5 L 24,27.5 L 24,45 L 18,45 Z M 18,46.5 L 24,46.5 L 24,60 Z M 24,18 L 34,26 L 24,26 Z M 24,27.5 L 34,27.5 L 30,45 L 24,45 Z M 24,46.5 L 30,46.5 L 24,60 Z" Fill="{DynamicResource RunningIndicatorBrush}" />
                                        <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 14,26 L 24,18 L 24,26 Z M 14,27.5 L 24,27.5 L 24,45 L 18,45 Z M 18,46.5 L 24,46.5 L 24,60 Z" Fill="{DynamicResource PopupBackgroundBrush}" Opacity="0.4" />
                                        <Path Canvas.Left="-14" Canvas.Top="-18" Data="M 24,18 L 34,26 L 24,26 Z M 24,27.5 L 34,27.5 L 30,45 L 24,45 Z M 24,46.5 L 30,46.5 L 24,60 Z" Fill="{DynamicResource TextBrushDark}" Opacity="0.3" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Grid>
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <Border x:Name="RowRoom">
                                <Grid ClipToBounds="True"><ContentPresenter /></Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.45" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.452" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" /><SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Y" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-9" /><EasingDoubleKeyFrame KeyTime="0:0:0.95" Value="0"><EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="-9"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMarkHost" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" /><SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.45,0 0.25,1" /><SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1" /><SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" /><SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Y" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-3" KeySpline="0.4,0 0.6,1" /><SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- RunningMarkRoom left="0" right="28": the running mark owns this strip of the row, so a long name stops before it. -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,28,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,28,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
