<!--
    Slipstream: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    A light theme: warm paper page, ink type and rules, vermilion pills for whatever is selected, dark teal pills
    for buttons, and blue / sage / mustard racing stripes as decoration. Token names (ss-*) live in tokens.css and
    are measured from captures (../RESEARCH.md). Keys are the shared vocabulary (scripts/data/theme-keys.json).
    Theme XAML reads brushes only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Type: a highway-style sans for body (Bahnschrift ships with Windows 10+), wide heavy caps for titles
         (Unbounded, bundled in Typography/, standing in for the game's extended display face). -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">18</sys:Double>
    <sys:Double x:Key="FontSizeLargest">28</sys:Double>
    <FontFamily x:Key="FontFamily">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Unbounded, Unbounded, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- Shape: 32px controls are pills (radius 16 = half the height, so WPF draws a true capsule);
         cards and panels take the small radii of the game's poster tiles and modal. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:ss-radius-pill}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:ss-radius-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:ss-radius-card}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">10</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">10000</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">10</Thickness>

    <!-- Playnite palette. GlyphColor (selection, checked, links) is vermilion; TextColorDark is the paper white
         printed on vermilion, teal and ink fills. -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{ss-ink}}</Color>
    <Color x:Key="TextColorDarker">{{ss-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{ss-paper-white}}</Color>
    <Color x:Key="MainColor">{{ss-plate}}</Color>
    <Color x:Key="MainColorDark">{{ss-paper-hi}}</Color>
    <Color x:Key="HoverColor">{{ss-plate-hi}}</Color>
    <Color x:Key="GlyphColor">{{ss-vermilion}}</Color>
    <Color x:Key="HighlightGlyphColor">{{ss-vermilion-hi}}</Color>
    <Color x:Key="PopupBackgroundColor">{{ss-paper-hi}}</Color>
    <Color x:Key="PopupBorderColor">{{ss-ink}}</Color>
    <Color x:Key="BackgroundToneColor">{{ss-paper-hi}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{ss-hairline}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{ss-hairline}}</Color>
    <Color x:Key="DataChangeNotifColor">{{ss-vermilion}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{ss-ink/45}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{ss-ink}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{ss-teal}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{ss-paper-hi}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{ss-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{ss-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{ss-orange}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{ss-orange}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{ss-plate}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{ss-paper}}" />

    <!-- Shell: one sheet of paper; the rail is a plate strip, ink rules separate things -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{ss-plate}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{ss-paper}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the theme's
         own ContentBackground color, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{ss-paper}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{ss-paper}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{ss-paper}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{ss-paper}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{ss-paper-hi}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{ss-paper-white}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{ss-teal}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{ss-paper-white}}" />

    <!-- States: the selected tab, row or tile is a vermilion pill with paper-white type -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{ss-vermilion}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{ss-vermilion-hi}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{ss-paper-white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{ss-wash-strong}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{ss-vermilion}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{ss-wash-strong}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{ss-blue}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{ss-sage}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{ss-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{ss-paper-white}}" />

    <!-- Headings: vermilion "/" before the title, ink caps, an ink rule running to the right -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{ss-ink}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{ss-vermilion}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{ss-ink}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{ss-paper}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{ss-ink}}" />

    <!-- Racing stripes -->
    <SolidColorBrush x:Key="StripeBrush" Color="{{ss-blue}}" />
    <SolidColorBrush x:Key="StripeAltBrush" Color="{{ss-sage}}" />
    <SolidColorBrush x:Key="StripeAccentBrush" Color="{{ss-mustard}}" />

    <!-- Buttons: dark teal pills with paper-white type (the modal's Accept and Cancel); Play is the vermilion pill -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{ss-paper-white}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{ss-teal-hi}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{ss-teal-deep}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{ss-teal-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{ss-vermilion}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{ss-vermilion-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{ss-vermilion-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{ss-paper-white}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{ss-vermilion}}" />

    <!-- Inputs: lighter paper wells with an ink rim -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{ss-paper-hi}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{ss-paper-white}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{ss-ink/45}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{ss-ink}}" />

    <!-- Controls: gauges and toggles are ink capsules; the scroll thumb is the game's deep teal -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{ss-ink}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{ss-vermilion}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{ss-vermilion-hi}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{ss-ink}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{ss-paper-white}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{ss-vermilion}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{ss-paper-white}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{ss-paper-white}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{ss-ink}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{ss-teal-deep/70}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{ss-teal-deep}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{ss-teal-deep/70}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{ss-teal-deep}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{ss-vermilion}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{ss-wash-strong}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{ss-teal}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{ss-vermilion}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{ss-wash-strong}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{ss-vermilion}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{ss-paper-hi}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{ss-teal-deep}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{ss-paper-white}}" />

    <!-- Popups: paper sheets with an ink edge; tooltips are the ink preview panel -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{ss-hairline}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{ss-paper-white}}" />
</ResourceDictionary>
