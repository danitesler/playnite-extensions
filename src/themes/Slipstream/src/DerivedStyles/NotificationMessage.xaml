<!--
    Overlay on Playnite Default/DerivedStyles/NotificationMessage.xaml: a message in the notifications panel.
    Default fills it with ButtonBackgroundBrush under TextBrush text; here that brush is the dark teal of the pills,
    so ink text would not read. The message is a plate card instead (ExpanderBackgroundBrush, HighlightBorder rim),
    its text in TextBrush, with a ghost close glyph (IconClear, DangerBrush on hover) in place of the Marlett "r".
    Commands and bindings are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="NotificationMessage" TargetType="Button">
        <Setter Property="Command" Value="{Binding ActivateCommand}" />
        <Setter Property="Margin" Value="10,8,10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Style="{DynamicResource HighlightBorder}" Background="{DynamicResource ExpanderBackgroundBrush}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Width="28" Height="28" Margin="0,5,5,0" VerticalAlignment="Top"
                                    Focusable="False" Cursor="Hand" Command="{Binding CloseCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Border x:Name="Plate" CornerRadius="14" Background="{DynamicResource DangerBrush}" Opacity="0" IsHitTestVisible="False" />
                                            <ContentControl x:Name="Glyph" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                                                            Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{DynamicResource TextBrushDarker}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Plate" Property="Opacity" Value="1" />
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="{Binding Text}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Margin="12,8,4,8" TextWrapping="Wrap"
                                       MinHeight="38" DockPanel.Dock="Left" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
