<!--
    Overlay on Playnite Default/DerivedStyles/DetailsViewItemStyle.xaml: a row of the game list beside the game page.
    The game's option row: a pill (ControlCornerRadius) inset from the list edge with a 12px gutter on the left.
    Hover: wash pill (ListItemHoverBrush), TextBrush label. Selected: the vermilion pill (ListItemSelectedBrush),
    SelectedForegroundBrush label and the notched selection arrow (GlyphBrush) in the gutter, as in the game's
    settings list. Installed games read in the text color, not installed in muted (as Default).
    Keyboard selection is the selected pill, so there is no separate focus visual.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Padding" Value="2,3,10,3" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Margin="16,1,6,1" Background="Transparent">
                        <Path x:Name="Marker" Data="M0,0 L8,5 L0,10 L3,5 Z" Width="8" Height="10" Stretch="Fill" Visibility="Collapsed"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-12,0,0,0"
                              Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                        <Border x:Name="Row" Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ListItemHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ListItemSelectedBrush}" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
