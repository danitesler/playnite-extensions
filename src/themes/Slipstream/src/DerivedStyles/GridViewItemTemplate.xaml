<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemTemplate.xaml: the cover tile of the grid view.
    Structure from Default 10.60 (PART_PanelHost, PART_ImageCover, PART_ButtonPlay, PART_ButtonInfo; the empty-cover name
    and darken-uninstalled rules are kept). Covers use a rounded transparency mask matching the card edge.
    Hover: the cover zooms to 1.03 (0.6s, ease out); a paper scrim (page color at 0.67) bleaches it over 0.15s; the two
    buttons fade in over 0.15s and rise 6px over 0.3s, Info 50ms after Play. Leaving reverses it in 0.15s
    (FillBehavior Stop, panel hidden by a Visibility keyframe).
    Buttons (GridTileButton): 44px discs, the shape of the game's round button prompts, with IconPlay (IconDownload for
    games that are not installed) and IconInfo. Play is the vermilion disc (PrimaryButton brushes), Info the teal one
    (Button brushes). Hover: the teal disc cross-fades to its hover fill and an ink rim over 0.3s and lifts 2px;
    pressed cancels the lift and fades the pressed fill in over 0.15s. Play dims its plate to 90 percent on hover and
    80 percent pressed, which lets the paper scrim through and reads as a lighter vermilion.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- Teal disc (Info). The vermilion variant (Play) is an inline style below with its own template (90 and 80 percent plates). Layers: rest fill and edge, hover fill, hover edge, pressed fill, glyph. -->
    <Style x:Key="GridTileButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="Lift" Y="0" />
                                    <TranslateTransform x:Name="PressDrop" Y="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="Rest" SnapsToDevicePixels="True" CornerRadius="22" Background="{DynamicResource ButtonBackgroundBrush}" />
                            <Border x:Name="RestEdge" SnapsToDevicePixels="True" CornerRadius="22" BorderBrush="{DynamicResource ButtonBorderBrush}"
                                    BorderThickness="{DynamicResource ControlBorderThickness}" />
                            <Border x:Name="HoverPlate" SnapsToDevicePixels="True" CornerRadius="22" Opacity="0" Background="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Border x:Name="PressPlate" SnapsToDevicePixels="True" CornerRadius="22" Opacity="0" Background="{DynamicResource ButtonPressedBackgroundBrush}" />
                            <Border x:Name="HoverEdge" SnapsToDevicePixels="True" CornerRadius="22" Opacity="0" BorderBrush="{DynamicResource InputHoverBorderBrush}"
                                    BorderThickness="{DynamicResource ControlBorderThickness}" />
                            <ContentPresenter Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="1" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="1" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RestEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="-2" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="1" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="RestEdge" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="1" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.2,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressDrop" Storyboard.TargetProperty="Y"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="2" KeySpline="0.2,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PressDrop" Storyboard.TargetProperty="Y"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="Transparent">
                        <StackPanel Name="PART_PanelHost"
                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">

                            <Grid Width="{Settings GridItemWidth}"
                                  Height="{Settings GridItemHeight}">
                                <!-- Rounded cover and scrims; controls remain outside the mask. -->
                                <Grid x:Name="CoverHost" ClipToBounds="True">
                                    <Grid.OpacityMask><VisualBrush Stretch="Fill"><VisualBrush.Visual><Border Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}" CornerRadius="{DynamicResource CornerRadiusSmall}" Background="Black" /></VisualBrush.Visual></VisualBrush></Grid.OpacityMask>
                                    <Border x:Name="CoverShape" Background="{DynamicResource ExpanderBackgroundBrush}" />
                                    <Image Name="PART_ImageCover"
                                           RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Stretch="{Settings CoverArtStretch}" RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <ScaleTransform x:Name="CoverZoom" ScaleX="1" ScaleY="1" />
                                        </Image.RenderTransform>
                                    </Image>
                                    <Grid x:Name="TextGameName" Visibility="Collapsed">
                                        <Border Background="{DynamicResource WindowBackgourndBrush}" Opacity="0.6" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap" Margin="5"
                                                   Style="{StaticResource BaseTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <!-- Darken uninstalled (static) and the hover scrim (animated) are separate layers. -->
                                    <Border x:Name="BorderUninstalled" Background="{DynamicResource WindowBackgourndBrush}"
                                            Opacity="0.67" Visibility="Collapsed" />
                                    <Border x:Name="BorderMouseOver" Background="{DynamicResource WindowBackgourndBrush}" Opacity="0" />
                                </Grid>
                                <!-- Hairline edge of the card, over the cover -->
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                                        BorderThickness="{DynamicResource ControlBorderThickness}"
                                        CornerRadius="{DynamicResource CornerRadiusSmall}" />
                                <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" StretchDirection="DownOnly"
                                         Name="GameControls" Visibility="Hidden">
                                    <StackPanel Orientation="Horizontal" Margin="12">
                                        <Button Name="PART_ButtonPlay" Margin="0,0,8,0"
                                                Content="{DynamicResource IconPlay}" Opacity="0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GridTileButton}">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid Background="Transparent">
                                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                                    <Grid.RenderTransform>
                                                                        <TransformGroup>
                                                                            <TranslateTransform x:Name="Lift" Y="0" />
                                                                            <TranslateTransform x:Name="PressDrop" Y="0" />
                                                                        </TransformGroup>
                                                                    </Grid.RenderTransform>
                                                                    <Border x:Name="Rest" SnapsToDevicePixels="True" CornerRadius="22" Background="{DynamicResource PrimaryButtonBackgroundBrush}" />
                                                                    <ContentPresenter Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                      Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                                </Grid>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.8" KeySpline="0.2,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressDrop" Storyboard.TargetProperty="Y"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="2" KeySpline="0.2,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0.9" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PressDrop" Storyboard.TargetProperty="Y"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0.9" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="-2" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="1" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            </Button.Style>
                                            <Button.RenderTransform>
                                                <TranslateTransform x:Name="PlayRise" Y="6" />
                                            </Button.RenderTransform>
                                        </Button>
                                        <Button Name="PART_ButtonInfo" Style="{StaticResource GridTileButton}"
                                                Content="{DynamicResource IconInfo}" Opacity="0">
                                            <Button.RenderTransform>
                                                <TranslateTransform x:Name="InfoRise" Y="6" />
                                            </Button.RenderTransform>
                                        </Button>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Padding="2,6,2,4" Grid.Row="1" Grid.Column="0"
                                       Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="{DynamicResource IconDownload}" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderUninstalled" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CoverZoom" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="1.03" KeySpline="0.25,1,0.5,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CoverZoom" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="1.03" KeySpline="0.25,1,0.5,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.67" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayRise" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" KeySpline="0.25,1,0.5,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.05">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InfoRise" Storyboard.TargetProperty="Y" BeginTime="0:0:0.05">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" KeySpline="0.25,1,0.5,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="CoverZoom" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1" KeySpline="0.25,1,0.5,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="CoverZoom" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1" KeySpline="0.25,1,0.5,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0" KeySpline="0.25,0.1,0.25,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PlayRise" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="6" KeySpline="0.25,1,0.5,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="InfoRise" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="6" KeySpline="0.25,1,0.5,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
