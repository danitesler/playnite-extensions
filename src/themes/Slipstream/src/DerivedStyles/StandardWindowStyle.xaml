<!--
    Slipstream: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    A 44px paper band drawn like the game's screen header: a vermilion "/" stroke, the title in the heading face
    (Unbounded Bold), the small vermilion tag block after it, and a 2px ink rule closing the band. The signature graphic
    is the racing stripe: three slanted bands (StripeBrush, StripeAltBrush, StripeAccentBrush) crossing the band left of
    the caption buttons, drawn in a zero-size Canvas inside the clipped band so small dialogs still size to content.
    Caption buttons are the 40x32 WindowBarButton, so the caption and the content offset are 44 (Default 25).
    PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}" ClipToBounds="True">
                                    <!-- Racing stripes, anchored to the right edge; no desired size. -->
                                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0" IsHitTestVisible="False">
                                        <Path Canvas.Left="-262" Data="M0,44 L24,44 L50,0 L26,0 Z" Fill="{DynamicResource StripeBrush}" />
                                        <Path Canvas.Left="-232" Data="M0,44 L12,44 L38,0 L26,0 Z" Fill="{DynamicResource StripeAltBrush}" />
                                        <Path Canvas.Left="-214" Data="M0,44 L4,44 L30,0 L26,0 Z" Fill="{DynamicResource StripeAccentBrush}" />
                                    </Canvas>
                                    <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource HeadingRuleBrush}" IsHitTestVisible="False" />
                                    <DockPanel LastChildFill="False">
                                        <!-- The slash that opens every screen title. -->
                                        <Path DockPanel.Dock="Left" Data="M6,0 L11,0 L5,18 L0,18 Z" Width="11" Height="18" Margin="16,0,6,2"
                                              VerticalAlignment="Center" Fill="{DynamicResource HeadingMarkerBrush}" IsHitTestVisible="False" />
                                        <TextBlock Text="{TemplateBinding Title}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,0,2"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}" TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                        <!-- The tag block that follows a title: a vermilion plate with paper slots. -->
                                        <Grid DockPanel.Dock="Left" Width="30" Height="12" Margin="10,0,0,2" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <Border CornerRadius="2" Background="{DynamicResource HeadingMarkerBrush}" />
                                            <Rectangle Width="10" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0" Fill="{DynamicResource WindowTitleBackgroundBrush}" />
                                            <Rectangle Width="6" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,3" Fill="{DynamicResource WindowTitleBackgroundBrush}" />
                                            <Rectangle Width="8" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Fill="{DynamicResource WindowTitleBackgroundBrush}" />
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,8,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
