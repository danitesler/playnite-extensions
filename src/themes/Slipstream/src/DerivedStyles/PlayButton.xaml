<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml: the Play / Install button on the game page.
    The game's selected pill made primary: a 40px vermilion capsule (PrimaryButtonBackgroundBrush, radius 20 = half the
    height), paper-white label (PrimaryButtonForegroundBrush) in the heading face, 15px Bold.
    Layers, bottom to top: Rest plate, HoverPlate (PrimaryButtonHoverBackgroundBrush), PressedPlate
    (PrimaryButtonPressedBackgroundBrush), the stripe sweep, the label.
    Hover: HoverPlate fades in over 0.2s and the racing stripes (three slanted paper-white bands, the game's speed
    motif) run left to right across the pill, looping only while hovered. Leaving fades both out over 0.3s
    (FillBehavior Stop). Pressed: its own plate fades in and out. The sweep is clipped to the capsule by an
    OpacityMask taken from the Rest plate. Keyboard focus: FocusVisual. Disabled: BaseStyle opacity.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="26,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Border x:Name="Rest" SnapsToDevicePixels="True" CornerRadius="20"
                                Background="{TemplateBinding Background}" />
                        <Border x:Name="HoverPlate" CornerRadius="20" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                        <Border x:Name="PressedPlate" CornerRadius="20" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        <Grid x:Name="Sweep" ClipToBounds="True" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                            <Grid.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=Rest}" Stretch="None" />
                            </Grid.OpacityMask>
                            <Canvas>
                                <Canvas Opacity="0.3">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform x:Name="SweepX" X="-90" />
                                    </Canvas.RenderTransform>
                                    <Path Data="M0,48 L16,48 L44,0 L28,0 Z" Fill="{DynamicResource PrimaryButtonForegroundBrush}" />
                                    <Path Canvas.Left="22" Data="M0,48 L7,48 L35,0 L28,0 Z" Fill="{DynamicResource PrimaryButtonForegroundBrush}" />
                                    <Path Canvas.Left="34" Data="M0,48 L3,48 L31,0 L28,0 Z" Fill="{DynamicResource PrimaryButtonForegroundBrush}" />
                                </Canvas>
                            </Canvas>
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="HoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="SweepX" Storyboard.TargetProperty="X" From="-90" To="420"
                                                         Duration="0:0:1.3" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="SweepX" Storyboard.TargetProperty="X" To="420" Duration="0:0:0.3" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
