<!--
    Overlay on Playnite Default/CustomControls/GameMenu.xaml. The game context menu takes the theme's ContextMenu
    (DefaultControls/ContextMenu.xaml, which already sets the shared size scope) through BasedOn.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GameMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />
</ResourceDictionary>
