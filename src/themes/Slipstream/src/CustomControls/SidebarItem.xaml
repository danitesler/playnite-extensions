<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    Rail item: a 44x40 compact item (repo shell rule) with a 32px disc, the shape of the game's round button prompts.
    TextBrushDarker icon at rest; hover: wash disc (TopPanelItemHoverBackgroundBrush) and a TextBrush icon; the current
    item is the vermilion disc (SelectedBrush) with a SelectedForegroundBrush icon and the game's selection arrow
    (GlyphBrush) on the rail's outer edge. The whole 44x40 item is the hit target. Icons are scaled into a fixed 16x16
    IconHost centered in the disc (no IconPadding); Library and Statistics use the theme's icons.
    PART_ProgressStatus (shown while an add-on reports progress) is a thin bar along the disc's bottom edge.
    An item with no content is a bare marker: WarningBrush fill.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="Tile" SnapsToDevicePixels="True" Width="32" Height="32"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid x:Name="IconHost" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox x:Name="ItemIcon">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Viewbox>
                                <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                IsHitTestVisible="False"
                                                ContentTemplate="{DynamicResource IconTemplate}" />
                            </Grid>
                        </Border>
                        <Path x:Name="Marker" Data="M0,0 L5,4 L0,8 L1.5,4 Z" Width="5" Height="8" Stretch="Fill" Visibility="Collapsed"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"
                              Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                        <ProgressBar x:Name="PART_ProgressStatus" Height="4" Margin="12,0,12,6"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource ProgressBarForegroundBrush}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="PART_ProgressStatus" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Marker" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
