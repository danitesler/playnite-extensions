<!--
    Slipstream: gives Playnite's path boxes the shared field height (ControlHeight), so it lines up with text boxes and buttons.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type PathSelectionBox}" BasedOn="{StaticResource {x:Type PathSelectionBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
