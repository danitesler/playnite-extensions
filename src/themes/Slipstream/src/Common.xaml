<!--
    Overlay on Playnite Default/Common.xaml. Slipstream's spacing and focus.
    The game's menu rows and dialog pills are about 32px tall at 1080p with 14px labels, which is this repo's
    ControlHeight, so pills are true capsules (radius 16). Playnite lays controls out by padding; vertical padding
    stays at 5 so ControlHeight decides the height.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: a lighter paper sheet with a 1px ink edge, CornerRadiusLarge (6) like the game's modal -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    </Style>

    <!-- Keyboard focus: a 2px FocusBrush (stripe blue) ring 2px outside the control, pill radius (buttons, tabs, rows). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="20" RadiusY="20" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggles and radios: the same ring around the 16px capsule and the round radio. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="11" RadiusY="11" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: 18 inline so the pill ends clear the label -->
    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <!-- Text box, password box, dropdown: 12 inline -->
    <Thickness x:Key="InputPadding">12,5</Thickness>
    <!-- Menu: 4 inside the sheet; items 31px (17 + 2 x 7), close to the game's 30px option rows -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">8,7,12,7</Thickness>
    <!-- Dropdown popup: the same sheet and rows as menus -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,7,12,7</Thickness>
    <!-- List box item -->
    <Thickness x:Key="ListBoxItemPadding">12,8</Thickness>
    <!-- Card (group box): 16 body padding; the header carries the title and its rule -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">16,14,16,0</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">13</sys:Double>
    <!-- Tooltip -->
    <Thickness x:Key="TooltipPadding">12,6</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu, on the teal disc): three slanted speed streaks in the theme's racing
         stripes, mustard, paper white and sage, staggered in length like a slipstream, 24x18 centred in the host. Hover
         (IsMouseOver): the streaks slip forward one after another (3, 2 and 4px, 0.3s CubicEase, 50ms apart) and fall back on
         exit. Open (the menu's ContextMenu.IsOpen on the nearest Border, which is PART_ElemMainMenu): the stripes fan into a
         thrust nozzle: the mustard and sage streaks swing 10 degrees about their tails towards the white one, which
         stretches, and all three shudder at their own pace (0.5, 0.65 and 0.8s, 1.2px) like an engine under load until the menu
         closes. Each streak sits in a hover canvas (the slip) inside an open canvas (swing and shudder), so the states never
         animate the same element. -->
    <ControlTemplate x:Key="LocalSlipstreamMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="False">
            <Canvas Width="24" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="24" Height="18">
                    <Canvas.RenderTransform><TranslateTransform x:Name="SlipA" X="0" /></Canvas.RenderTransform>
                    <Canvas Width="24" Height="18">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="SwingA" CenterX="21.25" CenterY="3.1" Angle="0" />
                                <TranslateTransform x:Name="ShudA" X="0" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Path Data="M8.5,1.8 L22,1.8 L20.5,4.4 L7,4.4 Z" Fill="{DynamicResource StripeAccentBrush}" />
                    </Canvas>
                </Canvas>
                <Canvas Width="24" Height="18">
                    <Canvas.RenderTransform><TranslateTransform x:Name="SlipB" X="0" /></Canvas.RenderTransform>
                    <Canvas Width="24" Height="18">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="StretchB" CenterX="19.75" CenterY="9" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="ShudB" X="0" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Path Data="M3.5,7.7 L20.5,7.7 L19,10.3 L2,10.3 Z" Fill="{DynamicResource MainMenuButtonForegroundBrush}" />
                    </Canvas>
                </Canvas>
                <Canvas Width="24" Height="18">
                    <Canvas.RenderTransform><TranslateTransform x:Name="SlipC" X="0" /></Canvas.RenderTransform>
                    <Canvas Width="24" Height="18">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="SwingC" CenterX="16.75" CenterY="14.9" Angle="0" />
                                <TranslateTransform x:Name="ShudC" X="0" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Path Data="M6.5,13.6 L17.5,13.6 L16,16.2 L5,16.2 Z" Fill="{DynamicResource StripeAltBrush}" />
                    </Canvas>
                </Canvas>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SlipA" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SlipB" Storyboard.TargetProperty="X" To="2" BeginTime="0:0:0.05" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SlipC" Storyboard.TargetProperty="X" To="4" BeginTime="0:0:0.1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SlipA" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SlipB" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SlipC" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SwingA" Storyboard.TargetProperty="Angle" To="-10" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SwingC" Storyboard.TargetProperty="Angle" To="10" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StretchB" Storyboard.TargetProperty="ScaleX" To="1.14" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ShudA" Storyboard.TargetProperty="X" From="0" To="1.2" BeginTime="0:0:0.3" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ShudB" Storyboard.TargetProperty="X" From="0" To="1.2" BeginTime="0:0:0.3" Duration="0:0:0.65" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ShudC" Storyboard.TargetProperty="X" From="0" To="1.2" BeginTime="0:0:0.3" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SwingA" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.22" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SwingC" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.22" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="StretchB" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShudA" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShudB" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShudC" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
