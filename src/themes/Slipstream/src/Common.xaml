<!--
    Overlay on Playnite Default/Common.xaml. Slipstream's spacing and focus.
    The game's menu rows and dialog pills are about 32px tall at 1080p with 14px labels, which is this repo's
    ControlHeight, so pills are true capsules (radius 16). Playnite lays controls out by padding; vertical padding
    stays at 5 so ControlHeight decides the height.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: a lighter paper sheet with a 1px ink edge, CornerRadiusLarge (6) like the game's modal -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    </Style>

    <!-- Keyboard focus: a 2px FocusBrush (stripe blue) ring 2px outside the control, pill radius (buttons, tabs, rows). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="20" RadiusY="20" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggles and radios: the same ring around the 16px capsule and the round radio. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="11" RadiusY="11" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: 18 inline so the pill ends clear the label -->
    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <!-- Text box, password box, dropdown: 12 inline -->
    <Thickness x:Key="InputPadding">12,5</Thickness>
    <!-- Menu: 4 inside the sheet; items 31px (17 + 2 x 7), close to the game's 30px option rows -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">8,7,12,7</Thickness>
    <!-- Dropdown popup: the same sheet and rows as menus -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,7,12,7</Thickness>
    <!-- List box item -->
    <Thickness x:Key="ListBoxItemPadding">12,8</Thickness>
    <!-- Card (group box): 16 body padding; the header carries the title and its rule -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">16,14,16,0</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">13</sys:Double>
    <!-- Tooltip -->
    <Thickness x:Key="TooltipPadding">12,6</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
</ResourceDictionary>
