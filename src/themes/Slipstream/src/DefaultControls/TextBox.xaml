<!--
    Overlay on Playnite Default/DefaultControls/TextBox.xaml. A paper well: InputBackgroundBrush fill (lighter paper), 1px
    InputBorderBrush rim (ink at 45 percent), CornerRadiusLarge (6; wells are rounded rectangles, actions are pills),
    InputPadding, 32px (ControlHeight) and growing for multi-line text.
    Hover: InputHoverBorderBrush (ink) rim. Focus: the rim disappears and a 2px FocusBrush ring replaces it; the ring is an
    overlay Border on IsKeyboardFocusWithin so nothing shifts. A text box drawn without an edge (BorderThickness 0) shows no ring.
    BareTextBox: no chrome at all, for hosts that draw their own (search box, editable dropdown).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LocalInkPlateFieldTemplate: a field cut from card stock with a hard ink plate under its bottom and right edges (a 3px
        crescent in the field's own corner radius, no blur). Rest: ink. Hover: the plate takes the lit frame colour.
        Keyboard focus: vermilion (GlyphBrush) and a small notched vermilion arrow points at the field from its left edge.
        State is read from the nearest Control above; no desired size.
    -->
    <ControlTemplate x:Key="LocalInkPlateFieldTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border x:Name="Plate" BorderThickness="0,0,3,3" BorderBrush="{DynamicResource TextBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Path x:Name="Arrow" Width="6" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" Visibility="Collapsed"
                  Fill="{DynamicResource GlyphBrush}" Data="M0,0 L6,5 L0,10 L2,5 Z" />
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Grid>
                            <Border x:Name="Border" BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                            </Border>
                            <Control x:Name="FieldOverlay" Template="{DynamicResource LocalInkPlateFieldTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        </Grid>
                        <Border x:Name="FocusRing" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}"
                                CornerRadius="{DynamicResource CornerRadiusLarge}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                            <Setter Property="BorderBrush" Value="Transparent" TargetName="Border" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FocusRing" />
                        </Trigger>
                        <Trigger Property="BorderThickness" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="FocusRing" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No fill, no edge, no padding: the host (search box, editable dropdown) draws the field. -->
    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
