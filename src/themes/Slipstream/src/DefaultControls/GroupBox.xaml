<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml. A plate card (ExpanderBackgroundBrush, 1px
    WindowPanelSeparatorBrush edge, CornerRadiusLarge 6) headed the way the game heads a settings group: the title in
    HeadingFontFamily Bold, then a 2px ink rule (HeadingRuleBrush) running to the card's right edge.
    Content-sized: the rule is a star column with no width of its own, so Statistics cards still wrap.
    A group box without a header draws just the body.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border DockPanel.Dock="Top" Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="{DynamicResource CornerRadiusLarge}">
                        <DockPanel>
                            <Border x:Name="HeaderBorder" DockPanel.Dock="Top" Padding="{DynamicResource GroupBoxHeaderPadding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                               Foreground="{DynamicResource HeadingForegroundBrush}"
                                               FontFamily="{DynamicResource HeadingFontFamily}"
                                               FontSize="{DynamicResource GroupBoxHeaderFontSize}" FontWeight="Bold">
                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                          RecognizesAccessKey="True" />
                                    </TextBlock>
                                    <Rectangle Grid.Column="1" Height="2" Margin="8,0,0,3" VerticalAlignment="Bottom"
                                               Fill="{DynamicResource HeadingRuleBrush}" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                              Margin="{TemplateBinding Padding}"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderBorder" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
