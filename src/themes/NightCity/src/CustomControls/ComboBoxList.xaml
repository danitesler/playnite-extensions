<!--
    Night City ComboBoxList: multi-select dropdown sharing LocalNightCityMenuPanelTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ComboBoxList}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxList}">
                    <Border x:Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Background}">
                        <DockPanel>
                            <Button x:Name="PART_ButtonClearFilter" DockPanel.Dock="Right"
                                    Style="{DynamicResource PropertyItemButton}"
                                    Content="r" FontFamily="Marlett" Margin="0,0,4,0" FontSize="12"
                                    Visibility="{TemplateBinding ShowClearButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid DockPanel.Dock="Left">
                                <ToggleButton x:Name="PART_ToggleDropDown" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <DockPanel LastChildFill="False" Background="Transparent">
                                                <Viewbox DockPanel.Dock="Right" Width="20" Margin="0,0,2,0">
                                                    <TextBlock Text="6" FontFamily="Marlett" Foreground="{DynamicResource GlyphBrush}" VerticalAlignment="Center" />
                                                </Viewbox>
                                            </DockPanel>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBlock x:Name="PART_TextFilterString" IsHitTestVisible="False" VerticalAlignment="Center"
                                           Margin="10,0,28,0" Style="{DynamicResource BaseTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <Popup x:Name="PART_Popup" IsOpen="{Binding IsChecked, ElementName=PART_ToggleDropDown}"
                                       Placement="Bottom" VerticalOffset="2" Focusable="False" AllowsTransparency="True" StaysOpen="False">
                                    <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                          SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Control Template="{DynamicResource LocalNightCityMenuPanelTemplate}"
                                                 Focusable="False" IsTabStop="False" />
                                        <ItemsControl x:Name="PART_ItemsPanel" Margin="7,9,7,9"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ItemsControl.Template>
                                                <ControlTemplate TargetType="{x:Type ItemsControl}">
                                                    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </ControlTemplate>
                                            </ItemsControl.Template>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger SourceName="PART_ToggleDropDown" Property="IsChecked" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Border" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
