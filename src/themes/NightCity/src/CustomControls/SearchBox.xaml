<!--
    Night City: SearchBox and the shared TopPanelSearchBox style. Keeps PART_SeachIcon, PART_TextInpuText, PART_ClearTextIcon.
    Square input (ControlCornerRadius) on InputBackgroundBrush with a NormalBorderBrush hairline; hover edge GlyphBrush, keyboard
    focus within FocusBrush. IconSearch and IconClear (IconTemplate) replace the icofont glyphs. The inner TextBox is BareTextBox
    so only this chrome draws. TopPanelSearchBox: 280x36 for the right end of the top strip.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}"
                                BorderThickness="{DynamicResource ControlBorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <ContentControl x:Name="PART_SeachIcon"
                                        Content="{DynamicResource IconSearch}"
                                        ContentTemplate="{DynamicResource IconTemplate}"
                                        Width="14" Height="14"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"
                                        Foreground="{DynamicResource TextBrushDarker}" />
                        <TextBox x:Name="PART_TextInpuText"
                                 Style="{DynamicResource BareTextBox}"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center" Padding="34,0,32,0" />
                        <ContentControl x:Name="PART_ClearTextIcon"
                                        Content="{DynamicResource IconClear}"
                                        ContentTemplate="{DynamicResource IconTemplate}"
                                        Width="12" Height="12"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"
                                        Cursor="Hand">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Chrome" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Chrome" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Width" Value="280" />
        <Setter Property="Height" Value="36" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
