<Grid x:Name="DetailsMainColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.MaxWidth><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="z == true ? x : Max(0, x - y - 24)"><Binding Path="ActualWidth" ElementName="DetailsOverviewBody" /><Binding Path="ActualWidth" ElementName="DetailsMetadataColumn" /><Binding Path="Tag" ElementName="DetailsOverviewBody" /></MultiBinding></Grid.MaxWidth>
<StackPanel>
                                        <!-- Steam Screenshots add-on: its host control, and a skeleton while it loads. The bindings use FallbackValue=PluginUnavailable
                                             (not False): with the add-on missing or disabled neither the section nor the skeleton shows. The add-on hides its
                                             control and clears IsControlVisible on every game change and needs about a second, so a Steam library game shows the
                                             section (skeleton) in that gap, for at most 12 s. -->
                                        <Grid x:Name="SteamScreenshotsGameScope">
                                            <!-- Plugin visibility is shared: a late Steam load must never reveal a different game's section. -->
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.Source.Name}" Value="Steam">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                                <StackPanel>
                                                    <StackPanel Margin="0,0,0,14">
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" />
    <Border Width="48" Height="3" Margin="0,6,0,0" HorizontalAlignment="Left" Background="{DynamicResource TabItemIndicatorBrush}" />
</StackPanel>
                                                    <Grid>
                                                        <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                        <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}"
                                                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                            <Control.Style>
                                                                <Style TargetType="Control">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Control.Style>
                                                        </Control>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        </Grid>
                                        <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemDescription}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel x:Name="PART_ElemDescription">
                                                <StackPanel Margin="0,0,0,14">
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCGameDescriptionTitle}" />
    <Border Width="48" Height="3" Margin="0,6,0,0" HorizontalAlignment="Left" Background="{DynamicResource TabItemIndicatorBrush}" />
</StackPanel>
                                                <HtmlTextView x:Name="PART_HtmlDescription"
                                                              TextElement.Foreground="{DynamicResource TextBrush}"
                                                              Tag="{DynamicResource GlyphBrush}"
                                                              HtmlFontSize="{DynamicResource FontSize}"
                                                              HtmlFontFamily="{DynamicResource FontFamily}"
                                                              HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                              LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                              pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemNotes}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel x:Name="PART_ElemNotes">
                                                <StackPanel Margin="0,0,0,14">
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCNotesLabel}" />
    <Border Width="48" Height="3" Margin="0,6,0,0" HorizontalAlignment="Left" Background="{DynamicResource TabItemIndicatorBrush}" />
</StackPanel>
                                                <TextBox x:Name="PART_TextNotes" Style="{DynamicResource BareTextBox}" IsReadOnly="True"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Padding="0" BorderThickness="0"
                                                         Foreground="{DynamicResource TextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
</Grid>
</Grid>
                            </Grid>
                            <!-- Empty state (no game selected): an empty cut-corner slab (the Play slab's shape) with a scan line running down it, a cyan
                                 ghost of its outline that glitches twice every 3.6s, Playnite's "No game selected" in the heading face and a yellow bar. Centered in the
                                 visible area; both loops run only while it shows (RemoveStoryboard on exit). -->
                            <Grid VerticalAlignment="Top" Height="{Binding ViewportHeight, ElementName=PART_ScrollViewHost}" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                                    <Grid Width="120" Height="96" HorizontalAlignment="Center">
                                        <Path x:Name="EmptyFx1" Data="M12,0.75 H119.25 V84 L108,95.25 H0.75 V12 Z" Stroke="{DynamicResource HighlightGlyphBrush}" StrokeThickness="1" Opacity="0" IsHitTestVisible="False">
                                            <Path.RenderTransform><TranslateTransform x:Name="EmptyFx1Xf" X="0" /></Path.RenderTransform>
                                        </Path>
                                        <Path Data="M12,0.75 H119.25 V84 L108,95.25 H0.75 V12 Z" Fill="{DynamicResource GridItemBackgroundBrush}" Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1.5" />
                                        <Grid Margin="6" ClipToBounds="True" IsHitTestVisible="False">
                                            <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" Opacity="0.7">
                                                <Rectangle.RenderTransform><TranslateTransform x:Name="EmptyFx2Xf" Y="4" /></Rectangle.RenderTransform>
                                            </Rectangle>
                                        </Grid>
                                        <ContentControl Content="{DynamicResource IconLibrary}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Width="48" Height="48" Foreground="{DynamicResource TextBrushDarker}" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,22,0,0"
                                               FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrushDarker}" />
                                    <Border Width="48" Height="3" Margin="0,12,0,0" HorizontalAlignment="Center" Background="{DynamicResource TabItemIndicatorBrush}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                    <ControlTemplate.Triggers>
                        <!-- Empty-state loops live here, on named transforms. Started from an element Style they crash Playnite: the page is built with no game yet, so the trigger fires while the transform is read-only. -->
                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="EmptyFx1Run">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3.6">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyFx1" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.0" Value="0.9" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.06" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.12" Value="0.9" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyFx1Xf" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.0" Value="-4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.12" Value="3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard x:Name="EmptyFx2Run">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyFx2Xf" Storyboard.TargetProperty="Y">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="4" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2" Value="88" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.6" Value="88" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="EmptyFx1Run" />
                                <RemoveStoryboard BeginStoryboardName="EmptyFx2Run" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
