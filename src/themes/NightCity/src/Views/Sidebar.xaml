<!--
    Overlay on Playnite Default/Views/Sidebar.xaml. The Cyberpunk 2077 yellow livery as a compact rail: a slab of the
    brand yellow (ShellBackgroundBrush, yellow fcee0a) 44px wide down the left edge, with a 1px black ink rule 3px in
    from its inner edge (the double line the game's panels carry) and a 10px chamfer cut off its bottom corner. Items
    are 44 x 40 black glyphs at 16px; the current one is inverted, a black plate with a yellow glyph
    (CustomControls/SidebarItem.xaml). The main menu button (MainMenuButton, defined here, also used by
    Views/TopPanel.xaml when the sidebar is hidden) is 44 x 40 at the top and inverts the same way on hover.
    Right: the rail mirrors and starts 56px down so the window buttons stay clear.
    Top and bottom: a 48px yellow strip without the rule; the top strip keeps 160px clear for the window buttons.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TextBrushDark}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid x:Name="Root" Width="44" Margin="{TemplateBinding Padding}">
                        <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}">
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                        DockPanel.Dock="Top" Margin="0,0,0,0">
                                    <ContentPresenter Width="16" Height="16"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Content="{DynamicResource IconMainMenu}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" Margin="0,0,0,10" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border x:Name="Edge" Width="1" Margin="0,0,3,0" HorizontalAlignment="Right"
                                IsHitTestVisible="False" Background="{DynamicResource TextBrushDark}" />
                        <Path x:Name="Cut" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              IsHitTestVisible="False" Fill="{DynamicResource ContentBackgroundBrush}"
                              Data="M 10,0 L 10,10 L 0,10 Z" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Main menu hidden (it is in the top bar): the items still start below the top bar. -->
                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemMainMenu}" Value="Collapsed">
                            <Setter Property="Margin" Value="0,56,0,0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,56,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="Edge" />
                            <Setter Property="Margin" Value="3,0,0,0" TargetName="Edge" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="Cut" />
                            <Setter Property="Data" Value="M 0,0 L 10,10 L 0,10 Z" TargetName="Cut" />
                            <Setter Property="Margin" Value="0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Width" Value="Auto" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Edge" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Cut" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,160,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,4,0,4" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="4,4,4,4" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Width" Value="Auto" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Edge" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Cut" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,4,0,4" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="4,4,4,4" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
