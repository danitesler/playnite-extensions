<!--
    Overlay on Playnite Default/Views/FilterPanelView.xaml.
    The filter side panel as the game's store side panel: the near-black page (ContentBackgroundBrush), closed off by
    a 1px WindowPanelSeparatorBrush edge on the side facing the views. A 16px gutter for every field, 12px around the
    header buttons, 16px of room under the list. Field labels are the game's section headers: the title face
    (HeadingFontFamily) at FontSizeSmall in TextBrushDarker; an unchecked filter is dimmed as in Playnite. Header and
    preset buttons are 32px square glyph buttons (Phosphor at IconSize): close (IconClear), delete (IconRemove),
    rename (IconEdit), save the current filter as a preset (IconFilterPresets).
    Every PART_ name is Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="FilterPanelCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="16,2,16,8" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="{StaticResource False}">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Margin" Value="16,12,16,6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource False}">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelFilterSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Margin" Value="16,0,16,0" />
        <Setter Property="ShowImage" Value="False" />
    </Style>

    <Style x:Key="FilterPanelFilterSelectionBox" TargetType="FilterSelectionBox" BasedOn="{StaticResource {x:Type FilterSelectionBox}}">
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <Style x:Key="FilterPanelFilterEnumSelectionBox" TargetType="FilterEnumSelectionBox" BasedOn="{StaticResource {x:Type FilterEnumSelectionBox}}">
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <Style x:Key="FilterPanelFilterStringSelectionBox" TargetType="FilterStringSelectionBox" BasedOn="{StaticResource {x:Type FilterStringSelectionBox}}">
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <!-- Preset actions: 32px square glyph buttons on the page; the icon is the button's content, drawn by IconTemplate. -->
    <Style x:Key="FilterPresetButtonAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>

    <Style TargetType="{x:Type FilterPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPanel}">
                    <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                            d:DesignWidth="200">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings FilterPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Background="{DynamicResource ContentBackgroundBrush}">
                            <DockPanel Margin="12,12,12,8" DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                                        Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0"
                                        Style="{StaticResource SimpleButton}"
                                        Name="PART_ButtonClose">
                                    <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                      Content="{DynamicResource IconClear}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button DockPanel.Dock="Left" Content="{StaticResource LOCClearFilters}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Style="{StaticResource SimpleButton}"
                                        Name="PART_ButtonClear"/>
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,0,16,12">
                                <Button x:Name="PART_ButtonDeleteFilter" Style="{DynamicResource FilterPresetButtonAction}">
                                    <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                      Content="{DynamicResource IconRemove}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button x:Name="PART_ButtonRenameFilter" Style="{DynamicResource FilterPresetButtonAction}">
                                    <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                      Content="{DynamicResource IconEdit}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button x:Name="PART_ButtonSaveFilter" Style="{DynamicResource FilterPresetButtonAction}">
                                    <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                      Content="{DynamicResource IconFilterPresets}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <ComboBox x:Name="PART_ComboFilterPresets"
                                          DockPanel.Dock="Left" VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      DockPanel.Dock="Top" Padding="0,0,0,16">
                                <StackPanel x:Name="PART_PanelItemsHost" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
