<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml (grid view, side panel).
    The same page as the details view in a side panel: the actions sit under the name, the close button sits over the top
    right corner, captions sit above their values.
    A Cyberpunk 2077 menu screen (journal, inventory): near-black page, the game's art as a banner fading into
    it, the title in the title face (HeadingFontFamily, FontSizeLargest) with the short yellow underline the game draws
    under a section title (TabItemIndicatorBrush, 48 x 3), then the actions: Play as the yellow slab
    (PlayButton), the context action and More as dark rows (Button.xaml), Edit a 40px glyph row shown while the pointer
    is over the header. Steam screenshots host and skeleton, then two columns: description and notes as sections
    (heading in the title face with the yellow underline, no box) on the left, the metadata pane on the right as the
    game's info box: the image box fill (ExpanderBackgroundBrush), square, 20px inside, every field Playnite can show
    in six groups (progress, scores, about, tags, library, links) split by the 1px divider (WindowPanelSeparatorBrush);
    a group whose fields are all hidden collapses with its rule. Captions are FontSizeSmall dim grey; values are white body text, text links (PropertyItemButton) or square chips.
    Every PART_ of Playnite's file is kept, each once. HtmlTextView takes Color-typed properties: the brushes are set on
    TextElement.Foreground and Tag and the Colors are bound from them (the one place theme XAML reads a Color).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" Margin="24,24,24,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextBrushDarker}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <Trigger Property="DataContext" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                <!-- Banner: the game's background art as a band of GameBannerHeight (0 turns it off). Faded out downward by the mask, darkened
                                     toward the title by a page-colored scrim, and cached because it is masked. Collapsed when the game has no background
                                     art or Playnite hides the image. -->
                                <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.CacheMode>
                                        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                    </Grid.CacheMode>
                                    <Grid>
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Black" Offset="0.25" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource ContentBackgroundBrush}" Opacity="0.75">
                                            <Border.OpacityMask>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="Transparent" Offset="0.1" />
                                                    <GradientStop Color="Black" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.OpacityMask>
                                        </Border>
                                    </Grid>
                                </Grid>
                                    <Grid Margin="24,0,24,24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                    <!-- Room above the title: the title sits low on the banner; the spacer shrinks when there is no banner. -->
                                    <Border Grid.Row="0" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                        <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 72 / 340'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                <Setter Property="Height" Value="48" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                                        <DockPanel>
                                            <Image x:Name="PART_ImageIcon" MaxHeight="32" MaxWidth="32" DockPanel.Dock="Left" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLarger}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource HeadingForegroundBrush}" />
                                        </DockPanel>
                                        <Border Width="48" Height="3" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                Background="{DynamicResource TabItemIndicatorBrush}" />
                                        <Grid Margin="0,16,0,0" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MaxWidth="160" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" Height="40" />
                                                <Button x:Name="PART_ButtonContextAction" Height="40" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Grid.Column="1" Height="40" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                                                    Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                    <TextBlock Text="{DynamicResource LOCMoreAction}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Grid.Column="2" Width="40" Height="40" Padding="0" Margin="8,0,0,0" Focusable="False"
                                                    VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <!-- Steam Screenshots add-on: its host control, and a skeleton while it loads. The bindings use FallbackValue=PluginUnavailable
                                                 (not False): with the add-on missing or disabled neither the section nor the skeleton shows. The add-on hides its
                                                 control and clears IsControlVisible on every game change and needs about a second, so a Steam library game shows the
                                                 section (skeleton) in that gap, for at most 12 s. -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                    <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                                    <StackPanel>
                                                        <StackPanel Margin="0,0,0,14">
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" />
    <Border Width="48" Height="3" Margin="0,6,0,0" HorizontalAlignment="Left" Background="{DynamicResource TabItemIndicatorBrush}" />
</StackPanel>
                                                        <Grid>
                                                            <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                            <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}"
                                                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                                <Control.Style>
                                                                    <Style TargetType="Control">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Control.Style>
                                                            </Control>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemDescription}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel x:Name="PART_ElemDescription">
                                                    <StackPanel Margin="0,0,0,14">
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCGameDescriptionTitle}" />
    <Border Width="48" Height="3" Margin="0,6,0,0" HorizontalAlignment="Left" Background="{DynamicResource TabItemIndicatorBrush}" />
</StackPanel>
                                                    <HtmlTextView x:Name="PART_HtmlDescription"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"
                                                                  Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemNotes}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel x:Name="PART_ElemNotes">
                                                    <StackPanel Margin="0,0,0,14">
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCNotesLabel}" />
    <Border Width="48" Height="3" Margin="0,6,0,0" HorizontalAlignment="Left" Background="{DynamicResource TabItemIndicatorBrush}" />
</StackPanel>
                                                    <TextBox x:Name="PART_TextNotes" Style="{DynamicResource BareTextBox}" IsReadOnly="True"
                                                             AcceptsReturn="True" TextWrapping="Wrap" Padding="0" BorderThickness="0"
                                                             Foreground="{DynamicResource TextBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Margin="24,0,0,0">
                                            <Border x:Name="DetailsPanel" Width="{DynamicResource GridDetailsPaneWidth}" VerticalAlignment="Top"
                                                    Background="{DynamicResource ExpanderBackgroundBrush}" BorderThickness="0" Padding="20">
                                                <Border.Resources>
                                                    <!-- Values are body text; a TextBlock with Tag="Caption" is the field caption (12px, dim) -->
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                        <Style.Triggers>
                                                            <Trigger Property="Tag" Value="Caption">
                                                        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                </Border.Resources>
                                                <StackPanel>
                                                    <StackPanel Margin="0,0,0,14">
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCGameDetails}" />
    <Border Width="48" Height="3" Margin="0,6,0,0" HorizontalAlignment="Left" Background="{DynamicResource TabItemIndicatorBrush}" />
</StackPanel>
                                                    <!-- The rule of each group is its top border; the wrapper clips the first one (negative margins:
                                                         -(2 x 12 + 1 + 8) on top, -8 at the bottom; change them with the spacing). -->
                                                    <Border ClipToBounds="True">
                                                        <StackPanel Margin="0,-33,0,-8">
                                                            <Border x:Name="MetaProgress" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCCompletionStatus}" />
                                                                        <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCTimePlayed}" />
                                                                        <TextBlock x:Name="PART_TextPlayTime" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCLastPlayed}" />
                                                                        <TextBlock x:Name="PART_TextLastActivity" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCRecentActivityLabel}" />
                                                                        <TextBlock x:Name="PART_TextRecentActivity" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCDateAddedLabel}" />
                                                                        <TextBlock x:Name="PART_TextAdded" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaScores" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCCommunityScore}" />
                                                                        <TextBlock x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCCriticScore}" />
                                                                        <TextBlock x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCUserScore}" />
                                                                        <TextBlock x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaAbout" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCDevelopersLabel}" />
                                                                        <ItemsControl x:Name="PART_ItemsDevelopers" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCPublishersLabel}" />
                                                                        <ItemsControl x:Name="PART_ItemsPublishers" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCGameReleaseDateTitle}" />
                                                                        <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCSeriesLabel}" />
                                                                        <ItemsControl x:Name="PART_ItemsSeries" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCAgeRatingLabel}" />
                                                                        <ItemsControl x:Name="PART_ItemsAgeRatings" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemRegion" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCRegionLabel}" />
                                                                        <ItemsControl x:Name="PART_ItemsRegions" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaTags" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemPlatform" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCPlatformsTitle}" />
                                                                        <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,0,0,-6">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemGenres" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCGenresLabel}" />
                                                                        <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,0,0,-6">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemCategories" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCCategoriesLabel}" />
                                                                        <ItemsControl x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,0,0,-6">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemFeatures" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCFeaturesLabel}" />
                                                                        <ItemsControl x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,0,0,-6">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemTags" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCTagsLabel}" />
                                                                        <ItemsControl x:Name="PART_ItemsTags" Tag="Chip" Margin="0,0,0,-6">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaLibrary" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemLibrary" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCGameProviderTitle}" />
                                                                        <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemSource" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCSourceLabel}" />
                                                                        <Button x:Name="PART_ButtonSource" HorizontalAlignment="Left" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemVersion" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCVersionLabel}" />
                                                                        <Button x:Name="PART_ButtonVersion" HorizontalAlignment="Left" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemInstallSize" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCInstallSizeLabel}" />
                                                                        <TextBlock x:Name="PART_TextInstallSize" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PART_ElemInstallDirectory" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCGameInstallDirTitle}" />
                                                                        <Button x:Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaLinks" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel x:Name="PART_ElemLinks" Margin="0,8,0,8">
                                                                        <TextBlock Tag="Caption" Margin="0,0,0,4" Text="{DynamicResource LOCLinksLabel}" />
                                                                        <ItemsControl x:Name="PART_ItemsLinks" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>

                            <!-- Close (hides the side panel): glyph button over the top right corner -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Width="32" Height="32" Padding="0"
                                    Command="{MainViewModel CloseGameSideBarCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <ContentControl Width="16" Height="16" Focusable="False" IsTabStop="False"
                                                Content="{DynamicResource IconWindowClose}" ContentTemplate="{DynamicResource IconTemplate}" />
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
