<!--
    Night City spacing and focus. Cyberpunk 2077's menus are dense and angular: tight padding, 1px hairlines, a cyan focus box.
    Values are this theme's own (no published spec); GameBannerHeight is the default banner height, edited in ThemeModifier.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Keyboard focus: a 1px cyan box 2px outside the control, no dashes. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="1" Stroke="{DynamicResource FocusBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">0,4</Thickness>
    <Thickness x:Key="MenuItemPadding">14,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,2</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>

    <!-- Default banner height; the game page spacer scales with it (see src/themes/AGENTS.md). -->
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Night City sprites: white masks (art/sprites.py -> Images/fx/*.png) painted with theme brushes through OpacityMask, so ThemeModifier recolours them.
         Alignment lives in the brush: a Rectangle with no Width reports no desired size (Stretch=None draws the sprite at its own size against the named edge), so
         none of these can widen a dialog or a card. -->
    <ImageBrush x:Key="LocalNcCornerBodyMask" ImageSource="{ThemeFile 'Images/fx/corner-body.png'}" Stretch="None" AlignmentX="Right" AlignmentY="Bottom" />
    <ImageBrush x:Key="LocalNcCornerEdgeMask" ImageSource="{ThemeFile 'Images/fx/corner-edge.png'}" Stretch="None" AlignmentX="Right" AlignmentY="Bottom" />
    <ImageBrush x:Key="LocalNcCornerAccentMask" ImageSource="{ThemeFile 'Images/fx/corner-accent.png'}" Stretch="None" AlignmentX="Right" AlignmentY="Bottom" />
    <ImageBrush x:Key="LocalNcRailFootMask" ImageSource="{ThemeFile 'Images/fx/rail-foot.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalNcTopTraceMask" ImageSource="{ThemeFile 'Images/fx/topbar-trace.png'}" Stretch="None" AlignmentX="Right" AlignmentY="Center" />
    <ImageBrush x:Key="LocalNcHexMeshMask" ImageSource="{ThemeFile 'Images/fx/hex-mesh.png'}" TileMode="Tile" Viewport="0,0,90,104" ViewportUnits="Absolute" Stretch="None" />
    <ImageBrush x:Key="LocalNcVeinMask" ImageSource="{ThemeFile 'Images/fx/circuit-vein.png'}" Stretch="None" AlignmentX="Right" AlignmentY="Top" />

    <!-- Crosshair grid (the in-game menu backdrop, as the dialog windows draw it): 48px tiles with a small red cross, painted through OpacityMask. Used on the game pages. -->
    <DrawingBrush x:Key="LocalNcCrossGridMask" TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute" Viewbox="0,0,48,48" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H48 V48 H0 Z" />
                <GeometryDrawing Brush="Black" Geometry="M20,23.5 H28 V24.5 H20 Z M23.5,20 H24.5 V28 H23.5 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Night City corner mark: three masked layers (frame red, tick scale and bracket cyan, commit bar and pips yellow), the in-game menus' three roles.
         Host it as <Control Template="{DynamicResource LocalNightCityCornerTemplate}" Height="120" VerticalAlignment="Top" IsHitTestVisible="False" />:
         the sprite is 360x120 and hugs the host's right edge, so a narrow host shows its right part (it is thin lines, no fills, and stays quiet). No Width: it must report no desired size. -->
    <ControlTemplate x:Key="LocalNightCityCornerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{DynamicResource FrameBrush}" Opacity="0.4" OpacityMask="{DynamicResource LocalNcCornerBodyMask}" />
            <Rectangle Fill="{DynamicResource GlyphBrush}" Opacity="0.4" OpacityMask="{DynamicResource LocalNcCornerEdgeMask}" />
            <Rectangle Fill="{DynamicResource SelectedBrush}" Opacity="0.45" OpacityMask="{DynamicResource LocalNcCornerAccentMask}" />
        </Grid>
    </ControlTemplate>

    <!-- menu-mark begin LocalNightCityMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a netrunner's target lock. Four chamfered red brackets frame three yellow data rows (the menu list).
         Hover (IsMouseOver): the lock snaps on, the four brackets jump 2.5px inward (BackEase, 0.14s), the rows scramble in stepped keyframes like a decrypting
         line (0.18s) and a cyan lock pip blinks on at the row end. Open (ContextMenu.IsOpen of the nearest Border): the whole frame tightens to 0.82, cyan
         brackets take over, the rows dim and a cyan scan line sweeps down and back (0.7s each way, until the menu closes). Every storyboard has an exit that
         restores each property it animates; hover and open never animate the same element and property (corner translates and row scales are hover,
         Lock scale, the cyan brackets, RowsHost opacity and the scan line are open). -->
    <ControlTemplate x:Key="LocalNightCityMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Canvas x:Name="Lock" Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform x:Name="LockS" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                    <Canvas x:Name="CornerTL" Width="24" Height="24">
                        <Canvas.RenderTransform><TranslateTransform x:Name="CornerTLt" X="0" Y="0" /></Canvas.RenderTransform>
                        <Path Data="M1,8 V3 L3,1 H8" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" />
                        <Path x:Name="CornerTLc" Data="M1,8 V3 L3,1 H8" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" Opacity="0" />
                    </Canvas>
                    <Canvas x:Name="CornerTR" Width="24" Height="24">
                        <Canvas.RenderTransform><TranslateTransform x:Name="CornerTRt" X="0" Y="0" /></Canvas.RenderTransform>
                        <Path Data="M16,1 H21 L23,3 V8" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" />
                        <Path x:Name="CornerTRc" Data="M16,1 H21 L23,3 V8" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" Opacity="0" />
                    </Canvas>
                    <Canvas x:Name="CornerBL" Width="24" Height="24">
                        <Canvas.RenderTransform><TranslateTransform x:Name="CornerBLt" X="0" Y="0" /></Canvas.RenderTransform>
                        <Path Data="M1,16 V21 L3,23 H8" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" />
                        <Path x:Name="CornerBLc" Data="M1,16 V21 L3,23 H8" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" Opacity="0" />
                    </Canvas>
                    <Canvas x:Name="CornerBR" Width="24" Height="24">
                        <Canvas.RenderTransform><TranslateTransform x:Name="CornerBRt" X="0" Y="0" /></Canvas.RenderTransform>
                        <Path Data="M16,23 H21 L23,21 V16" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" />
                        <Path x:Name="CornerBRc" Data="M16,23 H21 L23,21 V16" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" Opacity="0" />
                    </Canvas>
                </Canvas>
                <Canvas x:Name="RowsHost" Width="24" Height="24" Opacity="1">
                    <Rectangle Canvas.Left="6" Canvas.Top="7" Width="12" Height="2" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform><ScaleTransform x:Name="Row1S" ScaleX="1" ScaleY="1" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Canvas.Left="6" Canvas.Top="11" Width="8" Height="2" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform><ScaleTransform x:Name="Row2S" ScaleX="1" ScaleY="1" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Canvas.Left="6" Canvas.Top="15" Width="10" Height="2" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform><ScaleTransform x:Name="Row3S" ScaleX="1" ScaleY="1" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
                <Rectangle x:Name="LockPip" Canvas.Left="19" Canvas.Top="11" Width="2" Height="2" Fill="{DynamicResource GlyphBrush}" Opacity="0" />
                <Rectangle x:Name="Scan" Canvas.Left="5" Canvas.Top="5" Width="14" Height="1.5" Fill="{DynamicResource GlyphBrush}" Opacity="0">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="ScanT" X="0" Y="0" /></Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CornerTLt" Storyboard.TargetProperty="X" To="2.5" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CornerTLt" Storyboard.TargetProperty="Y" To="2.5" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CornerTRt" Storyboard.TargetProperty="X" To="-2.5" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CornerTRt" Storyboard.TargetProperty="Y" To="2.5" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CornerBLt" Storyboard.TargetProperty="X" To="2.5" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CornerBLt" Storyboard.TargetProperty="Y" To="-2.5" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CornerBRt" Storyboard.TargetProperty="X" To="-2.5" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CornerBRt" Storyboard.TargetProperty="Y" To="-2.5" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Row1S" Storyboard.TargetProperty="ScaleX"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0.45" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.050" Value="1" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.100" Value="0.7" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.150" Value="1" /></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Row2S" Storyboard.TargetProperty="ScaleX"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="1.6" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.050" Value="0.5" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.100" Value="1.25" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.150" Value="1" /></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Row3S" Storyboard.TargetProperty="ScaleX"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0.6" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.050" Value="1.3" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.100" Value="0.8" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.150" Value="1" /></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LockPip" Storyboard.TargetProperty="Opacity"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.060" Value="1" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.110" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.160" Value="1" /></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CornerTLt" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CornerTLt" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CornerTRt" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CornerTRt" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CornerBLt" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CornerBLt" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CornerBRt" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CornerBRt" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Row1S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.05" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Row2S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.05" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Row3S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.05" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LockPip" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.06" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LockS" Storyboard.TargetProperty="ScaleX" To="0.82" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LockS" Storyboard.TargetProperty="ScaleY" To="0.82" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CornerTLc" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetName="CornerTRc" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetName="CornerBLc" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetName="CornerBRc" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetName="RowsHost" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="Scan" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetName="ScanT" Storyboard.TargetProperty="Y" From="0" To="12" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LockS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.10" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LockS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.10" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CornerTLc" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CornerTRc" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CornerBLc" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CornerBRc" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RowsHost" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Scan" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.06" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ScanT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.05" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalNightCityMenuMarkTemplate -->
</ResourceDictionary>
