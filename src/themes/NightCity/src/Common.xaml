<!--
    Night City spacing and focus. Cyberpunk 2077's menus are dense and angular: tight padding, 1px hairlines, a cyan focus box.
    Values are this theme's own (no published spec); GameBannerHeight is the default banner height, edited in ThemeModifier.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Keyboard focus: a 1px cyan box 2px outside the control, no dashes. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="1" Stroke="{DynamicResource FocusBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">0,4</Thickness>
    <Thickness x:Key="MenuItemPadding">14,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,2</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>

    <!-- Default banner height; the game page spacer scales with it (see src/themes/AGENTS.md). -->
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- menu-mark begin LocalNightCityMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a chamfered cyberdeck panel, three data bars behind a cut corner. Hover (IsMouseOver): a glitch, the bars jump 3px right then 2px left and settle (stepped keyframes, 0.15s) while a cyan ghost of the frame flashes 2px to the side. Open (ContextMenu.IsOpen of the nearest Border): the cut corner fills solid and a cyan ghost frame offset 2px to the other side flickers on a 1.5s loop until the menu closes; exits restore every property. -->
    <ControlTemplate x:Key="LocalNightCityMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Path x:Name="Ghost1" Data="M1,1 H17 L21,5 V21 H1Z" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5" Opacity="0">
                    <Path.RenderTransform><TranslateTransform X="2" Y="0" /></Path.RenderTransform>
                </Path>
                <Path x:Name="Ghost2" Data="M1,1 H17 L21,5 V21 H1Z" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5" Opacity="0">
                    <Path.RenderTransform><TranslateTransform X="-2" Y="0" /></Path.RenderTransform>
                </Path>
                <Path Data="M1,1 H17 L21,5 V21 H1Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Miter" />
                <Canvas x:Name="Bars" Width="22" Height="22">
                    <Canvas.RenderTransform><TranslateTransform x:Name="BarsT" X="0" Y="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="5" Canvas.Top="7" Width="12" Height="2" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="5" Canvas.Top="11.5" Width="8" Height="2" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="5" Canvas.Top="16" Width="10" Height="2" Fill="{TemplateBinding Foreground}" />
                </Canvas>
                <Path x:Name="Notch" Data="M17,1 L21,5 H17Z" Fill="{TemplateBinding Foreground}" Opacity="0" />
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BarsT" Storyboard.TargetProperty="X"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.050" Value="3" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.100" Value="-2" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.150" Value="0" /></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ghost1" Storyboard.TargetProperty="Opacity"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0.9" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.160" Value="0" /></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BarsT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.050" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Ghost1" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.050" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Notch" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.100"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ghost2" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0.9" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.500" Value="0.9" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.560" Value="0.2" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.620" Value="0.9" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.000" Value="0.9" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.060" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.120" Value="0.9" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.500" Value="0.9" /></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Notch" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.120" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Ghost2" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.050" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalNightCityMenuMarkTemplate -->
</ResourceDictionary>
