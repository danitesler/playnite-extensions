<!--
    Night City ContextMenu (Cyberpunk 2077 in-game HUD menu).
      - Panel (LocalNightCityMenuPanelTemplate): #100A12 red-violet void (PopupBackgroundBrush), 1px red chrome edge
        (PopupBorderBrush), 2px Cyberpunk yellow top bar (SelectedBrush), top-left cyan corner tick (GlyphBrush),
        and an 8px bottom-right cut-corner chamfer in FrameBrush. Shared across ContextMenu, submenu popups,
        ComboBox lists, ComboBoxList and FilterSelectionBox.
      - Rows: 30px tall, 24px icon column, plain * label column, shared Auto MenuGestureColumn.
      - Highlight (110ms): red-tinted HoverBrush plate + 1px cyan (GlyphBrush) outline + 3px cyan left bar scaling
        vertically + 5px bottom-right cyan chamfer triangle; label and icon turn cyan.
      - Group break: 10px dim-red rule with a left bright-red HUD segment and right cyan telemetry dash.
      - Shortcuts: dark cyber-keycap chips (InputBackgroundBrush, dim-red rim, red-label monospace; cyan on highlight).
      - Marked rows: Exit (Alt+Q) uses 30% DangerBrush wash over void + 1px red outline + 3px red bar + white text
        (~8.5:1 contrast); checked/selected rows show a 14x14 Cyberpunk yellow (SelectedBrush) square with black check.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalNightCityMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="{DynamicResource PopupBorderThickness}" />
            <!-- 2px Cyberpunk yellow top bar -->
            <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource SelectedBrush}" />
            <!-- Top-left cyan HUD corner tick -->
            <Path Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,3,0,0"
                  Data="M 0,6 L 0,0 L 6,0"
                  Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" />
            <!-- Bottom-right cut-corner chamfer mark -->
            <Path Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Data="M 10,0 L 10,10 L 0,10 Z"
                  Fill="{DynamicResource ShellBackgroundBrush}" />
            <Path Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Data="M 0,10 L 10,0"
                  Stroke="{DynamicResource FrameBrush}" StrokeThickness="1" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="MinWidth" Value="210" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Control Template="{DynamicResource LocalNightCityMenuPanelTemplate}"
                                 Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="5,7,5,7">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
