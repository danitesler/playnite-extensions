<!--
    Night City Menu, MenuItem and Separator (Cyberpunk 2077 in-game HUD).
      - Rows: 30px height, 24px icon column, plain * label column, shared Auto MenuGestureColumn.
      - Highlight (110ms): red-tinted HoverBrush plate + 1px cyan outline + 3px cyan left bar scaling vertically +
        5px bottom-right cyan chamfer triangle; label and icon turn cyan (GlyphBrush).
      - Submenu open: held HoverBrush plate + 1px FrameBrush rim + 2px yellow (SelectedBrush) left bar.
      - Group break: 10px dim-red rule with an 18px bright-red HUD segment on the left and a 4px cyan dash on the right.
      - Shortcuts: dark InputBackgroundBrush keycaps with dim-red border and monospace red-label text (cyan on highlight).
      - Exit (Alt+Q): DangerBrush icon & keycap at rest; 30% DangerBrush wash + 1px red border + 3px red left bar +
        white DangerForegroundBrush label on highlight (~8.5:1 contrast).
      - Checked: 14x14 solid Cyberpunk yellow (SelectedBrush) square with black (TextBrushDark) check.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="Margin" Value="10,4,10,4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Height="1"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" Margin="6,0,6,0" SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" VerticalAlignment="Center" Margin="0,0,4,0"
                                Background="{DynamicResource FrameBrush}" />
                        <Border Grid.Column="1" Height="1" VerticalAlignment="Center"
                                Background="{DynamicResource WindowPanelSeparatorBrush}" />
                        <Border Grid.Column="2" Width="6" Height="1" VerticalAlignment="Center" Margin="4,0,0,0"
                                Background="{DynamicResource GlyphBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TopLevelHeader (preserved) -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border">
            <Grid>
                <Border x:Name="HoverBorder" Background="{DynamicResource HoverBrush}" Visibility="Collapsed" />
                <Border x:Name="SelectedBorder" Background="{DynamicResource SelectedBrush}" Visibility="Collapsed" />
                <TextBlock VerticalAlignment="Center" Padding="8,5" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                    <Grid MinWidth="180" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Control Template="{DynamicResource LocalNightCityMenuPanelTemplate}"
                                 Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="5,7,5,7">
                            <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="HoverBorder" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="SelectedBorder" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- TopLevelItem (preserved) -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" BorderBrush="{DynamicResource PopupBorderBrush}"
                Background="{DynamicResource PopupBackgroundBrush}" BorderThickness="{DynamicResource PopupBorderThickness}">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>

    <!-- SubmenuHeader -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- Held open plate while child submenu is open -->
            <Border x:Name="OpenPlate" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="{DynamicResource HoverBrush}"
                    BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1" />
            <Border x:Name="OpenBar" Visibility="Collapsed" Width="2" HorizontalAlignment="Left" IsHitTestVisible="False"
                    Background="{DynamicResource SelectedBrush}" />

            <!-- Animated cyber-cyan highlight layers -->
            <Border x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource HoverBrush}"
                    BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1" />
            <Border x:Name="HoverBar" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" IsHitTestVisible="False"
                    Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="HoverBarScale" ScaleY="0" />
                </Border.RenderTransform>
            </Border>
            <Path x:Name="HoverCorner" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                  Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Data="M 6,0 L 6,6 L 0,6 Z"
                  Fill="{DynamicResource GlyphBrush}" />

            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon"
                                  TextElement.Foreground="{DynamicResource FrameBrush}" />

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center" Margin="2,0,14,0"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                <Path x:Name="Arrow" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="4,0,2,0"
                      Data="M 0,0 L 4,4 L 0,8"
                      Stroke="{DynamicResource FrameBrush}" StrokeThickness="1.5"
                      StrokeStartLineCap="Square" StrokeEndLineCap="Square" StrokeLineJoin="Miter">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="ArrowShift" X="0" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Right" HorizontalOffset="2" VerticalOffset="-7"
                   Focusable="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Grid MinWidth="180" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Control Template="{DynamicResource LocalNightCityMenuPanelTemplate}"
                             Focusable="False" IsTabStop="False" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Margin="5,7,5,7">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="OpenBar" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedBrush}" />
                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource SelectedBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource GlyphBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.1">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverBarScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.11">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverCorner" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverCorner" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="X"
                                             To="2" Duration="0:0:0.11" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.1" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverBarScale" Storyboard.TargetProperty="ScaleY"
                                             To="0" Duration="0:0:0.1" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverCorner" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverCorner" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="X"
                                             To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MenuRow" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- Animated cyber-cyan highlight layers -->
            <Border x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource HoverBrush}"
                    BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1" />
            <Border x:Name="HoverBar" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" IsHitTestVisible="False"
                    Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="HoverBarScale" ScaleY="0" />
                </Border.RenderTransform>
            </Border>
            <Path x:Name="HoverCorner" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                  Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Data="M 6,0 L 6,6 L 0,6 Z"
                  Fill="{DynamicResource GlyphBrush}" />

            <!-- Danger highlight layers for Exit (Alt+Q): 30% DangerBrush wash over dark void for >= 8.5:1 white text -->
            <Border x:Name="DangerWash" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource DangerBrush}" />
            <Border x:Name="DangerFrame" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" />
            <Border x:Name="DangerBar" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" IsHitTestVisible="False"
                    Background="{DynamicResource DangerBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DangerBarScale" ScaleY="0" />
                </Border.RenderTransform>
            </Border>

            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon"
                                  TextElement.Foreground="{DynamicResource FrameBrush}" />

                <!-- Solid Cyberpunk yellow square with black checkmark -->
                <Grid x:Name="GlyphPanel" Grid.Column="0" Width="14" Height="14"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                    <Path Data="M 0,0 L 14,0 L 14,10 L 10,14 L 0,14 Z"
                          Fill="{DynamicResource SelectedBrush}" />
                    <Path Width="9" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0.5,3.5 L 3.2,6.2 L 8.5,0.8"
                          Stroke="{DynamicResource TextBrushDark}" StrokeThickness="1.8"
                          StrokeStartLineCap="Square" StrokeEndLineCap="Square" StrokeLineJoin="Miter" />
                </Grid>

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center" Margin="2,0,14,0"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                <Border x:Name="GesturePlate" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                        Padding="5,1,5,1"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="GestureText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource TextBrushDarker}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GesturePlate" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GesturePlate" />
            </Trigger>

            <!-- Normal highlight -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="GesturePlate" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="RowHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.1">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverBarScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.11">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverCorner" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverCorner" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.11" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="RowHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.1" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverBarScale" Storyboard.TargetProperty="ScaleY"
                                             To="0" Duration="0:0:0.1" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverCorner" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverCorner" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Exit danger row (Alt+Q) at rest -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="GesturePlate" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Trigger>
            <!-- Exit danger row highlighted -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                    <Condition Property="IsHighlighted" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HoverPlate" Property="Opacity" Value="0" />
                <Setter TargetName="HoverBar" Property="Opacity" Value="0" />
                <Setter TargetName="HoverCorner" Property="Opacity" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="GesturePlate" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="DangerHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerWash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerWash" Storyboard.TargetProperty="Opacity"
                                             To="0.3" Duration="0:0:0.1" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerFrame" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerFrame" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.1" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerBarScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.11">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="DangerHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerWash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerWash" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.1" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerFrame" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerFrame" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.1" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerBarScale" Storyboard.TargetProperty="ScaleY"
                                             To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MenuRow" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
