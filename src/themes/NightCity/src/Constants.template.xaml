<!--
    Night City: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    The Cyberpunk 2077 interface in its yellow livery: near-black cold panels (page 0a0a0d, row 15151b), off-white type,
    the acid brand yellow (yellow fcee0a) as the rail, the Play slab, selection frames and headings, black ink on the
    yellow, netrunner cyan (cyan 02d7f2) for keyboard focus and links, hostile red (red ff003c) for danger. Square
    plates with clipped corners. Keys are the shared theme vocabulary (scripts/data/theme-keys.json).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys) -->
    <sys:Double x:Key="FontSizeSmall">{{px:cp-text-sm}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:cp-text-md}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:cp-text-lg}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:cp-text-xl}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:cp-text-2xl}}</sys:Double>
    <!-- The game sets its whole UI in Rajdhani and minor labels in Orbitron (both OFL, not shipped: a theme cannot
         ship fonts). Bahnschrift is the squared DIN face every Windows 10/11 has, so it carries the look without them. -->
    <FontFamily x:Key="FontFamily">Rajdhani SemiBold, Rajdhani, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Orbitron, Bahnschrift SemiBold, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys): square plates, 1px hairlines, 2px frames -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:cp-radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">0</CornerRadius>
    <Thickness x:Key="FrameThickness">{{px:cp-frame}}</Thickness>

    <!--
        Playnite palette. GlyphColor (selection, checked, links) is the brand yellow; TextColorDark is the black ink
        printed on it. MainColor is a list row, MainColorDark the page.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{cp-text}}</Color>
    <Color x:Key="TextColorDarker">{{cp-text-dim}}</Color>
    <Color x:Key="TextColorDark">{{cp-ink}}</Color>
    <Color x:Key="MainColor">{{cp-row}}</Color>
    <Color x:Key="MainColorDark">{{cp-page}}</Color>
    <Color x:Key="HoverColor">{{cp-row-hover}}</Color>
    <Color x:Key="GlyphColor">{{cp-yellow}}</Color>
    <Color x:Key="HighlightGlyphColor">{{cp-yellow/35}}</Color>
    <Color x:Key="PopupBackgroundColor">{{cp-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{cp-edge}}</Color>
    <Color x:Key="BackgroundToneColor">{{cp-row}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{cp-box}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{cp-edge}}</Color>
    <Color x:Key="DataChangeNotifColor">{{cp-cyan}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{cp-track}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{cp-panel}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{cp-row}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{cp-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{cp-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{cp-orange}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{cp-orange}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{cp-box}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{cp-page}}" />

    <!-- Shell: the rail is a yellow slab with black glyphs, the views sit on the near-black menu background -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{cp-yellow}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{cp-page}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{cp-page}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{cp-row}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{cp-row-hover}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{cp-yellow}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{cp-ink}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{cp-page}}" />

    <!-- States: selection is a yellow frame around a dark row; keyboard focus is cyan -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{cp-yellow}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{cp-yellow}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{cp-row-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{cp-row}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{cp-row-hover}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{cp-cyan}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{cp-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{cp-text}}" />

    <!-- Buttons: dark plates with off-white type; Play is the yellow slab with black ink -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{cp-text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{cp-row-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{cp-row-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{cp-yellow}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{cp-yellow-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{cp-yellow-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{cp-ink}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{cp-row-hover}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{cp-row}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{cp-row-hover}}" />

    <!-- Controls: yellow tick, yellow slider fill on the dark rail, yellow progress -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{cp-yellow-dim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{cp-yellow}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{cp-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{cp-yellow}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{cp-yellow}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{cp-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{cp-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{cp-yellow-dim}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{cp-track}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{cp-yellow-dim}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{cp-yellow}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{cp-yellow-dim}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{cp-yellow}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{cp-row}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{cp-row}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{cp-text-soft}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{cp-row-hover}}" />

    <!-- Popups: dark panel with a dim yellow edge -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{cp-edge}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{cp-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{cp-yellow-dim}}" />

    <!-- Section headings: Orbitron-style caps in yellow -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{cp-yellow}}" />
</ResourceDictionary>
