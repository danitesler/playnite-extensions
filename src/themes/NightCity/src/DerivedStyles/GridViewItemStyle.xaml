<!--
    Night City GridViewItemStyle (cover tiles). Selected (static, setters): 3px GlyphBrush outline outside the cover.
    Hover is the game's glitch-lock, animated both ways on its own layers (no setters on animated parts):
      in  0.12s: the 2px cyan outline (GridViewItemHoverBorderBrush) flickers on (on, dip to 0.4, on), a red ghost
          outline jumps 3 to 4px off it in two stepped frames (0.17s, FrameBrush), and the chamfer cuts at the
          top-left and bottom-right corners (cyan triangles) pop in from their corner (0.14s ease-out).
      out 0.15s: everything fades away; exit animations use FillBehavior Stop so no clock outlives the fade.
    Everything is drawn inside the item's spacing margin or just outside it (the ghost sits 5px out, so with a very small
    grid spacing it clips at the panel edge). Square, no shadow, no OpacityMask.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <Border x:Name="SelectionBorder" BorderThickness="3" Margin="-3" IsHitTestVisible="False" />
                        <ContentPresenter />
                        <!-- Running game: the netrunner uplink, in status green. A 2px frame on the cover's edge over an 8px inner band (the yellow selection outline stays outside). LAUNCHING: a hard block on a
                             slant ratchets across the cover from the top-left corner while a foot of marching dashes fills beside the chip; as it lands the chip's signal bars rise one after another (1.4s loop).
                             RUNNING: dashes full, frame breathes, the bars dip in turn (2.6s). The hover chamfers keep the other two corners. -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="8" Opacity="0.18" />
                            <Rectangle x:Name="RunningScan" Visibility="Collapsed" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7"><GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.132" /><GradientStop x:Name="RunningScanLead" Color="#FF000000" Offset="-0.13" /><GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.04" /><GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="-0.038" /></LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                            <Grid Height="3" Margin="34,0,12,15" VerticalAlignment="Bottom">
                                <Grid.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,6,3" ViewportUnits="Absolute" Viewbox="0,0,6,3" ViewboxUnits="Absolute"><DrawingBrush.Transform><TranslateTransform x:Name="RunningMarch" X="0" /></DrawingBrush.Transform><DrawingBrush.Drawing><GeometryDrawing Brush="#FF000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,3" /></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush>
                                </Grid.OpacityMask>
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Grid Margin="10,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="20" Height="14">
                                <Path Data="M0,0 L20,0 L20,10 L16,14 L0,14 Z" Fill="{DynamicResource ShellBackgroundBrush}" />
                                <Canvas>
                                    <Rectangle x:Name="RunningBar1" Canvas.Left="4" Canvas.Top="9" Width="2" Height="3" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="RunningBar1Scale" ScaleY="1" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle x:Name="RunningBar2" Canvas.Left="8" Canvas.Top="6" Width="2" Height="6" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="RunningBar2Scale" ScaleY="1" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle x:Name="RunningBar3" Canvas.Left="12" Canvas.Top="3" Width="2" Height="9" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="RunningBar3Scale" ScaleY="1" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                </Canvas>
                            </Grid>
                        </Grid>
                        <!-- Hover: animated -->
                        <Border x:Name="HoverGhost" BorderThickness="1" Margin="-5" IsHitTestVisible="False" Opacity="0"
                                BorderBrush="{DynamicResource FrameBrush}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="GhostShift" X="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="HoverBorder" BorderThickness="2" Margin="-2" IsHitTestVisible="False" Opacity="0"
                                BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                        <Path x:Name="CutTopLeft" Data="M0,0 L14,0 L0,14 Z" Fill="{DynamicResource GridViewItemHoverBorderBrush}" Margin="-2"
                              HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0" RenderTransformOrigin="0,0">
                            <Path.RenderTransform>
                                <ScaleTransform x:Name="CutTopLeftScale" ScaleX="0" ScaleY="0" />
                            </Path.RenderTransform>
                        </Path>
                        <Path x:Name="CutBottomRight" Data="M14,14 L0,14 L14,0 Z" Fill="{DynamicResource GridViewItemHoverBorderBrush}" Margin="-2"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0" RenderTransformOrigin="1,1">
                            <Path.RenderTransform>
                                <ScaleTransform x:Name="CutBottomRightScale" ScaleX="0" ScaleY="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.04" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="0.4" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverGhost" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.03" Value="0.9" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.11" Value="0.9" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.17" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostShift" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.11" Value="3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="CutTopLeft" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.04" />
                                        <DoubleAnimation Storyboard.TargetName="CutBottomRight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.04" />
                                        <DoubleAnimation Storyboard.TargetName="CutTopLeftScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CutTopLeftScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CutBottomRightScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CutBottomRightScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverGhost" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CutTopLeft" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CutBottomRight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CutTopLeftScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CutTopLeftScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CutBottomRightScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CutBottomRightScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" TargetName="ItemGrid" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.132" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.158" KeySpline="0.65,0.05 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.158" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanLead" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.13" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.16" KeySpline="0.65,0.05 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.16" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.04" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.25" KeySpline="0.65,0.05 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.038" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.252" KeySpline="0.65,0.05 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.252" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" KeySpline="0.65,0.05 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMarch" Storyboard.TargetProperty="X" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="12" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.72" Value="0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.86" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.84" Value="0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.96" Value="0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.75" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.75" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
