<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml: the Play / Install button on the game page as the game's
    yellow slab: PrimaryButtonBackgroundBrush (yellow fcee0a), black ink (PrimaryButtonForegroundBrush) in the heading
    face (HeadingFontFamily) at FontSizeLarge, ButtonPadding, at least 40 tall, at least 150 wide. The slab is a path
    with its top-left and bottom-right corners clipped (the game's chamfered plates).
    Hover is the Cyberpunk glitch (RESEARCH.md -> Motion), hard-edged on purpose, in and out:
      in  0.1s: the brighter plate (PrimaryButtonHoverBackgroundBrush) fades in; at once a glitch burst runs in stepped
          frames (discrete keyframes, 0.3s): a cyan and a red copy of the slab (HighlightGlyphBrush, DangerBrush) jump
          3 to 4px either side of it, a 7px slice in the yellow shears sideways across the plate and the label shakes 2px. The burst
          repeats every 3s only while the pointer stays on the button.
      out 0.2s: the plate fades back; the burst layers are cut to zero in 0.05s. Exit animations use FillBehavior Stop.
    Pressed is its own plate (PressPlate). No blur, no shadows. Keyboard focus: FocusVisual.
    Deviation: the path is stretched, so the cut grows a little on very wide buttons; the ghosts draw outside the
    button's box, so the parent must not clip them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages (Playnite shows RUNNING or
        LAUNCHING there). The uplink: a green hairline along the cell's foot and three green signal bars at its right end.
        Breathes while running, glitches in stepped frames while launching.
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching). Never hit-testable.
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <!-- Play's own plate (the Chrome path, both cut corners), so the RUNNING button keeps Play's form. -->
                        <Path x:Name="RunningWash" Stretch="Fill" Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Path x:Name="RunningFrame" Stretch="Fill" Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" />
                        <Grid Height="3" Margin="16,0,40,6" VerticalAlignment="Bottom">
                            <Grid.OpacityMask>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,6,3" ViewportUnits="Absolute" Viewbox="0,0,6,3" ViewboxUnits="Absolute"><DrawingBrush.Transform><TranslateTransform x:Name="RunningMarch" X="0" /></DrawingBrush.Transform><DrawingBrush.Drawing><GeometryDrawing Brush="#FF000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,3" /></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush>
                            </Grid.OpacityMask>
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Grid Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="20" Height="14">
                            <Path Data="M0,0 L20,0 L20,10 L16,14 L0,14 Z" Fill="{DynamicResource ShellBackgroundBrush}" />
                            <Canvas>
                                <Rectangle x:Name="RunningBar1" Canvas.Left="4" Canvas.Top="9" Width="2" Height="3" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><ScaleTransform x:Name="RunningBar1Scale" ScaleY="1" /></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="RunningBar2" Canvas.Left="8" Canvas.Top="6" Width="2" Height="6" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><ScaleTransform x:Name="RunningBar2Scale" ScaleY="1" /></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="RunningBar3" Canvas.Left="12" Canvas.Top="3" Width="2" Height="9" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><ScaleTransform x:Name="RunningBar3Scale" ScaleY="1" /></Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" KeySpline="0.65,0.05 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMarch" Storyboard.TargetProperty="X" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="12" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.72" Value="0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.86" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.84" Value="0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.98" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.96" Value="0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.75" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.75" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid SnapsToDevicePixels="True">
                        <Path x:Name="GhostCyan" Stretch="Fill" Fill="{DynamicResource HighlightGlyphBrush}" Opacity="0" IsHitTestVisible="False"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z">
                            <Path.RenderTransform><TranslateTransform x:Name="GhostCyanShift" X="0" /></Path.RenderTransform>
                        </Path>
                        <Path x:Name="GhostRed" Stretch="Fill" Fill="{DynamicResource DangerBrush}" Opacity="0" IsHitTestVisible="False"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z">
                            <Path.RenderTransform><TranslateTransform x:Name="GhostRedShift" X="0" /></Path.RenderTransform>
                        </Path>
                        <Path x:Name="Chrome" Stretch="Fill" Fill="{TemplateBinding Background}"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z" />
                        <!-- Running and launching only, in the slab's double-cut shape and under the label. RunningBreath: a scrim over the solid status-green plate (launching 0.3, running 0.2 to 0.08 breathing). -->
                        <Path x:Name="RunningBreath" Stretch="Fill" Fill="{DynamicResource ShellBackgroundBrush}" Opacity="0" IsHitTestVisible="False"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z" />
                        <!-- RunningScan (launching only): the hard slanted block on the slab's own path, masked on the path itself. -->
                        <Path x:Name="RunningScan" Stretch="Fill" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.7" Visibility="Collapsed" IsHitTestVisible="False"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z">
                            <Path.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35"><GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.132" /><GradientStop x:Name="RunningScanLead" Color="#FF000000" Offset="-0.13" /><GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.04" /><GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="-0.038" /></LinearGradientBrush>
                            </Path.OpacityMask>
                        </Path>
                        <Path x:Name="HoverPlate" Stretch="Fill" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Opacity="0" IsHitTestVisible="False"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z" />
                        <Path x:Name="PressPlate" Stretch="Fill" Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0" IsHitTestVisible="False"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z" />
                        <!-- RunningHoverDim: the Cancel state. A second scrim faded in only while a RUNNING slab is hovered; below the label. -->
                        <Path x:Name="RunningHoverDim" Stretch="Fill" Fill="{DynamicResource ShellBackgroundBrush}" Opacity="0" IsHitTestVisible="False"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z" />
                        <Grid x:Name="HoverFx" ClipToBounds="True" IsHitTestVisible="False">
                            <Rectangle x:Name="Slice" Height="7" VerticalAlignment="Top" Opacity="0"
                                       Fill="{DynamicResource PrimaryButtonBackgroundBrush}">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="SliceShift" X="0" Y="0" />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ContentPresenter x:Name="PlayContent" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="LabelShift" X="0" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverFx" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="GhostCyan" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="GhostRed" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.15" To="0.3" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.132" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.228" KeySpline="0.65,0.05 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.228" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanLead" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.13" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.23" KeySpline="0.65,0.05 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.23" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.04" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.32" KeySpline="0.65,0.05 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.32" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.038" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.322" KeySpline="0.65,0.05 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.322" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverFx" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="GhostCyan" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="GhostRed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.08" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING slab is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostCyan" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.02" Value="0.8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.07" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.11" Value="0.8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.17" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="0.6" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.30" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostCyanShift" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.07" Value="3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.11" Value="-3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.17" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostRed" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="0.7" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.19" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="0.6" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.29" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostRedShift" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="-3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.19" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="-4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Slice" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.19" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.29" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliceShift" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="-6" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliceShift" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="14" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="26" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="-2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.19" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GhostCyan" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GhostRed" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Slice" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GhostCyanShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GhostRedShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SliceShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
            </DataTrigger>
                    <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsRunning}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
