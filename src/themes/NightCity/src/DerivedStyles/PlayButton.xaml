<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml: the Play / Install button on the game page as the game's
    yellow slab: PrimaryButtonBackgroundBrush (yellow fcee0a), black ink (PrimaryButtonForegroundBrush) in the heading
    face (HeadingFontFamily) at FontSizeLarge, ButtonPadding, at least 40 tall, at least 150 wide. The slab is a path
    with its top-left and bottom-right corners clipped (the game's chamfered plates).
    Hover is the Cyberpunk glitch (RESEARCH.md -> Motion), hard-edged on purpose, in and out:
      in  0.1s: the brighter plate (PrimaryButtonHoverBackgroundBrush) fades in; at once a glitch burst runs in stepped
          frames (discrete keyframes, 0.3s): a cyan and a red copy of the slab (HighlightGlyphBrush, DangerBrush) jump
          3 to 4px either side of it, a 7px slice in the yellow shears sideways across the plate and the label shakes 2px. The burst
          repeats every 3s only while the pointer stays on the button.
      out 0.2s: the plate fades back; the burst layers are cut to zero in 0.05s. Exit animations use FillBehavior Stop.
    Pressed is its own plate (PressPlate). No blur, no shadows. Keyboard focus: FocusVisual.
    Deviation: the path is stretched, so the cut grows a little on very wide buttons; the ghosts draw outside the
    button's box, so the parent must not clip them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid SnapsToDevicePixels="True">
                        <Path x:Name="GhostCyan" Stretch="Fill" Fill="{DynamicResource HighlightGlyphBrush}" Opacity="0" IsHitTestVisible="False"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z">
                            <Path.RenderTransform><TranslateTransform x:Name="GhostCyanShift" X="0" /></Path.RenderTransform>
                        </Path>
                        <Path x:Name="GhostRed" Stretch="Fill" Fill="{DynamicResource DangerBrush}" Opacity="0" IsHitTestVisible="False"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z">
                            <Path.RenderTransform><TranslateTransform x:Name="GhostRedShift" X="0" /></Path.RenderTransform>
                        </Path>
                        <Path x:Name="Chrome" Stretch="Fill" Fill="{TemplateBinding Background}"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z" />
                        <Path x:Name="HoverPlate" Stretch="Fill" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Opacity="0" IsHitTestVisible="False"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z" />
                        <Path x:Name="PressPlate" Stretch="Fill" Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0" IsHitTestVisible="False"
                              Data="M 12,0 L 150,0 L 150,28 L 138,40 L 0,40 L 0,12 Z" />
                        <Grid ClipToBounds="True" IsHitTestVisible="False">
                            <Rectangle x:Name="Slice" Height="7" VerticalAlignment="Top" Opacity="0"
                                       Fill="{DynamicResource PrimaryButtonBackgroundBrush}">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="SliceShift" X="0" Y="0" />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="LabelShift" X="0" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostCyan" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.02" Value="0.8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.07" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.11" Value="0.8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.17" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="0.6" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.30" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostCyanShift" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.07" Value="3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.11" Value="-3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.17" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostRed" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="0.7" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.19" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="0.6" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.29" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostRedShift" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="-3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="3" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.19" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="-4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Slice" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.19" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.29" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliceShift" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="-6" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SliceShift" Storyboard.TargetProperty="Y">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="8" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="14" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="26" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.13" Value="-2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.19" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GhostCyan" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GhostRed" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Slice" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GhostCyanShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GhostRedShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SliceShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.05" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
