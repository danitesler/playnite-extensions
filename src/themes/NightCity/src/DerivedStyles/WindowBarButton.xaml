<!--
    Night City WindowBarButton (dialog caption buttons; Playnite's Marlett character in Content picks a drawn 14px glyph). TextBrush glyph, not focusable.
    Resized to the 44x40 caption band. Hover: GlyphBrush yellow glyph on a HoverBrush plate; close hover is DangerBrush (set on the plate).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="WindowBarButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Plate" Background="{DynamicResource ControlBackgroundBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <!-- Drawn glyphs, one 14x14 box each, centred in the 44x40 plate. Marlett's characters ("0" minimize, "1" maximize, "2" restore, "r" close)
                             sit at different heights and left-aligned in their em box, so the three buttons never lined up. Playnite sets Content to that character. -->
                        <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" IsHitTestVisible="False">
                            <Path x:Name="GlyphMin" Visibility="Collapsed" Data="M1,7 H13" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" />
                            <Path x:Name="GlyphMax" Visibility="Collapsed" Data="M1.75,1.75 H12.25 V12.25 H1.75 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Miter" />
                            <Path x:Name="GlyphRestore" Visibility="Collapsed" Data="M4.75,4.75 V1.75 H12.25 V9.25 H9.25 M1.75,4.75 H9.25 V12.25 H1.75 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Miter" />
                            <Path x:Name="GlyphClose" Visibility="Collapsed" Data="M1.5,1.5 L12.5,12.5 M12.5,1.5 L1.5,12.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="0"><Setter Property="Visibility" Value="Visible" TargetName="GlyphMin" /></Trigger>
                        <Trigger Property="Content" Value="1"><Setter Property="Visibility" Value="Visible" TargetName="GlyphMax" /></Trigger>
                        <Trigger Property="Content" Value="2"><Setter Property="Visibility" Value="Visible" TargetName="GlyphRestore" /></Trigger>
                        <Trigger Property="Content" Value="r"><Setter Property="Visibility" Value="Visible" TargetName="GlyphClose" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" TargetName="Plate" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
