<!--
    Night City: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    A 40px void band. The title sits on a solid yellow slab in the heading face, black text, its top-left and
    bottom-right corners chamfered like the Play slab (the cut corners are small band-colored triangles, so the plate
    stays content-sized). A short cyan sliver continues the slab along the band's foot (the glitch ghost), then a yellow
    hairline closes the band. A strip of yellow slashes is ghosted in left of the caption buttons. WindowChrome
    CaptionHeight and the content offset are 40 (Default: 25). PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="40" VerticalAlignment="Top" Background="{DynamicResource ShellBackgroundBrush}" ClipToBounds="True">
                                    <!-- Closing rule and the slashes, in a Canvas so they add no desired width. -->
                                    <Rectangle Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{DynamicResource NormalBorderBrush}" />
                                    <Canvas IsHitTestVisible="False">
                                        <Path Canvas.Right="148" Canvas.Top="14" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="3" Opacity="0.35"
                                              Data="M0,12 L12,0 M10,12 L22,0 M20,12 L32,0 M30,12 L42,0 M40,12 L52,0 M50,12 L62,0" />
                                    </Canvas>
                                    <DockPanel LastChildFill="False">
                                        <Grid DockPanel.Dock="Left" Margin="0,0,0,0">
                                            <Rectangle Fill="{DynamicResource SelectedBrush}" />
                                            <Path Data="M0,0 H12 L0,12 Z" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource ShellBackgroundBrush}" />
                                            <Path Data="M12,0 V12 H0 Z" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource ShellBackgroundBrush}" />
                                            <TextBlock Text="{TemplateBinding Title}"
                                                       Margin="22,0,26,0" VerticalAlignment="Center" MaxWidth="460"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrushDark}" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                        </Grid>
                                        <Rectangle DockPanel.Dock="Left" Width="30" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,0" IsHitTestVisible="False"
                                                   Fill="{DynamicResource HighlightGlyphBrush}" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,4,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,40,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
