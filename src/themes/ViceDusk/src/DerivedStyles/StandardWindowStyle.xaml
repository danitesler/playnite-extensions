<!--
    Vice Dusk: StandardWindowStyle (Settings, Add-ons, Game Editor, dialogs).
    44px Vice twilight plum dusk title band (CaptionHeight=44 matching ContentPresenter top margin 0,44,0,0):
    - Dynamic twilight gradient (LocalDuskDeepBrush -> LocalDuskTopBrush via OpacityMask so ThemeModifier recolors it)
      plus coastal palm silhouettes (palm-dusk.png) inside a zero-size Canvas.
    - Sunset Palm Horizon BrandMarkTemplate, uppercase Barlow Condensed title (WindowSettings sets LOCSettingsLabel;
      PART_TextTitle sits safely inside a Visibility="Collapsed" parent so Playnite never draws bare stray text).
    - 2px Neon Flamingo Pink closing bottom rule & 46x44 WindowBarButton captions.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" ClipToBounds="True">
                                    <!-- Dynamic Vice Twilight Gradient Band -->
                                    <Border Background="{DynamicResource WindowTitleBackgroundBrush}" />
                                    <Rectangle Fill="{DynamicResource LocalDuskTopBrush}" IsHitTestVisible="False">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#99000000" Offset="0.55" />
                                                <GradientStop Color="#FF000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>

                                    <!-- Coastal Palm Silhouettes in a zero-size Canvas (never widens small dialogs) -->
                                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,185,0"
                                            Width="0" Height="0" IsHitTestVisible="False">
                                        <Control Canvas.Left="0" Canvas.Top="-68" Width="140" Height="82"
                                                 Template="{DynamicResource LocalPalmDuskTemplate}"
                                                 Foreground="{DynamicResource LocalPalmBrush}" Opacity="0.72" Focusable="False" />
                                    </Canvas>

                                    <!-- 2px Neon Flamingo Pink Closing Rule -->
                                    <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />

                                    <!-- PART_TextTitle inside Collapsed parent so Playnite never draws bare default title text -->
                                    <Border Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="{TemplateBinding Title}" x:Name="PART_TextTitle" Width="0" Height="0" Opacity="0" Foreground="Transparent" />
                                    </Border>

                                    <DockPanel Margin="14,0,146,0" LastChildFill="False" IsHitTestVisible="False">
                                        <Control DockPanel.Dock="Left" Template="{DynamicResource BrandMarkTemplate}"
                                                 Foreground="{DynamicResource LocalPinkHiBrush}" Width="22" Height="22"
                                                 VerticalAlignment="Center" Focusable="False" />
                                        <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Text, ElementName=PART_TextTitle, Converter={StaticResource StringToUpperCaseConverter}}"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontStretch="Condensed" FontSize="{DynamicResource FontSizeLarger}"
                                                   FontWeight="Bold" Foreground="{DynamicResource WindowTitleForegroundBrush}" />
                                    </DockPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </Grid>
                                <!-- Backdrop height follows the content: its palm art is 220-268px tall and would otherwise
                                     force SizeToContent dialogs (Exiting Playnite, progress) to that height -->
                                <Canvas ClipToBounds="True" IsHitTestVisible="False">
                                    <Control Template="{DynamicResource LocalSunsetBackdropTemplate}" Canvas.Top="44"
                                             Width="{Binding ActualWidth, ElementName=PART_WindowBody}"
                                             Height="{Binding ActualHeight, ElementName=PART_WindowBody}"
                                             Opacity="0.88" Focusable="False" IsHitTestVisible="False" />
                                </Canvas>
                                <ContentPresenter x:Name="PART_WindowBody" Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
