<!--
    Vice Dusk: game page, details view.
    - Banner (GameBannerHeight=300) with GameBannerDarken + 50% floor, soft page-color fade, spacer x * 158 / 300 (floor 20).
    - Header: Game icon + Barlow Condensed Bold title + flamingo dash rule; Flamingo Pink PlayButton +
      RunningActionIndicator + equal 40x40 icon-only SecondaryButton More & Edit.
    - Body: SteamScreenshotsGameScope + Description/Notes alongside JASON DUVAL Dossier Ledger (2px flamingo top crown,
      300px usable inner width, GameDetailsPanePosition Left / Center / Stretch / Right via game-page-breakpoints.mjs).
    - Empty state: EmptyGameTemplate centered in ViewportHeight when Game is null (PART_ScrollViewHost explicitly Visible).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="DetailsViewGameOverview">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DetailsViewGameOverview">
                    <ScrollViewer x:Name="PART_ScrollViewHost" Visibility="Visible" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                        <Grid x:Name="PageRoot" UseLayoutRounding="True">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Control Template="{DynamicResource LocalSunsetBackdropTemplate}" Focusable="False" IsHitTestVisible="False">
                                <Control.Style>
                                    <Style TargetType="Control">
                                        <Setter Property="Opacity" Value="0.92" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Control.Style>
                            </Control>
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False" CacheMode="BitmapCache">
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#ED000000" Offset="0.32" />
                                        <GradientStop Color="#52000000" Offset="0.74" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <!-- Subtle Vice twilight plum cast + title-zone legibility scrim (masked seamlessly to 0 alpha at bottom by HeroArt.OpacityMask) -->
                                <Rectangle Fill="{DynamicResource LocalDuskTopBrush}" Opacity="0.14" IsHitTestVisible="False" />
                                <Rectangle Fill="{DynamicResource ScrimBrush}" Opacity="0.34" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.15" />
                                            <GradientStop Color="#FF000000" Offset="0.72" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                            <StackPanel Margin="30,0,30,30">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border x:Name="DetailsBannerSpacer" MinHeight="20" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 158 / 300'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="20" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
                                                    <Setter Property="Height" Value="20" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel Margin="0,10,0,16">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                                        <Grid MinWidth="184" Height="46">
                                            <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                            <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                            <Control Style="{DynamicResource RunningActionIndicator}" />
                                        </Grid>
                                        <Button x:Name="PART_ButtonMoreActions" Width="46" Height="46" Padding="0" Style="{DynamicResource SecondaryButton}" Margin="10,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                            <ContentControl Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                        <Button x:Name="PART_ButtonEditGame" Width="46" Height="46" Padding="0" Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0" ToolTip="{DynamicResource LOCEditGame}">
                                            <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>
                                    <DockPanel>
                                        <Image x:Name="PART_ImageIcon" MaxWidth="54" MaxHeight="54" Margin="0,0,16,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}" FontStretch="Condensed" FontSize="32"
                                                       FontWeight="Bold" Foreground="{DynamicResource HeadingForegroundBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </DockPanel>
                                <Grid Margin="0,14,0,0" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataViewport" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
<Grid Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                        <Border Background="{DynamicResource LocalDossierGlassBrush}" BorderBrush="{DynamicResource LocalHairlineBrush}"
                                                BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True">
                                            <Grid>
                                                <!-- NeonSign: broken-tube sign segments (pink, cyan, gold) with a soft light spill that breathes slowly -->
<Grid x:Name="NeonCrown" Height="10" VerticalAlignment="Top" IsHitTestVisible="False">
    <Grid.ColumnDefinitions><ColumnDefinition Width="5*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
    <Grid.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="NeonGlowPink" Storyboard.TargetProperty="Opacity" From="0.16" To="0.3" Duration="0:0:3.4" AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="NeonGlowCyan" Storyboard.TargetProperty="Opacity" From="0.14" To="0.28" Duration="0:0:4.6" AutoReverse="True" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="NeonGlowGold" Storyboard.TargetProperty="Opacity" From="0.12" To="0.26" Duration="0:0:2.9" AutoReverse="True" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Grid.Triggers>
    <Rectangle x:Name="NeonGlowPink" Grid.Column="0" Margin="0,0,3,0" Fill="{DynamicResource GlyphBrush}" Opacity="0.2"><Rectangle.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="Black" Offset="0" /><GradientStop Color="Transparent" Offset="1" /></LinearGradientBrush></Rectangle.OpacityMask></Rectangle>
    <Rectangle x:Name="NeonGlowCyan" Grid.Column="1" Margin="0,0,3,0" Fill="{DynamicResource LocalGpsCyanLitBrush}" Opacity="0.18"><Rectangle.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="Black" Offset="0" /><GradientStop Color="Transparent" Offset="1" /></LinearGradientBrush></Rectangle.OpacityMask></Rectangle>
    <Rectangle x:Name="NeonGlowGold" Grid.Column="2" Fill="{DynamicResource LocalNeonGoldBrush}" Opacity="0.16"><Rectangle.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="Black" Offset="0" /><GradientStop Color="Transparent" Offset="1" /></LinearGradientBrush></Rectangle.OpacityMask></Rectangle>
    <Rectangle Grid.Column="0" Height="2" VerticalAlignment="Top" Margin="0,0,3,0" Fill="{DynamicResource GlyphBrush}" />
    <Rectangle Grid.Column="1" Height="2" VerticalAlignment="Top" Margin="0,0,3,0" Fill="{DynamicResource LocalGpsCyanLitBrush}" />
    <Rectangle Grid.Column="2" Height="2" VerticalAlignment="Top" Fill="{DynamicResource LocalNeonGoldBrush}" />
</Grid>
                                                <Border Padding="16,14">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                                            <TextBlock x:Name="OverviewTitleSrc" Visibility="Collapsed" Text="{DynamicResource LOCOverviewLabel}" />
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Text, ElementName=OverviewTitleSrc, Converter={StaticResource StringToUpperCaseConverter}}"
                                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontStretch="Condensed"
                                                                       FontSize="28" FontWeight="Bold"
                                                                       Foreground="{DynamicResource HeadingForegroundBrush}" />
