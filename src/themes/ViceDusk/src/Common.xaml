<!--
    Vice Dusk: Common.xaml — spacing keys (32px ControlHeight rhythm), shared white-mask ImageBrushes,
    9-slice GlowFrameTemplate, GTA VI white-to-fade selection plate (LocalWhiteFadePlateTemplate),
    coastal palm silhouette template (LocalPalmDuskTemplate), DividerTemplate, BrandMarkTemplate,
    and Vice twilight EmptyGameTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Spacing & Metric Keys -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>               <!-- Standard form inputs, combos, buttons -->
    <sys:Double x:Key="IconSize">16</sys:Double>                    <!-- Rail and top bar icons -->
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>           <!-- Default hero banner height (0..600) -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>             <!-- Default banner darkening slider (0..1) -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>               <!-- 32px control height rhythm -->
    <Thickness x:Key="InputPadding">10,5</Thickness>                <!-- 32px TextBox / PasswordBox / ComboBox -->
    <Thickness x:Key="MenuPadding">4,6,4,5</Thickness>              <!-- Compact 30px popup board padding -->
    <Thickness x:Key="MenuItemPadding">10,5</Thickness>             <!-- 30px menu rows -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>        <!-- ComboBox popup padding -->
    <Thickness x:Key="ComboBoxItemPadding">10,5</Thickness>         <!-- ComboBox 30px item rows -->
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>          <!-- ListBox rows -->
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>      <!-- Card GroupBox content inset -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,7</Thickness>              <!-- Dark slate tooltip padding -->

    <!-- Shared FX White-Mask ImageBrushes (allocated once, recolored dynamically by ThemeModifier) -->
    <ImageBrush x:Key="LocalSheenMaskBrush" ImageSource="{ThemeFile 'Images/fx/sheen-sweep.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalWhiteFadeMaskBrush" ImageSource="{ThemeFile 'Images/fx/white-fade-bar.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalPalmDuskMaskBrush" ImageSource="{ThemeFile 'Images/fx/palm-dusk.png'}" Stretch="Uniform" />
    <ImageBrush x:Key="LocalDuskHazeMaskBrush" ImageSource="{ThemeFile 'Images/fx/dusk-haze.png'}" Stretch="Fill" />

    <!-- Shared 9-Slice Bloom Masks (bloom.png 128x128: 32px caps, 64px center) -->
    <ImageBrush x:Key="LocalBloomTLMaskBrush" ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,0,32,32" ViewboxUnits="Absolute" />
    <ImageBrush x:Key="LocalBloomTCMaskBrush" ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="32,0,64,32" ViewboxUnits="Absolute" />
    <ImageBrush x:Key="LocalBloomTRMaskBrush" ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="96,0,32,32" ViewboxUnits="Absolute" />
    <ImageBrush x:Key="LocalBloomMLMaskBrush" ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,32,32,64" ViewboxUnits="Absolute" />
    <ImageBrush x:Key="LocalBloomMCMaskBrush" ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="32,32,64,64" ViewboxUnits="Absolute" />
    <ImageBrush x:Key="LocalBloomMRMaskBrush" ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="96,32,32,64" ViewboxUnits="Absolute" />
    <ImageBrush x:Key="LocalBloomBLMaskBrush" ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,96,32,32" ViewboxUnits="Absolute" />
    <ImageBrush x:Key="LocalBloomBCMaskBrush" ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="32,96,64,32" ViewboxUnits="Absolute" />
    <ImageBrush x:Key="LocalBloomBRMaskBrush" ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="96,96,32,32" ViewboxUnits="Absolute" />

    <!-- Popup Border -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard Focus Visual (neon flamingo focus rim) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="1.5" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 9-Slice Flamingo Bloom (zero desired size beyond caps) -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomTLMaskBrush}" />
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomTCMaskBrush}" />
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomTRMaskBrush}" />
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomMLMaskBrush}" />
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomMCMaskBrush}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomMRMaskBrush}" />
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomBLMaskBrush}" />
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomBCMaskBrush}" />
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBloomBRMaskBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Coastal Palm Silhouette Mask (tinted dynamically by Foreground) -->
    <ControlTemplate x:Key="LocalPalmDuskTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalPalmDuskMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Soft Dusk Haze Glow (tinted dynamically by Foreground) -->
    <ControlTemplate x:Key="LocalDuskHazeTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalDuskHazeMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Full-Canvas Vice Sunset Magenta-Plum Sky + Bottom-Right Coastal Palm Silhouette Cluster -->
    <ControlTemplate x:Key="LocalSunsetBackdropTemplate" TargetType="Control">
        <Grid ClipToBounds="True" IsHitTestVisible="False">
            <Rectangle Fill="{DynamicResource LocalDuskMidBrush}" Opacity="0.78">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.8,1">
                        <GradientStop Color="#EE000000" Offset="0" />
                        <GradientStop Color="#AA000000" Offset="0.62" />
                        <GradientStop Color="#44000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Fill="{DynamicResource LocalDuskTopBrush}" Opacity="0.80">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.82,0.16" GradientOrigin="0.82,0.16" RadiusX="0.82" RadiusY="0.76">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#99000000" Offset="0.48" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Control Template="{DynamicResource LocalDuskHazeTemplate}"
                     Foreground="{DynamicResource GlyphBrush}" Opacity="0.16"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Width="340" Height="220" Margin="0,0,-40,-40" Focusable="False" />
            <Control Template="{DynamicResource LocalPalmDuskTemplate}"
                     Foreground="{DynamicResource ScrimBrush}" Opacity="0.58"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Width="420" Height="268" Margin="0,0,-10,-10" Focusable="False" />
        </Grid>
    </ControlTemplate>

    <!-- GTA VI Settings White-to-Fade Selection Bar (solid LocalWhiteFadeBrush base + Background fade + 3px left bar) -->
    <ControlTemplate x:Key="LocalWhiteFadePlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{DynamicResource LocalWhiteFadeBrush}" />
            <Rectangle Fill="{TemplateBinding Background}" OpacityMask="{DynamicResource LocalWhiteFadeMaskBrush}" />
            <Rectangle Width="3" HorizontalAlignment="Left" Fill="{TemplateBinding BorderBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Flamingo Dash + Jason Duval Dossier Node + Hairline Rule Divider -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="8" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Width="14" Height="2" VerticalAlignment="Center"
                       Fill="{TemplateBinding Foreground}" />
            <Ellipse Grid.Column="1" Width="4" Height="4" Margin="4,0,6,0" VerticalAlignment="Center"
                     Fill="{DynamicResource PrimaryButtonBorderBrush}" Opacity="0.9" />
            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#CC000000" Offset="0.72" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Crisp 2px Corner Brackets (zero desired size) -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Data="M0,10 L0,0 L10,0 L10,2 L2,2 L2,10 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M10,10 L10,0 L0,0 L0,2 L8,2 L8,10 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L0,10 L10,10 L10,8 L2,8 L2,0 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M10,0 L10,10 L0,10 L0,8 L8,8 L8,0 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <!-- Active Tab Indicator: Crisp 2px Neon Flamingo Bottom Rule -->
    <ControlTemplate x:Key="TabItemIndicatorTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- Original Vice Dusk Brand Mark: Coastal Sunset Palm Horizon Emblem (matches art/mark.svg) -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="64" Height="64">
                <Path Fill="{TemplateBinding Foreground}" Opacity="0.90"
                      Data="M13,40 A11,11 0 0 1 35,40 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M40,40 C40.5,32.5 42,26.5 44.2,22.8 C38.5,23.2 32.5,24.8 27.5,27.6 C32.2,22.8 37.8,20.4 43.2,19.8 C37.2,17.5 30.8,17.4 25.2,19.2 C30.8,15.2 37.5,14.2 44,16.5 C41.6,12.2 38.2,9.2 34.4,7.6 C39.5,8.1 44.2,11.1 46.8,15.8 C50.4,12.2 54.8,10.6 58.6,11 C54.2,12.8 50.8,15.6 48.8,19 C53.4,19.2 57.6,21.4 60,25.2 C55.8,22.8 51.6,21.8 47.6,22.4 C45.2,26.4 43.8,32.5 43.2,40 Z" />
                <Rectangle Canvas.Left="10" Canvas.Top="43" Width="44" Height="4" RadiusX="1" RadiusY="1" Fill="{TemplateBinding Foreground}" />
                <Rectangle Canvas.Left="16" Canvas.Top="50" Width="32" Height="2.5" RadiusX="1" RadiusY="1" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- SteamScreenshots Plugin Loading Skeleton -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False">
            <Border Height="220" Background="{TemplateBinding Foreground}" Opacity="0.09"
                    BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}" Margin="0,0,0,8" />
            <UniformGrid Columns="5">
                <Border Height="46" Margin="0,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.09" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Height="46" Margin="0,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.07" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Height="46" Margin="0,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.09" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Height="46" Margin="0,0,6,0" Background="{TemplateBinding Foreground}" Opacity="0.07" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Height="46" Background="{TemplateBinding Foreground}" Opacity="0.09" CornerRadius="{DynamicResource CornerRadiusSmall}" />
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- Empty Game Page: Breathing Vice Twilight Dusk + Palm Horizon + Vice Dusk Brand Mark -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="380" Height="262" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Control x:Name="EmptyDuskHaze" Template="{DynamicResource LocalDuskHazeTemplate}"
                             Foreground="{DynamicResource LocalDuskTopBrush}" Opacity="0.45" Focusable="False">
                        <Control.Style>
                            <Style TargetType="Control">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="EmptyDuskPulse">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.28" To="0.7" Duration="0:0:3.2">
                                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="EmptyDuskPulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Control.Style>
                    </Control>

                    <!-- Palms flank the sunset and sway (named rotate transforms, started from ControlTemplate.Triggers) -->
                    <Control Template="{DynamicResource LocalPalmDuskTemplate}" Width="150" Height="130" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,0,0" Foreground="{DynamicResource LocalDuskMidBrush}" Opacity="0.7" Focusable="False" RenderTransformOrigin="0.5,1">
                        <Control.RenderTransform><RotateTransform x:Name="EmptyPalmR" Angle="-2" /></Control.RenderTransform>
                    </Control>
                    <Control Template="{DynamicResource LocalPalmDuskTemplate}" Width="120" Height="104" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="0,0,0,6" Foreground="{DynamicResource LocalDuskMidBrush}" Opacity="0.55" Focusable="False" RenderTransformOrigin="0.5,1">
                        <Control.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1" />
                                <RotateTransform x:Name="EmptyPalmL" Angle="2" />
                            </TransformGroup>
                        </Control.RenderTransform>
                    </Control>

                    <!-- Setting sun: a pink dome fading toward the horizon, drifting slowly down and up behind the clip -->
                    <Grid Width="190" Height="86" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,94,0,0" ClipToBounds="True">
                        <Ellipse Width="190" Height="190" VerticalAlignment="Top" Margin="0,10,0,0" Fill="{DynamicResource GlyphBrush}">
                            <Ellipse.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.55">
                                    <GradientStop Color="#F2000000" Offset="0" />
                                    <GradientStop Color="#33000000" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.OpacityMask>
                            <Ellipse.RenderTransform><TranslateTransform x:Name="EmptySunShift" Y="0" /></Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,188,0,0">
                            <Rectangle x:Name="EmptySea0" Width="200" Height="2" Margin="0,0,0,7" Fill="{DynamicResource GlyphBrush}" Opacity="0.70" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="EmptySeaScale0" ScaleX="1" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="EmptySea1" Width="156" Height="2" Margin="0,0,0,7" Fill="{DynamicResource GlyphBrush}" Opacity="0.57" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="EmptySeaScale1" ScaleX="1" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="EmptySea2" Width="112" Height="2" Margin="0,0,0,7" Fill="{DynamicResource GlyphBrush}" Opacity="0.44" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="EmptySeaScale2" ScaleX="1" /></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="EmptySea3" Width="70" Height="2" Margin="0,0,0,7" Fill="{DynamicResource GlyphBrush}" Opacity="0.31" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="EmptySeaScale3" ScaleX="1" /></Rectangle.RenderTransform></Rectangle>
                    </StackPanel>


                    <Path x:Name="EmptyStarA" Data="M 6,0 L 7.6,4.4 L 12,6 L 7.6,7.6 L 6,12 L 4.4,7.6 L 0,6 L 4.4,4.4 Z" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource DataChangeNotifBrush}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70,36,0,0" IsHitTestVisible="False" />
                    <Path x:Name="EmptyStarB" Data="M 6,0 L 7.6,4.4 L 12,6 L 7.6,7.6 L 6,12 L 4.4,7.6 L 0,6 L 4.4,4.4 Z" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource HighlightGlyphBrush}" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,64,0" IsHitTestVisible="False" />
                    <Path x:Name="EmptyStarC" Data="M 6,0 L 7.6,4.4 L 12,6 L 7.6,7.6 L 6,12 L 4.4,7.6 L 0,6 L 4.4,4.4 Z" Stretch="Uniform" Width="10" Height="10" Fill="{DynamicResource TextBrush}" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,128,0" IsHitTestVisible="False" />
                    <Path x:Name="EmptyStarD" Data="M 6,0 L 7.6,4.4 L 12,6 L 7.6,7.6 L 6,12 L 4.4,7.6 L 0,6 L 4.4,4.4 Z" Stretch="Uniform" Width="8" Height="8" Fill="{DynamicResource TextBrush}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,12,0,0" IsHitTestVisible="False" />
                    <Path x:Name="EmptyStarE" Data="M 6,0 L 7.6,4.4 L 12,6 L 7.6,7.6 L 6,12 L 4.4,7.6 L 0,6 L 4.4,4.4 Z" Stretch="Uniform" Width="10" Height="10" Fill="{DynamicResource HighlightGlyphBrush}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="36,84,0,0" IsHitTestVisible="False" />
                    <Path x:Name="EmptyStarF" Data="M 6,0 L 7.6,4.4 L 12,6 L 7.6,7.6 L 6,12 L 4.4,7.6 L 0,6 L 4.4,4.4 Z" Stretch="Uniform" Width="8" Height="8" Fill="{DynamicResource DataChangeNotifBrush}" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,112,30,0" IsHitTestVisible="False" />
                    <Path x:Name="EmptyStarG" Data="M 6,0 L 7.6,4.4 L 12,6 L 7.6,7.6 L 6,12 L 4.4,7.6 L 0,6 L 4.4,4.4 Z" Stretch="Uniform" Width="7" Height="7" Fill="{DynamicResource TextBrush}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,58,0,0" IsHitTestVisible="False" />
                    <Path x:Name="EmptyStarH" Data="M 6,0 L 7.6,4.4 L 12,6 L 7.6,7.6 L 6,12 L 4.4,7.6 L 0,6 L 4.4,4.4 Z" Stretch="Uniform" Width="9" Height="9" Fill="{DynamicResource TextBrush}" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,86,96,0" IsHitTestVisible="False" />
                    <Path x:Name="EmptyStarI" Data="M 6,0 L 7.6,4.4 L 12,6 L 7.6,7.6 L 6,12 L 4.4,7.6 L 0,6 L 4.4,4.4 Z" Stretch="Uniform" Width="7" Height="7" Fill="{DynamicResource HighlightGlyphBrush}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="92,120,0,0" IsHitTestVisible="False" />
                    <Path x:Name="EmptyStarJ" Data="M 6,0 L 7.6,4.4 L 12,6 L 7.6,7.6 L 6,12 L 4.4,7.6 L 0,6 L 4.4,4.4 Z" Stretch="Uniform" Width="9" Height="9" Fill="{DynamicResource DataChangeNotifBrush}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" IsHitTestVisible="False" />
                </Grid>

                <Control Template="{DynamicResource DividerTemplate}" Margin="0,0,0,12"
                         Foreground="{DynamicResource GlyphBrush}" BorderBrush="{DynamicResource FrameBrush}" Focusable="False" />

                <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                           FontFamily="{DynamicResource HeadingFontFamily}"
                           FontStretch="Condensed"
                           FontWeight="Bold"
                           FontSize="36"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Grid>
            <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyViceIdle">
                        <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="EmptySunShift" Storyboard.TargetProperty="Y" From="-8" To="14" Duration="0:0:6.0" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="EmptyPalmR" Storyboard.TargetProperty="Angle" From="-2.5" To="2.5" Duration="0:0:3.6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="EmptyPalmL" Storyboard.TargetProperty="Angle" From="2.5" To="-2.5" Duration="0:0:3.2" BeginTime="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="EmptySeaScale0" Storyboard.TargetProperty="ScaleX" From="1" To="0.62" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="EmptySeaScale1" Storyboard.TargetProperty="ScaleX" From="0.7" To="1" Duration="0:0:2.1" BeginTime="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="EmptySeaScale2" Storyboard.TargetProperty="ScaleX" From="1" To="0.55" Duration="0:0:2.7" BeginTime="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="EmptySeaScale3" Storyboard.TargetProperty="ScaleX" From="0.6" To="1" Duration="0:0:1.9" BeginTime="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
