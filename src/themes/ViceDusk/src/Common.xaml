    <!-- Section Heading TextBlock Style (2x bold Barlow Condensed section titles: Description, Notes, etc.) -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a retro sunset, the top half of the sun over three tapering water stripes, in the flamingo pink. Hover: the stripes shimmer sideways in alternating directions (staggered, eased). Open (ContextMenu.IsOpen of the nearest Border): the sun dips toward the horizon, a neon horizon line draws out from the middle and three gold dusk stars twinkle at different paces until the menu closes. -->
    <ControlTemplate x:Key="LocalViceDuskMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="SunDip" Y="0" /></Canvas.RenderTransform>
                    <Path x:Name="Sun" Data="M5,13 A8,8 0 0 1 21,13 Z" Fill="{TemplateBinding Foreground}" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="ShimmerA" X="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="5" Canvas.Top="15.2" Width="16" Height="1.8" RadiusX="0.6" RadiusY="0.6" Fill="{TemplateBinding Foreground}" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="ShimmerB" X="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="6.8" Canvas.Top="18.4" Width="12.4" Height="1.5" RadiusX="0.6" RadiusY="0.6" Fill="{TemplateBinding Foreground}" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="ShimmerC" X="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="8.8" Canvas.Top="21.2" Width="8.4" Height="1.2" RadiusX="0.6" RadiusY="0.6" Fill="{TemplateBinding Foreground}" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Rectangle x:Name="Horizon" Canvas.Left="1.5" Canvas.Top="12.9" Width="23" Height="1.2" Fill="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><ScaleTransform x:Name="HorizonScale" ScaleX="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Path x:Name="StarA" Data="M6,4 L6.7,5.3 L8,6 L6.7,6.7 L6,8 L5.3,6.7 L4,6 L5.3,5.3Z" Fill="{DynamicResource LocalNeonGoldBrush}" Opacity="0" />
                    <Path x:Name="StarB" Data="M20.5,2.5 L21.2,3.8 L22.5,4.5 L21.2,5.2 L20.5,6.5 L19.8,5.2 L18.5,4.5 L19.8,3.8Z" Fill="{DynamicResource LocalNeonGoldBrush}" Opacity="0" />
                    <Path x:Name="StarC" Data="M16.5,7 L17.2,8.3 L18.5,9 L17.2,9.7 L16.5,11 L15.8,9.7 L14.5,9 L15.8,8.3Z" Fill="{DynamicResource LocalNeonGoldBrush}" Opacity="0" />
                </Canvas>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ShimmerA" Storyboard.TargetProperty="X" To="2.4" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ShimmerB" Storyboard.TargetProperty="X" To="-2.4" BeginTime="0:0:0.05" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ShimmerC" Storyboard.TargetProperty="X" To="2.4" BeginTime="0:0:0.1" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShimmerA" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShimmerB" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShimmerC" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SunDip" Storyboard.TargetProperty="Y" To="3.4" Duration="0:0:0.6"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Sun" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HorizonScale" Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.1" Duration="0:0:0.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StarA" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.25" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StarA" Storyboard.TargetProperty="Opacity" From="0.15" To="1" BeginTime="0:0:0.45" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StarB" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.35" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StarB" Storyboard.TargetProperty="Opacity" From="0.15" To="1" BeginTime="0:0:0.55" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StarC" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.45" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StarC" Storyboard.TargetProperty="Opacity" From="0.15" To="1" BeginTime="0:0:0.65" Duration="0:0:1.7" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SunDip" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Sun" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HorizonScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="StarA" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="StarB" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="StarC" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
