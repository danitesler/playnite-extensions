<!--
    Vice Dusk: GroupBox — Content-sized dark twilight plum card crowned by a 2px Neon Flamingo Pink top bar
    (safe for Playnite's wrapping Statistics view: zero fixed widths >= 200, zero wide Paths, zero Line Stretch="Fill").
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="True" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <DockPanel DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}" LastChildFill="True">
                                <Rectangle DockPanel.Dock="Left" Width="4" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                  TextElement.FontStretch="Condensed"
                                                  TextElement.FontSize="24"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.Foreground="{DynamicResource SectionHeaderBrush}" />
                            </DockPanel>
                            <ContentPresenter />
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
