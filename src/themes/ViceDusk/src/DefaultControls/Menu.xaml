<!--
    Vice Dusk: Menu.xaml — GTA VI Settings/Exploration popup menu rows and group breaks (docs/themes/menus.md).
    - Panel: LocalMenuBoardTemplate (smoked charcoal-plum drawer, 2px neon flamingo top crown, bottom-right palm watermark).
    - Highlight (30px rows): stark white-to-lavender fade plate (LocalWhiteFadePlateTemplate) with 3px neon flamingo
      left bar sweeps in horizontally (ScaleX 0.90->1, 120ms CubicEase), label glides +3px right in dark plum ink
      (>=9.3:1 across full width), and icons invert cleanly via TextElement.Foreground on TargetName="Icon".
    - Group break (10px): 14px neon flamingo horizontal dash opening a fading 1px lavender hairline.
    - Shortcuts: recessed dark keycap chips (Cascadia Mono), inverting to solid dark plum ink chips with white text on highlight.
    - Checked rows: Control Scheme circular ring enclosing a neon flamingo-pink dot.
    - Exit (Alt+Q): Siren Crimson label/icon/cap at rest; solid Siren Crimson plate with white left bar & white text (5.47:1).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Flamingo dash + fading hairline separator (10px) -->
    <Style x:Key="{x:Type Separator}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource DividerTemplate}" VerticalAlignment="Center"
                             Foreground="{DynamicResource GlyphBrush}" BorderBrush="{DynamicResource MenuSeparatorBrush}"
                             Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource DividerTemplate}" VerticalAlignment="Center"
                             Foreground="{DynamicResource GlyphBrush}" BorderBrush="{DynamicResource MenuSeparatorBrush}"
                             Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard Menu Row (SubmenuItemTemplateKey, 30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="Root" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated white-to-lavender fade highlight plate + 3px neon flamingo bar -->
            <Control x:Name="HighlightPlate" Template="{DynamicResource LocalWhiteFadePlateTemplate}"
                     Background="{DynamicResource MenuItemHoverBrush}" BorderBrush="{DynamicResource GlyphBrush}"
                     RenderTransformOrigin="0,0.5" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False">
                <Control.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" ScaleY="1" />
                </Control.RenderTransform>
            </Control>

            <!-- Exit danger highlight plate (solid Siren Crimson with 3px white bar) -->
            <Grid x:Name="ExitHighlightPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border Background="{DynamicResource DangerBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource DangerForegroundBrush}" />
            </Grid>

            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <!-- Fixed 24px icon / pink-dot circular check column -->
                <Grid Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ContentPresenter x:Name="Icon" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Opacity="0.88" />
                    <Grid x:Name="CheckRing" Width="14" Height="14" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="CheckOuter" Stroke="{DynamicResource SelectedBrush}" StrokeThickness="1.5"
                                 Fill="{DynamicResource InputBackgroundBrush}" />
                        <Ellipse x:Name="CheckDot" Width="6" Height="6" Fill="{DynamicResource GlyphBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- Label (plain * column so shortcuts stay flush right) -->
                <TextBlock x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis" Foreground="{TemplateBinding Foreground}">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>

                <!-- Control Scheme recessed keycap shortcut badge -->
                <Border x:Name="ShortcutChip" Grid.Column="2" VerticalAlignment="Center" Padding="5,1"
                        Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}">
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrushDarker}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutChip" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutChip" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckRing" Property="Visibility" Value="Visible" />
            </Trigger>

            <!-- Exit row (Alt+Q) at rest: Siren Crimson text & rimmed keycap -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource LocalDangerLitBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource LocalDangerLitBrush}" />
                <Setter TargetName="ShortcutChip" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource LocalDangerLitBrush}" />
            </Trigger>

            <!-- Highlight animation (pointer or keyboard) for standard rows -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="Opacity" Value="1" />
                <Setter TargetName="CheckOuter" Property="Stroke" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="ShortcutChip" Property="Background" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="ShortcutChip" Property="BorderBrush" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource LocalWhiteBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" To="0.90" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Exit highlighted: solid Siren Crimson plate + white text/icon/keycap (5.47:1) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HighlightPlate" Property="Opacity" Value="0" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutChip" Property="Background" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutChip" Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="ExitRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExitHighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="ExitHighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="ExitRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="ExitHighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExitHighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Submenu Header Row (SubmenuHeaderTemplateKey, 30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="Root" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held plate while submenu is open (setter, no flicker when moving pointer into submenu) -->
            <Grid x:Name="OpenPlate" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource LocalPinkWashBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}" />
            </Grid>

            <Control x:Name="HighlightPlate" Template="{DynamicResource LocalWhiteFadePlateTemplate}"
                     Background="{DynamicResource MenuItemHoverBrush}" BorderBrush="{DynamicResource GlyphBrush}"
                     RenderTransformOrigin="0,0.5" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False">
                <Control.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" ScaleY="1" />
                </Control.RenderTransform>
            </Control>

            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.88"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis" Foreground="{TemplateBinding Foreground}">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>

                <ContentControl x:Name="Arrow" Grid.Column="3" Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource TextBrushDarker}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Focusable="False" IsHitTestVisible="False" />
            </Grid>

            <Popup x:Name="Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-8"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade">
                <Grid MinWidth="212" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer CanContentScroll="True" Margin="5,8,5,5"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Icon" />
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="Opacity" Value="1" />
                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubHeaderIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubHeaderOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" To="0.90" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="{DynamicResource MenuItemPadding}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
