<!--
    Vice Dusk: ContextMenu & shared LocalMenuBoardTemplate (GTA VI Exploration / Fix Your Car floating drawer).
    Panel: smoked charcoal-plum drawer (PopupBackgroundBrush) with 1px lavender-slate border,
    2px neon flamingo-pink top crown rule (GlyphBrush), and subtle coastal palm silhouette watermark
    in the bottom-right corner (palm-dusk.png at 14% opacity).
    Shared by ContextMenu, Submenu popups, ComboBox dropdowns, and multi-select popups (docs/themes/menus.md).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared menu board chrome hosted across ContextMenu, Submenu, ComboBox, ComboBoxList and FilterSelectionBox -->
    <ControlTemplate x:Key="LocalMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" ClipToBounds="True">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <!-- Subtle twilight palm silhouette in bottom-right corner -->
            <Control Template="{DynamicResource LocalPalmDuskTemplate}" Width="140" Height="90"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1"
                     Foreground="{DynamicResource LocalDuskTopBrush}" Opacity="0.14" Focusable="False" />
            <!-- Signature 2px Neon Flamingo Pink top crown rule -->
            <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="216" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid MinWidth="{TemplateBinding MinWidth}" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer CanContentScroll="True" Margin="5,8,5,5"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
