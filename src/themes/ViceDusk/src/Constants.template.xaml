<!--
    Vice Dusk: Constants.xaml template. scripts/build-theme.ps1 renders tokens.css placeholders into Constants.xaml.
    Palette maps by role: Deep smoked plum-charcoal HUD chrome, atmospheric Vice magenta-plum twilight backdrop,
    neon flamingo-pink rules/toggles/Play CTA, stark white-to-lavender selection plates with dark plum ink,
    Leonida GPS cyan running telemetry, Sunbelt emerald status pills, Vice Gold diamond pips, and Siren crimson Exit.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (WPF bundles Barlow Condensed inside Typography/#Barlow via FontStretch="Condensed") -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">13.5</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">26</sys:Double>
    <sys:Double x:Key="FontSizeLargest">56</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow, {{text:vd-font-body|Barlow, Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Barlow Condensed, {{text:vd-font-heading|Barlow Condensed, Bahnschrift Condensed, Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">./Typography/#Cascadia Mono, {{text:vd-font-mono|Cascadia Mono, Consolas}}</FontFamily>

    <!-- Game page metadata pane defaults (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape & radii -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:vd-radius|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:vd-radius-sm|1}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:vd-radius-lg|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{vd-ink}}</Color>
    <Color x:Key="TextColorDarker">{{vd-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{vd-ink-dim}}</Color>
    <Color x:Key="MainColor">{{vd-panel}}</Color>
    <Color x:Key="MainColorDark">{{vd-void}}</Color>
    <Color x:Key="HoverColor">{{vd-hover}}</Color>
    <Color x:Key="GlyphColor">{{vd-pink}}</Color>
    <Color x:Key="HighlightGlyphColor">{{vd-pink-hi}}</Color>
    <Color x:Key="PopupBackgroundColor">{{vd-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{vd-border-bright}}</Color>
    <Color x:Key="BackgroundToneColor">{{vd-panel-raised}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{vd-border}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{vd-border}}</Color>
    <Color x:Key="DataChangeNotifColor">{{vd-gold}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{vd-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{vd-card}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{vd-panel-raised}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{vd-well}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{vd-emerald}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{vd-crimson}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{vd-warning}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{vd-warning}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{vd-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{vd-page}}" />

    <!-- Shared Shell & Game Page Brushes -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{vd-void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{vd-panel}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{vd-page}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{vd-page}}" />
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{vd-dusk-deep}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{vd-void}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{vd-panel-raised}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{vd-pink}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{vd-well}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{vd-panel-raised}}" />

    <!-- Shared State Brushes -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{vd-white}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{vd-white-soft}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{vd-pink}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{vd-ink-dark}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{vd-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{vd-white}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{vd-white}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{vd-gps-cyan}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{vd-pink-hi}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{vd-focus-halo}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{vd-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{vd-crimson-fg}}" />

    <!-- Shared Button Brushes -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{vd-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{vd-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{vd-panel-press}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{vd-border-bright}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{vd-pink}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{vd-pink-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{vd-pink-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{vd-white}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{vd-ink-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{vd-pink}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{vd-panel-raised}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{vd-border-bright}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{vd-hover}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{vd-panel-press}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{vd-white}}" />

    <!-- Shared Input & Control Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{vd-well}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{vd-panel}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{vd-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{vd-border-bright}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{vd-border-bright}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{vd-pink}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{vd-well}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{vd-white}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{vd-pink-hi}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{vd-pink-hi}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{vd-gps-cyan-lit}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{vd-well}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{vd-border-bright}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{vd-pink}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{vd-void}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{vd-border-bright}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{vd-pink}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{vd-ink-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{vd-ink}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{vd-pink}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{vd-pink-hi}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{vd-pink}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{vd-white}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{vd-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{vd-white}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{vd-ink-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{vd-ink-dark}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{vd-pink}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{vd-panel-raised}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{vd-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{vd-white}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{vd-pink-hi}}" />

    <!-- Shared Popup, Frame & Typography Brushes -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{vd-hairline-strong}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{vd-ink}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{vd-border-bright}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{vd-dusk-deep}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{vd-ink}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{vd-border-bright}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{vd-border}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{vd-ink}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{vd-ink}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{vd-pink}}" />

    <!-- Vice Dusk Local Semantic & Contrast Brushes -->
    <SolidColorBrush x:Key="LocalPinkHiBrush" Color="{{vd-pink-hi}}" />
    <SolidColorBrush x:Key="LocalPinkDimBrush" Color="{{vd-pink-dim}}" />
    <SolidColorBrush x:Key="LocalPinkWashBrush" Color="{{vd-pink-wash}}" />
    <SolidColorBrush x:Key="LocalWhiteBrush" Color="{{vd-ink}}" />
    <SolidColorBrush x:Key="LocalWhiteFadeBrush" Color="{{vd-white-fade}}" />
    <SolidColorBrush x:Key="LocalHairlineBrush" Color="{{vd-hairline}}" />
    <SolidColorBrush x:Key="LocalDuskTopBrush" Color="{{vd-dusk-top}}" />
    <SolidColorBrush x:Key="LocalDuskMidBrush" Color="{{vd-dusk-mid}}" />
    <SolidColorBrush x:Key="LocalPalmBrush" Color="{{vd-palm}}" />
    <SolidColorBrush x:Key="LocalDossierGlassBrush" Color="{{vd-dossier-glass}}" />
    <SolidColorBrush x:Key="LocalGpsCyanLitBrush" Color="{{vd-gps-cyan-lit}}" />
    <SolidColorBrush x:Key="LocalNeonGoldBrush" Color="{{vd-gold}}" />
    <SolidColorBrush x:Key="LocalGpsForegroundBrush" Color="{{vd-ink}}" />
    <SolidColorBrush x:Key="LocalDangerLitBrush" Color="{{vd-crimson-hi}}" />
    <SolidColorBrush x:Key="LocalEmeraldPillBrush" Color="{{vd-emerald-pill}}" />

</ResourceDictionary>
