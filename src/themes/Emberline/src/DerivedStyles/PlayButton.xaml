<!--
    Emberline: Play, the source's START GAME plate. A black plate in a card hairline with faint scratches, the label in
    the display face, white. Layers bottom to top: bloom, plate, scratches, hover plate, pressed plate, reload bar,
    prompt cap, burning frame, label (uppercase).
    Hover, animated both ways (no setters on animated parts, so nothing snaps):
      in  0.2s: the burning frame ignites around the plate, a cinder wash and an ember bloom fade in, and the reload
          bar shows along the plate's foot (a hairline track with a white "perfect" zone two thirds along); the
          source's prompt cap (a white key cap with the play glyph) slides in 8px from the left. While
          hovered the frame flickers on its wrapper in an uneven 2.4s loop.
      out 0.35s: everything burns down; every exit animation has FillBehavior Stop, so no clock is left running.
    Press, on its own layers so leaving while pressed cannot strand the hover state: the reload marker sweeps from the
    left into the perfect zone in 0.12s (PowerEase out), the zone flashes and a dried-blood plate fades in.
    Sprites are white masks filled with theme brushes. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite
        swaps Play for the context action (RUNNING); the whole plate takes a frost tint and a frost frame with the pilot light
        at its foot, breathing (3.2s). Launching flickers like a pilot catching. Never hit-testable, never the hover fire.
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching).
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Rectangle x:Name="RunningWash" Margin="1" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" />
                        <Grid Height="2" Margin="8,0,8,4" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <StackPanel Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Height="16">
                            <Rectangle x:Name="RunningEmber1" Width="2" Height="2" VerticalAlignment="Center" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="RunningEmber1Rise" Y="5" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="RunningEmber2" Width="2" Height="2" Margin="4,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="RunningEmber2Rise" Y="5" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="RunningEmber3" Width="2" Height="2" Margin="4,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="RunningEmber3Rise" Y="5" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningEmber1Rise" Storyboard.TargetProperty="Y" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="-8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="-8" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningEmber1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningEmber2Rise" Storyboard.TargetProperty="Y" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="-8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="-8" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningEmber2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningEmber3Rise" Storyboard.TargetProperty="Y" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.75" Value="-8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="-8" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningEmber3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.28" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.75" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningEmber1Rise" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="-7" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="-7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningEmber1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningEmber2Rise" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.3" Value="-7" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="-7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningEmber2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.3" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningEmber3Rise" Storyboard.TargetProperty="Y" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="5" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="-7" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="-7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningEmber3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the scan has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20,0,20,3" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid x:Name="BloomWrap" Margin="-26,-22" IsHitTestVisible="False">
                            <Control x:Name="Bloom" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0" Focusable="False" />
                        </Grid>
                        <Border x:Name="PlayFill" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1" SnapsToDevicePixels="True" />
                        <Border x:Name="RunningBreath" Margin="1" Background="{DynamicResource ScrimBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Grid x:Name="RunningScan" Margin="1" Visibility="Collapsed" Opacity="0.4" IsHitTestVisible="False">
                            <Grid.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#FF000000" Offset="0.5" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Grid.OpacityMask>
                            <Border Background="{DynamicResource RunningIndicatorBrush}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.35" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                        <Rectangle Margin="1" IsHitTestVisible="False" Fill="{DynamicResource BevelLightBrush}" Opacity="0.6">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/grime.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,256,256" ViewportUnits="Absolute" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Border x:Name="HoverPlate" Margin="1" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="PressedPlate" Margin="1" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0" IsHitTestVisible="False" />
                        <!-- Reload bar: track, perfect zone (columns 62* / 9* / 29*), and the marker run that scales from the left to 0.68. -->
                        <Grid x:Name="ReloadBar" Height="3" Margin="12,0,12,6" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62*" />
                                <ColumnDefinition Width="9*" />
                                <ColumnDefinition Width="29*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.ColumnSpan="3" Fill="{DynamicResource FrameBrush}" />
                            <Rectangle x:Name="PerfectZone" Grid.Column="1" Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.6" />
                            <Rectangle x:Name="ReloadRun" Grid.ColumnSpan="3" Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="ReloadScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <!-- The source's prompt cap ([A] START CAMPAIGN): a white key cap with the play glyph in ink, sliding in from the left on hover. -->
                        <Grid x:Name="PromptCap" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,3" Opacity="0" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="PromptShift" X="-8" />
                            </Grid.RenderTransform>
                            <Border Background="{DynamicResource PrimaryButtonForegroundBrush}" />
                            <Viewbox Width="10" Height="10">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{DynamicResource IconPlay}" Fill="{DynamicResource TextBrushDark}" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <Grid x:Name="EmberWrap" IsHitTestVisible="False">
                            <Control x:Name="Ember" Template="{DynamicResource EmberFrameTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0" Visibility="Hidden" Focusable="False" />
                        </Grid>
                        <Border x:Name="RunningHoverDim" Margin="1" Background="{DynamicResource ScrimBrush}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="PlayContent" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <ContentControl x:Name="CancelLabel" Content="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"
                                        FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold"
                                        Foreground="{TemplateBinding Foreground}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="BloomWrap" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ReloadBar" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PromptCap" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EmberWrap" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.92" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.35" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.352" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.352" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="BloomWrap" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ReloadBar" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PromptCap" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EmberWrap" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.78" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.64" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.78" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PromptCap" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Ember" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ReloadBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PromptCap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PromptShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ember" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.2">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmberWrap" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="0.74" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.96" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="0.68" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.3" Value="0.9" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="0.78" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BloomWrap" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0.6" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BloomWrap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="EmberWrap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Ember" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ReloadBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PromptCap" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PromptShift" Storyboard.TargetProperty="X" To="-8" Duration="0:0:0.35" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Ember" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ReloadRun" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.04" />
                                        <DoubleAnimation Storyboard.TargetName="ReloadScale" Storyboard.TargetProperty="ScaleX" From="0" To="0.68" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PerfectZone" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.08" Duration="0:0:0.04" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ReloadRun" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ReloadScale" Storyboard.TargetProperty="ScaleX" To="0.68" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PerfectZone" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
