<!--
    Emberline: cover tiles, drawn as the source's mode cards.
    Selected, static: the burning frame around the cover at full strength with a 1px ember line on the cover's edge,
    as the source frames its chosen card.
    Hover, animated both ways: a white hairline lifts off the cover's edge (0.12s) while the frame catches fire
    (0.2s, PowerEase out) over a low ember light and flickers on its wrapper in an uneven 2.4s loop for as long as the
    pointer stays. Leaving burns it down in 0.35s with FillBehavior Stop. Hover and selected share no layer; the
    white line and the flicker belong to hover only, so one never reads as the other.
    Drawn inside the item's spacing margin. Library art behind has no OpacityMask (reference.md).
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}" Margin="{Settings ItemSpacingMargin}" x:Name="ItemGrid">
                        <Grid x:Name="LightWrap" Margin="-20" IsHitTestVisible="False">
                            <Control x:Name="HoverLight" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                     Opacity="0" Visibility="Hidden" Focusable="False" />
                        </Grid>
                        <ContentPresenter />
                        <!-- Selected, static: the burning frame at full strength with its hot line on the cover's edge. -->
                        <Border x:Name="SelectionBorder" BorderThickness="1" Margin="-1" IsHitTestVisible="False" />
                        <Control x:Name="SelectedFrame" Template="{DynamicResource EmberFrameTemplate}" Foreground="{DynamicResource GridViewItemSelectedBorderBrush}"
                                 Margin="-2" Visibility="Collapsed" Focusable="False" />
                        <!-- Hover, animated: a white hairline lifts off the cover while the frame catches fire and flickers. -->
                        <Border x:Name="HoverLine" BorderThickness="1" Margin="-1" BorderBrush="{DynamicResource FocusBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Grid x:Name="HoverWrap" IsHitTestVisible="False">
                            <Control x:Name="HoverFrame" Template="{DynamicResource EmberFrameTemplate}" Foreground="{DynamicResource GridViewItemHoverBorderBrush}"
                                     Margin="-2" Opacity="0" Visibility="Hidden" Focusable="False" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLight" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="HoverLight" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.2">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverWrap" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="0.72" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.95" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="0.66" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.3" Value="0.9" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="0.76" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverLight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverWrap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverLight" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedFrame" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
