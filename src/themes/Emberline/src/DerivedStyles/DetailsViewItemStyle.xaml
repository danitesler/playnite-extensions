<!--
    Emberline: game list rows, the source's main menu list. Installed games in white, the rest in grey (Default's
    rule). Hover lifts the row onto a black plate with a hairline. The selected row takes the menu's red streak: a
    3px ember bar on its left edge and red light fading to the right over a cinder plate, sliding in from the left in
    200ms (PowerEase out), with the name in white. No frame here: a burning frame on every row of a long list would
    be noise. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid>
                        <Control x:Name="HoverRectangle" Visibility="Collapsed" Template="{DynamicResource BevelTemplate}" Background="{DynamicResource ListItemHoverBrush}"
                                 BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Focusable="False" />
                        <Grid x:Name="SelectedRectangle" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0,0.5" SnapsToDevicePixels="True">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="StreakScale" ScaleX="1" />
                            </Grid.RenderTransform>
                            <Rectangle Fill="{DynamicResource ListItemSelectedBrush}" />
                            <Rectangle Fill="{DynamicResource SidebarItemSelectedGlowBrush}" Opacity="0.42">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="0.8" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource SelectedBorderBrush}" />
                        </Grid>
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="HoverRectangle" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedRectangle" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverRectangle" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="StreakScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <PowerEase Power="4" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
