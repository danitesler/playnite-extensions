<!--
    Emberline: spacing, focus and the shared motifs. Measurements: ../RESEARCH.md.
      BevelTemplate         an options row: flat black plate with a hairline edge
      FramedPlateTemplate   a card frame: one hairline, a brighter line across its head
      RivetsTemplate        kept empty: the source has no studs or ornaments on its plates
      SelectionBarTemplate  the selection: a black plate inside the burning frame (four ember strips + a hot inner line)
      EmberFrameTemplate    the burning frame alone, for hover layers that animate
      GlowLineTemplate      a panel's flare rule: a hairline that fades at both ends under a light flare
      GlowFrameTemplate     bloom behind a plate
      DividerTemplate       the white slanted tab that opens a title, then a rule
      CornerMarksTemplate   white corner ticks (keyboard focus)
    Sprites are white masks filled with theme brushes, so ThemeModifier edits reach them. None of these report a
    desired width of their own (Statistics cards stay compact).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Option rows: text sits 12px inside a plate (the source: 20px on a 44px row at 1080p); buttons 16px. -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,7</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,0</Thickness>
    <Thickness x:Key="TooltipPadding">8,4</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">360</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Options row. Background = the plate, BorderBrush + BorderThickness = its hairline. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="Control">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- The source's plates carry no studs. The key stays so files that reference it keep loading. -->
    <ControlTemplate x:Key="RivetsTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Card frame. Foreground = the hairline. Overlay it on a panel; it draws no fill. -->
    <ControlTemplate x:Key="FramedPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" />
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource FrameHoverBrush}" Opacity="0.55">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- The burning frame. Foreground = the fire. Four 14px strips that tile along their length; the band's
         centre runs 1px inside the host's edge. Strips are held 7px short of the corners so they meet, not cross. -->
    <ControlTemplate x:Key="EmberFrameTemplate" TargetType="Control">
        <Grid Margin="-8" IsHitTestVisible="False">
            <Rectangle Height="14" Margin="7,0" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/ember-top.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,256,14" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="14" Margin="7,0" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/ember-bottom.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,256,14" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="14" Margin="0,7" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/ember-left.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,14,256" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="14" Margin="0,7" HorizontalAlignment="Right" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/ember-right.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,14,256" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- The selection. Foreground = the plate inside the fire, BorderBrush = the fire. A dim wash rises from the
         plate's foot, as the frame's light does on the source's black rows. -->
    <ControlTemplate x:Key="SelectionBarTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Foreground}" />
            <Rectangle Fill="{DynamicResource SelectedSheenBrush}" Opacity="0.5">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.35" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Opacity="0.55" />
            <Control Template="{DynamicResource EmberFrameTemplate}" Foreground="{TemplateBinding BorderBrush}" Focusable="False" />
        </Grid>
    </ControlTemplate>

    <!-- Flare rule, 16px tall: host it with a negative vertical margin so only the hairline takes room.
         Foreground = the rule's cool grey, BorderBrush = the flare's white. The flare keeps to the middle 420px. -->
    <ControlTemplate x:Key="GlowLineTemplate" TargetType="Control">
        <Grid Height="16" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.18" />
                        <GradientStop Color="#FF000000" Offset="0.82" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle MaxWidth="420" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/flare.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Bloom. The host decides its own bleed with a negative margin. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- The white slanted tab the source puts before every screen title, then a rule for the rest of the row. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" VerticalAlignment="Center" Height="12" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Width="10" Height="12" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" Data="M3,0 L10,0 7,12 0,12Z" />
            <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{DynamicResource HeadingRuleBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- White corner ticks, arm 8, 1px. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,8 L0,0 8,0 8,1 1,1 1,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L8,0 8,8 7,8 7,1 0,1Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L1,0 1,7 8,7 8,8 0,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M7,0 L8,0 8,8 0,8 0,7 7,7Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Keyboard focus: white corner ticks 3px outside the control. -->
    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
