<!--
    Emberline: spacing, focus and the shared motifs. Measurements: ../RESEARCH.md.
      BevelTemplate         an options row: flat black plate with a hairline edge
      FramedPlateTemplate   a card frame: one hairline, a brighter line across its head
      RivetsTemplate        kept empty: the source has no studs or ornaments on its plates
      SelectionBarTemplate  the selection: a black plate inside the burning frame (four ember strips + a hot inner line)
      EmberFrameTemplate    the burning frame alone, for hover layers that animate
      GlowLineTemplate      a panel's flare rule: a hairline that fades at both ends under a light flare
      GlowFrameTemplate     bloom behind a plate
      DividerTemplate       the white slanted tab that opens a title, then a rule
      CornerMarksTemplate   white corner ticks (keyboard focus)
    Sprites are white masks filled with theme brushes, so ThemeModifier edits reach them. None of these report a
    desired width of their own (Statistics cards stay compact).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Option rows: text sits 12px inside a plate (the source: 20px on a 44px row at 1080p); buttons 16px. -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,7</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,0</Thickness>
    <Thickness x:Key="TooltipPadding">8,4</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">360</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Options row. Background = the plate, BorderBrush + BorderThickness = its hairline. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="Control">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- The source's plates carry no studs. The key stays so files that reference it keep loading. -->
    <ControlTemplate x:Key="RivetsTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Card frame. Foreground = the hairline. Overlay it on a panel; it draws no fill. -->
    <ControlTemplate x:Key="FramedPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" />
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource FrameHoverBrush}" Opacity="0.55">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.5" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- The burning frame. Foreground = the fire. Four 14px strips that tile along their length; the band's
         centre runs 1px inside the host's edge. Strips are held 7px short of the corners so they meet, not cross. -->
    <ControlTemplate x:Key="EmberFrameTemplate" TargetType="Control">
        <Grid Margin="-8" IsHitTestVisible="False">
            <Rectangle Height="14" Margin="7,0" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/ember-top.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,256,14" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="14" Margin="7,0" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/ember-bottom.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,256,14" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="14" Margin="0,7" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/ember-left.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,14,256" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="14" Margin="0,7" HorizontalAlignment="Right" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/ember-right.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,14,256" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- The selection. Foreground = the plate inside the fire, BorderBrush = the fire. A dim wash rises from the
         plate's foot, as the frame's light does on the source's black rows. -->
    <ControlTemplate x:Key="SelectionBarTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Foreground}" />
            <Rectangle Fill="{DynamicResource SelectedSheenBrush}" Opacity="0.5">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.35" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Opacity="0.55" />
            <Control Template="{DynamicResource EmberFrameTemplate}" Foreground="{TemplateBinding BorderBrush}" Focusable="False" />
        </Grid>
    </ControlTemplate>

    <!-- Flare rule, 16px tall: host it with a negative vertical margin so only the hairline takes room.
         Foreground = the rule's cool grey, BorderBrush = the flare's white. The flare keeps to the middle 420px. -->
    <ControlTemplate x:Key="GlowLineTemplate" TargetType="Control">
        <Grid Height="16" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.18" />
                        <GradientStop Color="#FF000000" Offset="0.82" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle MaxWidth="420" Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/flare.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Bloom. The host decides its own bleed with a negative margin. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- The white slanted tab the source puts before every screen title, then a rule for the rest of the row. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" VerticalAlignment="Center" Height="12" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Width="10" Height="12" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" Data="M3,0 L10,0 7,12 0,12Z" />
            <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{DynamicResource HeadingRuleBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- White corner ticks, arm 8, 1px. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,8 L0,0 8,0 8,1 1,1 1,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L8,0 8,8 7,8 7,1 0,1Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L1,0 1,7 8,7 8,8 0,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M7,0 L8,0 8,8 0,8 0,7 7,7Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Keyboard focus: white corner ticks 3px outside the control. -->
    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Empty game page: the loading screen's mark frozen in ice. The cog-tooth mark floats in frost blue over a breathing crystalline glow, a toothed gear
         ring turns slowly behind it, a cold scan line sweeps down through it, frost embers lift off, and a glint travels along the flare rule under the
         words. Named transforms and opacities only, started from ControlTemplate.Triggers (never a Style trigger), removed on exit. -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Grid Width="340" Height="268" HorizontalAlignment="Center">
                <Rectangle x:Name="EmptyFrostGlow" Width="256" Height="256" Fill="{DynamicResource TitleSuffixBrush}" Opacity="0.95">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/frost.png'}" Stretch="Fill" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <!-- the gear ring: toothed by its dashes -->
                <Ellipse Width="212" Height="212" Stroke="{DynamicResource TitleSuffixBrush}" StrokeThickness="12" StrokeDashArray="0.9 1.1" Opacity="0.22" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform x:Name="EmptyFrostGear" Angle="0" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="188" Height="188" Stroke="{DynamicResource FrameHoverBrush}" StrokeThickness="1" Opacity="0.7" />
                <Viewbox Width="140" Height="140" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform><TranslateTransform x:Name="EmptyFrostFloat" Y="0" /></Viewbox.RenderTransform>
                    <Canvas Width="24" Height="24">
                        <Path Data="{DynamicResource IconMainMenu}" Fill="{DynamicResource TextShadowBrush}" Opacity="0.55">
                            <Path.RenderTransform><TranslateTransform X="0.35" Y="0.45" /></Path.RenderTransform>
                        </Path>
                        <Path Data="{DynamicResource IconMainMenu}" Fill="{DynamicResource TitleSuffixBrush}" />
                    </Canvas>
                </Viewbox>
                <!-- scan line -->
                <Grid Width="180" Height="180" ClipToBounds="True">
                    <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource TitleSuffixBrush}" Opacity="0.6">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                        <Rectangle.RenderTransform><TranslateTransform x:Name="EmptyFrostScan" Y="0" /></Rectangle.RenderTransform>
                        
                    </Rectangle>
                </Grid>
                <!-- corner ticks -->
                <Path Data="M0,12 L0,0 L12,0" Stroke="{DynamicResource FrameHoverBrush}" StrokeThickness="1" Margin="14,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Path Data="M0,0 L12,0 L12,12" Stroke="{DynamicResource FrameHoverBrush}" StrokeThickness="1" Margin="0,10,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                <Path Data="M0,0 L0,12 L12,12" Stroke="{DynamicResource FrameHoverBrush}" StrokeThickness="1" Margin="14,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <Path Data="M12,0 L12,12 L0,12" Stroke="{DynamicResource FrameHoverBrush}" StrokeThickness="1" Margin="0,0,14,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                <!-- embers -->
                <Rectangle x:Name="EmptyFrostEmberA" Width="4" Height="4" Margin="96,0,0,52" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource TitleSuffixBrush}" Opacity="0">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="EmptyFrostEmberAShift" Y="0" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="EmptyFrostEmberB" Width="3" Height="3" Margin="0,0,88,64" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" Opacity="0">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="EmptyFrostEmberBShift" Y="0" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="EmptyFrostEmberC" Width="3" Height="3" Margin="150,0,0,40" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource TitleSuffixBrush}" Opacity="0">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="EmptyFrostEmberCShift" Y="0" /></Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,4,0,0" Style="{DynamicResource HeadingTextBlock}" />
            <Grid Width="260" Height="16" Margin="0,8,0,0" HorizontalAlignment="Center" ClipToBounds="True">
                <Control Template="{DynamicResource GlowLineTemplate}" Foreground="{DynamicResource TopPanelRuleStartBrush}" BorderBrush="{DynamicResource TopPanelRuleEndBrush}" Focusable="False" />
                <Rectangle x:Name="EmptyFrostGlint" Width="40" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TextBrush}" Opacity="0">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="0.5" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                    <Rectangle.RenderTransform><TranslateTransform x:Name="EmptyFrostGlintShift" X="-130" /></Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyFrostIdle">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="EmptyFrostGlow" Storyboard.TargetProperty="Opacity" From="0.95" To="0.45" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyFrostGear" Storyboard.TargetProperty="Angle" From="-14" To="14" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyFrostFloat" Storyboard.TargetProperty="Y" From="0" To="-6" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyFrostScan" Storyboard.TargetProperty="Y" From="-4" To="176" Duration="0:0:4.5" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmptyFrostGlintShift" Storyboard.TargetProperty="X" From="-130" To="130" Duration="0:0:3.2" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyFrostGlint" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0.9" /><LinearDoubleKeyFrame KeyTime="0:0:2.7" Value="0.9" /><LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyFrostEmberA" Storyboard.TargetProperty="Opacity" Duration="0:0:5" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.9" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:5" Value="0" KeySpline="0.4,0,0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="EmptyFrostEmberAShift" Storyboard.TargetProperty="Y" From="0" To="-100" Duration="0:0:5" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyFrostEmberB" Storyboard.TargetProperty="Opacity" Duration="0:0:6" BeginTime="0:0:1.4" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.9" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:6" Value="0" KeySpline="0.4,0,0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="EmptyFrostEmberBShift" Storyboard.TargetProperty="Y" From="0" To="-120" Duration="0:0:6" BeginTime="0:0:1.4" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyFrostEmberC" Storyboard.TargetProperty="Opacity" Duration="0:0:4.5" BeginTime="0:0:2.8" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0.8" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:4.5" Value="0" KeySpline="0.4,0,0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="EmptyFrostEmberCShift" Storyboard.TargetProperty="Y" From="0" To="-80" Duration="0:0:4.5" BeginTime="0:0:2.8" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyFrostIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Main menu mark (Sidebar tab and TopPanel PART_ElemMainMenu): a cog with a tooth broken off at three o'clock, 20x20, drawn in
         the host's Foreground (ink on the white tab; the tab's own hover trigger turns it red). Hover (IsMouseOver of the
         nearest Border, so the whole 44x62 button counts): the cog ratchets one tooth, 45 degrees, with a small overshoot
         (BackEase, 0.22s) and clicks back on exit. Open (the menu's ContextMenu.IsOpen on the same Border, which is
         PART_ElemMainMenu): the engine catches: the cog spins up (one turn every 1.8s, constant speed, like a chain
         saw at idle), an ember core lights in its hub (scale 0.2 to 1) and breathes, and the whole mark shivers 0.5px at 70ms
         until the menu closes. The ratchet turns the inner canvas and the spin the outer one, so the two never fight. -->
    <ControlTemplate x:Key="LocalEmberlineMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="False">
            <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas.RenderTransform><TranslateTransform x:Name="Shiver" X="0" /></Canvas.RenderTransform>
                <Canvas Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><RotateTransform x:Name="SpinTurn" Angle="0" /></Canvas.RenderTransform>
                    <Canvas Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><RotateTransform x:Name="RatchetTurn" Angle="0" /></Canvas.RenderTransform>
                        <Path Data="M8.29,2.59 L8.61,0.10 L11.39,0.10 L11.71,2.59 A7.6,7.6 0 0 1 14.03,3.55 L16.02,2.01 L17.99,3.98 L16.45,5.97 A7.6,7.6 0 0 1 16.45,14.03 L17.99,16.02 L16.02,17.99 L14.03,16.45 A7.6,7.6 0 0 1 11.71,17.41 L11.39,19.90 L8.61,19.90 L8.29,17.41 A7.6,7.6 0 0 1 5.97,16.45 L3.98,17.99 L2.01,16.02 L3.55,14.03 A7.6,7.6 0 0 1 2.59,11.71 L0.10,11.39 L0.10,8.61 L2.59,8.29 A7.6,7.6 0 0 1 3.55,5.97 L2.01,3.98 L3.98,2.01 L5.97,3.55 A7.6,7.6 0 0 1 8.29,2.59 Z M6,10 A4,4 0 1 0 14,10 A4,4 0 1 0 6,10 Z"
                              Fill="{TemplateBinding Foreground}" />
                    </Canvas>
                </Canvas>
                <Ellipse x:Name="Core" Canvas.Left="7.25" Canvas.Top="7.25" Width="5.5" Height="5.5" Fill="{DynamicResource HighlightGlyphBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="CoreScale" ScaleX="0.2" ScaleY="0.2" /></Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RatchetTurn" Storyboard.TargetProperty="Angle" To="45" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RatchetTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SpinTurn" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.8" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="Core" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.25" BeginTime="0:0:0.4" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
