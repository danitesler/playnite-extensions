<!--
    Emberline: left rail, 44px of near black with faint scratches, closed on its inner edge by a hairline. The main
    menu is the white slanted tab the source puts before every screen title, 32px, holding the theme's own mark in
    ink (a broken cog-tooth ring; no owner mark), a short hairline under it. Hover turns the mark menu red and fades an
    ember bloom in behind the tab. With the sidebar at the top or bottom the hairlines drop away.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource TopPanelBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <Rectangle IsHitTestVisible="False" Fill="{DynamicResource BevelLightBrush}" Opacity="0.5">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/grime.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,256,256" ViewportUnits="Absolute" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="62" Margin="0,0,0,2"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Control x:Name="SealBloom" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                                 Width="44" Height="44" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0" Focusable="False" />
                                        <Path x:Name="Seal" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" Width="32" Height="32" VerticalAlignment="Top" Margin="0,8,0,0"
                                              Data="M7,0 L32,0 25,32 0,32Z" SnapsToDevicePixels="True" />
                                        <ContentControl x:Name="MenuMark" Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource MainMenuButtonForegroundBrush}" Focusable="False"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" />
                                        <Path x:Name="SealOrnament" Width="24" Height="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Fill="{DynamicResource NormalBorderBrush}"
                                              Data="M0,0 L24,0 24,1 0,1Z" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                            <Border x:Name="EdgeRule" Width="2" HorizontalAlignment="Right" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                    Background="{DynamicResource BevelShadowBrush}" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="1,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" TargetName="MenuMark" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SealBloom" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SealBloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                            <Setter Property="BorderThickness" Value="0,0,1,0" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SealOrnament" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Margin" Value="0,6,0,0" TargetName="Seal" />
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="SealBloom" />
                            <Setter Property="Margin" Value="0,14,0,0" TargetName="MenuMark" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SealOrnament" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Margin" Value="0,6,0,0" TargetName="Seal" />
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="SealBloom" />
                            <Setter Property="Margin" Value="0,14,0,0" TargetName="MenuMark" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
