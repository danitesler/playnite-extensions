<!--
    Overlay on Playnite Default/DefaultControls/Menu.xaml.
    Emberline menus: Gears 5 sharp 0px menu rows (30px).
      Panel:     LocalEmberMenuPanelTemplate (ContextMenu.xaml).
      Highlight: main-menu red streak — cinder plate (SelectedBrush) + horizontal SelectedSheenBrush fire wash +
                 3px GlyphBrush left bar + slanted DangerBrush tab sliding in (120ms PowerEase 4 out); label snaps
                 to white and nudges 2px right.
      Submenu:   held SelectedBrush plate with 3px DangerBrush bar and 1px SelectedBorderBrush frame.
      Breaks:    10px row with a miniature 7x6 slanted tab (HeadingMarkerBrush) leading a fading hairline.
      Shortcuts: square dark hairline boxes at rest; stamp into solid white key caps (TooltipBackgroundBrush /
                 TooltipForegroundBrush) on highlight.
      Checked:   14x14 white square key-cap checkbox with ink IconCheck.
      Exit:      GlyphBrush (#ff2100) label at rest; dried-blood plate (PrimaryButtonPressedBackgroundBrush) with
                 GlyphBrush perimeter frame, 3px bar, white label and burning GlyphBrush key cap on highlight.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu group break (10px): miniature Gears 5 slanted title tab + fading hairline. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="6,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid VerticalAlignment="Center" Height="6" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="7" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Fill="{DynamicResource HeadingMarkerBrush}" Opacity="0.45"
                              Data="M2,0 L7,0 5,6 0,6 Z" />
                        <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center"
                                   Fill="{DynamicResource HeadingRuleBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#CC000000" Offset="0" />
                                    <GradientStop Color="#88000000" Offset="0.65" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TopLevelHeader -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="{TemplateBinding Background}">
            <Grid>
                <TextBlock VerticalAlignment="Center" Padding="{DynamicResource MenuItemPadding}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                    <Grid Margin="0,4,0,0" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalEmberMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <StackPanel Margin="5,7,5,5" Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Grid>
                </Popup>
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- TopLevelItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="{TemplateBinding Background}">
            <TextBlock VerticalAlignment="Center" Padding="{DynamicResource MenuItemPadding}" Style="{DynamicResource BaseTextBlockStyle}" Foreground="{TemplateBinding Foreground}">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </TextBlock>
        </Border>
    </ControlTemplate>

    <!-- SubmenuHeader -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True" ClipToBounds="True">
            <!-- Held plate while submenu is open -->
            <Grid x:Name="OpenPlate" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource SelectedBrush}"
                        BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1" Opacity="0.85" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource DangerBrush}" />
            </Grid>
            <!-- Animated highlight plate: Gears 5 main-menu red streak -->
            <Grid x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border Background="{DynamicResource SelectedBrush}" />
                <Rectangle Fill="{DynamicResource SelectedSheenBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#EE000000" Offset="0" />
                            <GradientStop Color="#44000000" Offset="0.55" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource SelectedBorderBrush}" Opacity="0.65">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.85" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>
            <!-- Sliding burning left bar + slanted tab -->
            <Grid x:Name="StreakMark" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="StreakShift" X="-6" />
                </Grid.RenderTransform>
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}" />
                <Path Width="5" Height="10" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Fill="{DynamicResource DangerBrush}" Data="M1.5,0 L5,0 3.5,10 0,10 Z" />
            </Grid>

            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="15" Height="15"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" ContentSource="Icon" />
                <Border x:Name="GlyphPanel" Grid.Column="0" Visibility="Collapsed" Width="14" Height="14"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource TooltipBackgroundBrush}">
                    <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"
                                    Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                    Foreground="{DynamicResource TooltipForegroundBrush}" />
                </Border>
                <TextBlock x:Name="HeaderText" Grid.Column="1" VerticalAlignment="Center"
                           Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <ContentControl x:Name="SubArrow" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="14,0,0,0" Focusable="False"
                                Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource SidebarItemForegroundBrush}" />
                <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                       HorizontalOffset="4" VerticalOffset="-7" Focusable="False" AllowsTransparency="True">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalEmberMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="5,7,5,5">
                            <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Icon" />
                <Setter Property="Visibility" Value="Visible" TargetName="OpenPlate" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="SubArrow" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Icon" />
                <Setter Property="Visibility" Value="Visible" TargetName="HoverPlate" />
                <Setter Property="Visibility" Value="Visible" TargetName="StreakMark" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="SubArrow" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="HeaderHoverIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StreakMark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="StreakShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="HeaderHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetName="StreakMark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetName="StreakShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.10" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="RowRoot" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True" ClipToBounds="True">
            <!-- Animated highlight plate: Gears 5 main-menu red streak -->
            <Grid x:Name="HoverPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border x:Name="HoverBase" Background="{DynamicResource SelectedBrush}"
                        BorderBrush="Transparent" BorderThickness="1" />
                <Rectangle x:Name="HoverWash" Fill="{DynamicResource SelectedSheenBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#EE000000" Offset="0" />
                            <GradientStop Color="#44000000" Offset="0.55" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle x:Name="HoverLine" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource SelectedBorderBrush}" Opacity="0.65">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.85" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>
            <!-- Sliding burning left bar + slanted tab -->
            <Grid x:Name="StreakMark" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="StreakShift" X="-6" />
                </Grid.RenderTransform>
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}" />
                <Path x:Name="StreakTab" Width="5" Height="10" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Fill="{DynamicResource DangerBrush}" Data="M1.5,0 L5,0 3.5,10 0,10 Z" />
            </Grid>

            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="15" Height="15"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" ContentSource="Icon" />
                <Border x:Name="GlyphPanel" Grid.Column="0" Visibility="Collapsed" Width="14" Height="14"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource TooltipBackgroundBrush}">
                    <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"
                                    Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                    Foreground="{DynamicResource TooltipForegroundBrush}" />
                </Border>
                <TextBlock x:Name="HeaderText" Grid.Column="1" VerticalAlignment="Center"
                           Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <Border x:Name="GestureCap" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="14,0,0,0" Padding="5,1"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1">
                    <TextBlock x:Name="GestureText" Text="{TemplateBinding InputGestureText}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrushDarker}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GestureCap" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GestureCap" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Icon" />
                <Setter Property="Visibility" Value="Visible" TargetName="HoverPlate" />
                <Setter Property="Visibility" Value="Visible" TargetName="StreakMark" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource TooltipBackgroundBrush}" TargetName="GestureCap" />
                <Setter Property="BorderBrush" Value="{DynamicResource TooltipBackgroundBrush}" TargetName="GestureCap" />
                <Setter Property="Foreground" Value="{DynamicResource TooltipForegroundBrush}" TargetName="GestureText" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="ItemHoverIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="StreakMark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="StreakShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="ItemHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetName="StreakMark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetName="StreakShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.10" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.10" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <!-- Exit danger row -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" TargetName="GestureCap" />
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="GestureText" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Icon" />
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" TargetName="HoverBase" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="HoverBase" />
                <Setter Property="Fill" Value="{DynamicResource GlyphBrush}" TargetName="StreakTab" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource GlyphBrush}" TargetName="GestureCap" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="GestureCap" />
                <Setter Property="Foreground" Value="{DynamicResource TooltipForegroundBrush}" TargetName="GestureText" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="RowRoot" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="200" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="True" />
                <Setter Property="MinWidth" Value="0" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
                <Setter Property="MinWidth" Value="0" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
