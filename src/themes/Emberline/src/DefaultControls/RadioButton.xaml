<!--
    Emberline: RadioButton. The source's level ring, small: an 18px black disc in a hairline ring; on, the ring turns
    white around a white core. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <DockPanel Background="Transparent">
                        <Grid Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Ellipse x:Name="Socket" Fill="{DynamicResource CheckBoxCheckMarkBkBrush}" Stroke="{DynamicResource CheckBoxBorderBrush}" StrokeThickness="1.5" />
                            <Ellipse x:Name="Core" Margin="5" Fill="{DynamicResource TextBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Socket" Property="Stroke" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Core" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Socket" Property="Stroke" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
