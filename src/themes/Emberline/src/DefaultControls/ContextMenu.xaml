<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml.
    Emberline menus: Gears 5 sharp 0px black options panel.
      Panel:     LocalEmberMenuPanelTemplate — 0px black panel (PopupBackgroundBrush) in FramedPlateTemplate
                 (PopupBorderBrush hairline + faded top sheen), capped by the cold-white panel flare rule
                 (GlowLineTemplate) and steel CornerMarksTemplate ticks. Shared by ContextMenu, submenu popups,
                 ComboBox, ComboBoxList and FilterSelectionBox.
      Rows:      30px compact rows (Menu.xaml, ComboBox.xaml).
      Highlight: Gears 5 main-menu red streak — lifted cinder plate (SelectedBrush) with SelectedSheenBrush
                 horizontal ember wash, 3px burning GlyphBrush left bar + slanted DangerBrush tab sliding in
                 from left (120ms PowerEase 4 out); label snaps to white and shifts 2px right.
      Breaks:    10px open break with a miniature 7x6 white slanted title tab (HeadingMarkerBrush) leading a
                 fading 1px hairline (MenuSeparatorBrush).
      Shortcuts: square hairline key boxes at rest; stamp into solid white Gears 5 key caps (TooltipBackgroundBrush,
                 ink TooltipForegroundBrush text) on highlight.
      Exit:      GlyphBrush (#ff2100, 5.16:1) label at rest; dried-blood plate (PrimaryButtonPressedBackgroundBrush)
                 with 1px GlyphBrush perimeter border, 3px GlyphBrush bar, white label and burning GlyphBrush key cap
                 (ink text) on highlight.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared panel chrome for ContextMenu, submenus, ComboBox, ComboBoxList and FilterSelectionBox. -->
    <ControlTemplate x:Key="LocalEmberMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" ClipToBounds="True">
            <!-- Sharp black panel fill -->
            <Border Background="{DynamicResource PopupBackgroundBrush}" />
            <!-- Card hairline frame + top sheen -->
            <Control Template="{DynamicResource FramedPlateTemplate}"
                     Foreground="{DynamicResource PopupBorderBrush}" Focusable="False" />
            <!-- Subtle steel corner ticks -->
            <Control Template="{DynamicResource CornerMarksTemplate}"
                     Foreground="{DynamicResource FrameHoverBrush}" Opacity="0.55" Focusable="False" />
            <!-- Gears 5 panel flare rule along the top edge -->
            <Control Template="{DynamicResource GlowLineTemplate}"
                     Foreground="{DynamicResource TopPanelRuleStartBrush}"
                     BorderBrush="{DynamicResource TopPanelRuleEndBrush}"
                     VerticalAlignment="Top" Margin="1,-7,1,0" Focusable="False" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,7,5,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalEmberMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="{TemplateBinding Padding}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
