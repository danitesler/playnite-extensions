<!--
    Emberline: GroupBox as one of the source's cards: black body inside a single hairline, headed by the white slanted
    tab and the title in the display face over a thin gold rule (the objective bars of the source's tour panel).
    Content-sized, no fixed widths: the rule is a stretching 1px Rectangle with no desired width and the tab is 10px,
    so Statistics sections stay compact cards. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{DynamicResource ExpanderBackgroundBrush}" Padding="1">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" MinHeight="34" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                    <DockPanel Margin="14,8,14,7" LastChildFill="True">
                                        <Path DockPanel.Dock="Left" Width="10" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource HeadingMarkerBrush}"
                                              Data="M3,0 L10,0 7,12 0,12Z" />
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                          TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                          TextElement.Foreground="{DynamicResource HeadingForegroundBrush}">
                                            <ContentPresenter.Resources>
                                                <DataTemplate DataType="{x:Type sys:String}">
                                                    <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                                </DataTemplate>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </DockPanel>
                                    <Rectangle Height="1" Margin="14,0" VerticalAlignment="Bottom" Fill="{DynamicResource MixedRatingBrush}" Opacity="0.6" IsHitTestVisible="False" />
                                </Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                        <Control Template="{DynamicResource FramedPlateTemplate}" Foreground="{DynamicResource FrameBrush}" Focusable="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
