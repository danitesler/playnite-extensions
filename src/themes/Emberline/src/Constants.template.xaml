<!--
    Emberline: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared vocabulary (scripts/data/theme-keys.json); each placeholder names the em token that plays
    the key's role. Token-to-key table: ../AGENTS.md. Theme XAML reads brushes only, never Color keys.
    Shape: every plate is square. Selection is a black plate inside a burning frame, never a filled accent.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: a heavy squared display face for titles (Russo One, bundled), DIN-style body (Bahnschrift, ships with Windows). -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Bahnschrift}}, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Russo One, {{text:font-heading|Russo One}}, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{em-white}}</Color>
    <Color x:Key="TextColorDarker">{{em-label}}</Color>
    <Color x:Key="TextColorDark">{{em-ink}}</Color>
    <Color x:Key="MainColor">{{em-pit}}</Color>
    <Color x:Key="MainColorDark">{{em-panel}}</Color>
    <Color x:Key="HoverColor">{{em-plate-lit}}</Color>
    <Color x:Key="GlyphColor">{{em-ember}}</Color>
    <Color x:Key="HighlightGlyphColor">{{em-lancer}}</Color>
    <Color x:Key="PopupBackgroundColor">{{em-pit}}</Color>
    <Color x:Key="PopupBorderColor">{{em-edge-card}}</Color>
    <Color x:Key="BackgroundToneColor">{{em-panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{em-edge}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{em-edge}}</Color>
    <Color x:Key="DataChangeNotifColor">{{em-alert}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{em-edge-lit}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{em-pit}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{em-pit}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{em-support}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{em-lancer}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{em-gold}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{em-alert}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{em-pit}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{em-panel}}" />

    <!-- Surfaces and art -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{em-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{em-panel}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{em-pit}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{em-panel}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{em-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{em-blood}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the dried-blood
         red of the source's class headers, so a darker banner keeps the menus' red cast instead of plain black. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{em-blood}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{em-ink}}" />

    <!-- Selection and states -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{em-cinder}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{em-ember}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{em-plate}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{em-cinder}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{em-plate-lit}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{em-lancer}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{em-white}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{em-label}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{em-edge-lit}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{em-plate}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{em-plate-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{em-pit}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{em-ember}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{em-cinder}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{em-blood}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{em-ember}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{em-cinder}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{em-pit}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{em-edge-lit}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{em-edge-card}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{em-edge-card}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{em-steel}}" />

    <!-- Tracks and thumbs -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{em-label}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{em-ember}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{em-edge}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{em-ember}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{em-edge-card}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{em-steel}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{em-edge-card}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{em-steel}}" />

    <!-- Tabs, covers, shell items -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{em-label}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{em-ember}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{em-ember}}" />
    <!-- Running game: the frost of the source's boost text, the cold opposite of the red selection. -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{em-frost}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{em-plate-lit}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{em-cinder}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{em-steel}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{em-lancer}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{em-ember}}" />

    <!-- Metadata, menus, tooltips, dialogs -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{em-pit}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{em-label}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{em-plate-lit}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{em-edge}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{em-ink}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{em-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{em-white}}" />

    <!-- Frames and headings -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{em-edge-card}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{em-edge}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{em-steel}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{em-edge}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{em-void}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{em-white}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{em-edge-lit}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{em-edge-card}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{em-void}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{em-pit}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{em-rule}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{em-flare}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{em-edge-lit}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{em-void}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{em-ember-dim}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{em-pit}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{em-edge-lit}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{em-frost}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{em-lancer}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{em-void}}" />
</ResourceDictionary>
