<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Joyride shared pieces, drawn from the GTA III-V box-art collages, the V pause menu and the HUD (RESEARCH.md).
        Plates are flat rectangles with black rims and hard black offsets (a sticker on a collage, no blur, no DropShadowEffect):
          LocalSlabTemplate          plain plate: Background fill, BorderBrush / BorderThickness rim (rows, search, hover plates)
          LocalTagTemplate           plate with a 2px hard offset (chips, toggled view switches, tabs)
          LocalButtonSlabTemplate    plate with a 3px hard offset (buttons)
          LocalStickerPanelTemplate  panel with a 2px black rim and a 6px hard offset (metadata, group boxes, tooltips)
          LocalWellTemplate          rounded 3px input well
          LocalBadgeTemplate         rounded square with a 2px rim (check boxes, slider thumb, cover buttons, the radar close)
          LocalKeyCapTemplate        the V instructional key cap: a filled rounded key, no rim (shortcuts)
        Hosts are plain Controls behind the content.
        Collage scenes (art/sprites.py white masks tinted by theme brushes): Vice sunset, Liberty night, San Andreas desert.
    -->
    <ImageBrush x:Key="LocalHalftoneMask" ImageSource="{ThemeFile 'Images/fx/halftone.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,96,96" Stretch="Fill" />
    <ImageBrush x:Key="LocalSweepMask" ImageSource="{ThemeFile 'Images/fx/sweep.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalSkylineMask" ImageSource="{ThemeFile 'Images/fx/skyline.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalWindowsMask" ImageSource="{ThemeFile 'Images/fx/windows.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalBridgeMask" ImageSource="{ThemeFile 'Images/fx/bridge.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalPalmsMask" ImageSource="{ThemeFile 'Images/fx/palms.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalHillsMask" ImageSource="{ThemeFile 'Images/fx/hills.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalSunMask" ImageSource="{ThemeFile 'Images/fx/sun.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalHeliMask" ImageSource="{ThemeFile 'Images/fx/heli.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalCarMask" ImageSource="{ThemeFile 'Images/fx/car.png'}" Stretch="Fill" />

    <!-- Plain plate. -->
    <ControlTemplate x:Key="LocalSlabTemplate" TargetType="{x:Type Control}">
        <Border IsHitTestVisible="False" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
    </ControlTemplate>
    <!-- Sticker plates: the plate over a hard black offset. -->
    <ControlTemplate x:Key="LocalTagTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False">
            <Border Margin="2,2,-2,-2" Background="{DynamicResource LocalGutterBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalButtonSlabTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False">
            <Border Margin="3,3,-3,-3" Background="{DynamicResource LocalGutterBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalStickerPanelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False">
            <Border Margin="6,6,-6,-6" Background="{DynamicResource LocalGutterBrush}" />
            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LocalGutterBrush}" BorderThickness="2" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalWellTemplate" TargetType="{x:Type Control}">
        <Border IsHitTestVisible="False" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
    </ControlTemplate>
    <ControlTemplate x:Key="LocalBadgeTemplate" TargetType="{x:Type Control}">
        <Border IsHitTestVisible="False" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" />
    </ControlTemplate>
    <ControlTemplate x:Key="LocalKeyCapTemplate" TargetType="{x:Type Control}">
        <Border IsHitTestVisible="False" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
    </ControlTemplate>
    <!-- The wanted star: Foreground fill, a black outline like the HUD stars. -->
    <ControlTemplate x:Key="LocalStarCheckTemplate" TargetType="{x:Type Control}">
        <Viewbox IsHitTestVisible="False" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource LocalStarGeometry}" Fill="{TemplateBinding Foreground}" Stroke="{DynamicResource LocalGutterBrush}" StrokeThickness="1.6" StrokeLineJoin="Miter" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <!-- The tri-color tick: Michael blue, Franklin green, Trevor orange. Sized by the host (one third each). -->
    <ControlTemplate x:Key="LocalTriTickTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="{DynamicResource LocalMichaelBrush}" />
            <Rectangle Grid.Column="1" Fill="{DynamicResource LocalFranklinBrush}" />
            <Rectangle Grid.Column="2" Fill="{DynamicResource LocalTrevorBrush}" />
        </Grid>
    </ControlTemplate>
    <!-- Group break (metadata, details groups): a 4px black gutter with the tri-color tick 16px in. 4px tall. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" Height="4">
            <Rectangle Fill="{DynamicResource LocalGutterBrush}" />
            <Control Template="{DynamicResource LocalTriTickTemplate}" Width="30" HorizontalAlignment="Left" Margin="16,0,0,0" Focusable="False" IsTabStop="False" />
        </Grid>
    </ControlTemplate>

    <!-- Collage scenes: each a 240x120 painting in a Viewbox that fills its panel (UniformToFill; the host clips). -->
    <ControlTemplate x:Key="LocalSceneViceTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
            <Canvas Width="240" Height="120">
                <Rectangle Width="240" Height="120" Fill="{DynamicResource LocalViceDuskBrush}" />
                <Rectangle Width="240" Height="120" Fill="{DynamicResource LocalViceMagentaBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#00000000" /><GradientStop Offset="0.5" Color="#FF000000" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Width="240" Height="120" Fill="{DynamicResource LocalTrevorBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.45" Color="#00000000" /><GradientStop Offset="0.78" Color="#FF000000" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Canvas.Left="46" Canvas.Top="30" Width="86" Height="86" Fill="{DynamicResource LocalMissionLitBrush}" OpacityMask="{DynamicResource LocalSunMask}" />
                <Rectangle Canvas.Top="94" Width="240" Height="26" Fill="{DynamicResource LocalFreemodeDeepBrush}" />
                <Rectangle Canvas.Left="64" Canvas.Top="96" Width="50" Height="2" Fill="{DynamicResource LocalMissionLitBrush}" Opacity="0.6" />
                <Rectangle Canvas.Left="74" Canvas.Top="101" Width="30" Height="2" Fill="{DynamicResource LocalMissionLitBrush}" Opacity="0.4" />
                <Rectangle Canvas.Left="104" Canvas.Top="18" Width="152" Height="100" Fill="{DynamicResource LocalGutterBrush}" OpacityMask="{DynamicResource LocalPalmsMask}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalSceneLibertyTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
            <Canvas Width="240" Height="120">
                <Rectangle Width="240" Height="120" Fill="{DynamicResource LocalAsphaltDeepBrush}" />
                <Rectangle Width="240" Height="120" Fill="{DynamicResource LocalLibertyBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.2" Color="#00000000" /><GradientStop Offset="0.9" Color="#C0000000" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Canvas.Top="30" Width="240" Height="64" Fill="{DynamicResource LocalLibertyDeepBrush}" OpacityMask="{DynamicResource LocalBridgeMask}" />
                <Rectangle Canvas.Top="54" Width="240" Height="66" Fill="{DynamicResource LocalGutterBrush}" OpacityMask="{DynamicResource LocalSkylineMask}" />
                <Rectangle Canvas.Top="54" Width="240" Height="66" Fill="{DynamicResource LocalMissionBrush}" Opacity="0.85" OpacityMask="{DynamicResource LocalWindowsMask}" />
                <Rectangle Canvas.Left="150" Canvas.Top="8" Width="52" Height="26" Fill="{DynamicResource LocalGutterBrush}" OpacityMask="{DynamicResource LocalHeliMask}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalSceneDesertTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
            <Canvas Width="240" Height="120">
                <Rectangle Width="240" Height="120" Fill="{DynamicResource LocalSaCreamBrush}" />
                <Rectangle Width="240" Height="120" Fill="{DynamicResource LocalSaRustBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.25" Color="#00000000" /><GradientStop Offset="1" Color="#FF000000" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Canvas.Left="150" Canvas.Top="14" Width="44" Height="44" Fill="{DynamicResource LocalMissionLitBrush}" Opacity="0.9" OpacityMask="{DynamicResource LocalSunMask}" />
                <Rectangle Canvas.Top="58" Width="240" Height="62" Fill="{DynamicResource LocalWastedDeepBrush}" OpacityMask="{DynamicResource LocalHillsMask}" />
                <Rectangle Canvas.Left="24" Canvas.Top="86" Width="100" Height="31" Fill="{DynamicResource LocalGutterBrush}" OpacityMask="{DynamicResource LocalCarMask}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <!-- Three-panel collage strip (the settings band, the menu crown): Vice | Liberty | desert, split by 3px gutters. Each scene keeps its
         2:1 shape and sits on the strip's foot, so a thin strip shows the silhouettes (palms, skyline, hills), not empty sky. -->
    <ControlTemplate x:Key="LocalCollageStripTemplate" TargetType="{x:Type Control}">
        <!-- The scenes fill their panels (UniformToFill), so the strip sits in a Canvas and never asks for width: it takes the
             size its host gives it (a menu, a 300px band) instead of growing to the screen. -->
        <Grid x:Name="StripHost" IsHitTestVisible="False" ClipToBounds="True">
            <Canvas>
                <Grid Width="{Binding ActualWidth, ElementName=StripHost}" Height="{Binding ActualHeight, ElementName=StripHost}" Background="{DynamicResource LocalGutterBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" ClipToBounds="True"><Control Template="{DynamicResource LocalSceneViceTemplate}" Focusable="False" IsTabStop="False" VerticalAlignment="Bottom" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x / 2'}" /></Border>
                    <Border Grid.Column="2" ClipToBounds="True"><Control Template="{DynamicResource LocalSceneLibertyTemplate}" Focusable="False" IsTabStop="False" VerticalAlignment="Bottom" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x / 2'}" /></Border>
                    <Border Grid.Column="4" ClipToBounds="True"><Control Template="{DynamicResource LocalSceneDesertTemplate}" Focusable="False" IsTabStop="False" VerticalAlignment="Bottom" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x / 2'}" /></Border>
                </Grid>
            </Canvas>
        </Grid>
    </ControlTemplate>
    <!-- The brand mark: a collage tile cut into three panels, a wanted star punched into the tall one. Foreground fill. -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox IsHitTestVisible="False" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource LocalMarkGeometry}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <!-- Empty game page: a loading-screen collage. Three scenes in a black-gutter grid, panning slowly while visible, the mark
         in a black title box over the gutter crossing. 360x230. -->
    <ControlTemplate x:Key="LocalEmptyCollageTemplate" TargetType="{x:Type Control}">
        <Grid x:Name="Root" IsHitTestVisible="False" Width="372" Height="242">
            <Border Margin="8,8,-8,-8" Background="{DynamicResource LocalGutterBrush}" Opacity="0.6" />
            <Grid Background="{DynamicResource LocalGutterBrush}">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="3" ClipToBounds="True">
                        <Control Template="{DynamicResource LocalSceneViceTemplate}" Margin="-24,0,-24,0" Focusable="False" IsTabStop="False">
                            <Control.RenderTransform><TranslateTransform x:Name="PanA" /></Control.RenderTransform>
                        </Control>
                    </Border>
                    <Border Grid.Column="2" ClipToBounds="True">
                        <Control Template="{DynamicResource LocalSceneLibertyTemplate}" Margin="-20,0,-20,0" Focusable="False" IsTabStop="False">
                            <Control.RenderTransform><TranslateTransform x:Name="PanB" /></Control.RenderTransform>
                        </Control>
                    </Border>
                    <Border Grid.Column="2" Grid.Row="2" ClipToBounds="True">
                        <Control Template="{DynamicResource LocalSceneDesertTemplate}" Margin="-20,0,-20,0" Focusable="False" IsTabStop="False">
                            <Control.RenderTransform><TranslateTransform x:Name="PanC" /></Control.RenderTransform>
                        </Control>
                    </Border>
                </Grid>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,0" Width="64" Height="64" Background="{DynamicResource LocalGutterBrush}">
                    <Control Template="{DynamicResource BrandMarkTemplate}" Width="40" Height="40" Foreground="{DynamicResource LocalMissionBrush}" Focusable="False" IsTabStop="False" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="CollagePan">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="PanA" Storyboard.TargetProperty="X" From="-20" To="20" Duration="0:0:9">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PanB" Storyboard.TargetProperty="X" From="16" To="-16" Duration="0:0:7">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PanC" Storyboard.TargetProperty="X" From="-16" To="16" Duration="0:0:8">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="CollagePan" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>
    <!-- Keyboard focus: a 2px mission-yellow frame 3px outside the control (the GTA V cursor box). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" IsHitTestVisible="False" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Component spacing: the V pause menu's 30px rows, 32px fields, 2px rims eat one pixel of vertical padding. -->
    <Thickness x:Key="ButtonPadding">18,4,18,4</Thickness> <!-- Button: 2px black rim + 3px hard offset -->
    <Thickness x:Key="InputPadding">10,5,10,5</Thickness> <!-- Text box, password box; 32px with ControlHeight -->
    <Thickness x:Key="MenuPadding">0,0,0,6</Thickness> <!-- Menu rows under the 12px collage crown -->
    <Thickness x:Key="MenuItemPadding">10,5,8,5</Thickness> <!-- Menu item: 30px row -->
    <Thickness x:Key="ComboBoxDropDownPadding">0,0,0,6</Thickness> <!-- Dropdown board under its crown -->
    <Thickness x:Key="ComboBoxItemPadding">14,5,10,5</Thickness> <!-- Dropdown row: room for the mission tab -->
    <Thickness x:Key="ListBoxItemPadding">12,5,10,5</Thickness> <!-- List box item -->
    <Thickness x:Key="GroupBoxPadding">14,10,14,12</Thickness> <!-- Sticker panel body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness> <!-- Gap under the panel's black tab label -->
    <Thickness x:Key="TooltipPadding">10,6,10,7</Thickness> <!-- Tooltip panel -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double> <!-- Top bar and sidebar icons -->
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         collage gutters and the title scrim. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Both views start on the right. Center and Stretch flow above media. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->
    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, cut by black gutters like the collage, so the real carousel replaces it without the page jumping.
         Each Viewbox scales a fixed 1600px layout to the width its column gives it. The tiles are the host's Foreground at
         low opacity; the whole thing pulses while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,6,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- More / Edit: the V instructional key as a square: charcoal plate, 2px black rim, 3px hard offset; on hover it turns into
         the white key with a black glyph and lifts off its shadow; pressed it lands on it. -->
    <Style x:Key="LocalGameActionSocket" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border Margin="3,3,-3,-3" Background="{DynamicResource LocalGutterBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <Grid x:Name="Face" IsHitTestVisible="False">
                            <Grid.RenderTransform><TranslateTransform x:Name="FaceShift" /></Grid.RenderTransform>
                            <Border x:Name="Plate" Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource LocalGutterBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border x:Name="HoverPlate" Opacity="0" Background="{DynamicResource LocalWhiteBrush}" BorderBrush="{DynamicResource LocalGutterBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LocalInkBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ActionHoverIn"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                                    <DoubleAnimation Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="X" To="-1" Duration="0:0:0.09" />
                                    <DoubleAnimation Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.09" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ActionHoverOut"><Storyboard>
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="3,3,-3,-3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): three tilted paper slips, each on a hard ink offset shadow, cut-and-paste collage rows. Hover: the slips slap down onto their shadows one after another (short, hard-eased). Open (ContextMenu.IsOpen of the nearest Border): a mission-yellow tag with a wanted star drops over the dimmed slips with an overshoot, and a red and a blue light on its top edge flash in alternation until the menu closes. -->
    <ControlTemplate x:Key="LocalJoyrideMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Grid x:Name="Slips">
                    <Canvas Width="26" Height="26" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><RotateTransform Angle="-3" /></Canvas.RenderTransform>
                        <Rectangle Canvas.Left="5.6" Canvas.Top="5.6" Width="18" Height="4.4" Fill="{DynamicResource LocalInkBrush}">
                            <Rectangle.RenderTransform><TranslateTransform x:Name="ShadowA" X="0" Y="0" /></Rectangle.RenderTransform>
                        </Rectangle>
