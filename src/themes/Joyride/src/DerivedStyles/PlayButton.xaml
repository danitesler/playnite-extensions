<!--
    Joyride: Play, the mission slab. Structure: Playnite Default 10.60 (PlayButton); every Default state is kept.
    Brushes: Background (the slab, PrimaryButtonBackgroundBrush = mission yellow), BorderBrush (the triangle and tyre hub in the key cap),
    Foreground (the label, black ink), LocalGutterBrush (rim, key cap, hard offset), CheckMarkBrush (the star),
    LocalPureBrush (the press flash, pistol, tyre, siren base), LocalGoldBrush (the pressed slab), RunningIndicatorBrush (siren blue),
    LocalWastedBrush (siren red, the glow), ScrimBrush.
    Rest: a mission-yellow slab with a 2px black rim on a 4px hard black offset (a sticker on the box art); a black instructional
    key cap holds the play triangle; PLAY in Impact.
    Hover (hero, both ways): the slab lifts 2px up-left off its shadow and the key cap cycles its glyph while the pointer stays:
    play triangle -> wanted star -> pistol -> police siren (blue and red flicker) -> triangle, 3.6s loop, each glyph pops in with
    a spin (BackEase) and shrinks out. Behind the slab a police car's roof lamps blip (a siren-blue lamp at the left end, a red one at the right end, each
    double-flashing in turn, 1.2s loop), fading in on hover and out on leave. The hit area never moves.
    Press, its own layers: the slab slams onto its shadow (90ms), darkens to gold, and a white flash band sweeps across it
    (the MISSION PASSED bar); release recovers in 0.18s.
    Running and launching: the slab fills with RunningIndicatorBrush (police siren blue) with black ink; the corona, flash and hover
    layers drop out. The key cap shows a tyre instead of the triangle: launching spins it fast (0.4s a turn), running slow (2.6s).
    Launching: a dark band sweeps the slab and a blue then red light bar sweeps behind it, left to right (1.2s). Running: a light scrim breathes over it. The RUNNING label shows
    Cancel only while the button itself is hovered (RelativeSource Self), and the hover layers stay off while it runs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite
        swaps Play for the context action (RUNNING). The overlay is a police light bar: a siren-blue frame on the slab's own
        rounded rectangle, a faint blue wash, two siren lamps (blue left, red right) at the slab's ends that strobe in turn,
        and a light-bar foot of blue blocks passing along the bottom edge. Launching: the lamps strobe fast (0.25s) and the
        blocks run (0.4s per step). Running: the lamps alternate slowly (2.4s) while the frame breathes 0.72 to 1. The lamps
        and the foot stay clear of the label, which sits in the middle. DataContext is Playnite's GameDetailsViewModel.
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.18" />
                        <Border x:Name="RunningFrame" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="2" BorderBrush="{DynamicResource RunningIndicatorBrush}" />
                        <Border x:Name="RunningLampLeft" Width="8" Height="12" Margin="-3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource RunningIndicatorBrush}" BorderBrush="{DynamicResource LocalGutterBrush}" BorderThickness="1.5" CornerRadius="2" />
                        <Border x:Name="RunningLampRight" Width="8" Height="12" Margin="0,0,-3,0" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.35"
                                Background="{DynamicResource LocalWastedBrush}" BorderBrush="{DynamicResource LocalGutterBrush}" BorderThickness="1.5" CornerRadius="2" />
                        <Grid Height="4" Margin="14,0,14,3" VerticalAlignment="Bottom" ClipToBounds="True">
                            <Border Background="{DynamicResource ScrimBrush}" Opacity="0.7" />
                            <Canvas>
                                <Rectangle x:Name="MarchFoot" Canvas.Left="-16" Width="600" Height="4">
                                    <Rectangle.Fill>
                                        <DrawingBrush TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,16,4" ViewboxUnits="Absolute" Viewbox="0,0,16,4">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="{DynamicResource RunningIndicatorBrush}" Geometry="M0,0 L9,0 L9,4 L0,4 Z" />
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="MarchFootShift" X="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="MarchFootShift" Storyboard.TargetProperty="X" From="0" To="16" Duration="0:0:0.4" />
                                        <DoubleAnimation Storyboard.TargetName="RunningLampLeft" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.25" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="RunningLampRight" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.25" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MarchFootShift" Storyboard.TargetProperty="X" From="0" To="16" Duration="0:0:2.4" />
                                        <DoubleAnimation Storyboard.TargetName="RunningLampLeft" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.2" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="RunningLampRight" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:1.2" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="48,0,22,1" />
        <Setter Property="FontFamily" Value="{DynamicResource LocalPosterFontFamily}" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Launching: a police light bar behind the slab, a blurred siren-blue band and then a red one sweeping across it from left to right. -->
                        <Grid x:Name="SweepHost" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                            <Grid x:Name="SweepBlue" Margin="-26,-20,-26,-20" Opacity="0.9" IsHitTestVisible="False">
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="SweepBlueA" Color="#00000000" Offset="-0.75" />
                                        <GradientStop x:Name="SweepBlueB" Color="#FF000000" Offset="-0.45" />
                                        <GradientStop x:Name="SweepBlueC" Color="#00000000" Offset="-0.15" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <Border Margin="22,17,22,17" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Border.Effect><BlurEffect Radius="16" KernelType="Gaussian" /></Border.Effect>
                                </Border>
                            </Grid>
                            <Grid x:Name="SweepRed" Margin="-26,-20,-26,-20" Opacity="0.9" IsHitTestVisible="False">
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="SweepRedA" Color="#00000000" Offset="-0.75" />
                                        <GradientStop x:Name="SweepRedB" Color="#FF000000" Offset="-0.45" />
                                        <GradientStop x:Name="SweepRedC" Color="#00000000" Offset="-0.15" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <Border Margin="22,17,22,17" Background="{DynamicResource LocalWastedBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Border.Effect><BlurEffect Radius="16" KernelType="Gaussian" /></Border.Effect>
                                </Border>
                            </Grid>
                        </Grid>
                        <!-- Police car roof lamps behind the hovered slab: a siren-blue lamp blips at the left end, a red one at the right end, taking turns. Only while hovered. -->
                        <Grid x:Name="BlipHost" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                            <Grid Margin="-4,-3,-4,-3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.42*" />
                                    <ColumnDefinition Width="0.16*" />
                                    <ColumnDefinition Width="0.42*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BlipBlue" Grid.Column="0" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0">
                                    <Border.Effect><BlurEffect Radius="16" KernelType="Gaussian" /></Border.Effect>
                                </Border>
                                <Border x:Name="BlipRed" Grid.Column="2" Background="{DynamicResource LocalWastedBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0">
                                    <Border.Effect><BlurEffect Radius="16" KernelType="Gaussian" /></Border.Effect>
                                </Border>
                            </Grid>
                        </Grid>
                        <!-- The hard black offset the slab stands on. -->
                        <Border x:Name="Shadow" Margin="4,4,-4,-4" Background="{DynamicResource LocalGutterBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <Grid x:Name="Face">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="FaceShift" X="0" Y="0" />
                            </Grid.RenderTransform>
                            <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <Border Margin="2" CornerRadius="1" ClipToBounds="True" IsHitTestVisible="False">
                                <Rectangle x:Name="RunningScan" Visibility="Collapsed" Fill="{DynamicResource ShellBackgroundBrush}" Opacity="0.25">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Border>
                            <Border x:Name="RunningHoverDim" Background="{DynamicResource ScrimBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressedPlate" Background="{DynamicResource LocalGoldBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <!-- The MISSION PASSED flash: a white band crossing the slab on press. -->
                            <Border Margin="2" ClipToBounds="True" IsHitTestVisible="False">
                                <Rectangle x:Name="PressFlash" Width="70" HorizontalAlignment="Left" Fill="{DynamicResource LocalPureBrush}" OpacityMask="{DynamicResource LocalSweepMask}" Opacity="0">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="FlashShift" X="-70" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>
                            <Border x:Name="Rim" BorderBrush="{DynamicResource LocalGutterBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                            <!-- The instructional key cap holding the play triangle. -->
                            <Border x:Name="Gem" Width="28" Height="28" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                    Background="{DynamicResource LocalGutterBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Grid>
                                    <Path x:Name="PlayGlyph" Data="M0,0 L10,6 L0,12 Z" Width="10" Height="12" Margin="2,0,0,0" Fill="{TemplateBinding BorderBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="PlayScale" ScaleX="1" ScaleY="1" />
                                                <RotateTransform x:Name="PlaySpin" Angle="0" />
                                            </TransformGroup>
                                        </Path.RenderTransform>
                                    </Path>
                                    <!-- Hover glyphs: scale 0 at rest, cycled by PlayGlyphLoop. -->
                                    <Grid x:Name="StarLayer" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="StarScale" ScaleX="0" ScaleY="0" />
                                                <RotateTransform x:Name="StarSpin" Angle="0" />
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <Path Data="M8,0.6 L9.95,5.7 L15.4,6 L11.15,9.4 L12.55,14.7 L8,11.75 L3.45,14.7 L4.85,9.4 L0.6,6 L6.05,5.7 Z" Fill="{DynamicResource CheckMarkBrush}" />
                                    </Grid>
                                    <Grid x:Name="PistolLayer" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="PistolScale" ScaleX="0" ScaleY="0" />
                                                <RotateTransform x:Name="PistolSpin" Angle="0" />
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <Path Data="M0.5,3 L15.5,3 L15.5,7 L11.8,7 L13.2,14 L9.3,14 L7.6,9.6 L5.4,9.6 L4.6,7 L0.5,7 Z" Fill="{DynamicResource LocalPureBrush}" />
                                    </Grid>
                                    <Grid x:Name="SirenLayer" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="SirenScale" ScaleX="0" ScaleY="0" />
                                                <RotateTransform x:Name="SirenSpin" Angle="0" />
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <Path Data="M3,12.8 L13,12.8 L13,14.6 L3,14.6 Z" Fill="{DynamicResource LocalPureBrush}" />
                                        <Path Data="M4,12.2 L4,8.6 A4,4.6 0 0 1 12,8.6 L12,12.2 Z" Fill="{DynamicResource RunningIndicatorBrush}" />
                                        <Path x:Name="SirenRed" Data="M4,12.2 L4,8.6 A4,4.6 0 0 1 12,8.6 L12,12.2 Z" Fill="{DynamicResource LocalWastedBrush}" Opacity="0" />
                                        <Path Data="M8,0.8 L8,2.6 M2,2.8 L3.3,4.2 M14,2.8 L12.7,4.2" Stroke="{DynamicResource LocalPureBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Grid>
                                    <!-- Running and launching: the tyre. Spun by PlayFillLaunching (fast) and PlayFillRunning (slow). -->
                                    <Grid x:Name="Tyre" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="TyreSpin" Angle="0" />
                                        </Grid.RenderTransform>
                                        <Ellipse Width="20" Height="20" Stroke="{DynamicResource LocalPureBrush}" StrokeThickness="3.5" StrokeDashArray="1 0.85" />
                                        <Ellipse Width="11" Height="11" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.6" />
                                        <Path Data="M10,10 L10,5.6 M10,10 L14.2,8.6 M10,10 L11.6,14.3 M10,10 L8.4,14.3 M10,10 L5.8,8.6" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Ellipse Width="3.4" Height="3.4" Fill="{TemplateBinding BorderBrush}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <StackPanel x:Name="LabelRow" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="PlayContent" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </StackPanel>
                            </Viewbox>
                            <ContentPresenter x:Name="CancelLabel" Content="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="48,0,0,1" TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type sys:String}">
                                        <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="Gem" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Padding" Value="22,0,22,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,0,1" />
                            <Setter TargetName="CancelLabel" Property="HorizontalAlignment" Value="Center" />
                        </Trigger>
                        <!-- Hover and press: only while the game is not launching or running. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="X" To="-2" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="PlayGlyphLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:3.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.7" Value="0" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:2.9" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.7" Value="0" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:2.9" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlaySpin" Storyboard.TargetProperty="Angle" Duration="0:0:3.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="90" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.7" Value="-120" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:2.9" Value="0"><EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StarScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:3.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StarScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="0" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StarSpin" Storyboard.TargetProperty="Angle" Duration="0:0:3.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-120" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="-120" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0"><EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="90" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="90" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PistolScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:3.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="0" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:1.15" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
