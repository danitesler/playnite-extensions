                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.55" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
