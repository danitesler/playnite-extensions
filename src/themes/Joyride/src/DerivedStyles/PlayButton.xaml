                                </BeginStoryboard>
                                <BeginStoryboard Name="PlayBlipFadeIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BlipHost" Storyboard.TargetProperty="Visibility">
