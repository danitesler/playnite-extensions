                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressFlash" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Tyre" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SweepHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SweepHost" Property="Opacity" Value="1" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.1" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayLaunchSweep">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepBlueA" Storyboard.TargetProperty="Offset" Duration="0:0:1.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.75" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="1.15" KeySpline="0.35,0 0.65,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepBlueB" Storyboard.TargetProperty="Offset" Duration="0:0:1.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="1.45" KeySpline="0.35,0 0.65,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepBlueC" Storyboard.TargetProperty="Offset" Duration="0:0:1.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.55" Value="1.75" KeySpline="0.35,0 0.65,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.75" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepRedA" Storyboard.TargetProperty="Offset" Duration="0:0:1.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.75" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="-0.75" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.15" KeySpline="0.35,0 0.65,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepRedB" Storyboard.TargetProperty="Offset" Duration="0:0:1.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.35,0 0.65,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.45" />
