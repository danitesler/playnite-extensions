                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
