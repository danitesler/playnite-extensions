<!--
    Joyride: StandardWindowStyle. Every dialog and the Settings window: a 44px collage-gutter black title band. A three-panel box-art
    strip (Vice sunset | Liberty night | desert, split by black gutters) sits at its right end before the caption buttons and fades
    out to the left; the brand mark in mission yellow and the title in white Impact with a black outline ride over it on the left;
    the V tri-color tick marks the band's foot. Caption buttons: WindowBarButton / MainWindowButton. CaptionHeight is 44.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource NormalBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource HeaderBandBrush}" ClipToBounds="True">
                                    <!-- The title band: the box-art strip at the right end, fading out to the left; the tri-color tick at its foot. -->
                                    <Control Template="{DynamicResource LocalCollageStripTemplate}" Width="300" Margin="0,4,142,4" HorizontalAlignment="Right"
                                             Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                        <Control.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#00000000" />
                                                <GradientStop Offset="0.3" Color="#FF000000" />
                                            </LinearGradientBrush>
                                        </Control.OpacityMask>
                                    </Control>
                                    <Control Template="{DynamicResource LocalTriTickTemplate}" Width="66" Height="3" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="14,0,22,2" VerticalAlignment="Center">
                                            <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource GlyphBrush}" Width="26" Height="26" Margin="0,0,12,0"
                                                     VerticalAlignment="Center" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="22" Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="3" Y="3" /></TextBlock.RenderTransform></TextBlock>
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="22" Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="-1.5" Y="0" /></TextBlock.RenderTransform></TextBlock>
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="22" Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="1.5" Y="0" /></TextBlock.RenderTransform></TextBlock>
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="22" Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="0" Y="-1.5" /></TextBlock.RenderTransform></TextBlock>
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="22" Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="0" Y="1.5" /></TextBlock.RenderTransform></TextBlock>
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="22" Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="-1.5" Y="-1.5" /></TextBlock.RenderTransform></TextBlock>
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="22" Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="1.5" Y="-1.5" /></TextBlock.RenderTransform></TextBlock>
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="22" Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="-1.5" Y="1.5" /></TextBlock.RenderTransform></TextBlock>
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="22" Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="1.5" Y="1.5" /></TextBlock.RenderTransform></TextBlock>
                                                <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="22"
                                                           Foreground="{DynamicResource HeadingForegroundBrush}" TextTrimming="CharacterEllipsis"
                                                           x:Name="PART_TextTitle" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,0">
                                            <Button Style="{DynamicResource MainWindowButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource MainWindowButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource MainWindowButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
