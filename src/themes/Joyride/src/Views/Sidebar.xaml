<!--
    Joyride: left rail, 44px of collage gutter black (HeaderBandBrush) that runs into the top bar's black foot. Three box-art panels
    (Vice sunset, Liberty night, desert) stack up from its foot between black gutters and fade out upward (sparse decor, hidden while
    the sidebar sits at the top or bottom and while window art is on). The main menu is the brand mark in mission yellow; on hover a
    mission-yellow tag on a hard offset fades in under it and the mark turns black. The current item is the white plate with a
    mission foot (SidebarItem.xaml). Colors: HeaderBandBrush, MainMenuButtonForegroundBrush, GlyphBrush, LocalGutterBrush.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource HeaderBandBrush}" Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <!-- Box-art panels stacked at the rail's foot, fading out upward. -->
                            <!-- Fixed width: the scenes fill their panel (UniformToFill), so an unconstrained width would make the rail as wide as the window. -->
                            <Grid x:Name="RailLattice" Width="36" Height="196" Margin="0,0,0,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.6" IsHitTestVisible="False" ClipToBounds="True">
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="0.75" Color="#FF000000" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" ClipToBounds="True"><Control Template="{DynamicResource LocalSceneDesertTemplate}" Focusable="False" IsTabStop="False" /></Border>
                                <Border Grid.Row="2" ClipToBounds="True"><Control Template="{DynamicResource LocalSceneLibertyTemplate}" Focusable="False" IsTabStop="False" /></Border>
                                <Border Grid.Row="4" ClipToBounds="True"><Control Template="{DynamicResource LocalSceneViceTemplate}" Focusable="False" IsTabStop="False" /></Border>
                            </Grid>
                            <Rectangle x:Name="EdgeLine" Width="1" HorizontalAlignment="Right" Fill="{DynamicResource LocalGutterBrush}" IsHitTestVisible="False" />
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="52" Margin="0,0,0,0"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid x:Name="MenuSocketHost" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Control Template="{DynamicResource LocalJoyrideMenuMarkTemplate}" Focusable="False" IsTabStop="False" Foreground="{DynamicResource MainMenuButtonForegroundBrush}" />
            </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailLattice" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailLattice" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="1" TargetName="EdgeLine" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailLattice" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="1" TargetName="EdgeLine" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="EdgeLine" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
