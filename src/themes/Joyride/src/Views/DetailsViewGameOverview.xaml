<!--
    Joyride: game page, details view. Generated by art/gen-overviews.mjs; edit the generator, not this file.
    The banner is the game's art cut into a box-art collage by black gutters and ending on a hard black foot; the title is white
    Impact in a black outline straddling that foot; Play is the mission slab, More and Edit are instructional key caps; the
    metadata is one sticker panel with gutter breaks, money-counter scores with wanted-star meters and sticker chips.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="DetailsViewGameOverview">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DetailsViewGameOverview">
                    <ScrollViewer x:Name="PART_ScrollViewHost" Visibility="Visible" Style="{DynamicResource DetailsScrollViewer}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                        <Grid x:Name="PageRoot" UseLayoutRounding="True">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False" ClipToBounds="True">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                            <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                                <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                    <Setter Property="Height" Value="0" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource LocalGutterBrush}">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.38" />
                                            <GradientStop Color="#BB000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Grid Height="130" VerticalAlignment="Bottom">
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF000000" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="0.62" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <Rectangle Fill="{DynamicResource LocalGutterBrush}" Opacity="0.4" OpacityMask="{DynamicResource LocalHalftoneMask}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="38*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Column="1" Grid.RowSpan="3" Fill="{DynamicResource LocalGutterBrush}" />
                                    <Rectangle Grid.Column="2" Grid.Row="1" Fill="{DynamicResource LocalGutterBrush}" />
                                </Grid>
                                <Rectangle Height="8" VerticalAlignment="Bottom" Fill="{DynamicResource LocalGutterBrush}" />
                            </Grid>
                            <StackPanel Margin="28,0,28,28">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border x:Name="DetailsBannerSpacer" MinHeight="28" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 236 / 300'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="28" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
                                                    <Setter Property="Height" Value="28" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="16,0,6,0" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Grid MinWidth="164" Height="44">
                                            <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                            <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                            <Control Style="{DynamicResource RunningActionIndicator}" />
                                        </Grid>
                                        <Button x:Name="PART_ButtonMoreActions" Style="{DynamicResource LocalGameActionSocket}" Width="40" Height="40" Padding="0" Margin="14,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                            <ContentControl Focusable="False" Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                        <Button x:Name="PART_ButtonEditGame" Style="{DynamicResource LocalGameActionSocket}" Width="40" Height="40" Padding="0" Margin="14,0,0,0" ToolTip="{DynamicResource LOCEditGame}">
                                            <ContentControl Focusable="False" Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0" Background="{DynamicResource LocalGutterBrush}" Padding="3"
                                            Visibility="{Binding Visibility, ElementName=PART_ImageIcon}">
                                        <Border BorderBrush="{DynamicResource LocalWhiteBrush}" BorderThickness="1">
                                            <Image x:Name="PART_ImageIcon" MaxWidth="52" MaxHeight="52" />
                                        </Border>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="5" Y="5" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="-2" Y="0" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="2" Y="0" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="0" Y="-2" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="0" Y="2" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="-2" Y="-2" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="2" Y="-2" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="-2" Y="2" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextOutlineBrush}" IsHitTestVisible="False"><TextBlock.RenderTransform><TranslateTransform X="2" Y="2" /></TextBlock.RenderTransform></TextBlock>
                                            <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="{DynamicResource FontSizeLargest}"
                                                       Foreground="{DynamicResource HeadingForegroundBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid Width="190" Height="4" Margin="0,8,0,0" HorizontalAlignment="Left">
                                            <Rectangle Fill="{DynamicResource LocalGutterBrush}" />
                                            <Control Template="{DynamicResource LocalTriTickTemplate}" Width="30" HorizontalAlignment="Left" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                        </Grid>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Margin="0,30,0,0" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stretch" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
<Grid VerticalAlignment="Top" Margin="0,0,6,6" HorizontalAlignment="Stretch">
                                        <Control Template="{DynamicResource LocalStickerPanelTemplate}" Background="{DynamicResource LocalPanelBrush}"
                                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                        <Border Padding="16,16,16,16">
                                            <StackPanel Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch" x:Name="DetailsMetadataContent">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                <Grid ClipToBounds="True" x:Name="DetailsMetadataViewport">
                                                    <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-24,0,-4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-24,-24,-4" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Margin" Value="0,-4,0,-4" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-4,-24,-4" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Margin" Value="0,-4,0,-4" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0,-4,-24,-4" /></MultiDataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                        <Border x:Name="MetaProgress" Padding="0"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,8,0,0" /><Style.Triggers><MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Control Template="{DynamicResource DividerTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,0,0,8" />
</Border>
<Border x:Name="PART_ElemCompletionStatus" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <ContentControl Content="{DynamicResource LOCCompletionStatus}" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                                                                        Foreground="{DynamicResource TextBrushDarker}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="12">
                                                                            <ContentControl.ContentTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" TextWrapping="Wrap" />
                                                                                </DataTemplate>
                                                                            </ContentControl.ContentTemplate>
                                                                        </ContentControl>
                                                                        <Button Grid.Column="2" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PropertyItemButton}" />
                                                                    </Grid>
                                                                </Border>
<Border x:Name="PART_ElemPlayTime" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <ContentControl Content="{DynamicResource LOCTimePlayed}" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                                                                        Foreground="{DynamicResource TextBrushDarker}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="12">
                                                                            <ContentControl.ContentTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" TextWrapping="Wrap" />
                                                                                </DataTemplate>
                                                                            </ContentControl.ContentTemplate>
                                                                        </ContentControl>
                                                                        <TextBlock Grid.Column="2" x:Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                    </Grid>
                                                                </Border>
<Border x:Name="PART_ElemLastPlayed" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <ContentControl Content="{DynamicResource LOCLastPlayed}" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                                                                        Foreground="{DynamicResource TextBrushDarker}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="12">
                                                                            <ContentControl.ContentTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" TextWrapping="Wrap" />
                                                                                </DataTemplate>
                                                                            </ContentControl.ContentTemplate>
                                                                        </ContentControl>
                                                                        <TextBlock Grid.Column="2" x:Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                    </Grid>
                                                                </Border>
<Border x:Name="PART_ElemRecentActivity" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <ContentControl Content="{DynamicResource LOCRecentActivityLabel}" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                                                                        Foreground="{DynamicResource TextBrushDarker}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="12">
                                                                            <ContentControl.ContentTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" TextWrapping="Wrap" />
                                                                                </DataTemplate>
                                                                            </ContentControl.ContentTemplate>
                                                                        </ContentControl>
                                                                        <TextBlock Grid.Column="2" x:Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                    </Grid>
                                                                </Border>
<Border x:Name="PART_ElemAdded" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,4,0,4" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,4,24,4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <ContentControl Content="{DynamicResource LOCDateAddedLabel}" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                                                                        Foreground="{DynamicResource TextBrushDarker}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="12">
                                                                            <ContentControl.ContentTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" TextWrapping="Wrap" />
                                                                                </DataTemplate>
                                                                            </ContentControl.ContentTemplate>
                                                                        </ContentControl>
                                                                        <TextBlock Grid.Column="2" x:Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                    </Grid>
                                                                </Border>
<Border x:Name="MetaScores" Padding="0"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,8,0,0" /><Style.Triggers><MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Center"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataColumn}" Value="Stretch"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
