<!--
    Joyride: GroupBox, the Statistics page's card and the settings groups. A sticker panel (LocalStickerPanelTemplate): content-sized
    charcoal, a 2px black rim and a 6px hard black offset, the title as the V brief tab (a black label with a mission-yellow edge, Barlow
    Condensed Bold) at its top left. No fixed widths: the card sizes to its content.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource LocalPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalStickerPanelTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                 Foreground="{DynamicResource LocalMissionBrush}" Focusable="False" IsTabStop="False" />
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <StackPanel x:Name="HeaderHost" DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                <Border HorizontalAlignment="Left" Background="{DynamicResource LocalGutterBrush}" Padding="12,2,10,3">
                                    <Grid>
                                        <Rectangle Width="4" Margin="-12,-2,0,-3" HorizontalAlignment="Left" Fill="{DynamicResource LocalMissionBrush}" />
                                        <TextBlock Style="{DynamicResource HeadingTextBlock}" FontSize="13">
                                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                              RecognizesAccessKey="True" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderHost" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
