<!--
    Joyride: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json); each placeholder names the token that plays the key's role.
    The pause menu's black steps: asphalt is the page and shell, gutter-black the collage gutters, outlines and hard shadows,
    panel / panel-lit / panel-up the plates. Selection is the pause menu's white plate with black ink and a mission-yellow tab;
    mission yellow is the accent, cash green the money counters, wasted red danger, siren blue the running game (nothing else
    uses it). The three V protagonist colors only draw the tri-color tick.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Typography: Barlow body (Chalet London stand-in) and Barlow Condensed Bold captions (Chalet Comprime stand-in), both
         bundled; Impact (Windows) with a black outline for poster titles, money counters and Play (Pricedown's role). -->
    <sys:Double x:Key="FontSizeSmall">{{px:size-caption}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:size-body}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:size-lead}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:size-title}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:size-display}}</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow, {{text:font-body|Barlow}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Barlow Condensed, {{text:font-heading|Barlow Condensed}}</FontFamily>
    <FontFamily x:Key="LocalPosterFontFamily">{{text:font-poster|Impact}}</FontFamily>
    <!-- Metadata width defaults (usable content, inside the pane's padding and frame). -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>
    <!-- Shape: 2px black rims, 4px hard offsets, 2-3px corners (key caps 3, the radar close plate 6). -->
    <Thickness x:Key="PopupBorderThickness">{{px:stroke-hair}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:stroke-hair}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:stroke-rim}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:corner-medium}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:corner-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:corner-large}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{white}}</Color>
    <Color x:Key="TextColorDarker">{{grey-light}}</Color>
    <Color x:Key="TextColorDark">{{ink}}</Color>
    <Color x:Key="MainColor">{{panel-up}}</Color>
    <Color x:Key="MainColorDark">{{asphalt}}</Color>
    <Color x:Key="HoverColor">{{panel-lit}}</Color>
    <Color x:Key="GlyphColor">{{mission}}</Color>
    <Color x:Key="HighlightGlyphColor">{{mission/35}}</Color>
    <Color x:Key="PopupBackgroundColor">{{gutter-black}}</Color>
    <Color x:Key="PopupBorderColor">{{dim}}</Color>
    <Color x:Key="BackgroundToneColor">{{panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{panel}}</Color>   <!-- the slot behind each cover -->
    <Color x:Key="PanelSeparatorColor">{{gutter-black}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{gutter-black}}</Color>
    <Color x:Key="DataChangeNotifColor">{{gold}}</Color>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <!-- Banner darkening color: the blue-black of the night-city collage panels, so a darker banner reads as dusk, not grey. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{asphalt-deep}}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{edge}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{panel-up}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{cash}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{wasted-lit}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{trevor}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{asphalt}}" />
    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->
    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{asphalt}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{asphalt}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{asphalt}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{panel-lit}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{pure}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{siren}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{panel-lit}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{wasted}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{pure}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{panel-hi}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{mission-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{grey}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{dim}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{pure}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{pure}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{health}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{health-deep}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{dim}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{grey}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{gutter-black/70}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{dim}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{dim}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{grey-light}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{panel-lit}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{white}}" />
    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{edge}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{pure}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{edge}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{grey}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{grey-light}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{edge}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{edge}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{edge}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{pure}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{panel-up}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{cash}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="TextOutlineBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{edge}}" />
    <!-- Theme-only: the HUD colors, collage paint and plates (Local prefix = no ThemeModifier entry, no shared meaning). -->
    <SolidColorBrush x:Key="LocalGutterBrush" Color="{{gutter-black}}" />
    <SolidColorBrush x:Key="LocalAsphaltBrush" Color="{{asphalt}}" />
    <SolidColorBrush x:Key="LocalAsphaltDeepBrush" Color="{{asphalt-deep}}" />
    <SolidColorBrush x:Key="LocalPanelBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="LocalPanelLitBrush" Color="{{panel-lit}}" />
    <SolidColorBrush x:Key="LocalPanelUpBrush" Color="{{panel-up}}" />
    <SolidColorBrush x:Key="LocalPanelHiBrush" Color="{{panel-hi}}" />
    <SolidColorBrush x:Key="LocalEdgeBrush" Color="{{edge}}" />
    <SolidColorBrush x:Key="LocalDimBrush" Color="{{dim}}" />
    <SolidColorBrush x:Key="LocalPureBrush" Color="{{pure}}" />
    <SolidColorBrush x:Key="LocalWhiteBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="LocalGreyLightBrush" Color="{{grey-light}}" />
    <SolidColorBrush x:Key="LocalGreyBrush" Color="{{grey}}" />
    <SolidColorBrush x:Key="LocalInkBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="LocalMissionBrush" Color="{{mission}}" />
    <SolidColorBrush x:Key="LocalMissionLitBrush" Color="{{mission-lit}}" />
    <SolidColorBrush x:Key="LocalMissionDeepBrush" Color="{{mission-deep}}" />
    <SolidColorBrush x:Key="LocalGoldBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="LocalCashBrush" Color="{{cash}}" />
    <SolidColorBrush x:Key="LocalCashDeepBrush" Color="{{cash-deep}}" />
    <SolidColorBrush x:Key="LocalHealthBrush" Color="{{health}}" />
    <SolidColorBrush x:Key="LocalHealthDeepBrush" Color="{{health-deep}}" />
    <SolidColorBrush x:Key="LocalWastedBrush" Color="{{wasted}}" />
    <SolidColorBrush x:Key="LocalWastedLitBrush" Color="{{wasted-lit}}" />
    <SolidColorBrush x:Key="LocalWastedDeepBrush" Color="{{wasted-deep}}" />
    <SolidColorBrush x:Key="LocalSirenBrush" Color="{{siren}}" />
    <SolidColorBrush x:Key="LocalSirenDeepBrush" Color="{{siren-deep}}" />
    <SolidColorBrush x:Key="LocalSirenWashBrush" Color="{{siren/18}}" />
    <SolidColorBrush x:Key="LocalMichaelBrush" Color="{{michael}}" />
    <SolidColorBrush x:Key="LocalFranklinBrush" Color="{{franklin}}" />
    <SolidColorBrush x:Key="LocalTrevorBrush" Color="{{trevor}}" />
    <SolidColorBrush x:Key="LocalVicePinkBrush" Color="{{vice-pink}}" />
    <SolidColorBrush x:Key="LocalViceMagentaBrush" Color="{{vice-magenta}}" />
    <SolidColorBrush x:Key="LocalViceTealBrush" Color="{{vice-teal}}" />
    <SolidColorBrush x:Key="LocalViceDuskBrush" Color="{{vice-dusk}}" />
    <SolidColorBrush x:Key="LocalLibertyBrush" Color="{{liberty}}" />
    <SolidColorBrush x:Key="LocalLibertyDeepBrush" Color="{{liberty-deep}}" />
    <SolidColorBrush x:Key="LocalSaCreamBrush" Color="{{sa-cream}}" />
    <SolidColorBrush x:Key="LocalSaRustBrush" Color="{{sa-rust}}" />
    <SolidColorBrush x:Key="LocalFreemodeBrush" Color="{{freemode}}" />
    <SolidColorBrush x:Key="LocalFreemodeDeepBrush" Color="{{freemode-deep}}" />
    <SolidColorBrush x:Key="LocalGlassBrush" Color="{{glass}}" />
    <SolidColorBrush x:Key="LocalGlassBrightBrush" Color="{{glass-bright}}" />
    <SolidColorBrush x:Key="LocalScrimBrush" Color="{{scrim}}" />
</ResourceDictionary>
