<!--
    Overlay on Playnite Default/DefaultControls/CheckBox.xaml. The game's ON / OFF option toggle: a tan capsule
    (CheckBoxBorderBrush, 36x20, radius 10) holding a round cream knob (SliderThumbBackgroundBrush, 16px) with a short
    shadow beneath it. Off: the knob sits left. On: the capsule turns the green of QUICK JOIN (PrimaryButtonBackgroundBrush
    with a PrimaryButtonBorderBrush rim) and the knob slides right with a small overshoot (BackEase, 0.16s).
    Indeterminate: the knob sits in the middle. Hover: a 2px CheckBoxHoverBorderBrush ring around the capsule.
    Label gap 10px. Keyboard focus: CheckBoxFocusVisual.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource CheckBoxFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="36" Height="20" VerticalAlignment="Center">
                                <Border x:Name="HoverRing" Margin="-2" CornerRadius="12" Opacity="0"
                                        BorderThickness="2" BorderBrush="{DynamicResource CheckBoxHoverBorderBrush}" />
                                <Border x:Name="BulletBorder" CornerRadius="10" BorderThickness="0"
                                        Background="{TemplateBinding BorderBrush}" />
                                <Ellipse x:Name="KnobShadow" Width="16" Height="16" Margin="2,4,0,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{DynamicResource TextBrushDarker}" Opacity="0.35">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ShadowShift" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Knob" Width="16" Height="16" Margin="2,0,0,2"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{DynamicResource SliderThumbBackgroundBrush}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobShift" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="10,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="HoverRing" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" TargetName="BulletBorder" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" TargetName="BulletBorder" />
                            <Setter Property="BorderThickness" Value="2" TargetName="BulletBorder" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ShadowShift" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ShadowShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" TargetName="BulletBorder" />
                            <Setter Property="Fill" Value="{DynamicResource TextBrushDarker}" TargetName="Knob" />
                            <Setter Property="Margin" Value="10,0,0,2" TargetName="Knob" />
                            <Setter Property="Margin" Value="10,4,0,0" TargetName="KnobShadow" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
