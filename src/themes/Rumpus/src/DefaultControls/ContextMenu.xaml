<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu,
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is Party Animals' butter card: warm butter fill (PopupBackgroundBrush) with a
    2px tan rim (PopupBorderBrush) over a 4px burnt-orange bottom lip (SlotBorderBrush), 14px soft corners and three
    tiny confetti dots (blue, green, coral) tucked into the top-right corner (LocalMenuPanelTemplate, shared by
    ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml).
    Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <!-- 4px burnt-orange lip beneath the butter card -->
            <Border Margin="0,4,0,0" CornerRadius="14" Background="{DynamicResource SlotBorderBrush}" />
            <Border Margin="0,0,0,4" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="2" CornerRadius="14" />
            <!-- Three confetti dots in the top-right corner -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,12,0">
                <Ellipse Width="5" Height="5" Margin="0,0,3,0" Fill="{DynamicResource StripeBrush}" />
                <Ellipse Width="5" Height="5" Margin="0,0,3,0" Fill="{DynamicResource StripeAltBrush}" />
                <Ellipse Width="5" Height="5" Fill="{DynamicResource StripeAccentBrush}" />
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,10,0,10" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="6,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
