<!--
    Overlay on Playnite Default/DefaultControls/TextBox.xaml. A sunk cream well: InputBackgroundBrush fill (lit cream), a
    InputBorderBrush rim 1px at the sides and 3px at the top (the sunk look of the game's option bars), CornerRadiusLarge (20, a capsule at 32px),
    InputPadding, 32px (ControlHeight) and growing for multi-line text.
    Hover: InputHoverBorderBrush rim. Focus: the rim disappears and a 2px FocusBrush ring replaces it; the ring is an
    overlay Border on IsKeyboardFocusWithin so nothing shifts. A text box drawn without an edge (BorderThickness 0) shows no ring.
    BareTextBox: no chrome at all, for hosts that draw their own (search box, editable dropdown).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LocalBoneFieldTemplate: a cream pill on a lip with the selection's bone pointer. A 3px butter lip sits under the
        bottom edge at rest. Hover: the lip turns orange. Keyboard focus: the lip turns yellow and the cream bone marker
        (BoneGeometry) pops onto the top-left corner, tilted, with a squash-and-stretch bounce (0.24s).
        State is read from the nearest Control above; no desired size.
    -->
    <ControlTemplate x:Key="LocalBoneFieldTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle x:Name="Lip" Height="3" VerticalAlignment="Bottom" Margin="2,0,2,-2" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource PanelShadowBrush}" />
            <Path x:Name="Bone" Width="17" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,-5,0,0" Stretch="Uniform"
                  Data="{DynamicResource BoneGeometry}" Fill="{DynamicResource InputBackgroundBrush}" RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BoneScale" ScaleX="0.2" ScaleY="0.2" />
                        <RotateTransform Angle="-28" />
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <Setter TargetName="Lip" Property="Fill" Value="{DynamicResource InputHoverBorderBrush}" />
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Lip" Property="Fill" Value="{DynamicResource SelectedBorderBrush}" />
                <Setter TargetName="Bone" Property="Opacity" Value="1" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Pop">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BoneScale" Storyboard.TargetProperty="ScaleX">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="1.25" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.18" Value="0.92" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.24" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BoneScale" Storyboard.TargetProperty="ScaleY">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0.85" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.18" Value="1.12" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.24" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Pop" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,3,1,1" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Grid>
                            <Border x:Name="Border" BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                            </Border>
                            <Control x:Name="FieldOverlay" Template="{DynamicResource LocalBoneFieldTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        </Grid>
                        <Border x:Name="FocusRing" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}"
                                CornerRadius="{DynamicResource CornerRadiusLarge}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                            <Setter Property="BorderBrush" Value="Transparent" TargetName="Border" />
                            <Setter Property="Visibility" Value="Visible" TargetName="FocusRing" />
                        </Trigger>
                        <Trigger Property="BorderThickness" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="FocusRing" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No fill, no edge, no padding: the host (search box, editable dropdown) draws the field. -->
    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
