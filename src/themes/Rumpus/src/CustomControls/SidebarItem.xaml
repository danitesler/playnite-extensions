<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    Rail item: a 44x40 compact item (repo shell rule) with a 32px pill, the cream pills that sit on the game's yellow bottom
    bar: a lit face (ButtonBackgroundBrush) over a 3px lip (ButtonBorderBrush), a TextBrushDarker icon. Hover: the face turns
    TopPanelSearchBoxHoverBackgroundBrush, lifts 1.5px with a small overshoot and the icon goes TextBrush. The current
    item is the yellow APPLY pill (SelectedBrush over a SelectedBorderBrush lip) with a SelectedForegroundBrush icon and a
    small orange tab (SidebarItemSelectedGlowBrush) on the rail's outer edge. The whole 44x40 item is the hit target.
    Icons are scaled into a fixed 16x16 IconHost centered in the pill (no IconPadding); Library and Statistics use the
    theme's icons. PART_ProgressStatus (shown while an add-on reports progress) is a thin bar along the pill's bottom.
    An item with no content is a bare marker: WarningBrush fill.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Grid x:Name="Tile" SnapsToDevicePixels="True" Width="32" Height="32"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}">
                            <Border x:Name="Lip" Margin="0,3,0,0" Background="{TemplateBinding BorderBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                            <Border x:Name="Face" Margin="0,0,0,3" Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="FaceShift" Y="0" />
                                </Border.RenderTransform>
                                <Grid x:Name="IconHost" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox x:Name="ItemIcon">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    </Viewbox>
                                    <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                    IsHitTestVisible="False"
                                                    ContentTemplate="{DynamicResource IconTemplate}" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Border x:Name="Marker" Width="4" Height="12" CornerRadius="0,3,3,0" Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"
                                Background="{DynamicResource SidebarItemSelectedGlowBrush}" IsHitTestVisible="False" />
                        <ProgressBar x:Name="PART_ProgressStatus" Height="4" Padding="0" Margin="12,0,12,7"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource ProgressBarForegroundBrush}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="Y" To="-1.5" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectedBorderBrush}" TargetName="Lip" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="PART_ProgressStatus" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Marker" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
