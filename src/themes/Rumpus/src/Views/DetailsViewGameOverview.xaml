<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details view, right pane).
    The butter panel of the game's menus (GameOverviewBackgroundBrush) on the orange page. The banner (HeroArt) is bleached by a
    butter wash and fades into the panel; the title is the game's screen title: a bone (the game's currency, HeadingMarkerBrush),
    then the name in the heading face (Nunito Black).
    Skeleton as in src/themes/AGENTS.md: banner, proportional spacer, header (icon, bone, name, actions), then the
    Steam screenshots host and skeleton, description and notes on the left and the metadata pane on the right
    (responsive: scripts/game-page-breakpoints.mjs). Cards are cream option rows (ExpanderBackgroundBrush over a 4px
    ButtonBorderBrush lip, CornerRadiusLarge 20); each is headed like a settings group, the title in the
    heading face followed by a 4px rounded tan rule (HeadingRuleBrush). The metadata pane is one card with six collapsing
    groups split by tan hairlines; captions 12px muted in a 112px column, values 14px text, links
    (PropertyItemButton) or chips. Actions: Play is the 40px green QUICK JOIN pill (PlayButton); the context action is a
    green pill; More and Edit are 40px cream icon buttons, always visible, labelled by ToolTip.
    With no game selected: the chalkboard of the game's map and controller screens with a paw drawn in chalk and a taped
    sticky note holding LOCErrorNoGameSelected in handwriting (the note sways in ControlTemplate.Triggers).
    Every PART_ of Playnite's file is kept, each once. HtmlTextView takes Color-typed properties: the brushes are set on
    TextElement.Foreground and Tag and the Colors are bound from them (the one place theme XAML reads a Color).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Card title / section heading: the game's settings group heading (heading face, Bold). Used by every overview. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Placeholder for the Steam Screenshots control: a 16:9 main image over a row of five thumbnails (a muted
         fill, radius-md; here the host's Foreground at 15 percent, and a pulse instead of the shimmer, which needs a gradient).
         Each Viewbox scales a 1600px layout to the width its column gives it. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the add-on's ContentControl. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="24"
                        Background="{TemplateBinding Foreground}" Opacity="0.15" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="16" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="2" CornerRadius="16" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="4" CornerRadius="16" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="6" CornerRadius="16" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="8" CornerRadius="16" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible"
                                  Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible"
                                  d:DesignWidth="1280" d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Grid x:Name="PageRoot">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <!-- Banner: the game's background art as a band of GameBannerHeight (0 turns it off), faded into the page by a gradient on top
                                 (not a mask). Collapsed when the game has no background art or Playnite hides the image. -->
                            <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <!-- No OpacityMask on the banner: masked art repainted in part (behind the animated Play button) left dark patches on
                                     scaled displays. A butter wash (ScrimBrush at 28 percent) warms the art like the game's backdrops, then a plain
                                     gradient runs from transparent white (a light page must not pass through grey) to the page color (PageRoot). -->
                                <Rectangle Fill="{DynamicResource ScrimBrush}" Opacity="0.28" />
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.82" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <Grid HorizontalAlignment="Stretch" MaxWidth="1280" Margin="32,0,32,32">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Room above the title: the title sits low on the banner; the spacer shrinks when there is no banner. -->
                                <Border Grid.Row="0" IsHitTestVisible="False" x:Name="DetailsBannerSpacer" MinHeight="32">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 100 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="32" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="32" />
</DataTrigger>
</Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="0,0,0,24" Background="Transparent">
                                    <!-- Cover, sized by Playnite's cover height setting: rounded to CornerRadiusLarge by a mask, cached. -->
                                    <Border x:Name="CoverFrame" DockPanel.Dock="Right" Margin="24,0,0,0" VerticalAlignment="Bottom">
                                        <Border.CacheMode>
                                            <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                        </Border.CacheMode>
                                        <Border.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=CoverShape}" />
                                        </Border.OpacityMask>
                                        <Grid>
                                            <Border x:Name="CoverShape" Background="{DynamicResource ExpanderBackgroundBrush}"
                                                    CornerRadius="{DynamicResource CornerRadiusLarge}" />
                                            <Image x:Name="PART_ImageCover"
                                                   Height="{Settings GameDetailsCoverHeight}"
                                                   StretchDirection="Both" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <DockPanel>
                                            <Image x:Name="PART_ImageIcon" MaxHeight="40" MaxWidth="40" DockPanel.Dock="Left" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <Path DockPanel.Dock="Left" Data="{DynamicResource BoneGeometry}" Width="28" Height="12" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource HeadingMarkerBrush}" IsHitTestVisible="False" />
                                            <TextBlock x:Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLargest}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Black"
                                                       LineHeight="31.2" LineStackingStrategy="BlockLineHeight"
                                                       TextWrapping="Wrap" VerticalAlignment="Center">
<TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Style.Triggers><DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" Height="40" MinWidth="160" />
                                                <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" Height="40" MinWidth="160" />
                                                <Control Style="{DynamicResource RunningActionIndicator}" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                                                    ToolTip="{DynamicResource LOCMoreAction}" Focusable="False">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Margin="8,0,0,0" Focusable="False"
                                                    VerticalAlignment="Center" ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Grid.Row="2" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top" Tag="{DynamicResource GameDetailsPanePosition}"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left"><Setter Property="Grid.Column" Value="0" /><Setter Property="Margin" Value="0,0,24,0" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /><Setter Property="HorizontalAlignment" Value="Center" /></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True" /><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Center" /></MultiDataTrigger.Conditions><Setter Property="Grid.Row" Value="0" /><Setter Property="Margin" Value="0,0,0,24" /><Setter Property="HorizontalAlignment" Value="Stretch" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
<Grid Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                        <Border x:Name="DetailsPanel" VerticalAlignment="Top"
                                                Background="{DynamicResource ExpanderBackgroundBrush}"
                                                BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,0,0,4"
                                                CornerRadius="{DynamicResource CornerRadiusLarge}" Padding="{DynamicResource GroupBoxPadding}">
                                            <Border.Resources>
                                                <!-- Values are body text; a TextBlock with Tag="Caption" is the field caption (12px, medium, muted) -->
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Tag" Value="Caption">
                                                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                                                            <Setter Property="FontWeight" Value="Medium" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                            <Setter Property="TextWrapping" Value="Wrap" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                            </Border.Resources>
                                            <StackPanel Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch" x:Name="DetailsMetadataContent">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCGameDetails}" /><Rectangle Grid.Column="1" Height="4" RadiusX="2" RadiusY="2" Margin="10,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource HeadingRuleBrush}" IsHitTestVisible="False" /></Grid>
                                                <!-- The rule of each group is its top border; the wrapper clips the first one (negative margins:
                                                     -(2 x 12 + 1 + 8) on top, -8 at the bottom; change them with the spacing). -->
                                                <Border ClipToBounds="True" x:Name="DetailsMetadataViewport">
                                                    <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-33,0,-8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-33,-24,-8" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                        <Border x:Name="MetaProgress" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                BorderBrush="{DynamicResource ButtonBorderBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCCompletionStatus}" />
                                                                    <Button Grid.Column="1" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCTimePlayed}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextPlayTime" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCLastPlayed}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextLastActivity" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCRecentActivityLabel}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextRecentActivity" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCDateAddedLabel}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextAdded" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                BorderBrush="{DynamicResource ButtonBorderBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCCommunityScore}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCCriticScore}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCUserScore}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                BorderBrush="{DynamicResource ButtonBorderBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
