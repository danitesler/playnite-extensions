                                                      Stroke="{DynamicResource TooltipForegroundBrush}" StrokeThickness="2.4" StrokeLineJoin="Round" StrokeDashArray="3.2 2.2" Opacity="0.9" />
                                                <Path Data="M 4,12 L 12,12 M 8,8 L 8,16" Stroke="{DynamicResource TooltipForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                <Path Data="M 0,0 L 7,0 M 3.5,-3.5 L 3.5,3.5" Stroke="{DynamicResource TooltipForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,12" />
                                                <Ellipse Width="7" Height="7" Stroke="{DynamicResource TooltipForegroundBrush}" StrokeThickness="2" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0" />
                                            </Grid>
                                            <!-- The sticky note: the empty-selection line in handwriting on a taped note that sways. -->
                                            <Grid x:Name="EmptyNote" Margin="0,22,0,0" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0">
                                                <Grid.RenderTransform>
                                                    <RotateTransform x:Name="EmptyNoteSwing" Angle="-2" />
                                                </Grid.RenderTransform>
                                                <Border Padding="22,24,22,18" CornerRadius="6" Background="{DynamicResource SelectedBrush}">
                                                    <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220"
                                                               FontFamily="{DynamicResource NoteFontFamily}" FontSize="22" LineHeight="26" LineStackingStrategy="BlockLineHeight"
                                                               Foreground="{DynamicResource SelectedForegroundBrush}" />
                                                </Border>
                                                <Border Width="70" Height="18" CornerRadius="2" Margin="0,-9,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                        Background="{DynamicResource SelectedBorderBrush}" Opacity="0.9" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                    <ControlTemplate.Triggers>
                        <!-- Empty state idle: the note sways while no game is selected. Rotation needs a named
                             transform and lives here, not in a Style trigger (reference.md, Hard rules). -->
                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="EmptyNoteLoop">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="EmptyNoteSwing" Storyboard.TargetProperty="Angle"
                                                         From="-2.2" To="2.2" Duration="0:0:2.1" AutoReverse="True" RepeatBehavior="Forever">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="EmptyNoteLoop" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>