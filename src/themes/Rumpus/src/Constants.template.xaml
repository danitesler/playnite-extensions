<!--
    Rumpus: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    A light theme: a party-orange page, butter panels, cream pills, brown ink, a yellow pill for whatever is selected,
    green for Play and blue type on secondary buttons. Token names (rp-*) live in tokens.css and are measured from
    captures (../RESEARCH.md). Keys are the shared vocabulary (scripts/data/theme-keys.json). Theme XAML reads brushes only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Type: Nunito (Regular and Bold) for text and Nunito ExtraBold and Black for titles and buttons, bundled in Typography/; the game's own heavy rounded menu face is proprietary. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">18</sys:Double>
    <sys:Double x:Key="FontSizeLargest">28</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Nunito, {{text:font-body|Nunito}}, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Nunito, {{text:font-heading|Nunito}}, Segoe UI</FontFamily>
    <FontFamily x:Key="NoteFontFamily">./Typography/#Patrick Hand, {{text:font-note|Patrick Hand}}, Segoe Print</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- Shape: 32px controls are pills (radius 16 = half the height, so WPF draws a true capsule); rows, cards and panels take the big soft corners of the game's menu panels. -->
    <Thickness x:Key="PopupBorderThickness">2</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:rp-radius-pill}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:rp-radius-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:rp-radius-card}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:rp-radius-xlarge}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">10000</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">10</Thickness>

    <!-- Playnite palette. GlyphColor (glyphs, links on cream) is the darkened APPLY orange; TextColorDark is the brown ink printed on the yellow and green fills. -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{rp-ink}}</Color>
    <Color x:Key="TextColorDarker">{{rp-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{rp-ink-deep}}</Color>
    <Color x:Key="MainColor">{{rp-cream}}</Color>
    <Color x:Key="MainColorDark">{{rp-cream-hi}}</Color>
    <Color x:Key="HoverColor">{{rp-cream-hi}}</Color>
    <Color x:Key="GlyphColor">{{rp-orange-ink}}</Color>
    <Color x:Key="HighlightGlyphColor">{{rp-orange}}</Color>
    <Color x:Key="PopupBackgroundColor">{{rp-butter}}</Color>
    <Color x:Key="PopupBorderColor">{{rp-rim}}</Color>
    <Color x:Key="BackgroundToneColor">{{rp-butter}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{rp-hairline}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{rp-hairline}}</Color>
    <Color x:Key="DataChangeNotifColor">{{rp-coral}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{rp-cream-lip}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{rp-chalk}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{rp-cream-hi}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{rp-cream-hi}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{rp-green-ok}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{rp-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{rp-orange-ink}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{rp-orange-ink}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{rp-cream}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{rp-orange}}" />

    <!-- Shell: the orange page; the rail and top bar are the yellow bar of the game's bottom edge with cream pills on it. -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{rp-bar}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{rp-butter-deep}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the burnt orange rim of the game's menu panels, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{rp-orange-deep}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{rp-bar}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{rp-butter}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{rp-butter}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{rp-cream-hi}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{rp-cream-white}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{rp-green}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{rp-green-ink}}" />

    <!-- States: the selected tab, row or tile is a yellow pill with brown ink; hover lifts a lighter cream. -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{rp-yellow}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{rp-yellow-hi}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{rp-ink-deep}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{rp-cream-white}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{rp-yellow}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{rp-cream-white}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{rp-blue-ink}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{rp-blue-hi}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{rp-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{rp-cream-white}}" />

    <!-- Headings: brown ink, a bone marker before the title, a tan rule. The title band is the panel header yellow with a cream title. -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{rp-ink-deep}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{rp-orange-ink}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{rp-cream-lip}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{rp-header}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{rp-cream-white}}" />

    <!-- Confetti: blue, green and coral bits (reuses the shared Stripe keys) -->
    <SolidColorBrush x:Key="StripeBrush" Color="{{rp-blue}}" />
    <SolidColorBrush x:Key="StripeAltBrush" Color="{{rp-green}}" />
    <SolidColorBrush x:Key="StripeAccentBrush" Color="{{rp-coral}}" />

    <!-- Buttons: cream pills with dusty blue type (the menu's Cancel and Reset); Play is the green QUICK JOIN pill with a dark green label. -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{rp-blue-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{rp-cream-white}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{rp-cream-lip}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{rp-cream-lip}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{rp-green}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{rp-green-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{rp-green-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{rp-green-ink}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{rp-yellow}}" />

    <!-- Inputs: lit cream wells with a tan rim -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{rp-cream-hi}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{rp-cream-white}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{rp-cream-lip}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{rp-orange}}" />

    <!-- Controls: toggles are tan capsules that turn green; gauges are tan tracks with a green level bar; scroll thumbs are burnt orange -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{rp-cream-lip}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{rp-orange}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{rp-green-hi}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{rp-cream-lip}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{rp-cream-white}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{rp-orange}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{rp-orange-ink}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{rp-green-bar}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{rp-cream-lip}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{rp-orange-deep/80}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{rp-orange-deep}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{rp-orange-deep/80}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{rp-orange-deep}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{rp-yellow}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{rp-cream-hi}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{rp-cream-white}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{rp-yellow}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{rp-cream-hi}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{rp-yellow}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{rp-cream-hi}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{rp-blue-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{rp-cream-white}}" />

    <!-- Popups: butter sheets with a tan rim; tooltips are the chalkboard -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{rp-hairline}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{rp-chalk-white}}" />

    <!-- Running game: indigo, the forum card's blue; yellow selects, cream hovers, green plays, coral flags. -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{rp-indigo}}" />

    <!-- Lips and sheens: every plate is a face over a darker lip. Yellow lip, green lip, the orange rim of a selected row,
         the pale sheen that crosses Play, and the chalkboard rim of tooltips. -->
    <SolidColorBrush x:Key="CapBarBrush" Color="{{rp-bar-deep}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{rp-butter-deep}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{rp-ink-deep}}" />
    <SolidColorBrush x:Key="StripeDeepBrush" Color="{{rp-indigo-deep}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{rp-yellow-deep}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{rp-cream-white}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{rp-green-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{rp-cream-white}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{rp-orange-deep}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{rp-chalk-hi}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{rp-ink-deep}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{rp-orange-ink}}" />

    <!-- Text and glyphs printed straight on the game art while "Use game background image as window background" is on (a light theme's ink would vanish on dark art). -->
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{rp-cream-white}}" />
</ResourceDictionary>
