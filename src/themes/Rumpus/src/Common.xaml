<!--
    Overlay on Playnite Default/Common.xaml. Rumpus's spacing and focus.
    The game's option rows and menu pills are about 32px tall at 1080p with 14px labels, which is this repo's
    ControlHeight, so pills are true capsules (radius 16, a 29px face over a 3px lip). Playnite lays controls out by padding; vertical padding
    stays at 5 so ControlHeight decides the height.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: a butter sheet with a 2px tan rim, CornerRadiusLarge (20) like the game's menu panel -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    </Style>

    <!-- Keyboard focus: a 2px FocusBrush (dusty blue) ring 2px outside the control, pill radius (buttons, tabs, rows). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="20" RadiusY="20" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggles and radios: the same ring around the 16px capsule and the round radio. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="11" RadiusY="11" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: 18 inline so the pill ends clear the label -->
    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <!-- Text box, password box, dropdown: 12 inline -->
    <Thickness x:Key="InputPadding">12,5</Thickness>
    <!-- Menu: 4 inside the sheet; items 31px (17 + 2 x 7), close to the game's 30px option rows -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">8,7,12,7</Thickness>
    <!-- Dropdown popup: the same sheet and rows as menus -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,7,12,7</Thickness>
    <!-- List box item -->
    <Thickness x:Key="ListBoxItemPadding">12,8</Thickness>
    <!-- Card (group box): 16 body padding; the header carries the title and its rule -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">16,14,16,0</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">14</sys:Double>
    <!-- Tooltip -->
    <Thickness x:Key="TooltipPadding">12,6</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu, on the green pill): the theme's paw print, a pad and four toes in the
         pill's ink (the host's Foreground), 18x20. Hover (IsMouseOver): the toes wiggle up one after another, 40ms apart
         (2px, BackEase, 0.22s) and drop back on exit. Open (the menu's ContextMenu.IsOpen on the nearest Border, which is
         PART_ElemMainMenu): the paw pats the table: the toes splay 7 and 14 degrees about the pad, the whole print hops 2.5px
         and lands with a squash of the pad (0.82 high, 1.12 wide) on a 1.2s loop, like a party animal's bouncy stomp, until the
         menu closes. Every toe sits in a splay canvas (open) around its own wiggle translate (hover). -->
    <ControlTemplate x:Key="LocalRumpusMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="False">
            <Canvas Width="18" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas.RenderTransform><TranslateTransform x:Name="Hop" Y="0" /></Canvas.RenderTransform>
                <Canvas Width="18" Height="20">
                    <Canvas.RenderTransform><RotateTransform x:Name="SplayA" CenterX="9" CenterY="13" Angle="0" /></Canvas.RenderTransform>
                    <Ellipse Canvas.Left="0.9" Canvas.Top="6.2" Width="3.8" Height="4.8" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><TransformGroup><RotateTransform Angle="-25" /><TranslateTransform x:Name="WigA" Y="0" /></TransformGroup></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
                <Canvas Width="18" Height="20">
                    <Canvas.RenderTransform><RotateTransform x:Name="SplayB" CenterX="9" CenterY="13" Angle="0" /></Canvas.RenderTransform>
                    <Ellipse Canvas.Left="4.5" Canvas.Top="2.0" Width="3.8" Height="5.2" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><TransformGroup><RotateTransform Angle="-8" /><TranslateTransform x:Name="WigB" Y="0" /></TransformGroup></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
                <Canvas Width="18" Height="20">
                    <Canvas.RenderTransform><RotateTransform x:Name="SplayC" CenterX="9" CenterY="13" Angle="0" /></Canvas.RenderTransform>
                    <Ellipse Canvas.Left="9.7" Canvas.Top="2.0" Width="3.8" Height="5.2" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><TransformGroup><RotateTransform Angle="8" /><TranslateTransform x:Name="WigC" Y="0" /></TransformGroup></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
                <Canvas Width="18" Height="20">
                    <Canvas.RenderTransform><RotateTransform x:Name="SplayD" CenterX="9" CenterY="13" Angle="0" /></Canvas.RenderTransform>
                    <Ellipse Canvas.Left="13.3" Canvas.Top="6.2" Width="3.8" Height="4.8" Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><TransformGroup><RotateTransform Angle="25" /><TranslateTransform x:Name="WigD" Y="0" /></TransformGroup></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
                <Path Data="M9,10.5 C12.5,10.5 14.5,13 14.5,15.3 C14.5,17.6 12.2,18.4 9,18.4 C5.8,18.4 3.5,17.6 3.5,15.3 C3.5,13 5.5,10.5 9,10.5Z" Fill="{TemplateBinding Foreground}">
                    <Path.RenderTransform><ScaleTransform x:Name="PadSquash" CenterX="9" CenterY="18.4" ScaleX="1" ScaleY="1" /></Path.RenderTransform>
                </Path>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="WigA" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="WigB" Storyboard.TargetProperty="Y" To="-2" BeginTime="0:0:0.04" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="WigC" Storyboard.TargetProperty="Y" To="-2" BeginTime="0:0:0.08" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="WigD" Storyboard.TargetProperty="Y" To="-2" BeginTime="0:0:0.12" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="WigA" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="WigB" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="WigC" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="WigD" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SplayA" Storyboard.TargetProperty="Angle" To="-14" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SplayB" Storyboard.TargetProperty="Angle" To="-7" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SplayC" Storyboard.TargetProperty="Angle" To="7" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SplayD" Storyboard.TargetProperty="Angle" To="14" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hop" Storyboard.TargetProperty="Y" BeginTime="0:0:0.25" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-2.5"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.65" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PadSquash" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.25" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.75" Value="0.82"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PadSquash" Storyboard.TargetProperty="ScaleX" BeginTime="0:0:0.25" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.75" Value="1.12"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="1"><EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SplayA" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SplayB" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SplayC" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SplayD" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Hop" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PadSquash" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PadSquash" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
