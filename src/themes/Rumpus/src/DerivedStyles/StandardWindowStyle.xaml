<!--
    Rumpus: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    A 44px band in the header yellow of the game's menu panels (WindowTitleBackgroundBrush), closed by a 4px burnt orange lip
    (SlotBorderBrush): the theme's paw mark (PawGeometry, HeadingMarkerBrush), then the title in the heading face (Nunito Black,
    20px) in cream (WindowTitleForegroundBrush) with a hard 2px shadow in the orange (a second TextBlock offset below, the
    way the game prints "CUSTOM GAME"), and a few confetti bits (StripeBrush, StripeAltBrush, StripeAccentBrush) left of the
    caption buttons, drawn in a zero-size Canvas inside the clipped band so small dialogs still size to content.
    The window body is the butter of the menu panels (PopupBackgroundBrush), its edge a 2px burnt orange rim.
    Caption buttons are the 40x32 WindowBarButton, so the caption and the content offset are 44 (Default 25).
    PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource SlotBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}" ClipToBounds="True">
                                    <!-- Confetti, anchored to the right edge; no desired size. -->
                                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0" IsHitTestVisible="False">
                                        <Rectangle Canvas.Left="-230" Canvas.Top="9" Width="10" Height="5" RadiusX="2" RadiusY="2" Fill="{DynamicResource StripeBrush}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-28" /></Rectangle.RenderTransform></Rectangle>
                                        <Rectangle Canvas.Left="-204" Canvas.Top="22" Width="10" Height="5" RadiusX="2" RadiusY="2" Fill="{DynamicResource StripeAccentBrush}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="24" /></Rectangle.RenderTransform></Rectangle>
                                        <Rectangle Canvas.Left="-182" Canvas.Top="8" Width="10" Height="5" RadiusX="2" RadiusY="2" Fill="{DynamicResource StripeAltBrush}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="40" /></Rectangle.RenderTransform></Rectangle>
                                        <Rectangle Canvas.Left="-160" Canvas.Top="24" Width="10" Height="5" RadiusX="2" RadiusY="2" Fill="{DynamicResource WindowTitleForegroundBrush}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-18" /></Rectangle.RenderTransform></Rectangle>
                                    </Canvas>
                                    <Rectangle Height="4" VerticalAlignment="Bottom" Fill="{DynamicResource SlotBorderBrush}" IsHitTestVisible="False" />
                                    <DockPanel LastChildFill="False">
                                        <!-- The brand mark that opens every screen title. -->
                                        <Path DockPanel.Dock="Left" Data="{DynamicResource PawGeometry}" Width="28" Height="28" Stretch="Uniform" Margin="14,0,8,3"
                                              VerticalAlignment="Center" Fill="{DynamicResource HeadingMarkerBrush}" IsHitTestVisible="False" />
                                        <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" Margin="0,2,0,0" IsHitTestVisible="False"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="20" FontWeight="Black"
                                                       Foreground="{DynamicResource HeadingMarkerBrush}" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource BaseTextBlockStyle}" />
                                            <TextBlock Text="{TemplateBinding Title}" x:Name="PART_TextTitle"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="20" FontWeight="Black"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource BaseTextBlockStyle}" />
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,8,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
