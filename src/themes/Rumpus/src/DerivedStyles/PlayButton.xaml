<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml: the Play / Install button on the game page.
    The game's QUICK JOIN pill: a 40px green capsule (PrimaryButtonBackgroundBrush face, radius 20) over a 4px lip
    (PrimaryButtonBorderBrush), a play chevron and a dark green label (PrimaryButtonForegroundBrush) in the heading face,
    16px Black.
    Layers of the face, bottom to top: Rest plate, RunningBreath, RunningScan, HoverPlate (PrimaryButtonHoverBackgroundBrush),
    PressedPlate (PrimaryButtonPressedBackgroundBrush), the sheen, the confetti bits, the label.
    Hover (the hero moment): the face lifts 2px with an overshoot (BackEase, 0.14s), HoverPlate fades in, a pale sheen
    (SelectedSheenBrush) crosses the plate once, the chevron nudges right, and eight confetti bits (blue, coral, yellow
    and cream: StripeBrush, StripeAccentBrush, SelectedBrush, SelectedSheenBrush) pop outwards and fade over 0.55s.
    Leaving drops the face back (CubicEase) and fades the plates. Pressed: the face drops 3px onto the lip and its own
    plate fades in. The sheen is clipped to the capsule by an OpacityMask taken from the Rest plate.
    Keyboard focus: FocusVisual. Disabled: BaseStyle opacity.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages (Playnite shows RUNNING or
        LAUNCHING there). The ping bars: three rising cream bars at the pill's right end, the way the game shows a
        connection; they fill in one after another while launching and bob slowly while running, over an indigo
        frame and a foot line that fills once.
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching). Never hit-testable.
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="20" Opacity="0.22" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" CornerRadius="20" />
                        <Grid Height="3" Margin="20,0,20,9" VerticalAlignment="Bottom">
                            <Rectangle RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                            <Rectangle x:Name="RunningFill" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <StackPanel x:Name="RunningBarsHost" Orientation="Horizontal" Margin="0,0,20,6" HorizontalAlignment="Right" VerticalAlignment="Center" Height="16" Opacity="0.9">
                            <Rectangle x:Name="RunningBar1" Width="4" Height="16" Margin="0,0,3,0" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1" Fill="{DynamicResource DangerForegroundBrush}">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="RunningBar1Scale" ScaleY="0.4" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="RunningBar2" Width="4" Height="16" Margin="0,0,3,0" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1" Fill="{DynamicResource DangerForegroundBrush}">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="RunningBar2Scale" ScaleY="0.65" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="RunningBar3" Width="4" Height="16" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1" Fill="{DynamicResource DangerForegroundBrush}">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="RunningBar3Scale" ScaleY="0.9" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0.4" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.65" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.7" Value="0.9" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar1Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0.75" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar2Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.4" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBar3Scale" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the launch has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="38,0,26,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Lip" Margin="0,4,0,0" CornerRadius="20" Background="{TemplateBinding BorderBrush}" IsHitTestVisible="False" />
                        <Grid x:Name="Face" Margin="0,0,0,4">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="FaceShift" Y="0" />
                            </Grid.RenderTransform>
                            <Border x:Name="Rest" SnapsToDevicePixels="True" CornerRadius="20"
                                    Background="{TemplateBinding Background}" />
                            <Border x:Name="RunningBreath" SnapsToDevicePixels="True" CornerRadius="20" Background="{DynamicResource TextBrush}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.6" CornerRadius="20" IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.5" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid x:Name="HoverFx">
                                <Border x:Name="HoverPlate" CornerRadius="20" Opacity="0" IsHitTestVisible="False"
                                        Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                                <Border x:Name="PressedPlate" CornerRadius="20" Opacity="0" IsHitTestVisible="False"
                                        Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                                <Grid x:Name="Sweep" ClipToBounds="True" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                                    <Grid.OpacityMask>
                                        <VisualBrush Visual="{Binding ElementName=Rest}" Stretch="None" />
                                    </Grid.OpacityMask>
                                    <Canvas>
                                        <Canvas Opacity="0.5">
                                            <Canvas.RenderTransform>
                                                <TranslateTransform x:Name="SweepX" X="-70" />
                                            </Canvas.RenderTransform>
                                            <Path Data="M0,48 L22,48 L50,0 L28,0 Z" Fill="{DynamicResource SelectedSheenBrush}" />
                                        </Canvas>
                                    </Canvas>
                                </Grid>
                            </Grid>
                            <Border x:Name="RunningHoverDim" SnapsToDevicePixels="True" CornerRadius="20" Background="{DynamicResource TextBrush}" Opacity="0" IsHitTestVisible="False" />
                            <!-- The play chevron of QUICK JOIN: rounded, a little left of centre, nudges right on hover. -->
                            <Path x:Name="Chevron" Data="M0,1.2 Q0,0 1.1,0.6 L9.4,5.4 Q10.4,6 9.4,6.6 L1.1,11.4 Q0,12 0,10.8 Z" Width="10" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="19,0,0,0" IsHitTestVisible="False"
                                  Fill="{TemplateBinding Foreground}">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="ChevronShift" X="0" />
                                </Path.RenderTransform>
                            </Path>
                            <Border x:Name="PlayRoom">
                                <ContentPresenter x:Name="PlayContent" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                            <!-- Confetti: eight bits that pop outwards on hover. Resting opacity 0. -->
                            <Canvas x:Name="Confetti" IsHitTestVisible="False" Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle x:Name="Bit1" Width="8" Height="4" RadiusX="2" RadiusY="2" Opacity="0" Canvas.Left="-52" Canvas.Top="-6" Fill="{DynamicResource StripeBrush}">
                                    <Rectangle.RenderTransform><TransformGroup><RotateTransform Angle="-28" /><TranslateTransform x:Name="Bit1Shift" /></TransformGroup></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bit2" Width="8" Height="4" RadiusX="2" RadiusY="2" Opacity="0" Canvas.Left="-26" Canvas.Top="-16" Fill="{DynamicResource StripeAccentBrush}">
                                    <Rectangle.RenderTransform><TransformGroup><RotateTransform Angle="22" /><TranslateTransform x:Name="Bit2Shift" /></TransformGroup></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bit3" Width="8" Height="4" RadiusX="2" RadiusY="2" Opacity="0" Canvas.Left="6" Canvas.Top="-17" Fill="{DynamicResource SelectedBrush}">
                                    <Rectangle.RenderTransform><TransformGroup><RotateTransform Angle="-12" /><TranslateTransform x:Name="Bit3Shift" /></TransformGroup></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bit4" Width="8" Height="4" RadiusX="2" RadiusY="2" Opacity="0" Canvas.Left="38" Canvas.Top="-12" Fill="{DynamicResource SelectedSheenBrush}">
                                    <Rectangle.RenderTransform><TransformGroup><RotateTransform Angle="38" /><TranslateTransform x:Name="Bit4Shift" /></TransformGroup></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bit5" Width="8" Height="4" RadiusX="2" RadiusY="2" Opacity="0" Canvas.Left="-46" Canvas.Top="10" Fill="{DynamicResource StripeAccentBrush}">
                                    <Rectangle.RenderTransform><TransformGroup><RotateTransform Angle="34" /><TranslateTransform x:Name="Bit5Shift" /></TransformGroup></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bit6" Width="8" Height="4" RadiusX="2" RadiusY="2" Opacity="0" Canvas.Left="-12" Canvas.Top="13" Fill="{DynamicResource SelectedBrush}">
                                    <Rectangle.RenderTransform><TransformGroup><RotateTransform Angle="-20" /><TranslateTransform x:Name="Bit6Shift" /></TransformGroup></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bit7" Width="8" Height="4" RadiusX="2" RadiusY="2" Opacity="0" Canvas.Left="22" Canvas.Top="12" Fill="{DynamicResource StripeBrush}">
                                    <Rectangle.RenderTransform><TransformGroup><RotateTransform Angle="26" /><TranslateTransform x:Name="Bit7Shift" /></TransformGroup></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bit8" Width="8" Height="4" RadiusX="2" RadiusY="2" Opacity="0" Canvas.Left="48" Canvas.Top="4" Fill="{DynamicResource SelectedSheenBrush}">
                                    <Rectangle.RenderTransform><TransformGroup><RotateTransform Angle="-32" /><TranslateTransform x:Name="Bit8Shift" /></TransformGroup></Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Confetti" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.6" />
                            <Setter TargetName="Lip" Property="Background" Value="{DynamicResource StripeDeepBrush}" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.5" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.502" KeySpline="0.1,0.7 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.502" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Confetti" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Lip" Property="Background" Value="{DynamicResource StripeDeepBrush}" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.38" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="0,3,0,1" />
                            <Setter TargetName="Lip" Property="Margin" Value="0,4,0,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="HoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="FaceShift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ChevronShift" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="SweepX" Storyboard.TargetProperty="X" From="-70" To="300" Duration="0:0:0.6">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bit1" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Bit1Shift" Storyboard.TargetProperty="X" From="6" To="-6" Duration="0:0:0.55"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
