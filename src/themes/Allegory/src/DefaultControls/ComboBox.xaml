<!--
    Allegory: ComboBox. The closed box is the white selected segment of the game's Settings rows: a paper plate with a slanted left end
    (LocalSlantPlateTemplate), ink Gelasio label, a 30px chevron cell on the right (IconDropDown in ink) set off by a faint ink hairline.
    Hover sweeps a 2px crimson underline in from the left; keyboard focus and an open list hold it. The chevron turns over while the list is
    open. The list is the shared board (LocalAllegoryMenuBoardTemplate, ContextMenu.xaml) and drops in like the menus; rows are the menu
    rows: 30px, the crimson dry-brush band sweeping in on highlight with ink text, and the chosen item carries the paper rank diamond
    (LocalMenuCheckTemplate) in the icon column. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource LocalInkBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource LocalPaperBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalCrimsonBrush}" />
        <Setter Property="Padding" Value="18,3,4,3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <!-- value box: the paper segment plate (Background), slanted left end -->
                        <Control x:Name="Face" Template="{DynamicResource LocalSlantPlateTemplate}" Background="{TemplateBinding Background}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Grid Background="Transparent">
                                        <!-- chevron cell: 30px wide over the plate, a faint ink hairline on its left edge -->
                                        <Grid Width="30" HorizontalAlignment="Right" IsHitTestVisible="False">
                                            <Rectangle Width="1" Margin="0,7,0,7" HorizontalAlignment="Left" Fill="{DynamicResource LocalInkBrush}" Opacity="0.25" />
                                            <ContentControl x:Name="Chevron" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Focusable="False" IsTabStop="False" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                                                            Foreground="{DynamicResource LocalInkBrush}"
                                                            Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconTemplate}">
                                                <ContentControl.RenderTransform>
                                                    <RotateTransform x:Name="ChevronTurn" />
                                                </ContentControl.RenderTransform>
                                            </ContentControl>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard x:Name="ChevronOpen">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard x:Name="ChevronClose">
                                                    <Storyboard FillBehavior="Stop">
                                                        <DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- the crimson underline: hover sweeps HoverRim in; keyboard focus and an open list hold FocusRim (separate layers, so the hover exit never flickers a held line) -->
                        <Border x:Name="HoverRim" Height="2" Margin="1,0,0,0" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False" Background="{TemplateBinding BorderBrush}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="HoverRimScale" ScaleX="1" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="FocusRim" Height="2" Margin="1,0,0,0" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False" Background="{TemplateBinding BorderBrush}" />
                        <!-- 38px on the right for the chevron cell (30px) plus 8px of air -->
                        <Border Margin="0,0,38,0" IsHitTestVisible="False">
                            <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        </Border>
                        <TextBox x:Name="PART_EditableTextBox" MinHeight="0" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 Margin="10,0,38,0" Focusable="True" BorderThickness="0" Background="Transparent"
                                 Style="{DynamicResource BareTextBox}" Padding="8,0,8,0"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" Foreground="{DynamicResource LocalInkBrush}" CaretBrush="{DynamicResource LocalInkBrush}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               VerticalOffset="2" Focusable="False" AllowsTransparency="True">
                            <Grid x:Name="ListBoard" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="ListRise" />
                                </Grid.RenderTransform>
                                <Control Template="{DynamicResource LocalAllegoryMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                                <ScrollViewer Margin="0,6,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RimHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="HoverRimScale" Storyboard.TargetProperty="ScaleX" From="0.1" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RimHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="FocusRim" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ListRiseIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ListBoard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ListRise" Storyboard.TargetProperty="Y" From="-6" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="ListRiseIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Opacity" Value="1" TargetName="FocusRim" />
                        </MultiTrigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="ContentSite" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid x:Name="ListRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="ListHover" Template="{DynamicResource LocalMenuBandTemplate}" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                                 Focusable="False" IsTabStop="False" Background="{DynamicResource MenuItemHoverBrush}" RenderTransformOrigin="0,0.5">
                            <Control.RenderTransform>
                                <ScaleTransform x:Name="ListBandScale" ScaleX="1" />
                            </Control.RenderTransform>
                        </Control>
                        <Grid Margin="9,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="33" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- chosen: the paper rank diamond -->
                            <Control x:Name="ListCheck" Template="{DynamicResource LocalMenuCheckTemplate}" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Foreground="{TemplateBinding Foreground}" Visibility="Collapsed" Focusable="False" IsTabStop="False" />
                            <ContentPresenter x:Name="ListLabel" Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="ListCheck" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ListHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                                        <DoubleAnimation Storyboard.TargetName="ListBandScale" Storyboard.TargetProperty="ScaleX" From="0.15" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.25" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ListHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" TargetName="ListRow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
