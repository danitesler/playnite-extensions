<!--
    Allegory: Button. The game's prompt plate. Plain buttons are an ink strip with a slanted left end and a hairline underline, paper Gelasio label;
    hover fades the paper plate in (label turns ink) and nudges it 2px to the right; pressed drops it to segment grey. The default button (Save, OK)
    is the paper plate at rest; on hover a crimson dry-brush band sweeps in behind it from the left and bleeds past both ends, the selected-command
    splash of the Player menu. Animations run from the template triggers only, on named transforms. Keeps Default's Width == 41 trigger for
    ThemeModifier's icon buttons (32x32 by layout scaling).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" /> <!-- fixed-width buttons (ThemeModifier icon buttons) keep their glyph unclipped; auto-width ones get the padding below -->
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True" Background="Transparent">
                        <!-- Default button hover: the crimson band behind the plate, swept in from the left. -->
                        <Rectangle x:Name="Sweep" Margin="-14,-9,-28,-9" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0,0.5"
                                   Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" OpacityMask="{DynamicResource LocalBrushBandShortMask}">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="SweepScale" ScaleX="1" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Control x:Name="Face" Template="{DynamicResource LocalStripTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <Control x:Name="HoverFace" Template="{DynamicResource LocalSlantPlateTemplate}" Background="{DynamicResource ButtonHoverBackgroundBrush}"
                                 Opacity="0" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                            <Control.RenderTransform>
                                <TranslateTransform x:Name="HoverNudge" />
                            </Control.RenderTransform>
                        </Control>
                        <ContentPresenter x:Name="Content" IsHitTestVisible="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="ContentNudge" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ButtonHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverFace" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="HoverNudge" Storyboard.TargetProperty="X" From="-3" To="2" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ContentNudge" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ButtonHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverFace" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverNudge" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ContentNudge" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverFace" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Face" Property="Template" Value="{DynamicResource LocalSlantPlateTemplate}" />
                            <Setter TargetName="HoverFace" Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="DefaultSweepIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SweepScale" Storyboard.TargetProperty="ScaleX" From="0.2" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.25" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="DefaultSweepIn" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HoverFace" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <!-- ThemeModifier icon buttons: the plugin sets Width=41 on them (editor and constants tabs).
                 Render at 32x32 via uniform 32/41 layout scaling, including glyphs and decoration; auto-width buttons keep ButtonPadding. -->
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Width" Value="NaN">
                <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
