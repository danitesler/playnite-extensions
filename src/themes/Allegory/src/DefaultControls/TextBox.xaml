<!--
    Allegory: TextBox. The game's prompt strip: an ink well (InputBackgroundBrush) with a 1px hairline underline, paper text, crimson
    selection. Hover brightens the underline to paper; keyboard focus draws a 2px paper underline. No radius, no frame around the sides.
    MinHeight is ControlHeight and Padding is applied once, by the content host. BareTextBox has no chrome (search box, editable dropdown).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LocalSlashFieldTemplate: the menus' slashes and crimson dry brush. One slanted paper slash sits in the 16px left
        inset at rest, half lit. Hover: it lights fully and a second slash joins it. Keyboard focus: both slashes turn
        crimson and a dry-brush crimson streak (three bristle lines of different lengths) wipes along the bottom
        (0.24s). State is read from the nearest Control above; no desired size.
    -->
    <ControlTemplate x:Key="LocalSlashFieldTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle x:Name="Brush" Height="4" VerticalAlignment="Bottom" Margin="1,0,1,1" Fill="{DynamicResource SelectedBrush}" RenderTransformOrigin="0,0.5">
                <Rectangle.OpacityMask>
                    <DrawingBrush Stretch="Fill">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#00000000" Geometry="M0,0 H100 V4 H0 Z" />
                                <GeometryDrawing Brush="#FF000000" Geometry="M0,0 H74 L71,1 H0 Z M0,1.5 H100 L97,2.5 H0 Z M0,3 H57 L54,4 H0 Z" />
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.OpacityMask>
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="BrushScale" ScaleX="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Slash1" Width="2" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                       Fill="{DynamicResource FocusBrush}" Opacity="0.55">
                <Rectangle.RenderTransform><SkewTransform AngleX="-22" CenterY="7" /></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Slash2" Width="2" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"
                       Fill="{DynamicResource FocusBrush}" Visibility="Collapsed">
                <Rectangle.RenderTransform><SkewTransform AngleX="-22" CenterY="5" /></Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <Setter TargetName="Slash1" Property="Opacity" Value="1" />
                <Setter TargetName="Slash2" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Slash1" Property="Opacity" Value="1" />
                <Setter TargetName="Slash1" Property="Fill" Value="{DynamicResource SelectedBrush}" />
                <Setter TargetName="Slash2" Property="Visibility" Value="Visible" />
                <Setter TargetName="Slash2" Property="Fill" Value="{DynamicResource SelectedBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Swipe">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="BrushScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Swipe" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid x:Name="Border" SnapsToDevicePixels="True" Background="Transparent">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False" />
                        <Border x:Name="HoverRim" Height="1" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource InputHoverBorderBrush}" />
                        <Border x:Name="FocusRim" Height="2" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource FocusBrush}" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        <Control x:Name="FieldOverlay" Template="{DynamicResource LocalSlashFieldTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="HoverRim" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                            <Setter Property="Opacity" Value="1" TargetName="FocusRim" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless text box for hosts that draw their own chrome (search box, editable dropdown). -->
    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
