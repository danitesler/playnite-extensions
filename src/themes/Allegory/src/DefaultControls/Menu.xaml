<!--
    Overlay on Playnite Default/DefaultControls/Menu.xaml. Every popup menu (hamburger menu, top bar dropdowns, game and group menus,
    tray) is the Allegory board from ContextMenu.xaml (LocalAllegoryMenuBoardTemplate), drawn from Metaphor: ReFantazio's System menu.
    Menu signature (docs/themes/menus.md levers):
    - Rows: 30px, a fixed 33px icon column (16px icon) ending at the board's vertical hairline, a plain star label column (Gelasio 14,
      paper), a shared shortcut column and the submenu mark on the right edge.
    - Highlight: a crimson dry-brush band (LocalMenuBandTemplate, the short band mask) that sweeps in from the left (ScaleX 0.15 to 1,
      BackEase, 180ms) while the label nudges 4px right; label, shortcut and marks turn ink (icon through TextElement.Foreground on
      TargetName="Icon"). Out in 140ms.
    - Group break: 9px, a hairline from the label edge to the right with a small paper diamond (the quest rank pip) sitting on the vertical rule.
    - Shortcuts: Playfair Display SC Bold 12px, muted, at the right edge (the game's small caps captions).
    - Submenu mark: LocalMenuArrowTemplate, the settings rows' small triangle; an open submenu holds the band (setter, no animation).
    - Checked rows: LocalMenuCheckTemplate, a paper diamond in the icon column.
      Exit (Alt+Q): label in LocalCrimsonLitBrush (5.9:1 on the board); highlighted it is a deep crimson band (DangerBrush) with a paper label.
    Roles: TopLevelHeader and TopLevelItem (a horizontal Menu bar), SubmenuHeader and SubmenuItem (every popup menu).
    The Separator and MenuItem.SeparatorStyleKey are both redefined (the Default one points at its own sibling).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Group break: 9px; a hairline from the label edge, the rank diamond on the board's vertical rule. -->
    <ControlTemplate x:Key="LocalMenuBreakTemplate" TargetType="Control">
        <Grid Height="9" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Height="1" Margin="42,0,12,0" VerticalAlignment="Center" Background="{DynamicResource MenuSeparatorBrush}" />
            <Path Width="7" Height="7" Margin="31,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Fill"
                  Data="M0.5,0 L1,0.5 L0.5,1 L0,0.5 Z" Fill="{DynamicResource LocalPaperBrush}" Opacity="0.7" />
        </Grid>
    </ControlTemplate>
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Foreground" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource LocalMenuBreakTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Foreground" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource LocalMenuBreakTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- SubmenuItem: a plain row. -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <Control x:Name="MenuHover" Template="{DynamicResource LocalMenuBandTemplate}" Visibility="Collapsed" IsHitTestVisible="False"
                     Focusable="False" IsTabStop="False" Background="{DynamicResource MenuItemHoverBrush}" RenderTransformOrigin="0,0.5">
                <Control.RenderTransform>
                    <ScaleTransform x:Name="MenuBandScale" ScaleX="1" />
                </Control.RenderTransform>
            </Control>
            <Grid Margin="9,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="33" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" TextElement.Foreground="{DynamicResource TextBrushDarker}" />
                <Control x:Name="GlyphPanel" Template="{DynamicResource LocalMenuCheckTemplate}" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Foreground="{DynamicResource LocalPaperBrush}" Visibility="Collapsed" Focusable="False" IsTabStop="False" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MenuLabelNudge" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <TextBlock x:Name="GestureText" Grid.Column="2" Margin="16,0,0,1" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource LocalCapsFontFamily}" FontWeight="Bold" FontSize="12"
                           Foreground="{DynamicResource TextBrushDarker}" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GestureText" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="GestureText" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource LocalCrimsonLitBrush}" TargetName="MenuLabel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource LocalCrimsonLitBrush}" TargetName="Icon" />
                <Setter Property="Background" Value="{DynamicResource DangerBrush}" TargetName="MenuHover" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="GestureText" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="GlyphPanel" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.05" />
                            <DoubleAnimation Storyboard.TargetName="MenuBandScale" Storyboard.TargetProperty="ScaleX" From="0.15" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.25" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuLabelNudge" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="MenuLabelNudge" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <!-- Paper on the deep crimson band (7.2:1). -->
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="GestureText" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Icon" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- SubmenuHeader: a row that opens a submenu. The band is held (setter) while it is open; its popup is the same board and drops in. -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <Control x:Name="MenuHeld" Template="{DynamicResource LocalMenuBandTemplate}" Visibility="Collapsed" IsHitTestVisible="False"
                     Focusable="False" IsTabStop="False" Background="{DynamicResource MenuItemHoverBrush}" />
            <Control x:Name="MenuHover" Template="{DynamicResource LocalMenuBandTemplate}" Visibility="Collapsed" IsHitTestVisible="False"
                     Focusable="False" IsTabStop="False" Background="{DynamicResource MenuItemHoverBrush}" RenderTransformOrigin="0,0.5">
                <Control.RenderTransform>
                    <ScaleTransform x:Name="MenuBandScale" ScaleX="1" />
                </Control.RenderTransform>
            </Control>
            <Grid Margin="9,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="33" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" TextElement.Foreground="{DynamicResource TextBrushDarker}" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MenuLabelNudge" />
                    </TextBlock.RenderTransform>
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <Control x:Name="MenuArrow" Grid.Column="3" Template="{DynamicResource LocalMenuArrowTemplate}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,2,0"
                         Foreground="{DynamicResource TextBrushDarker}" Focusable="False" IsTabStop="False" />
            </Grid>
            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                   HorizontalOffset="6" VerticalOffset="-6" Focusable="False" AllowsTransparency="True">
                <Grid x:Name="SubBoard" MinWidth="212" SnapsToDevicePixels="True">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SubDrop" />
                    </Grid.RenderTransform>
                    <Control Template="{DynamicResource LocalAllegoryMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="0,6,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="MenuHeld" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuArrow" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubDropIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SubBoard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SubDrop" Storyboard.TargetProperty="Y" From="-6" To="0" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SubDropIn" />
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuArrow" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.05" />
                            <DoubleAnimation Storyboard.TargetName="MenuBandScale" Storyboard.TargetProperty="ScaleX" From="0.15" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.25" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuLabelNudge" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="MenuLabelNudge" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- TopLevelHeader: a horizontal menu bar entry; highlighted it sits on the crimson band with ink text. -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="Border" Background="Transparent">
            <Control x:Name="TopPlate" Visibility="Collapsed" Template="{DynamicResource LocalMenuBandTemplate}" Background="{DynamicResource MenuItemHoverBrush}"
                     Focusable="False" IsTabStop="False" />
            <TextBlock x:Name="TopLabel" VerticalAlignment="Center" Padding="12,5" Style="{DynamicResource BaseTextBlockStyle}"
                       Foreground="{TemplateBinding Foreground}">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </TextBlock>
            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                <Grid MinWidth="212" Margin="0,4,0,0" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalAllegoryMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <StackPanel Margin="0,6,0,5" Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="TopPlate" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="TopLabel" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- TopLevelItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Style="{DynamicResource PopupBorder}">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>
    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="true" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
