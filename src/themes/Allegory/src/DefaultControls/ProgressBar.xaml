<!--
    Allegory: ProgressBar. The game's HP / MP gauge: a flat track at 22% paper (ProgressBarTrackBrush) filled with crimson (ProgressBarForegroundBrush)
    that carries a 1px paper hairline along its top edge, like the lit edge on the party gauges. The track takes Background, BorderBrush and
    BorderThickness from its host, so a host that sets a Transparent Background (the sidebar items' PART_ProgressStatus) gets a bare track and no rule
    is ever drawn under a sidebar item. No radius.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Margin="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border Background="{TemplateBinding Foreground}" />
                                <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource LocalPaperBrush}" Opacity="0.7" />
                            </Grid>
                        </Border>
                        <Border x:Name="IndeterminateBar" Visibility="Collapsed" Margin="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Foreground}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-0.33" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="0" />
                                    <GradientStop Color="Black" Offset="0.33" />
                                    <GradientStop Color="Transparent" Offset="0.33" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="IndeterminateBar" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateSlide">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateBar"
                                                         Storyboard.TargetProperty="(Border.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.33" To="1" Duration="0:0:3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="IndeterminateSlide" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
