<!--
    Allegory: GroupBox, the Statistics page's card and the settings groups. A content-sized ink well with no frame: the title in Playfair
    Display SC Black (title case gives the enlarged initial, like SKILL / ITEM) with a hairline running out to its right, as the game heads
    its lists. The rule is a plain Border with no width of its own, so the card still sizes to its content (no fixed widths, no stretching
    shapes).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource LocalWellBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HeadingRuleBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border SnapsToDevicePixels="True" Background="{TemplateBinding Background}" Padding="12,10,12,10">
                        <DockPanel>
                            <DockPanel x:Name="HeaderHost" DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Style="{DynamicResource HeadingTextBlock}" VerticalAlignment="Center">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </TextBlock>
                                <Border Height="1" Margin="10,2,0,0" VerticalAlignment="Center" Background="{TemplateBinding BorderBrush}" IsHitTestVisible="False" />
                            </DockPanel>
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top" Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderHost" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
