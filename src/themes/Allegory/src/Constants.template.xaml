<!--
    Allegory: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Tokens are canvas-sampled from Metaphor: ReFantazio's menus (RESEARCH.md); keys are the shared vocabulary
    (scripts/data/theme-keys.json). Theme XAML reads brushes only, never Color keys.
    Roles: paper = plates, prompts, cards and type; ink = text on paper and on bright brush; crimson = the current item's
    dry-brush band (selection, Play hover, menu highlight); teal = the Settings brush; yellow = the running game (the quest
    in progress); teal and oxblood washes = painted grounds.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Gelasio (body serif) and Playfair Display SC (wide Didone small caps and numerals: title case renders the game's enlarged initials), all bundled. -->
    <sys:Double x:Key="FontSizeSmall">{{px:size-small}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:size-body}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:size-lead}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:size-title}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:size-display}}</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Gelasio, {{text:font-body|Georgia}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Playfair Display SC Black, {{text:font-display|Georgia}}</FontFamily>
    <FontFamily x:Key="LocalDisplayFontFamily">./Typography/#Playfair Display SC Black, {{text:font-display|Georgia}}</FontFamily>
    <FontFamily x:Key="LocalCapsFontFamily">./Typography/#Playfair Display SC, {{text:font-caps|Georgia}}</FontFamily>

    <!-- Usable metadata content width; apply inside the pane's horizontal padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape: no radii anywhere (the menus cut plates with a slanted end instead); 1px hairlines. -->
    <Thickness x:Key="PopupBorderThickness">{{px:stroke-hair}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:stroke-hair}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:stroke-hair}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:corner-medium}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:corner-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:corner-none}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:corner-none}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{text}}</Color>
    <Color x:Key="TextColorDarker">{{text-muted}}</Color>
    <Color x:Key="TextColorDark">{{ink}}</Color>
    <Color x:Key="MainColor">{{panel}}</Color>
    <Color x:Key="MainColorDark">{{ground-deep}}</Color>
    <Color x:Key="HoverColor">{{teal-lift}}</Color>
    <Color x:Key="GlyphColor">{{crimson}}</Color>
    <Color x:Key="HighlightGlyphColor">{{crimson/40}}</Color>
    <Color x:Key="PopupBackgroundColor">{{panel}}</Color>
    <Color x:Key="PopupBorderColor">{{board-rule-40}}</Color>
    <Color x:Key="BackgroundToneColor">{{ground-deep}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{rule-28}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{rule-22}}</Color>
    <Color x:Key="DataChangeNotifColor">{{crimson}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{rule-55}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{mint}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{crimson-lit}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{yellow}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{yellow}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{ground-deep}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{ground}}" />

    <!-- Shared keys: roles outside the Playnite palette. ThemeModifier lists those opted in through the shared catalog. -->
    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{ground}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{ground}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{ground}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{ink/72}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{paper}}" />
    <!-- Game page: banner darkening is the teal ground, the colour the game's menus paint over everything. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{teal-wash}}" />
    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{crimson}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{crimson-lit}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{yellow}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{teal-lift}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{crimson}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{crimson}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{crimson-deep}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{paper}}" />
    <!-- Buttons: plain = ink strip with a white underline; primary = the white prompt plate. -->
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{seg}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{crimson}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{paper-dim}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{paper}}" />
    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{ink/72}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{paper}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{rule-80}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{rule-28}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{crimson}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{crimson}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{rule-22}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{rule-45}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{paper/30}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{rule-45}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{crimson}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{rule-60}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{paper/12}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{paper}}" />
    <!-- Popups and plates -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{board-rule-30}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{ground}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{rule-70}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{rule-50}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{text-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{rule-40}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{rule-40}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{rule-45}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{rule-22}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{blue}}" />

    <!-- Theme-only (Local prefix: no ThemeModifier entry, no shared meaning). -->
    <SolidColorBrush x:Key="LocalInkBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="LocalInkBoxBrush" Color="{{ink-box}}" />
    <SolidColorBrush x:Key="LocalPanelBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="LocalGroundBrush" Color="{{ground}}" />
    <SolidColorBrush x:Key="LocalGroundDeepBrush" Color="{{ground-deep}}" />
    <SolidColorBrush x:Key="LocalTealWashBrush" Color="{{teal-wash}}" />
    <SolidColorBrush x:Key="LocalTealLiftBrush" Color="{{teal-lift}}" />
    <SolidColorBrush x:Key="LocalOxbloodBrush" Color="{{oxblood}}" />
    <SolidColorBrush x:Key="LocalOxbloodMidBrush" Color="{{oxblood-mid}}" />
    <SolidColorBrush x:Key="LocalPaperBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="LocalPaperDimBrush" Color="{{paper-dim}}" />
    <SolidColorBrush x:Key="LocalSegBrush" Color="{{seg}}" />
    <SolidColorBrush x:Key="LocalGraphiteBrush" Color="{{graphite}}" />
    <SolidColorBrush x:Key="LocalGhostBrush" Color="{{ghost}}" />
    <SolidColorBrush x:Key="LocalSlateBrush" Color="{{slate}}" />
    <SolidColorBrush x:Key="LocalMutedBrush" Color="{{text-muted}}" />
    <SolidColorBrush x:Key="LocalCrimsonBrush" Color="{{crimson}}" />
    <SolidColorBrush x:Key="LocalCrimsonDeepBrush" Color="{{crimson-deep}}" />
    <SolidColorBrush x:Key="LocalCrimsonLitBrush" Color="{{crimson-lit}}" />
    <SolidColorBrush x:Key="LocalTealBrush" Color="{{teal}}" />
    <SolidColorBrush x:Key="LocalTealDeepBrush" Color="{{teal-deep}}" />
    <SolidColorBrush x:Key="LocalOrangeBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="LocalYellowBrush" Color="{{yellow}}" />
    <SolidColorBrush x:Key="LocalBlueBrush" Color="{{blue}}" />
    <SolidColorBrush x:Key="LocalMagentaBrush" Color="{{magenta}}" />
    <SolidColorBrush x:Key="LocalMintBrush" Color="{{mint}}" />
    <!-- Hairlines: white at fixed strengths, flattened onto the ground so they stay crisp. -->
    <SolidColorBrush x:Key="LocalRuleFaintBrush" Color="{{rule-14}}" />
    <SolidColorBrush x:Key="LocalRuleBrush" Color="{{rule-30}}" />
    <SolidColorBrush x:Key="LocalRuleStrongBrush" Color="{{rule-55}}" />
    <SolidColorBrush x:Key="LocalWatermarkBrush" Color="{{paper/16}}" />
    <SolidColorBrush x:Key="LocalHairlineBrush" Color="{{paper/40}}" />
    <SolidColorBrush x:Key="LocalWellBrush" Color="{{ink/72}}" />
</ResourceDictionary>
