<!--
    Allegory: SearchBox. The game's prompt strip ("Which item?"): an ink strip with a slanted left end and a hairline underline
    (LocalStripTemplate). Hover brightens the underline; keyboard focus draws a 2px paper underline. The quill magnifier lives outside
    PART_SeachIcon so it stays while typing: muted when empty, GlyphBrush when focused or filled. The clear button keeps a transparent
    hit area around the glyph. Keeps PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid x:Name="Field" Background="Transparent">
                        <Control x:Name="Plate" Template="{DynamicResource LocalStripTemplate}" Background="{DynamicResource InputBackgroundBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" Focusable="False" IsTabStop="False" />
                        <Border x:Name="HoverRim" Height="1" Margin="1,0,0,0" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource InputHoverBorderBrush}" />
                        <Border x:Name="FocusRim" Height="2" Margin="1,0,0,0" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource FocusBrush}" />
                        <ContentControl x:Name="Glyph" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" Focusable="False" IsTabStop="False"
                                        Width="16" Height="16" Foreground="{DynamicResource GlyphBrush}" Margin="16,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" />
                        <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                        <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                 Padding="40,0,30,0" VerticalContentAlignment="Center" />
                        <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,6,0" Cursor="Hand"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ContentControl.Template>
                                <ControlTemplate TargetType="ContentControl">
                                    <Border Background="Transparent" Padding="6,4">
                                        <ContentPresenter ContentSource="Content" />
                                    </Border>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverRim" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- Keep the magnifier visible while Playnite hides its placeholder: muted when empty, GlyphBrush when filled or focused
                             (SearchGlyphRegressionTests pins both colours to TextBrushDarker and GlyphBrush). -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRim" Property="Opacity" Value="1" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
