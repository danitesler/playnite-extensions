<!--
    Overlay on Playnite Default/DerivedStyles/DetailsViewGroupStyle.xaml.
    Group header of the details list, no plate: the group name in Playfair Display SC Black at FontSizeLarge (title case gives the enlarged
    initial, like INSTALLED), its count as the game's item counter (x12, Playfair Display SC Bold, muted), and a white hairline running out
    to the right edge. The expander arrow comes from DefaultControls/Expander.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailsViewGroupStyle" TargetType="{x:Type GroupItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupItem}">
                    <ExpanderEx BorderThickness="0" SaveGameGroupId="{Binding Name, Mode=OneWay}"
                                IsExpanded="True" Background="Transparent">
                        <ExpanderEx.Header>
                            <DockPanel Background="Transparent">
                                <DockPanel.ContextMenu>
                                    <GameGroupMenu />
                                </DockPanel.ContextMenu>
                                <TextBlock DockPanel.Dock="Left"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           TextAlignment="Center" Margin="0,0,5,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                                            <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
                                            <Setter Property="Text" Value="{Binding Name, Converter={StaticResource ObjectToStringConverter}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Name, Converter={StaticResource ObjectToStringConverter}}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="{DynamicResource LOCNone}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Name, Converter={StaticResource ObjectToStringConverter}}" Value="">
                                                    <Setter Property="Text" Value="{DynamicResource LOCNone}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Items.Count, Mode=OneWay, StringFormat='x{0}'}" Margin="4,1,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Style="{DynamicResource BaseTextBlockStyle}" FontFamily="{DynamicResource LocalCapsFontFamily}" FontWeight="Bold"
                                           FontSize="{DynamicResource FontSize}"
                                           Foreground="{DynamicResource TextBrushDarker}"
                                           DockPanel.Dock="Left" TextAlignment="Center"
                                           Visibility="{Settings ShowGroupCount}"/>
                                <Border Height="1" Margin="12,2,0,0" VerticalAlignment="Center" Background="{DynamicResource HeadingRuleBrush}" IsHitTestVisible="False" />
                            </DockPanel>
                        </ExpanderEx.Header>
                        <ItemsPresenter />
                    </ExpanderEx>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
