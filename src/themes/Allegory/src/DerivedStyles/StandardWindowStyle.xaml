<!--
    Allegory: StandardWindowStyle. Every dialog and the Settings window, drawn from the game's Settings and System menus: a 44px ink title band
    (HeaderBandBrush) closed by the Load list's doubled hairline (faint over strong). At the left the Allegory mark (28px, paper) and the title in
    Playfair Display SC Black 20px (title case gives the enlarged initial, like SETTINGS); at the right, behind the caption buttons, the menus'
    compass: two hairline rings cropped by the band and a long diagonal stroke through them. Behind the content, the game's giant cropped section
    title: the window's title in Playfair Display SC Black 132px at about 6% paper, bleeding off the bottom-right corner (hosted in a zero-size
    Canvas, so it never widens a dialog). The caption buttons are WindowBarButton (button prompts; close = deep crimson disc).
    CaptionHeight 44 equals the content's top margin. PART_TextTitle stays inside a collapsed parent: Playnite sets its Text and it must never
    draw by itself. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- The giant cropped title behind the content (zero-size Canvas pinned to the bottom-right corner). -->
                                <Grid Margin="0,44,0,0" ClipToBounds="True" IsHitTestVisible="False">
                                     <Rectangle Fill="{DynamicResource LocalInkBrush}" Opacity="0.75" OpacityMask="{DynamicResource LocalBrushWashMask}" IsHitTestVisible="False" />
<Rectangle Fill="{DynamicResource LocalInkBrush}" Opacity="0.75" OpacityMask="{DynamicResource LocalBrushWashMask}" IsHitTestVisible="False" />
<Rectangle Width="300" Height="300" Margin="0,0,-70,-90" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.05" IsHitTestVisible="False" Fill="{DynamicResource LocalPaperBrush}" OpacityMask="{DynamicResource LocalDraftingArcsMask}" />
                                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="0" Height="0">
                                        <TextBlock Canvas.Right="-28" Canvas.Bottom="-38" Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource HeadingFontFamily}"
                                                   FontSize="132" Foreground="{DynamicResource LocalWatermarkBrush}" Opacity="0.38" TextWrapping="NoWrap" />
                                    </Canvas>
                                </Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource HeaderBandBrush}" ClipToBounds="True">
                                    <!-- Ink splash behind the mark and title (the earlier Metaphor theme header) with its canvas tooth. -->
<Rectangle Fill="{DynamicResource LocalInkBrush}" Opacity="0.75" OpacityMask="{DynamicResource LocalBrushWashMask}" IsHitTestVisible="False" />
<Rectangle Width="170" Height="104" Margin="-22,-32,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.5" IsHitTestVisible="False" Fill="{DynamicResource LocalCrimsonDeepBrush}" OpacityMask="{DynamicResource LocalInkSplashMask}" />
<!-- The compass: two hairline rings and a long diagonal, cropped by the band, behind the caption buttons. Fixed 260px host. -->
                                    <Grid Width="260" HorizontalAlignment="Right" ClipToBounds="True" IsHitTestVisible="False">
                                        <Canvas>
                                            <Ellipse Canvas.Left="64" Canvas.Top="-62" Width="150" Height="150" Stroke="{DynamicResource LocalRuleStrongBrush}" StrokeThickness="1" />
                                            <Ellipse Canvas.Left="86" Canvas.Top="-40" Width="106" Height="106" Stroke="{DynamicResource LocalRuleBrush}" StrokeThickness="1" />
                                            <Rectangle Canvas.Left="40" Canvas.Top="-30" Width="1" Height="150" Fill="{DynamicResource LocalRuleStrongBrush}">
                                                <Rectangle.RenderTransform>
                                                    <RotateTransform Angle="-58" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                            <Path Canvas.Left="136" Canvas.Top="18" Width="6" Height="6" Stretch="Fill" Data="M0.5,0 L1,0.5 L0.5,1 L0,0.5 Z" Fill="{DynamicResource LocalCrimsonBrush}" />
                                        </Canvas>
                                    </Grid>
                                    <!-- The band's closing rule: the doubled hairline. -->
                                    <Border Height="1" Margin="0,0,0,3" VerticalAlignment="Bottom" Background="{DynamicResource LocalRuleFaintBrush}" IsHitTestVisible="False" />
                                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource LocalRuleStrongBrush}" IsHitTestVisible="False" />
                                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource LocalPaperBrush}" Width="28" Height="28" Margin="0,0,12,0"
                                                     VerticalAlignment="Center" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                            <Grid VerticalAlignment="Center">
                                                <!-- The title lives here only as Playnite's text holder (hidden in a collapsed parent); the visible copy below reads its Text. -->
                                                <Border Visibility="Collapsed" Width="0" Height="0" Opacity="0">
                                                    <TextBlock Text="{TemplateBinding Title}" Foreground="Transparent" x:Name="PART_TextTitle" />
                                                </Border>
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="20"
                                                           Foreground="{DynamicResource HeadingForegroundBrush}" MaxWidth="460" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                        <Border />
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
