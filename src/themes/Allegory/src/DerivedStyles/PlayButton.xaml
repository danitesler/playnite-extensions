<!--
    Allegory: Play, the game's selected command. Structure: Playnite Default 10.60 (PlayButton); every Default state is kept.
    Plate: the MONEY / prompt plate, flat paper (PrimaryButtonBackgroundBrush) with a slanted left end (LocalSlantPlateTemplate), no radius,
    no shadow. The label is Playfair Display SC Black 19px in ink (title case gives the enlarged initial: PLAY), and a quill play glyph
    sits in its own 22px column on the right (MarkHost).
    Hover (hero, both ways; only while the game is not launching or running): the Player menu's splash. A crimson dry-brush band
    (PrimaryButtonHoverBackgroundBrush through LocalBrushBandMask) sweeps in behind the plate from the left with a small overshoot
    (360ms, BackEase), bleeding past both ends; a mint flick shows under its head and a crimson splatter lands above its tail; the plate
    nudges 3px right on top of it. Press has its own layer: the plate drops to segment grey.
    PART_ButtonContextAction (Tag ContextAction) is the same paper plate without the glyph column.
    Launching and running: the plate fills with RunningIndicatorBrush (the quest-in-progress yellow) with ink text; the play glyph steps aside
    for the Archetype compass (an ink hairline ring whose needle turns: 1.2s a turn while launching, 4s while running). Launching: a paper band
    sweeps the plate. Running: a RunningBreath scrim breathes over it. The mark owns its own column (MarkHost), so the label (PlayRoom) never
    meets it. The RUNNING label shows Cancel only while the button itself is hovered (RelativeSource Self); the hover splash stays off while it runs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite swaps Play for the
        context action (RUNNING). The overlay copies the plate's own slanted outline: a 2px yellow outline 3px outside it (RunningFrame, a
        stretched Path), a faint wash on the face, and a foot line under the plate that fills with the running colour as a progress bar.
        Launching: the foot fills in step with the sweep on the plate (1.6s loop). Running: the outline breathes 0.72 to 1 (3.2s) and the foot
        stays full. The compass lives on the plate itself. DataContext is Playnite's GameDetailsViewModel.
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Control x:Name="RunningWash" Template="{DynamicResource LocalSlantPlateTemplate}" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12"
                                 Focusable="False" IsTabStop="False" />
                        <Grid x:Name="RunningFoot" Height="2" Margin="0,0,0,-6" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Path x:Name="RunningFrame" Margin="-4,-3,-3,-3" Stretch="Fill" Data="M14,0 L200,0 L200,48 L0,48 Z"
                              Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot fills once (the sweep has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="24,0,12,0" />
        <Setter Property="FontFamily" Value="{DynamicResource LocalDisplayFontFamily}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="MinWidth" Value="176" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- The hover splash behind the plate: mint flick, crimson dry-brush band, splatter at the tail. Swept in from the left. -->
                        <Grid x:Name="HoverSweep" Visibility="Collapsed" Opacity="0" Margin="-36,-22,-60,-22" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SweepScale" ScaleX="1" />
                            </Grid.RenderTransform>
                            <Rectangle Width="200" Height="18" Margin="20,0,0,12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                       Fill="{DynamicResource LocalMintBrush}" OpacityMask="{DynamicResource LocalBrushFlickMask}" Opacity="0.85">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="-4" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" OpacityMask="{DynamicResource LocalBrushBandMask}" />
                            <Rectangle x:Name="Splatter" Width="66" Height="66" Margin="0,-14,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0"
                                       Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" OpacityMask="{DynamicResource LocalSplatterMask}" />
                        </Grid>
                        <!-- The plate: paper, pressed and running layers, then the content. The whole face nudges right on hover. -->
                        <Grid x:Name="Face" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="FaceNudge" />
                            </Grid.RenderTransform>
                            <Control x:Name="Plate" Template="{DynamicResource LocalSlantPlateTemplate}" Background="{TemplateBinding Background}" Focusable="False" IsTabStop="False" />
                            <Control x:Name="PressedPlate" Template="{DynamicResource LocalSlantPlateTemplate}" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0" Focusable="False" IsTabStop="False" />
                            <Control x:Name="RunningBreath" Template="{DynamicResource LocalSlantPlateTemplate}" Background="{DynamicResource ScrimBrush}" Opacity="0" Focusable="False" IsTabStop="False" />
                            <Control x:Name="RunningScan" Template="{DynamicResource LocalSlantPlateTemplate}" Visibility="Collapsed" Background="{DynamicResource LocalPaperBrush}" Opacity="0.45"
                                     Focusable="False" IsTabStop="False">
                                <Control.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Control.OpacityMask>
                            </Control>
                            <Control x:Name="RunningHoverDim" Template="{DynamicResource LocalSlantPlateTemplate}" Background="{DynamicResource ScrimBrush}" Opacity="0" Focusable="False" IsTabStop="False" />
                            <Grid x:Name="Content" Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- RunningMarkRoom left="0" right="0": the compass owns MarkHost, a column of its own, so the label never meets it. -->
                                <Border x:Name="PlayRoom" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2">
                                    <Grid x:Name="PlayContent">
                                        <ContentPresenter x:Name="PlayLabel" RecognizesAccessKey="True" Content="{TemplateBinding Content}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="CancelLabel" Content="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" TextElement.Foreground="{TemplateBinding Foreground}" />
                                <!-- The quill play glyph at rest; the Archetype compass while the game launches or runs. -->
                                <Grid x:Name="MarkHost" Grid.Column="1" Width="22" Height="22" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Viewbox x:Name="PlayGlyph" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentControl Focusable="False" IsTabStop="False" Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{TemplateBinding Foreground}" />
                                    </Viewbox>
                                    <Grid x:Name="RunningCompass" Visibility="Collapsed">
                                        <Ellipse Margin="1" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" />
                                        <Path Width="4" Height="15" Stretch="Fill" Data="M0.5,0 L1,0.5 L0.5,1 L0,0.5 Z" Fill="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="RunningNeedleTurn" Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="MarkHost" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Padding" Value="22,0,18,0" />
                            <Setter Property="MinWidth" Value="190" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <!-- Hover: only while the game is not launching or running. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverSweep" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverSweep" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="SweepScale" Storyboard.TargetProperty="ScaleX" From="0.15" To="1" Duration="0:0:0.36">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Splatter" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.2" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="FaceNudge" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverSweep" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Splatter" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="FaceNudge" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverSweep" Storyboard.TargetProperty="Visibility" Duration="0:0:0.16">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="PlayHoverIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <!-- Press: its own layer. The plate drops to segment grey. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PressedPlate" Property="Opacity" Value="1" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverSweep" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningCompass" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MarkHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.06" />
                            <Setter Property="Padding" Value="22,0,14,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.4" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.402" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The compass needle spins fast while launching. -->
                                <BeginStoryboard Name="PlayNeedleLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningNeedleTurn" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                                <RemoveStoryboard BeginStoryboardName="PlayNeedleLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverSweep" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningCompass" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MarkHost" Property="Visibility" Value="Visible" />
                            <Setter Property="Padding" Value="22,0,14,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.04" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.16" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.04" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The needle keeps turning, slowly: 4s a turn. -->
                                <BeginStoryboard Name="PlayNeedleRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningNeedleTurn" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                                <RemoveStoryboard BeginStoryboardName="PlayNeedleRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Launching and running keep the plate and fill it with the running yellow, ink text (9.6:1). -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalInkBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalInkBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
