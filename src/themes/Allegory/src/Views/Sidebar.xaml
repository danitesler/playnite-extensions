<!--
    Allegory: left rail, 44px of ink (ShellBackgroundBrush) closed by a 1px white hairline, like the vertical rules that split the
    game's System and Load menus. At its foot a small compass ring with a hairline needle rising out of it, fading upward (sparse
    decor; hidden while the sidebar sits at the top or bottom and while window art is on). The main menu is the animated Allegory
    mark (LocalAllegoryMenuMarkTemplate). The current item sits on a crimson dry-brush dab with an ink glyph (SidebarItem.xaml).
    Colors: ShellBackgroundBrush, MainMenuButtonForegroundBrush, LocalRuleBrush.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <!-- Compass at the rail's foot: two hairline rings and a needle fading upward. Fixed width: nothing here may ask for more than the rail. -->
                            <Grid x:Name="RailCompass" Width="40" Height="150" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Rectangle Width="1" Height="118" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{DynamicResource LocalPaperBrush}">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#00000000" />
                                            <GradientStop Offset="1" Color="#66000000" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Control Width="22" Height="22" Margin="0,0,0,10" VerticalAlignment="Bottom" HorizontalAlignment="Center" Focusable="False" IsTabStop="False"
                                         Template="{DynamicResource LocalRingsTemplate}" Foreground="{DynamicResource LocalRuleStrongBrush}" />
                                <Path Width="5" Height="5" Margin="0,0,0,18.5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Stretch="Fill"
                                      Data="M0.5,0 L1,0.5 L0.5,1 L0,0.5 Z" Fill="{DynamicResource LocalCrimsonBrush}" />
                            </Grid>
                            <!-- Canvas tooth from the earlier Metaphor theme, and a crimson ink splash bleeding in at the top. -->
                            <Rectangle Fill="{DynamicResource LocalInkBrush}" Opacity="0.75" OpacityMask="{DynamicResource LocalBrushWashMask}" IsHitTestVisible="False" />
                            <Canvas IsHitTestVisible="False"><Rectangle Canvas.Left="-30" Canvas.Top="-18" Width="96" Height="72" Opacity="0.2" Fill="{DynamicResource LocalCrimsonDeepBrush}" OpacityMask="{DynamicResource LocalInkSplashMask}" /></Canvas>
                            <Rectangle x:Name="EdgeLine" Width="1" HorizontalAlignment="Right" Fill="{DynamicResource LocalRuleBrush}" IsHitTestVisible="False" />
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="52" Margin="0,0,0,0"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Control x:Name="MenuMark" Template="{DynamicResource LocalAllegoryMenuMarkTemplate}" Focusable="False" IsTabStop="False"
                                             Foreground="{DynamicResource MainMenuButtonForegroundBrush}" />
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailCompass" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailCompass" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="1" TargetName="EdgeLine" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailCompass" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="1" TargetName="EdgeLine" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="EdgeLine" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
