<!--
    Allegory: game page, details view. Generated by art/gen-overviews.mjs; edit the generator, not this file.
    The banner's art ends in a dragged dry-brush edge (a vector Path in the page colour) under a plain gradient; the game's name rises behind
    the header as the menus' giant cropped title (Playfair Display SC Black 150px, paper at 16%, bleeding off the right edge). The title is
    Playfair Display SC Black 34px beside the icon in a hairline frame; Play (the paper prompt plate with the crimson brush splash on hover)
    and the More / Edit ring prompts sit under it. Screenshots and description on the left; the metadata is a borderless ledger on the
    ground with small caps captions, doubled hairline breaks, ink score plates and paper tag chips.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="DetailsViewGameOverview">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DetailsViewGameOverview">
                    <ScrollViewer x:Name="PART_ScrollViewHost" Visibility="Visible" Style="{DynamicResource DetailsScrollViewer}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                        <Grid x:Name="PageRoot" UseLayoutRounding="True">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False" ClipToBounds="True">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                            <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                                <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                    <Setter Property="Height" Value="0" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Opacity="0.7">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.42" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Path Height="58" VerticalAlignment="Bottom" Stretch="Fill" Data="{DynamicResource LocalBannerEdgeGeometry}" Fill="{Binding Background, ElementName=PageRoot}" />
                            </Grid>
                            <StackPanel Margin="30,0,30,30">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border x:Name="DetailsBannerSpacer" MinHeight="30" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 188 / 290'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="30" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
                                                    <Setter Property="Height" Value="30" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Canvas Height="0" IsHitTestVisible="False" ClipToBounds="False">
                                    <TextBlock Canvas.Right="-60" Canvas.Top="-96" Text="{Binding Text, ElementName=PART_TextDisplayName}" FontFamily="{DynamicResource LocalDisplayFontFamily}"
                                               FontSize="150" Foreground="{DynamicResource LocalWatermarkBrush}" TextWrapping="NoWrap" />
                                </Canvas>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0" Padding="3" BorderBrush="{DynamicResource LocalRuleStrongBrush}" BorderThickness="1"
                                            Visibility="{Binding Visibility, ElementName=PART_ImageIcon}">
                                        <Image x:Name="PART_ImageIcon" MaxWidth="52" MaxHeight="52" />
                                    </Border>
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Left" MinHeight="46">
                                        <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource LocalDisplayFontFamily}" FontSize="34" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource HeadingForegroundBrush}" TextWrapping="Wrap" LineHeight="37" LineStackingStrategy="BlockLineHeight" />
                                    </Grid>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Grid MinWidth="176" Height="42" Margin="0,0,22,0">
                                        <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                        <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                        <Control Style="{DynamicResource RunningActionIndicator}" />
                                    </Grid>
                                    <Button x:Name="PART_ButtonMoreActions" Style="{DynamicResource LocalGameActionRing}" Width="40" Height="40" Padding="0" Margin="12,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                        <ContentControl Focusable="False" Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <Button x:Name="PART_ButtonEditGame" Style="{DynamicResource LocalGameActionRing}" Width="40" Height="40" Padding="0" Margin="12,0,0,0" ToolTip="{DynamicResource LOCEditGame}">
                                        <ContentControl Focusable="False" Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </StackPanel>
                                <Grid Margin="0,26,0,0" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 30 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
