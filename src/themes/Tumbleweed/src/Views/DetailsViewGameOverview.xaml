                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel x:Name="PART_ElemNotes">
                                                <StackPanel Margin="0,0,0,14">
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCNotesLabel}" />
    <Border Height="2" Margin="0,6,0,0" Background="{DynamicResource TopPanelSeparatorBrush}" />
</StackPanel>
                                                <TextBox x:Name="PART_TextNotes" Style="{DynamicResource BareTextBox}" IsReadOnly="True"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Padding="0" BorderThickness="0"
                                                         Foreground="{DynamicResource TextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
</Grid>
</Grid>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                        </Grid>
                        <!-- Empty state (no game selected): one of the game's painted header bars (the torn maroon slab of Play)
                             carrying Playnite's "No game is selected", two paint drips running down from it and the flat 2px rule
                             under. The drips are the only motion: they lengthen and recede slowly while the state shows (plain
                             Height loops in the drips' own style, removed on exit). Centered in the page. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Stretch="Fill" SnapsToDevicePixels="False" Fill="{DynamicResource PrimaryButtonBackgroundBrush}"
                                      Data="M 6,0 L 2.2,0 L 3.6,3.5 L 0.6,8 L 2.8,12.5 L 0.2,17 L 2.4,21 L 1,25.5 L 3.4,30 L 0.4,35 L 2,40 L 6,40 Z" />
                                <Border Grid.Column="1" Background="{DynamicResource PrimaryButtonBackgroundBrush}" SnapsToDevicePixels="True">
                                    <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" Margin="16,9" MaxWidth="220" TextAlignment="Center" TextWrapping="Wrap"
                                               FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                               Foreground="{DynamicResource PrimaryButtonForegroundBrush}" />
                                </Border>
                                <Path Grid.Column="2" Stretch="Fill" SnapsToDevicePixels="False" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource PrimaryButtonBackgroundBrush}"
                                      Data="M 6,0 L 2.2,0 L 3.6,3.5 L 0.6,8 L 2.8,12.5 L 0.2,17 L 2.4,21 L 1,25.5 L 3.4,30 L 0.4,35 L 2,40 L 6,40 Z">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="-1" ScaleY="-1" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <Grid Height="34">
                                <Rectangle Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,0,0,0" Fill="{DynamicResource PrimaryButtonBackgroundBrush}">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="DripA">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="4" To="28" Duration="0:0:2.6">
                                                                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="DripA" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Width="3" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="74,0,0,0" Fill="{DynamicResource PrimaryButtonBackgroundBrush}">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="DripB">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True" BeginTime="0:0:1.1">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="4" To="16" Duration="0:0:2.1">
                                                                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="DripB" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </Grid>
                            <Border Height="2" Background="{DynamicResource TopPanelSeparatorBrush}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
