<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details view, right pane).
    A Red Dead Redemption Options page: the black page, the game's art as a banner washed into the menus' red and black
    duotone (the art, then the maroon ArtTintBrush at 50%, faded out downward by the mask and darkened toward the title
    by a black scrim), the title in the title face (HeadingFontFamily) in selection white, then the actions: Play as a
    torn maroon header bar (PlayButton), the context action and More as keycaps (Button.xaml), Edit a 40px keycap shown
    while the pointer is over the header. Steam screenshots host and skeleton, then two columns: description and notes
    as Options sections on the left (a maroon heading over the flat 2px rule, TopPanelSeparatorBrush), and the metadata
    pane on the right as an Options column with no box: the same heading and rule, then every field Playnite can show
    in six groups (progress, scores, about, tags, library, links) split by a 1px rule (WindowPanelSeparatorBrush); a
    group whose fields are all hidden collapses with its rule.
    Captions are FontSizeSmall dim grey in a 112px column beside the value; values are resting-grey body text, text
    links (PropertyItemButton) or square price-tag chips.
    Every PART_ of Playnite's file is kept, each once. HtmlTextView takes Color-typed properties: the brushes are set on
    TextElement.Foreground and Tag and the Colors are bound from them (the one place theme XAML reads a Color).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Section heading: the title face (HeadingFontFamily) at FontSizeLarger in the maroon of the game's Options headers (HeadingForegroundBrush). Used by every overview. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Placeholder for the Steam Screenshots control: a 16:9 main image over a row of five thumbnails, square, in the host's
         Foreground at 15 percent, pulsing. Each Viewbox scales a 1600px layout to the width its column gives it. Host: a
         Control with Foreground set and hit testing off, in a Grid next to the add-on's ContentControl. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="0"
                        Background="{TemplateBinding Foreground}" Opacity="0.15" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="2" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="4" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="6" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="8" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible"
                                  Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible"
                                  d:DesignWidth="1280" d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Grid>
                            <!-- Banner: the game's background art as a band of GameBannerHeight (0 turns it off), washed maroon (ArtTintBrush). Faded out downward by the mask, darkened
                                 toward the title by a page-colored scrim, and cached because it is masked. Collapsed when the game has no background
                                 art or Playnite hides the image. -->
                            <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.CacheMode>
                                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                </Grid.CacheMode>
                                <Grid>
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="Black" Offset="0.25" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                    <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <Border Background="{DynamicResource ArtTintBrush}" Opacity="0.5" />
                                    <Border Background="{DynamicResource ContentBackgroundBrush}" Opacity="0.75">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Transparent" Offset="0.1" />
                                                <GradientStop Color="Black" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                </Grid>
                            </Grid>
                            <Grid HorizontalAlignment="Stretch" MaxWidth="1280" Margin="32,0,32,32">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Room above the title: the title sits low on the banner; the spacer shrinks when there is no banner. -->
                                <Border Grid.Row="0" IsHitTestVisible="False" x:Name="DetailsBannerSpacer" MinHeight="32">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 110 / 360'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                            <Setter Property="Height" Value="32" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="32" />
</DataTrigger>
</Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="0,0,0,24" Background="Transparent">
                                    <!-- Cover, sized by Playnite's cover height setting: square, cached. -->
                                    <Border x:Name="CoverFrame" DockPanel.Dock="Right" Margin="24,0,0,0" VerticalAlignment="Bottom">
                                        <Border.CacheMode>
                                            <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                        </Border.CacheMode>
                                        <Border.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=CoverShape}" />
                                        </Border.OpacityMask>
                                        <Grid>
                                            <Border x:Name="CoverShape" Background="{DynamicResource ExpanderBackgroundBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                                            <Image x:Name="PART_ImageCover"
                                                   Height="{Settings GameDetailsCoverHeight}"
                                                   StretchDirection="Both" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <DockPanel>
                                            <Image x:Name="PART_ImageIcon" MaxHeight="40" MaxWidth="40" DockPanel.Dock="Left" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLargest}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource SelectedForegroundBrush}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" Height="40" MinWidth="140" />
                                                <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" Height="40" MinWidth="140" />
                                                <Control Style="{DynamicResource RunningActionIndicator}" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                                                    ToolTip="{DynamicResource LOCMoreAction}">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                                                Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Margin="8,0,0,0" Focusable="False"
                                                    VerticalAlignment="Center" ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Grid.Row="2" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsPanel" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<Grid Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                        <Border x:Name="DetailsPanel" VerticalAlignment="Top"
                                                Background="Transparent" BorderThickness="0" Padding="0" Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch">
<Border.Style><Style TargetType="Border"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <Border.Resources>
                                                <!-- Values are body text; a TextBlock with Tag="Caption" is the field caption (12px, dim) -->
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Tag" Value="Caption">
                                                    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                            </Border.Resources>
                                            <StackPanel>
                                                <StackPanel Margin="0,0,0,14">
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCGameDetails}" />
    <Border Height="2" Margin="0,6,0,0" Background="{DynamicResource TopPanelSeparatorBrush}" />
</StackPanel>
                                                <!-- The rule of each group is its top border; the wrapper clips the first one (negative margins:
                                                     -(2 x 12 + 1 + 8) on top, -8 at the bottom; change them with the spacing). -->
                                                <Border ClipToBounds="True" x:Name="DetailsMetadataViewport">
                                                    <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-33,0,-8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-33,-24,-8" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                        <Border x:Name="MetaProgress" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCCompletionStatus}" />
                                                                    <Button Grid.Column="1" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCTimePlayed}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextPlayTime" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCLastPlayed}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextLastActivity" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCRecentActivityLabel}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextRecentActivity" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCDateAddedLabel}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextAdded" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCCommunityScore}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCCriticScore}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCUserScore}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                                                                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCDevelopersLabel}" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsDevelopers" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCPublishersLabel}" />
                                                                    <ItemsControl Grid.Column="1" x:Name="PART_ItemsPublishers" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCGameReleaseDateTitle}" />
                                                                    <Button Grid.Column="1" x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCSeriesLabel}" />
