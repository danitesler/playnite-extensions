<!--
    Overlay on Playnite Default/Views/Sidebar.xaml. The Red Dead Redemption pause menu as a compact rail: a black column
    (ShellBackgroundBrush, black) 44px wide down the left edge, carrying the pause stack's red items as glyphs
    (CustomControls/SidebarItem.xaml). The Options pages open with a splash of maroon paint in the top-left corner; here
    that splash (an original ragged path, MainMenuButtonBackgroundBrush, red 800000) sits behind the main menu button,
    44 x 56 so it lines up with the 56px top bar, and spills 26px to the right over the top bar's left padding. It
    draws over the views (the sidebar is on top) but takes no clicks. The main menu glyph is black ink on the paint and
    turns white on hover. Items start 56px down.
    Right, top and bottom: no splash; the main menu button falls back to MainMenuButton's own red tile. Right starts
    56px down so the window buttons stay clear; the top strip keeps 160px clear for them.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- Main menu button: a red paint tile with a black glyph, white on hover. Also used by Views/TopPanel.xaml when the
         sidebar is hidden. -->
    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid x:Name="Root" Width="44" Margin="{TemplateBinding Padding}">
                        <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" />
                        <Path x:Name="Splash" Width="70" Height="68" Margin="0,0,-26,0"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Stretch="None" SnapsToDevicePixels="False" IsHitTestVisible="False"
                              Fill="{DynamicResource MainMenuButtonBackgroundBrush}"
                              Data="M 0,0 L 62,0 L 61.8,1.4 L 58.3,3.6 L 52.7,5.2 L 53.2,7.1 L 57.3,9.7 L 53.3,11 L 53.6,12.5 L 53.1,14.9 L 57.8,16.7 L 60.4,19.2 L 53.8,21.6 L 62,22.9 L 61.1,24.3 L 59.1,26.4 L 52.4,27.7 L 57.5,30.3 L 58.6,32.4 L 56.3,34.3 L 45.8,35.6 L 53.1,37.6 L 53.9,40.2 L 42.9,42.7 L 42.1,44 L 37.2,48.6 L 33.8,48.6 L 31.9,51.8 L 31.3,52.2 L 25.7,56.4 L 24.2,55 L 23.8,57.8 L 20.2,59.4 L 15.6,62.1 L 11.2,62.2 L 9.3,64 L 8,62 L 5.8,64.3 L 0.5,65.9 L 0,66.1 Z M 66.2,22.7 A 1.1,1.1 0 1 0 68.4,22.7 A 1.1,1.1 0 1 0 66.2,22.7 Z M 61.5,35.6 A 1,1 0 1 0 63.5,35.6 A 1,1 0 1 0 61.5,35.6 Z M 47,48 A 1.8,1.8 0 1 0 50.6,48 A 1.8,1.8 0 1 0 47,48 Z M 56.1,41.8 A 0.8,0.8 0 1 0 57.7,41.8 A 0.8,0.8 0 1 0 56.1,41.8 Z" />
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                    DockPanel.Dock="Top" Margin="0,0,0,0">
                                <ContentPresenter Width="16" Height="16"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" Margin="0,0,0,10" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Left (the design): the button is the splash, 56 tall to match the top bar. -->
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Left">
                            <Setter Property="Background" Value="Transparent" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="56" TargetName="PART_ElemMainMenu" />
                        </DataTrigger>
                        <!-- Main menu hidden (it is in the top bar): no splash, items still start below the top bar. -->
                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemMainMenu}" Value="Collapsed">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Splash" />
                            <Setter Property="Margin" Value="0,56,0,0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,56,0,0" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Splash" />
                            <Setter Property="Margin" Value="0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Width" Value="Auto" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Splash" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,160,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,4,0,4" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="4,4,4,4" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Width" Value="Auto" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Splash" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,4,0,4" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="4,4,4,4" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
