<!--
    Tumbleweed: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    The Options page's header turned into a 44px black band: the title sits on a maroon header bar that runs in from the
    window edge and ends in the game's torn edge (a ragged ink-black cut, fixed 12px wide so the bar stays content-sized),
    in the title face with the selection white. The flat 2px grey rule closes the band, as it does above the Options
    rows. Caption buttons are the 44x40 WindowBarButton keycaps. The caption and the content offset are 44 (Default: 25).
    PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource ShellBackgroundBrush}">
                                    <!-- The flat 2px rule that closes the band. -->
                                    <Rectangle Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{DynamicResource NormalBorderBrush}" />
                                    <DockPanel LastChildFill="False">
                                        <!-- The maroon header bar with its torn end. -->
                                        <Grid DockPanel.Dock="Left" Height="38" VerticalAlignment="Top" Margin="0,3,0,0">
                                            <Rectangle Fill="{DynamicResource MainMenuButtonBackgroundBrush}" />
                                            <TextBlock Text="{TemplateBinding Title}" Margin="20,0,34,0" VerticalAlignment="Center" MaxWidth="440"
                                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                                       Foreground="{DynamicResource SelectedForegroundBrush}" TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                            <Path Width="12" HorizontalAlignment="Right" Stretch="Fill" IsHitTestVisible="False" Fill="{DynamicResource ShellBackgroundBrush}"
                                                  Data="M10,0 V26 H3 L6,22 L2,18 L6,14 L3,10 L7,6 L4,2 L6,0 Z" />
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,2,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
