<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml: the Play / Install button on the game page, as one of the
    game's painted header bars ("ORGANIZE AND COMPARE"): a maroon slab (PrimaryButtonBackgroundBrush, red 800000) whose
    two ends are torn, 6px ragged edges (original paths in the slab's own fill, the right one mirrored), white type
    (PrimaryButtonForegroundBrush) in the title face (HeadingFontFamily) at FontSizeLarge, ButtonPadding, at least 40
    tall. Keyboard focus: FocusVisual.
    Hover: a fresh coat of paint. A copy of the whole slab, torn ends included, in the console capture's brighter maroon
    (PrimaryButtonHoverBackgroundBrush) is wiped on from the left (a clip rectangle grows across it in 0.24s) while the
    label steps 3px toward the right; leaving wipes it back off in 0.2s. Pressed: a third copy in the dark label red fades
    in over 0.05s. The plates carry every color change (no setters on the background); nothing loops, so nothing keeps
    running while the pointer is away.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                        </Grid.ColumnDefinitions>
                        <!-- The slab at rest -->
                        <Path Grid.Column="0" Stretch="Fill" SnapsToDevicePixels="False" IsHitTestVisible="False"
                              Fill="{TemplateBinding Background}"
                              Data="M 6,0 L 2.2,0 L 3.6,3.5 L 0.6,8 L 2.8,12.5 L 0.2,17 L 2.4,21 L 1,25.5 L 3.4,30 L 0.4,35 L 2,40 L 6,40 Z" />
                        <Border x:Name="Chrome" Grid.Column="1" SnapsToDevicePixels="True" IsHitTestVisible="False" Background="{TemplateBinding Background}" />
                        <Path Grid.Column="2" Stretch="Fill" SnapsToDevicePixels="False" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"
                              Fill="{TemplateBinding Background}"
                              Data="M 6,0 L 2.2,0 L 3.6,3.5 L 0.6,8 L 2.8,12.5 L 0.2,17 L 2.4,21 L 1,25.5 L 3.4,30 L 0.4,35 L 2,40 L 6,40 Z">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="-1" ScaleY="-1" />
                            </Path.RenderTransform>
                        </Path>
                        <!-- The fresh coat: the same slab in the hover maroon, revealed by the growing clip -->
                        <Grid x:Name="HoverLayer" Grid.ColumnSpan="3" IsHitTestVisible="False">
                            <Grid.Clip>
                                <RectangleGeometry x:Name="WipeClip" Rect="0,0,0,400" />
                            </Grid.Clip>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Stretch="Fill" SnapsToDevicePixels="False"
                                  Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                  Data="M 6,0 L 2.2,0 L 3.6,3.5 L 0.6,8 L 2.8,12.5 L 0.2,17 L 2.4,21 L 1,25.5 L 3.4,30 L 0.4,35 L 2,40 L 6,40 Z" />
                            <Border Grid.Column="1" SnapsToDevicePixels="True" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Path Grid.Column="2" Stretch="Fill" SnapsToDevicePixels="False" RenderTransformOrigin="0.5,0.5"
                                  Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                  Data="M 6,0 L 2.2,0 L 3.6,3.5 L 0.6,8 L 2.8,12.5 L 0.2,17 L 2.4,21 L 1,25.5 L 3.4,30 L 0.4,35 L 2,40 L 6,40 Z">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="-1" ScaleY="-1" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <!-- Pressed: the dark label red -->
                        <Grid x:Name="PressLayer" Grid.ColumnSpan="3" Opacity="0" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Stretch="Fill" SnapsToDevicePixels="False"
                                  Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                  Data="M 6,0 L 2.2,0 L 3.6,3.5 L 0.6,8 L 2.8,12.5 L 0.2,17 L 2.4,21 L 1,25.5 L 3.4,30 L 0.4,35 L 2,40 L 6,40 Z" />
                            <Border Grid.Column="1" SnapsToDevicePixels="True" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                            <Path Grid.Column="2" Stretch="Fill" SnapsToDevicePixels="False" RenderTransformOrigin="0.5,0.5"
                                  Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                  Data="M 6,0 L 2.2,0 L 3.6,3.5 L 0.6,8 L 2.8,12.5 L 0.2,17 L 2.4,21 L 1,25.5 L 3.4,30 L 0.4,35 L 2,40 L 6,40 Z">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="-1" ScaleY="-1" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform x:Name="LabelShift" X="0" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <RectAnimation Storyboard.TargetName="WipeClip" Storyboard.TargetProperty="Rect" To="0,0,240,400" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <RectAnimation Storyboard.TargetName="WipeClip" Storyboard.TargetProperty="Rect" To="0,0,0,400" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
