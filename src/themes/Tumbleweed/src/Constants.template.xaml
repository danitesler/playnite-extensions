<!--
    Tumbleweed: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    The Red Dead Redemption menus: pure black pages (black 000000), one maroon (red 800000) for titles, the pause stack
    and the Play slab, a grey text ramp where selection turns grey text white (text a6a6a6, text-white e6e6e6), flat 2px
    grey rules (rule 4e4e4e), keycap greys for buttons (key 383838), and the red and black duotone the game washes over
    the world behind every menu (ArtTintBrush over banner and library art). Square corners throughout. No gold, no
    parchment: the menus have neither.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). Placeholder syntax: see reference.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): rows 15, section headers 24, the pause stack 34 (1080p sizes x 2/3, condensed). -->
    <sys:Double x:Key="FontSizeSmall">{{px:rdr1-text-sm}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:rdr1-text-md}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:rdr1-text-lg}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:rdr1-text-xl}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:rdr1-text-2xl}}</sys:Double>
    <!-- Body: a light condensed sans (the game's is unidentified). Oswald and Pathway Gothic One are free (OFL); Arial
         Narrow ships with Office; Bahnschrift and Segoe UI with Windows. Titles: Chinese Rocks (Typodermic, free for
         desktop use, not embeddable, so not shipped), then Anton (OFL), then Impact, which Windows has. -->
    <FontFamily x:Key="FontFamily">Oswald, Pathway Gothic One, Arial Narrow, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Chinese Rocks, Chinese Rocks Rg, Anton, Impact</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys): square corners; hairline edges on popups only. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">0</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:rdr1-radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">0</CornerRadius>
    <!-- The game's rules and ink frames: 2px -->
    <Thickness x:Key="FrameThickness">{{px:rdr1-rule-width}}</Thickness>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor (checked, links, the current tab) is the solid Dead Eye red, the brightest red the menus use, so small
        marks read on black. TextColor is a resting row; selection is text-white. MainColor is a dimmed keycap.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{rdr1-text}}</Color>
    <Color x:Key="TextColorDarker">{{rdr1-text-dim}}</Color>
    <Color x:Key="TextColorDark">{{rdr1-text-white}}</Color>
    <Color x:Key="MainColor">{{rdr1-button}}</Color>
    <Color x:Key="MainColorDark">{{rdr1-panel}}</Color>
    <Color x:Key="HoverColor">{{rdr1-row-hover}}</Color>
    <Color x:Key="GlyphColor">{{rdr1-red-glyph}}</Color>
    <Color x:Key="HighlightGlyphColor">{{rdr1-red-glyph/40}}</Color>
    <Color x:Key="PopupBackgroundColor">{{rdr1-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{rdr1-edge}}</Color>
    <Color x:Key="BackgroundToneColor">{{rdr1-box}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{rdr1-box}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{rdr1-edge}}</Color>
    <Color x:Key="DataChangeNotifColor">{{rdr1-warning}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{rdr1-rule}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{rdr1-panel}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{rdr1-button}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{rdr1-good}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{rdr1-red-glyph}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{rdr1-mixed}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{rdr1-warning}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{rdr1-box}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{rdr1-black}}" />

    <!-- Shell: everything on black; the main menu button sits in a splash of maroon paint (the Options pages' corner) -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{rdr1-black}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{rdr1-black}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{rdr1-panel}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{rdr1-rule}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{rdr1-red}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{rdr1-black}}" />
    <!-- The pause stack: red entries, the selected one white -->
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{rdr1-red-glyph}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{rdr1-text-white}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{rdr1-black}}" />
    <!-- The duotone: maroon laid over background art at partial opacity (Views/Library.xaml, the game page banner) -->
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{rdr1-red}}" />

    <!-- States: selection turns grey text white; lists add the duotone's shadow red behind the row so it reads at a glance -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{rdr1-wash}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{rdr1-text-white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{rdr1-row-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{rdr1-wash}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{rdr1-wash}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{rdr1-text-white}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{rdr1-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{rdr1-text-white}}" />

    <!-- Buttons: prompt keycaps (grey plate, light glyph); Play is the maroon slab with white type -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{rdr1-key-glyph}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{rdr1-key}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{rdr1-key-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{rdr1-red}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{rdr1-red-bright}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{rdr1-red-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{rdr1-text-white}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{rdr1-wash-hover}}" />

    <!-- Inputs: a black box on a 2px grey rule; the white of selection marks focus -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{rdr1-panel}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{rdr1-row-hover}}" />
    <SolidColorBrush x:Key="InputUnderlineBrush" Color="{{rdr1-rule}}" />
    <SolidColorBrush x:Key="InputHoverUnderlineBrush" Color="{{rdr1-thumb}}" />

    <!-- Controls: grey box, white tick on maroon; the Options slider (2px track, dot); a thin grey scroll thumb -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{rdr1-text-dim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{rdr1-text-white}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{rdr1-track-on}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{rdr1-dot}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{rdr1-text-white}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{rdr1-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{rdr1-thumb}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{rdr1-dot}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{rdr1-track}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{rdr1-key}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{rdr1-thumb}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{rdr1-rule}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{rdr1-text-white}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{rdr1-button}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{rdr1-text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{rdr1-key}}" />

    <!-- Popups: the black header bars and boxes -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{rdr1-edge}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{rdr1-text-white}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{rdr1-edge}}" />

    <!-- Section headings: the maroon of "GRAPHICS" and "ORGANIZE AND COMPARE", in the brighter capture value so 24px
         type holds on black -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{rdr1-red-bright}}" />
</ResourceDictionary>
