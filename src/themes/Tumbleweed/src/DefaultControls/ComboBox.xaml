<!--
    Overlay on Playnite Default/DefaultControls/ComboBox.xaml. An Options value row as a dropdown: the field of
    TextBox.xaml (a black box, InputBackgroundBrush, on the flat 2px rule, InputUnderlineBrush), square, InputPadding (34
    tall), the value in resting grey and a chevron (IconDropDown) in TextBrushDarker at the end, white while hovered or
    open, like the arrows the game prints beside the selected value. Hover: InputHoverBackgroundBrush and a lighter rule.
    Keyboard focus or open: the rule turns white (FocusBrush).
    Popup: PopupBorder (a black box, 1px grey edge) right under the field, ComboBoxDropDownPadding around rows 2px apart.
    Items (ComboBoxItem): ComboBoxItemPadding, transparent at rest with resting grey type (TextBrush); on hover or
    keyboard highlight the duotone's shadow red behind the row (MenuItemHoverBrush) and white type; the chosen item
    white with a red IconCheck (GlyphBrush) at its end.
    Structure kept from the Default template: ToggleButton, ContentSite, PART_EditableTextBox, PART_Popup.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Grid Background="Transparent">
                                                <ContentPresenter x:Name="Chevron" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  Margin="0,0,10,0" IsHitTestVisible="False"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                  Content="{DynamicResource IconDropDown}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Chevron" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Chevron" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- ComboBox-chevron-room: the value never runs under the chevron (12px + 10px margin + 8px gap = 30px kept clear). -->
                                <Border Margin="0,0,30,0" IsHitTestVisible="False">
                                    <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                </Border>
                                <TextBox x:Name="PART_EditableTextBox" Style="{DynamicResource BareTextBox}" Visibility="Hidden"
                                         VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                         Margin="8,0,30,0" Focusable="True"
                                         IsReadOnly="{TemplateBinding IsReadOnly}" />
                            </Grid>
                        </Border>
                        <Border x:Name="Rule" Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                Background="{DynamicResource InputUnderlineBrush}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" VerticalOffset="2" Focusable="False" AllowsTransparency="True">
                            <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Border Style="{DynamicResource PopupBorder}" Padding="{DynamicResource ComboBoxDropDownPadding}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" TargetName="Border" />
                            <Setter Property="Background" Value="{DynamicResource InputHoverUnderlineBrush}" TargetName="Rule" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="Background" Value="{DynamicResource FocusBrush}" TargetName="Rule" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="{DynamicResource FocusBrush}" TargetName="Rule" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="ContentSite" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxItemPadding}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid>
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <ContentPresenter x:Name="CheckIcon" Grid.Column="1" Visibility="Collapsed" Width="14" Height="14"
                                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource GlyphBrush}"
                                                  Content="{DynamicResource IconCheck}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="ItemBorder" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="ItemBorder" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
