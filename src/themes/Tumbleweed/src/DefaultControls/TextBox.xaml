<!--
    Overlay on Playnite Default/DefaultControls/TextBox.xaml. An Options value as a field: a black box
    (InputBackgroundBrush, panel 0a0a0a) standing on the game's flat 2px rule (InputUnderlineBrush, rule 4e4e4e), square,
    resting-row grey type, InputPadding (34 tall). Hover: the box lifts a step (InputHoverBackgroundBrush) and the rule
    lightens (InputHoverUnderlineBrush). Keyboard focus: the rule turns white (FocusBrush), the game's selection color.
    BareTextBox: no chrome at all, for hosts that draw their own (search box, editable dropdown).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource SelectedForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border" BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <Border x:Name="Rule" Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                Background="{DynamicResource InputUnderlineBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" TargetName="Border" />
                            <Setter Property="Background" Value="{DynamicResource InputHoverUnderlineBrush}" TargetName="Rule" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="{DynamicResource FocusBrush}" TargetName="Rule" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No fill, no edge, no padding: the host (search box, editable dropdown) draws the field. -->
    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource SelectedForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
