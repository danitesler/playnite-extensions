<!--
    Overlay on Playnite Default/DefaultControls/TextBox.xaml. An Options value as a field: a black box
    (InputBackgroundBrush, panel 0a0a0a) standing on the game's flat 2px rule (InputUnderlineBrush, rule 4e4e4e), square,
    resting-row grey type, InputPadding (34 tall). Hover: the box lifts a step (InputHoverBackgroundBrush) and the rule
    lightens (InputHoverUnderlineBrush). Keyboard focus: the rule turns white (FocusBrush), the game's selection color.
    BareTextBox: no chrome at all, for hosts that draw their own (search box, editable dropdown).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LocalFieldPaintTemplate: the field's signature, shared by TextBox, PasswordBox and ComboBox. The game paints its
        header bars by hand, so a field carries a stroke of the same maroon on its 2px rule: a short stub at rest that
        loads more paint on hover (28 -> 84px) and, on keyboard focus, a fresh coat wiped across the whole rule that ends
        in a ragged tail. State comes from the host (the nearest Control above), so every host shares this one template.
        Host it as <Control Template="{DynamicResource LocalFieldPaintTemplate}" VerticalAlignment="Bottom" ... />.
    -->
    <ControlTemplate x:Key="LocalFieldPaintTemplate" TargetType="{x:Type Control}">
        <Grid Height="4" ClipToBounds="True" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid x:Name="Stub" Width="28" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="9" />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Path Grid.Column="1" Stretch="Fill" Fill="{DynamicResource PrimaryButtonBackgroundBrush}"
                      Data="M0,0 H4 L7,1.2 L5,2.4 L9,3.4 L6,4 H0 Z" />
            </Grid>
            <Grid x:Name="Coat" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="9" />
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="CoatBody" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="CoatScale" ScaleX="1" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Path x:Name="CoatTail" Grid.Column="1" Stretch="Fill" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                      Data="M0,0 H4 L7,1.2 L5,2.4 L9,3.4 L6,4 H0 Z" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="LoadPaintIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Stub" Storyboard.TargetProperty="Width" To="84" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="LoadPaintIn" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Coat" Property="Visibility" Value="Visible" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="WipeIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CoatScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CoatTail" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="WipeIn" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource SelectedForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border" BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <Border x:Name="Rule" Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                Background="{DynamicResource InputUnderlineBrush}" />
                        <Control x:Name="FieldOverlay" Template="{DynamicResource LocalFieldPaintTemplate}" VerticalAlignment="Bottom" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" TargetName="Border" />
                            <Setter Property="Background" Value="{DynamicResource InputHoverUnderlineBrush}" TargetName="Rule" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                            <Setter Property="Background" Value="{DynamicResource FocusBrush}" TargetName="Rule" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No fill, no edge, no padding: the host (search box, editable dropdown) draws the field. -->
    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource SelectedForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
