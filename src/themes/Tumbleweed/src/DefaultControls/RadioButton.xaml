<!--
    Overlay on Playnite Default/DefaultControls/RadioButton.xaml. The check box as a round option: a 16px ring, 2px
    CheckBoxBorderBrush (EllipseBorderThickness); checked, the ring and a 6px dot turn the glyph red (GlyphBrush). Hover:
    a white ring (CheckBoxHoverBorderBrush) and a white label. Label 8px after the ring. Keyboard focus: FocusVisual.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <!-- Dead Eye: a ring with four reticle ticks that stand out of it; the ticks wake on hover,
                                 and a chosen option locks on (red ring, red ticks, red dot). -->
                            <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Ellipse x:Name="Ring" Stroke="{TemplateBinding BorderBrush}"
                                         StrokeThickness="{DynamicResource EllipseBorderThickness}" />
                                <Rectangle x:Name="TickN" Width="2" Height="4" VerticalAlignment="Top" Margin="0,-3,0,0" Opacity="0" Fill="{DynamicResource GlyphBrush}" />
                                <Rectangle x:Name="TickS" Width="2" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,-3" Opacity="0" Fill="{DynamicResource GlyphBrush}" />
                                <Rectangle x:Name="TickW" Width="4" Height="2" HorizontalAlignment="Left" Margin="-3,0,0,0" Opacity="0" Fill="{DynamicResource GlyphBrush}" />
                                <Rectangle x:Name="TickE" Width="4" Height="2" HorizontalAlignment="Right" Margin="0,0,-3,0" Opacity="0" Fill="{DynamicResource GlyphBrush}" />
                                <Ellipse x:Name="Dot" Width="6" Height="6" Visibility="Collapsed"
                                         Fill="{DynamicResource GlyphBrush}" />
                            </Grid>
                        </BulletDecorator.Bullet>
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Label" RecognizesAccessKey="True" Margin="11,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="Ring" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Label" />
                            <Setter Property="Opacity" Value="0.6" TargetName="TickN" />
                            <Setter Property="Opacity" Value="0.6" TargetName="TickS" />
                            <Setter Property="Opacity" Value="0.6" TargetName="TickW" />
                            <Setter Property="Opacity" Value="0.6" TargetName="TickE" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Dot" />
                            <Setter Property="Stroke" Value="{DynamicResource GlyphBrush}" TargetName="Ring" />
                            <Setter Property="Opacity" Value="1" TargetName="TickN" />
                            <Setter Property="Opacity" Value="1" TargetName="TickS" />
                            <Setter Property="Opacity" Value="1" TargetName="TickW" />
                            <Setter Property="Opacity" Value="1" TargetName="TickE" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
