<!--
    Overlay on Playnite Default/DefaultControls/CheckBox.xaml. The Options pages print On / Off; a launcher needs a box,
    so it takes the game's other marks: a 16px square, 2px CheckBoxBorderBrush (caption grey), transparent inside
    (CheckBoxCheckMarkBkBrush). Checked: filled with the glyph red (GlyphBrush) and a white tick (IconCheck,
    SelectedForegroundBrush); indeterminate: a white bar on red. Hover: the edge turns white (CheckBoxHoverBorderBrush)
    and so does the label, the game's selection cue. Label 8px after the box. Keyboard focus: FocusVisual.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Border x:Name="BulletBorder" DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{DynamicResource CheckBoxCheckMarkBkBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Grid>
                                    <!-- Checked: not a tick but the X a hand paints on a form, two tapered brush strokes
                                         that overrun the box by a pixel or two, in selection white. -->
                                    <Canvas x:Name="CheckIcon" Visibility="Collapsed" Width="12" Height="12" ClipToBounds="False"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Path Fill="{DynamicResource SelectedForegroundBrush}" Data="M-2.2,-1.6 L0.6,-2.6 L14.2,11.4 L11.6,13.8 Z" />
                                        <Path Fill="{DynamicResource SelectedForegroundBrush}" Data="M13.6,-2.4 L14.4,0.2 L1.6,13.6 L-1.2,11.8 Z" />
                                    </Canvas>
                                    <Border x:Name="IndeterminateIcon" Visibility="Collapsed" Width="8" Height="2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{DynamicResource SelectedForegroundBrush}" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="Label" DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="8,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="BulletBorder" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Label" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" TargetName="BulletBorder" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon" />
                            <Setter Property="Background" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
