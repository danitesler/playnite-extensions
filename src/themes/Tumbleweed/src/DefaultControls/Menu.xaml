<!--
    Overlay on Playnite Default/DefaultControls/Menu.xaml. Every popup menu (hamburger menu, top bar dropdowns, game
    and group menus, tray) is Red Dead Redemption's Options stack on the black box of ContextMenu.xaml.
    Roles: TopLevelHeader and TopLevelItem (a horizontal Menu bar), SubmenuHeader and SubmenuItem (every popup menu).
    The Separator and MenuItem.SeparatorStyleKey are both redefined (the Default one points at its own sibling).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="true" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group break in every menu: RDR1's flat 2px grey rule (9px tall) led by a 10px maroon paint stub. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="9" Margin="-3,0,-3,0" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Rectangle Height="2" VerticalAlignment="Center" Fill="{DynamicResource NormalBorderBrush}" Opacity="0.7" />
                        <Rectangle Width="14" Height="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{DynamicResource PrimaryButtonBackgroundBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Rows of every popup menu, compact: 30px on RDR1's black box.
        - Row: fixed 26px icon column (16px icon at 0.8 opacity at rest), resting grey label, shortcuts in square
          dark-grey RDR1 prompt keycaps (ButtonBackgroundBrush, 1,1,1,2 NormalBorderBrush rim); checked rows draw
          Tumbleweed's square Dead Eye red box with a white tick.
        - Highlight (pointer or keyboard): duotone shadow-red bar (SelectedBrush) with a torn ragged right cut fades
          in (0.12s) while a Dead Eye red arrow (IconSubmenu) slides in from the left and the label turns selection
          white (SelectedForegroundBrush); prompt keycap lights up. Out over 0.18s (FillBehavior=Stop).
        - Exit (gesture Alt+Q): maroon prompt keycap at rest; on highlight, fills as a solid maroon painted slab
          (PrimaryButtonBackgroundBrush) with torn right cut and selection-white arrow, label and keycap (8.75:1).
        - Submenu headers: IconSubmenu at right edge, Dead Eye red while open, with a held shadow-red wash (no
          animation); submenus open on the same black box.
        Recipe: docs/themes/menus.md.
    -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Torn-end duotone wash plate -->
            <Grid x:Name="MenuHover" Margin="0,1,2,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Rectangle x:Name="MenuSlab" Fill="{DynamicResource SelectedBrush}" />
                <Path Width="10" HorizontalAlignment="Right" Stretch="Fill"
                      Fill="{DynamicResource PopupBackgroundBrush}"
                      Data="M10,0 V28 H3 L6,23 L2,19 L6,14 L3,10 L7,6 L4,2 L6,0 Z" />
            </Grid>
            <ContentPresenter x:Name="MenuCursor" Width="11" Height="11" Margin="3,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              TextElement.Foreground="{DynamicResource GlyphBrush}"
                              Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconTemplate}"
                              Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <ContentPresenter.RenderTransform>
                    <TranslateTransform x:Name="MenuCursorShift" X="-4" />
                </ContentPresenter.RenderTransform>
            </ContentPresenter>
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.8" />
                <Border x:Name="GlyphPanel" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Visibility="Collapsed" Background="{DynamicResource GlyphBrush}">
                    <ContentPresenter Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource SelectedForegroundBrush}"
                                      Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconTemplate}" />
                </Border>
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <Border x:Name="MenuKeycap" Grid.Column="2" Height="18" Margin="14,0,0,0" Padding="5,0" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Background="{DynamicResource ButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1,1,1,2">
                    <TextBlock x:Name="GestureText" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource ButtonForegroundBrush}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuKeycap" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuKeycap" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" TargetName="MenuKeycap" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="MenuKeycap" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="GestureText" />
                <Setter Property="Fill" Value="{DynamicResource PrimaryButtonBackgroundBrush}" TargetName="MenuSlab" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuCursor" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" TargetName="MenuKeycap" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="GestureText" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursorShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursorShift" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <!-- Selection white on maroon painted slab (8.75:1) -->
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" TargetName="MenuKeycap" />
                <Setter Property="BorderBrush" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuKeycap" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="GestureText" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held duotone wash while submenu is open (no animation) -->
            <Rectangle x:Name="MenuHeld" Margin="0,1,2,1" Visibility="Collapsed"
                       Fill="{DynamicResource SelectedBrush}" Opacity="0.65" IsHitTestVisible="False" />
            <Grid x:Name="MenuHover" Margin="0,1,2,1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Rectangle Fill="{DynamicResource SelectedBrush}" />
                <Path Width="10" HorizontalAlignment="Right" Stretch="Fill"
                      Fill="{DynamicResource PopupBackgroundBrush}"
                      Data="M10,0 V28 H3 L6,23 L2,19 L6,14 L3,10 L7,6 L4,2 L6,0 Z" />
            </Grid>
            <ContentPresenter x:Name="MenuCursor" Width="11" Height="11" Margin="3,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              TextElement.Foreground="{DynamicResource GlyphBrush}"
                              Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconTemplate}"
                              Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <ContentPresenter.RenderTransform>
                    <TranslateTransform x:Name="MenuCursorShift" X="-4" />
                </ContentPresenter.RenderTransform>
            </ContentPresenter>
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.8" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <ContentPresenter x:Name="MenuArrow" Grid.Column="3" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                  Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconTemplate}" />
            </Grid>
            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                   HorizontalOffset="6" VerticalOffset="-11" Focusable="False" AllowsTransparency="True">
                <Grid MinWidth="200" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="0,11,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" Margin="4,0"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Visibility" Value="Visible" TargetName="MenuHeld" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" TargetName="MenuArrow" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="MenuArrow" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursorShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursor" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="MenuCursorShift" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TopLevelHeader: an item in a menu bar, opening a popup menu -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid>
            <Border x:Name="HoverBorder" Background="Transparent" />
            <TextBlock VerticalAlignment="Center" Padding="12,6" Style="{DynamicResource BaseTextBlockStyle}"
                       Foreground="{TemplateBinding Foreground}">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </TextBlock>
            <Popup Placement="Bottom" VerticalOffset="2" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                <Border Style="{DynamicResource PopupBorder}" SnapsToDevicePixels="True">
                    <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" Margin="{DynamicResource MenuPadding}"
                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="HoverBorder" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="HoverBorder" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- TopLevelItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid>
            <Border x:Name="HoverBorder" Background="Transparent" />
            <TextBlock VerticalAlignment="Center" Padding="12,6" Style="{DynamicResource BaseTextBlockStyle}"
                       Foreground="{TemplateBinding Foreground}">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </TextBlock>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="HoverBorder" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="true" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
