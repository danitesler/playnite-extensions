<!--
    Overlay on Playnite Default/Common.xaml. Spacing and focus of the Red Dead Redemption Options pages, scaled from
    1080p captures by 2/3: rows on a 53px pitch (35 here) with no fill between them, labels flush with the column, values
    right-aligned, the content column split by flat 2px rules (above the rows, and between the rows and the help line).
    Playnite lays most controls out by padding, so each control key turns the row pitch into padding around 15px
    condensed text (about 20px tall): 34 = 20 + 2 x 7.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: the black boxes of the Weapons and store screens, a step off the page with a
             1px grey edge (WPF popups are layered windows: no ink spray), square -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Keyboard focus: the game marks the selected row by turning it white, so focus is a 1px white frame (FocusBrush)
         set 3px outside the control: a pointer click never shows it, the keyboard always does. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: a prompt keycap stretched to a label, 34 tall, 16 inline -->
    <Thickness x:Key="ButtonPadding">16,7</Thickness>
    <!-- Text box, password box, dropdown: 34 tall, 8 inline -->
    <Thickness x:Key="InputPadding">8,7</Thickness>
    <!-- Menu: a black box, 4px around rows 30 tall (the Options pitch tightened for Playnite's long game menu) -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">10,5,16,5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,5,16,5</Thickness>
    <!-- List box row: 30 tall, 8 inline -->
    <Thickness x:Key="ListBoxItemPadding">8,5</Thickness>
    <!-- Group box: an Options section, red title over a 2px rule, no fill -->
    <Thickness x:Key="GroupBoxPadding">0,12,0,4</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,6</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">22</sys:Double>
    <!-- Tooltip: the help line in a black box, 10 / 6 -->
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Glyphs at 18px (the prompt glyphs, about 26px at 1080p) -->
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">360</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">320</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">270</sys:Double>
</ResourceDictionary>
