<!--
    Overlay on Playnite Default/Common.xaml. Spacing and focus of the Red Dead Redemption Options pages, scaled from
    1080p captures by 2/3: rows on a 53px pitch (35 here) with no fill between them, labels flush with the column, values
    right-aligned, the content column split by flat 2px rules (above the rows, and between the rows and the help line).
    Playnite lays most controls out by padding, so each control key turns the row pitch into padding around 15px
    condensed text (about 20px tall): 34 = 20 + 2 x 7.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: the black boxes of the Weapons and store screens, a step off the page with a
             1px grey edge (WPF popups are layered windows: no ink spray), square -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Keyboard focus: the game marks the selected row by turning it white, so focus is a 1px white frame (FocusBrush)
         set 3px outside the control: a pointer click never shows it, the keyboard always does. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: a prompt keycap stretched to a label, 34 tall, 16 inline -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <!-- Text box, password box, dropdown: 34 tall, 8 inline -->
    <Thickness x:Key="InputPadding">8,5</Thickness>
    <!-- Menu: a black box, 4px around rows 30 tall (the Options pitch tightened for Playnite's long game menu) -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">10,5,16,5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,5,16,5</Thickness>
    <!-- List box row: 30 tall, 8 inline -->
    <Thickness x:Key="ListBoxItemPadding">8,5</Thickness>
    <!-- Group box: an Options section, red title over a 2px rule, no fill -->
    <Thickness x:Key="GroupBoxPadding">0,12,0,4</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,6</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">22</sys:Double>
    <!-- Tooltip: the help line in a black box, 10 / 6 -->
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Glyphs at 18px (the prompt glyphs, about 26px at 1080p) -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">360</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- EmptyGameTemplate (no game selected): the game's horizon. A maroon sun sinks and rises behind two flat mesas, shimmer lines run
         under the rule, a tumbleweed rolls and hops along it, a crow glides over. Named transforms started from ControlTemplate.Triggers only. -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Canvas Width="340" Height="150" IsHitTestVisible="False">
            <Rectangle x:Name="EmptyStarA" Canvas.Left="64" Canvas.Top="22" Width="3" Height="3" Fill="{DynamicResource TextBrush}" Opacity="0" />
            <Rectangle x:Name="EmptyStarB" Canvas.Left="272" Canvas.Top="36" Width="3" Height="3" Fill="{DynamicResource TextBrush}" Opacity="0" />
            <Grid Canvas.Left="110" Canvas.Top="36" Width="120" Height="62" ClipToBounds="True">
                <Ellipse Width="120" Height="120" VerticalAlignment="Top" Fill="{DynamicResource PrimaryButtonBackgroundBrush}"><Ellipse.RenderTransform><TranslateTransform x:Name="EmptySunShift" Y="10" /></Ellipse.RenderTransform></Ellipse>
            </Grid>
            <Path Fill="{DynamicResource ButtonBackgroundBrush}" Data="M 14,98 L 24,70 L 60,70 L 68,82 L 92,82 L 102,98 Z" />
            <Path Fill="{DynamicResource ButtonBackgroundBrush}" Data="M 228,98 L 238,78 L 252,78 L 258,58 L 292,58 L 298,78 L 318,78 L 328,98 Z" />
            <Path Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.5" Data="M 266,98 L 266,80 M 266,92 L 258,92 L 258,85 M 266,88 L 274,88 L 274,81" />
            <Rectangle Canvas.Left="10" Canvas.Top="98" Width="320" Height="2" Fill="{DynamicResource NormalBorderBrush}" />
            <Rectangle x:Name="EmptyShim0" Canvas.Left="70" Canvas.Top="108" Width="200" Height="2" Fill="{DynamicResource TextBrushDarker}" Opacity="0.3" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="EmptyShimScale0" ScaleX="1" /></Rectangle.RenderTransform></Rectangle><Rectangle x:Name="EmptyShim1" Canvas.Left="100" Canvas.Top="117" Width="140" Height="2" Fill="{DynamicResource TextBrushDarker}" Opacity="0.22" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="EmptyShimScale1" ScaleX="1" /></Rectangle.RenderTransform></Rectangle><Rectangle x:Name="EmptyShim2" Canvas.Left="125" Canvas.Top="126" Width="90" Height="2" Fill="{DynamicResource TextBrushDarker}" Opacity="0.15" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="EmptyShimScale2" ScaleX="1" /></Rectangle.RenderTransform></Rectangle>
            <Grid x:Name="EmptyTumble" Canvas.Left="159" Canvas.Top="76" Width="22" Height="22" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><TransformGroup><RotateTransform x:Name="EmptyTumbleRoll" Angle="0" /><TranslateTransform x:Name="EmptyTumbleX" X="-150" Y="0" /><TranslateTransform x:Name="EmptyTumbleHop" Y="0" /></TransformGroup></Grid.RenderTransform>
                <Ellipse Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="2" />
                <Path Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1.2" Data="M 3,8 L 19,14 M 5,16 L 17,5 M 11,1 L 11,21" />
            </Grid>
            <Path x:Name="EmptyCrow" Canvas.Left="162" Canvas.Top="20" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" Data="M 0,5 Q 4,-1 8,5 Q 12,-1 16,5">
                <Path.RenderTransform><TransformGroup><TranslateTransform x:Name="EmptyCrowX" X="-140" /><TranslateTransform x:Name="EmptyCrowY" Y="0" /></TransformGroup></Path.RenderTransform></Path>
        </Canvas>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions><BeginStoryboard x:Name="EmptyIdle"><Storyboard><DoubleAnimation Storyboard.TargetName="EmptySunShift" Storyboard.TargetProperty="Y" From="12" To="-4" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyShimScale0" Storyboard.TargetProperty="ScaleX" From="1" To="0.6" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyShimScale1" Storyboard.TargetProperty="ScaleX" From="0.65" To="1" Duration="0:0:2.1" BeginTime="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyShimScale2" Storyboard.TargetProperty="ScaleX" From="1" To="0.55" Duration="0:0:2.7" BeginTime="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyTumbleX" Storyboard.TargetProperty="X" From="-150" To="150" Duration="0:0:7" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyTumbleRoll" Storyboard.TargetProperty="Angle" From="0" To="540" Duration="0:0:7" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyTumbleHop" Storyboard.TargetProperty="Y" From="0" To="-12" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyTumble" Storyboard.TargetProperty="Opacity" Duration="0:0:7" RepeatBehavior="Forever"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.9" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:6.2" Value="0.9" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:7" Value="0" KeySpline="0.4,0,0.2,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetName="EmptyCrowX" Storyboard.TargetProperty="X" From="-140" To="140" Duration="0:0:6.5" BeginTime="0:0:1.5" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="EmptyCrowY" Storyboard.TargetProperty="Y" From="0" To="8" Duration="0:0:3.2" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyCrow" Storyboard.TargetProperty="Opacity" Duration="0:0:6.5" BeginTime="0:0:1.5" RepeatBehavior="Forever"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.75" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:5.6" Value="0.75" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:6.5" Value="0" KeySpline="0.4,0,0.2,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyStarA" Storyboard.TargetProperty="Opacity" Duration="0:0:4" RepeatBehavior="Forever"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.9" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:4" Value="0" KeySpline="0.4,0,0.2,1" /></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyStarB" Storyboard.TargetProperty="Opacity" Duration="0:0:4" BeginTime="0:0:2" RepeatBehavior="Forever"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.9" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" KeySpline="0.4,0,0.2,1" /><SplineDoubleKeyFrame KeyTime="0:0:4" Value="0" KeySpline="0.4,0,0.2,1" /></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="EmptyIdle" /></Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
