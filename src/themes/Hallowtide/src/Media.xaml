<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Hallowtide icons: drawn as inked strokes on a 24 unit grid (round caps and joins, 2 unit pen), the way the
        quest book's own glyphs are cut: plain, bold silhouettes with no fine detail. Each Icon geometry is a set of
        open or closed stroke paths; IconTemplate lays it in a Viewbox so the pen scales with the icon. The foreground
        is whatever the host sets. Playnite's own menu icons (AddGameIcon, PlayIcon, ...) keep Playnite's glyphs.
    -->

    <DataTemplate x:Key="IconTemplate">
        <Viewbox Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox Width="14" Height="14" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Solid glyph for the cover tile Play button: the same triangle, filled. -->
    <DataTemplate x:Key="IconTileSolidTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" StrokeThickness="2" StrokeLineJoin="Round"
                      Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

