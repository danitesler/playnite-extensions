<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!--
        Hallowtide filter panel: Playnite's structure, respaced and drawn as a page of the quest book. Controls here are
        28px high (the sidebar exception to the 32px field height): the preset dropdown, the Name search box and every
        filter selector, with the three preset actions (delete, rename, save) as 28x28 icon buttons with no padding and
        the close button the same square. Section captions are carved caps (HeadingFontFamily SemiBold 15,
        HeadingForegroundBrush, the HeadingTextBlock face; a Label has no TextBlock style, so its setters are repeated).
        The preset icons are the theme's stroked glyphs (IconRemove, IconEdit, IconFilterPresets) in TextBrushDarker that
        turn GlyphBrush on hover. Spacing: 12px side gutters, 12px above a caption, 5px between caption and field, 8px
        between check boxes. "Clear filters" stays a text link in UIFontFamily Medium and GlyphBrush.
    -->

    <Style x:Key="FilterPanelCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="12,2,12,8" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="{StaticResource False}">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Margin" Value="12,12,12,5" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource False}">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelFilterSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Margin" Value="12,0,12,0" />
        <Setter Property="ShowImage" Value="False" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style x:Key="FilterPanelFilterSelectionBox" TargetType="FilterSelectionBox" BasedOn="{StaticResource {x:Type FilterSelectionBox}}">
        <Setter Property="Margin" Value="12,0,12,0" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style x:Key="FilterPanelFilterEnumSelectionBox" TargetType="FilterEnumSelectionBox" BasedOn="{StaticResource {x:Type FilterEnumSelectionBox}}">
        <Setter Property="Margin" Value="12,0,12,0" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style x:Key="FilterPanelFilterStringSelectionBox" TargetType="FilterStringSelectionBox" BasedOn="{StaticResource {x:Type FilterStringSelectionBox}}">
        <Setter Property="Margin" Value="12,0,12,0" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style x:Key="FilterPresetButtonAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MaxWidth" Value="28" />
        <Setter Property="MaxHeight" Value="28" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="ContentTemplate" Value="{DynamicResource IconTemplate}" />
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type FilterPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPanel}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DesignWidth="200">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings FilterPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Background="{TemplateBinding Background}">
                            <DockPanel Margin="12,10,10,8" DockPanel.Dock="Top">
                                <Button Name="PART_ButtonClose" DockPanel.Dock="Right" Margin="8,0,0,0"
                                        Style="{DynamicResource SecondaryButton}"
                                        Width="28" Height="28" MinWidth="28" MinHeight="28" MaxWidth="28" MaxHeight="28" Padding="0"
                                        Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}" />
                                <Button DockPanel.Dock="Left" Content="{StaticResource LOCClearFilters}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" MinHeight="0"
                                        FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="15"
                                        Style="{StaticResource SimpleButton}"
                                        Name="PART_ButtonClear" />
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="12,0,12,8">
                                <Button x:Name="PART_ButtonDeleteFilter" Style="{DynamicResource FilterPresetButtonAction}"
                                        Content="{DynamicResource IconRemove}" ToolTip="{DynamicResource LOCRemoveTitle}" />
                                <Button x:Name="PART_ButtonRenameFilter" Style="{DynamicResource FilterPresetButtonAction}"
                                        Content="{DynamicResource IconEdit}" ToolTip="{DynamicResource LOCRenameItem}" />
                                <Button x:Name="PART_ButtonSaveFilter" Style="{DynamicResource FilterPresetButtonAction}"
                                        Content="{DynamicResource IconFilterPresets}" ToolTip="{DynamicResource LOCFilterPresetSave}" />
                                <ComboBox x:Name="PART_ComboFilterPresets"
                                          DockPanel.Dock="Left" VerticalAlignment="Center" Height="28" MinHeight="28" />
                            </DockPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      DockPanel.Dock="Top" Padding="0,0,0,16">
                                <StackPanel x:Name="PART_PanelItemsHost" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
