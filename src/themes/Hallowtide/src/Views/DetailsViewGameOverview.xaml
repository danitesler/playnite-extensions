<!--
    Hallowtide: the game page (details view) as the open quest book. Dark plum page, the game's art toned into it as a banner,
    the title in carved caps (Cinzel Bold) with the thorn rule under it, Play as the torn parchment plate lit by the lantern,
    More and Edit as ink squares. Below: Steam screenshots, then two parchment pages: description and notes on the left, every
    metadata field on the right in six groups split by the thorn rule. Text on a page is ink. Generated by art/gen-overviews.mjs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"
                                  Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible"
                                  d:DesignWidth="1280" d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Grid x:Name="PageRoot">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
<Grid.Style>
<Style TargetType="Grid">
<Style.Triggers>
<DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
<DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
      <Setter Property="Visibility" Value="Collapsed" />
    </DataTrigger>
</Style.Triggers>
</Style>
</Grid.Style>
<FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
<Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
<!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
<Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
    <Rectangle.Style>
        <Style TargetType="Rectangle">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Rectangle.Style>
</Rectangle>
<!-- The art is toned toward the book's plum night and faded into the page by plain gradients: no OpacityMask on the banner, which left dark seams behind the animated Play button on scaled displays. -->
<Border Background="{DynamicResource ArtTintBrush}" />
<Border Background="{DynamicResource ScrimBrush}" Opacity="0.4" />
<Rectangle>
<Rectangle.Fill>
<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
<GradientStop Color="#00000000" Offset="0.2" />
<GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.96" />
</LinearGradientBrush>
</Rectangle.Fill>
</Rectangle>
</Grid>
<Grid>
<Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<StackPanel Margin="24,16,41,32" MaxWidth="1100">
<StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="TextWrapping" Value="Wrap" /></Style></StackPanel.Resources>
<Border IsHitTestVisible="False" x:Name="DetailsBannerSpacer" MinHeight="8">
<Border.Style>
<Style TargetType="Border">
<Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 100 / 320'}" />
<Style.Triggers>
<DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0"><Setter Property="Height" Value="8" /></DataTrigger>
<DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed"><Setter Property="Height" Value="8" /></DataTrigger>
</Style.Triggers>
</Style>
</Border.Style>
</Border>
<DockPanel>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
<Grid>
<Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
<Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
</Grid>
<Grid Margin="10,0,0,0"><Button x:Name="PART_ButtonMoreActions" Width="42" Height="42" Padding="0" Style="{DynamicResource SecondaryButton}" ToolTip="{DynamicResource LOCMoreAction}">
<ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False" Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
</Button></Grid>
<Grid Margin="8,0,0,0"><Button Focusable="False" x:Name="PART_ButtonEditGame" Width="42" Height="42" Padding="0" Style="{DynamicResource SecondaryButton}" ToolTip="{DynamicResource LOCEditGame}">
<ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False" Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
</Button></Grid>
</StackPanel>
<StackPanel VerticalAlignment="Bottom">
<DockPanel>
<Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" MaxWidth="40" MaxHeight="40" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
<TextBlock x:Name="PART_TextDisplayName" TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLargest}" Foreground="{DynamicResource HeadingForegroundBrush}" />
</DockPanel>
</StackPanel>
</DockPanel>
<Control Template="{DynamicResource DividerTemplate}" IsTabStop="False" Focusable="False" Margin="0,16,0,26" Foreground="{DynamicResource HeadingRuleBrush}" />
<Grid x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataViewport" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="24,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<Grid Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
<Grid>
<Border Background="{DynamicResource ParchmentBrush}" CornerRadius="6" />
<Rectangle IsHitTestVisible="False" Fill="{DynamicResource ParchmentEdgeBrush}" RadiusX="6" RadiusY="6">
<Rectangle.OpacityMask><RadialGradientBrush Center="0.5,0.5" RadiusX="0.78" RadiusY="0.78"><GradientStop Color="#00000000" Offset="0.5" /><GradientStop Color="#99000000" Offset="1" /></RadialGradientBrush></Rectangle.OpacityMask>
</Rectangle>
<Control Template="{DynamicResource InkFrameTemplate}" IsTabStop="False" Focusable="False" Margin="2" Foreground="{DynamicResource ParchmentTitleBrush}" Opacity="0.9" />
<Border Padding="42,42,42,42">
<StackPanel>
<StackPanel.Resources>
<Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}"><Setter Property="Foreground" Value="{DynamicResource ParchmentLinkBrush}" /></Style>
</StackPanel.Resources>
<StackPanel Margin="0,0,0,12">
<TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCGameDetails}" Foreground="{DynamicResource ParchmentTitleBrush}" />
<Control Template="{DynamicResource DividerTemplate}" IsTabStop="False" Focusable="False" Margin="0,4,0,0" Opacity="0.75" Foreground="{DynamicResource ParchmentTitleBrush}" />
</StackPanel>
<Border x:Name="DetailsMetadataViewport" ClipToBounds="True" HorizontalAlignment="Stretch" Tag="{DynamicResource GameDetailsPaneWidth}">
<Border.Style><Style TargetType="Border"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></Border.Style>
<WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-34,0,-8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-34,-24,-8" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
<Border x:Name="MetaProgress" Padding="0,22,0,0"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid>
<Rectangle Height="14" VerticalAlignment="Top" Margin="0,-22,0,0" IsHitTestVisible="False" Fill="{DynamicResource ParchmentEdgeBrush}" Opacity="0.85">
<Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/thorn-tile.png'}" Viewport="0,0,48,14" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
</Rectangle>
<StackPanel>
<DockPanel x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCCompletionStatus}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" Foreground="{DynamicResource ParchmentLinkBrush}" />
</DockPanel>
<DockPanel x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCTimePlayed}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <TextBlock x:Name="PART_TextPlayTime" TextWrapping="Wrap" Foreground="{DynamicResource ParchmentTextBrush}" />
</DockPanel>
<DockPanel x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCLastPlayed}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <TextBlock x:Name="PART_TextLastActivity" TextWrapping="Wrap" Foreground="{DynamicResource ParchmentTextBrush}" />
</DockPanel>
<DockPanel x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCRecentActivityLabel}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <TextBlock x:Name="PART_TextRecentActivity" TextWrapping="Wrap" Foreground="{DynamicResource ParchmentTextBrush}" />
</DockPanel>
<DockPanel x:Name="PART_ElemAdded" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCDateAddedLabel}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <TextBlock x:Name="PART_TextAdded" TextWrapping="Wrap" Foreground="{DynamicResource ParchmentTextBrush}" />
</DockPanel>
</StackPanel>
</Grid>
</Border>
<Border x:Name="MetaScores" Padding="0,22,0,0"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid>
<Rectangle Height="14" VerticalAlignment="Top" Margin="0,-22,0,0" IsHitTestVisible="False" Fill="{DynamicResource ParchmentEdgeBrush}" Opacity="0.85">
<Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/thorn-tile.png'}" Viewport="0,0,48,14" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
</Rectangle>
<StackPanel>
<DockPanel x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCCommunityScore}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <TextBlock x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" />
</DockPanel>
<DockPanel x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCCriticScore}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <TextBlock x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" />
</DockPanel>
<DockPanel x:Name="PART_ElemUserScore" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCUserScore}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <TextBlock x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" HorizontalAlignment="Left" />
</DockPanel>
</StackPanel>
</Grid>
</Border>
<Border x:Name="MetaAbout" Padding="0,22,0,0"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid>
<Rectangle Height="14" VerticalAlignment="Top" Margin="0,-22,0,0" IsHitTestVisible="False" Fill="{DynamicResource ParchmentEdgeBrush}" Opacity="0.85">
<Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/thorn-tile.png'}" Viewport="0,0,48,14" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
</Rectangle>
<StackPanel>
<DockPanel x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCDeveloperLabel}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <ItemsControl x:Name="PART_ItemsDevelopers" />
</DockPanel>
<DockPanel x:Name="PART_ElemPublishers" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCPublisherLabel}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <ItemsControl x:Name="PART_ItemsPublishers" />
</DockPanel>
<DockPanel x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCGameReleaseDateTitle}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" Foreground="{DynamicResource ParchmentLinkBrush}" />
</DockPanel>
<DockPanel x:Name="PART_ElemSeries" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCSeriesLabel}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <ItemsControl x:Name="PART_ItemsSeries" />
</DockPanel>
<DockPanel x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCAgeRatingLabel}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <ItemsControl x:Name="PART_ItemsAgeRatings" />
</DockPanel>
<DockPanel x:Name="PART_ElemRegion" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCRegionLabel}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <ItemsControl x:Name="PART_ItemsRegions" />
</DockPanel>
</StackPanel>
</Grid>
</Border>
<Border x:Name="MetaTags" Padding="0,22,0,0"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid>
<Rectangle Height="14" VerticalAlignment="Top" Margin="0,-22,0,0" IsHitTestVisible="False" Fill="{DynamicResource ParchmentEdgeBrush}" Opacity="0.85">
<Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/thorn-tile.png'}" Viewport="0,0,48,14" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
</Rectangle>
<StackPanel>
<DockPanel x:Name="PART_ElemPlatform" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCPlatformTitle}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
</DockPanel>
<DockPanel x:Name="PART_ElemGenres" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCGenreLabel}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
</DockPanel>
<DockPanel x:Name="PART_ElemCategories" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCGameCategoriesTitle}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <ItemsControl x:Name="PART_ItemsCategories" Tag="Chip"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
</DockPanel>
<DockPanel x:Name="PART_ElemFeatures" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCFeaturesLabel}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <ItemsControl x:Name="PART_ItemsFeatures" Tag="Chip"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
</DockPanel>
<DockPanel x:Name="PART_ElemTags" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCTagsLabel}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
  <ItemsControl x:Name="PART_ItemsTags" Tag="Chip"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
</DockPanel>
</StackPanel>
</Grid>
</Border>
<Border x:Name="MetaLibrary" Padding="0,22,0,0"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
<Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" /><Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid>
<Rectangle Height="14" VerticalAlignment="Top" Margin="0,-22,0,0" IsHitTestVisible="False" Fill="{DynamicResource ParchmentEdgeBrush}" Opacity="0.85">
<Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/thorn-tile.png'}" Viewport="0,0,48,14" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
</Rectangle>
<StackPanel>
<DockPanel x:Name="PART_ElemLibrary" Margin="0,8,0,8">
  <TextBlock DockPanel.Dock="Left" Width="118" Text="{DynamicResource LOCGameProviderTitle}" FontFamily="{DynamicResource UIFontFamily}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource ParchmentLabelBrush}" TextWrapping="Wrap" Margin="0,3,14,0" />
