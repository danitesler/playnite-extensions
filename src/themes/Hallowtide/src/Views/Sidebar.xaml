<!--
    Hallowtide: the left rail. Quest book part: the page edge with the red barcode bookmark hanging from the top and the
    blue bookmark tabs below it. Keys: ShellBackgroundBrush (rail), FrameInnerBrush (1px rail edge),
    MainMenuButtonBackgroundBrush / MainMenuButtonForegroundBrush (the red bookmark and its glyph and ticks),
    DataChangeNotifBrush (lit wax, hover), BookmarkTemplate (Common.xaml), IconMainMenu (Media.xaml).
    The main menu is a 26px ribbon, 44px long, hung from the top of the 44px rail with the menu glyph near its head and
    three 1px barcode ticks under it; hover lengthens it by 6px (the named Ribbon grows by 6 in a 50px cell, so nothing
    around it moves). With the sidebar at the top or bottom the ribbon shortens to 38px so the strip stays 44px.
    Keep PART_ElemMainMenu, PART_PanelSideBarItems and the position triggers. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}"
                            BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="0,0,1,0"
                            Margin="{TemplateBinding Padding}">
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                    Width="44" Height="50" Margin="0,0,0,4"
                                    DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <Grid>
                                    <Control x:Name="Ribbon" Template="{DynamicResource BookmarkTemplate}"
                                             Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                             Width="26" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top"
                                             IsTabStop="False" Focusable="False" IsHitTestVisible="False" />
                                    <Viewbox x:Name="MenuMark" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Top"
                                             Margin="0,9,0,0" IsHitTestVisible="False">
                                        <ContentControl Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                        IsTabStop="False" Focusable="False" />
                                    </Viewbox>
                                    <StackPanel x:Name="Barcode" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,29,0,0" Opacity="0.5" SnapsToDevicePixels="True" UseLayoutRounding="True"
                                                IsHitTestVisible="False">
                                        <Rectangle Width="1" Height="5" Margin="0,0,3,0" Fill="{DynamicResource MainMenuButtonForegroundBrush}" />
                                        <Rectangle Width="1" Height="3" Margin="0,0,3,0" Fill="{DynamicResource MainMenuButtonForegroundBrush}" />
                                        <Rectangle Width="1" Height="5" Fill="{DynamicResource MainMenuButtonForegroundBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Background" Value="{DynamicResource DataChangeNotifBrush}" TargetName="Ribbon" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ribbon" Storyboard.TargetProperty="Height" By="6" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Ribbon" Storyboard.TargetProperty="Height" By="-6" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,36,0,0" />
                            <Setter Property="BorderThickness" Value="1,0,0,0" TargetName="BorderContentHolder" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="BorderContentHolder" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0,0,5,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Height" Value="38" TargetName="Ribbon" />
                            <Setter Property="Margin" Value="0,7,0,0" TargetName="MenuMark" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Barcode" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0,0,5,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Height" Value="38" TargetName="Ribbon" />
                            <Setter Property="Margin" Value="0,7,0,0" TargetName="MenuMark" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Barcode" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
