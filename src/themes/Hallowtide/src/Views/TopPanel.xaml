<!--
    Hallowtide: the top bar. Quest book part: the page head closed by the wavy thorn rule. 52px of TopPanelBackgroundBrush;
    the toolbar row is 36px high (4px above, 12px below) so the thorns under it stay clear. Closing rule: a 14px tiled
    thorn-tile.png mask filled TopPanelRuleStartBrush along the bottom edge (no fixed width, clipped Grid) over a 1px
    TopPanelRuleEndBrush line; both vanish when Playnite's panel separators are off.
    Order: menu (only while the sidebar is hidden), search, filter toggle, then the main items with sorting first,
    notifications, plugin items, progress. 132px are kept clear on the right for the three 40px caption buttons plus a
    gap. Every plate is 36px, idle and active. Glyphs are the theme's IconSize set, icons only (view switches too).
    Filter active: a 10px wax pin (DataChangeNotifBrush head, lit crescent) on the icon's top-right corner while Tag is
    True, no text; a checked toggle (panel open) is the parchment plate (TopPanelItemCheckedBackgroundBrush). The
    notification count sits in a 16px wax-red badge (DataChangeNotifBrush, DangerForegroundBrush number).
    Keys: TopPanelBackgroundBrush, TopPanelRule*Brush, TopPanelItemHoverBackgroundBrush, TopPanelItemCheckedBackgroundBrush,
    SidebarItemForegroundBrush, GlyphBrush, TextBrush, TextBrushDark, ParchmentBrush, ParchmentEdgeBrush,
    MainMenuButton* brushes. Templates: InkPlateTemplate (Common.xaml). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentControl Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False" Focusable="False" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentControl Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False" Focusable="False" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentControl Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False" Focusable="False" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentControl Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False" Focusable="False" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentControl Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False" Focusable="False" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentControl Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False" Focusable="False" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentControl Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False" Focusable="False" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentControl Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}"
                        Foreground="{DynamicResource WarningBrush}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False" Focusable="False" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentControl Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False" Focusable="False" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False" Focusable="False" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False" Focusable="False" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentControl Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="False" Focusable="False" />
    </DataTemplate>

    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <!-- Filter toggle: a 36px plate, no label. Tag True (a filter applies) shows the wax pin on the icon's top-right corner. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Control x:Name="HoverPlate" Template="{DynamicResource InkPlateTemplate}"
                                 Background="{DynamicResource TopPanelItemHoverBackgroundBrush}" Opacity="0"
                                 IsTabStop="False" Focusable="False" IsHitTestVisible="False" />
                        <Control x:Name="CheckedPlate" Template="{DynamicResource InkPlateTemplate}"
                                 Background="{DynamicResource TopPanelItemCheckedBackgroundBrush}" Visibility="Collapsed"
                                 IsTabStop="False" Focusable="False" IsHitTestVisible="False" />
                        <ContentControl Content="{DynamicResource IconFilter}" ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsTabStop="False" Focusable="False" IsHitTestVisible="False" />
                        <Grid x:Name="TextFilter" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,4,4,0" Visibility="Collapsed" IsHitTestVisible="False">
                            <Ellipse Fill="{DynamicResource DataChangeNotifBrush}" Stroke="{DynamicResource ParchmentEdgeBrush}" StrokeThickness="0.8" />
                            <Path Data="M2.2,4.4 C2.2,2.8 3.5,2 5,2.1 C3.8,2.6 3.1,3.4 3,5 Z" Fill="{DynamicResource ParchmentBrush}" Opacity="0.75" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckedPlate" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="HoverPlate" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Control x:Name="HoverPlate" Template="{DynamicResource InkPlateTemplate}"
                                 Background="{DynamicResource TopPanelItemHoverBackgroundBrush}" Opacity="0"
                                 IsTabStop="False" Focusable="False" IsHitTestVisible="False" />
                        <Control x:Name="CheckedPlate" Template="{DynamicResource InkPlateTemplate}"
                                 Background="{DynamicResource TopPanelItemCheckedBackgroundBrush}" Visibility="Collapsed"
                                 IsTabStop="False" Focusable="False" IsHitTestVisible="False" />
                        <ContentControl Content="{DynamicResource IconNotifications}" ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsTabStop="False" Focusable="False" IsHitTestVisible="False" />
                        <Border Width="16" Height="16" Margin="0,0,3,3" CornerRadius="{DynamicResource CornerRadiusFull}"
                                Background="{DynamicResource DataChangeNotifBrush}" BorderBrush="{DynamicResource ParchmentEdgeBrush}" BorderThickness="1"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <TextBlock Text="{Api Notifications.Count}" FontSize="10" FontFamily="{DynamicResource UIFontFamily}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckedPlate" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="HoverPlate" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Grid Height="52"
                          d:DesignWidth="1280"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource TopPanelBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid x:Name="BarRule" Height="14" VerticalAlignment="Bottom" ClipToBounds="True"
                              IsHitTestVisible="False" UseLayoutRounding="True">
                            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource TopPanelRuleEndBrush}" />
                            <Rectangle Height="14" VerticalAlignment="Bottom" Fill="{DynamicResource TopPanelRuleStartBrush}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/thorn-tile.png'}" Viewport="0,0,48,14" ViewportUnits="Absolute" TileMode="Tile" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                        <DockPanel Margin="12,4,132,12">
                            <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                    DockPanel.Dock="Left" Margin="0,0,8,0" Width="36" Height="36" Cursor="Hand"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <Grid>
                                    <Control x:Name="MenuPlate" Template="{DynamicResource InkPlateTemplate}"
                                             Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                             IsTabStop="False" Focusable="False" IsHitTestVisible="False" />
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <ContentControl Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                        IsTabStop="False" Focusable="False" />
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch" Style="{DynamicResource TopPanelSearchBox}"
                                       Margin="0,0,4,0" VerticalAlignment="Center"
                                       WindowChrome.IsHitTestVisibleInChrome="True"
                                       Width="280" DockPanel.Dock="Left" HorizontalAlignment="Left" />

                            <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" DockPanel.Dock="Left" />

                            <!-- Keep sorting first even though Playnite inserts it after view settings and grouping. -->
                            <Grid x:Name="PART_PanelMainItems" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="{x:Type TopPanelItem}" BasedOn="{StaticResource {x:Type TopPanelItem}}">
                                        <Style.Triggers>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSortSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="0" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSearchButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="1" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGeneralViewSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="2" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelFilterPresetsSelectionTemplate}">
                                                <Setter Property="Grid.Column" Value="3" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGroupSettingsTemplate}">
                                                <Setter Property="Grid.Column" Value="4" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchDetailsViewTemplate}">
                                                <Setter Property="Grid.Column" Value="6" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchGridViewTemplate}">
                                                <Setter Property="Grid.Column" Value="7" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchListViewTemplate}">
                                                <Setter Property="Grid.Column" Value="8" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelUpdateButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="9" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="10" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelViewSelectRandomGameButtonTemplate}">
                                                <Setter Property="Grid.Column" Value="11" />
                                            </Trigger>
                                            <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelExplorerSwitchTemplate}">
                                                <Setter Property="Grid.Column" Value="12" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Grid.Column" Value="5" />
                                    </Style>
                                </Grid.Resources>
                            </Grid>

                            <CheckBox x:Name="PART_ToggleNotifications"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" DockPanel.Dock="Left" />

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Stretch" Margin="12,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                        HorizontalAlignment="Center" Margin="0,2">
                                <Grid MaxWidth="600" MinWidth="300">
                                    <ProgressBar Name="PART_ProgressGlobal" />
                                    <TextBlock Name="PART_TextProgressText"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Style="{DynamicResource BaseTextBlockStyle}" Margin="5,0,5,0" />
                                </Grid>

                                <Button Name="PART_ButtonProgressCancel"
                                        Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Margin="5,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Background" Value="{DynamicResource DataChangeNotifBrush}" TargetName="MenuPlate" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="BarRule" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
