<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Every other thumb (splitters, grid column grips): a small ink grip, radius 3, ThumbBrush at rest and ThumbHoverBrush when the
        mouse is over it or its track is focused. The scroll bar and slider thumbs have their own styles.
    -->

    <Style TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource ThumbBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <Border x:Name="Grip" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="10"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="3"
                                Background="{TemplateBinding Background}" />
                        <Border x:Name="GripHover" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="10"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" CornerRadius="3"
                                Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource ThumbHoverBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True" />
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GripHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="GripHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Track}}" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="GripHover" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
