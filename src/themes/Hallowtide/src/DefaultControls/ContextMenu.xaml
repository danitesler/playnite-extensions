<!--
    Hallowtide: ContextMenu. Every popup menu and dropdown list (hamburger menu, top bar dropdowns via TopPanelMenu,
    GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select boxes) wears
    the quest book's dialogue box (LocalDialogueBoxTemplate): deep teal PopupBackgroundBrush, PopupBorderBrush rim,
    CornerRadiusLarge, a warm lantern top glint fading to both ends, and a red wax push pin pinned at the top-right
    corner (rising 3px above the rim, so hosts leave 4px above the panel and start rows 8px down).
    Rows and the 10px thorn-vine group break are in Menu.xaml.
    Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalDialogueBoxTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="{DynamicResource CornerRadiusLarge}" />
            <!-- Warm lantern glint along the top edge, fading to both ends -->
            <Rectangle Height="1.5" Margin="16,1.5,28,0" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" Opacity="0.55">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="0.25" Color="#FF000000" />
                        <GradientStop Offset="0.75" Color="#FF000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <!-- Red wax push pin anchoring the top-right corner of the dialogue box -->
            <Grid Width="12" Height="12" Margin="0,-3,11,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Ellipse Width="10" Height="10" Margin="2,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Fill="{DynamicResource ScrimBrush}" Opacity="0.65" />
                <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Fill="{DynamicResource MainMenuButtonBackgroundBrush}"
                         Stroke="{DynamicResource ParchmentEdgeBrush}" StrokeThickness="0.8" />
                <Path Data="M3,5.5 C3,3.5 4.8,2.5 6.5,2.7 C5.2,3.1 4.2,4.1 4.1,6 Z"
                      Fill="{DynamicResource TextBrush}" Opacity="0.7" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" Margin="0,4,0,0" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalDialogueBoxTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,8,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="6,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
