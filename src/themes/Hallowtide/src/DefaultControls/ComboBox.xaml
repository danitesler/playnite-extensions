<!--
    Hallowtide ComboBox: the TextBox's ink well (InputBackgroundBrush, 1px InputBorderBrush rim, 2px InputUnderlineBrush
    rule, InputHover*, FocusBrush rim + GlyphBrush rule + FocusHaloBrush ring on focus or while open) with the chevron
    (IconDropDown through IconSmallTemplate, GlyphBrush, turns over while open) in its own Auto grid column, so the
    value in the star column never runs under it (chevron room rule, src/themes/AGENTS.md).
    List: the menus' dialogue box (LocalDialogueBoxTemplate, ContextMenu.xaml). Items (ComboBoxItem) are 30px rows
    matching Menu.xaml: UIFontFamily Medium, dream-indigo brush-stroke plate + turning lantern spiral on IsHighlighted,
    parchment check seal visible in the leading column on IsSelected. MinHeight is ControlHeight. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Halo" Margin="-2" CornerRadius="5" BorderThickness="2" Opacity="0" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource FocusHaloBrush}" />
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource CornerRadiusSmall}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="ToggleButton" Grid.Column="0" Grid.ColumnSpan="2" Style="{x:Null}" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Margin="10,0,6,0" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Style="{DynamicResource BareTextBox}" Visibility="Hidden"
                                         VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="10,0,6,0" Focusable="True" MinHeight="0"
                                         Background="Transparent" BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}"
                                         Foreground="{DynamicResource TextBrush}" />
                                <ContentPresenter x:Name="Chevron" Grid.Column="1" Margin="0,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                                                  Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                  TextElement.Foreground="{DynamicResource GlyphBrush}">
                                    <ContentPresenter.RenderTransform>
                                        <RotateTransform x:Name="ChevronTurn" Angle="0" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                                <Border x:Name="Underline" Grid.Column="0" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom"
                                        CornerRadius="0,0,2,2" IsHitTestVisible="False"
                                        Background="{DynamicResource InputUnderlineBrush}" />
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="0"
                                       Focusable="False" AllowsTransparency="True">
                                    <Grid x:Name="PopupRoot" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                          Margin="0,4,0,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                        <Control Template="{DynamicResource LocalDialogueBoxTemplate}" Focusable="False" IsTabStop="False" />
                                        <ScrollViewer Margin="0,8,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter Name="ItemsPresenter" Margin="6,0" KeyboardNavigation.DirectionalNavigation="Contained"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource InputHoverUnderlineBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource GlyphBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PopupRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource GlyphBrush}" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UIFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid x:Name="ListRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="ListPlate" Template="{DynamicResource InkPlateTemplate}" Background="{DynamicResource SelectedBrush}"
                                 Opacity="0" Visibility="Collapsed" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <Rectangle x:Name="ListSpiral" Width="11" Height="11" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{DynamicResource GlyphBrush}" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                                   IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/spiral-mark.png'}" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                            <Rectangle.RenderTransform>
                                <RotateTransform x:Name="ListSpiralSpin" Angle="-45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Grid Margin="18,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ListCheckSeal" Grid.Column="0" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="Collapsed" CornerRadius="3" Background="{DynamicResource ParchmentBrush}"
                                    BorderBrush="{DynamicResource ParchmentEdgeBrush}" BorderThickness="1">
                                <Path Width="9" Height="7" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 1,3.5 L 3.8,6.5 L 9,1" Stroke="{DynamicResource TextBrushDark}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Border>
                            <ContentPresenter x:Name="ListLabel" Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="ListLabelShift" X="0" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ListCheckSeal" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ListHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListSpiral" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ListSpiral" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="ListSpiralSpin" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ListLabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ListHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListSpiral" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ListSpiral" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ListSpiralSpin" Storyboard.TargetProperty="Angle" To="-45" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ListLabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" TargetName="ListRow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
