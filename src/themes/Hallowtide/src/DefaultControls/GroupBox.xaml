<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        A quest page card (the Statistics sections are GroupBoxes in a wrapping panel): an ink page (ExpanderBackgroundBrush) with a 1px
        WindowPanelSeparatorBrush edge, radius 8 and GroupBoxPadding, headed by carved caps (HeadingTextBlock at GroupBoxHeaderFontSize)
        over a thorn rule with a spiral (DividerTemplate in HeadingRuleBrush), then GroupBoxHeaderMargin and the content.
        The card is sized by its content: nothing here has a fixed width. The divider's width is free (its two thorn runs are star
        columns around a 76px spiral), so it takes the card's width and never asks for more.
    -->

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border DockPanel.Dock="Top" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="8">
                        <StackPanel>
                            <StackPanel Margin="{DynamicResource GroupBoxHeaderMargin}">
                                <TextBlock Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource GroupBoxHeaderFontSize}"
                                           Padding="{DynamicResource GroupBoxHeaderPadding}">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </TextBlock>
                                <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource HeadingRuleBrush}"
                                         IsTabStop="False" Focusable="False" />
                            </StackPanel>
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
