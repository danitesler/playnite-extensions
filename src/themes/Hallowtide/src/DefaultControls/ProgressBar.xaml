<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Quest progress rail: an 8px ink groove (ProgressBarTrackBrush, 1px NormalBorderBrush edge, radius 4) filled with paper
        (ProgressBarForegroundBrush). A lantern mote (PrimaryButtonGlowBrush, mote.png, 14px) rides the fill's leading edge.
        Indeterminate: Default's Animation layer, but it holds a soft-ended paper bar (gradient OpacityMask) that glides across
        the groove through a Viewbox, so the bar needs no knowledge of the width. The loop stops when IsIndeterminate ends.
    -->

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{DynamicResource NormalBorderBrush}"
                            Background="{TemplateBinding Background}" CornerRadius="4">
                        <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Rectangle Name="PART_Track" Margin="0" />
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                <Grid>
                                    <Border x:Name="Fill" Background="{TemplateBinding Foreground}" CornerRadius="3" />
                                    <Grid x:Name="Animation" Visibility="Hidden" ClipToBounds="True">
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="100" Height="1">
                                                <Rectangle x:Name="Runner" Canvas.Left="-45" Width="45" Height="1"
                                                           Fill="{TemplateBinding Foreground}">
                                                    <Rectangle.OpacityMask>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#00000000" Offset="0" />
                                                            <GradientStop Color="#FF000000" Offset="0.35" />
                                                            <GradientStop Color="#FF000000" Offset="0.65" />
                                                            <GradientStop Color="#00000000" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                    <Rectangle x:Name="Spark" Width="14" Height="14" Margin="0,0,-7,0"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{ThemeFile 'Images/fx/mote.png'}" Stretch="Fill" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                            </Decorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Value" Value="0">
                            <Setter TargetName="Spark" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Animation" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Fill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Spark" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RunnerStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Runner" Storyboard.TargetProperty="(Canvas.Left)"
                                                         From="-45" To="100" Duration="0:0:1.7">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunnerStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
