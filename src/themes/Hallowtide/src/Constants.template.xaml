<!--
    Hallowtide: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). The quest book's token names stay in
    tokens.css; each placeholder here names the token that plays the key's role.

    Roles: void (the plum-black night) is every shell surface, ink plates are cards and controls, parchment is a
    content page (description, notes, metadata, tooltips, the Play plate), lantern orange is the accent on dark,
    dream blue marks the current place and focus, wisp violet marks links, wax red marks something that is on,
    dialogue teal is every popup, neon red is danger.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography. Gelasio (book serif) is the body, Cinzel the carved caps of page headings, Barlow Semi Condensed
         the prompt face of buttons and menus, Patrick Hand the felt pen of pinned notes. All four are bundled in
         src/Typography. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">21</sys:Double>
    <sys:Double x:Key="FontSizeLargest">30</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Gelasio, Gelasio, Georgia</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Cinzel, Cinzel, Georgia</FontFamily>
    <FontFamily x:Key="UIFontFamily">./Typography/#Barlow Semi Condensed, Barlow Semi Condensed, Segoe UI</FontFamily>
    <FontFamily x:Key="NoteFontFamily">./Typography/#Patrick Hand, Patrick Hand, Segoe Print</FontFamily>

    <!-- Usable metadata content width; apply inside the pane's horizontal padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape. Plates are hand-cut, so the medium step is a soft 6px; capsules are for the choice pill only. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius-ink}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-large}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:radius-xlarge}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{bone}}</Color>
    <Color x:Key="TextColorDarker">{{bone-mute}}</Color>
    <Color x:Key="TextColorDark">{{ink-text}}</Color>
    <Color x:Key="MainColor">{{ink-dark}}</Color>
    <Color x:Key="MainColorDark">{{ink-black}}</Color>
    <Color x:Key="HoverColor">{{ink}}</Color>
    <Color x:Key="GlyphColor">{{lantern}}</Color>
    <Color x:Key="HighlightGlyphColor">{{lantern/24}}</Color>
    <Color x:Key="PopupBackgroundColor">{{dialogue}}</Color>
    <Color x:Key="PopupBorderColor">{{dialogue-edge}}</Color>
    <Color x:Key="BackgroundToneColor">{{void-plum}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">#00000000</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{ink-lit}}</Color>
    <Color x:Key="DataChangeNotifColor">{{pin-lit}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{ink-rule}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{paper-lit}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{ink-well}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{moss}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{neon-lit}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{gold}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{neon-lit}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{ink-dark}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{void-wine}}" />

    <!-- Shell: the plum-black night, three layers -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{void-deep}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{void-plum}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{ink-well}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{ink-dark}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{pin}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{bone}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{ink-rule}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{ink-lit}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{void-deep/72}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{void-aubergine/38}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the theme's
         own ArtTint color, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{void-aubergine}}" />

    <!-- States: the highlighted contents entry is indigo, focus is the wand's blue light -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{dream-plate}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{dream-glow/55}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{bone}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{dream-plate}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{dialogue-lit}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{dream-glow}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{dream-glow/45}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{neon}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{bone}}" />

    <!-- Buttons: ink plates; Play is the torn parchment plate lit from below by the lantern -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{bone}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{ink-lit}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{ink-black}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{paper-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{paper-glow}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{paper-shade}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{ink-text}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{lantern}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{ink-lit}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{ink-black}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{paper-lit}}" />

    <!-- Inputs: ink wells with a paper underline -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{ink-well}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{ink-dark}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{ink-rule}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{bone-mute}}" />
    <SolidColorBrush x:Key="InputUnderlineBrush" Color="{{paper-shade}}" />
    <SolidColorBrush x:Key="InputHoverUnderlineBrush" Color="{{paper-glow}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{bone-dim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{lantern}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{lantern/25}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{ink-rule}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{paper-lit}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{lantern}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{paper-lit}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{ink-black}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{ink-rule}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{paper-shade}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{ink-black/60}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{ink-rule}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{paper-shade}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{bone-mute}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{bone}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{dream-tab}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{ink-lit}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{lantern}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{dream-glow}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{paper-lit}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{bone-mute}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{bone}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{dream-glow/35}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{bone}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{dream-plate}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{wisp-link}}" />

    <!-- Popups: the dialogue box is teal, a tooltip is a pinned note -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{dialogue-edge}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{ink-text}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{void-plum}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{bone}}" />

    <!-- Frames: the inked rope border and its inner groove -->
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{ink-lit}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{ink-rule}}" />

    <!-- Paper: a quest page -->
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{paper-lit}}" />
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{paper-burn}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{ink-text}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{ink-black}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{ink-label}}" />
    <SolidColorBrush x:Key="ParchmentLinkBrush" Color="{{wisp-link}}" />

    <!-- Typography -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{bone}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{ink-rule}}" />

    <!-- Game page -->
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{void}}" />
</ResourceDictionary>
