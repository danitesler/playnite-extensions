<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <!--
        Hallowtide Common: spacing, focus and the hand-inked ornament templates every control draws from.
        Sprites are white masks in Images/fx (generated by art/sprites.py), filled with theme brushes through
        OpacityMask so ThemeModifier recolours them. Corners stay fixed, edges tile: the edge profiles are periodic.
        Quest book spacing: plates 14x5, wells 10x5, rows 10x6 (the contents list rows are about 30px tall).
    -->

    <Style x:Key="BaseStyle" TargetType="Control">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Popups are the dialogue box: deep teal with a 1px edge. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    </Style>

    <!-- Keyboard focus is the wand's light: a dashed blue ring one pixel off the plate. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="7" RadiusY="7" StrokeThickness="1.5" StrokeDashArray="2 2"
                               Stroke="{DynamicResource FocusBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="4" RadiusY="4" StrokeThickness="1.5" StrokeDashArray="2 2"
                               Stroke="{DynamicResource FocusBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Spacing -->
    <Thickness x:Key="ButtonPadding">14,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">6</Thickness>
    <Thickness x:Key="MenuItemPadding">10,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">6</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,10</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">0</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">15</sys:Double>
    <Thickness x:Key="TooltipPadding">16,12,16,12</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">18</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- Section heading: carved caps in the page-header face. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>

    <!-- InkFrameTemplate: the book's hand-inked rope border (rope-frame.png, 120 DIP square, corners 36, edge tile 48).
         Host Foreground is the ink. No fill: a frame laid around a page or panel; keep content inside by margin. -->
    <ControlTemplate x:Key="InkFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/rope-frame.png'}" Viewbox="0,0,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/rope-frame.png'}" Viewbox="36,0,48,36" ViewboxUnits="Absolute" Viewport="0,0,48,36" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/rope-frame.png'}" Viewbox="84,0,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/rope-frame.png'}" Viewbox="0,36,36,48" ViewboxUnits="Absolute" Viewport="0,0,36,48" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/rope-frame.png'}" Viewbox="84,36,36,48" ViewboxUnits="Absolute" Viewport="0,0,36,48" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/rope-frame.png'}" Viewbox="0,84,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/rope-frame.png'}" Viewbox="36,84,48,36" ViewboxUnits="Absolute" Viewport="0,0,48,36" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/rope-frame.png'}" Viewbox="84,84,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- TornPlateTemplate: a solid plate with torn edges (plate-torn.png, 72 DIP, corners 20, edge tile 32). Host
         Background is the paper. A layer behind content: it has no content presenter. -->
    <ControlTemplate x:Key="TornPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="7" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="0,0,20,20" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="20,0,32,20" ViewboxUnits="Absolute" Viewport="0,0,32,20" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="52,0,20,20" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="0,20,20,32" ViewboxUnits="Absolute" Viewport="0,0,20,32" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="52,20,20,32" ViewboxUnits="Absolute" Viewport="0,0,20,32" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="0,52,20,20" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="20,52,32,20" ViewboxUnits="Absolute" Viewport="0,0,32,20" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-torn.png'}" Viewbox="52,52,20,20" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- InkPlateTemplate: brush-stroke plate with dry-brush ends (plate-ink.png, 64 DIP, corners 16, edge tile 32),
         drawn at 0.75 scale (cells 12, tile 24) so a 28px row or a chip still has a middle. Host Background is the ink. -->
    <ControlTemplate x:Key="InkPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
            </Grid.RowDefinitions>
            <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="7,2" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-ink.png'}" Viewbox="0,0,16,16" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-ink.png'}" Viewbox="16,0,32,16" ViewboxUnits="Absolute" Viewport="0,0,24,12" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-ink.png'}" Viewbox="48,0,16,16" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-ink.png'}" Viewbox="0,16,16,32" ViewboxUnits="Absolute" Viewport="0,0,12,24" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-ink.png'}" Viewbox="48,16,16,32" ViewboxUnits="Absolute" Viewport="0,0,12,24" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-ink.png'}" Viewbox="0,48,16,16" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-ink.png'}" Viewbox="16,48,32,16" ViewboxUnits="Absolute" Viewport="0,0,24,12" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-ink.png'}" Viewbox="48,48,16,16" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- GlowFrameTemplate: lantern bloom around a plate (glow-frame.png, 128 DIP, corners 44, edge tile 40). Host
         Foreground is the light; the host sits at a negative margin of 30 so the lit core hides behind the plate. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}" Opacity="0.55" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,84,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- DividerTemplate: the book's thorn rule with the spiral flourish in the middle (thorn-tile.png 48x14 tile,
         spiral-pair.png 76x18). Host Foreground is the ink; height is fixed at 18, width is free. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="18" ClipToBounds="True" IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Height="14" Margin="0,0,-6,0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/thorn-tile.png'}" Viewport="0,0,48,14" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/spiral-pair.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Column="2" Height="14" Margin="-6,0,0,0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/thorn-tile.png'}" Viewport="0,0,48,14" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- SerpentRibbonTemplate: the page-header ribbon (serpent-ribbon.png, 360x44, head on the right). Host
         Foreground is the ink. Fixed size, no layout: lay it in a Canvas or a clipped Grid. -->
    <ControlTemplate x:Key="SerpentRibbonTemplate" TargetType="Control">
        <Rectangle Width="360" Height="44" Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/serpent-ribbon.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- PinTemplate: a wax push pin, 20x20. Host Background is the head, Foreground its lit crescent. -->
    <ControlTemplate x:Key="PinTemplate" TargetType="Control">
        <Grid Width="20" Height="20" IsHitTestVisible="False">
            <Ellipse Width="14" Height="14" Margin="5,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Fill="{DynamicResource ScrimBrush}" />
            <Ellipse Width="14" Height="14" Margin="2,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Fill="{TemplateBinding Background}" Stroke="{DynamicResource ParchmentEdgeBrush}" StrokeThickness="0.8" />
            <Path Data="M5,8 C5,5 7.5,3.6 10,3.8 C8,4.4 6.6,5.8 6.4,8.6 Z" Fill="{TemplateBinding Foreground}" Opacity="0.75" />
        </Grid>
    </ControlTemplate>

    <!-- SteamScreenshotsSkeletonTemplate: while the Steam Screenshots add-on loads, a 16:9 plate over a row of five
         thumbnails breathes in the host's Foreground (a loop that only runs while the host is visible). -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel x:Name="Root" IsHitTestVisible="False" Opacity="0.4">
            <Border Background="{TemplateBinding Foreground}" Opacity="0.4" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{TemplateBinding Foreground}" Opacity="0.4" CornerRadius="{DynamicResource CornerRadiusSmall}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Grid.Column="2" Background="{TemplateBinding Foreground}" Opacity="0.4" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Grid.Column="4" Background="{TemplateBinding Foreground}" Opacity="0.4" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Grid.Column="6" Background="{TemplateBinding Foreground}" Opacity="0.4" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                <Border Grid.Column="8" Background="{TemplateBinding Foreground}" Opacity="0.4" CornerRadius="{DynamicResource CornerRadiusSmall}" />
            </Grid>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Breathe">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0.45" To="1" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Breathe" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- BookmarkTemplate: a hanging ribbon with a notched tail. Host Background is the ribbon, BorderBrush its edge.
         The notch is a fixed 9px; the ribbon takes the host's height. -->
    <ControlTemplate x:Key="BookmarkTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="9" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Fill="{TemplateBinding Background}" />
            <Path Grid.Row="1" Stretch="Fill" Data="M0,0 L1,0 L1,1 L0.5,0.15 L0,1 Z" Fill="{TemplateBinding Background}" />
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
