<!--
    Hallowtide: SearchBox. Quest book part: an ink well with a paper rule under it, the same well as TextBox. Keys:
    Background (the style's InputBackgroundBrush, hover InputHoverBackgroundBrush; Views top bar uses
    TopPanelSearchBoxBackgroundBrush), InputBorderBrush / InputHoverBorderBrush (1px edge), InputUnderlineBrush /
    InputHoverUnderlineBrush (2px rule inside the bottom edge), FocusBrush and FocusHaloBrush (focus edge and the 2px
    halo ring, fades in 0.12s), GlyphBrush (underline and magnifier while focused or typed), TextBrushDarker (empty
    magnifier, clear glyph), BareTextBox (Group A), IconSearch and IconClear (Media.xaml). Radius CornerRadiusSmall.
    The magnifier is the named Glyph, outside PART_SeachIcon (Playnite hides that one while focused or filled), 16px at
    10px from the left; the text starts at 34 and keeps 32px on the right for the clear glyph. ShowImage False collapses
    it. PART_ClearTextIcon keeps a transparent Border around its glyph so the whole glyph area takes the click.
    Keeps PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="FocusRing" Margin="-2" BorderThickness="2" CornerRadius="5"
                                BorderBrush="{DynamicResource FocusHaloBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}">
                            <Grid>
                                <Rectangle x:Name="Underline" Height="2" Margin="2,0" VerticalAlignment="Bottom"
                                           Fill="{DynamicResource InputUnderlineBrush}" IsHitTestVisible="False" />
                                <Viewbox Width="16" Height="16" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         IsHitTestVisible="False" Panel.ZIndex="1">
                                    <ContentControl x:Name="Glyph" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}"
                                                    Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                </Viewbox>
                                <ContentControl x:Name="PART_SeachIcon" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                         Padding="34,0,32,0" VerticalContentAlignment="Center" />
                                <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,6,0" Cursor="Hand" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ContentControl.Template>
                                        <ControlTemplate TargetType="ContentControl">
                                            <Border Background="Transparent" Padding="4">
                                                <ContentPresenter ContentSource="Content" />
                                            </Border>
                                        </ControlTemplate>
                                    </ContentControl.Template>
                                </ContentControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                            <Setter TargetName="Underline" Property="Fill" Value="{DynamicResource InputHoverUnderlineBrush}" />
                        </Trigger>

                        <!-- Keep the magnifier visible while Playnite hides its placeholder: color changes only. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="Underline" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
