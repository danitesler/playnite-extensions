<!--
    Hallowtide PathSelectionBox: the TextBox's ink well (InputBackgroundBrush, 1px InputBorderBrush rim, 2px
    InputUnderlineBrush rule, InputHover*, FocusBrush rim + GlyphBrush rule + FocusHaloBrush ring on keyboard focus) with
    the two pick buttons beside it as SecondaryButton plates, ControlHeight square: the folder (IconExplorer) and a
    page glyph drawn inline, both stroked in the button's own foreground. MinHeight is ControlHeight; Padding is
    InputPadding and reaches PART_ContentHost from WPF. Part names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type PathSelectionBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <DockPanel>
                        <Button x:Name="PART_ButtonDirectorySelect" DockPanel.Dock="Right" Margin="6,0,0,0"
                                Style="{DynamicResource SecondaryButton}" Width="{DynamicResource ControlHeight}"
                                MaxHeight="{TemplateBinding ActualHeight}"
                                Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}"
                                ToolTip="{DynamicResource LOCSelectDirectoryTooltip}" />
                        <Button x:Name="PART_ButtonFileSelect" DockPanel.Dock="Right" Margin="6,0,0,0"
                                Style="{DynamicResource SecondaryButton}" Width="{DynamicResource ControlHeight}"
                                MaxHeight="{TemplateBinding ActualHeight}"
                                ToolTip="{DynamicResource LOCSelectFileTitle}">
                            <Viewbox Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M6.5,3.5 H13.5 L18.5,8.5 V20.5 H6.5 Z M13.5,3.5 V8.5 H18.5" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Halo" Margin="-2" CornerRadius="5" BorderThickness="2" Opacity="0" IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource FocusHaloBrush}" />
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource CornerRadiusSmall}">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                                  HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                                    <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,2,2" IsHitTestVisible="False"
                                            Background="{DynamicResource InputUnderlineBrush}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource InputHoverUnderlineBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource GlyphBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
