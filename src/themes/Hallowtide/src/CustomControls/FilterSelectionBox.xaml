<!--
    Hallowtide FilterSelectionBox: the filter panel's dropdowns as the same ink well as TextBox and ComboBox
    (InputBackgroundBrush, 1px InputBorderBrush rim, 2px InputUnderlineBrush rule, InputHover*, FocusBrush rim, GlyphBrush
    rule and FocusHaloBrush ring on focus or while open). Text, clear button and chevron each get their own space: a star
    column for the text, a 22px column for the clear X (it shows while the well is hovered), and an Auto column for the
    IconDropDown chevron in GlyphBrush, so they never overlap. The dropdown is a PopupBorder panel on
    PopupBackgroundBrush with ComboBoxDropDownPadding; its rows are check boxes on UIFontFamily Medium that light up in
    MenuItemHoverBrush. Every part Playnite looks for keeps its name. The styles below keep the shared ControlHeight
    (the filter panel sets 28px on its own keyed styles).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="FilterSelectionBoxTemplate" TargetType="{x:Type FilterSelectionBoxBase}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Halo" Margin="-2" CornerRadius="5" BorderThickness="2" Opacity="0" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource FocusHaloBrush}" />
            <Border x:Name="Root" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="{DynamicResource ControlBorderThickness}" CornerRadius="{DynamicResource CornerRadiusSmall}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PART_TextFilterString" Grid.Column="0" Style="{StaticResource BaseTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               Margin="10,0,4,0" />
                    <ContentPresenter x:Name="Chevron" Grid.Column="2" Margin="2,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                                      Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                      TextElement.Foreground="{DynamicResource GlyphBrush}">
                        <ContentPresenter.RenderTransform>
                            <RotateTransform x:Name="ChevronTurn" Angle="0" />
                        </ContentPresenter.RenderTransform>
                    </ContentPresenter>
                    <ToggleButton x:Name="MainToggle" Grid.Column="0" Grid.ColumnSpan="3"
                                  BorderThickness="0" Focusable="False"
                                  HorizontalContentAlignment="Stretch"
                                  Background="Transparent">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBox x:Name="PART_TextFilterInput" Grid.Column="0" Style="{DynamicResource BareTextBox}" BorderThickness="0"
                             VerticalAlignment="Center" Margin="10,0,4,0" MinHeight="0" />
                    <Button x:Name="PART_ButtonClearFilter" Grid.Column="1" Width="20" Height="20" Padding="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0"
                            Background="Transparent"
                            Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconSmallTemplate}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border x:Name="Underline" Grid.Column="0" Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom"
                            CornerRadius="0,0,2,2" IsHitTestVisible="False"
                            Background="{DynamicResource InputUnderlineBrush}" />
                    <Popup Placement="Bottom" VerticalOffset="3" Focusable="False" AllowsTransparency="True" Name="Popup"
                           IsOpen="{Binding IsChecked, ElementName=MainToggle, Mode=TwoWay, Delay=100}" StaysOpen="False"
                           MaxHeight="300" MinWidth="{Binding ActualWidth, ElementName=MainToggle}">
                        <Border x:Name="PopupRoot" Style="{DynamicResource PopupBorder}" Padding="{DynamicResource ComboBoxDropDownPadding}">
                            <ItemsControl x:Name="PART_ItemsPanel" />
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource InputHoverUnderlineBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource GlyphBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger SourceName="MainToggle" Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource GlyphBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PopupRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="FilterSelectionBoxItemStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontFamily" Value="{DynamicResource UIFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type FilterEnumSelectionBox}" BasedOn="{StaticResource {x:Type FilterEnumSelectionBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
    <Style TargetType="{x:Type FilterStringSelectionBox}" BasedOn="{StaticResource {x:Type FilterStringSelectionBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
    <Style TargetType="{x:Type FilterSelectionBox}" BasedOn="{StaticResource {x:Type FilterSelectionBox}}">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
    </Style>
</ResourceDictionary>
