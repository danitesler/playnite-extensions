<!--
    Hallowtide: SidebarItem. Quest book part: the blue bookmark tabs on the page edge. A 44x40 cell with a 16px glyph.
    Keys: SidebarItemForegroundBrush (idle), TextBrush (hover), SidebarItemSelectedForegroundBrush (current),
    TopPanelItemHoverBackgroundBrush (hover ink plate, InkPlateTemplate), TabItemIndicatorBrush (the current blue tab),
    GlyphBrush (2px lantern line on the item's edge), SidebarItemSelectedGlowBrush (bloom behind, GlowFrameTemplate),
    WarningBrush (an item with no icon). Hover fades the ink plate in; current: the blue plate slides in from the edge
    (Width 0 to 44 in 0.18s) and ends in a tab ear (0,8,8,0) at the rail edge, with the glow fading in behind it.
    The glyph area is a fixed 14,12 padding (16x16); IconPadding is not added on top, it would collapse the Viewbox.
    Library and Statistics get the theme's glyphs. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Control x:Name="SelectedGlow" Template="{DynamicResource GlowFrameTemplate}"
                                 Foreground="{DynamicResource SidebarItemSelectedGlowBrush}" Margin="-30" Visibility="Collapsed"
                                 IsTabStop="False" Focusable="False" IsHitTestVisible="False" />
                        <Border x:Name="Plate" Margin="4" Background="{TemplateBinding Background}" IsHitTestVisible="False" />
                        <Control x:Name="HoverPlate" Template="{DynamicResource InkPlateTemplate}"
                                 Background="{DynamicResource TopPanelItemHoverBackgroundBrush}" Margin="4" Opacity="0"
                                 IsTabStop="False" Focusable="False" IsHitTestVisible="False" />
                        <Border x:Name="SelectedPlate" Width="44" HorizontalAlignment="Left" CornerRadius="0,8,8,0"
                                Background="{DynamicResource TabItemIndicatorBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Rectangle x:Name="EdgeLine" Width="2" Margin="0,8" HorizontalAlignment="Left"
                                   Fill="{DynamicResource GlyphBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border Padding="14,12">
                            <Viewbox x:Name="ItemIcon">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                        </Border>
                        <Viewbox x:Name="SetIcon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="Collapsed" IsHitTestVisible="False">
                            <ContentControl x:Name="SetIconContent" ContentTemplate="{DynamicResource IconTemplate}"
                                            IsTabStop="False" Focusable="False" />
                        </Viewbox>
                        <ProgressBar x:Name="PART_ProgressStatus" Height="3" MinHeight="0" Margin="8,0,8,3" BorderThickness="0" Background="Transparent"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedGlow" />
                            <Setter Property="Visibility" Value="Visible" TargetName="EdgeLine" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="HoverPlate" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Width" From="0" To="44" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelectedGlow" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="HorizontalAlignment" Value="Right" TargetName="SelectedPlate" />
                            <Setter Property="CornerRadius" Value="8,0,0,8" TargetName="SelectedPlate" />
                            <Setter Property="HorizontalAlignment" Value="Right" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="HorizontalAlignment" Value="Center" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="EdgeLine" />
                            <Setter Property="Width" Value="20" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="2" TargetName="EdgeLine" />
                            <Setter Property="Margin" Value="0" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="HorizontalAlignment" Value="Center" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="EdgeLine" />
                            <Setter Property="Width" Value="20" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="2" TargetName="EdgeLine" />
                            <Setter Property="Margin" Value="0" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIconContent" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIconContent" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
