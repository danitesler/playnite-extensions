<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite
        swaps Play for the context action (RUNNING): a 0.12 violet tint, a 1px frame and a tapered ink line along the
        plate's foot, with three wisps at the far end. LAUNCHING: the line fills as the brush crosses the plate and the
        wisps lift off as it lands (2s loop). RUNNING: the line stays full and the wisps drift up (3.6s).
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching).
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Control x:Name="RunningWash" Template="{DynamicResource TornPlateTemplate}" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" Focusable="False" IsTabStop="False" />
                        <Border x:Name="RunningFrame" Margin="3" CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" />
                        <Grid Height="3" Margin="16,0,16,9" VerticalAlignment="Bottom">
                            <Path Stretch="Fill" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" Data="M0,0 L100,0.9 L100,1.3 L0,3 Z" />
                            <Path x:Name="RunningFill" Stretch="Fill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5" Data="M0,0 L100,0.9 L100,1.3 L0,3 Z">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <Grid Width="26" Height="24" Margin="0,0,18,10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Ellipse x:Name="RunningMote1" Width="5" Height="5" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="RunningMote1Move" Y="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="RunningMote2" Width="6" Height="6" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="RunningMote2Move" Y="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="RunningMote3" Width="5" Height="5" Margin="18,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="RunningMote3Move" Y="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.28" Value="0.9" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1Move" Storyboard.TargetProperty="Y" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="-10" KeySpline="0.2,0.5 0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="-10" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.43" Value="0.9" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.95" Value="0" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2Move" Storyboard.TargetProperty="Y" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.95" Value="-10" KeySpline="0.2,0.5 0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="-10" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.58" Value="0.9" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="0" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3Move" Storyboard.TargetProperty="Y" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="-10" KeySpline="0.2,0.5 0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="-10" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="0.85" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote1Move" Storyboard.TargetProperty="Y" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-10" KeySpline="0.3,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="-10" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.85" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.5" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote2Move" Storyboard.TargetProperty="Y" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.5" Value="-10" KeySpline="0.3,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="-10" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.85" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMote3Move" Storyboard.TargetProperty="Y" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="-10" KeySpline="0.3,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="-10" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the sweep has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--
        Play: the torn "Travel to" label of the quest book's world map, lit from below by the lantern.
        Layers, bottom to top: lantern bloom (GlowFrameTemplate, PrimaryButtonGlowBrush), the torn parchment plate
        (PrimaryButtonBackgroundBrush), a hover plate (PrimaryButtonHoverBackgroundBrush), a pressed plate
        (PrimaryButtonPressedBackgroundBrush), five fireflies, an ink underline that is written under the label, the label
        (Cinzel SemiBold, PrimaryButtonForegroundBrush). Hover fades the plates and the bloom in over 0.2 s, starts the
        fireflies drifting up (a loop that only runs while hovered), and writes the underline; leaving fades back over 0.35 s.
        Every animated transform is named and driven from the template triggers.
    -->
    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="22,6" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Grid" Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="Bloom" IsTabStop="False" Focusable="False" Template="{DynamicResource GlowFrameTemplate}" Margin="-30"
                                 Foreground="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0.18" />
                        <Control x:Name="Plate" IsTabStop="False" Focusable="False" Template="{DynamicResource TornPlateTemplate}"
                                 Background="{TemplateBinding Background}" />
                        <!-- Running and launching only, in the plate's torn shape and under the label. RunningBreath: a ScrimBrush layer over the solid running-colour plate (ScrimBrush is 72% void: launching holds 0.14, running breathes 0.05 to 0.16) so the dark ink keeps its contrast. RunningScan: the dry brush in cream (TextBrush: a band in the running colour would vanish on that plate), launching only. -->
                        <Control x:Name="RunningBreath" IsTabStop="False" Focusable="False" Template="{DynamicResource TornPlateTemplate}"
                                 Background="{DynamicResource ScrimBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Control x:Name="RunningScan" IsTabStop="False" Focusable="False" Template="{DynamicResource TornPlateTemplate}"
                                 Background="{DynamicResource TextBrush}" Opacity="0.5" Visibility="Collapsed" IsHitTestVisible="False">
                            <Control.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="RunningScanA" Color="#00000000" Offset="-0.5" />
                                    <GradientStop x:Name="RunningScanB" Color="#8C000000" Offset="-0.42" />
                                    <GradientStop x:Name="RunningScanC" Color="#33000000" Offset="-0.36" />
                                    <GradientStop x:Name="RunningScanD" Color="#BF000000" Offset="-0.26" />
                                    <GradientStop x:Name="RunningScanE" Color="#4D000000" Offset="-0.19" />
                                    <GradientStop x:Name="RunningScanF" Color="#F2000000" Offset="-0.1" />
                                    <GradientStop x:Name="RunningScanG" Color="#F2000000" Offset="-0.002" />
                                    <GradientStop x:Name="RunningScanH" Color="#00000000" Offset="0" />
                                </LinearGradientBrush>
                            </Control.OpacityMask>
                        </Control>
                        <Control x:Name="HoverPlate" IsTabStop="False" Focusable="False" Template="{DynamicResource TornPlateTemplate}"
                                 Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Opacity="0" />
                        <Control x:Name="PressedPlate" IsTabStop="False" Focusable="False" Template="{DynamicResource TornPlateTemplate}"
                                 Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0" />
                        <!-- RunningHoverDim: the Cancel state, a second scrim faded in only while a RUNNING button is hovered. Below the label. -->
                        <Control x:Name="RunningHoverDim" IsTabStop="False" Focusable="False" Template="{DynamicResource TornPlateTemplate}"
                                 Background="{DynamicResource ScrimBrush}" Opacity="0" IsHitTestVisible="False" />

                        <Grid x:Name="Motes" IsHitTestVisible="False" Margin="14,0" VerticalAlignment="Bottom" Height="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="Mote1" Grid.Column="0" Width="9" Height="9" Opacity="0" HorizontalAlignment="Center"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/mote.png'}" /></Rectangle.OpacityMask>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="Mote1Move" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Mote2" Grid.Column="1" Width="7" Height="7" Opacity="0" HorizontalAlignment="Center"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/mote.png'}" /></Rectangle.OpacityMask>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="Mote2Move" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Mote3" Grid.Column="2" Width="11" Height="11" Opacity="0" HorizontalAlignment="Center"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/mote.png'}" /></Rectangle.OpacityMask>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="Mote3Move" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Mote4" Grid.Column="3" Width="7" Height="7" Opacity="0" HorizontalAlignment="Center"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/mote.png'}" /></Rectangle.OpacityMask>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="Mote4Move" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Mote5" Grid.Column="4" Width="9" Height="9" Opacity="0" HorizontalAlignment="Center"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/mote.png'}" /></Rectangle.OpacityMask>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="Mote5Move" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <Grid x:Name="Content" Margin="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Rectangle x:Name="Underline" Height="2" Margin="0,0,0,-4" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                       Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.7" IsHitTestVisible="False"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="UnderlineScale" ScaleX="0" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource TextBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Bloom" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Motes" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Underline" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.06" To="0.14" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanA" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanB" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.42" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.08" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.08" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanC" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.36" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.14" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.14" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanD" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.26" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.24" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.24" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanE" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.19" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.31" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.31" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanF" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.4" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanG" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.498" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.498" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanH" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.5" KeySpline="0.5,0 0.5,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Bloom" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Motes" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Underline" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.16" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.05" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.16" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING button is under the pointer. The binding is Self (this button); TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="HoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.05" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard x:Name="FirefliesLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote1Move" Storyboard.TargetProperty="Y" Duration="0:0:1.9">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="-46" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.9">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="0.95" /><LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote2Move" Storyboard.TargetProperty="Y" BeginTime="0:0:0.55" Duration="0:0:1.7">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:1.7" Value="-40" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.55" Duration="0:0:1.7">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.9" /><LinearDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote3Move" Storyboard.TargetProperty="Y" BeginTime="0:0:0.25" Duration="0:0:2.1">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="-54" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.25" Duration="0:0:2.1">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote4Move" Storyboard.TargetProperty="Y" BeginTime="0:0:1.0" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="-36" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote4" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.0" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.85" /><LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote5Move" Storyboard.TargetProperty="Y" BeginTime="0:0:0.8" Duration="0:0:1.8">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="-44" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote5" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.8" Duration="0:0:1.8">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="0.95" /><LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FirefliesLoop" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.35" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.2" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Content" Property="Margin" Value="22,8,22,4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Launching and running keep Play's torn plate, filled with the running colour; the label is the deepest ink (the plate is light), Cancel is set in the template. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ShellBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ShellBackgroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
