<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Play: the torn "Travel to" label of the quest book's world map, lit from below by the lantern.
        Layers, bottom to top: lantern bloom (GlowFrameTemplate, PrimaryButtonGlowBrush), the torn parchment plate
        (PrimaryButtonBackgroundBrush), a hover plate (PrimaryButtonHoverBackgroundBrush), a pressed plate
        (PrimaryButtonPressedBackgroundBrush), five fireflies, an ink underline that is written under the label, the label
        (Cinzel SemiBold, PrimaryButtonForegroundBrush). Hover fades the plates and the bloom in over 0.2 s, starts the
        fireflies drifting up (a loop that only runs while hovered), and writes the underline; leaving fades back over 0.35 s.
        Every animated transform is named and driven from the template triggers.
    -->
    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="22,6" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Grid" Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="Bloom" IsTabStop="False" Focusable="False" Template="{DynamicResource GlowFrameTemplate}" Margin="-30"
                                 Foreground="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0.18" />
                        <Control x:Name="Plate" IsTabStop="False" Focusable="False" Template="{DynamicResource TornPlateTemplate}"
                                 Background="{DynamicResource PrimaryButtonBackgroundBrush}" />
                        <Control x:Name="HoverPlate" IsTabStop="False" Focusable="False" Template="{DynamicResource TornPlateTemplate}"
                                 Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Opacity="0" />
                        <Control x:Name="PressedPlate" IsTabStop="False" Focusable="False" Template="{DynamicResource TornPlateTemplate}"
                                 Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0" />

                        <Grid x:Name="Motes" IsHitTestVisible="False" Margin="14,0" VerticalAlignment="Bottom" Height="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="Mote1" Grid.Column="0" Width="9" Height="9" Opacity="0" HorizontalAlignment="Center"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/mote.png'}" /></Rectangle.OpacityMask>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="Mote1Move" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Mote2" Grid.Column="1" Width="7" Height="7" Opacity="0" HorizontalAlignment="Center"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/mote.png'}" /></Rectangle.OpacityMask>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="Mote2Move" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Mote3" Grid.Column="2" Width="11" Height="11" Opacity="0" HorizontalAlignment="Center"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/mote.png'}" /></Rectangle.OpacityMask>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="Mote3Move" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Mote4" Grid.Column="3" Width="7" Height="7" Opacity="0" HorizontalAlignment="Center"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/mote.png'}" /></Rectangle.OpacityMask>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="Mote4Move" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Mote5" Grid.Column="4" Width="9" Height="9" Opacity="0" HorizontalAlignment="Center"
                                       Fill="{DynamicResource PrimaryButtonGlowBrush}">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/mote.png'}" /></Rectangle.OpacityMask>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="Mote5Move" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <Grid x:Name="Content" Margin="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Rectangle x:Name="Underline" Height="2" Margin="0,0,0,-4" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                       Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.7" IsHitTestVisible="False"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="UnderlineScale" ScaleX="0" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="HoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.05" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard x:Name="FirefliesLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote1Move" Storyboard.TargetProperty="Y" Duration="0:0:1.9">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="-46" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.9">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="0.95" /><LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote2Move" Storyboard.TargetProperty="Y" BeginTime="0:0:0.55" Duration="0:0:1.7">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:1.7" Value="-40" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.55" Duration="0:0:1.7">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.9" /><LinearDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote3Move" Storyboard.TargetProperty="Y" BeginTime="0:0:0.25" Duration="0:0:2.1">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="-54" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.25" Duration="0:0:2.1">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote4Move" Storyboard.TargetProperty="Y" BeginTime="0:0:1.0" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="-36" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote4" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.0" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.85" /><LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote5Move" Storyboard.TargetProperty="Y" BeginTime="0:0:0.8" Duration="0:0:1.8">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="-44" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Mote5" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.8" Duration="0:0:1.8">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="0.95" /><LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="FirefliesLoop" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.35" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.2" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Content" Property="Margin" Value="22,8,22,4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
