<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Scores sit on the parchment pages of the game page, where the rating colours (moss, neon, gold) would vanish on
        paper. The score is a small ink plate with the rating colour as its number, the way the book prints a star rating
        in ink: ButtonBackgroundBrush plate, UIFontFamily SemiBold, rating brushes from Default's triggers.
    -->
    <Style x:Key="TextBlockGameScore" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource UIFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Padding" Value="10,1,10,2" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Positive}">
                <Setter Property="Foreground" Value="{DynamicResource PositiveRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Negative}">
                <Setter Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Mixed}">
                <Setter Property="Foreground" Value="{DynamicResource MixedRatingBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
