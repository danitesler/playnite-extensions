<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Dialog window (Settings, Add-ons, the game editor, every dialog): the quest book's page header. A 44px band
        (WindowChrome CaptionHeight 44, content offset 44) carries the signature graphic, the serpent-headed bark ribbon,
        ghosted into the right end behind the caption buttons. The title is set in carved caps (Cinzel SemiBold) after a
        lantern spiral. The band closes with the thorn rule, which hangs 7px below it. Settings has no Title, so a
        trigger names it from LOCSettingsLabel.
    -->
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource FrameInnerBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <ContentPresenter Margin="0,44,0,0" />
                                <Grid x:Name="Band" Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}">
                                    <Grid ClipToBounds="True" IsHitTestVisible="False">
                                        <Control Template="{DynamicResource SerpentRibbonTemplate}" IsTabStop="False" Focusable="False"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,150,0"
                                                 Foreground="{DynamicResource WindowTitleForegroundBrush}" Opacity="0.17" />
                                    </Grid>
                                    <DockPanel LastChildFill="False">
                                        <Rectangle DockPanel.Dock="Left" Width="14" Height="14" Margin="14,0,8,0" VerticalAlignment="Center"
                                                   Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False">
                                            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/spiral-mark.png'}" /></Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock Text="{TemplateBinding Title}" DockPanel.Dock="Left" VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="17"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}" x:Name="PART_TextTitle" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Rectangle Height="14" VerticalAlignment="Bottom" Margin="0,0,0,-7" IsHitTestVisible="False"
                                               Fill="{DynamicResource HeadingRuleBrush}">
                                        <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/thorn-tile.png'}" Viewport="0,0,48,14" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
