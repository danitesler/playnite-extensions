<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Cover tile frame. Selected: a static blue rope frame (the hand-inked border of the book, GridViewItemSelectedBorderBrush)
        and a blue bookmark ribbon hanging from the top right corner. Hover: the frame is re-inked in lantern light (it
        settles from 1.05 to 1 while fading in) and a red wax pin drops onto the top edge with a small overshoot. Hover and
        selected are separate named layers, so hover never looks selected. Everything is drawn inside a margin of 8, the
        item's own spacing; hovered and selected items rise above their neighbours with Canvas.ZIndex.
    -->
    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <Control x:Name="SelectedFrame" Template="{DynamicResource InkFrameTemplate}" IsTabStop="False" Focusable="False"
                                 Margin="-12" Foreground="{DynamicResource GridViewItemSelectedBorderBrush}" Visibility="Collapsed" />
                        <Control x:Name="SelectedRibbon" Template="{DynamicResource BookmarkTemplate}" IsTabStop="False" Focusable="False"
                                 Width="14" Height="34" Margin="0,-6,12,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Background="{DynamicResource TabItemIndicatorBrush}" Visibility="Collapsed" />
                        <Control x:Name="HoverFrame" Template="{DynamicResource InkFrameTemplate}" IsTabStop="False" Focusable="False"
                                 Margin="-12" Foreground="{DynamicResource GridViewItemHoverBorderBrush}" Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Control.RenderTransform><ScaleTransform x:Name="HoverFrameScale" ScaleX="1.05" ScaleY="1.05" /></Control.RenderTransform>
                        </Control>
                        <ContentPresenter />
                        <Control x:Name="HoverPin" Template="{DynamicResource PinTemplate}" IsTabStop="False" Focusable="False"
                                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-14,0,0" Opacity="0"
                                 Background="{DynamicResource DataChangeNotifBrush}" Foreground="{DynamicResource ParchmentBrush}">
                            <Control.RenderTransform><TranslateTransform x:Name="HoverPinDrop" Y="-18" /></Control.RenderTransform>
                        </Control>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedFrame" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectedRibbon" Property="Visibility" Value="Visible" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="91" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="HoverFrameScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrameScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverPin" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.08" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPinDrop" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.08" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="HoverFrameScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.2" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="HoverFrameScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.2" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPin" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPinDrop" Storyboard.TargetProperty="Y" To="-18" Duration="0:0:0.14" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
