<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is a Persona 5 Calling Card command sheet (LocalCallingCardPanelTemplate, shared by
    ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: ink command card (PopupBackgroundBrush) in a 2px paper edge (PopupBorderBrush), dropped over a 4px offset
      screaming-red slab (SelectedBrush, no DropShadowEffect), with a 5px horizontal paper sawtooth tear (FrameBrush
      through a tiled triangle mask) along the top inside a 2px red crown.
    - Rows, rules and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalCallingCardPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <!-- 4px offset screaming-red slab -->
            <Border Margin="4,4,0,0" Background="{DynamicResource SelectedBrush}" />
            <!-- Main ink command card in a 2px paper edge -->
            <Border Margin="0,0,4,4" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="2" />
            <!-- 2px red crown + 5px horizontal paper sawtooth tear along the top inner edge -->
            <Rectangle Height="2" Margin="2,2,6,0" VerticalAlignment="Top" Fill="{DynamicResource SelectedBrush}" />
            <Rectangle Height="5" Margin="2,4,6,0" VerticalAlignment="Top" SnapsToDevicePixels="False"
                       Fill="{DynamicResource FrameBrush}">
                <Rectangle.OpacityMask>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,10,5" ViewportUnits="Absolute"
                                  Viewbox="0,0,10,5" ViewboxUnits="Absolute" Stretch="Fill">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#FF000000" Geometry="M 0,0 L 5,5 L 10,0 Z" />
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="232" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalCallingCardPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="4,12,8,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
