<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml. A menu section: no fill and no box. The title in heavy
    condensed capitals (HeadingFontFamily, GroupBoxHeaderFontSize 20, HeadingForegroundBrush) behind a short red slash
    (a 6 x 18 parallelogram in GlyphBrush, the stripes Tactica runs beside its commands), over a hard 2px ash rule
    (TopPanelSeparatorBrush), then the body (GroupBoxPadding: 10 above, 4 below). Without a header only the body shows.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel Background="{TemplateBinding Background}">
                        <StackPanel x:Name="HeaderPanel" DockPanel.Dock="Top">
                            <DockPanel Margin="{DynamicResource GroupBoxHeaderMargin}">
                                <Border DockPanel.Dock="Left" Width="6" Height="18" Margin="3,0,10,0" VerticalAlignment="Center"
                                        Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <SkewTransform AngleX="-12" />
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock Style="{DynamicResource BaseTextBlockStyle}" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                           Foreground="{DynamicResource HeadingForegroundBrush}"
                                           FontSize="{DynamicResource GroupBoxHeaderFontSize}">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </TextBlock>
                            </DockPanel>
                            <Border Height="2" Background="{DynamicResource TopPanelSeparatorBrush}" />
                        </StackPanel>
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                          Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderPanel" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
