<!--
    Overlay on Playnite Default/DefaultControls/TextBox.xaml. A field is a recessed coal plate (InputBackgroundBrush) in
    a 2px smoke edge (InputBorderBrush), square, paper text, InputPadding (34 tall). Hover: the edge turns paper
    (InputHoverBorderBrush). Keyboard focus: the edge turns red (GlyphBrush), the way the menus light the field being
    typed into. Selection is red at 40%.
    BareTextBox: no chrome, for hosts that draw their own (search box, editable dropdown).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LocalCallingCardFieldTemplate: a calling card's slashed paper sliver. A skewed strip of paper juts out under the
        field's bottom-left edge (4px tall, a third of the width), the way the menus stack a white sliver behind a black
        plate. Hover: the sliver lengthens to two thirds. Keyboard focus: it turns red and runs the full width, and a red
        five-point star stamps onto the top-right corner (scale 1.4 to 1, 0.14s). State is read from the nearest Control
        above; no desired size.
    -->
    <ControlTemplate x:Key="LocalCallingCardFieldTemplate" TargetType="{x:Type Control}">
        <Grid x:Name="Root" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SliverCol" Width="1*" />
                <ColumnDefinition x:Name="RestCol" Width="2*" />
            </Grid.ColumnDefinitions>
            <Rectangle x:Name="Sliver" Grid.Column="0" Height="4" VerticalAlignment="Bottom" Margin="4,0,0,-4" Fill="{DynamicResource SelectedForegroundBrush}">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-30" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Path x:Name="Star" Grid.Column="1" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                  Stretch="Fill" Fill="{DynamicResource DangerBrush}" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                  Data="M10,0 L12.4,7.2 L20,7.3 L13.9,11.8 L16.2,19 L10,14.6 L3.8,19 L6.1,11.8 L0,7.3 L7.6,7.2 Z">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="StarScale" ScaleX="1" ScaleY="1" />
                </Path.RenderTransform>
            </Path>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <Setter TargetName="SliverCol" Property="Width" Value="2*" />
                <Setter TargetName="RestCol" Property="Width" Value="1*" />
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Sliver" Property="Fill" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="Sliver" Property="Grid.ColumnSpan" Value="2" />
                <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Stamp">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="StarScale" Storyboard.TargetProperty="ScaleX" From="1.4" To="1" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="StarScale" Storyboard.TargetProperty="ScaleY" From="1.4" To="1" Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Stamp" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border" BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <Control x:Name="FieldOverlay" Template="{DynamicResource LocalCallingCardFieldTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="Border" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No fill, no edge, no padding: the host (search box, editable dropdown) draws the field. -->
    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
