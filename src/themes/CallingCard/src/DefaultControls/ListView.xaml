<!--
    Overlay on Playnite Default/DefaultControls/ListView.xaml (the row only; the list, its column headers and the header
    scroll viewer are Playnite's). Library list view rows: Default's row in the details rows' hover and selected fills, plus the running game:
    a running-colour tint and 1px frame around the row and an HP-gauge sliver under the far end (same as DetailsViewItemStyle), above both fills.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,1,0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Grid>
                        <Rectangle x:Name="HoverRectangle" Visibility="Collapsed" Fill="{DynamicResource ListItemHoverBrush}" />
                        <Rectangle x:Name="SelectedRectangle" Visibility="Collapsed" Fill="{DynamicResource ListItemSelectedBrush}" />
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Grid Margin="3,0,7,3" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <SkewTransform AngleX="-12" />
                                </Grid.RenderTransform>
                                <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.16" />
                                <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.4">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanPre" Color="#00000000" Offset="-0.322" />
                                            <GradientStop x:Name="RunningScanTail" Color="#FF000000" Offset="-0.32" />
                                            <GradientStop x:Name="RunningScanMid" Color="#FF000000" Offset="-0.29" />
                                            <GradientStop x:Name="RunningScanGap" Color="#00000000" Offset="-0.288" />
                                            <GradientStop x:Name="RunningScanGap2" Color="#00000000" Offset="-0.202" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.2" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanCap" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Grid Height="3" Margin="8,0,8,4" VerticalAlignment="Bottom">
                                    <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                    <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                                <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2">
                                    <Border BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1" Opacity="0.7" />
                                </Border>
                                <Path x:Name="RunningStar" Width="14" Height="14" Margin="0,0,18,2" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="None"
                                      Data="M7.0,0 L8.75,5.25 L14,7.0 L8.75,8.75 L7.0,14 L5.25,8.75 L0,7.0 L5.25,5.25 Z" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="RunningStarSpin" Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Grid>
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <GridViewRowPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Stretch" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Selector.IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedRectangle" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="HoverRectangle" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanPre" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.322" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.028" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.028" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.32" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.03" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.03" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanMid" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.29" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.06" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.06" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanGap" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.288" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.062" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.062" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanGap2" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.202" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.148" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.148" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.15" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.35" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanCap" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.352" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.352" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningStarSpin" Storyboard.TargetProperty="Angle" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="180" KeySpline="0.5,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="180" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningStar" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0.6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningStarSpin" Storyboard.TargetProperty="Angle" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="90" KeySpline="0.6,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="90" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningStar" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.7" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.6" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.6" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the scan has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Selector.IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
