<!--
    Overlay on Playnite Default/DerivedStyles/DetailsViewItemStyle.xaml: a row of the game list beside the game page,
    drawn as a command of the pause menu. Rows 1px apart and inset 6px from the list edge (room for the slanted corners),
    transparent at rest (installed: TextBrush; not installed: TextBrushDarker, as Default). Hover: a soot slanted plate
    (SlantPlateTemplate, ListItemHoverBrush, no sliver). Selected: the current command, the red plate
    (ListItemSelectedBrush) with the blue sliver behind it (SelectedBorderBrush), text in SelectedForegroundBrush.
    Keyboard selection is the selection, so there is no separate focus visual.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Padding" Value="10,5,14,7" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Margin="6,0,6,1" Background="Transparent">
                        <Control x:Name="Plate" Visibility="Collapsed" IsHitTestVisible="False" Margin="3,0,7,3"
                                 Template="{DynamicResource SlantPlateTemplate}" Focusable="False" IsTabStop="False"
                                 Background="{DynamicResource ListItemHoverBrush}" Foreground="Transparent" />
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Plate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ListItemSelectedBrush}" />
                            <Setter TargetName="Plate" Property="Foreground" Value="{DynamicResource SelectedBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
