<!--
    Overlay on Playnite Default/DerivedStyles/PropertyItemButton.xaml: the clickable field values of the game overview
    (a click filters the library by that value).
    Default: a value in paper (TextBrush) that turns red (GlyphBrush) and underlines under the pointer; 1px vertical
    margin so link values and plain values stack at the same rhythm.
    Chip: when the owning ItemsControl has Tag="Chip" (platforms, genres, categories, features, tags), a paper label on a
    slanted plate (SlantPlateTemplate, PropertyItemBackgroundBrush, no sliver) with ink text
    (PropertyItemForegroundBrush), semibold FontSizeSmall, 3 x 12 padding, the ransom-note labels of the menus; hover
    turns it into the current command (PropertyItemHoverBackgroundBrush red, blue sliver, TextBrushDark). 4px gaps.
    Keyboard focus: FocusVisual on both.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                               TextWrapping="Wrap" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource PropertyItemBackgroundBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Control x:Name="Plate" Margin="3,0,6,3" IsHitTestVisible="False"
                                         Template="{DynamicResource SlantPlateTemplate}" Focusable="False" IsTabStop="False"
                                         Background="{TemplateBinding Background}" Foreground="Transparent" />
                                <TextBlock x:Name="Text" VerticalAlignment="Center" Margin="12,3,15,6"
                                           FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Plate" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                                    <Setter TargetName="Plate" Property="Foreground" Value="{DynamicResource SelectedBorderBrush}" />
                                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
