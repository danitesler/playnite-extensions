<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml: the Play / Install button on the game page, as the current
    command of the pause menu: a slanted red plate (PrimaryButtonBackgroundBrush) in a 2px paper edge
    (PrimaryButtonBorderBrush) with the blue sliver offset behind it (SelectedBorderBrush), paper text
    (PrimaryButtonForegroundBrush) in heavy condensed capitals (HeadingFontFamily) at FontSizeLarger, at least 44 tall.
    Keyboard focus: FocusVisual. The plate is inset 6px left, 10px right and 4px below so its slanted corners and the sliver
    stay inside the button.
    Hover is the menus' pop (RESEARCH.md -> Motion), quick and with overshoot, both ways, on separate layers:
      in  0.16s: the plate grows 5% with a back-ease overshoot while the brighter red (PrimaryButtonHoverBackgroundBrush)
          fades in over it (0.08s); the blue sliver is thrown 3px further out (0.18s, overshoot); a paper slash cuts across the
          plate once (0.22s). While hovered the sliver wobbles 1.5px (0.5s each way).
      out 0.15s: everything settles back (FillBehavior Stop on every exit).
    Pressed is its own layer: the plate squeezes to 96% and a darker red plate (PrimaryButtonPressedBackgroundBrush) fades in.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages (DataContext: Playnite's
        GameDetailsViewModel, IsRunning / IsLaunching). While the game runs Playnite swaps Play for the context action
        (RUNNING): the context action is a square ink button (Button.xaml, ControlCornerRadius 0); it is tinted HP teal inside a 1px frame with a slanted gauge bar along its foot, breathing; launching jolts in hard steps.
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Grid Margin="6,0,10,4" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <SkewTransform AngleX="-12" />
                            </Grid.RenderTransform>
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.22" />
                            <Grid Height="3" Margin="10,0,10,5" VerticalAlignment="Bottom">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Path x:Name="RunningStar" Width="14" Height="14" Margin="0,0,16,2" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="None"
                                  Data="M7.0,0 L8.75,5.25 L14,7.0 L8.75,8.75 L7.0,14 L5.25,8.75 L0,7.0 L5.25,5.25 Z" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="RunningStarSpin" Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <Border x:Name="RunningFrame" CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningStarSpin" Storyboard.TargetProperty="Angle" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="180" KeySpline="0.5,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="180" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningStar" Storyboard.TargetProperty="Opacity" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0.6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningStarSpin" Storyboard.TargetProperty="Angle" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="90" KeySpline="0.6,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="90" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningStar" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.7" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.6" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.6" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the scan has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="28,6,32,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid x:Name="SliverBreath" Margin="6,0,10,4" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="BreathShift" X="0" Y="0" />
                            </Grid.RenderTransform>
                            <Border x:Name="Sliver" Background="{DynamicResource SelectedBorderBrush}" Margin="4,4,-4,-4" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <SkewTransform AngleX="-12" />
                                        <TranslateTransform x:Name="SliverPopX" X="0" />
                                        <TranslateTransform x:Name="SliverPopY" Y="0" />
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <Grid x:Name="PlateHost" Margin="6,0,10,4" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PlateScale" ScaleX="1" ScaleY="1" />
                                    <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                                    <SkewTransform AngleX="-12" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.4" IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanPre" Color="#00000000" Offset="-0.322" />
                                        <GradientStop x:Name="RunningScanTail" Color="#FF000000" Offset="-0.32" />
                                        <GradientStop x:Name="RunningScanMid" Color="#FF000000" Offset="-0.29" />
                                        <GradientStop x:Name="RunningScanGap" Color="#00000000" Offset="-0.288" />
                                        <GradientStop x:Name="RunningScanGap2" Color="#00000000" Offset="-0.202" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.2" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanCap" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningHoverDim" Background="{DynamicResource ScrimBrush}" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" Opacity="0" IsHitTestVisible="False" />
                            <Grid x:Name="HoverFx">
                                <Border x:Name="HoverPlate" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Margin="{TemplateBinding BorderThickness}" Opacity="0" />
                                <Border x:Name="PressPlate" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Margin="{TemplateBinding BorderThickness}" Opacity="0" />
                            </Grid>
                        </Grid>
                        <Grid x:Name="SlashHost" Margin="6,0,10,4" ClipToBounds="True" IsHitTestVisible="False">
                            <Rectangle x:Name="Slash" Width="16" HorizontalAlignment="Left" Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0" Visibility="Hidden">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <SkewTransform AngleX="-12" />
                                        <TranslateTransform x:Name="SlashShift" X="-30" />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ContentPresenter x:Name="PlayContent" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SlashHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.95" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanPre" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.322" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.028" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.028" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.32" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.03" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.03" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanMid" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.29" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.06" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.06" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanGap" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.288" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.062" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.062" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanGap2" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.202" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.148" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.148" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.15" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.35" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanCap" Storyboard.TargetProperty="Offset" Duration="0:0:1.65">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.352" KeySpline="0.6,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.65" Value="1.352" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SlashHost" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.8" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PlateScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlateScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SliverPopX" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="1.2" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SliverPopY" Storyboard.TargetProperty="Y" To="3" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="1.2" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Slash" Storyboard.TargetProperty="Visibility">
    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
</ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Slash" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.02" Value="0.45" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="0.45" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SlashShift" Storyboard.TargetProperty="X">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-30" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="230" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True" BeginTime="0:0:0.2">
                                        <DoubleAnimation Storyboard.TargetName="BreathShift" Storyboard.TargetProperty="X" From="0" To="1.5" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BreathShift" Storyboard.TargetProperty="Y" From="0" To="1.5" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PlateScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PlateScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SliverPopX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SliverPopY" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BreathShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BreathShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Slash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.05" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Slash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.05" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
                    <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsRunning}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
