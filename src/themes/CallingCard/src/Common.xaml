<!--
    Overlay on Playnite Default/Common.xaml. Spacing, focus and the slanted plate of the Persona 5 menus.
    Measured on the 1920x1080 captures listed in tokens.css and scaled by 2/3 (Playnite's 14px text against the
    menus' 21px command labels): command rows 54px tall in Tactica's pause menu (36 here), plates tilted 12 degrees,
    2-3px white edges on every black plate (2 here), the blue sliver offset 4-6px down and right (4 here).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: an ink plate in a 2px paper edge, square, like the command plates -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Keyboard focus: the blue that marks the current command, as a 2px frame 3px outside the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The slanted plate: every current command in the menus sits on a parallelogram tilted about 12 degrees, with a
        second plate offset behind it (Tactica: a blue sliver; Strikers: a black drop). Drawn behind content, never
        around it, so text stays upright: <Control Template="{DynamicResource SlantPlateTemplate}" Focusable="False" IsTabStop="False" Background=...
        Foreground="(echo brush or Transparent)" BorderBrush=... BorderThickness=... IsHitTestVisible="False" />
        The skew is about the plate's center, so the corners reach 0.1 x height past the sides; hosts keep that much
        room (4px on a 36px row).
    -->
    <ControlTemplate x:Key="SlantPlateTemplate" TargetType="{x:Type Control}">
        <Grid>
            <Border Background="{TemplateBinding Foreground}" Margin="4,4,-4,-4"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <SkewTransform AngleX="-12" />
                </Border.RenderTransform>
            </Border>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <SkewTransform AngleX="-12" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Captions over a block (description, notes, details): heavy condensed capitals, like the menu titles. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Button: command plate, 34 tall, 16 inline -->
    <Thickness x:Key="ButtonPadding">16,7</Thickness>
    <!-- Text box, password box, dropdown: 34 tall, 10 inline -->
    <Thickness x:Key="InputPadding">10,7</Thickness>
    <!-- Menu: 4px of ink around rows 30 tall -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6,16,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">12,6,16,6</Thickness>
    <!-- List box row: 30 tall, 12 inline (room for the slanted plate's corners) -->
    <Thickness x:Key="ListBoxItemPadding">12,6</Thickness>
    <!-- Group box: heavy caption on a red slash, body below -->
    <Thickness x:Key="GroupBoxPadding">0,10,0,4</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,4</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">20</sys:Double>
    <!-- Tooltip: the white name plate, 10 / 5 -->
    <Thickness x:Key="TooltipPadding">10,5</Thickness>
    <!-- Glyphs at 18px -->
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">360</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">340</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double>
</ResourceDictionary>
