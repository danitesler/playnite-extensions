<!--
    Overlay on Playnite Default/Common.xaml. Spacing, focus and the slanted plate of the Persona 5 menus.
    Measured on the 1920x1080 captures listed in tokens.css and scaled by 2/3 (Playnite's 14px text against the
    menus' 21px command labels): command rows 54px tall in Tactica's pause menu (36 here), plates tilted 12 degrees,
    2-3px white edges on every black plate (2 here), the blue sliver offset 4-6px down and right (4 here).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: an ink plate in a 2px paper edge, square, like the command plates -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Keyboard focus: the blue that marks the current command, as a 2px frame 3px outside the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The slanted plate: every current command in the menus sits on a parallelogram tilted about 12 degrees, with a
        second plate offset behind it (Tactica: a blue sliver; Strikers: a black drop). Drawn behind content, never
        around it, so text stays upright: <Control Template="{DynamicResource SlantPlateTemplate}" Focusable="False" IsTabStop="False" Background=...
        Foreground="(echo brush or Transparent)" BorderBrush=... BorderThickness=... IsHitTestVisible="False" />
        The skew is about the plate's center, so the corners reach 0.1 x height past the sides; hosts keep that much
        room (4px on a 36px row).
    -->
    <ControlTemplate x:Key="SlantPlateTemplate" TargetType="{x:Type Control}">
        <Grid>
            <Border Background="{TemplateBinding Foreground}" Margin="4,4,-4,-4"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <SkewTransform AngleX="-12" />
                </Border.RenderTransform>
            </Border>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <SkewTransform AngleX="-12" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Captions over a block (description, notes, details): heavy condensed capitals, like the menu titles. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Button: command plate, 34 tall, 16 inline -->
    <Thickness x:Key="ButtonPadding">16,4</Thickness>
    <!-- Text box, password box, dropdown: 34 tall, 10 inline -->
    <Thickness x:Key="InputPadding">10,4</Thickness>
    <!-- Menu: 4px of ink around rows 30 tall -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6,16,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">12,6,16,6</Thickness>
    <!-- List box row: 30 tall, 12 inline (room for the slanted plate's corners) -->
    <Thickness x:Key="ListBoxItemPadding">12,6</Thickness>
    <!-- Group box: heavy caption on a red slash, body below -->
    <Thickness x:Key="GroupBoxPadding">0,10,0,4</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,4</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">20</sys:Double>
    <!-- Tooltip: the white name plate, 10 / 5 -->
    <Thickness x:Key="TooltipPadding">10,5</Thickness>
    <!-- Glyphs at 18px -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">360</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- menu-mark begin LocalCallingCardMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a calling card tilted 6 degrees, an outlined card with a solid star. Hover (IsMouseOver): the card flips, its width closing to zero in 0.11s and opening again while the face swaps for the solid card with the star cut out. Open (ContextMenu.IsOpen of the nearest Border): the card tilts to 15 degrees and an accent star slams onto it, shrinking from 1.8 to 1 (0.22s); exits restore every property. -->
    <ControlTemplate x:Key="LocalCallingCardMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="22" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Canvas x:Name="Tilt" Width="22" Height="26" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><RotateTransform x:Name="TiltR" Angle="-6" /></Canvas.RenderTransform>
                    <Canvas x:Name="Flip" Width="22" Height="26" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><ScaleTransform x:Name="FlipS" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                        <Canvas x:Name="Front" Width="22" Height="26" Opacity="1">
                            <Rectangle Canvas.Left="3" Canvas.Top="2" Width="16" Height="22" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" />
                            <Path Data="M11.00,8.40 L12.23,11.50 L15.57,11.72 L13.00,13.85 L13.82,17.08 L11.00,15.30 L8.18,17.08 L9.00,13.85 L6.43,11.72 L9.77,11.50Z" Fill="{TemplateBinding Foreground}" />
                        </Canvas>
                        <Canvas x:Name="Back" Width="22" Height="26" Opacity="0">
                            <Path Data="F0 M3,2 H19 V24 H3Z M11.00,8.40 L12.23,11.50 L15.57,11.72 L13.00,13.85 L13.82,17.08 L11.00,15.30 L8.18,17.08 L9.00,13.85 L6.43,11.72 L9.77,11.50Z" Fill="{TemplateBinding Foreground}" />
                        </Canvas>
                        <Canvas x:Name="SlamW" Width="22" Height="26" RenderTransformOrigin="0.5,0.5" Opacity="0">
                            <Canvas.RenderTransform><ScaleTransform x:Name="SlamS" ScaleX="1.8" ScaleY="1.8" /></Canvas.RenderTransform>
                            <Path Data="M11.00,8.40 L12.23,11.50 L15.57,11.72 L13.00,13.85 L13.82,17.08 L11.00,15.30 L8.18,17.08 L9.00,13.85 L6.43,11.72 L9.77,11.50Z" Fill="{DynamicResource GlyphBrush}" />
                        </Canvas>
                    </Canvas>
                </Canvas>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlipS" Storyboard.TargetProperty="ScaleX"><LinearDoubleKeyFrame KeyTime="0:0:0.000" Value="1" /><EasingDoubleKeyFrame KeyTime="0:0:0.110" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.240" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Front" Storyboard.TargetProperty="Opacity"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="1" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.110" Value="0" /></DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Back" Storyboard.TargetProperty="Opacity"><DiscreteDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.110" Value="1" /></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FlipS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.150" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Front" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.100" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Back" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.100" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="TiltR" Storyboard.TargetProperty="Angle" To="-15" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SlamS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SlamS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SlamW" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.120"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="TiltR" Storyboard.TargetProperty="Angle" To="-6" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SlamS" Storyboard.TargetProperty="ScaleX" To="1.8" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SlamS" Storyboard.TargetProperty="ScaleY" To="1.8" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SlamW" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.120" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalCallingCardMenuMarkTemplate -->
</ResourceDictionary>
