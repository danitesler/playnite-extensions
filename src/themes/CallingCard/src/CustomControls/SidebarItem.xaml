<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml. A command of the pause menu on the ink rail: a 44 x 40
    tile, its 16px glyph (fixed 14,12 plate padding, no IconPadding) in SidebarItemForegroundBrush (fog) at rest, paper under the pointer; the current item sits on a
    30 x 26 slanted red plate with the blue sliver behind it (SlantPlateTemplate: SelectedBrush, SelectedBorderBrush),
    glyph in SidebarItemSelectedForegroundBrush. Library and Statistics drawn with Heroicons at 16px. Items stack edge
    to edge.
    PART_ProgressStatus (Playnite shows it while an add-on reports progress) is a 3px HP-teal bar along the tile's bottom
    edge. An item with no content is a bare marker: WarningBrush fill.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="{TemplateBinding Background}">
                        <Control x:Name="Plate" Visibility="Hidden" IsHitTestVisible="False"
                                 Width="30" Height="26" Margin="0,0,4,4"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Template="{DynamicResource SlantPlateTemplate}" Focusable="False" IsTabStop="False"
                                 Background="{DynamicResource SelectedBrush}" Foreground="{DynamicResource SelectedBorderBrush}" />
                        <Border Padding="14,12">
                            <Viewbox x:Name="ItemIcon">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                        </Border>
                        <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                        IsHitTestVisible="False" Width="16" Height="16"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ContentTemplate="{DynamicResource IconTemplate}" />
                        <ProgressBar x:Name="PART_ProgressStatus" Height="3" Margin="6,0,6,0"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource ProgressBarForegroundBrush}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Plate" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Margin" Value="0" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Margin" Value="0" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
