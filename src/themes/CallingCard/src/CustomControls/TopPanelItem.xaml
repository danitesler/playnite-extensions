<!--
    Overlay on Playnite Default/CustomControls/TopPanelItem.xaml. A command glyph of the top bar: 44 x 40, glyph at
    IconSize in TextBrushDarker at rest. Under the pointer it sits on a paper slanted plate
    (SlantPlateTemplate, TopPanelItemHoverBackgroundBrush) with an ink glyph (ButtonHoverForegroundBrush); a toggled item
    (current view, open explorer) is the current command, the red plate (TopPanelItemCheckedBackgroundBrush) with the
    blue sliver behind it (SelectedBorderBrush) and a paper glyph. An item with no content is a bare marker:
    WarningBrush fill. Plugin glyphs (text) get the same FontSize as the icons (IconSize).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TopPanelItem}">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="{DynamicResource IconSize}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Margin" Value="1,0,1,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0,16,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanelItem}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Control x:Name="Plate" Visibility="Hidden" IsHitTestVisible="False" Margin="3,2,7,6"
                                 Template="{DynamicResource SlantPlateTemplate}" Focusable="False" IsTabStop="False"
                                 Background="{DynamicResource TopPanelItemHoverBackgroundBrush}" Foreground="Transparent" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Plate" />
                        </Trigger>
                        <Trigger Property="IsToggled" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Plate" />
                            <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" TargetName="Plate" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedBorderBrush}" TargetName="Plate" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsToggled" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
