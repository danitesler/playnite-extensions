<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml (grid view, side panel).
    The same page as the details view in a side panel: the actions sit under the name, the close button sits over the top
    right corner, captions sit above their values.
    A Persona 5 status screen: ink page, the game's art as a banner fading into it, the title as a battle name plate (an
    ink parallelogram in a 2px paper edge, FrameBrush, with a red plate dropped behind it, GlyphBrush; heavy condensed
    capitals at 28), then the actions: Play as the current command (PlayButton), the context action and More as command
    plates (Button.xaml), Edit a 40px glyph plate shown while the pointer is over the header. Steam screenshots host and
    skeleton, then two columns: description and notes as sections (HeadingTextBlock behind a red slash) on the left; on
    the right the info box, a coal plate (ExpanderBackgroundBrush) in a 2px paper edge, 20px inside, every field
    Playnite can show in six groups split by 2px ash rules (WindowPanelSeparatorBrush); a group whose fields are all
    hidden collapses with its rule. Captions are heavy capitals in fog above the value; values are paper body text, text
    links (PropertyItemButton) or slanted paper chips.
    Every PART_ of Playnite's file is kept, each once. HtmlTextView takes Color-typed properties: the brushes are set on
    TextElement.Foreground and Tag and the Colors are bound from them (the one place theme XAML reads a Color).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border x:Name="PageRoot" Background="{DynamicResource ContentBackgroundBrush}" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Empty state (no game selected): a slanted red plate in a paper edge with the blue sliver wobbling behind it and the star of
                                 the menus turning on it, Playnite's "No game selected" in the heading capitals beneath. Centered in the visible area; both
                                 loops run only while it shows (RemoveStoryboard on exit). -->
                            <Grid IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                                    <Grid Width="180" Height="84" HorizontalAlignment="Center">
                                        <Border Background="{DynamicResource SelectedBorderBrush}" Margin="12,8,0,0" RenderTransformOrigin="0.5,0.5" Width="156" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <SkewTransform AngleX="-12" />
                                                    <TranslateTransform X="0" Y="0" />
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="SliverWobble">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" From="0" To="4" Duration="0:0:0.6" AutoReverse="True">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="0" To="4" Duration="0:0:0.6" AutoReverse="True">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="SliverWobble" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Border Background="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="2" Width="156" Height="72"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,8" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform><SkewTransform AngleX="-12" /></Border.RenderTransform>
                                        </Border>
                                        <ContentControl Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}" Width="40" Height="40"
                                                        Foreground="{DynamicResource PrimaryButtonForegroundBrush}" Margin="0,0,12,8" RenderTransformOrigin="0.5,0.5">
                                            <ContentControl.RenderTransform><RotateTransform Angle="0" /></ContentControl.RenderTransform>
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="StarSpin">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:9" />
                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="StarSpin" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,20,0,0"
                                               FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <Trigger Property="DataContext" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                <!-- Banner: the game's background art as a band of GameBannerHeight (0 turns it off). Faded out downward by a veil and a plain gradient to the page color (no OpacityMask). Collapsed when the game has no background
                                     art or Playnite hides the image. -->
                                <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- No OpacityMask on the banner: masked art repainted in part (behind the animated Play button) left dark
                                         seams on scaled displays. A veil and a plain gradient to the page color fade it toward the title instead. -->
                                    <Border Background="{DynamicResource ContentBackgroundBrush}" Opacity="0.35" />
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.2" />
                                                <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                                    <Grid Margin="24,0,24,24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                    <!-- Room above the title: the title sits low on the banner; the spacer shrinks when there is no banner. -->
                                    <Border Grid.Row="0" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                        <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 84 / 360'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                <Setter Property="Height" Value="48" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                                        <!-- The name plate: an ink parallelogram in a 2px paper edge with a red plate dropped behind it. -->
                                        <Grid HorizontalAlignment="Left">
                                            <Control Template="{DynamicResource SlantPlateTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="6,0,10,5"
                                                     Background="{DynamicResource WindowBackgourndBrush}"
                                                     BorderBrush="{DynamicResource FrameBrush}" BorderThickness="2"
                                                     Foreground="{DynamicResource GlyphBrush}" />
                                            <DockPanel Margin="22,6,28,11">
                                                <Image x:Name="PART_ImageIcon" MaxHeight="32" MaxWidth="32" DockPanel.Dock="Left" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                                <TextBlock x:Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLargest}"
                                                           FontFamily="{DynamicResource HeadingFontFamily}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                            </DockPanel>
                                        </Grid>
                                        <Grid Margin="0,16,0,0" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MaxWidth="180" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" Height="48" />
                                                <Button x:Name="PART_ButtonContextAction" Height="40" VerticalAlignment="Top" />
                                            </Grid>
                                            <Button Padding="0" Width="40" x:Name="PART_ButtonMoreActions" Grid.Column="1" Height="40" Margin="4,0,0,0" VerticalAlignment="Top" ToolTip="{DynamicResource LOCMoreAction}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                                                    Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Grid.Column="2" Width="40" Height="40" Padding="0" Margin="8,0,0,0" Focusable="False"
                                                    VerticalAlignment="Top" ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <!-- Steam Screenshots add-on: its host control, and a skeleton while it loads. The bindings use FallbackValue=PluginUnavailable
                                                 (not False): with the add-on missing or disabled neither the section nor the skeleton shows. The add-on hides its
                                                 control and clears IsControlVisible on every game change and needs about a second, so a Steam library game shows the
                                                 section (skeleton) in that gap, for at most 12 s. -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                    <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,12">
    <Border DockPanel.Dock="Left" Width="7" Height="20" Margin="3,0,10,0" VerticalAlignment="Center" Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <SkewTransform AngleX="-12" />
        </Border.RenderTransform>
    </Border>
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" />
</DockPanel>
                                                        <Grid>
                                                            <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                            <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}"
                                                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                                <Control.Style>
                                                                    <Style TargetType="Control">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Control.Style>
                                                            </Control>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemDescription}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel x:Name="PART_ElemDescription">
                                                    <DockPanel Margin="0,0,0,12">
    <Border DockPanel.Dock="Left" Width="7" Height="20" Margin="3,0,10,0" VerticalAlignment="Center" Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <SkewTransform AngleX="-12" />
        </Border.RenderTransform>
    </Border>
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource LOCGameDescriptionTitle}" />
</DockPanel>
                                                    <HtmlTextView x:Name="PART_HtmlDescription"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"
                                                                  Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemNotes}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel x:Name="PART_ElemNotes">
                                                    <DockPanel Margin="0,0,0,12">
    <Border DockPanel.Dock="Left" Width="7" Height="20" Margin="3,0,10,0" VerticalAlignment="Center" Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <SkewTransform AngleX="-12" />
        </Border.RenderTransform>
    </Border>
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource LOCNotesLabel}" />
</DockPanel>
                                                    <TextBox x:Name="PART_TextNotes" Style="{DynamicResource BareTextBox}" IsReadOnly="True"
                                                             AcceptsReturn="True" TextWrapping="Wrap" Padding="0" BorderThickness="0"
                                                             Foreground="{DynamicResource TextBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Margin="24,0,0,0">
                                            <Border x:Name="DetailsPanel" Width="{DynamicResource GridDetailsPaneWidth}" VerticalAlignment="Top"
                                                    Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="2" Padding="20">
                                                <Border.Resources>
                                                    <!-- Values are body text; a TextBlock with Tag="Caption" is the field caption (12px, dim) -->
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                        <Style.Triggers>
                                                            <Trigger Property="Tag" Value="Caption">
                                                        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                                                        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                </Border.Resources>
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,12">
    <Border DockPanel.Dock="Left" Width="7" Height="20" Margin="3,0,10,0" VerticalAlignment="Center" Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <SkewTransform AngleX="-12" />
        </Border.RenderTransform>
    </Border>
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource LOCGameDetails}" />
</DockPanel>
                                                    <!-- The rule of each group is its top border; the wrapper clips the first one (negative margins:
                                                         -(2 x 12 + 2 + 8) on top, -8 at the bottom; change them with the spacing). -->
                                                    <Border ClipToBounds="True">
                                                        <StackPanel Margin="0,-34,0,-8">
                                                            <Border x:Name="MetaProgress" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,2,0,0"
                                                                    BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Grid x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Tag="Caption" Text="{DynamicResource LOCCompletionStatus}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                        <Button Grid.Column="2" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Tag="Caption" Text="{DynamicResource LOCTimePlayed}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="2" x:Name="PART_TextPlayTime" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Tag="Caption" Text="{DynamicResource LOCLastPlayed}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="2" x:Name="PART_TextLastActivity" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Tag="Caption" Text="{DynamicResource LOCRecentActivityLabel}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="2" x:Name="PART_TextRecentActivity" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <Grid x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Tag="Caption" Text="{DynamicResource LOCDateAddedLabel}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                        <TextBlock Grid.Column="2" x:Name="PART_TextAdded" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="MetaScores" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,2,0,0"
                                                                    BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <Grid x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="3*" />
