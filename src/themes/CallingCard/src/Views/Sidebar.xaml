<!--
    Overlay on Playnite Default/Views/Sidebar.xaml. The pause menu as a compact rail: an ink column
    (ShellBackgroundBrush) 44px wide down the left edge, edged by a 6px paper sawtooth (FrameBrush through a tiled
    triangle mask, teeth 10px apart, laid over the views with a negative margin so it adds no width): the torn white
    stripes Tactica's menu runs beside its commands. Items are 44 x 40 with 16px glyphs (CustomControls/SidebarItem.xaml).
    The main menu button (MainMenuButton, defined here, also used by Views/TopPanel.xaml when the sidebar is hidden) is
    a 44 x 44 red block with the tilted star in paper at the top of the rail; hovered it turns to paper with a red star.
    Right: the rail mirrors (teeth on its left) and starts 52px down so the window buttons stay clear.
    Top and bottom: a 44px ink strip without the teeth; the top strip keeps 156px clear for the window buttons.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid x:Name="Root" Width="44" Margin="{TemplateBinding Padding}">
                        <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}">
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                        DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <ContentPresenter Width="22" Height="22"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Content="{DynamicResource IconMainMenu}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" Margin="0,0,0,10" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Rectangle x:Name="Edge" Width="6" Margin="0,0,-6,0" HorizontalAlignment="Right"
                                   IsHitTestVisible="False" SnapsToDevicePixels="False"
                                   Fill="{DynamicResource FrameBrush}">
                            <Rectangle.OpacityMask>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,6,10" ViewportUnits="Absolute"
                                              Viewbox="0,0,6,10" ViewboxUnits="Absolute" Stretch="Fill">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#FF000000" Geometry="M 0,0 L 6,5 L 0,10 Z" />
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Main menu hidden (it is in the top bar): the items still start below the top bar. -->
                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemMainMenu}" Value="Collapsed">
                            <Setter Property="Margin" Value="0,52,0,0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,52,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="Edge" />
                            <Setter Property="Margin" Value="-6,0,0,0" TargetName="Edge" />
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" TargetName="Edge" />
                            <Setter Property="RenderTransform" TargetName="Edge">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="-1" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Margin" Value="0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Width" Value="Auto" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Edge" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,156,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,6,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="4,2,4,2" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Width" Value="Auto" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Edge" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,6,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="4,2,4,2" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
