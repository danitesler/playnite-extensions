<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details view, right pane).
    A Persona 5 status screen: ink page, the game's art as a banner fading into it, the title as a battle name plate (an
    ink parallelogram in a 2px paper edge, FrameBrush, with a red plate dropped behind it, GlyphBrush; title in heavy
    condensed capitals, HeadingFontFamily at 40), the cover in a 3px paper frame with the same red drop, then the
    actions: Play as the current command (PlayButton, a slanted red plate with its blue sliver), the context action and
    More as command plates (Button.xaml), Edit a 40px glyph plate shown while the pointer is over the header. Steam
    screenshots host and skeleton, then two columns: description and notes as sections (HeadingTextBlock behind a red
    slash, no box) on the left; on the right the info box, a coal plate (ExpanderBackgroundBrush) in a 2px paper edge,
    20px inside, every field Playnite can show in six groups (progress, scores, about, tags, library, links) split by
    2px ash rules (WindowPanelSeparatorBrush); a group whose fields are all hidden collapses with its rule. Captions are
    heavy capitals in fog in a 112px column beside the value; values are paper body text, text links
    (PropertyItemButton) or slanted paper chips.
    Every PART_ of Playnite's file is kept, each once. HtmlTextView takes Color-typed properties: the brushes are set on
    TextElement.Foreground and Tag and the Colors are bound from them (the one place theme XAML reads a Color).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Placeholder for the Steam Screenshots control: a 16:9 main image over a row of five thumbnails, square, in the host's
         Foreground at 15 percent, pulsing. Each Viewbox scales a 1600px layout to the width its column gives it. Host: a
         Control with Foreground set and hit testing off, in a Grid next to the add-on's ContentControl. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="0"
                        Background="{TemplateBinding Foreground}" Opacity="0.15" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="2" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="4" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="6" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                    <Border Grid.Column="8" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.15" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1280" d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Grid>
                            <!-- Banner: the game's background art as a band of GameBannerHeight (0 turns it off). Faded out downward by the mask, darkened
                                 toward the title by a page-colored scrim, and cached because it is masked. Collapsed when the game has no background
                                 art or Playnite hides the image. -->
                            <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.CacheMode>
                                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                </Grid.CacheMode>
                                <Grid>
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="Black" Offset="0.25" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource ContentBackgroundBrush}" Opacity="0.75">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Transparent" Offset="0.1" />
                                                <GradientStop Color="Black" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                </Grid>
                            </Grid>
                            <Grid HorizontalAlignment="Stretch" MaxWidth="1280" Margin="32,0,32,32">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Room above the title: the title sits low on the banner; the spacer shrinks when there is no banner. -->
                                <Border Grid.Row="0" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 120 / 360'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                            <Setter Property="Height" Value="24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="0,0,0,24" Background="Transparent">
                                    <!-- Cover, sized by Playnite's cover height setting, square and cached, in a 3px paper frame with a red plate
                                         dropped 6px behind it. -->
                                    <Grid DockPanel.Dock="Right" Margin="24,0,6,6" VerticalAlignment="Bottom">
                                        <Border Margin="6,6,-6,-6" Background="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                                        <Border BorderThickness="3" BorderBrush="{DynamicResource FrameBrush}" Background="{DynamicResource WindowBackgourndBrush}">
                                            <Border x:Name="CoverFrame">
                                                <Border.CacheMode>
                                                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                                </Border.CacheMode>
                                                <Border.OpacityMask>
                                                    <VisualBrush Visual="{Binding ElementName=CoverShape}" />
                                                </Border.OpacityMask>
                                                <Grid>
                                                    <Border x:Name="CoverShape" Background="{DynamicResource ExpanderBackgroundBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                    <Image x:Name="PART_ImageCover"
                                                           Height="{Settings GameDetailsCoverHeight}"
                                                           StretchDirection="Both" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="Fant" />
                                                </Grid>
                                            </Border>
                                        </Border>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <!-- The name plate: an ink parallelogram in a 2px paper edge with a red plate dropped behind it. -->
                                        <Grid HorizontalAlignment="Left">
                                            <Control Template="{DynamicResource SlantPlateTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="8,0,14,6"
                                                     Background="{DynamicResource WindowBackgourndBrush}"
                                                     BorderBrush="{DynamicResource FrameBrush}" BorderThickness="2"
                                                     Foreground="{DynamicResource GlyphBrush}" />
                                            <DockPanel Margin="28,8,36,14">
                                                <Image x:Name="PART_ImageIcon" MaxHeight="40" MaxWidth="40" DockPanel.Dock="Left" Margin="0,0,14,0"
                                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                                <TextBlock x:Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLargest}"
                                                           FontFamily="{DynamicResource HeadingFontFamily}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                            </DockPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" Height="48" MinWidth="168" />
                                                <Button x:Name="PART_ButtonContextAction" Height="40" MinWidth="140" VerticalAlignment="Top" />
                                            </Grid>
                                            <Button Padding="0" Width="40" x:Name="PART_ButtonMoreActions" Height="40" Margin="4,0,0,0" VerticalAlignment="Top" ToolTip="{DynamicResource LOCMoreAction}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                                                    Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Margin="8,0,0,0" Focusable="False"
                                                    VerticalAlignment="Top" ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                                Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <!-- Steam Screenshots add-on: its host control, and a skeleton while it loads. The bindings use FallbackValue=PluginUnavailable
                                             (not False): with the add-on missing or disabled neither the section nor the skeleton shows. The add-on hides its
                                             control and clears IsControlVisible on every game change and needs about a second, so a Steam library game shows the
                                             section (skeleton) in that gap, for at most 12 s. -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,12">
    <Border DockPanel.Dock="Left" Width="7" Height="20" Margin="3,0,10,0" VerticalAlignment="Center" Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <SkewTransform AngleX="-12" />
        </Border.RenderTransform>
    </Border>
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" />
</DockPanel>
                                                    <Grid>
                                                        <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                        <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}"
                                                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                            <Control.Style>
                                                                <Style TargetType="Control">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Control.Style>
                                                        </Control>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemDescription}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel x:Name="PART_ElemDescription">
                                                <DockPanel Margin="0,0,0,12">
    <Border DockPanel.Dock="Left" Width="7" Height="20" Margin="3,0,10,0" VerticalAlignment="Center" Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <SkewTransform AngleX="-12" />
        </Border.RenderTransform>
    </Border>
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource LOCGameDescriptionTitle}" />
</DockPanel>
                                                <HtmlTextView x:Name="PART_HtmlDescription"
                                                              TextElement.Foreground="{DynamicResource TextBrush}"
                                                              Tag="{DynamicResource GlyphBrush}"
                                                              HtmlFontSize="{DynamicResource FontSize}"
                                                              HtmlFontFamily="{DynamicResource FontFamily}"
                                                              HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                              LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                              pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,0,24" Padding="0" Background="Transparent" BorderThickness="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemNotes}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel x:Name="PART_ElemNotes">
                                                <DockPanel Margin="0,0,0,12">
    <Border DockPanel.Dock="Left" Width="7" Height="20" Margin="3,0,10,0" VerticalAlignment="Center" Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <SkewTransform AngleX="-12" />
        </Border.RenderTransform>
    </Border>
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource LOCNotesLabel}" />
</DockPanel>
                                                <TextBox x:Name="PART_TextNotes" Style="{DynamicResource BareTextBox}" IsReadOnly="True"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Padding="0" BorderThickness="0"
                                                         Foreground="{DynamicResource TextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Grid Grid.Column="1" Margin="24,0,0,0">
                                        <Border x:Name="DetailsPanel" Width="{DynamicResource GameDetailsPaneWidth}" VerticalAlignment="Top"
                                                Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource FrameBrush}"
                                                BorderThickness="2" Padding="20">
                                            <Border.Resources>
                                                <!-- Values are body text; a TextBlock with Tag="Caption" is the field caption (heavy capitals, fog) -->
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Tag" Value="Caption">
                                                    <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                                                    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                            </Border.Resources>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,12">
    <Border DockPanel.Dock="Left" Width="7" Height="20" Margin="3,0,10,0" VerticalAlignment="Center" Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <SkewTransform AngleX="-12" />
        </Border.RenderTransform>
    </Border>
    <TextBlock Style="{DynamicResource HeadingTextBlock}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource LOCGameDetails}" />
</DockPanel>
                                                <!-- The rule of each group is its top border; the wrapper clips the first one (negative margins:
                                                     -(2 x 12 + 2 + 8) on top, -8 at the bottom; change them with the spacing). -->
                                                <Border ClipToBounds="True">
                                                    <StackPanel Margin="0,-34,0,-8">
                                                        <Border x:Name="MetaProgress" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,2,0,0"
                                                                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCCompletionStatus}" />
                                                                    <Button Grid.Column="1" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCTimePlayed}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextPlayTime" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCLastPlayed}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextLastActivity" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCRecentActivityLabel}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextRecentActivity" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCDateAddedLabel}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextAdded" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,2,0,0"
                                                                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCCommunityScore}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCCriticScore}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </Grid>
                                                                <Grid x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="112" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Tag="Caption" Margin="0,2,8,0" Text="{DynamicResource LOCUserScore}" />
                                                                    <TextBlock Grid.Column="1" x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,2,0,0"
                                                                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
