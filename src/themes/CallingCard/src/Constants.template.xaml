<!--
    Calling Card: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). The token names (red, ink, paper, ...) are this
    theme's own and live in tokens.css, each with the screenshot it was measured on.
    The menus are three colors: ink plates with paper text, one screaming red for whatever is current, and a blue
    sliver offset behind the current plate. HP teal fills progress bars; amber is warnings.
    Placeholder syntax: .claude/skills/playnite-theme-dev/reference.md. No double braces in comments here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography. Body in Segoe UI; headings, tabs, Play and the game title in Impact, the heavy condensed capitals
         Windows ships that come closest to the menus' lettering. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">32</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Impact, Haettenschweiler, Arial Black</FontFamily>

    <!-- Shape: hard polygons, thick edges. -->
    <Thickness x:Key="PopupBorderThickness">2</Thickness>
    <Thickness x:Key="ControlBorderThickness">2</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{paper}}</Color>
    <Color x:Key="TextColorDarker">{{fog}}</Color>
    <Color x:Key="TextColorDark">{{paper}}</Color>              <!-- text on the red plate -->
    <Color x:Key="MainColor">{{coal}}</Color>
    <Color x:Key="MainColorDark">{{ink-soft}}</Color>
    <Color x:Key="HoverColor">{{white-veil}}</Color>
    <Color x:Key="GlyphColor">{{red}}</Color>
    <Color x:Key="HighlightGlyphColor">{{red-veil}}</Color>
    <Color x:Key="PopupBackgroundColor">{{ink}}</Color>
    <Color x:Key="PopupBorderColor">{{paper}}</Color>
    <Color x:Key="BackgroundToneColor">{{coal}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">#00000000</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{ash}}</Color>
    <Color x:Key="DataChangeNotifColor">{{amber}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{smoke}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{paper}}" />  <!-- the white name plate -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{ink-soft}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{hp-teal}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{amber}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{amber}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{coal}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{ink}}" />

    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{ink-soft}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{coal}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{ash}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{paper}}" />  <!-- the rail's sawtooth edge -->
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{ink-scrim}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{ink-soft}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{red-hover}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{echo-blue}}" />   <!-- the blue sliver behind the current plate -->
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{soot}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{echo-blue}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{red-pressed}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{paper}}" />

    <!-- Buttons: an ink plate in a paper edge; hovered it turns to paper with ink text, pressed it turns red. -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{red-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{red-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{paper}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{coal}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{soot}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{smoke}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{paper}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{fog}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{ash}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{hp-teal}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{ash}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{smoke}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{fog}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{red}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{fog}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{paper}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{paper}}" />  <!-- chips are paper labels -->
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{red}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{ash}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{ink}}" />

    <!-- Typography -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{paper}}" />
</ResourceDictionary>
