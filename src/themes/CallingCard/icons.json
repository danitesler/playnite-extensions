{
    "_comment": "Heroicons 2.2.0 solid (MIT). Original marks and custom button geometries live in Media.xaml. PNG colors reference src/tokens.css.",
    "jobs": [
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/heroicons@{ref}/24/solid/{name}.svg",
            "ref": "2.2.0",
            "format": "Geometry",
            "keyPrefix": "Icon",
            "xamlOut": "src/Media.xaml",
            "updateXaml": true,
            "icons": [
                "magnifying-glass=Search",
                "x-mark=Clear",
                "adjustments-horizontal=ViewSettings",
                "bookmark=FilterPresets",
                "square-3-stack-3d=Group",
                "arrows-up-down=Sort",
                "list-bullet=DetailsView",
                "squares-2x2=GridView",
                "queue-list=ListView",
                "arrow-down-circle=Update",
                "folder-open=Explorer",
                "sparkles=Random",
                "arrows-right-left=ViewRandom",
                "funnel=Filter",
                "bell=Notifications",
                "rectangle-stack=Library",
                "chart-bar=Statistics",
                "x-mark=WindowClose",
                "chevron-down=DropDown",
                "chevron-right=Submenu",
                "check=Check",
                "plus=Add",
                "pencil=Edit",
                "trash=Remove",
                "ellipsis-horizontal=Options"
            ]
        },
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/heroicons@{ref}/24/solid/{name}.svg",
            "ref": "2.2.0",
            "format": "Png",
            "outDir": "src/Images/Heroicons",
            "size": 48,
            "colorToken": "paper",
            "icons": [
                "arrows-pointing-out",
                "plus",
                "arrow-path",
                "information-circle",
                "cog-6-tooth",
                "puzzle-piece",
                "play",
                "arrow-down-tray",
                "link",
                "folder-open",
                "server",
                "computer-desktop",
                "star",
                "eye-slash",
                "eye",
                "sun",
                "pencil",
                "sparkles",
                "book-open",
                "archive-box",
                "clock"
            ]
        },
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/heroicons@{ref}/24/solid/{name}.svg",
            "ref": "2.2.0",
            "format": "Png",
            "outDir": "src/Images/Heroicons",
            "size": 48,
            "colorToken": "red",
            "icons": [
                "arrow-right-start-on-rectangle=arrow-right-start-on-rectangle-red",
                "trash=trash-red"
            ]
        },
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/heroicons@{ref}/24/solid/{name}.svg",
            "ref": "2.2.0",
            "format": "Png",
            "outDir": "src/Images/Heroicons",
            "size": 48,
            "colorToken": "amber",
            "icons": [
                "star=star-amber"
            ]
        }
    ]
}
