<!--
    Wildhand: TabControl. Balatro's Options tab row: the tabs sit in their own 2px pale-outline rounded frame (LocalOutlineBrush, 12px). Every tab is a 28px
    ledged plate (3px ledge): idle tabs are LocalLBlackBrush over a slate ledge, the selected tab is the danger red over its red ledge with the red pointer
    (LocalPointerTemplate in LocalMultBrush) dropping in above it. Labels are white Pixelify Sans 17px (FontSizeLarge), never bold. With a Left strip (the game
    editor) the frame stands as a column and the pointer sits on the selected tab's right edge. Hover fades a lighter face in and pops the plate (named
    transforms, template triggers only). The TabItem keeps Foreground = TextBrush (tab pages inherit it) and every header colour is set on the header TextBlock
    through TargetName.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnDefinition0" />
                            <ColumnDefinition x:Name="ColumnDefinition1" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" x:Name="RowDefinition0" />
                            <RowDefinition Height="*" x:Name="RowDefinition1" />
                        </Grid.RowDefinitions>
                        <Border x:Name="HeaderBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,10" Padding="0"
                                Background="{DynamicResource TabControlHeaderBackgroundBrush}" BorderBrush="{DynamicResource LocalOutlineBrush}" BorderThickness="2"
                                CornerRadius="{DynamicResource CornerRadiusXLarge}">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Panel.ZIndex="1" Width="Auto" Height="Auto" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <Border x:Name="ContentPanel" Grid.Column="0" Grid.Row="1"
                                KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local" Background="{DynamicResource ControlBackgroundBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition1" Value="Auto" />
                            <Setter Property="Grid.Row" TargetName="HeaderBorder" Value="1"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter Property="Grid.Row" TargetName="HeaderBorder" Value="0" />
                            <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Grid.Column" TargetName="ContentPanel" Value="1" />
                            <Setter Property="Width" TargetName="ColumnDefinition0" Value="Auto" />
                            <Setter Property="Width" TargetName="ColumnDefinition1" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition1" Value="0" />
                            <Setter Property="Grid.Column" TargetName="HeaderBorder" Value="0"/>
                            <Setter Property="Margin" TargetName="HeaderBorder" Value="0,0,18,0"/>
                            <Setter Property="Margin" TargetName="ContentPanel" Value="0,0,0,0"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter Property="Grid.Row" TargetName="HeaderBorder" Value="0" />
                            <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Grid.Column" TargetName="ContentPanel" Value="0" />
                            <Setter Property="Width" TargetName="ColumnDefinition0" Value="*" />
                            <Setter Property="Width" TargetName="ColumnDefinition1" Value="Auto" />
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*" />
                            <Setter Property="Height" TargetName="RowDefinition1" Value="0" />
                            <Setter Property="Grid.Column" TargetName="HeaderBorder" Value="1"/>
                            <Setter Property="Margin" TargetName="HeaderBorder" Value="18,0,0,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- The whole tab page inherits this colour (the edit dialog's labels set none), so it stays the normal text colour. Header colours are set on the header TextBlock only. -->
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="TabGrid" Background="Transparent" Margin="4,4,4,4" MinHeight="28" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Pop" />
                                <RotateTransform x:Name="Rock" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border x:Name="TabLedge" Margin="0,3,0,0" IsHitTestVisible="False" Background="{DynamicResource LocalLedgeSlateBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="TabFace" Margin="0,0,0,3" IsHitTestVisible="False" Background="{DynamicResource LocalLBlackBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="HoverFace" Margin="0,0,0,3" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource ButtonHoverBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Grid x:Name="SelectedPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Margin="0,3,0,0" Background="{DynamicResource LocalDangerLedgeBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Border Margin="0,0,0,3" Background="{DynamicResource LocalDangerBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        </Grid>
                        <Control x:Name="Pointer" Template="{DynamicResource LocalPointerTemplate}" Width="16" Height="16" Margin="0,-16,0,0" Opacity="0" Focusable="False" IsTabStop="False"
                                 HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" Foreground="{DynamicResource LocalMultBrush}" RenderTransformOrigin="0.5,0.5">
                            <Control.RenderTransform>
                                <TranslateTransform x:Name="PointerShift" Y="0" />
                            </Control.RenderTransform>
                        </Control>
                        <Control x:Name="PointerSide" Template="{DynamicResource LocalPointerRightTemplate}" Width="16" Height="16" Margin="0,0,-15,3" Visibility="Collapsed" Opacity="0" Focusable="False" IsTabStop="False"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource LocalMultBrush}" />
                        <TextBlock x:Name="TextContent" Padding="14,2,14,2" Margin="0,0,0,3" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource TextBrush}">
                            <ContentPresenter x:Name="ContentSite" RecognizesAccessKey="True" ContentSource="Header"
                                              HorizontalAlignment="Center" Margin="2,0" VerticalAlignment="Center" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- A vertical strip (the game editor's section list): the pointer turns to the tab's right edge. -->
                        <DataTrigger Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Left">
                            <Setter TargetName="TabGrid" Property="Margin" Value="4,2,4,2" />
                            <Setter TargetName="TextContent" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="Pointer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PointerSide" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Right">
                            <Setter TargetName="TabGrid" Property="Margin" Value="4,2,4,2" />
                            <Setter TargetName="TextContent" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="Pointer" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TabHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverFace" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rock" Storyboard.TargetProperty="Angle">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="-2" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="1.5" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TabHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverFace" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Rock" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedPlate" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalWhiteBrush}" TargetName="TextContent" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TabSelectIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Pointer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PointerSide" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="PointerShift" Storyboard.TargetProperty="Y" From="-6" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="TabSelectIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
