<!--
    Wildhand: CheckBox. Balatro's option box: a 22px recessed square (CheckBoxCheckMarkBkBrush, the inset) with a 2px pale outline rim and 6px corners.
    Checked draws a white pixel tick (IconCheck) that pops in (scale 0.6 to 1.15 to 1 over 180ms, BackEase on the first leg). Indeterminate is a small
    white block. Hover turns the rim orange, pressed turns it white.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="22" Height="22" VerticalAlignment="Center">
                                <Border x:Name="BulletBorder" Background="{DynamicResource CheckBoxCheckMarkBkBrush}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" />
                                <Grid x:Name="CheckIcon" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="CheckScale" ScaleX="1" ScaleY="1" />
                                    </Grid.RenderTransform>
                                    <ContentControl Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False"
                                                    Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource CheckMarkBrush}" />
                                </Grid>
                                <Border x:Name="IndeterminateIcon" Visibility="Collapsed" Width="10" Height="10" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource CheckMarkBrush}" IsHitTestVisible="False" />
                            </Grid>
                            <ContentPresenter DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="BulletBorder" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource LocalWhiteBrush}" TargetName="BulletBorder" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CheckPop">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.15">
                                                <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="1">
                                                <EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.15">
                                                <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="1">
                                                <EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CheckPop" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
