<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu,
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is one Balatro-style board with ledged rows. Levers (docs/themes/menus.md):
    - Panel: LocalMenuBoardTemplate, a slate board (LocalBlackBrush) in a 2px LocalOutlineBrush rim, 10px radius, standing on a
      4px LocalLedgeSlateBrush ledge (two stacked Borders, no DropShadowEffect), 5px inner padding. It fades in and rises 6px over
      140ms from ControlTemplate triggers (here on IsOpen; the submenu, ComboBox and multi-select popups do the same on their own open flag).
    - Highlight: LocalMenuPillTemplate, an orange ledged pill (face over a 3px ledge, 6px radius), animated in Menu.xaml and ComboBox.xaml.
    - Icons: LocalMenuCheckTemplate (checked rows, the chosen ComboBox item) and LocalMenuArrowTemplate (submenu mark, a 14px red square).
    Shared by Menu.xaml, ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml.
    Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The board: rim and body over the ledge. Rows start 7px inside every edge (2px rim + 5px padding); the foot has 4px of ledge more. -->
    <ControlTemplate x:Key="LocalMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource LocalLedgeSlateBrush}" CornerRadius="{DynamicResource CornerRadiusLarge}" />
            <Border Margin="0,0,0,4" Background="{DynamicResource LocalBlackBrush}" BorderBrush="{DynamicResource LocalOutlineBrush}" BorderThickness="2"
                    CornerRadius="{DynamicResource CornerRadiusLarge}" />
        </Grid>
    </ControlTemplate>
    <!-- The highlight pill: Background = face, BorderBrush = ledge. The face leaves 3px of ledge showing at the bottom. -->
    <ControlTemplate x:Key="LocalMenuPillTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="0,0,0,3" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Grid>
    </ControlTemplate>
    <!-- Checked row and chosen ComboBox item: a 16x16 inset box with a 2px pale rim and a white tick. -->
    <ControlTemplate x:Key="LocalMenuCheckTemplate" TargetType="{x:Type Control}">
        <Border Width="16" Height="16" IsHitTestVisible="False" SnapsToDevicePixels="True" Background="{DynamicResource LocalInsetBrush}"
                BorderBrush="{DynamicResource LocalOutlineBrush}" BorderThickness="2" CornerRadius="4">
            <ContentControl Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                            Foreground="{DynamicResource LocalWhiteBrush}" Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconTemplate}" />
        </Border>
    </ControlTemplate>
    <!-- Submenu mark: a 14px red square on a 2px red ledge with a white arrow (14x16 with the ledge). -->
    <ControlTemplate x:Key="LocalMenuArrowTemplate" TargetType="{x:Type Control}">
        <Grid Width="14" Height="16" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Margin="0,2,0,0" Background="{DynamicResource LocalDangerLedgeBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
            <Border Margin="0,0,0,2" Background="{DynamicResource LocalDangerBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}">
                <ContentControl Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                Foreground="{DynamicResource LocalWhiteBrush}" Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconTemplate}" />
            </Border>
        </Grid>
    </ControlTemplate>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource LocalBlackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalOutlineBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="236" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="MenuRise" />
                        </Grid.RenderTransform>
                        <Control Template="{DynamicResource LocalMenuBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="7,7,7,11" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuRiseIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MenuPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="MenuRise" Storyboard.TargetProperty="Y" From="6" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="MenuRiseIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
