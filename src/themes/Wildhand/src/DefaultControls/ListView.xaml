<!--
    Wildhand: the list view's row. Only the implicit ListViewItem style lives here (Playnite Default 10.60's row plus the running
    game indicator); the list, its headers and its scroll viewer stay Playnite's.
    Hover is a slate plate; selected is the orange ledged plate (an orange face over a 2px ledge, ink text), the same plate the
    details rows wear, only tighter. Rows that are launching or running get the details row's mark: a 2px green frame with a 1px
    ink keyline, a green wash, a green strip behind a dark capsule of three value dots, and the ledge strip as a progress bar.
    Launching: a green band crosses the row while the strip fills and the dots step fast in discrete keyframes (220ms). Running:
    the frame breathes 0.7 to 1 over 3.2s and the dots step slowly (400ms). Selection and hover never touch RunningIndicator.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,1,0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Grid>
                        <Border x:Name="HoverRectangle" Visibility="Collapsed" Margin="0,0,0,2" CornerRadius="4" Background="{DynamicResource ListItemHoverBrush}" IsHitTestVisible="False" />
                        <Grid x:Name="SelectedRectangle" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border Margin="0,2,0,0" CornerRadius="4" Background="{DynamicResource LocalOrangeLedgeBrush}" />
                            <Border Margin="0,0,0,2" CornerRadius="4" Background="{DynamicResource ListItemSelectedBrush}" />
                        </Grid>

                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Margin="0,0,0,2" CornerRadius="4" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.14" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Margin="0,0,0,2" CornerRadius="4" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.4">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningMarkPlate" Width="56" Margin="0,0,0,2" HorizontalAlignment="Right" CornerRadius="0,4,4,0" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.55" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid x:Name="RunningFoot" Height="2" Margin="8,0,8,0" VerticalAlignment="Bottom">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <!-- 2px running edge with a 1px ink keyline inside: it separates the frame from a bright selected plate. -->
                            <Border x:Name="RunningFrame" Margin="0,0,0,2" CornerRadius="4" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2">
                                <Border CornerRadius="2" BorderBrush="{DynamicResource LocalInkBrush}" BorderThickness="1" Opacity="0.7" />
                            </Border>
                            <Border Margin="0,0,6,2" Padding="6,4" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="3" Background="{DynamicResource LocalInsetBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle x:Name="RunningDot1" Width="5" Height="5" Fill="{DynamicResource RunningIndicatorBrush}" />
                                    <Rectangle x:Name="RunningDot2" Width="5" Height="5" Margin="3,0,0,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                                    <Rectangle x:Name="RunningDot3" Width="5" Height="5" Margin="3,0,0,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <Border x:Name="RowRoom" Padding="0,0,0,2">
                                <Grid ClipToBounds="True"><GridViewRowPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Stretch" /></Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Selector.IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedRectangle" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="HoverRectangle" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The three value dots step one at a time, 220ms each (discrete), in their own storyboard. -->
                                <BeginStoryboard Name="RunningDotsLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot1" Storyboard.TargetProperty="Opacity" Duration="0:0:0.66">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot2" Storyboard.TargetProperty="Opacity" Duration="0:0:0.66">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.44" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot3" Storyboard.TargetProperty="Opacity" Duration="0:0:0.66">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.44" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                                <RemoveStoryboard BeginStoryboardName="RunningDotsLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot strip completes once (the sweep has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The same three dots, slower: 400ms a step. -->
                                <BeginStoryboard Name="RunningDotsRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                                <RemoveStoryboard BeginStoryboardName="RunningDotsRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- RunningMarkRoom left="0" right="46": the running mark owns this strip of the row, so a long name stops before it. -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,46,2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,46,2" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Selector.IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
