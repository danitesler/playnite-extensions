<!--
    Wildhand: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json); each placeholder names the token that plays the key's role.
    Slate panels (black, black-deep, the recessed inset) sit on the felt; every plate is a flat face over a darker ledge.
    Selection is orange with ink, Play is the deepened chips blue, danger the deepened mult red, running is green (nothing
    else uses it), gold is money and scores.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Typography: Nunito (Regular, Bold) carries every size under 17px; Pixelify Sans Regular (m6x11 stand-in) carries titles,
         plate labels, tabs and numerals at 17px and up. Pixelify's c reads as o and its f ligatures draw wrong below 17px, so the
         bundled copy has no liga/dlig and is never set smaller. -->
    <sys:Double x:Key="FontSizeSmall">{{px:size-caption}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:size-body}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:size-lead}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:size-title}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:size-display}}</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Nunito, {{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Pixelify Sans, {{text:font-pixel|Segoe UI}}</FontFamily>
    <FontFamily x:Key="LocalPosterFontFamily">./Typography/#Pixelify Sans, {{text:font-pixel|Segoe UI}}</FontFamily>
    <!-- Metadata width defaults (usable content, inside the pane's padding and frame). -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>
    <!-- Shape: 6px buttons, 10px panels, 14px modal frames, 3px tags; the ledge under every plate is 4px. -->
    <Thickness x:Key="PopupBorderThickness">{{px:stroke-rim}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:stroke-hair}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:stroke-rim}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:corner-medium}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:corner-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:corner-large}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:corner-xlarge}}</CornerRadius>
    <sys:Double x:Key="LocalLedge">4</sys:Double>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{white}}</Color>
    <Color x:Key="TextColorDarker">{{joker-grey}}</Color>
    <Color x:Key="TextColorDark">{{ink}}</Color>
    <Color x:Key="MainColor">{{black}}</Color>
    <Color x:Key="MainColorDark">{{black-deep}}</Color>
    <Color x:Key="HoverColor">{{l-black}}</Color>
    <Color x:Key="GlyphColor">{{orange}}</Color>
    <Color x:Key="HighlightGlyphColor">{{orange/35}}</Color>
    <Color x:Key="PopupBackgroundColor">{{black}}</Color>
    <Color x:Key="PopupBorderColor">{{ui-outline}}</Color>
    <Color x:Key="BackgroundToneColor">{{black-deep}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{felt-deep}}</Color>   <!-- the slot behind each cover -->
    <Color x:Key="PanelSeparatorColor">{{ledge-slate}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{l-black}}</Color>
    <Color x:Key="DataChangeNotifColor">{{mult}}</Color>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <!-- Banner darkening color: the deepest felt, so a darker banner reads as the table in shadow, not grey. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{felt-deep}}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{grey}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{inset}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{l-black}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{inset}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{mult}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{money}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{money}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{black-deep}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{felt}}" />
    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->
    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{black}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{felt}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{felt}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{black}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{inset}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{black-deep}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{orange-lit}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{green}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{black}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{danger}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{grey}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{black}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{play}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{play-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{play}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{inset}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{ui-outline}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{ui-outline}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{inset}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{chips}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{inset}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{grey}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{joker-grey}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{black-deep/70}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{grey}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{mult}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{grey}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{l-black}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{orange}}" />
    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{l-black}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{felt-deep}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{ledge-slate}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{ledge-slate}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{grey}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{joker-grey}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{ledge-slate}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{ledge-slate}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{l-black}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{l-black}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{ledge-slate}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{l-black}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{grey}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{ledge-slate}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{money}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{black-deep}}" />
    <SolidColorBrush x:Key="TextOutlineBrush" Color="{{ledge-slate}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{money}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{l-black}}" />
    <!-- Theme-only: the palette steps, ledges and washes (Local prefix = no ThemeModifier entry, no shared meaning). -->
    <SolidColorBrush x:Key="LocalBlackBrush" Color="{{black}}" />
    <SolidColorBrush x:Key="LocalBlackDeepBrush" Color="{{black-deep}}" />
    <SolidColorBrush x:Key="LocalInsetBrush" Color="{{inset}}" />
    <SolidColorBrush x:Key="LocalLBlackBrush" Color="{{l-black}}" />
    <SolidColorBrush x:Key="LocalGreyBrush" Color="{{grey}}" />
    <SolidColorBrush x:Key="LocalJokerGreyBrush" Color="{{joker-grey}}" />
    <SolidColorBrush x:Key="LocalOutlineBrush" Color="{{ui-outline}}" />
    <SolidColorBrush x:Key="LocalFeltBrush" Color="{{felt}}" />
    <SolidColorBrush x:Key="LocalFeltLitBrush" Color="{{felt-lit}}" />
    <SolidColorBrush x:Key="LocalFeltDeepBrush" Color="{{felt-deep}}" />
    <SolidColorBrush x:Key="LocalWhiteBrush" Color="{{white}}" />
    <SolidColorBrush x:Key="LocalInkBrush" Color="{{ink}}" />
    <SolidColorBrush x:Key="LocalChipsBrush" Color="{{chips}}" />
    <SolidColorBrush x:Key="LocalPlayBrush" Color="{{play}}" />
    <SolidColorBrush x:Key="LocalPlayLitBrush" Color="{{play-lit}}" />
    <SolidColorBrush x:Key="LocalPlayLedgeBrush" Color="{{play-ledge}}" />
    <SolidColorBrush x:Key="LocalMultBrush" Color="{{mult}}" />
    <SolidColorBrush x:Key="LocalMultLitBrush" Color="{{mult-lit}}" />
    <SolidColorBrush x:Key="LocalDangerBrush" Color="{{danger}}" />
    <SolidColorBrush x:Key="LocalDangerLedgeBrush" Color="{{danger-ledge}}" />
    <SolidColorBrush x:Key="LocalOrangeBrush" Color="{{orange}}" />
    <SolidColorBrush x:Key="LocalOrangeLitBrush" Color="{{orange-lit}}" />
    <SolidColorBrush x:Key="LocalOrangeLedgeBrush" Color="{{orange-ledge}}" />
    <SolidColorBrush x:Key="LocalGreenBrush" Color="{{green}}" />
    <SolidColorBrush x:Key="LocalGreenLedgeBrush" Color="{{green-ledge}}" />
    <SolidColorBrush x:Key="LocalMoneyBrush" Color="{{money}}" />
    <SolidColorBrush x:Key="LocalGoldBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="LocalPurpleBrush" Color="{{purple}}" />
    <SolidColorBrush x:Key="LocalLedgeSlateBrush" Color="{{ledge-slate}}" />
    <SolidColorBrush x:Key="LocalLedgeGreyBrush" Color="{{ledge-grey}}" />
    <SolidColorBrush x:Key="LocalScrimBrush" Color="{{scrim}}" />
    <SolidColorBrush x:Key="LocalScanBrush" Color="{{scan}}" />
    <SolidColorBrush x:Key="LocalGlassBrush" Color="{{glass}}" />
</ResourceDictionary>
