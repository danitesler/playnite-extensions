<!--
    Wildhand: left rail, 44px of slate (ShellBackgroundBrush) closed by a 3px dark rim, the run HUD column. A CRT scan band and the four
    suits stack up from its foot (sparse decor, fading out upward; hidden while the sidebar sits at the top or bottom and while window
    art is on). The main menu is the card-and-jester-cap mark in white; on hover an orange ledged plate rises under it and the mark turns
    ink. The current item is the orange ledged plate with the red pointer on the rail edge (SidebarItem.xaml).
    Colors: ShellBackgroundBrush, MainMenuButtonForegroundBrush, GlyphBrush, LocalLedgeSlateBrush.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <!-- Scan band and the four suits at the rail's foot, fading out upward. Fixed width: nothing here may ask for more than the rail. -->
                            <Grid x:Name="RailLattice" Width="40" Height="190" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False" ClipToBounds="True">
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="0.55" Color="#FF000000" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Viewbox="0,0,4,4" ViewboxUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="{DynamicResource LocalScanBrush}">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,4,2" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{DynamicResource LocalSpadeGeometry}" Fill="{DynamicResource LocalLBlackBrush}" />
                                    <Path Width="14" Height="14" Margin="0,12,0,0" Stretch="Uniform" Data="{DynamicResource LocalHeartGeometry}" Fill="{DynamicResource LocalLBlackBrush}" />
                                    <Path Width="14" Height="14" Margin="0,12,0,0" Stretch="Uniform" Data="{DynamicResource LocalClubGeometry}" Fill="{DynamicResource LocalLBlackBrush}" />
                                    <Path Width="14" Height="14" Margin="0,12,0,0" Stretch="Uniform" Data="{DynamicResource LocalDiamondGeometry}" Fill="{DynamicResource LocalLBlackBrush}" />
                                </StackPanel>
                            </Grid>
                            <Rectangle x:Name="EdgeLine" Width="3" HorizontalAlignment="Right" Fill="{DynamicResource LocalLedgeSlateBrush}" IsHitTestVisible="False" />
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="52" Margin="0,0,0,0"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid x:Name="MenuSocketHost" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Control x:Name="MenuMark" Template="{DynamicResource LocalWildhandMenuMarkTemplate}" Focusable="False" IsTabStop="False"
                         Foreground="{DynamicResource MainMenuButtonForegroundBrush}" />
            </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailLattice" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailLattice" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="1" TargetName="EdgeLine" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="EdgeLine" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailLattice" />
                            <Setter Property="Width" Value="NaN" TargetName="EdgeLine" />
                            <Setter Property="Height" Value="1" TargetName="EdgeLine" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" TargetName="EdgeLine" />
                            <Setter Property="VerticalAlignment" Value="Top" TargetName="EdgeLine" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
