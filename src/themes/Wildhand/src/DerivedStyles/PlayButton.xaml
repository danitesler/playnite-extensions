<!--
    Wildhand: Play, the Play Hand plate from Balatro's run HUD. Structure: Playnite Default 10.60 (PlayButton); every Default state is kept.
    Plate: a flat face (PrimaryButtonBackgroundBrush, the Play blue) over a hard 5px ledge (BorderBrush, LocalPlayLedgeBrush), 8px
    radius. PLAY is Pixelify Sans 24px in white with a hard 2px shadow in the ledge colour, and a 22px ink bubble at the right holds a
    white play glyph (the controller bubble). Nothing blurs; no DropShadowEffect.
    Hover (hero, both ways): the plate pops to 1.06 and rocks (-4, +3, settling at -1.5 degrees) with a BackEase, the lit face
    (PrimaryButtonHoverBackgroundBrush) fades in and a 2px white rim fades in 2px outside the plate (100ms). Press has its own
    layers: the face drops onto the ledge and an ink scrim darkens it.
    PART_ButtonContextAction (Tag ContextAction) is the same plate in danger red (the Discard plate), white text, no bubble.
    Launching and running: the plate fills with RunningIndicatorBrush (green) over a green ledge, with ink text; the bubble steps
    aside for three value dots (5px squares) that step in discrete keyframes, fast (220ms) while launching and slow (400ms) while
    running. Launching: a lighter band sweeps the plate. Running: a RunningBreath scrim breathes over it. The mark owns its own
    column (MarkHost), so the label (PlayRoom) never meets it. The RUNNING label shows Cancel only while the button itself is
    hovered (RelativeSource Self); hover and pop stay off while it runs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite swaps
        Play for the context action (RUNNING). The overlay frames the plate: a 2px green ring 2px outside it (the plate itself is
        already green), a faint wash on the face, and a foot that fills the ledge with the running colour, a progress bar drawn
        on the ledge. Launching: the foot fills in step with the sweep on the plate (1.6s loop). Running: the ring breathes 0.72
        to 1 (3.2s) and the foot stays full. The three value dots live on the plate itself. DataContext is Playnite's
        GameDetailsViewModel.
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Margin="0,0,0,5" CornerRadius="8" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Grid x:Name="RunningFoot" Height="3" Margin="10,0,10,1" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Border x:Name="RunningFrame" Margin="-4,-4,-4,1" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource RunningIndicatorBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The ledge fills once (the sweep has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalPlayLedgeBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="22,0,12,0" />
        <Setter Property="FontFamily" Value="{DynamicResource LocalPosterFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <ControlTemplate.Resources>
                        <!-- Labels are caps whatever Playnite's string says. -->
                        <DataTemplate DataType="{x:Type sys:String}">
                            <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Pop" />
                                <RotateTransform x:Name="Rock" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <!-- The hard ledge under the face. -->
                        <Border x:Name="Ledge" Margin="0,5,0,0" IsHitTestVisible="False" Background="{TemplateBinding BorderBrush}" CornerRadius="8" />
                        <!-- The face: plate, hover, pressed and running layers, then the content. A press drops the whole face onto the ledge. -->
                        <Grid x:Name="Face" Margin="0,0,0,5" IsHitTestVisible="False">
                            <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="8" />
                            <Border x:Name="HoverPlate" Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" CornerRadius="8" Opacity="0" />
                            <Border x:Name="PressedPlate" Background="{DynamicResource LocalInkBrush}" CornerRadius="8" Opacity="0" />
                            <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}" CornerRadius="8" Opacity="0" />
                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource LocalWhiteBrush}" CornerRadius="8" Opacity="0.35">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningHoverDim" Background="{DynamicResource ScrimBrush}" CornerRadius="8" Opacity="0" />
                            <Grid x:Name="Content" Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- RunningMarkRoom left="0" right="0": the value dots own MarkHost, a column of their own, so the label never meets them. -->
                                <Border x:Name="PlayRoom" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1">
                                    <Grid x:Name="PlayContent">
                                        <ContentPresenter x:Name="PlayLabelShadow" Margin="0,2,0,0" IsHitTestVisible="False" Content="{TemplateBinding Content}"
                                                          TextElement.Foreground="{TemplateBinding BorderBrush}" />
                                        <ContentPresenter x:Name="PlayLabel" RecognizesAccessKey="True" Content="{TemplateBinding Content}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="CancelLabel" Content="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" TextElement.Foreground="{TemplateBinding Foreground}" />
                                <!-- The controller bubble at rest; the three value dots while the game launches or runs. -->
                                <Grid x:Name="MarkHost" Grid.Column="1" Width="22" Height="22" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Border x:Name="Bubble" Background="{DynamicResource LocalInkBrush}" CornerRadius="11">
                                        <Viewbox Width="10" Height="10" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ContentControl Focusable="False" IsTabStop="False" Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{DynamicResource LocalWhiteBrush}" />
                                        </Viewbox>
                                    </Border>
                                    <StackPanel x:Name="RunningDots" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle x:Name="RunningDot1" Width="5" Height="5" Fill="{DynamicResource LocalInkBrush}" />
                                        <Rectangle x:Name="RunningDot2" Width="5" Height="5" Margin="3,0,0,0" Fill="{DynamicResource LocalInkBrush}" Opacity="0.35" />
                                        <Rectangle x:Name="RunningDot3" Width="5" Height="5" Margin="3,0,0,0" Fill="{DynamicResource LocalInkBrush}" Opacity="0.35" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                        <!-- The hover rim: 2px white, 2px outside the face. -->
                        <Border x:Name="Rim" Margin="-4,-4,-4,1" Opacity="0" IsHitTestVisible="False" BorderBrush="{DynamicResource LocalWhiteBrush}" BorderThickness="2" CornerRadius="12" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="MarkHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Padding" Value="20,0,20,0" />
                            <Setter Property="MinWidth" Value="190" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <!-- Hover: only while the game is not launching or running. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Rim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rock" Storyboard.TargetProperty="Angle">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="-4" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="3" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="-1.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Rim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Rock" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <!-- Press: its own layers. The face drops onto the ledge and an ink scrim darkens it. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Face" Property="Margin" Value="0,5,0,0" />
                            <Setter TargetName="PressedPlate" Property="Opacity" Value="0.22" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayLabelShadow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bubble" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningDots" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MarkHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.06" />
                            <Setter Property="Padding" Value="20,0,14,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The three value dots step one at a time, 220ms each (discrete). -->
                                <BeginStoryboard Name="PlayDotsLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot1" Storyboard.TargetProperty="Opacity" Duration="0:0:0.66">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot2" Storyboard.TargetProperty="Opacity" Duration="0:0:0.66">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.44" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot3" Storyboard.TargetProperty="Opacity" Duration="0:0:0.66">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.44" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                                <RemoveStoryboard BeginStoryboardName="PlayDotsLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayLabelShadow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bubble" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningDots" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MarkHost" Property="Visibility" Value="Visible" />
                            <Setter Property="Padding" Value="20,0,14,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.04" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.16" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.04" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The same three dots, slower: 400ms a step. -->
                                <BeginStoryboard Name="PlayDotsRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningDot3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                                <RemoveStoryboard BeginStoryboardName="PlayDotsRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- The context action is the Discard plate (danger red); launching and running keep the plate and fill it green with ink text. -->
        <Style.Triggers>
            <Trigger Property="Tag" Value="ContextAction">
                <Setter Property="Background" Value="{DynamicResource LocalDangerBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalDangerLedgeBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalInkBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalGreenLedgeBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalInkBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalGreenLedgeBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
