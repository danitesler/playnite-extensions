<!--
    Wildhand: PropertyItemButton. A value is a plain text link in Money gold (LinkBrush) that turns orange and underlines on hover.
    In a chip list (the owning ItemsControl has Tag Chip) it is a chip: a 26px lifted plate (LocalLBlackBrush) over a 2px slate
    ledge, 4px radius, white Nunito Bold 14px. Hover: the face turns orange with ink text over an orange ledge and hops 1px;
    press drops the face onto the ledge. Static setters only, nothing blurs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Value" FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                               TextWrapping="Wrap" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="TextDecorations" Value="Underline" TargetName="Value" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LocalOrangeBrush}" />
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource LocalWhiteBrush}" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Plate" MinHeight="26" Background="Transparent" SnapsToDevicePixels="True">
                                <!-- The ledge, then the lifted face over it. -->
                                <Border x:Name="ChipLedge" Margin="0,2,0,0" IsHitTestVisible="False" CornerRadius="4" Background="{DynamicResource LocalLedgeSlateBrush}" />
                                <Border x:Name="ChipFace" Margin="0,0,0,2" IsHitTestVisible="False" CornerRadius="4" Background="{DynamicResource LocalLBlackBrush}" />
                                <TextBlock x:Name="ChipText" Margin="9,0,9,2" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource LocalOrangeBrush}" TargetName="ChipFace" />
                                    <Setter Property="Background" Value="{DynamicResource LocalOrangeLedgeBrush}" TargetName="ChipLedge" />
                                    <Setter Property="Foreground" Value="{DynamicResource LocalInkBrush}" TargetName="ChipText" />
                                    <Setter Property="Margin" Value="0,-1,0,3" TargetName="ChipFace" />
                                    <Setter Property="Margin" Value="9,0,9,4" TargetName="ChipText" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Margin" Value="0,2,0,0" TargetName="ChipFace" />
                                    <Setter Property="Margin" Value="9,2,9,0" TargetName="ChipText" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
