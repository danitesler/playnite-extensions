<!--
    Wildhand: dialog caption buttons (StandardWindowStyle). Three 28px ledged squares (28px face + 3px ledge): minimize and maximize are the neutral lifted
    slate plate (LocalLBlackBrush over the slate ledge), close is the red option-arrow square (LocalDangerBrush over LocalDangerLedgeBrush) with a white X. Hover fades
    a lighter face in (close keeps its red), draws the white 2px rim and pops the plate to 1.08 with a short rock (named transforms, template triggers only);
    pressed drops the face onto the ledge. Playnite passes the Marlett codes 0 / 1 / 2 / r as Content; triggers swap them for the theme's glyphs.
    The main window's own caption cells (MainWindowButton) are defined in MainWindowStyle.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WindowBarButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="31" />
        <Setter Property="Margin" Value="3,0,3,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource LocalLBlackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalLedgeSlateBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LocalWhiteBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Pop" />
                                <RotateTransform x:Name="Rock" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border x:Name="Ledge" Margin="0,3,0,0" IsHitTestVisible="False" Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Face" Margin="0,0,0,3" IsHitTestVisible="False" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="HoverFace" Margin="0,0,0,3" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource ButtonHoverBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Rim" Margin="-2,-2,-2,1" Opacity="0" IsHitTestVisible="False" BorderBrush="{DynamicResource LocalWhiteBrush}" BorderThickness="2" CornerRadius="8" />
                        <ContentPresenter x:Name="Glyph" Width="14" Height="14" Margin="0,0,0,3" IsHitTestVisible="False"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          Content="{DynamicResource IconWindowClose}"
                                          ContentTemplate="{DynamicResource IconTemplate}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="r">
                            <Setter Property="Background" Value="{DynamicResource LocalDangerBrush}" TargetName="HoverFace" />
                        </Trigger>
                        <Trigger Property="Content" Value="0">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMinimize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Content" Value="{DynamicResource IconWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BarHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverFace" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Rim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rock" Storyboard.TargetProperty="Angle">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="-4" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="3" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="-1.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="BarHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverFace" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Rim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Rock" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Margin" Value="0,3,0,0" TargetName="Face" />
                            <Setter Property="Margin" Value="0,3,0,0" TargetName="HoverFace" />
                            <Setter Property="Margin" Value="0,3,0,0" TargetName="Glyph" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Close: the red option-arrow square. -->
            <Trigger Property="Content" Value="r">
                <Setter Property="Background" Value="{DynamicResource LocalDangerBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalDangerLedgeBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
