<!--
    Wildhand: StandardWindowStyle. Every dialog and the Settings window: Balatro's SHOP sign as a 46px slate-deep title band (HeaderBandBrush) closed by a 3px
    slate ledge rule. At the left the card-and-jester mark (28px, white) and the title in Pixelify Sans 26px gold with a hard 2px shadow; then the marquee: a 16px
    red rail on a 3px red ledge carrying 5px bulbs, white and gold alternating every 12px, that chase in 300ms steps (two bulb layers swapping opacity;
    the storyboard starts while the window is active and is removed when it stops). The caption buttons are WindowBarButton (close = red square).
    CaptionHeight 46 equals the content's top margin. PART_TextTitle stays inside a collapsed parent: Playnite sets its Text and it must never draw by itself.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="46" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="46" VerticalAlignment="Top" Background="{DynamicResource HeaderBandBrush}" ClipToBounds="True">
                                    <!-- The band's closing rule: a 3px slate ledge. -->
                                    <Border Height="3" VerticalAlignment="Bottom" Background="{DynamicResource LocalLedgeSlateBrush}" IsHitTestVisible="False" />
                                    <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource LocalWhiteBrush}" Width="28" Height="28" Margin="0,0,12,0"
                                                     VerticalAlignment="Center" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                            <Grid VerticalAlignment="Center">
                                                <!-- The title lives here only as Playnite's text holder (hidden in a collapsed parent); the two visible copies below read its Text. -->
                                                <Border Visibility="Collapsed" Width="0" Height="0" Opacity="0">
                                                    <TextBlock Text="{TemplateBinding Title}" Foreground="Transparent" x:Name="PART_TextTitle" />
                                                </Border>
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="26"
                                                           Foreground="{DynamicResource LocalLedgeSlateBrush}" MaxWidth="420" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform X="0" Y="2" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="26"
                                                           Foreground="{DynamicResource LocalGoldBrush}" MaxWidth="420" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                        <!-- The SHOP marquee: red rail on its ledge, two bulb layers that trade places every 300ms. Border/Grid only, sized by the dock: no wide shapes. -->
                                        <Grid Height="19" Margin="6,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <Border Margin="0,3,0,0" Background="{DynamicResource LocalDangerLedgeBrush}" CornerRadius="8" />
                                            <Border Margin="0,0,0,3" Background="{DynamicResource LocalDangerBrush}" CornerRadius="8" />
                                            <Grid Margin="10,0,10,3" ClipToBounds="True">
                                                <Border x:Name="BulbsA" Opacity="1">
                                                    <Border.Background>
                                                        <DrawingBrush TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,24,16" ViewboxUnits="Absolute" Viewbox="0,0,24,16">
                                                            <DrawingBrush.Drawing>
                                                                <DrawingGroup>
                                                                    <GeometryDrawing Brush="{DynamicResource LocalWhiteBrush}">
                                                                        <GeometryDrawing.Geometry><EllipseGeometry Center="6,8" RadiusX="2.5" RadiusY="2.5" /></GeometryDrawing.Geometry>
                                                                    </GeometryDrawing>
                                                                    <GeometryDrawing Brush="{DynamicResource LocalMoneyBrush}">
                                                                        <GeometryDrawing.Geometry><EllipseGeometry Center="18,8" RadiusX="2.5" RadiusY="2.5" /></GeometryDrawing.Geometry>
                                                                    </GeometryDrawing>
                                                                </DrawingGroup>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border x:Name="BulbsB" Opacity="0">
                                                    <Border.Background>
                                                        <DrawingBrush TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,24,16" ViewboxUnits="Absolute" Viewbox="0,0,24,16">
                                                            <DrawingBrush.Drawing>
                                                                <DrawingGroup>
                                                                    <GeometryDrawing Brush="{DynamicResource LocalMoneyBrush}">
                                                                        <GeometryDrawing.Geometry><EllipseGeometry Center="6,8" RadiusX="2.5" RadiusY="2.5" /></GeometryDrawing.Geometry>
                                                                    </GeometryDrawing>
                                                                    <GeometryDrawing Brush="{DynamicResource LocalWhiteBrush}">
                                                                        <GeometryDrawing.Geometry><EllipseGeometry Center="18,8" RadiusX="2.5" RadiusY="2.5" /></GeometryDrawing.Geometry>
                                                                    </GeometryDrawing>
                                                                </DrawingGroup>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,46,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <!-- The bulbs chase only while the window is active: two layers swap places in discrete 300ms steps; the storyboard is removed when the window stops being active. -->
                        <Trigger Property="IsActive" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MarqueeChase">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:0.6">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BulbsA" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BulbsB" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="MarqueeChase" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
