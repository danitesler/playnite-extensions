<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Wildhand shared pieces, drawn from Balatro's HUD column, modal panels and option rows (RESEARCH.md, BRIEF.md).
        Every plate is a flat face over a hard ledge (the face's Margin leaves the ledge showing at the bottom); no blur, no
        DropShadowEffect. A pressed plate drops onto its ledge (face Margin 0,L,0,0 over the same ledge).
          LocalLedge2Template / LocalLedge3Template / LocalLedge4Template
                                plate: Background = face, BorderBrush = ledge colour, ControlCornerRadius corners
          LocalWellTemplate     recessed well: Background fill with a 2px BorderBrush strip along the top edge (inputs, cells)
          LocalPanelTemplate    slate panel: Background body, BorderBrush rim 2px, a 4px LocalLedgeSlateBrush ledge under it
          LocalDotsTemplate     three 5px squares in the host's Foreground, the last at 35% (the value dots under option boxes)
          LocalPointerTemplate / LocalPointerRightTemplate  the red tab pointer (down / right), Foreground fill
          LocalChipTemplate     the round-score poker chip glyph, Foreground fill
          DividerTemplate       dotted leader (the Cash Out dots): 3px tall, 2px dots on a 6px pitch, LocalLBlackBrush
          BrandMarkTemplate     the card-and-jester-cap mark, Foreground fill
        Hosts are plain Controls behind the content (IsHitTestVisible False).
    -->
    <ControlTemplate x:Key="LocalLedge2Template" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="0,0,0,2" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalLedge3Template" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="0,0,0,3" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalLedge4Template" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="0,0,0,4" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalWellTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Height="2" VerticalAlignment="Top" Background="{TemplateBinding BorderBrush}" CornerRadius="6,6,0,0" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalPanelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource LocalLedgeSlateBrush}" CornerRadius="{DynamicResource CornerRadiusLarge}" />
            <Border Margin="0,0,0,4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="{DynamicResource CornerRadiusLarge}" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalDotsTemplate" TargetType="{x:Type Control}">
        <StackPanel IsHitTestVisible="False" Orientation="Horizontal" SnapsToDevicePixels="True">
            <Rectangle Width="5" Height="5" Fill="{TemplateBinding Foreground}" />
            <Rectangle Width="5" Height="5" Margin="3,0,0,0" Fill="{TemplateBinding Foreground}" />
            <Rectangle Width="5" Height="5" Margin="3,0,0,0" Fill="{TemplateBinding Foreground}" Opacity="0.35" />
        </StackPanel>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalPointerTemplate" TargetType="{x:Type Control}">
        <Viewbox IsHitTestVisible="False" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource LocalPointerGeometry}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalPointerRightTemplate" TargetType="{x:Type Control}">
        <Viewbox IsHitTestVisible="False" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource LocalPointerGeometry}" Fill="{TemplateBinding Foreground}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="-90" CenterX="12" CenterY="12" />
                    </Path.RenderTransform>
                </Path>
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <ControlTemplate x:Key="LocalChipTemplate" TargetType="{x:Type Control}">
        <Viewbox IsHitTestVisible="False" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource LocalChipGeometry}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <!-- Group break (metadata, details groups): a dotted leader, 3px tall, 2px dots on a 6px pitch. No wide children: the tile is a brush. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Border IsHitTestVisible="False" Height="3" SnapsToDevicePixels="True">
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,6,3" ViewportUnits="Absolute" Viewbox="0,0,6,3" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="{DynamicResource LocalLBlackBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0.5,2,2" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>
    </ControlTemplate>
    <!-- The brand mark: a tilted playing card holding a three-point jester cap. Foreground fill. -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox IsHitTestVisible="False" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource LocalMarkGeometry}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
    <!-- Headings are Pixelify Sans, so they stay at 17px and up (its c reads as o below that). -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>
    <!-- Keyboard focus: a 2px white frame 3px outside the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" IsHitTestVisible="False" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="9" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Component spacing: 30px menu rows, 32px fields and buttons (the 4px ledge counts inside the 32px), 2px rims eat one pixel of vertical padding. -->
    <Thickness x:Key="ButtonPadding">16,5,16,5</Thickness> <!-- Button: face over a 4px ledge -->
    <Thickness x:Key="InputPadding">10,5,10,5</Thickness> <!-- Text box, password box; 32px with ControlHeight -->
    <Thickness x:Key="MenuPadding">5</Thickness> <!-- Menu panel inset: 2px outline plus 5px, rows 30px -->
    <Thickness x:Key="MenuItemPadding">6,5,8,5</Thickness> <!-- Menu item: 30px row -->
    <Thickness x:Key="ComboBoxDropDownPadding">5</Thickness> <!-- Dropdown board inset -->
    <Thickness x:Key="ComboBoxItemPadding">10,5,8,5</Thickness> <!-- Dropdown row -->
    <Thickness x:Key="ListBoxItemPadding">10,5,10,5</Thickness> <!-- List box item -->
    <Thickness x:Key="GroupBoxPadding">14,12,14,12</Thickness> <!-- Slate panel body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness> <!-- Gap under the panel's blind-bar title -->
    <Thickness x:Key="TooltipPadding">10,6,10,7</Thickness> <!-- Tooltip panel -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double> <!-- Top bar and sidebar icons -->
    <sys:Double x:Key="GameBannerHeight">224</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         scan band and the felt fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Both views start on the right. Center and Stretch flow above media. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->
    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, cut by 16px gutters, so the real carousel replaces it without the page jumping.
         Each Viewbox scales a fixed 1600px layout to the width its column gives it. The tiles are the host's Foreground at
         low opacity; the whole thing pulses while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,6,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- More / Edit: the Run Info (red) and Options (orange) squares. Face over a 4px ledge; hover rocks the plate, scales it 1.08 and
         draws a white rim; pressed it drops onto its ledge. Background = face, BorderBrush = ledge, Foreground = glyph. -->
    <Style x:Key="LocalGameActionSocket" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource LocalDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalDangerLedgeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LocalWhiteBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Pop" />
                                <RotateTransform x:Name="Rock" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border x:Name="Ledge" Margin="0,4,0,0" IsHitTestVisible="False" Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Face" Margin="0,0,0,4" IsHitTestVisible="False" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="Rim" Margin="-2,-2,-2,2" Opacity="0" IsHitTestVisible="False" BorderBrush="{DynamicResource LocalWhiteBrush}" BorderThickness="2" CornerRadius="8" />
                        <ContentPresenter x:Name="Content" Margin="0,0,0,4" IsHitTestVisible="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ActionHoverIn"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Rim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rock" Storyboard.TargetProperty="Angle">
                                        <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="-4" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="3" />
                                        <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="-1.5" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ActionHoverOut"><Storyboard>
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Rim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Rock" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.16" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="0,4,0,0" />
                            <Setter TargetName="Content" Property="Margin" Value="0,4,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LocalGameActionEditSocket" TargetType="{x:Type Button}" BasedOn="{StaticResource LocalGameActionSocket}">
        <Setter Property="Background" Value="{DynamicResource LocalOrangeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalOrangeLedgeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LocalInkBrush}" />
    </Style>
    <!-- Empty game page: an empty joker slot. A dashed card outline (150x200) with the mark rocking slowly inside it and a 0/5 count above
         its corner, 180x240 in all. The rock runs only while the host is visible and is removed on exit. -->
    <ControlTemplate x:Key="LocalEmptySlotTemplate" TargetType="{x:Type Control}">
        <Grid Width="180" Height="240" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <TextBlock Text="0 / 5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,14,0"
                       FontFamily="{DynamicResource LocalPosterFontFamily}" FontSize="17" Foreground="{DynamicResource LocalGreyBrush}" />
            <Rectangle Width="150" Height="200" VerticalAlignment="Bottom" RadiusX="10" RadiusY="10" StrokeThickness="3"
                       Stroke="{DynamicResource LocalLBlackBrush}" StrokeDashArray="3 2.5" Fill="{DynamicResource LocalFeltDeepBrush}" Opacity="0.9" />
            <Control x:Name="EmptyMark" Width="64" Height="64" VerticalAlignment="Bottom" Margin="0,0,0,68" Focusable="False" IsTabStop="False"
                     Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource LocalLBlackBrush}" RenderTransformOrigin="0.5,0.5">
                <Control.RenderTransform>
                    <RotateTransform x:Name="EmptyRock" />
                </Control.RenderTransform>
            </Control>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyRockStory">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="EmptyRock" Storyboard.TargetProperty="Angle" From="-5" To="5" Duration="0:0:1.6">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyRockStory" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a stack of three poker chips on hard ledges (orange, chips blue, danger red) with white edge notches. Hover: the stack rocks on its base with an elastic wobble and the top chip pops up with a bounce. Open (ContextMenu.IsOpen of the nearest Border): the chips ripple up and down in a staggered wave while the top chip takes a lit orange rim, until the menu closes. -->
    <ControlTemplate x:Key="LocalWildhandMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Grid RenderTransformOrigin="0.5,0.9">
                    <Grid.RenderTransform><RotateTransform x:Name="Rock" Angle="0" /></Grid.RenderTransform>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="BobC" Y="0" /></Canvas.RenderTransform>
                    <Canvas Width="26" Height="26">
                        <Canvas.RenderTransform><TranslateTransform x:Name="PopC" Y="0" /></Canvas.RenderTransform>
                        <Rectangle Canvas.Left="3" Canvas.Top="19.0" Width="20" Height="4.6" RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource LocalDangerLedgeBrush}" />
                        <Rectangle Canvas.Left="3" Canvas.Top="17.4" Width="20" Height="4.6" RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource DangerBrush}" />
                        <Rectangle Canvas.Left="6.4" Canvas.Top="18.5" Width="1.6" Height="2.4" Fill="{TemplateBinding Foreground}" Opacity="0.9" /><Rectangle Canvas.Left="12.2" Canvas.Top="18.5" Width="1.6" Height="2.4" Fill="{TemplateBinding Foreground}" Opacity="0.9" /><Rectangle Canvas.Left="18" Canvas.Top="18.5" Width="1.6" Height="2.4" Fill="{TemplateBinding Foreground}" Opacity="0.9" />
                        
                    </Canvas>
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="BobB" Y="0" /></Canvas.RenderTransform>
                    <Canvas Width="26" Height="26">
                        <Canvas.RenderTransform><TranslateTransform x:Name="PopB" Y="0" /></Canvas.RenderTransform>
                        <Rectangle Canvas.Left="3" Canvas.Top="12.799999999999999" Width="20" Height="4.6" RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource LocalPlayLedgeBrush}" />
                        <Rectangle Canvas.Left="3" Canvas.Top="11.2" Width="20" Height="4.6" RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource LocalChipsBrush}" />
                        <Rectangle Canvas.Left="6.4" Canvas.Top="12.299999999999999" Width="1.6" Height="2.4" Fill="{TemplateBinding Foreground}" Opacity="0.9" /><Rectangle Canvas.Left="12.2" Canvas.Top="12.299999999999999" Width="1.6" Height="2.4" Fill="{TemplateBinding Foreground}" Opacity="0.9" /><Rectangle Canvas.Left="18" Canvas.Top="12.299999999999999" Width="1.6" Height="2.4" Fill="{TemplateBinding Foreground}" Opacity="0.9" />
                        
                    </Canvas>
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="BobA" Y="0" /></Canvas.RenderTransform>
                    <Canvas Width="26" Height="26">
                        <Canvas.RenderTransform><TranslateTransform x:Name="PopA" Y="0" /></Canvas.RenderTransform>
                        <Rectangle Canvas.Left="3" Canvas.Top="6.6" Width="20" Height="4.6" RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource LocalOrangeLedgeBrush}" />
                        <Rectangle Canvas.Left="3" Canvas.Top="5" Width="20" Height="4.6" RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource LocalOrangeBrush}" />
                        <Rectangle Canvas.Left="6.4" Canvas.Top="6.1" Width="1.6" Height="2.4" Fill="{TemplateBinding Foreground}" Opacity="0.9" /><Rectangle Canvas.Left="12.2" Canvas.Top="6.1" Width="1.6" Height="2.4" Fill="{TemplateBinding Foreground}" Opacity="0.9" /><Rectangle Canvas.Left="18" Canvas.Top="6.1" Width="1.6" Height="2.4" Fill="{TemplateBinding Foreground}" Opacity="0.9" />
                        <Rectangle x:Name="Lit" Canvas.Left="2.4" Canvas.Top="3.4" Width="21.2" Height="6" RadiusX="1.6" RadiusY="1.6" Stroke="{DynamicResource LocalOrangeLitBrush}" StrokeThickness="1.2" Opacity="0" />
                    </Canvas>
                </Canvas>
                </Grid>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Rock" Storyboard.TargetProperty="Angle" To="-8" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><ElasticEase Oscillations="2" Springiness="5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PopA" Storyboard.TargetProperty="Y" To="-2" BeginTime="0:0:0.04" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BounceEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Rock" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PopA" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BobC" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.1" Duration="0:0:0.01"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BobC" Storyboard.TargetProperty="Y" From="0" To="-1.8" BeginTime="0:0:0.1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BobB" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.1" Duration="0:0:0.01"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BobB" Storyboard.TargetProperty="Y" From="0" To="-1.8" BeginTime="0:0:0.28" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BobA" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.1" Duration="0:0:0.01"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
