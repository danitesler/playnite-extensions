<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is a Windows 11 flyout on Fluent 2's tokens:
    - Panel (LocalFlyoutTemplate, shared by Menu.xaml's submenus, ComboBox.xaml, CustomControls/ComboBoxList.xaml and
      CustomControls/FilterSelectionBox.xaml): colorNeutralBackground1, borderRadiusLarge, a 1px colorNeutralStroke2
      edge with the lighter colorNeutralStroke1 light catching its top (the Windows 11 elevation stroke, standing in for
      shadow16), 4px padding (MenuPadding). No acrylic: a WPF popup cannot reach the backdrop.
    Rows, the NavigationView selection pill and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalFlyoutTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="{DynamicResource PopupBorderThickness}" CornerRadius="{DynamicResource CornerRadiusLarge}" />
            <!-- Elevation stroke: the top edge catches the light -->
            <Border Height="1" Margin="6,0" VerticalAlignment="Top" Background="{DynamicResource NormalBorderBrush}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource MenuPadding}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalFlyoutTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="{TemplateBinding Padding}" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
