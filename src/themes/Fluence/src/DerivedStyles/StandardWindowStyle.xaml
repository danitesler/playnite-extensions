<!--
    Fluence: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    The Windows 11 title bar on the Mica base layer, 40px: a 24px brand tile holding the settings glyph as the app
    icon, the title in the body face (semibold), a 1px stroke closing the band, and a large settings glyph ghosted
    into the right end. Caption buttons are the 46x40 WindowBarButton (square, flush, red close), so the caption and
    the content offset are 40 (Default: 25). PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>
    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="40" VerticalAlignment="Top" Background="{DynamicResource WindowBackgourndBrush}" ClipToBounds="True">
                                    <!-- The settings glyph ghosted into the right end, in a Canvas so it adds no desired width. -->
                                    <Canvas IsHitTestVisible="False">
                                        <ContentControl Canvas.Right="40" Canvas.Top="-26" Width="92" Height="92" Opacity="0.05"
                                                        Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource TextBrush}" />
                                    </Canvas>
                                    <Rectangle Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{DynamicResource NormalBorderBrush}" />
                                    <DockPanel LastChildFill="False">
                                        <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="12,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                CornerRadius="{DynamicResource CornerRadiusSmall}" Background="{DynamicResource PrimaryButtonBackgroundBrush}">
                                            <ContentControl Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{DynamicResource PrimaryButtonForegroundBrush}" />
                                        </Border>
                                        <TextBlock Text="{TemplateBinding Title}" DockPanel.Dock="Left" VerticalAlignment="Center" FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,40,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
