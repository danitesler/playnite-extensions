<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml. Fluent Button "primary": colorBrandBackground, white text, BrandBackgroundHover.
    Motion (Fluent UI react-button styles, @fluentui/tokens): the root transitions background, border and color over durationFaster
    (100ms) on curveEasyEase cubic-bezier(0.33, 0, 0.67, 1); hover is colorBrandBackgroundHover, pressed colorBrandBackgroundPressed,
    and there is no press scale, glow or ripple. Hover and pressed are layers over the plate that fade in over 0.1s and out over 0.1s
    (FillBehavior Stop); the pressed layer is its own, so leaving while pressed strands no hover state.
    LAUNCHING and RUNNING (Playnite swaps Play for the context action, Tag ContextAction): RunningPlate, a solid layer in the success
    green, covers the plate; the hover and pressed layers are off and the label takes the page colour as ink. Layers in the plate's
    radius, under the label: RunningBreath (a page-colour scrim: launching 0.18, running 0.12 to 0 over 4s) and RunningScan, a pale reveal spot
    (a radial mask, TextBrush) gliding across every 1.9s on the easy-ease curve. Hovering the RUNNING plate fades in RunningHoverDim
    (0.5) and shows Cancel in the light text colour; the hover binding is Self (the button's own pointer state, never the game page's).
    Keyboard focus: FocusVisual.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite
        swaps Play for the context action (Running); a success-green hairline rims the button and a 2px progress bar sits
        at its foot, breathing (3s). Launching runs the bar like an indeterminate ProgressBar: it grows from the left in
        0.8s (DecelerateMid), again and again.
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching).
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <!-- Running game (overlay above the label: frame, a faint tint, the progress bar and ring; the slab carries the reveal): the bar glides while launching and is full while running; the ring turns once per loop. -->
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Grid Height="2" Margin="12,0,32,5" VerticalAlignment="Bottom">
                            <Border CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                            <Border x:Name="RunningFill" CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="RunningGlide" Visibility="Collapsed" CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningGlideTail" Color="#00000000" Offset="-0.3" />
                                        <GradientStop x:Name="RunningGlideHead" Color="#FF000000" Offset="-0.25" />
                                        <GradientStop x:Name="RunningGlideTrail" Color="#FF000000" Offset="-0.07" />
                                        <GradientStop x:Name="RunningGlideEdge" Color="#00000000" Offset="-0.02" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                        <Border x:Name="RunningFrame" CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" />
                        <Grid x:Name="RunningMark" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="RunningRingTurn" Angle="0" />
                            </Grid.RenderTransform>
                            <Path Data="M 6,1 A 5,5 0 1 1 1,6" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningGlide" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGlideTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.3" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="-0.3" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.02" KeySpline="0.33,0 0.67,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.02" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGlideHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.25" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="-0.25" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.07" KeySpline="0.33,0 0.67,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.07" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGlideTrail" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.07" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="-0.07" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.25" KeySpline="0.33,0 0.67,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.25" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGlideEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.9">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.02" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="-0.02" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.3" KeySpline="0.33,0 0.67,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.3" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Opacity" Duration="0:0:1.9">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.45" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRingTurn" Storyboard.TargetProperty="Angle" Duration="0:0:1.9">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="360" KeySpline="0.33,0 0.67,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:4">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1" KeySpline="0.4,0 0.6,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Opacity" Duration="0:0:4">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1" KeySpline="0.4,0 0.6,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:4" Value="0.6" KeySpline="0.4,0 0.6,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRingTurn" Storyboard.TargetProperty="Angle" Duration="0:0:4">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:4" Value="360" KeySpline="0.33,0 0.67,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,6,16,6" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Grid">
                        <Border x:Name="Rest" SnapsToDevicePixels="True"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <!-- Launching and running only, in the plate's own shape and under the label. RunningPlate: the solid running colour (the hover fade cannot touch it). RunningBreath: a scrim. RunningScan: the swipe. RunningHoverDim: the Cancel state. -->
                        <Border x:Name="RunningPlate" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="RunningBreath" IsHitTestVisible="False" SnapsToDevicePixels="True" Opacity="0" Background="{DynamicResource WindowBackgourndBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="RunningScan" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TextBrush}" Opacity="0.3">
                            <Border.OpacityMask>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.35" RadiusY="1.4">
                                    <RadialGradientBrush.RelativeTransform>
                                        <TranslateTransform x:Name="RunningRevealShift" X="-0.87" />
                                    </RadialGradientBrush.RelativeTransform>
                                    <GradientStop Color="#FF000000" Offset="0" />
                                    <GradientStop Color="#99000000" Offset="0.45" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Border x:Name="RunningHoverDim" IsHitTestVisible="False" SnapsToDevicePixels="True" Opacity="0" Background="{DynamicResource WindowBackgourndBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="HoverPlate" SnapsToDevicePixels="True" Opacity="0"
                                Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="PressPlate" SnapsToDevicePixels="True" Opacity="0"
                                Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <ContentPresenter x:Name="PlayContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource TextBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressPlate" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:1.9">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.18" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0.18" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRevealShift" Storyboard.TargetProperty="X" Duration="0:0:1.9">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.87" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.87" KeySpline="0.33,0 0.67,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0.87" />
                                    </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressPlate" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:4">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.12" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" KeySpline="0.4,0 0.6,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:4" Value="0.12" KeySpline="0.4,0 0.6,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer (the binding is Self: the button, never the game page). The plate darkens (RunningHoverDim) and the label reads Cancel. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.100" Value="1" KeySpline="0.33,0,0.67,1" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.100" Value="0" KeySpline="0.33,0,0.67,1" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.100" Value="1" KeySpline="0.33,0,0.67,1" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PressPlate" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.100" Value="0" KeySpline="0.33,0,0.67,1" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WindowBackgourndBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WindowBackgourndBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
