<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml (grid mode, side panel).
    The Store product page in the side panel (16px gutters): the box art cover centered (max 280px),
    the title at 20px semibold with the icon, the actions (primary Play or Install at 40px,
    secondary More, subtle icon Button Edit). Below, the same two columns as the details view: Steam screenshots,
    Description and Notes on the left (16px semibold headings); a 320px Game details column on the right. Game details
    lists every metadata field Playnite can show, each a Caption 1 (12px) colorNeutralForeground3 label over its
    Body 1 value, in the six groups of the details view split by 1px colorNeutralStroke2 Dividers (a group whose
    fields are all hidden takes no space).
    The panel edge follows Playnite's panel settings. Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
<Grid>
<!-- Empty state (no game selected), Fluent's empty pattern: a quiet icon (colorNeutralForeground3) over a semibold line, centered in the visible area. It fades in over 250ms (durationGentle, curveDecelerateMid) when it appears; no loop (RemoveStoryboard on exit). -->
<Grid VerticalAlignment="Stretch">
<Grid.Style>
<Style TargetType="Grid">
<Setter Property="Visibility" Value="Collapsed" />
<Style.Triggers>
<DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
<Setter Property="Visibility" Value="Visible" />
</DataTrigger>
</Style.Triggers>
</Style>
</Grid.Style>
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,24">
<StackPanel.Style>
    <Style TargetType="StackPanel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyFadeIn">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.250" Value="1" KeySpline="0,0,0,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyFadeIn" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</StackPanel.Style>
<Viewbox Width="40" Height="40" HorizontalAlignment="Center">
<Canvas Width="20" Height="20">
<!-- fluent: games_20_regular -->
<Path Data="F1M6,7.5C6,7.22386 6.22386,7 6.5,7 6.77614,7 7,7.22386 7,7.5L7,9 8.5,9C8.77614,9 9,9.22386 9,9.5 9,9.77614 8.77614,10 8.5,10L7,10 7,11.5C7,11.7761 6.77614,12 6.5,12 6.22386,12 6,11.7761 6,11.5L6,10 4.5,10C4.22386,10 4,9.77614 4,9.5 4,9.22386 4.22386,9 4.5,9L6,9 6,7.5z M15,8C15,8.55228 14.5523,9 14,9 13.4477,9 13,8.55228 13,8 13,7.44772 13.4477,7 14,7 14.5523,7 15,7.44772 15,8z M12,12C12.5523,12 13,11.5523 13,11 13,10.4477 12.5523,10 12,10 11.4477,10 11,10.4477 11,11 11,11.5523 11.4477,12 12,12z M2,9.5C2,6.46243 4.46243,4 7.5,4L12.5,4C15.5376,4 18,6.46243 18,9.5 18,12.5376 15.5376,15 12.5,15L7.5,15C4.46243,15 2,12.5376 2,9.5z M7.5,5C5.01472,5 3,7.01472 3,9.5 3,11.9853 5.01472,14 7.5,14L12.5,14C14.9853,14 17,11.9853 17,9.5 17,7.01472 14.9853,5 12.5,5L7.5,5z" Fill="{DynamicResource TextBrushDarker}" />
</Canvas>
</Viewbox>
<TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap"
FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
</StackPanel>
</Grid>

                        <DockPanel>
                            <DockPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
