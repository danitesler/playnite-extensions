<!-- Banner: the game's background art as a band at the top. Tinted at the top, darkened toward the title by a page-colored scrim, faded into the page. GameBannerHeight sets the height; 0 turns it off. -->
<Grid x:Name="HeroClip" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" Margin="8,8,8,0" IsHitTestVisible="False">
<Grid.Style>
        <Style TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Grid.Style>

<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
<Grid.Style>
        <Style TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Grid.Style>
<FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
<Border Background="{DynamicResource ContentBackgroundBrush}" Opacity="0.3" />
<!-- No OpacityMask on the banner: masked art repainted in part (behind the animated Play button) left dark patches on scaled displays.
     The fade is a plain gradient to the page color, read from the page brush (PageRoot). -->
<Rectangle>
<Rectangle.Fill>
<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
<GradientStop Color="#00000000" Offset="0.25" />
<GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.95" />
</LinearGradientBrush>
</Rectangle.Fill>
</Rectangle>
</Grid>
<Path Data="M0,0 H6 A6,6 0 0 0 0,6 Z" Fill="{DynamicResource ContentBackgroundBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="6" Height="6" IsHitTestVisible="False" />
<Path Data="M0,0 H6 V6 A6,6 0 0 0 0,0 Z" Fill="{DynamicResource ContentBackgroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="6" Height="6" IsHitTestVisible="False" />
</Grid>
<Grid>

<StackPanel Margin="28,0,28,32">
                                        <!-- Room above the title so it sits low on the banner; gone when the banner is off or the game has no art. -->
<Border  IsHitTestVisible="False">
    <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 84 / 320'}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                    <Setter Property="Height" Value="52" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
</Border>
<DockPanel>
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0"
