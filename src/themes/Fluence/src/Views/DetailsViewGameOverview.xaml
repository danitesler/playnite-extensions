<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details mode, right pane).
    A store product page layout built from Fluent 2 style parts. Hero: the background art, 320px, fading into the content layer
    (colorNeutralBackground1); hidden when there is no art. The page column (max 1000px, 36px sides) starts 120px
    down: the box art tile (Playnite's cover height setting, borderRadiusLarge, 1px colorNeutralStroke2 edge), then
    the title at 28px semibold (Title 1) with the icon and the actions: primary Play (or Install) at 40px (Button size
    large, min 160px wide), secondary More, subtle icon Button Edit (32px, Fluent edit icon).
    Below, two columns under Title 3 headings (20px semibold), no cards (the content layer and Fluent's Card share
    colorNeutralBackground1): the main column holds the Steam screenshots, Description and Notes; the 320px column on
    the right holds every metadata field Playnite can show, each a Caption 1 (12px) colorNeutralForeground3 label over
    its Body 1 value, in six groups split by 1px colorNeutralStroke2 Dividers: progress (completion status, time
    played, last played, recent activity, added), scores, about (developers, publishers, release date, series, age
    rating, region), tags (platforms, genres, categories, features, tags, as small outline InteractionTags), library
    (library, source, version, install size, install folder) and links. A group whose fields are all hidden takes no
    space, and neither does its Divider.
    Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}">
                        <Grid>
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Fill="{DynamicResource ContentBackgroundBrush}">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#40000000" Offset="0" />
                                            <GradientStop Color="#FF000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
<Grid>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>

                            <!-- Hero art, fading into the content layer -->
                            

                            <StackPanel MaxWidth="1000" VerticalAlignment="Top" Margin="24,0,41,32">
                                <Border IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 120 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Product header: box art tile, then title, developer, tags and actions -->
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Margin="0,0,24,0" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                        <!-- No cover: collapse the tile so its 24px gap does not indent the title and actions away from the body's left edge. -->
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageCover}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageCover}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.CacheMode>
                                            <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                        </Grid.CacheMode>
                                        <Grid>
                                            <Grid.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=CoverShape}" />
                                            </Grid.OpacityMask>
                                            <Border x:Name="CoverShape" CornerRadius="{DynamicResource CornerRadiusLarge}" Background="{DynamicResource ContentBackgroundBrush}" />
                                            <Image x:Name="PART_ImageCover" Stretch="Uniform" StretchDirection="Both" Height="{Settings GameDetailsCoverHeight}"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                            <Border CornerRadius="{DynamicResource CornerRadiusLarge}" BorderThickness="{DynamicResource ControlBorderThickness}"
                                                    BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" />
                                        </Grid>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <DockPanel>
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeLargest}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Grid MinWidth="160">
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" MinHeight="40" />
                                                <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" MinHeight="40" />
                                            </Grid>
                                            <Button Padding="0" x:Name="PART_ButtonMoreActions" Width="40" Height="40" Margin="8,0,0,0"
                                                    ToolTip="{DynamicResource LOCMoreAction}">
                                                <ContentPresenter Width="20" Height="20"
                                                                  Content="{DynamicResource IconOptions}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button Padding="0" x:Name="PART_ButtonEditGame" Width="40" Height="40" Margin="8,0,0,0"
                                                    ToolTip="{DynamicResource LOCEditGame}">
                                                <ContentPresenter Width="20" Height="20"
                                                                  Content="{DynamicResource IconEdit}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Body: the main column and the details pane -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="240" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                    <!-- Steam screenshots -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library or Steam source games in that gap; give up after 12s so a game without screenshots does not keep an empty block. When the plugin is not installed or is disabled the binding fails, FallbackValue=PluginUnavailable matches neither True nor False, and no skeleton shows. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                            <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                        <MultiDataTrigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                        </MultiDataTrigger.ExitActions>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                            <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                        <MultiDataTrigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                        </MultiDataTrigger.ExitActions>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <StackPanel Margin="0,40,0,0">
                                            <TextBlock Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}" FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <Grid>
                                                <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                    <Control.Style>
                                                        <Style TargetType="Control">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Control.Style>
                                                </Control>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Description -->
                                    <StackPanel x:Name="PART_ElemDescription" Margin="0,40,0,0">
                                        <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold" Margin="0,0,0,12" />
                                        <HtmlTextView x:Name="PART_HtmlDescription"
                                                      TextElement.Foreground="{DynamicResource TextBrush}"
                                                      Tag="{DynamicResource GlyphBrush}"
                                                      HtmlFontSize="{DynamicResource FontSize}"
                                                      HtmlFontFamily="{DynamicResource FontFamily}"
                                                      HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                      LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                      pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                    </StackPanel>

                                    <StackPanel x:Name="PART_ElemNotes" Margin="0,40,0,0">
                                        <TextBlock Text="{DynamicResource LOCNotesLabel}" FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold" Margin="0,0,0,12" />
                                        <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                 Background="{DynamicResource ControlBackgroundBrush}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" />
                                    </StackPanel>
                                    </StackPanel>

                                    <!-- Details pane: every metadata field, one column -->
                                    <StackPanel Grid.Column="2" Width="{DynamicResource GameDetailsPaneWidth}">
                                        <TextBlock Text="{DynamicResource LOCGameDetails}" FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold" Margin="0,40,0,12" />
                                        <Border ClipToBounds="True">
                                            <StackPanel Margin="0,-33,0,-8">
                                                <Border x:Name="MetaProgress" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <TextBlock x:Name="PART_TextPlayTime" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <TextBlock x:Name="PART_TextLastActivity" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <TextBlock x:Name="PART_TextRecentActivity" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCDateAddedLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <TextBlock x:Name="PART_TextAdded" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaScores" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCCommunityScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <TextBlock x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCCriticScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <TextBlock x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCUserScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <TextBlock x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaAbout" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCDevelopersLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsDevelopers" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCPublishersLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsPublishers" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCSeriesLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsSeries" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsAgeRatings" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemRegion" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCRegionLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsRegions" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaTags" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <StackPanel x:Name="PART_ElemPlatform" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCPlatformsTitle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemGenres" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCGenresLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemCategories" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCCategoriesLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemFeatures" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCFeaturesLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <StackPanel x:Name="PART_ElemTags" Margin="0,8,0,8">
                                                            <TextBlock Text="{DynamicResource LOCTagsLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                            <ItemsControl x:Name="PART_ItemsTags" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaLibrary" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
