<!--
    Overlay on Playnite Default/Views/Library.xaml. WinUI content layer: the title-bar row (TopPanel) stays on the
    base layer, and everything below sits on a lighter layer (colorNeutralBackground1) whose top-left corner is
    rounded (8px, OverlayCornerRadius) where it meets the navigation rail, square when the rail is not on the left.
    Layout and parts are Playnite's: top bar over the panels and views, filter and explorer panels on their
    settings' sides, the three library views stacked.
    Window background (repo AGENTS.md "Window background"): PART_ImageBackground holds the game art only while
    Playnite's "Use game background image as window background" is on, and shows it at full strength with no theme
    scrim, tint, mask or blur: Playnite's own darken and blur settings are the only treatment. The art fills the
    content layer below the top bar, which stays solid; the side panels and game pages turn see-through.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Window art layer (Playnite's window background setting): the library color, the art and its decor in one layer that spans the top bar and
                             reaches under the icon rail (Views/Sidebar.xaml), so the art is one picture across the window. The margin is the rail's thickness. -->
                        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Margin" Value="-44,0,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                                            <Setter Property="Margin" Value="0,0,-44,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                                            <Setter Property="Margin" Value="0,-56,0,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                                            <Setter Property="Margin" Value="0,0,0,-56" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid IsHitTestVisible="False">
                                <Grid.CacheMode>
                                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                </Grid.CacheMode>
                                <!-- Window art (Playnite's window background setting): shown at full strength, top-aligned at its own size;
                                     its bottom edge fades into the color behind it so the art never ends in a hard line. -->
                                <Border x:Name="WindowArtSwatch" Background="{DynamicResource ContentBackgroundBrush}" Visibility="Collapsed" />
                                <Grid VerticalAlignment="Top" IsHitTestVisible="False">
                                    <FadeImage x:Name="PART_ImageBackground" VerticalAlignment="Top" HorizontalAlignment="Center" />
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.55" />
                                                <GradientStop Color="{Binding Background.Color, ElementName=WindowArtSwatch}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </Grid>

                        <TopPanel Grid.Row="0" />

                        <Border x:Name="Layer" Grid.Row="1" CornerRadius="8,0,0,0"
                               >
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                    <Style.Triggers>
                                        <!-- Window art on: the layer is see-through; the art layer above draws the library color and the art. -->
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <DockPanel>
                                    <FilterPanel x:Name="PART_FilterPanel"
                                                 DockPanel.Dock="{Settings FilterPanelPosition}"
                                                 Width="{Settings FilterPanelWitdh}"
                                                 Visibility="{Settings FilterPanelVisible}" />

                                    <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                                   DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                                   Width="{Settings ExplorerPanelWitdh}" />

                                    <Grid DockPanel.Dock="Left">
                                        <LibraryDetailsView x:Name="PART_ViewDetails" />
                                        <LibraryGridView x:Name="PART_ViewGrid" />
                                        <LibraryListView x:Name="PART_ViewList" />
                                    </Grid>
                                </DockPanel>

                                <Path x:Name="LayerCorner" Data="M0,0 H8 A8,8 0 0 0 0,8 Z"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      IsHitTestVisible="False" SnapsToDevicePixels="True"
                                      Fill="{DynamicResource WindowBackgourndBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: no rounded corner where the layer meets the rail; the art runs under the rail. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="LayerCorner" />
                            <Setter Property="CornerRadius" Value="0" TargetName="Layer" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="LayerCorner" />
                            <Setter Property="CornerRadius" Value="0" TargetName="Layer" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="LayerCorner" />
                            <Setter Property="CornerRadius" Value="0" TargetName="Layer" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="LayerCorner" />
                            <Setter Property="CornerRadius" Value="0" TargetName="Layer" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings ShowSidebar}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="LayerCorner" />
                            <Setter Property="CornerRadius" Value="0" TargetName="Layer" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
