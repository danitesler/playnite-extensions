<!--
    Overlay on Playnite Default/CustomControls/SliderEx.xaml. Playnite uses SliderEx for the grid zoom slider and
    in settings. Theme files load one by one after DefaultControls, so the StaticResource below resolves to the
    theme's own Slider style (DefaultControls/Slider.xaml): SliderEx gets its template, colors and triggers with
    nothing repeated here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SliderEx}" BasedOn="{StaticResource {x:Type Slider}}" />
</ResourceDictionary>
