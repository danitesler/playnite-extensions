<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    NavigationViewItem in a compact pane, sized to the repo's rail (44x40 item, 16px glyphs): a 32x32 borderRadiusMedium
    plate takes the subtle fill on hover. The selected item keeps the subtle fill and shows the selection indicator: a
    3x16 brand pill on the plate's left edge. Icons sit in a fixed 16x16 box (no IconPadding); Library and Statistics
    use Fluent System Icons from Media.xaml. PART_ProgressStatus is a 2px brand bar along the plate's bottom edge.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Grid x:Name="Plate" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Grid x:Name="IconHost" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox x:Name="ItemIcon">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Viewbox>
                                <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                                ContentTemplate="{DynamicResource IconTemplate}" />
                            </Grid>
                            <ProgressBar x:Name="PART_ProgressStatus" Height="2" Margin="4,0,4,0"
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource GlyphBrush}"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                            <Border x:Name="Indicator" Width="3" Height="16" Visibility="Collapsed" IsHitTestVisible="False"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="1.5"
                                    Background="{DynamicResource GlyphBrush}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Indicator" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Width" Value="16" TargetName="Indicator" />
                            <Setter Property="Height" Value="3" TargetName="Indicator" />
                            <Setter Property="HorizontalAlignment" Value="Center" TargetName="Indicator" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="Indicator" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Width" Value="16" TargetName="Indicator" />
                            <Setter Property="Height" Value="3" TargetName="Indicator" />
                            <Setter Property="HorizontalAlignment" Value="Center" TargetName="Indicator" />
                            <Setter Property="VerticalAlignment" Value="Bottom" TargetName="Indicator" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
