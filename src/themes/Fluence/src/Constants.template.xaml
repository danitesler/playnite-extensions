<!--
    Fluence: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from tokens.css
    (Fluent's webDarkTheme tokens) and writes the result to the build as Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo: Playnite's
    palette keys, then shared keys for roles Playnite has none for. Each placeholder names the Fluent token that plays
    the role (colorNeutralBackground1, borderRadiusMedium, strokeWidthThin), so Fluent's names live in tokens.css and
    here only. Theme XAML reads the brushes (never the Color keys), so ThemeModifier edits reach every control.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). fontSizeBase300 (14px) is the body size, fontSizeBase200 (12px) caption. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">28</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:fontFamilyBase|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys): strokeWidthThin, and borderRadiusMedium as the medium step of the radius scale. -->
    <Thickness x:Key="PopupBorderThickness">{{px:strokeWidthThin}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:strokeWidthThin}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:strokeWidthThin}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:borderRadiusMedium}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale: borderRadiusSmall / -Large / -Circular -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:borderRadiusSmall}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:borderRadiusLarge}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">10000</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor (selection, checked, links) is the compound brand with colorNeutralForegroundInverted as
        TextColorDark; primary buttons use colorBrandBackground (PrimaryButton* below).
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{colorNeutralForeground1}}</Color>
    <Color x:Key="TextColorDarker">{{colorNeutralForeground3}}</Color>
    <Color x:Key="TextColorDark">{{colorNeutralForegroundInverted}}</Color>
    <Color x:Key="MainColor">{{colorNeutralBackground1}}</Color>
    <Color x:Key="MainColorDark">{{colorNeutralBackground1}}</Color>
    <Color x:Key="HoverColor">{{colorSubtleBackgroundHover}}</Color>
    <Color x:Key="GlyphColor">{{colorCompoundBrandBackground}}</Color>
    <Color x:Key="HighlightGlyphColor">{{colorCompoundBrandBackground/50}}</Color>
    <Color x:Key="PopupBackgroundColor">{{colorNeutralBackground1}}</Color>
    <Color x:Key="PopupBorderColor">{{colorNeutralStroke2}}</Color>     <!-- stands in for shadow16 -->
    <Color x:Key="BackgroundToneColor">{{colorNeutralBackground1}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>     <!-- no frame around covers -->
    <Color x:Key="PanelSeparatorColor">#00000000</Color>         <!-- no lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{colorNeutralStroke2}}</Color>
    <Color x:Key="DataChangeNotifColor">{{colorStatusWarningForeground1}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{colorNeutralStroke1}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{colorNeutralBackground1}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{colorNeutralBackground1}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{colorNeutralBackground1}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{colorStatusSuccessForeground1}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{colorStatusDangerForeground1}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{colorPaletteYellowForeground1}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{colorStatusDangerForeground1}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{colorNeutralBackground1}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{colorNeutralBackground2}}" />   <!-- base layer (stands in for Mica) -->

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell: Windows 11 content layer over the base layer -->
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{colorNeutralBackground1}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{colorSubtleBackgroundSelected}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{colorNeutralBackground1Hover}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{colorStrokeFocus2}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{colorPaletteRedBackground3}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{colorNeutralForeground1}}" />

    <!-- Buttons: Button secondary (colorNeutralBackground1*), primary (colorBrand*) -->
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{colorNeutralBackground1Hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{colorNeutralBackground1Pressed}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{colorNeutralBackground1Selected}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{colorBrandBackground}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{colorBrandBackgroundHover}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{colorNeutralForegroundOnBrand}}" />

    <!-- Inputs: Input outline, accessible-stroke bottom edge -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{colorNeutralBackground1}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{colorNeutralStroke1Hover}}" />
    <SolidColorBrush x:Key="InputUnderlineBrush" Color="{{colorNeutralStrokeAccessible}}" />
    <SolidColorBrush x:Key="InputHoverUnderlineBrush" Color="{{colorNeutralStrokeAccessibleHover}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{colorNeutralStrokeAccessible}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{colorNeutralStrokeAccessibleHover}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{colorNeutralStrokeAccessible}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{colorNeutralBackground1}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{colorCompoundBrandBackgroundHover}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{colorNeutralBackground6}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{colorNeutralForeground3}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{colorNeutralForeground1}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{colorNeutralStroke1}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{colorNeutralStrokeAccessible}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{colorNeutralStroke1Hover}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{colorNeutralStrokeAccessibleHover}}" />
</ResourceDictionary>
