<!--
    Inkbolt: dialog windows (Settings, game editor, add-ons). A 44px ink black band (CaptionHeight 44 = the content offset)
    with grain: the theme's mark opens the title in the heading face, the cobalt damask ribbon runs in from the right
    under the 46x44 WindowBarButton caption buttons, and a 2px charcoal rule closes it. One hairline frames the window.
    The Settings window has no Title, so a trigger names it. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" ClipToBounds="True">
                                    <Border Background="{DynamicResource WindowTitleBackgroundBrush}" />
                                    <Control Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource SelectedBrush}" Opacity="0.14" Focusable="False" />
                                    <!-- The cobalt damask ribbon runs in from the right, under the caption buttons, fading out toward the title. -->
                                    <Control Template="{DynamicResource RibbonTemplate}" Foreground="{DynamicResource StripeBrush}" Opacity="0.95" Width="440" Height="44"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,138,0" Focusable="False" IsHitTestVisible="False">
                                        <Control.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="0.3" />
                                            </LinearGradientBrush>
                                        </Control.OpacityMask>
                                    </Control>
                                    <!-- The theme's mark opens the title. -->
                                    <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource SelectedBrush}" Width="26" Height="26"
                                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Focusable="False" IsHitTestVisible="False" />
                                    <!-- PART_TextTitle keeps the real title (Playnite and the Settings trigger set it); the band shows an uppercase copy.
                                         Playnite makes this element visible once a window has a Title, and unstyled it draws bare text over the band's
                                         top-left corner. So it lives in a Collapsed parent (a collapsed parent hides it whatever its own Visibility)
                                         and is also zero-sized and transparent. -->
                                    <Border Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="{TemplateBinding Title}" x:Name="PART_TextTitle" Width="0" Height="0" Opacity="0" Foreground="Transparent" />
                                    </Border>
                                    <TextBlock Text="{Binding Text, ElementName=PART_TextTitle, Converter={StaticResource StringToUpperCaseConverter}}"
                                               Margin="52,0,150,2" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLarger}"
                                               Foreground="{DynamicResource WindowTitleForegroundBrush}" IsHitTestVisible="False"
                                               Style="{DynamicResource BaseTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                                <!-- The closing rule: 2px of charcoal on the band's bottom edge. -->
                                <Border Height="2" VerticalAlignment="Top" Margin="0,42,0,0" Background="{DynamicResource TopPanelRuleStartBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
