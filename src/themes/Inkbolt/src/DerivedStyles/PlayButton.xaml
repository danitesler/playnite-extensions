<!--
    Inkbolt: Play, the source's menu cursor made into a button. A cobalt slab with the arrowhead notch (ArrowPlateTemplate), a
    play glyph and an uppercase label in ink black, the heading face. Layers bottom to top: plate, hover plate, pressed
    plate, label, and above/below the plate two pairs of lightning arcs (Images/fx/arc-a, arc-b, arc-c: white masks
    filled with PrimaryButtonGlowBrush, so ThemeModifier recolors them).
    Hover, animated both ways (no setters on animated parts, so nothing snaps):
      in  0.18s: the plate lights to the lit bolt blue and the arcs fade in; while hovered the arcs jump between their
          two variants in four 90ms steps (a comic cut, DiscreteDoubleKeyFrame) on a 0.36s loop.
      out 0.35s: the plate settles and the arcs fade; every exit animation has FillBehavior Stop, so no clock is left running.
    Press, on its own layer so leaving while pressed cannot strand the hover state: a near-white slab flashes in (0.06s)
    and fades out (0.22s) on release.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite
        swaps Play for the context action (RUNNING); a charge-green hairline and foot bar hold the slab with a small bolt at
        its right end, breathing (3s). Launching crackles like a short circuit: irregular hard flashes (0.7s).
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching).
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Control x:Name="RunningWash" Template="{DynamicResource ArrowPlateTemplate}" Foreground="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" Focusable="False" />
                        <Grid x:Name="RunningFrame">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2,2,0,2" />
                            <Border Margin="2,2,0,2" BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1,1,0,1" Opacity="0.7" />
                            <Path Grid.Column="1" Data="M0,0 L10,10 L0,20" Stretch="Fill" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" StrokeLineJoin="Miter" />
                        </Grid>
                        <Grid Height="2" Margin="8,0,18,5" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Path x:Name="RunningBolt" Width="8" Height="13" Margin="0,0,16,0" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="Fill"
                              Data="M7,0 L1,9 L5,9 L3,16 L10,6 L6,6 L9,0 Z" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform x:Name="RunningBoltScale" ScaleX="1" ScaleY="0.8" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.6,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBolt" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.24" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.34" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBoltScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.8" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBolt" Storyboard.TargetProperty="Opacity" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBoltScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.1" Value="1.2" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.28" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the scan has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,0,30,2" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Arcs: above and below the plate, outside its bounds. Each pair is two variants that swap in the flicker. -->
                        <Grid x:Name="ArcWrap" Margin="-4,-17,-4,-17" IsHitTestVisible="False" Opacity="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>
                            <Rectangle x:Name="ArcTopA" Grid.Row="0" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/arc-a.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle x:Name="ArcTopB" Grid.Row="0" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/arc-b.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle x:Name="ArcBottomA" Grid.Row="2" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleX="-1" /></Rectangle.RenderTransform>
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/arc-c.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle x:Name="ArcBottomB" Grid.Row="2" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/arc-b.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                        <Control x:Name="Plate" Template="{DynamicResource ArrowPlateTemplate}" Foreground="{TemplateBinding Background}" Focusable="False" />
                        <Control x:Name="RunningBreath" Template="{DynamicResource ArrowPlateTemplate}" Foreground="{DynamicResource ScrimBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Opacity="0" />
                        <Grid x:Name="RunningScan" Visibility="Collapsed" Opacity="0.3" IsHitTestVisible="False">
                            <Grid.OpacityMask>
                                <DrawingBrush TileMode="Tile" Viewbox="0,0,8,64" ViewboxUnits="Absolute" Viewport="0,0,8,64" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#FF000000">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,6,64" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.OpacityMask>
                            <Control Template="{DynamicResource ArrowPlateTemplate}" Foreground="{DynamicResource RunningIndicatorBrush}" Focusable="False" IsTabStop="False">
                                <Control.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.3" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.298" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanCap" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Control.OpacityMask>
                            </Control>
                        </Grid>
                        <Control x:Name="RunningHoverDim" Template="{DynamicResource ArrowPlateTemplate}" Foreground="{DynamicResource ScrimBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Opacity="0" />
                        <Grid x:Name="HoverFx">
                            <Control x:Name="HoverPlate" Template="{DynamicResource ArrowPlateTemplate}" Foreground="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Opacity="0" Focusable="False" />
                            <Control x:Name="PressedPlate" Template="{DynamicResource ArrowPlateTemplate}" Foreground="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0" Focusable="False" />
                        </Grid>
                        <StackPanel x:Name="LabelRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <ContentControl x:Name="PlayGlyph" Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{TemplateBinding Foreground}"
                                            Focusable="False" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ContentPresenter x:Name="PlayContent" VerticalAlignment="Center" RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type sys:String}">
                                        <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </StackPanel>
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ArcWrap" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.95" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.6,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.298" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.002" KeySpline="0.6,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.002" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.3" KeySpline="0.6,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanCap" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.302" KeySpline="0.6,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.302" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ArcWrap" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.84" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.84" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ArcWrap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ArcTopA" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.27" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ArcTopB" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.27" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ArcBottomA" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.27" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ArcBottomB" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.27" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="ArcWrap" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="ArcTopA" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="ArcTopB" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="ArcBottomA" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="ArcBottomB" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" TargetName="Root" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <!-- Launching and running keep Play's plate, filled with the running colour. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
                    <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsRunning}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
