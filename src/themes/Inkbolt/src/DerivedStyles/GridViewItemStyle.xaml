<!--
    Inkbolt: cover tiles, drawn as the source's torn documents.
    Selected, static: a 2px lightning-blue rim around the cover and a 3px near-white slab along its foot, as the source
    marks the chosen row with its slab.
    Hover, animated both ways: the black ink frame (InkFrameTemplate, bitten 6px into the cover's edge) and a 1px white
    rim fade in over 0.12s while a short arc of lightning sweeps along the top edge once (0.45s). Leaving fades both out
    over 0.3s with FillBehavior Stop. Hover and selected share no layer, so one never reads as the other.
    Drawn inside the item's spacing margin. Library art behind has no OpacityMask (reference.md). The theme has no corner
    radius, so the covers need no rounded clip.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}" Margin="{Settings ItemSpacingMargin}" x:Name="ItemGrid">
                        <ContentPresenter />
                        <!-- Selected, static: lightning-blue rim and a slab along the foot. -->
                        <Border x:Name="SelectionBorder" BorderThickness="2" Margin="-2" IsHitTestVisible="False" />
                        <Border x:Name="SelectedSlab" Height="3" VerticalAlignment="Bottom" Margin="-2,0,-2,-5" Background="{DynamicResource SelectedBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="6" Opacity="0.16" />
                            <Grid x:Name="RunningScan" Visibility="Collapsed" Opacity="0.32" IsHitTestVisible="False">
                                <Grid.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewbox="0,0,8,64" ViewboxUnits="Absolute" Viewport="0,0,8,64" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#FF000000">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,6,64" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Grid.OpacityMask>
                                <Border Background="{DynamicResource RunningIndicatorBrush}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.3" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.298" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanCap" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                            <Grid Height="22" Margin="6,0,6,6" VerticalAlignment="Bottom">
                                <Border Background="{DynamicResource ScrimBrush}" Opacity="0.85" />
                                <Path x:Name="RunningBolt" Width="9" Height="15" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Fill"
                                      Data="M7,0 L1,9 L5,9 L3,16 L10,6 L6,6 L9,0 Z" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="RunningBoltScale" ScaleX="1" ScaleY="0.8" />
                                    </Path.RenderTransform>
                                </Path>
                                <Grid Height="2" Margin="22,0,6,4" VerticalAlignment="Bottom">
                                    <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                    <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </Grid>
                        <!-- Hover, animated: the ink frame, a white rim and one sweep of lightning along the top edge. -->
                        <Grid x:Name="HoverWrap" IsHitTestVisible="False" Opacity="0">
                            <Border BorderThickness="1" Margin="-1" BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                            <Control x:Name="HoverFrame" Template="{DynamicResource InkFrameTemplate}" Foreground="{DynamicResource TextBrushDark}"
                                     Margin="-6" Focusable="False" />
                            <Grid Height="28" VerticalAlignment="Top" Margin="0,-14,0,0" ClipToBounds="True">
                                <Control x:Name="Spark" Template="{DynamicResource ArcStripTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}" Width="96"
                                         HorizontalAlignment="Left" Focusable="False" Visibility="Hidden">
                                    <Control.RenderTransform>
                                        <TranslateTransform x:Name="SparkShift" X="-96" />
                                    </Control.RenderTransform>
                                </Control>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverWrap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Spark" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SparkShift" Storyboard.TargetProperty="X" From="-96" To="420" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverWrap" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" FillBehavior="Stop" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Spark" Storyboard.TargetProperty="Visibility" FillBehavior="Stop">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedSlab" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <Setter TargetName="HoverWrap" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.6,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.298" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.002" KeySpline="0.6,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.002" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.3" KeySpline="0.6,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanCap" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.302" KeySpline="0.6,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.302" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.6,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBolt" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.24" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.34" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBoltScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.7">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.8" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.8" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter TargetName="HoverWrap" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBolt" Storyboard.TargetProperty="Opacity" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBoltScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.1" Value="1.2" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.28" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.9" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the scan has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
