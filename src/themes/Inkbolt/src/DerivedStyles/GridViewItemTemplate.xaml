<!--
    Inkbolt: cover content. Parts from Playnite Default 10.60: PART_PanelHost, PART_ImageCover, PART_ButtonPlay,
    PART_ButtonInfo; the empty-cover name and darken-uninstalled rules are kept.
    Hover, animated both ways: the shade fades in; the controls slide in from the left (16px, BackEase 0.3) and scale
    0.86 to 1, Info 50ms after Play (0.2s), the way the source's menu list slides in; leaving reverses in 0.2s with
    FillBehavior Stop. Controls are GridTileButton: the source's controller-button tiles, near-white with an ink glyph
    (IconPlay, IconDownload for uninstalled games, IconInfo); hover lights the tile to the bolt blue. No OpacityMask on
    anything behind them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- GridTileButton (Info): a button-prompt disc, the round face button of the controller the game prints beside every action. A black
         disc in a chalk ring with a grey glyph; hover floods it bolt blue, the ring brightens and the glyph pops 1.12 to 1.
         GridTilePlayButton below is the white arrowhead menu cursor. -->
    <Style x:Key="GridTileButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid UseLayoutRounding="False" Background="Transparent">
                        <Ellipse Margin="3" Fill="{DynamicResource SelectedBrush}" Stroke="{DynamicResource TextBrushDark}" StrokeThickness="1" IsHitTestVisible="False" />
                        <Ellipse x:Name="Lit" Margin="3" Fill="{DynamicResource GlyphBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Ellipse x:Name="Ring" Margin="1" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5" Opacity="0" IsHitTestVisible="False" />
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="GlyphScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Viewbox Width="18" Height="18">
                                <ContentControl Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}"
                                                Foreground="{DynamicResource TextBrushDark}" Focusable="False" />
                            </Viewbox>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PromptIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="GlyphScale" Storyboard.TargetProperty="ScaleX" From="1.15" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlyphScale" Storyboard.TargetProperty="ScaleY" From="1.15" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PromptIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Lit" Property="Fill" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GridTilePlayButton: the white arrowhead cursor the menus use for the current row (a slab with its point on the right) in the ink
         glyph. Hover: the slab goes bolt blue and a zig-zag lightning line crackles along its top edge in four hard flickers; press flashes arc white. -->
    <Style x:Key="GridTilePlayButton" TargetType="Button" BasedOn="{StaticResource GridTileButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid UseLayoutRounding="False" Background="Transparent">
                        <Path x:Name="Slab" Data="M1,6 L36,6 L47,24 L36,42 L1,42 Z" Fill="{DynamicResource SelectedBrush}" Stroke="{DynamicResource TextBrushDark}" StrokeThickness="1" IsHitTestVisible="False" />
                        <Path x:Name="Lit" Data="M1,6 L36,6 L47,24 L36,42 L1,42 Z" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Path x:Name="Arc" Data="M1,3 L9,7 L15,2 L23,7 L30,2 L37,6 L45,2" Stroke="{DynamicResource PrimaryButtonGlowBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter"
                              Opacity="0" IsHitTestVisible="False" />
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="GlyphScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Viewbox Width="20" Height="20">
                                <ContentControl Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}"
                                                Foreground="{DynamicResource TextBrushDark}" Focusable="False" />
                            </Viewbox>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CursorIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arc" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="0.2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="0.45" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="GlyphScale" Storyboard.TargetProperty="ScaleX" From="1.15" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlyphScale" Storyboard.TargetProperty="ScaleY" From="1.15" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CursorIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Lit" Property="Fill" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="{DynamicResource GridItemBackgroundBrush}">
                        <StackPanel Name="PART_PanelHost"
                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                            <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}">
                                <Image Name="PART_ImageCover"
                                       RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="{Settings CoverArtStretch}" />
                                <Border Background="{DynamicResource WindowBackgourndBrush}" Opacity="0.6" x:Name="TextGameName" Visibility="Collapsed">
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Margin="5"
                                               Style="{StaticResource BaseTextBlockStyle}" Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- Darken uninstalled (static) and the hover shade (animated) are separate layers. -->
                                <Border Background="{DynamicResource WindowBackgourndBrush}" Opacity="0.66" x:Name="BorderUninstalled" Visibility="Collapsed" />
                                <Border Background="{DynamicResource WindowBackgourndBrush}" x:Name="BorderMouseOver" Opacity="0" />
                                <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="150"
                                         Name="GameControls" Visibility="Hidden">
                                    <StackPanel Orientation="Horizontal" Margin="14">
                                        <Button Name="PART_ButtonPlay" Style="{StaticResource GridTilePlayButton}" Margin="0,0,4,0"
                                                Content="{DynamicResource IconPlay}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="PlayScale" ScaleX="0.86" ScaleY="0.86" />
                                                    <TranslateTransform x:Name="PlayRise" X="-16" />
                                                </TransformGroup>
                                            </Button.RenderTransform>
                                        </Button>
                                        <Button Name="PART_ButtonInfo" Style="{StaticResource GridTileButton}" Margin="4,0,0,0"
                                                Content="{DynamicResource IconInfo}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="InfoScale" ScaleX="0.86" ScaleY="0.86" />
                                                    <TranslateTransform x:Name="InfoRise" X="-16" />
                                                </TransformGroup>
                                            </Button.RenderTransform>
                                        </Button>
                                    </StackPanel>
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Padding="2,5,2,5" Grid.Row="1" Grid.Column="0"
                                       Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="{DynamicResource IconDownload}" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderUninstalled" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="PlayRise" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.05" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="InfoRise" Storyboard.TargetProperty="X" To="0" BeginTime="0:0:0.05" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="InfoScale" Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.05" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="InfoScale" Storyboard.TargetProperty="ScaleY" To="1" BeginTime="0:0:0.05" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BorderMouseOver" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PlayRise" Storyboard.TargetProperty="X" To="-16" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="InfoRise" Storyboard.TargetProperty="X" To="-16" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="0.86" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="0.86" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="InfoScale" Storyboard.TargetProperty="ScaleX" To="0.86" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="InfoScale" Storyboard.TargetProperty="ScaleY" To="0.86" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="GameControls" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
