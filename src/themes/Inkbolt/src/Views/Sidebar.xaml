<!--
    Inkbolt: left rail, 44px of ink black with grain and an ink splatter at its foot, closed on its inner edge by a
    1px charcoal rule. The source's button-tile column: the main menu is the theme's own mark (a broken ring around a
    bolt) on a 32px charcoal tile; hover turns the bolt lightning blue. With the sidebar at the top or bottom the
    splatter and the edge rule drop away. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <!-- The splatter sits on a Canvas (no desired size): a 210px control in the Grid would widen the rail past 44px. -->
                            <Canvas x:Name="SplatHost" Height="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Control x:Name="Splat" Template="{DynamicResource SplatterTemplate}" Foreground="{DynamicResource NormalBrush}" Opacity="0.55"
                                         Width="210" Height="210" Canvas.Left="-70" Canvas.Bottom="-30" Focusable="False" />
                            </Canvas>
                            <Control x:Name="Grain" Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource SelectedBrush}" Opacity="0.14" Focusable="False" />
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="56" Margin="0,0,0,0"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Border x:Name="Tile" Width="32" Height="32" VerticalAlignment="Top" Margin="0,8,0,0" Background="{DynamicResource NormalBrush}" SnapsToDevicePixels="True" />
                                        <Control x:Name="MenuMark" Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                 Width="26" Height="26" VerticalAlignment="Top" Margin="0,11,0,0" Focusable="False" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                            <Border x:Name="EdgeRule" Width="1" HorizontalAlignment="Right" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                    Background="{DynamicResource WindowPanelSeparatorBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Background" Value="{DynamicResource ListItemHoverBrush}" TargetName="Tile" />
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="MenuMark" />
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Splat" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Margin" Value="0,6,0,0" TargetName="Tile" />
                            <Setter Property="Margin" Value="0,9,0,0" TargetName="MenuMark" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Splat" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Margin" Value="0,6,0,0" TargetName="Tile" />
                            <Setter Property="Margin" Value="0,9,0,0" TargetName="MenuMark" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
