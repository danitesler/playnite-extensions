<!--
    Inkbolt: game page, details view. Generated by art/gen-overviews.mjs; edit the generator, not this file.
    Skeleton (src/themes/AGENTS.md -> Game page): banner (GameBannerHeight, default 260) shown clean, darkened at its
    head and faded into the page, the cobalt corner ribbon over it as page decor; spacer x * 128 / 260 (28 with no
    banner); the game name as the mission toast (heading face, uppercase, near-white over a hard 2px black copy), the
    actions beside it (Play slab 204x40, More and Edit 40x40 icon squares with tooltips, always visible); then the
    screenshots in one ink frame, description and notes under grey section bands on the left and the detail panel on
    the right (GameDetailsPaneWidth, 300 content width) headed by the play-time band.
    Empty state: the loading screen (mark, tip line, two-tone bar). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="DetailsViewGameOverview">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DetailsViewGameOverview">
                    <ScrollViewer x:Name="PART_ScrollViewHost" Visibility="Visible" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                        <Grid x:Name="PageRoot" UseLayoutRounding="True">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Background" Value="{DynamicResource GameOverviewBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                <Setter Property="Height" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Height="120" VerticalAlignment="Top" Opacity="0.7">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.25" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <Control Template="{DynamicResource RibbonCornerTemplate}" Foreground="{DynamicResource StripeBrush}" Opacity="0.55" Width="240" Height="240"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Focusable="False" IsHitTestVisible="False" />
                            <StackPanel Margin="30,0,30,30">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border x:Name="DetailsBannerSpacer" MinHeight="20">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 128 / 260'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="20" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed"><Setter Property="Height" Value="20" /></DataTrigger>
                                </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel Margin="0,10,0,18">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                                        <Grid MinWidth="204" Height="40">
                                            <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                            <Button x:Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" />
                                            <Control Style="{DynamicResource RunningActionIndicator}" />
                                        </Grid>
                                        <Button x:Name="PART_ButtonMoreActions" Width="40" Height="40" Padding="0" Margin="12,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                            <ContentControl Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                        <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource LOCEditGame}">
                                            <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>
                                    <DockPanel>
                                        <Image x:Name="PART_ImageIcon" MaxWidth="44" MaxHeight="44" Margin="0,0,14,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLargest}"
                                                       Foreground="Transparent" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName, Converter={StaticResource StringToUpperCaseConverter}}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLargest}"
                                                       Foreground="{DynamicResource TextShadowBrush}" TextWrapping="Wrap" Margin="2,2,-2,-2" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text, ElementName=PART_TextDisplayName, Converter={StaticResource StringToUpperCaseConverter}}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLargest}"
                                                       Foreground="{DynamicResource SelectedBrush}" TextWrapping="Wrap" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, ElementName=PART_TextDisplayName}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DockPanel>
                                </DockPanel>
                                <Grid Margin="0,20,0,0" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 26 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="26,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<Grid VerticalAlignment="Top" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                        <Border Background="{DynamicResource ExpanderBackgroundBrush}">
                                            <StackPanel>
                                                <Border x:Name="PART_ElemPlayTime" Background="{DynamicResource HeaderBandBrush}" Padding="16,8,16,8" MinHeight="46">
                                                    <Grid>
                                                        <TextBlock x:Name="PART_TextPlayTime" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFontFamily}"
                                                                   FontWeight="Bold" FontSize="26" Foreground="{DynamicResource HeaderBandForegroundBrush}" />
                                                        <TextBlock Text="{DynamicResource LOCTimePlayed}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFontFamily}"
                                                                   FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource HeaderBandForegroundBrush}" Margin="12,0,0,0" />
                                                    </Grid>
                                                </Border>
                                                <Border Padding="16,10,16,16">
                                                    <StackPanel Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch" x:Name="DetailsMetadataContent">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                        <Grid ClipToBounds="True" x:Name="DetailsMetadataViewport">
                                                            <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-31,0,-6" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-31,-24,-6" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                                <Border x:Name="MetaProgress" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <Border x:Name="PART_ElemCompletionStatus" Margin="0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="108" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                                <Border Grid.Column="1" Margin="8,0,0,0">
                                                                                    <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PropertyItemButton}" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemLastPlayed" Margin="0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="108" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCLastPlayed}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                                <Border Grid.Column="1" Margin="8,0,0,0">
                                                                                    <TextBlock x:Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemRecentActivity" Margin="0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="108" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                                <Border Grid.Column="1" Margin="8,0,0,0">
                                                                                    <TextBlock x:Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemAdded" Margin="0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="108" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCDateAddedLabel}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                                <Border Grid.Column="1" Margin="8,0,0,0">
                                                                                    <TextBlock x:Name="PART_TextAdded" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaScores" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <Border x:Name="PART_ElemCommunityScore" Margin="0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="108" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCCommunityScore}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                                <Border Grid.Column="1" Margin="8,0,0,0">
                                                                                    <TextBlock x:Name="PART_TextCommunityScore" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemCriticScore" Margin="0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="108" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCCriticScore}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                                <Border Grid.Column="1" Margin="8,0,0,0">
                                                                                    <TextBlock x:Name="PART_TextCriticScore" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemUserScore" Margin="0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="108" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCUserScore}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                                <Border Grid.Column="1" Margin="8,0,0,0">
                                                                                    <TextBlock x:Name="PART_TextUserScore" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaAbout" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <Border x:Name="PART_ElemDevelopers" Margin="0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="108" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCDeveloperLabel}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                                <Border Grid.Column="1" Margin="8,0,0,0">
                                                                                    <ItemsControl x:Name="PART_ItemsDevelopers" Tag="">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <WrapPanel />
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                    </ItemsControl>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemPublishers" Margin="0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="108" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCPublisherLabel}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                                <Border Grid.Column="1" Margin="8,0,0,0">
                                                                                    <ItemsControl x:Name="PART_ItemsPublishers" Tag="">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <WrapPanel />
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                    </ItemsControl>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemReleaseDate" Margin="0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="108" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                                <Border Grid.Column="1" Margin="8,0,0,0">
                                                                                    <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PropertyItemButton}" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemSeries" Margin="0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="108" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCSeriesLabel}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                                <Border Grid.Column="1" Margin="8,0,0,0">
                                                                                    <ItemsControl x:Name="PART_ItemsSeries" Tag="">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <WrapPanel />
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                    </ItemsControl>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemAgeRating" Margin="0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="108" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                                <Border Grid.Column="1" Margin="8,0,0,0">
                                                                                    <ItemsControl x:Name="PART_ItemsAgeRatings" Tag="">
