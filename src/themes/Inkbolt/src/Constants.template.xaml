<!--
    Inkbolt: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo, plus a few
    Inkbolt keys (SelectedBrush, HeaderBandBrush, GlyphBrush, ...) for the source's own parts.
    Each placeholder names the token that plays the key's role. Theme XAML reads brushes only, never Color keys.

    Placeholder syntax: docs/themes/reference.md. Keep double braces out of comments here: the build renders
    them too.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography. Barlow and Barlow Condensed (OFL) stand in for the source's distressed condensed capitals; both are
         bundled in src/Typography and lead their stacks as ./Typography/#Family. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">22</sys:Double>
    <sys:Double x:Key="FontSizeLargest">44</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow, {{text:font-body|Barlow}}, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Barlow Condensed, {{text:font-heading|Barlow Condensed}}, Arial Narrow, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width; apply inside the pane's horizontal padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: the menu's plates are square-cut. Radius is 0 everywhere; the only round shapes are the ring segments of the mark. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{ik-chalk}}</Color>
    <Color x:Key="TextColorDarker">{{ik-smoke}}</Color>
    <Color x:Key="TextColorDark">{{ik-black}}</Color>
    <Color x:Key="MainColor">{{ik-plate}}</Color>
    <Color x:Key="MainColorDark">{{ik-soot}}</Color>
    <Color x:Key="HoverColor">{{ik-plate-lit}}</Color>
    <Color x:Key="GlyphColor">{{ik-bolt}}</Color>
    <Color x:Key="HighlightGlyphColor">{{ik-cobalt}}</Color>
    <Color x:Key="PopupBackgroundColor">{{ik-soot}}</Color>
    <Color x:Key="PopupBorderColor">{{ik-ash}}</Color>
    <Color x:Key="BackgroundToneColor">{{ik-soot}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{ik-plate}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{ik-plate-lit}}</Color>
    <Color x:Key="DataChangeNotifColor">{{ik-ember}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{ik-ash-lit}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{ik-black}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{ik-plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{ik-soot}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <!-- Running game: battery-charge green, never the white cursor, the lightning blue or the orange filter mark -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{ik-charge}}" />

    <!-- Karma: good is the lit bolt blue, evil the tile red, mixed the HUD ring orange. -->
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{ik-bolt}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{ik-karma-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{ik-ember}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{ik-ember}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{ik-plate}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{ik-asphalt}}" />

    <!-- Surfaces and art -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{ik-black}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{ik-asphalt}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{ik-soot}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{ik-soot}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{ik-black}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{ik-navy}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the ink navy in the
         shadow of the cobalt corner ribbon, the darkest branded surface, so a darker banner keeps the menu's cold cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{ik-navy}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{ik-black}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{ik-slab}}" />

    <!-- Selection and states: the cursor is a near-white slab with black text. -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{ik-slab}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{ik-slab}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{ik-black}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{ik-plate-lit}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{ik-slab}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{ik-plate-lit}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{ik-bolt}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{ik-karma-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{ik-slab}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{ik-chalk}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{ik-slab}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{ik-ash}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{ik-plate-lit}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{ik-plate-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{ik-cobalt}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{ik-cobalt}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{ik-bolt}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{ik-slab}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{ik-black}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{ik-arc}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{ik-slab}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{ik-soot}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{ik-ash-lit}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{ik-smoke}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{ik-ash-lit}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{ik-smoke}}" />

    <!-- Tracks and thumbs: the loading bar is blue progress over a red remainder; the slider a thin line with a white block. -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{ik-ash}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{ik-slab}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{ik-bolt}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{ik-arc}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{ik-karma-red-deep}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{ik-bolt}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{ik-ash}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{ik-ash-lit}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{ik-ash}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{ik-ash-lit}}" />

    <!-- Tabs, covers, shell items -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{ik-smoke}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{ik-chalk}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{ik-band}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{ik-slab}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{ik-bolt}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{ik-plate-lit}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{ik-slab}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{ik-smoke}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{ik-black}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{ik-bolt}}" />

    <!-- Metadata, menus, tooltips, dialogs -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{ik-plate-lit}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{ik-chalk}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{ik-ash}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{ik-plate-lit}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{ik-chalk}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{ik-ash}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{ik-black}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{ik-chalk}}" />

    <!-- Frames and headings -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{ik-ash}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{ik-plate-lit}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{ik-ash-lit}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{ik-plate-lit}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{ik-black}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{ik-chalk}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{ik-bolt}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{ik-plate-lit}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{ik-ash}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{ik-black}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{ik-soot}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{ik-plate}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{ik-bolt}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{ik-plate-lit}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{ik-black}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{ik-band}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{ik-plate}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{ik-ash}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{ik-smoke}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{ik-ember}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{ik-black}}" />

    <!-- Inkbolt's grey section band (POWER LEVEL tabs, the XP header) and the cobalt baroque ribbon (highlight and base). -->
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{ik-band}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{ik-black}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{ik-cobalt}}" />
    <SolidColorBrush x:Key="StripeDeepBrush" Color="{{ik-ribbon}}" />
</ResourceDictionary>
