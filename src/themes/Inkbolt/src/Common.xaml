<!--
    Inkbolt: spacing, focus and the shared motifs. Measurements: ../RESEARCH.md.
      BevelTemplate        a menu row: flat charcoal plate with a hairline edge
      FramedPlateTemplate  a card frame: one ash hairline and a short lightning-blue tab at its head
      ArrowPlateTemplate         the menu cursor: a near-white slab with a right-pointing arrowhead notch
      InkFrameTemplate     the torn black ink frame of the documents screen (9-slice mask, fixed 14px corners)
      ArcStripTemplate    the HUD health line: a zig-zag trace that tiles along its length and fades at both ends
      RibbonTemplate       the cobalt damask ribbon, a band (settings title band)
      RibbonCornerTemplate the same ribbon crossing a corner (banner, empty page)
      GrainTemplate        ink grain, a seamless tile
      SplatterTemplate        ink splatter, a seamless tile
      BrandMarkTemplate         the brand mark: a broken ring around a bolt
    Sprites are white masks filled with theme brushes, so ThemeModifier edits reach them. None of these report a
    desired width of their own (Statistics cards stay compact).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Menu rows: text sits 10px inside a charcoal plate (the source: 12px on a 26px row at 720p); buttons 16px. -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">3</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">3</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,0</Thickness>
    <Thickness x:Key="TooltipPadding">8,4</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">260</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- A menu row. Background = the plate, BorderBrush + BorderThickness = its hairline. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="Control">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Card frame. Foreground = the hairline; BorderBrush = the tab at the head. Overlay it on a panel; it draws no fill. -->
    <ControlTemplate x:Key="FramedPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" />
            <Rectangle Width="28" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{TemplateBinding BorderBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- The menu cursor. Foreground = the slab. The arrowhead takes the last 10px of the host, so a host that wants the
         arrow outside its content keeps 10px of right padding. The head's angle follows the host's height (28 to 44px rows). -->
    <ControlTemplate x:Key="ArrowPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
            </Grid.ColumnDefinitions>
            <Rectangle Fill="{TemplateBinding Foreground}" />
            <Path Grid.Column="1" Data="M0,0 L10,10 L0,20Z" Stretch="Fill" Fill="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- Torn ink frame. Foreground = the ink. 9-slice of Images/fx/frame.png (128px, 28px border) drawn at half size:
         14px corner cells, edges stretch. The host sits at a negative margin so the ink bites into what it frames. -->
    <ControlTemplate x:Key="InkFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" ViewboxUnits="Absolute" Viewbox="0,0,28,28" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" ViewboxUnits="Absolute" Viewbox="28,0,72,28" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" ViewboxUnits="Absolute" Viewbox="100,0,28,28" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" ViewboxUnits="Absolute" Viewbox="0,28,28,72" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" ViewboxUnits="Absolute" Viewbox="100,28,28,72" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" ViewboxUnits="Absolute" Viewbox="0,100,28,28" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" ViewboxUnits="Absolute" Viewbox="28,100,72,28" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/frame.png'}" ViewboxUnits="Absolute" Viewbox="100,100,28,28" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- The lightning trace, 28px tall (the host sets the height): bolt-h.png tiles along its length, joined at 256px. Foreground =
         the bolt. The ends fade out. Give the host a negative vertical margin when it should straddle a rule. -->
    <ControlTemplate x:Key="ArcStripTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" Height="28" ClipToBounds="True">
            <Grid.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#FF000000" Offset="0.22" />
                    <GradientStop Color="#FF000000" Offset="0.78" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.OpacityMask>
            <Rectangle Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/bolt-h.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,28" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Cobalt ribbon bands. Foreground = the ribbon. The host sets the size (the band: 512x44 at 1:1). -->
    <ControlTemplate x:Key="RibbonTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/ribbon.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>
    <ControlTemplate x:Key="RibbonCornerTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/ribbon-corner.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Ink grain and splatter: seamless 256px tiles. Foreground = the ink; the host sets Opacity. -->
    <ControlTemplate x:Key="GrainTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/grain.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>
    <ControlTemplate x:Key="SplatterTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/splat.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- The brand mark: a broken three-segment ring (ring orange, bolt blue, ash) around a bolt filled with Foreground. 32 grid. -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="32" Height="32">
                <Path Data="M16,3.4 A12.6,12.6 0 0 1 27.4,10" Stroke="{DynamicResource DataChangeNotifBrush}" StrokeThickness="3.2" />
                <Path Data="M28.6,17.6 A12.6,12.6 0 0 1 21.6,27.6" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="3.2" />
                <Path Data="M10.4,27.6 A12.6,12.6 0 0 1 3.4,16.4" Stroke="{DynamicResource FrameBrush}" StrokeThickness="3.2" />
                <Path Data="M17.6,7 L9.4,17.6 H14.6 L12.8,25 L22.6,14 H17.4Z" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Keyboard focus: a dashed bolt-blue outline 2px outside the control. -->
    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{DynamicResource FocusBrush}" StrokeThickness="1" StrokeDashArray="3 2" Margin="-2" SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
