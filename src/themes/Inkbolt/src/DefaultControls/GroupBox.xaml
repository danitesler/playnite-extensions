<!--
    Inkbolt: GroupBox as one of the source's panels: a charcoal body inside a single ash hairline, headed by the grey
    section band (POWER LEVEL 1) with black caps in the heading face and a short lightning-blue tab at its corner.
    Content-sized, no fixed widths: the band is a stretching Border with no desired width, so Statistics sections stay
    compact cards. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{DynamicResource ExpanderBackgroundBrush}" Padding="1">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBandBrush}" MinHeight="28" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="14,4,14,4"
                                                      TextElement.FontFamily="{DynamicResource HeadingFontFamily}" TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{DynamicResource HeaderBandForegroundBrush}">
                                        <ContentPresenter.Resources>
                                            <DataTemplate DataType="{x:Type sys:String}">
                                                <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                            </DataTemplate>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                        <Control Template="{DynamicResource FramedPlateTemplate}" Foreground="{DynamicResource FrameBrush}" BorderBrush="{DynamicResource GlyphBrush}" Focusable="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
