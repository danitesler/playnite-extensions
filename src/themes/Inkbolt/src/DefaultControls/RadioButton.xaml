<!--
    Inkbolt: RadioButton. The karma tile's twin: a 20px square on a 2px ash edge; on, a 8px lightning-blue block sits in the
    centre and the edge turns blue. Square, like every plate in the source. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <DockPanel Background="Transparent">
                        <Grid Width="20" Height="20" Margin="0,0,9,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Border x:Name="Socket" Background="{DynamicResource CheckBoxCheckMarkBkBrush}" BorderBrush="{DynamicResource CheckBoxBorderBrush}" BorderThickness="2" />
                            <Rectangle x:Name="Core" Width="8" Height="8" Fill="{DynamicResource GlyphBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Socket" Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Core" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Socket" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
