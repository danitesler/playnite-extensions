<!--
    Inkbolt: ContextMenu. Every popup menu and dropdown list (hamburger menu, top bar dropdowns via TopPanelMenu,
    GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select boxes) wears
    the Infamous 2 soot panel (LocalInkboltMenuTemplate): PopupBackgroundBrush with ink grain (GrainTemplate at 0.06),
    1px ash frame (PopupBorderBrush), a 3px cobalt top strip (PrimaryButtonBackgroundBrush) with a 28px arc-white lead
    highlight, and a 2px lightning-blue foot trace fading right. Rows start 7px down.
    Rows and the 10px lightning-trace group break are in Menu.xaml.
    Structure: Playnite Default 10.60. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalInkboltMenuTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1" />
            <Control Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource TextBrush}"
                     Opacity="0.06" Margin="1" Focusable="False" IsTabStop="False" />
            <!-- 3px cobalt top bar with arc-white lead flash -->
            <Rectangle Height="3" Margin="1,1,1,0" VerticalAlignment="Top" Fill="{DynamicResource PrimaryButtonBackgroundBrush}" />
            <Rectangle Width="28" Height="3" Margin="1,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="{DynamicResource PrimaryButtonGlowBrush}" />
            <!-- 2px lightning-blue foot trace fading right -->
            <Rectangle Height="2" Margin="1,0,1,1" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" Opacity="0.7">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="0.6" Color="#55000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalInkboltMenuTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,7,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="4,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
