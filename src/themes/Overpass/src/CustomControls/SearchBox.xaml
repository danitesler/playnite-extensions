<!--
    Overpass: CustomControls/SearchBox.xaml.
    Sharp 0px monochrome search well matching Overpass's field signature: quiet left GPS tick, faint street etch,
    amber focus baseline sweep, persistent Glyph outside PART_SeachIcon, transparent hit-test Border on PART_ClearTextIcon.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Field" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="{DynamicResource ControlBorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <!-- Subtle right-side street-grid etch -->
                                <Control Width="110" HorizontalAlignment="Right"
                                         Template="{DynamicResource LocalOverpassMapPlateTemplate}"
                                         Foreground="{DynamicResource TextBrushDarker}" Opacity="0.06" IsHitTestVisible="False" />
                                <!-- Left GPS tick -->
                                <Rectangle x:Name="LeftTick" Width="2" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Fill="{DynamicResource InputUnderlineBrush}" IsHitTestVisible="False" />
                                <!-- Focus bottom amber GPS sweep -->
                                <Rectangle x:Name="FocusBar" Height="1.5" VerticalAlignment="Bottom"
                                           Fill="{DynamicResource InputHoverUnderlineBrush}"
                                           RenderTransformOrigin="0,0.5" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="FocusBarScale" ScaleX="0.1" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <!-- Persistent magnifier Glyph outside PART_SeachIcon -->
                                <ContentControl x:Name="Glyph" Focusable="False" Content="{DynamicResource IconSearch}"
                                                ContentTemplate="{DynamicResource IconTemplate}"
                                                Foreground="{DynamicResource GlyphBrush}" Margin="10,0,0,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                IsHitTestVisible="False" Panel.ZIndex="1" />
                                <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                                <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                         Padding="32,0,28,0" VerticalContentAlignment="Center" />
                                <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}"
                                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,4,0" Cursor="Hand"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ContentControl.Template>
                                        <ControlTemplate TargetType="ContentControl">
                                            <Border Background="Transparent" Padding="4">
                                                <ContentPresenter ContentSource="Content" />
                                            </Border>
                                        </ControlTemplate>
                                    </ContentControl.Template>
                                </ContentControl>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                            <Setter TargetName="LeftTick" Property="Fill" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="LeftTick" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="LeftTick" Property="Height" Value="20" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SearchFocusIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusBar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="FocusBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="FocusBarScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SearchFocusOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="FocusBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="FocusBarScale" Storyboard.TargetProperty="ScaleX" To="0.1" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusBar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TextInpuText" Property="Padding" Value="10,0,28,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
