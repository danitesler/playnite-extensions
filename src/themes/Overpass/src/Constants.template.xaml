<!--
    Overpass: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    GTA IV-inspired monochrome Liberty cartographic and Swiss pause-menu palette.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (bundled SIL OFL Schibsted Grotesk static TTFs in src/Typography/) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">30</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Schibsted Grotesk, {{text:op-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Schibsted Grotesk, {{text:op-font-heading|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width & position (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape: razor-sharp 0px Swiss architectural geometry; full radius strictly for 1:1 circular radar marks -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:op-radius-md|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:op-radius-sm|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:op-radius-lg|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:op-radius-full|999}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{op-ink}}</Color>
    <Color x:Key="TextColorDarker">{{op-muted}}</Color>
    <Color x:Key="TextColorDark">{{op-ink-dark}}</Color>
    <Color x:Key="MainColor">{{op-zebra}}</Color>
    <Color x:Key="MainColorDark">{{op-panel}}</Color>
    <Color x:Key="HoverColor">{{op-land}}</Color>
    <Color x:Key="GlyphColor">{{op-amber}}</Color>
    <Color x:Key="HighlightGlyphColor">{{op-amber-bright}}</Color>
    <Color x:Key="PopupBackgroundColor">{{op-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{op-border-hi}}</Color>
    <Color x:Key="BackgroundToneColor">{{op-input}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{op-border}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{op-border}}</Color>
    <Color x:Key="DataChangeNotifColor">{{op-radar-health}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{op-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{op-input}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{op-zebra}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{op-input}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{op-radar-health}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{op-danger-text}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{op-gps-gold}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{op-amber}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{op-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{op-ground}}" />

    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{op-void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{op-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{op-ground}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="#000A0B0C" />
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{op-banner-tint}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{op-rule}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{op-input}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{op-zebra}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{op-void}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{op-ink}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{op-scrim}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{op-void}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{op-land}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{op-surface-hi}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{op-amber}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{op-ink-pure}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{op-zebra}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{op-land}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{op-land}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{op-radar-armor}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{op-amber}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{op-danger}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{op-ink-pure}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{op-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{op-ink-pure}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{op-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{op-surface-hi}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{op-track}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{op-border}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{op-ink-pure}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{op-ink-pure}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{op-amber}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{op-amber-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{op-ink-dark}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{op-zebra}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{op-border}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{op-land}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{op-track}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{op-land}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{op-input}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{op-zebra}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{op-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{op-border-hi}}" />
    <SolidColorBrush x:Key="InputUnderlineBrush" Color="{{op-rule}}" />
    <SolidColorBrush x:Key="InputHoverUnderlineBrush" Color="{{op-amber}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{op-border-hi}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{op-amber}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{op-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{op-ink-pure}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{op-amber}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{op-amber}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{op-muted}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{op-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{op-block}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{op-muted}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{op-void}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{op-block}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{op-muted}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{op-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{op-ink}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{op-amber}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{op-void}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{op-highway}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{op-amber}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{op-zebra}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{op-land}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{op-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{op-ink-pure}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{op-input}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{op-highway}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{op-land}}" />

    <!-- Popups & Typography -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{op-border}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{op-ink}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{op-border-hi}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{op-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{op-ink}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{op-ink-pure}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{op-rule}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{op-muted}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{op-amber}}" />

    <!-- Overpass local cartography & radar brushes (theme-only, non-Color) -->
    <SolidColorBrush x:Key="LocalMapLandBrush" Color="{{op-land}}" />
    <SolidColorBrush x:Key="LocalMapRoadBrush" Color="{{op-muted}}" />
    <SolidColorBrush x:Key="LocalMapHighwayBrush" Color="{{op-highway}}" />
    <SolidColorBrush x:Key="LocalMapRouteBrush" Color="{{op-amber}}" />
    <SolidColorBrush x:Key="LocalAmberDimBrush" Color="{{op-amber-dim}}" />
    <SolidColorBrush x:Key="LocalAmberWashBrush" Color="{{op-amber-wash}}" />
    <SolidColorBrush x:Key="LocalRadarHealthBrush" Color="{{op-radar-health}}" />
    <SolidColorBrush x:Key="LocalRadarArmorBrightBrush" Color="{{op-radar-armor-hi}}" />
    <SolidColorBrush x:Key="LocalDangerTextBrush" Color="{{op-danger-text}}" />
    <SolidColorBrush x:Key="LocalZebraBrush" Color="{{op-zebra}}" />
    <SolidColorBrush x:Key="LocalNavShadeBrush" Color="{{op-nav-shade}}" />
</ResourceDictionary>
