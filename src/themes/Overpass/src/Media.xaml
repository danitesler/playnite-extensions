<!--
    Overpass: Media.xaml.
    Bespoke geometric Swiss monochrome Icon<Role> vector geometries matching Overpass's sharp 0px architectural craft
    plus the 24 custom bare-icon menu PNG keys generated via art/menu-icons.json.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Primary UI Icon DataTemplates (uniformly scaling Viewbox capped to smallest host) -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox Width="12" Height="12" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileSolidTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

