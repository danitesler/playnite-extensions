<!--
    Overpass: Common.xaml.
    GTA IV-inspired monochrome Liberty cartographic spacing, dividers, animated Circular Radar main menu mark,
    procedural cartographic mask templates, empty-game cartographic map state, and screenshot skeleton.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Component spacing (ControlHeight=32; vertical padding 5 so height stays 32 across fonts) -->
    <Thickness x:Key="ButtonPadding">14,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">4,5</Thickness>
    <Thickness x:Key="MenuItemPadding">10,5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,5</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12</Thickness>
    <Thickness x:Key="TooltipPadding">10,7</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- PopupBorder -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Keyboard FocusVisual: crisp 1px amber hairline outside control -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section Heading TextBlock: bold tight-tracked Swiss neo-grotesque -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>

    <!-- DividerTemplate: GTA IV 1px pause hairline opened by a 5x5 amber map crosshair (zero wide desired size) -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="10" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                <Rectangle Width="7" Height="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Fill="{DynamicResource GlyphBrush}" />
                <Rectangle Width="1" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Fill="{DynamicResource GlyphBrush}" />
            </Grid>
            <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center"
                       Fill="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- Shared procedural cartographic OpacityMask ImageBrushes (pure-white RGBA masks in Images/fx/) -->
    <ImageBrush x:Key="LocalMapLandMask" ImageSource="{ThemeFile 'Images/fx/map-land.png'}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
    <ImageBrush x:Key="LocalMapRoadsMask" ImageSource="{ThemeFile 'Images/fx/map-roads.png'}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
    <ImageBrush x:Key="LocalMapRouteMask" ImageSource="{ThemeFile 'Images/fx/map-route.png'}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
    <ImageBrush x:Key="LocalMapRailMask" ImageSource="{ThemeFile 'Images/fx/map-rail.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalMapBandMask" ImageSource="{ThemeFile 'Images/fx/map-band.png'}" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center" />
    <ImageBrush x:Key="LocalMapPlateMask" ImageSource="{ThemeFile 'Images/fx/map-plate.png'}" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center" />
    <ImageBrush x:Key="LocalMapEdgeMask" ImageSource="{ThemeFile 'Images/fx/map-edge.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalAsphaltGrainMask" ImageSource="{ThemeFile 'Images/fx/asphalt-grain.png'}" TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute" />

    <!-- Pure black-and-white translucent Liberty cartography backdrop (no orange routes; continuous & aligned across Library & Settings) -->
    <ControlTemplate x:Key="LocalOverpassMapBackdropTemplate" TargetType="Control">
        <Grid ClipToBounds="True" IsHitTestVisible="False">
            <Rectangle Fill="{DynamicResource LocalMapLandBrush}" Opacity="0.34"
                       OpacityMask="{DynamicResource LocalMapLandMask}" />
            <Rectangle Fill="{DynamicResource LocalMapRoadBrush}" Opacity="0.095"
                       OpacityMask="{DynamicResource LocalMapRoadsMask}" />
            <Rectangle Fill="{DynamicResource TextBrush}" Opacity="0.015"
                       OpacityMask="{DynamicResource LocalAsphaltGrainMask}" />
        </Grid>
    </ControlTemplate>

    <!-- Quieter pure monochrome map watermark for secondary overlays -->
    <ControlTemplate x:Key="LocalOverpassMapSubtleTemplate" TargetType="Control">
        <Grid ClipToBounds="True" IsHitTestVisible="False">
            <Rectangle Fill="{DynamicResource LocalMapLandBrush}" Opacity="0.26"
                       OpacityMask="{DynamicResource LocalMapLandMask}" />
            <Rectangle Fill="{DynamicResource LocalMapRoadBrush}" Opacity="0.08"
                       OpacityMask="{DynamicResource LocalMapRoadsMask}" />
        </Grid>
    </ControlTemplate>

    <!-- Vertical coastal & bridge sliver for 44px Sidebar rail foot -->
    <ControlTemplate x:Key="LocalOverpassMapRailTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalMapRailMask}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Horizontal expressway interchange strip fading left-to-right for TopPanel & StandardWindowStyle -->
    <ControlTemplate x:Key="LocalOverpassMapBandTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalMapBandMask}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Fine street-grid plate etching for PlayButton, primary buttons, and active inputs -->
    <ControlTemplate x:Key="LocalOverpassMapPlateTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalMapPlateMask}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Elevated-highway border strip (fixed height, zero wide intrinsic width) -->
    <ControlTemplate x:Key="LocalOverpassMapEdgeTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalMapEdgeMask}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Original Overpass Emblem (art/mark.svg geometry: circular radar bezel + elevated overpass + GPS chevron) -->
    <ControlTemplate x:Key="LocalOverpassEmblemTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="256" Height="256">
                <Path Data="M 104,28 A 102,102 0 1 0 152,28" Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="14" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" />
                <Rectangle Canvas.Left="118" Canvas.Top="16" Width="20" Height="22" Fill="{DynamicResource GlyphBrush}" />
                <Path Data="M 74,72 L 108,106 M 148,150 L 182,184" Stroke="{DynamicResource TextBrushDarker}"
                      StrokeThickness="11" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" />
                <Path Data="M 46,154 C 82,148 104,128 128,128 C 152,128 174,108 210,102"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="18" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" />
                <Polygon Points="128,112 144,142 128,134 112,142" Fill="{DynamicResource GlyphBrush}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!--
        Main menu mark (docs/themes/menu-mark.md): LocalOverpassMenuMarkTemplate.
        Custom animated GTA IV Circular Liberty Radar used in both Sidebar.xaml and TopPanel.xaml.
        - Rest: 28x28 circular radar dial with split Health sage-green (left) / Armor steel-cyan (right) outer arc,
          monochrome city cross-streets, amber center GPS player chevron, and circular North 'N' crown badge.
        - Hover: GPS chevron nudges forward and scales cleanly while inner city streets brighten (separate elements).
        - Open (ContextMenu.IsOpen on ancestor Border): dedicated amber sonar ring pulses outward + amber lock bezel
          breathes smoothly until closed; exit storyboard resets every animated property.
    -->
    <ControlTemplate x:Key="LocalOverpassMenuMarkTemplate" TargetType="Control">
        <Grid Background="Transparent" Width="28" Height="28" SnapsToDevicePixels="True">
            <Viewbox Width="28" Height="28" Stretch="Uniform">
                <Canvas Width="28" Height="28">
                    <!-- Outer black bezel -->
                    <Ellipse Canvas.Left="2.5" Canvas.Top="3" Width="23" Height="23"
                             Fill="{DynamicResource ShellBackgroundBrush}" />
                    <!-- Split Health (left sage) & Armor (right steel-cyan) circular radar ring -->
                    <Path Data="M 14,25 A 10.5,10.5 0 0 1 14,4"
                          Stroke="{DynamicResource LocalRadarHealthBrush}" StrokeThickness="1.8" />
                    <Path Data="M 14,4 A 10.5,10.5 0 0 1 14,25"
                          Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="1.8" />
                    <!-- Inner monochrome map disc -->
                    <Ellipse Canvas.Left="5.4" Canvas.Top="5.9" Width="17.2" Height="17.2"
                             Fill="{DynamicResource LocalZebraBrush}" />
                    <!-- Rest cross-streets -->
                    <Path Data="M 6.5,14.5 L 21.5,14.5 M 14,6.5 L 14,22.5 M 8.5,10.5 L 19.5,18.5"
                          Stroke="{DynamicResource HeadingRuleBrush}" StrokeThickness="1" Opacity="0.72" />
                    <!-- Hover-lit cross-streets overlay (hover only) -->
                    <Path x:Name="HoverStreets" Data="M 6.5,14.5 L 21.5,14.5 M 14,6.5 L 14,22.5 M 8.5,10.5 L 19.5,18.5"
                          Stroke="{DynamicResource TextBrush}" StrokeThickness="1.15" Opacity="0" />

                    <!-- Open-state dedicated sonar pulse ring (separate element from hover) -->
                    <Ellipse x:Name="OpenSonarRing" Canvas.Left="4" Canvas.Top="4.5" Width="20" Height="20"
                             Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.3" Opacity="0"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="OpenSonarScale" ScaleX="0.5" ScaleY="0.5" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <!-- Open-state amber lock bezel -->
                    <Ellipse x:Name="OpenLockBezel" Canvas.Left="3.5" Canvas.Top="4" Width="21" Height="21"
                             Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.8" Opacity="0" />

                    <!-- Center amber GPS player chevron (hover moves & scales cleanly) -->
                    <Polygon x:Name="GpsChevron" Points="14,10.2 17.4,17.8 14,16 10.6,17.8"
                             Fill="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
                        <Polygon.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ChevronScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="ChevronSlide" X="0" Y="0" />
                            </TransformGroup>
                        </Polygon.RenderTransform>
                    </Polygon>

                    <!-- Top circular North crown badge -->
                    <Ellipse Canvas.Left="10.6" Canvas.Top="0.4" Width="6.8" Height="6.8"
                             Fill="{DynamicResource ShellBackgroundBrush}"
                             Stroke="{DynamicResource LocalMapHighwayBrush}" StrokeThickness="0.85" />
                    <Path Data="M 12.7,5.4 L 12.7,2.4 L 15.3,5.4 L 15.3,2.4"
                          Stroke="{DynamicResource SelectedForegroundBrush}" StrokeThickness="0.95"
                          StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Miter" />
                </Canvas>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <!-- Hover: GPS arrow locks upward and cross-streets brighten -->
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="RadarHoverIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverStreets" Storyboard.TargetProperty="Opacity"
                                             To="0.95" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ChevronSlide" Storyboard.TargetProperty="Y"
                                             To="-1.4" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ChevronScale" Storyboard.TargetProperty="ScaleX"
                                             To="1.12" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ChevronScale" Storyboard.TargetProperty="ScaleY"
                                             To="1.12" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="RadarHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverStreets" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="ChevronSlide" Storyboard.TargetProperty="Y"
                                             To="0" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="ChevronScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="ChevronScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.22" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Menu Open: dedicated amber sonar ping + glowing lock ring -->
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="RadarOpenIn">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OpenLockBezel" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OpenSonarScale" Storyboard.TargetProperty="ScaleX">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.18" KeySpline="0.2,0 0.2,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="1.18" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OpenSonarScale" Storyboard.TargetProperty="ScaleY">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.18" KeySpline="0.2,0 0.2,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="1.18" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OpenSonarRing" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.88" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0" KeySpline="0.2,0 0.4,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard x:Name="RadarOpenOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="OpenLockBezel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="OpenSonarRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="OpenSonarScale" Storyboard.TargetProperty="ScaleX" To="0.5" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="OpenSonarScale" Storyboard.TargetProperty="ScaleY" To="0.5" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SteamScreenshots pulsing monochrome 16:9 + 5 thumbnail skeleton -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <Grid x:Name="SkelRoot" Opacity="0.45" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="170" />
                <RowDefinition Height="8" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
            <UniformGrid Grid.Row="2" Columns="5">
                <Border Margin="0,0,6,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Margin="0,0,6,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Margin="0,0,6,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Margin="0,0,6,0" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                <Border Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
            </UniformGrid>
        </Grid>
    </ControlTemplate>

    <!-- Empty game page: monochrome Liberty cartographic map table + Overpass radar emblem + subtle crosshair breath -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid Background="Transparent">
            <!-- Cartographic map centered softly behind empty state (collapsed when window art is on) -->
            <Control x:Name="EmptyMapBg" Template="{DynamicResource LocalOverpassMapBackdropTemplate}" Opacity="0.85" IsHitTestVisible="False">
                <Control.Style>
                    <Style TargetType="Control">
                        <Style.Triggers>
                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Control.Style>
            </Control>

            <!-- Hair-thin GTA IV map crosshair centered on the empty table -->
            <Grid IsHitTestVisible="False" Opacity="0.45">
                <Rectangle Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="64,0"
                           Fill="{DynamicResource LocalAmberDimBrush}" />
                <Rectangle Width="1" VerticalAlignment="Stretch" HorizontalAlignment="Center" Margin="0,64"
                           Fill="{DynamicResource LocalAmberDimBrush}" />
            </Grid>

            <!-- Center emblem + localized LOCErrorNoGameSelected caption -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="64" Height="64" Background="{DynamicResource ShellBackgroundBrush}"
                        BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Grid>
                        <Control Width="42" Height="42" Template="{DynamicResource LocalOverpassEmblemTemplate}"
                                 Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Rectangle Height="2" VerticalAlignment="Bottom" Margin="14,0"
                                   Fill="{DynamicResource GlyphBrush}" />
                    </Grid>
                </Border>
                <Rectangle Width="120" Height="1" Margin="0,16,0,12" Fill="{DynamicResource HeadingRuleBrush}" Opacity="0.7" />
                <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                           FontFamily="{DynamicResource HeadingFontFamily}"
                           FontSize="{DynamicResource FontSizeLarge}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrushDarker}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
