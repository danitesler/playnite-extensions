<!--
    Overpass: DerivedStyles/StandardWindowStyle.xaml.
    44px pitch-black GTA IV title band (CaptionHeight == 44 == content top margin) with Overpass emblem,
    fading monochrome expressway strip (LocalOverpassMapBandTemplate), 1px pause hairline + amber lead rule,
    WindowSettings title trigger (LOCSettingsLabel), subtle body corner map watermark, and standalone WindowDesignStyle.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder"
                                BorderBrush="{DynamicResource PopupBorderBrush}"
                                CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid ClipToBounds="True">
                                <!-- Continuous pure black-and-white Liberty map stretching across left section tree and right content (aligned with Library) -->
                                <Control Margin="0,44,0,0"
                                         Template="{DynamicResource LocalOverpassMapBackdropTemplate}"
                                         IsHitTestVisible="False" />

                                <!-- Main dialog content offset exactly by CaptionHeight=44 -->
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px Title Band -->
                                <Border Height="44" VerticalAlignment="Top"
                                        Background="{DynamicResource WindowTitleBackgroundBrush}"
                                        BorderBrush="{DynamicResource TopPanelSeparatorBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ClipToBounds="True">
                                        <!-- Wide map band inside Canvas so small dialogs stay content-sized -->
                                        <Canvas IsHitTestVisible="False">
                                            <Control Width="560" Height="44" Canvas.Left="120" Canvas.Top="0"
                                                     Template="{DynamicResource LocalOverpassMapBandTemplate}"
                                                     Foreground="{DynamicResource LocalMapRoadBrush}" Opacity="0.12" />
                                        </Canvas>
                                        <!-- 2px amber lead bar along bottom left -->
                                        <Rectangle Width="148" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                   Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />

                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                                <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                                <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
                                                <Control Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"
                                                         Template="{DynamicResource LocalOverpassEmblemTemplate}"
                                                         Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                         Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                                <TextBlock x:Name="PART_TextTitle"
                                                           Text="{TemplateBinding Title}"
                                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource HeadingForegroundBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standalone WindowDesignStyle (NEVER BasedOn StandardWindowStyle: TargetType Window vs WindowBase crashes WPF!) -->
    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
