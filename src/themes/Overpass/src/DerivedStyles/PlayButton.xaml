<!--
    Overpass: DerivedStyles/PlayButton.xaml.
    Hero Focal Piece (0px Swiss monochrome-to-amber map-etched architectural slab):
      - Rest: crisp Swiss off-white (#F7F8FA) plate with jet-black ink, faint map-plate.png street-grid etch,
        4px amber GPS left rail, and directional Play arrow (hidden on Tag="ContextAction").
      - Hover: GTA IV Amber-Orange (#E89D10) GPS sweep wipes left-to-right (180ms CubicEase), border lights amber,
        and delicate left/right amber crosshair ticks extend cleanly outside the slab.
      - Launching / Running: solid Radar Armor Steel-Cyan (#2B7FA6) darkened via RunningBreath ScrimBrush so
        crisp white label stays >= 6:1 contrast; angled GPS scan; RunningHoverDim + CancelLabel on Self IsMouseOver only;
        PlayRoom reserves 34px right strip so RunningActionIndicator's GPS target blip never touches text.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="Padding" Value="18,0,22,0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Subtle extending left/right amber crosshair ticks on hover -->
                        <Grid x:Name="HoverTicks" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Rectangle Width="8" Height="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="-11,0,0,0" Fill="{DynamicResource GlyphBrush}" />
                            <Rectangle Width="8" Height="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,-11,0" Fill="{DynamicResource GlyphBrush}" />
                        </Grid>

                        <Grid ClipToBounds="True">
                            <!-- Base solid plate -->
                            <Border x:Name="PlayFill"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />

                            <!-- RunningBreath scrim darkening solid RunningIndicatorBrush plate for >=6:1 white label contrast -->
                            <Border x:Name="RunningBreath" Visibility="Collapsed" Opacity="0"
                                    Background="{DynamicResource ScrimBrush}" IsHitTestVisible="False" />

                            <!-- RunningScan angled GPS sweep while launching -->
                            <Border x:Name="RunningScan" Visibility="Collapsed"
                                    Background="{DynamicResource LocalRadarArmorBrightBrush}" Opacity="0.34" IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.22">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>

                            <!-- Hover amber GPS sweep plate (collapsed during launching/running) -->
                            <Border x:Name="HoverPlate" Visibility="Collapsed" Opacity="0"
                                    Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                    BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="1"
                                    RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="HoverPlateScale" ScaleX="0.08" />
                                </Border.RenderTransform>
                            </Border>

                            <!-- Pressed layer -->
                            <Border x:Name="PressedPlate" Visibility="Collapsed" Opacity="0"
                                    Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                    BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1" IsHitTestVisible="False" />

                            <!-- RunningHoverDim scrim under Cancel label when hovering RUNNING button -->
                            <Border x:Name="RunningHoverDim" Opacity="0"
                                    Background="{DynamicResource ScrimBrush}" IsHitTestVisible="False" />

                            <!-- Fine monochrome street-grid etching inside plate face -->
                            <Control x:Name="PlateMapEtch" Template="{DynamicResource LocalOverpassMapPlateTemplate}"
                                     Foreground="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.09" IsHitTestVisible="False" />

                            <!-- Left 4px GPS lead rail (amber at rest, crisp white on amber hover) -->
                            <Rectangle x:Name="LeftRail" Width="4" HorizontalAlignment="Left"
                                       Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />

                            <!-- Label + Play glyph inside PlayRoom (reserves right room while launching/running) -->
                            <Border x:Name="PlayRoom" Padding="0">
                                <StackPanel x:Name="PlayContent" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}">
                                    <ContentControl x:Name="PlayGlyph" Width="13" Height="13" Margin="0,0,9,0"
                                                    Content="{DynamicResource IconPlay}"
                                                    ContentTemplate="{DynamicResource IconTemplate}"
                                                    Foreground="{TemplateBinding Foreground}"
                                                    VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                                </StackPanel>
                            </Border>

                            <!-- Cancel label revealed ONLY while IsRunning=True AND pointer is over Self -->
                            <TextBlock x:Name="CancelLabel" Visibility="Collapsed" Opacity="0"
                                       Text="{DynamicResource LOCCancelLabel}"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       FontSize="{DynamicResource FontSizeLarge}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SelectedForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Hover amber GPS sweep ONLY when idle (never over Launching/Running state!) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching, FallbackValue=False}" Value="False" />
                                <Condition Binding="{Binding IsRunning, FallbackValue=False}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="LeftRail" Property="Fill" Value="{DynamicResource SelectedForegroundBrush}" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverTicks" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPlateScale" Storyboard.TargetProperty="ScaleX" From="0.08" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverTicks" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="HoverTicks" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverTicks" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching, FallbackValue=False}" Value="False" />
                                <Condition Binding="{Binding IsRunning, FallbackValue=False}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressedPlate" Property="Opacity" Value="1" />
                        </MultiDataTrigger>

                        <!-- RunningMarkRoom left="0" right="34" -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverTicks" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LeftRail" Property="Fill" Value="{DynamicResource LocalRadarArmorBrightBrush}" />
                            <Setter TargetName="PlateMapEtch" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="PlateMapEtch" Property="Opacity" Value="0.08" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,34,0" />
                            <DataTrigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="PlayHoverIn" />
                                <RemoveStoryboard BeginStoryboardName="PlayHoverOut" />
                                <BeginStoryboard Name="PlayLaunchingMotion">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.16" To="0.26" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayLaunchingMotion" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverTicks" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LeftRail" Property="Fill" Value="{DynamicResource LocalRadarArmorBrightBrush}" />
                            <Setter TargetName="PlateMapEtch" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="PlateMapEtch" Property="Opacity" Value="0.08" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,34,0" />
                            <DataTrigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="PlayHoverIn" />
                                <RemoveStoryboard BeginStoryboardName="PlayHoverOut" />
                                <BeginStoryboard Name="PlayRunningBreath">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.14" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.30" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.14" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayRunningBreath" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Cancel shown ONLY when IsRunning AND mouse is over Self (never TemplatedParent!) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="CancelFadeIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0.65" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="CancelFadeOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalRadarArmorBrightBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="MinWidth" Value="156" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LocalRadarArmorBrightBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="MinWidth" Value="156" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Overlay drawn on top of the Play / ContextAction cell in both DetailsViewGameOverview and GridViewGameOverview -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="1" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5" />

                        <!-- Segmented highway-dash foot line -->
                        <Grid Height="2" Margin="6,0,6,4" VerticalAlignment="Bottom">
                            <Grid.OpacityMask>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,8,2" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#FF000000">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,6,2" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.OpacityMask>
                            <Rectangle Fill="{DynamicResource SelectedForegroundBrush}" Opacity="0.28" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource SelectedForegroundBrush}"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <!-- Right-end GPS Target Blip inside reserved 34px PlayRoom strip -->
                        <Grid Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Rectangle x:Name="ActBlipPing" Width="14" Height="14"
                                       Stroke="{DynamicResource SelectedForegroundBrush}" StrokeThickness="1" Opacity="0.4"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="ActBlipPingS" ScaleX="0.85" ScaleY="0.85" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Border Width="10" Height="10" Background="{DynamicResource ShellBackgroundBrush}"
                                    BorderBrush="{DynamicResource SelectedForegroundBrush}" BorderThickness="1.5">
                                <Rectangle x:Name="ActBlipCore" Width="4" Height="4"
                                           Fill="{DynamicResource LocalRadarArmorBrightBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.58" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActBlipPingS" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.85" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1.35" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActBlipPingS" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.85" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1.35" KeySpline="0.2,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.85" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActBlipPing" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.9" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.35" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActBlipCore" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
