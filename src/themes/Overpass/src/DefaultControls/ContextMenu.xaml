<!--
    Overpass: DefaultControls/ContextMenu.xaml.
    Menus contract (docs/themes/menus.md): LocalOverpassMenuBoardTemplate shared by ContextMenu, submenus, ComboBox popups.
    Panel signature: sharp 0px #111214 monochrome board, 1px #55585D rim, 4px map-band.png expressway crown closed by
    1px pause hairline with centered 18px amber crosshair dash, plus quiet 7% map-roads.png corner watermark.
    UseLayoutRounding=True for sharp 16px PNG menu icons at 125%/175% scaling.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared menu board chrome hosted by ContextMenu, Menu submenus, and ComboBox popups -->
    <ControlTemplate x:Key="LocalOverpassMenuBoardTemplate" TargetType="{x:Type Control}">
        <Border Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="{DynamicResource PopupBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid ClipToBounds="True">
                <!-- Quiet bottom-right monochrome Liberty map watermark -->
                <Rectangle Width="220" Height="160" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Fill="{DynamicResource LocalMapRoadBrush}" Opacity="0.06"
                           OpacityMask="{DynamicResource LocalMapRoadsMask}" />
                <!-- Top 5px monochrome cartographic map crown + pause hairline + centered 18px amber crosshair dash -->
                <Grid Height="6" VerticalAlignment="Top">
                    <Rectangle Fill="{DynamicResource LocalZebraBrush}" />
                    <Rectangle Fill="{DynamicResource LocalMapRoadBrush}" Opacity="0.18"
                               OpacityMask="{DynamicResource LocalMapBandMask}" />
                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource TopPanelSeparatorBrush}" />
                    <Rectangle Width="18" Height="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Fill="{DynamicResource GlyphBrush}" />
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalOverpassMenuBoardTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ScrollViewer Margin="4,10,4,5" Style="{DynamicResource LocalMenuScrollViewer}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
