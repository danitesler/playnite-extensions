<!--
    Overpass: DefaultControls/Menu.xaml.
    Menus contract (docs/themes/menus.md) — Overpass GTA IV Pause/Map Menu levers:
      - Panel: LocalOverpassMenuBoardTemplate (0px monochrome board, map-band crown, amber crosshair dash, corner map)
      - Highlight (30px rows): zebra-charcoal landmass plate with 1px hairlines + 3px amber GPS left bar wipes left-to-right
        (ScaleX 0.90->1, 120ms CubicEase), label nudges +2px right in pure white, Icon foreground flips bright
      - Group break: 10px amber + map crosshair opening a 1px hairline rule
      - Shortcuts: right-aligned Consolas led by '/' slash separator (echoing WED / 12:57 / $5), lighting amber on highlight
      - Submenu mark: crisp GPS chevron (IconSubmenu), steady held plate on IsSubmenuOpen
      - Marked rows: Exit (Alt+Q) in [B] Crimson (LocalDangerTextBrush at rest, solid DangerBrush slab + white ink on highlight);
        checked rows show a crisp 14x14 square waypoint mark with amber IconCheck.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Grid Height="10" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Rectangle Width="5" Height="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Fill="{DynamicResource GlyphBrush}" />
                            <Rectangle Width="1" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Fill="{DynamicResource GlyphBrush}" />
                        </Grid>
                        <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center"
                                   Fill="{DynamicResource MenuSeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}" />

    <!-- SubmenuItemTemplateKey: compact 30px Overpass row -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated monochrome landmass highlight wiping left-to-right with 3px amber GPS left bar -->
            <Grid x:Name="HighlightPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" />
                </Grid.RenderTransform>
                <Border Background="{DynamicResource MenuItemHoverBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,1,0,1" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}" />
            </Grid>

            <!-- Exit danger highlight slab -->
            <Grid x:Name="DangerPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border Background="{DynamicResource DangerBrush}" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource DangerForegroundBrush}" />
            </Grid>

            <Grid Margin="6,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcutCol" />
                </Grid.ColumnDefinitions>

                <!-- Fixed 26px icon column (16x16 icon or 14x14 waypoint check square) -->
                <Grid Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ContentPresenter x:Name="Icon" Width="16" Height="16" ContentSource="Icon"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource TextBrush}" />
                    <Border x:Name="CheckSquare" Visibility="Collapsed" Width="14" Height="14"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1">
                        <ContentControl Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{DynamicResource GlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Plain '*' label column so shortcuts align flush right -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" Margin="0,0,12,0">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelNudge" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Right-aligned slash-prefixed Consolas shortcut -->
                <StackPanel x:Name="ShortcutWrap" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ShortcutSlash" Text="/" FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11"
                               Foreground="{DynamicResource LocalAmberDimBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11.5"
                               Foreground="{DynamicResource TextBrushDarker}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckSquare" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutWrap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutWrap" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!-- Normal highlight -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="ShortcutSlash" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuRowHiIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelNudge" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuRowHiOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="LabelNudge" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Exit (Alt+Q) marked danger treatment -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource LocalDangerTextBrush}" />
                <Setter TargetName="ShortcutSlash" Property="Foreground" Value="{DynamicResource LocalDangerTextBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource LocalDangerTextBrush}" />
                <Setter TargetName="ShortcutWrap" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                    <Condition Property="IsHighlighted" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutSlash" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="HighlightPlate" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DangerPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="DangerPlate" Property="Opacity" Value="1" />
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeaderTemplateKey: 30px parent row with GPS chevron & held plate while submenu open -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held steady plate while submenu is open -->
            <Grid x:Name="SubmenuHeldPlate" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Background="{DynamicResource LocalZebraBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,1,0,1" />
                <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource TextBrush}" />
            </Grid>

            <!-- Animated highlight -->
            <Grid x:Name="HighlightPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" />
                </Grid.RenderTransform>
                <Border Background="{DynamicResource MenuItemHoverBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,1,0,1" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}" />
            </Grid>

            <Grid Margin="6,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ContentPresenter x:Name="Icon" Width="16" Height="16" ContentSource="Icon"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{DynamicResource TextBrush}" />
                </Grid>

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" Margin="0,0,12,0">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelNudge" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <ContentControl x:Name="SubArrow" Grid.Column="2" Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource TextBrushDarker}"
                                VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="1" VerticalOffset="-10"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade">
                <Grid MinWidth="200" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalOverpassMenuBoardTemplate}"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    <ScrollViewer Margin="4,10,4,5" Style="{DynamicResource LocalMenuScrollViewer}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="SubmenuHeldPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubHiIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelNudge" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubHiOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="LabelNudge" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
