<!--
    Overpass: DefaultControls/ToggleButton.xaml.
    Sharp 0px monochrome toggle plate; checked state locks landmass charcoal with 2px amber bottom rule.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Control Template="{DynamicResource LocalOverpassMapPlateTemplate}"
                                 Foreground="{DynamicResource TextBrush}" Opacity="0.06" IsHitTestVisible="False" />
                        <Rectangle x:Name="CheckedRule" Height="2" VerticalAlignment="Bottom" Visibility="Collapsed"
                                   Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ToggleButtonCheckedBackgroundBrush}" />
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                            <Setter TargetName="CheckedRule" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="{x:Static sys:Double.NaN}">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
