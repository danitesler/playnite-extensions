<!--
    Overpass: DefaultControls/TextBox.xaml.
    Fields contract (docs/themes/fields.md): LocalOverpassFieldTemplate shared across TextBox, PasswordBox, and closed ComboBox.
    Signature levers:
      - Edge: sharp 0px monochrome well + ultra-faint street-map etching on right (map-plate.png)
      - Rest mark: quiet 2x12 left grey GPS tick + subtle hairline base
      - Hover: left GPS tick brightens and lifts to white-grey while bottom hairline lifts
      - Focus/Active (Tag="Active"): one-shot 160ms CubicEase amber bottom GPS sweep + amber left bar + subtle crosshair notch
      - Zero desired size (no Stretch="Fill" Path/Line). ControlHeight=32; Padding applied once on PART_ContentHost.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Overpass field overlay: reads hover from nearest Control, focus/open from own Tag="Active" -->
    <ControlTemplate x:Key="LocalOverpassFieldTemplate" TargetType="{x:Type Control}">
        <Grid ClipToBounds="True" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Subtle cartographic street-grid etch tucked cleanly on right margin (no desired size) -->
            <Rectangle Width="96" HorizontalAlignment="Right" Fill="{DynamicResource TextBrushDarker}" Opacity="0.06"
                       OpacityMask="{DynamicResource LocalMapPlateMask}" />
            <!-- Rest left GPS tick -->
            <Rectangle x:Name="RestTick" Width="2" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource InputUnderlineBrush}" />
            <!-- Hover highlight layer (lifts tick & hairline) -->
            <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0">
                <Rectangle Width="2" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Fill="{DynamicResource TextBrush}" />
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource InputHoverBorderBrush}" Opacity="0.7" />
            </Grid>
            <!-- Focus/Active layer (one-shot amber bottom GPS route sweep + amber left rail + left crosshair notch) -->
            <Grid x:Name="ActiveLayer" Visibility="Collapsed" Opacity="0">
                <Rectangle Width="2" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Fill="{DynamicResource GlyphBrush}" />
                <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}"
                           RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="ActiveSweepScale" ScaleX="0.08" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="6" Height="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,4"
                           Fill="{DynamicResource GlyphBrush}" Opacity="0.75" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="FieldHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard x:Name="FieldHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="RestTick" Property="Opacity" Value="0" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="FieldActiveIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActiveLayer" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="ActiveLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="ActiveSweepScale" Storyboard.TargetProperty="ScaleX" From="0.08" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="FieldActiveOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="ActiveLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ActiveSweepScale" Storyboard.TargetProperty="ScaleX" To="0.08" Duration="0:0:0.15" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActiveLayer" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                        <Control x:Name="FieldOverlay" Template="{DynamicResource LocalOverpassFieldTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                            <Setter TargetName="FieldOverlay" Property="Tag" Value="Active" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Border" Property="Opacity" Value="0.82" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BareTextBox: chromeless inner text box for SearchBox and editable ComboBox -->
    <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
