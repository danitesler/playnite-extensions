<!--
    Overpass: DefaultControls/TabControl.xaml.
    GTA IV Pause Menu top tab strip (Map Brief Stats Controls Audio Display Graphics Game):
      - Bold tightly tracked Schibsted Grotesk headers in muted grey at rest, turning crisp Amber-Orange (#E89D10)
        with a 2px bottom bar when selected, closed by GTA IV's 1px pause hairline.
      - TabItem keeps Foreground=TextBrush so child edit-dialog labels inherit readable white ink; header colors
        target HeaderText via TargetName only (TabItemColors rule).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource TabControlHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource TopPanelSeparatorBrush}" BorderThickness="0,0,0,1"
                                Padding="8,0">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Panel.ZIndex="1"
                                      KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabNavigation="Local"
                                KeyboardNavigation.TabIndex="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="TabRoot" Background="Transparent" Margin="0,0,6,0" SnapsToDevicePixels="True">
                        <Border x:Name="HoverWash" Background="{DynamicResource ListItemHoverBrush}"
                                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Rectangle x:Name="ActiveBar" Height="2" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource TabItemIndicatorBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                        <TextBlock x:Name="HeaderText" Margin="10,9,10,9"
                                   FontFamily="{DynamicResource HeadingFontFamily}"
                                   FontSize="{DynamicResource FontSizeLarge}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TabItemForegroundBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                            <Setter TargetName="HoverWash" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverWash" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="10" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemIndicatorBrush}" />
                            <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverWash" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
