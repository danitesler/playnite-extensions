                                                                            <TextBlock Text="{DynamicResource LOCCriticScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                                            <Border Grid.Column="1" Margin="10,0,0,0">
                                                                                <TextBlock x:Name="PART_TextCriticScore" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource TextBlockGameScore}" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
<Border x:Name="PART_ElemUserScore" Padding="8,4" Background="{DynamicResource LocalZebraBrush}" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,1,0,1" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,1,24,1" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
