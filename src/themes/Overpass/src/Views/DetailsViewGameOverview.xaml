<Border x:Name="PART_ElemCriticScore" Padding="8,4" Background="Transparent" VerticalAlignment="Top"><Border.Width><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Border.Width><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,1,0,1" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,1,24,1" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
