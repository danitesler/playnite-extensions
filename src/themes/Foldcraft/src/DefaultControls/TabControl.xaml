<!--
    Foldcraft: DefaultControls/TabControl.xaml. Stepped construction-paper index tabs:
    inactive tabs sit in folded kraft; selected tab snaps up into Crisp Paper White (#FAF8F3)
    with a bright Mint construction strip along the top edge. TabItem keeps Foreground=TextBrush
    while HeaderText manages readable tab states.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,0,1.5" Padding="2,0,0,0">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Panel.ZIndex="1"
                                      KeyboardNavigation.TabIndex="1" Background="Transparent" />
                        </Border>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="0,10,0,0">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                              KeyboardNavigation.DirectionalNavigation="Contained"
                                              KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource TabControlHeaderBackgroundBrush}" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Margin" Value="0,0,4,-1.5" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="TabPlate" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5,1.5,1.5,0"
                            CornerRadius="3,3,0,0" Margin="0,2,0,0">
                        <Grid>
                            <Rectangle x:Name="TopStrip" Height="3" VerticalAlignment="Top"
                                       Fill="{DynamicResource PanelSeparatorBrush}" Opacity="0.5" IsHitTestVisible="False" />
                            <TextBlock x:Name="HeaderText" Margin="{TemplateBinding Padding}"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       FontSize="{DynamicResource FontSize}"
                                       Foreground="{DynamicResource TabItemForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabPlate" Property="Background" Value="{DynamicResource TabItemHoverIndicatorBrush}" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="2" />
                            <Setter TargetName="TabPlate" Property="Margin" Value="0,0,0,0" />
                            <Setter TargetName="TabPlate" Property="Background" Value="{DynamicResource TabItemIndicatorBrush}" />
                            <Setter TargetName="TopStrip" Property="Fill" Value="{DynamicResource LocalMintBrightBrush}" />
                            <Setter TargetName="TopStrip" Property="Opacity" Value="1" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="HeaderText" Property="Margin" Value="14,6,14,7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
