<!--
    Foldcraft: DefaultControls/GroupBox.xaml. Accordion Ivory Cardstock container with 2px offset
    studio paper shadow lip, matte paper fibers texture, and Oswald heading with fold divider.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border Margin="2,2,0,0" Background="{DynamicResource PanelShadowBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                        <Border Margin="0,0,2,2" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True">
                            <Grid>
                                <Control Template="{DynamicResource LocalPaperFibersTemplate}"
                                         Foreground="{DynamicResource PanelShadowBrush}" Opacity="0.12"
                                         Focusable="False" IsHitTestVisible="False" />
                                <Control Template="{DynamicResource LocalAccordionCreasesTemplate}"
                                         Foreground="{DynamicResource TextBrushDarker}" Opacity="0.13"
                                         Focusable="False" IsHitTestVisible="False" />
                                <DockPanel Margin="{TemplateBinding Padding}">
                                    <Border DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}"
                                            BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1.5" Padding="0,0,0,5">
                                        <DockPanel>
                                            <Path DockPanel.Dock="Left" Width="6" Height="6" Stretch="Fill" Margin="0,0,7,0"
                                                  VerticalAlignment="Center" Data="M 3,0 L 6,3 L 3,6 L 0,3 Z"
                                                  Fill="{DynamicResource LocalMagentaBrush}" />
                                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                              TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                              TextElement.FontSize="{DynamicResource FontSizeLarge}"
                                                              TextElement.Foreground="{DynamicResource HeadingForegroundBrush}" />
                                        </DockPanel>
                                    </Border>
                                    <ContentPresenter />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
