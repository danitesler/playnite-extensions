<!--
    Foldcraft: DefaultControls/ProgressBar.xaml. Curled Sky-Blue Confetti Ribbon bar inside
    a kraft folded track. Honours Height="{TemplateBinding Height}" with MinHeight="8" so
    PART_ProgressGlobal renders cleanly at 12px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid Height="{TemplateBinding Height}" MinHeight="{TemplateBinding MinHeight}">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="1">
                                    <Grid>
                                        <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource LocalPaperWhiteBrush}" Opacity="0.4" IsHitTestVisible="False" />
                                        <Control Template="{DynamicResource LocalPaperFibersTemplate}"
                                                 Foreground="{DynamicResource LocalPaperWhiteBrush}" Opacity="0.2"
                                                 Focusable="False" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
