<!--
    Foldcraft: DefaultControls/ListView.xaml. Implicit ListViewItem style only:
    pale Seafoam hover & Seafoam-Mint bookmark selection with 3px Emerald left spine, plus
    Tearaway Confetti Cobalt (#1264B5) RunningIndicator with confetti ribbon sweep (RunningScan),
    2px foot track (RunningFill), RunningMarkPlate, 3 fluttering confetti diamonds, and 36px RowRoom.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="HoverPlate" Background="{DynamicResource ListItemHoverBrush}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Grid x:Name="SelectedPlate" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border Background="{DynamicResource ListItemSelectedBrush}"
                                    BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" />
                            <Rectangle Width="3" Margin="1,3,0,3" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}" />
                        </Grid>

                        <!-- Confetti Electric Cobalt Running Game Indicator -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0.14" />

                            <Grid x:Name="RunningScan" Visibility="Collapsed" ClipToBounds="True">
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <Border Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0.38">
                                    <Rectangle Fill="{DynamicResource LocalCeruleanBrush}" Opacity="0.65"
                                               OpacityMask="{DynamicResource LocalConfettiSweepMaskBrush}" />
                                </Border>
                            </Grid>

                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                    BorderThickness="2" CornerRadius="{DynamicResource CornerRadiusSmall}">
                                <Border BorderBrush="{DynamicResource ScrimBrush}" BorderThickness="1" Opacity="0.45" />
                            </Border>

                            <Grid Height="2" VerticalAlignment="Bottom" Margin="4,0,4,3">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.28" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="FillScaleX" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>

                            <Border x:Name="RunningMarkPlate" Width="36" HorizontalAlignment="Right" Margin="0,2,2,2"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.32"
                                    CornerRadius="0,2,2,0">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.45" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid Width="24" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,1">
                                <Path x:Name="Spark1" Width="5" Height="5" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                      Data="M 2.5,0 L 5,2.5 L 2.5,5 L 0,2.5 Z" Fill="{DynamicResource RunningIndicatorBrush}">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="Spark1Y" Y="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="Spark2" Width="7" Height="7" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 3.5,0 L 7,3.5 L 3.5,7 L 0,3.5 Z" Fill="{DynamicResource LocalCeruleanBrush}">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="Spark2Y" Y="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="Spark3" Width="5" Height="5" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                                      Data="M 2.5,0 L 5,2.5 L 2.5,5 L 0,2.5 Z" Fill="{DynamicResource LocalSkyRibbonBrush}">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="Spark3Y" Y="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Grid>

                        <Border x:Name="RowRoom" Padding="0">
                            <GridViewRowPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverPlate" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- RunningMarkRoom left="0" right="36" -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,36,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark1Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="-3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark2Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="-4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark3Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-2.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,36,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark2" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowBackgroundImageOnWindow}" Value="False" />
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
