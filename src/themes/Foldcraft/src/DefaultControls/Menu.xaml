<!--
    Foldcraft: DefaultControls/Menu.xaml.
    Menu Signature (docs/themes/menus.md):
    - Rows: Compact 30px height, fixed 24px icon column, plain * label column, shared shortcut column, right arrow.
    - Highlight: Papercraft Emerald bookmark slide (#187A36) fades in (110ms) with a crisp Paper White
      triangular notch sliding in from the left and label nudging 2px right; text and icons flip to LocalPaperWhiteBrush (5.25:1).
    - Group break: 10px scissor-cut dashed craft rule flanking an 8px rotated Hot-Magenta origami diamond notch (#E91E78).
    - Shortcuts: Torn-charcoal mini HUD keycaps (#262423 bg, #FAF8F3 Consolas text) flipping to Paper White cap + Emerald ink on hover.
    - Marked rows: Exit (Alt+Q) rests in DangerBrush (#C62828) and fills solid Crimson bookmark with Cream-White ink on hover (5.5:1);
      checked rows show a 14x14 Emerald square check badge that inverts to Paper White + Emerald check when hovered.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group Break: Hot-Magenta Origami Diamond + Dashed Scissor-Cut Craft Rule -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="24,0,10,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="7" Height="7" Stretch="Fill" Margin="0,0,6,0" VerticalAlignment="Center"
                              Data="M 3.5,0 L 7,3.5 L 3.5,7 L 0,3.5 Z" Fill="{DynamicResource LocalMagentaBrush}" />
                        <Rectangle Grid.Column="1" Height="1.5" VerticalAlignment="Center">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,9,1.5" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="{DynamicResource MenuSeparatorBrush}" Geometry="M 0,0 H 5 V 1.5 H 0 Z" />
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SubmenuItemTemplateKey (Plain 30px Papercraft Menu Row) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated Papercraft Emerald Bookmark Highlight Slide (collapsed at rest) -->
            <Border x:Name="HighlightPlate" Background="{DynamicResource MenuItemHoverBrush}"
                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border x:Name="HighlightFoldLip" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,0,1.5" Opacity="0.35" />
            </Border>

            <!-- Sliding White Bookmark Notch (left edge) -->
            <Path x:Name="PointerNotch" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                  Width="6" Height="8" Stretch="Fill" Data="M 0,0 L 6,4 L 0,8 Z"
                  Fill="{DynamicResource LocalPaperWhiteBrush}" Visibility="Collapsed" Opacity="0"
                  IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="PointerShift" X="-6" />
                </Path.RenderTransform>
            </Path>

            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <!-- Fixed Icon / Check Column -->
                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                  ContentSource="Icon"
                                  TextElement.Foreground="{DynamicResource TextBrushDarker}" />
                <Border x:Name="CheckBoxWell" Grid.Column="0" Width="14" Height="14"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                        Background="{DynamicResource MenuItemHoverBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusSmall}" Visibility="Collapsed">
                    <ContentControl x:Name="CheckBoxGlyph" Content="{DynamicResource IconCheck}"
                                    ContentTemplate="{DynamicResource IconSmallTemplate}"
                                    Foreground="{DynamicResource LocalPaperWhiteBrush}"
                                    Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                </Border>

                <!-- Label Column (plain *, trims cleanly) -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Torn-Charcoal Mini HUD Shortcut Keycap -->
                <Border x:Name="ShortcutCap" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                        Padding="5,1" Background="{DynamicResource TopPanelBackgroundBrush}"
                        BorderBrush="{DynamicResource LocalDeckleRimBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusSmall}">
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11"
                               Foreground="{DynamicResource LocalPaperWhiteBrush}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckBoxWell" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutCap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutCap" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!-- Exit (Alt+Q) resting Crimson styling -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </Trigger>

            <!-- Animated Emerald Highlight -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
                <Setter TargetName="ShortcutCap" Property="Background" Value="{DynamicResource LocalPaperWhiteBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource LocalPaperWhiteBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource MenuItemHoverBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard Name="MenuHiIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerNotch" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="PointerNotch" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="PointerShift" Storyboard.TargetProperty="X" From="-6" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Name="MenuHiOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="PointerNotch" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="PointerShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerNotch" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Invert checked square when hovered so it pops on Emerald highlight -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsHighlighted" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CheckBoxWell" Property="Background" Value="{DynamicResource LocalPaperWhiteBrush}" />
                <Setter TargetName="CheckBoxGlyph" Property="Foreground" Value="{DynamicResource MenuItemHoverBrush}" />
            </MultiTrigger>

            <!-- Exit (Alt+Q) Highlighted: Solid Crimson bookmark + Paper White ink & icon (5.5:1 contrast) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HighlightPlate" Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="PointerNotch" Property="Fill" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutCap" Property="Background" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeaderTemplateKey (30px Submenu Row + Accordion Cardstock Child Popup) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held Emerald Bookmark while Submenu is Open -->
            <Border x:Name="OpenPlate" Background="{DynamicResource MenuItemHoverBrush}"
                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,0,1.5" Opacity="0.35" />
            </Border>

            <!-- Animated Emerald Bookmark Highlight -->
            <Border x:Name="HighlightPlate" Background="{DynamicResource MenuItemHoverBrush}"
                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,0,1.5" Opacity="0.35" />
            </Border>

            <!-- Sliding Paper White Bookmark Notch -->
            <Path x:Name="PointerNotch" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                  Width="6" Height="8" Stretch="Fill" Data="M 0,0 L 6,4 L 0,8 Z"
                  Fill="{DynamicResource LocalPaperWhiteBrush}" Visibility="Collapsed" Opacity="0"
                  IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="PointerShift" X="-6" />
                </Path.RenderTransform>
            </Path>

            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                  ContentSource="Icon"
                                  TextElement.Foreground="{DynamicResource TextBrushDarker}" />

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelShift" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <ContentControl x:Name="SubArrow" Grid.Column="3" Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource GlyphBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False" />
            </Grid>

            <!-- Child Submenu Popup -->
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right" HorizontalOffset="2" VerticalOffset="-8"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Focusable="False" PopupAnimation="Fade">
                <Grid Grid.IsSharedSizeScope="True" MinWidth="210" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalPaperBoardTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,2,2" Padding="{DynamicResource MenuPadding}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard Name="SubHiIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerNotch" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="PointerNotch" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="PointerShift" Storyboard.TargetProperty="X" From="-6" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Name="SubHiOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="PointerNotch" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="PointerShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerNotch" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
