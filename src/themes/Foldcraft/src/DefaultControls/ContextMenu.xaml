<!--
    Foldcraft: DefaultControls/ContextMenu.xaml.
    Menu Signature (docs/themes/menus.md):
    - Panel (LocalPaperBoardTemplate): Accordion Ivory Cardstock sheet (#FAF8F3) with cut-paper
      seam outline (#B5AC96), 2px bottom-right studio paper shadow lip (#C4BA9F), faint 5%
      matte paper-fiber pulp texture, and an 11px folded cutting-mat teal origami dog-ear
      tab tucked cleanly into the top-right corner.
    - Shared across ContextMenu, TopPanelMenu, submenus, and ComboBox popups.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Accordion Cardstock Popup Board (hosted by ContextMenu, Submenu Popup, ComboBox Popup) -->
    <ControlTemplate x:Key="LocalPaperBoardTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Studio drop shadow sheet offset bottom-right -->
            <Border Margin="2,2,0,0" Background="{DynamicResource PanelShadowBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <!-- Ivory Cardstock sheet with matte paper fibers + top-right folded origami dog-ear -->
            <Border Margin="0,0,2,2" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                    CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True">
                <Grid>
                    <Control Template="{DynamicResource LocalPaperFibersTemplate}"
                             Foreground="{DynamicResource TextBrushDarker}" Opacity="0.06"
                             Focusable="False" IsHitTestVisible="False" />
                    <Border BorderBrush="{DynamicResource NormalBrushDark}" BorderThickness="0,0,0,1.5" IsHitTestVisible="False" />
                    <!-- Top-right Origami Corner Dog-Ear (cutting-mat teal reverse + ivory crease flap) -->
                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="12" Height="12" IsHitTestVisible="False">
                        <Path Data="M 0,0 L 12,0 L 12,12 Z" Fill="{DynamicResource ShellBackgroundBrush}" />
                        <Path Data="M 0,0 L 0,12 L 12,12 Z" Fill="{DynamicResource NormalBrushDark}" />
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource MenuPadding}" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid Grid.IsSharedSizeScope="True" MinWidth="{TemplateBinding MinWidth}" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalPaperBoardTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,0,2,2" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
