<!--
    Foldcraft: DefaultControls/ComboBox.xaml. 32px Crisp-Paper dropdown with Tearaway's vibrant
    Tangerine (#D96218) square stepper chevron button and at least 12px horizontal clearance for
    ContentSite / PART_EditableTextBox. PART_Popup hosts the shared LocalPaperBoardTemplate accordion
    ivory cardstock sheet; ComboBoxItem wears the 30px Papercraft Emerald bookmark row design.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
        <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Border" Grid.ColumnSpan="2" Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="{DynamicResource ControlBorderThickness}"
                    CornerRadius="{DynamicResource CornerRadiusSmall}">
                <Grid IsHitTestVisible="False">
                    <Control Template="{DynamicResource LocalPaperFibersTemplate}"
                             Foreground="{DynamicResource PanelShadowBrush}" Opacity="0.22"
                             Focusable="False" IsHitTestVisible="False" />
                    <Rectangle Height="6" VerticalAlignment="Top" Fill="{DynamicResource PanelShadowBrush}">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#99000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Rectangle Height="1.5" VerticalAlignment="Bottom" Margin="4,0,30,2" Fill="{DynamicResource NormalBorderBrush}" Opacity="0.6" />
                </Grid>
            </Border>
            <!-- Tangerine Spinner Stepper Cell -->
            <!-- Full-height tangerine ribbon tab with stitched left seam -->
            <Border x:Name="ArrowBox" Grid.Column="1" Margin="0,1.5,1.5,1.5"
                    Background="{DynamicResource ValueAccentBrush}"
                    CornerRadius="0,2,2,0">
                <ContentControl Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource LocalPaperWhiteBrush}"
                                Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
            </Border>
            <!-- Texture + stitched seam over the ribbon tab -->
            <Grid Grid.Column="1" Margin="0,1.5,1.5,1.5" IsHitTestVisible="False">
                <Control Template="{DynamicResource LocalPaperFibersTemplate}"
                         Foreground="{DynamicResource LocalPaperWhiteBrush}" Opacity="0.35"
                         Focusable="False" IsHitTestVisible="False" />
                <Rectangle Width="1" HorizontalAlignment="Left" Margin="2,3" Stroke="{DynamicResource LocalPaperWhiteBrush}"
                           StrokeThickness="1" StrokeDashArray="2 2" Opacity="0.85" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                <Setter TargetName="ArrowBox" Property="Background" Value="{DynamicResource LocalCeruleanBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                <Setter TargetName="ArrowBox" Property="Background" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Template="{StaticResource LocalComboBoxToggleButton}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,2,32,2"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="Left" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{DynamicResource BareTextBox}"
                                 MinHeight="0" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Margin="9,2,32,2" VerticalContentAlignment="Center" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                <Control Template="{DynamicResource LocalPaperBoardTemplate}" Focusable="False" IsTabStop="False" />
                                <ScrollViewer Margin="0,0,2,2" Padding="{DynamicResource ComboBoxDropDownPadding}"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxItemPadding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid Height="30" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Emerald Bookmark Hover Slide -->
                        <Border x:Name="HighlightPlate" Background="{DynamicResource MenuItemHoverBrush}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,0,1.5" Opacity="0.35" />
                        </Border>
                        <Path x:Name="PointerNotch" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                              Width="6" Height="8" Stretch="Fill" Data="M 0,0 L 6,4 L 0,8 Z"
                              Fill="{DynamicResource LocalPaperWhiteBrush}" Visibility="Collapsed" Opacity="0"
                              IsHitTestVisible="False">
                            <Path.RenderTransform>
                                <TranslateTransform x:Name="PointerShift" X="-6" />
                            </Path.RenderTransform>
                        </Path>
                        <Grid Margin="12,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ChosenMark" Grid.Column="0" Width="14" Height="14"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource MenuItemHoverBrush}"
                                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Visibility="Collapsed">
                                <ContentControl x:Name="ChosenMarkGlyph" Content="{DynamicResource IconCheck}"
                                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                Foreground="{DynamicResource LocalPaperWhiteBrush}"
                                                Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ChosenMark" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="CbiHiIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerNotch" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="PointerNotch" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                        <DoubleAnimation Storyboard.TargetName="PointerShift" Storyboard.TargetProperty="X" From="-6" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="CbiHiOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="PointerNotch" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="PointerShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerNotch" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsHighlighted" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ChosenMark" Property="Background" Value="{DynamicResource LocalPaperWhiteBrush}" />
                            <Setter TargetName="ChosenMarkGlyph" Property="Foreground" Value="{DynamicResource MenuItemHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
