<!--
    Foldcraft: DefaultControls/Expander.xaml. Library group headers in Oswald condensed uppercase/title-case
    with Hot-Magenta / Emerald rotated diamond fold indicator and bottom cardstock seam rule.
    Turns Transparent and flips header ink to WindowArtForegroundBrush when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel SnapsToDevicePixels="True">
                        <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HdrBorder" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="8,5">
                                        <DockPanel>
                                            <ContentControl x:Name="Arrow" DockPanel.Dock="Left" Width="10" Height="10"
                                                            Margin="0,0,7,0" VerticalAlignment="Center"
                                                            Content="{DynamicResource IconSubmenu}"
                                                            ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                            Foreground="{DynamicResource GlyphBrush}"
                                                            Focusable="False" />
                                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center"
                                                              TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                              TextElement.FontSize="{DynamicResource FontSize}"
                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="Content" Value="{DynamicResource IconDropDown}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HdrBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter TargetName="HdrBorder" Property="Background" Value="Transparent" />
                                            <Setter TargetName="HdrBorder" Property="BorderBrush" Value="Transparent" />
                                            <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                          Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter TargetName="HeaderSite" Property="Background" Value="Transparent" />
                            <Setter TargetName="HeaderSite" Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
