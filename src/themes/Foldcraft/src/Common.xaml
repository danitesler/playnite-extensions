<!--
    Foldcraft: Common.xaml — Tactile papercraft spacing metrics, white-mask FX ImageBrushes,
    Origami Seal BrandMarkTemplate, accordion card dividers, SecondaryButton, EmptyGameTemplate
    (blueprint fold net + Origami Seal), and SteamScreenshotsSkeletonTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Spacing & Metric Keys (per repo FormControlHeight & Menu rules) -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>               <!-- Standard 32px inputs, combos, buttons -->
    <sys:Double x:Key="IconSize">16</sys:Double>                    <!-- Compact rail and top bar glyphs -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>           <!-- Default hero banner height (0..600) -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>             <!-- Default banner darkening slider (0..1) -->
    <Thickness x:Key="ButtonPadding">14,4</Thickness>               <!-- 1.5px paper border + 4px v-pad = 32px -->
    <Thickness x:Key="InputPadding">9,4</Thickness>                 <!-- TextBox / PasswordBox / ComboBox -->
    <Thickness x:Key="MenuPadding">8,8,10,10</Thickness>            <!-- Cardstock menu inset + corner fold room -->
    <Thickness x:Key="MenuItemPadding">10,4</Thickness>             <!-- Compact 30px menu rows -->
    <Thickness x:Key="ComboBoxDropDownPadding">8,8,10,10</Thickness><!-- Cardstock ComboBox popup inset -->
    <Thickness x:Key="ComboBoxItemPadding">10,4</Thickness>         <!-- 30px ComboBox rows -->
    <Thickness x:Key="ListBoxItemPadding">10,5</Thickness>          <!-- ListBox rows -->
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>      <!-- Accordion cardstock GroupBox inset -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>              <!-- Torn-charcoal HUD tooltip inset -->

    <!-- Shared White-Mask FX ImageBrushes (recolored live by ThemeModifier via Fill) -->
    <ImageBrush x:Key="LocalCuttingMatGridMaskBrush" ImageSource="{ThemeFile 'Images/fx/cutting-mat-grid.png'}"
                TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalPaperFibersMaskBrush" ImageSource="{ThemeFile 'Images/fx/paper-fibers.png'}"
                TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalCorrugatedKraftMaskBrush" ImageSource="{ThemeFile 'Images/fx/corrugated-kraft.png'}"
                TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalAccordionCreasesMaskBrush" ImageSource="{ThemeFile 'Images/fx/accordion-creases.png'}"
                TileMode="Tile" Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalDeckleEdgeHMaskBrush" ImageSource="{ThemeFile 'Images/fx/deckle-edge-h.png'}"
                TileMode="Tile" Viewport="0,0,256,16" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalBlueprintFoldsMaskBrush" ImageSource="{ThemeFile 'Images/fx/blueprint-folds.png'}"
                TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalPaperSheenMaskBrush" ImageSource="{ThemeFile 'Images/fx/paper-sheen.png'}"
                Stretch="Fill" />
    <ImageBrush x:Key="LocalConfettiSweepMaskBrush" ImageSource="{ThemeFile 'Images/fx/confetti-sweep.png'}"
                Stretch="Fill" />

    <!-- Popup Border -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard Focus Visual (crisp Cobalt focus ring) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Texture Mask Templates (recolored cleanly via TemplateBinding Foreground) -->
    <ControlTemplate x:Key="LocalCuttingMatGridTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalCuttingMatGridMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalPaperFibersTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalPaperFibersMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalCorrugatedKraftTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalCorrugatedKraftMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalAccordionCreasesTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalAccordionCreasesMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalDeckleEdgeHTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalDeckleEdgeHMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalBlueprintFoldsTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalBlueprintFoldsMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalPaperSheenTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalPaperSheenMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="LocalConfettiSweepTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalConfettiSweepMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Foldcraft Origami Seal Brand Mark Template (notched folded-paper diamond rosette) -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path Fill="{TemplateBinding Foreground}"
                      Data="F0 M12,1.5 L15.4,4.9 L20.2,3.8 L19.1,8.6 L22.5,12 L19.1,15.4 L20.2,20.2 L15.4,19.1 L12,22.5 L8.6,19.1 L3.8,20.2 L4.9,15.4 L1.5,12 L4.9,8.6 L3.8,3.8 L8.6,4.9 Z M12,5.8 L14.5,9.5 L18.2,12 L14.5,14.5 L12,18.2 L9.5,14.5 L5.8,12 L9.5,9.5 Z M12,9.2 L14.8,12 L12,14.8 L9.2,12 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Main menu mark: an accordion-folded paper strip (three trapezoid pleats, the middle one in shadow), drawn in the host's
         Foreground.
         Hover: the concertina is pulled open, the outer pleats spring apart and the shadowed fold stretches (BackEase, reverses).
         Open (ContextMenu.IsOpen on the nearest Border, PART_ElemMainMenu): the pleats fold flat into a paper envelope, its flap
         flips up over a Hot-Magenta seal and flutters like paper in a breeze until the menu closes.
         Hover and open never animate the same element or property; each exit covers everything its enter animates.
         The host's Padding sets the drawing size (22px in the rail, 18px in the top bar). -->
    <ControlTemplate x:Key="LocalFoldcraftMenuMarkTemplate" TargetType="Control">
        <Grid Background="Transparent">
            <Viewbox Margin="{TemplateBinding Padding}" Stretch="Uniform" IsHitTestVisible="False">
                <Canvas Width="24" Height="24">
                    <Canvas x:Name="Pleats" Width="24" Height="24">
                        <Canvas.RenderTransform><ScaleTransform x:Name="PleatsFold" CenterX="12" CenterY="12" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                        <Path Data="M5.5,9.5 H18.5 L21,15 H3 Z" Fill="{TemplateBinding Foreground}" Opacity="0.55">
                            <Path.RenderTransform><ScaleTransform x:Name="MidStretch" CenterY="12.25" ScaleX="1" ScaleY="1" /></Path.RenderTransform>
                        </Path>
                        <Path Data="M3,4 H21 L18.5,9.5 H5.5 Z" Fill="{TemplateBinding Foreground}">
                            <Path.RenderTransform><TranslateTransform x:Name="TopPull" Y="0" /></Path.RenderTransform>
                        </Path>
                        <Path Data="M3,15 H21 L18.5,20.5 H5.5 Z" Fill="{TemplateBinding Foreground}">
                            <Path.RenderTransform><TranslateTransform x:Name="BottomPull" Y="0" /></Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas x:Name="Envelope" Width="24" Height="24" Opacity="0">
                        <Canvas.RenderTransform><ScaleTransform x:Name="EnvelopePop" CenterX="12" CenterY="14" ScaleX="0.6" ScaleY="0.6" /></Canvas.RenderTransform>
                        <Path Data="M3.5,9 H20.5 V20.5 H3.5 Z" Fill="{DynamicResource LocalPaperWhiteBrush}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                        <Path Data="M3.5,20.5 L10,15 M20.5,20.5 L14,15" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.1" Opacity="0.6" />
                        <Path x:Name="Seal" Data="M12,12.2 L14.3,14.5 L12,16.8 L9.7,14.5 Z" Fill="{DynamicResource LocalMagentaBrush}">
                            <Path.RenderTransform><ScaleTransform x:Name="SealPop" CenterX="12" CenterY="14.5" ScaleX="0.2" ScaleY="0.2" /></Path.RenderTransform>
                        </Path>
                        <Path Data="M3.5,9 L12,15.5 L20.5,9 Z" Fill="{TemplateBinding Foreground}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round">
                            <Path.RenderTransform><ScaleTransform x:Name="FlapOpen" CenterY="9" ScaleX="1" ScaleY="1" /></Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Canvas>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="TopPull" Storyboard.TargetProperty="Y" To="-1.8" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BottomPull" Storyboard.TargetProperty="Y" To="1.8" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MidStretch" Storyboard.TargetProperty="ScaleY" To="1.65" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="TopPull" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BottomPull" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="MidStretch" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PleatsFold" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Pleats" Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.08" Duration="0:0:0.08" />
                            <DoubleAnimation Storyboard.TargetName="Envelope" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.08" />
                            <DoubleAnimation Storyboard.TargetName="EnvelopePop" Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EnvelopePop" Storyboard.TargetProperty="ScaleY" To="1" BeginTime="0:0:0.1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="FlapOpen" Storyboard.TargetProperty="ScaleY" To="-1" BeginTime="0:0:0.28" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="FlapOpen" Storyboard.TargetProperty="ScaleY" From="-1" To="-0.72" BeginTime="0:0:0.52" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SealPop" Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.4" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.8" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SealPop" Storyboard.TargetProperty="ScaleY" To="1" BeginTime="0:0:0.4" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.8" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PleatsFold" Storyboard.TargetProperty="ScaleY" To="1" BeginTime="0:0:0.1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Pleats" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Envelope" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="EnvelopePop" Storyboard.TargetProperty="ScaleX" To="0.6" Duration="0:0:0.12" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="EnvelopePop" Storyboard.TargetProperty="ScaleY" To="0.6" Duration="0:0:0.12" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="FlapOpen" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SealPop" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.12" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SealPop" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Accordion Cardstock Crease Divider with Tri-Tab Paper Swatches (Magenta / Ochre / Teal) -->
    <ControlTemplate x:Key="LocalCardFoldDividerTemplate" TargetType="Control">
        <Grid Height="9" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                <Path Width="7" Height="7" Stretch="Fill" Margin="0,0,3,0"
                      Data="M 3.5,0 L 7,3.5 L 3.5,7 L 0,3.5 Z" Fill="{DynamicResource LocalMagentaBrush}" />
                <Border Width="10" Height="4" Margin="0,0,2,0" Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                        CornerRadius="1" />
                <Border Width="10" Height="4" Margin="0,0,2,0" Background="{DynamicResource ShellBackgroundBrush}"
                        CornerRadius="1" />
                <Border Width="6" Height="4" Background="{DynamicResource LocalCeruleanBrush}"
                        CornerRadius="1" />
            </StackPanel>
            <Rectangle Grid.Column="1" Height="1.5" VerticalAlignment="Center" Fill="{DynamicResource PanelSeparatorBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Section Heading TextBlock (Oswald display heading) -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Secondary Folded Cardstock Button (More, Edit, dialog secondary actions) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Offset bottom-right studio paper shadow lip -->
                        <Border Margin="2,2,0,0" Background="{DynamicResource PanelShadowBrush}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" IsHitTestVisible="False" />
                        <Border x:Name="Plate" Margin="0,0,2,2" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}">
                            <Grid ClipToBounds="True">
                                <Control Template="{DynamicResource LocalPaperFibersTemplate}"
                                         Foreground="{DynamicResource PanelShadowBrush}" Opacity="0.3"
                                         Focusable="False" IsHitTestVisible="False" />
                                <Rectangle Margin="3" RadiusX="2" RadiusY="2" StrokeThickness="1"
                                           Stroke="{DynamicResource NormalBorderBrush}" StrokeDashArray="3 2.5"
                                           Opacity="0.7" IsHitTestVisible="False" />
                                <Border x:Name="HoverWash" Background="{DynamicResource SecondaryButtonHoverBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="PressedWash" Background="{DynamicResource SecondaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <!-- Small top-right corner crease triangle -->
                                <Path HorizontalAlignment="Right" VerticalAlignment="Top" Width="7" Height="7" Stretch="Fill"
                                      Data="M 0,0 L 7,0 L 7,7 Z" Fill="{DynamicResource NormalBrushDark}" IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="SecHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="SecHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedWash" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressedWash" Property="Opacity" Value="1" />
                            <Setter TargetName="Plate" Property="Margin" Value="1,1,1,1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Designed Empty Game State (Papercraft Blueprint Net Card + Origami Seal) -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <!-- Layered bottom-right studio paper shadow sheet -->
            <Border Margin="5,5,0,0" Background="{DynamicResource PanelShadowBrush}"
                    CornerRadius="{DynamicResource CornerRadiusLarge}" IsHitTestVisible="False" />
            <Border Margin="0,0,5,5" Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource NormalBorderBrush}"
                    BorderThickness="1.5" CornerRadius="{DynamicResource CornerRadiusLarge}" Padding="32,26" MinWidth="290"
                    ClipToBounds="True">
                <Grid>
                    <!-- Blueprint papercraft fold pattern behind center emblem -->
                    <Control Margin="-32,-26" Template="{DynamicResource LocalBlueprintFoldsTemplate}"
                             Foreground="{DynamicResource TextBrushDarker}" Opacity="0.14"
                             Focusable="False" IsHitTestVisible="False" />
                    <!-- Top-right ochre corner fold accent -->
                    <Path HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-26,-32,0"
                          Width="24" Height="24" Stretch="Fill" Data="M 0,0 L 24,0 L 24,24 Z"
                          Fill="{DynamicResource PrimaryButtonBackgroundBrush}" IsHitTestVisible="False" />
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="54" Height="54" HorizontalAlignment="Center" Margin="0,0,0,14"
                                Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource LocalMatTealHiBrush}"
                                BorderThickness="1.5" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid ClipToBounds="True">
                                <Control Template="{DynamicResource LocalCuttingMatGridTemplate}"
                                         Foreground="{DynamicResource LocalMatGridBrush}" Opacity="0.22"
                                         Focusable="False" IsHitTestVisible="False" />
                                <Control x:Name="EmptyEmblem" Template="{DynamicResource BrandMarkTemplate}"
                                         Foreground="{DynamicResource LocalPaperWhiteBrush}" Width="34" Height="34"
                                         RenderTransformOrigin="0.5,0.5" Focusable="False">
                                    <Control.RenderTransform>
                                        <ScaleTransform x:Name="EmblemPulse" ScaleX="1" ScaleY="1" />
                                    </Control.RenderTransform>
                                </Control>
                            </Grid>
                        </Border>
                        <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" FontFamily="{DynamicResource HeadingFontFamily}"
                                   FontSize="{DynamicResource FontSizeLarger}" Foreground="{DynamicResource TextBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                        <Control Template="{DynamicResource LocalCardFoldDividerTemplate}" Width="148" Margin="0,12,0,0" Focusable="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="EmptyEmblemIdle">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="EmblemPulse" Storyboard.TargetProperty="ScaleX" From="1" To="1.06" Duration="0:0:1.6">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="EmblemPulse" Storyboard.TargetProperty="ScaleY" From="1" To="1.06" Duration="0:0:1.6">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyEmblemIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Steam Screenshots Loading Skeleton (Folded Cardstock Photo Mounts) -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <UniformGrid Rows="1" Columns="3" Height="110" Margin="0,6,0,0">
            <Border Margin="0,0,8,0" Background="{DynamicResource NormalBrushDark}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border x:Name="Skel1" Background="{DynamicResource LocalPaperWhiteBrush}" Opacity="0.32" />
            </Border>
            <Border Margin="4,0,4,0" Background="{DynamicResource NormalBrushDark}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border x:Name="Skel2" Background="{DynamicResource LocalPaperWhiteBrush}" Opacity="0.32" />
            </Border>
            <Border Margin="8,0,0,0" Background="{DynamicResource NormalBrushDark}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5" CornerRadius="{DynamicResource ControlCornerRadius}">
                <Border x:Name="Skel3" Background="{DynamicResource LocalPaperWhiteBrush}" Opacity="0.32" />
            </Border>
        </UniformGrid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="SkelPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Skel1" Storyboard.TargetProperty="Opacity" From="0.2" To="0.58" Duration="0:0:0.9" />
                            <DoubleAnimation Storyboard.TargetName="Skel2" Storyboard.TargetProperty="Opacity" From="0.2" To="0.58" BeginTime="0:0:0.15" Duration="0:0:0.9" />
                            <DoubleAnimation Storyboard.TargetName="Skel3" Storyboard.TargetProperty="Opacity" From="0.2" To="0.58" BeginTime="0:0:0.3" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkelPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
