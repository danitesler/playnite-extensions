<!--
    Foldcraft: DerivedStyles/GridViewItemStyle.xaml.
    Cut-paper Photo Mount Cover Tiles:
    - Rest: Ivory cardstock sleeve (#EAE3D2) with cut-paper seam rim and offset studio shadow lip.
    - Hover: BackEase spring paper lift (Scale 1.025) + bright Cerulean frame (#1EA1D4) and diagonal
      Cerulean masking-tape strips taped onto the Top-Left and Bottom-Right corners.
    - Selected: Signature Papercraft Emerald active frame (#187A36) + folded Ochre-Gold origami corner
      triangle stamped cleanly in the Top-Right corner with a crisp Paper-White diamond seal.
    - RunningIndicator (Confetti Cobalt #1264B5, drawn AFTER hover & selection, inset 4px):
      confetti launch sweep (confetti-sweep.png), bottom 16px Deep Cobalt scrim ribbon with
      RunningFill + 3 lively confetti diamonds.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="SlotRoot" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <!-- Layered Cardstock Shadow Sheet -->
                        <Border Margin="3,3,0,0" Background="{DynamicResource PanelShadowBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />

                        <!-- Ivory Cardstock Photo Mount -->
                        <Border Margin="0,0,3,3" Background="{DynamicResource NormalBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="2">
                            <ContentPresenter />
                        </Border>

                        <!-- Hover Layer: Cerulean Outline + Diagonal Corner Tape Ears -->
                        <Grid x:Name="HoverOverlay" Margin="0,0,3,3" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Margin="-1" BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}"
                                    BorderThickness="2.5" CornerRadius="{DynamicResource CornerRadiusLarge}" />
                            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,-2,0,0"
                                  Width="16" Height="16" Stretch="Fill" Data="M 0,0 L 16,0 L 0,16 Z"
                                  Fill="{DynamicResource GridViewItemHoverBorderBrush}" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                  Width="16" Height="16" Stretch="Fill" Data="M 16,0 L 16,16 L 0,16 Z"
                                  Fill="{DynamicResource GridViewItemHoverBorderBrush}" />
                        </Grid>

                        <!-- Selected Layer: Papercraft Emerald Frame + Folded Ochre-Gold Top-Right Origami Stamp -->
                        <Grid x:Name="SelectedOverlay" Margin="0,0,3,3" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SelFrameScale" ScaleX="0.97" ScaleY="0.97" />
                            </Grid.RenderTransform>
                            <Border Margin="-1" BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}"
                                    BorderThickness="3" CornerRadius="{DynamicResource CornerRadiusLarge}" />
                            <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="22">
                                <Path Data="M 0,0 L 22,0 L 22,22 Z" Fill="{DynamicResource PrimaryButtonBackgroundBrush}" />
                                <Path Canvas.Left="11" Canvas.Top="4" Width="6" Height="6" Stretch="Fill"
                                      Data="M 3,0 L 6,3 L 3,6 L 0,3 Z" Fill="{DynamicResource LocalPaperWhiteBrush}" />
                            </Canvas>
                        </Grid>

                        <!-- Running Game Indicator (Confetti Cobalt, drawn AFTER hover & selection, inset 4px) -->
                        <Grid x:Name="RunningIndicator" Margin="4,4,7,7" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0.16" />

                            <Grid x:Name="RunningScan" Visibility="Collapsed" ClipToBounds="True">
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <Border Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0.36">
                                    <Rectangle Fill="{DynamicResource LocalCeruleanBrush}" Opacity="0.6"
                                               OpacityMask="{DynamicResource LocalConfettiSweepMaskBrush}" />
                                </Border>
                            </Grid>

                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                    BorderThickness="2.5" CornerRadius="{DynamicResource CornerRadiusSmall}">
                                <Border BorderBrush="{DynamicResource ScrimBrush}" BorderThickness="1" Opacity="0.5" />
                            </Border>

                            <!-- 16px Deep Cobalt Confetti Foot Ribbon holding RunningFill + 3 Diamonds -->
                            <Border Height="16" VerticalAlignment="Bottom" Margin="2"
                                    Background="{DynamicResource ScrimBrush}" Opacity="0.88" CornerRadius="0,0,2,2">
                                <Grid Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Height="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                                        <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalPaperWhiteBrush}" RenderTransformOrigin="0,0.5">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="FillScaleX" ScaleX="0" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path x:Name="Spark1" Width="5" Height="5" Margin="0,0,3,0" Stretch="Fill"
                                              Data="M 2.5,0 L 5,2.5 L 2.5,5 L 0,2.5 Z" Fill="{DynamicResource LocalPaperWhiteBrush}">
                                            <Path.RenderTransform><TranslateTransform x:Name="Spark1Y" Y="0" /></Path.RenderTransform>
                                        </Path>
                                        <Path x:Name="Spark2" Width="6" Height="6" Margin="0,0,3,0" Stretch="Fill"
                                              Data="M 3,0 L 6,3 L 3,6 L 0,3 Z" Fill="{DynamicResource LocalSkyRibbonBrush}">
                                            <Path.RenderTransform><TranslateTransform x:Name="Spark2Y" Y="0" /></Path.RenderTransform>
                                        </Path>
                                        <Path x:Name="Spark3" Width="5" Height="5" Stretch="Fill"
                                              Data="M 2.5,0 L 5,2.5 L 2.5,5 L 0,2.5 Z" Fill="{DynamicResource LocalGoldSealBrush}">
                                            <Path.RenderTransform><TranslateTransform x:Name="Spark3Y" Y="0" /></Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Panel.ZIndex" Value="5" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="CoverHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="CoverHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="6" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="CoverSelIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelFrameScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelFrameScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CoverSelIn" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark1Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="-2.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark2Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="-3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark3Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark2" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
