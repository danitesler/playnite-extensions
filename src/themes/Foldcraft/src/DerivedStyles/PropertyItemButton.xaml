<!--
    Foldcraft: DerivedStyles/PropertyItemButton.xaml.
    Default: High-contrast cerulean link (#0B6E99) underlining on hover.
    Tag="Chip" (ItemsControl ancestor): Hand-cut Tearaway craft luggage/ribbon tags with a
    punched eyelet hole on the left, Cerulean tape tab, diagonal paper-fold crease, notched
    swallowtail ribbon tail on the right, and offset paper shadow; flips to Ochre-Gold on hover.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Hand-Cut Swallowtail Ribbon Craft Tag (shown when ItemsControl.Tag == "Chip") -->
                        <Grid x:Name="ChipHost" Visibility="Collapsed" IsHitTestVisible="False">
                            <!-- Offset Studio Shadow -->
                            <Grid Margin="2,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="9" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="{DynamicResource PanelShadowBrush}" />
                                <Path Grid.Column="1" Width="9" Stretch="Fill"
                                      Data="M 0,0 L 9,0 L 4,11 L 9,22 L 0,22 Z"
                                      Fill="{DynamicResource PanelShadowBrush}" />
                            </Grid>
                            <!-- Main Folded Craft Tag -->
                            <Grid Margin="0,0,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="9" />
                                </Grid.ColumnDefinitions>
                                <!-- Left Tape & Punched Eyelet Cap -->
                                <Border x:Name="ChipCap" Grid.Column="0" Background="{DynamicResource NormalBrush}"
                                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5,1.5,0,1.5">
                                    <Grid>
                                        <Rectangle x:Name="TapeStrip" Width="3" HorizontalAlignment="Left"
                                                   Fill="{DynamicResource LocalCeruleanBrush}" />
                                        <Ellipse Width="5" Height="5" Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{DynamicResource GameOverviewBackgroundBrush}"
                                                 Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1.2" />
                                    </Grid>
                                </Border>
                                <!-- Center Paper Strip with subtle fold crease -->
                                <Border x:Name="ChipBody" Grid.Column="1" Background="{DynamicResource PropertyItemBackgroundBrush}"
                                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,1.5,0,1.5">
                                    <Rectangle Fill="{DynamicResource NormalBrushDark}" Opacity="0.22" Width="12" HorizontalAlignment="Right">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#00000000" Offset="0.45" />
                                                <GradientStop Color="#FF000000" Offset="0.5" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Border>
                                <!-- Swallowtail Scissor-Cut Tail -->
                                <Grid Grid.Column="2">
                                    <Path x:Name="ChipTail" Width="9" Stretch="Fill"
                                          Data="M 0,0 L 9,0 L 4,11 L 9,22 L 0,22 Z"
                                          Fill="{DynamicResource PropertyItemBackgroundBrush}" />
                                    <Path Width="9" Stretch="Fill"
                                          Data="M 0,0.75 L 8.5,0.75 L 3.8,11 L 8.5,21.25 L 0,21.25"
                                          Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1.4" />
                                </Grid>
                            </Grid>
                        </Grid>

                        <TextBlock x:Name="Label" Margin="{TemplateBinding Padding}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="Bold" TextTrimming="CharacterEllipsis">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                            <Setter TargetName="ChipHost" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                            <Setter Property="Padding" Value="18,3,15,4" />
                            <Setter Property="Margin" Value="0,0,6,6" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Label" Property="TextDecorations" Value="{x:Null}" />
                            <Setter TargetName="ChipCap" Property="Background" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                            <Setter TargetName="ChipBody" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                            <Setter TargetName="ChipTail" Property="Fill" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                            <Setter TargetName="TapeStrip" Property="Fill" Value="{DynamicResource TextBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
