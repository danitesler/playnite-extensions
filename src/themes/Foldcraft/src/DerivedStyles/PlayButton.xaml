<!--
    Foldcraft: DerivedStyles/PlayButton.xaml (Ochre Hero Moment & Confetti Cobalt RunningActionIndicator).
    - Play CTA: Tearaway Ochre-Gold (#E0A229) construction-paper button with 2px offset paper
      shadow lip, deep espresso ink (#221D1A, 7.8:1), and Golden Star-Seal corner fold triangle.
    - Hover: Sunlit Ochre (#EEB53E), golden outer paper rim, diagonal sunlight sweep (paper-sheen.png),
      BackEase upward paper lift (-1.5px), and +2px Play glyph nudge; press sinks cleanly.
    - Running / Launching (Confetti Cobalt #1264B5): switches Background to RunningIndicatorBrush
      and Foreground to LocalPaperWhiteBrush (#FAF8F3, 5.85:1, >8:1 under ScrimBrush), collapses idle hover
      layers inside IdleHoverHost/IdleHaloHost, sweeps Confetti (confetti-sweep.png) while Launching,
      and shows RunningHoverDim + CancelLabel only when hovered (IsRunning + RelativeSource Self).
    - RunningActionIndicator: Confetti Cobalt border frame, paper-white foot ribbon (RunningFill),
      and 3 staggered tumbling confetti diamonds inside PlayRoom=0,0,34,0.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinWidth" Value="156" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="BtnRoot" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PlateLift" Y="0" />
                        </Grid.RenderTransform>

                        <!-- Outer Golden Seal Halo Rim (hidden via IdleHaloHost while launching/running) -->
                        <Grid x:Name="IdleHaloHost" IsHitTestVisible="False">
                            <Border x:Name="HoverHaloRim" Margin="-2" BorderBrush="{DynamicResource PrimaryButtonGlowBrush}"
                                    BorderThickness="2" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        </Grid>

                        <!-- Offset studio paper shadow lip -->
                        <Border x:Name="ShadowLip" Margin="2,2,0,0" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />

                        <!-- Main Ochre-Gold Folded Cutout Plate -->
                        <Border x:Name="PlayFill" Margin="0,0,2,2" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True">
                            <Grid>
                                <!-- RunningBreath: Deep Cobalt Scrim darkening under text while Launching/Running -->
                                <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- RunningScan: Confetti ribbon sweep during Launching -->
                                <Grid x:Name="RunningScan" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <Border Background="{DynamicResource LocalCeruleanBrush}" Opacity="0.52">
                                        <Rectangle Fill="{DynamicResource LocalPaperWhiteBrush}" Opacity="0.48"
                                                   OpacityMask="{DynamicResource LocalConfettiSweepMaskBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Idle Hover Layer wrapped in IdleHoverHost so Running states stay Confetti Cobalt -->
                                <Grid x:Name="IdleHoverHost" IsHitTestVisible="False">
                                    <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                        <Border Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                                        <Rectangle x:Name="SheenSweep" Width="130" HorizontalAlignment="Left"
                                                   Fill="{DynamicResource LocalPaperWhiteBrush}" Opacity="0.34"
                                                   OpacityMask="{DynamicResource LocalPaperSheenMaskBrush}">
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform x:Name="SheenX" X="-130" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                </Grid>

                                <!-- Pressed Layer -->
                                <Border x:Name="PressedLayer" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- RunningHoverDim: Second scrim faded in strictly on Running + Self hover -->
                                <Border x:Name="RunningHoverDim" Background="{DynamicResource ScrimBrush}"
                                        Opacity="0" IsHitTestVisible="False" />

                                <!-- Top-right Origami Corner Crease Triangle -->
                                <Path x:Name="CornerFold" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Width="10" Height="10" Stretch="Fill" Data="M 0,0 L 10,0 L 10,10 Z"
                                      Fill="{DynamicResource PrimaryButtonGlowBrush}" IsHitTestVisible="False" />

                                <!-- Content Room (reserves right 34px strip for RunningActionIndicator confetti) -->
                                <Border x:Name="PlayRoom" Padding="0">
                                    <Grid Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel x:Name="PlayContent" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <ContentControl x:Name="PlayGlyph" Content="{DynamicResource IconPlay}"
                                                            ContentTemplate="{DynamicResource IconTemplate}"
                                                            Foreground="{TemplateBinding Foreground}"
                                                            Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False">
                                                <ContentControl.RenderTransform>
                                                    <TranslateTransform x:Name="GlyphNudge" X="0" />
                                                </ContentControl.RenderTransform>
                                            </ContentControl>
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                                        </StackPanel>
                                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                                   FontFamily="{DynamicResource HeadingFontFamily}"
                                                   FontSize="17" Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed" Opacity="0" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hide Play triangle on ContextAction button (Install / Launching / Running) -->
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Idle Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverHaloRim" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="HoverHaloRim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="PlateLift" Storyboard.TargetProperty="Y" To="-1.5" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlyphNudge" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SheenX" Storyboard.TargetProperty="X" From="-120" To="195" Duration="0:0:0.38">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="HoverHaloRim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="PlateLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="GlyphNudge" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverHaloRim" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Pressed State -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedLayer" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressedLayer" Property="Opacity" Value="1" />
                            <Setter TargetName="PlayFill" Property="Margin" Value="1,1,1,1" />
                        </Trigger>

                        <!-- RunningMarkRoom left="0" right="34" -->
                        <!-- LAUNCHING State: Solid Confetti Cobalt plate + Paper-White ink + Confetti Sweep -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
                            <Setter TargetName="PlayFill" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource ScrimBrush}" />
                            <Setter TargetName="ShadowLip" Property="Background" Value="{DynamicResource ScrimBrush}" />
                            <Setter TargetName="CornerFold" Property="Fill" Value="{DynamicResource LocalCeruleanBrush}" />
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleHaloHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverHaloRim" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,34,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningBreathLaunch">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.24" To="0.44" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                                <RemoveStoryboard BeginStoryboardName="RunningBreathLaunch" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING State: Solid Confetti Cobalt plate + Calm Breathing Scrim + Paper-White ink -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
                            <Setter TargetName="PlayFill" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="PlayFill" Property="BorderBrush" Value="{DynamicResource ScrimBrush}" />
                            <Setter TargetName="ShadowLip" Property="Background" Value="{DynamicResource ScrimBrush}" />
                            <Setter TargetName="CornerFold" Property="Fill" Value="{DynamicResource LocalCeruleanBrush}" />
                            <Setter TargetName="IdleHoverHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IdleHaloHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverHaloRim" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,34,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.22" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.22" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING + Button Self Hover ONLY: Hide PlayContent (Hidden, never Collapsed) & show Cancel -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="RunningCancelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RunningActionIndicator: Confetti Cobalt overlay over Play / ContextAction cell -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Margin="0,0,2,2" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}"
                                BorderThickness="1.5" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Border BorderBrush="{DynamicResource LocalCeruleanBrush}" BorderThickness="1" Opacity="0.7" />
                        </Border>

                        <!-- Confetti Foot Ribbon Progress Line -->
                        <Grid Height="2" VerticalAlignment="Bottom" Margin="6,0,6,4">
                            <Rectangle Fill="{DynamicResource LocalCeruleanBrush}" Opacity="0.3" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource LocalPaperWhiteBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="FillScaleX" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <!-- 3 Staggered Confetti Diamonds on right edge (inside 34px reserved PlayRoom strip) -->
                        <Grid Width="24" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,1">
                            <Path x:Name="Spark1" Width="6" Height="6" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                  Data="M 3,0 L 6,3 L 3,6 L 0,3 Z" Fill="{DynamicResource LocalPaperWhiteBrush}" Opacity="0.82">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="Spark1Y" Y="0" />
                                </Path.RenderTransform>
                            </Path>
                            <Path x:Name="Spark2" Width="8" Height="8" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 4,0 L 8,4 L 4,8 L 0,4 Z" Fill="{DynamicResource LocalSkyRibbonBrush}" Opacity="0.95">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="Spark2Y" Y="0" />
                                </Path.RenderTransform>
                            </Path>
                            <Path x:Name="Spark3" Width="5" Height="5" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,1,0"
                                  Data="M 2.5,0 L 5,2.5 L 2.5,5 L 0,2.5 Z" Fill="{DynamicResource LocalGoldSealBrush}" Opacity="0.9">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="Spark3Y" Y="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark1Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="-4" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark2Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="-5" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark3Y" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-3" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark2" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FillScaleX" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
