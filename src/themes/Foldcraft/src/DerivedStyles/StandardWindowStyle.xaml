<!--
    Foldcraft: DerivedStyles/StandardWindowStyle.xaml. 44px Gridded Cutting-Mat dialog title band
    with subtle etched grid lines, Origami Seal crisp-white medallion, ghosted Origami Seal watermark,
    Oswald title, WindowSettings title trigger, and standalone WindowDesignStyle.
    CaptionHeight (44) equals ContentPresenter top margin (44) per settings-screens.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Handmade paper tooth + faint blueprint fold net across dialog canvas -->
                                <Control Margin="0,44,0,0" Template="{DynamicResource LocalPaperFibersTemplate}"
                                         Foreground="{DynamicResource PanelShadowBrush}" Opacity="0.15"
                                         Focusable="False" IsHitTestVisible="False" />
                                <Control Margin="0,44,0,0" Template="{DynamicResource LocalBlueprintFoldsTemplate}"
                                         Foreground="{DynamicResource TextBrushDarker}" Opacity="0.1"
                                         Focusable="False" IsHitTestVisible="False" />

                                <!-- Bottom-right Tearaway layered origami corner fold collage (non-interactive, behind content) -->
                                <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="0" Height="0" IsHitTestVisible="False">
                                    <Path Canvas.Left="-190" Canvas.Top="-150" Data="M 190,150 L 190,18 L 58,150 Z"
                                          Fill="{DynamicResource SelectedBrush}" Opacity="0.38" />
                                    <Path Canvas.Left="-148" Canvas.Top="-118" Data="M 148,118 L 148,10 L 40,118 Z"
                                          Fill="{DynamicResource LocalCeruleanBrush}" Opacity="0.28" />
                                    <Path Canvas.Left="-104" Canvas.Top="-86" Data="M 104,86 L 104,6 L 24,86 Z"
                                          Fill="{DynamicResource PrimaryButtonBackgroundBrush}" Opacity="0.34" />
                                    <Path Canvas.Left="-62" Canvas.Top="-52" Data="M 62,52 L 62,4 L 14,52 Z"
                                          Fill="{DynamicResource LocalMagentaBrush}" Opacity="0.26" />
                                    <Control Canvas.Left="-92" Canvas.Top="-92" Width="54" Height="54"
                                             Template="{DynamicResource BrandMarkTemplate}"
                                             Foreground="{DynamicResource TextBrushDarker}" Opacity="0.09"
                                             Focusable="False" IsHitTestVisible="False" />
                                </Canvas>

                                <!-- Top-right angled masking-tape strip holding the paper sheet -->
                                <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0" Margin="0,44,0,0" IsHitTestVisible="False">
                                    <Border Canvas.Left="-56" Canvas.Top="-6" Width="76" Height="16"
                                            Background="{DynamicResource SelectedBrush}" Opacity="0.72"
                                            BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                                        <Border.RenderTransform><RotateTransform Angle="32" /></Border.RenderTransform>
                                    </Border>
                                </Canvas>

                                <!-- Dialog content offset equals 44px CaptionHeight -->
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px Gridded Cutting-Mat Title Band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}"
                                      ClipToBounds="True" SnapsToDevicePixels="True">
                                    <Control Template="{DynamicResource LocalCuttingMatGridTemplate}"
                                             Foreground="{DynamicResource LocalMatGridBrush}" Opacity="0.18"
                                             Focusable="False" IsHitTestVisible="False" />

                                    <!-- Layered Tearaway construction-paper ribbon fan + ghosted Origami Seal on right -->
                                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0" IsHitTestVisible="False">
                                        <Border Canvas.Left="-215" Canvas.Top="-8" Width="46" Height="64"
                                                Background="{DynamicResource LocalMintBrightBrush}" Opacity="0.28">
                                            <Border.RenderTransform><RotateTransform Angle="22" /></Border.RenderTransform>
                                        </Border>
                                        <Border Canvas.Left="-178" Canvas.Top="-10" Width="44" Height="66"
                                                Background="{DynamicResource LocalCeruleanBrush}" Opacity="0.34">
                                            <Border.RenderTransform><RotateTransform Angle="22" /></Border.RenderTransform>
                                        </Border>
                                        <Border Canvas.Left="-142" Canvas.Top="-10" Width="42" Height="66"
                                                Background="{DynamicResource PrimaryButtonBackgroundBrush}" Opacity="0.36">
                                            <Border.RenderTransform><RotateTransform Angle="22" /></Border.RenderTransform>
                                        </Border>
                                        <Border Canvas.Left="-108" Canvas.Top="-10" Width="36" Height="66"
                                                Background="{DynamicResource LocalMagentaBrush}" Opacity="0.3">
                                            <Border.RenderTransform><RotateTransform Angle="22" /></Border.RenderTransform>
                                        </Border>
                                        <Control Canvas.Left="-136" Canvas.Top="-10" Width="64" Height="64"
                                                 Template="{DynamicResource BrandMarkTemplate}"
                                                 Foreground="{DynamicResource LocalPaperWhiteBrush}" Opacity="0.14"
                                                 Focusable="False" IsHitTestVisible="False" />
                                    </Canvas>

                                    <!-- Hairline cyan rule + paper shadow at foot of title band -->
                                    <StackPanel VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <Rectangle Height="1.5" Fill="{DynamicResource LocalMatGridBrush}" Opacity="0.45" />
                                        <Rectangle Height="2" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
                                    </StackPanel>

                                    <DockPanel LastChildFill="False" VerticalAlignment="Center" Margin="12,0,6,2">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <Border Width="24" Height="24" Margin="0,0,10,0"
                                                    Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                                    BorderBrush="{DynamicResource LocalGoldSealBrush}" BorderThickness="1.5"
                                                    CornerRadius="{DynamicResource CornerRadiusSmall}">
                                                <Control Width="14" Height="14" Template="{DynamicResource BrandMarkTemplate}"
                                                         Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                                            </Border>
                                            <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
    </Style>
</ResourceDictionary>
