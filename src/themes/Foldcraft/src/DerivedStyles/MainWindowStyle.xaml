<!--
    Foldcraft: DerivedStyles/MainWindowStyle.xaml. Craft-paper MainWindow frame, 42x46 MainWindowButton
    captions wearing Tearaway's circular grey cardstock discs (28x28 CornerRadiusFull, Crimson X on
    close, solid Crimson disc on close hover), 44x50 Crisp-White Origami Seal MainMenuButton, and 32px
    TopPanelSearchBox.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="MainWindowButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="46" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Circular 1:1 Cut-Cardstock Disc (28x28) -->
                        <Border x:Name="Disc" Width="28" Height="28" Background="{DynamicResource LocalCloseDiscBrush}"
                                BorderBrush="{DynamicResource LocalCardstockGreyBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource CornerRadiusFull}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter x:Name="Glyph" Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{DynamicResource IconWindowClose}"
                                              ContentTemplate="{DynamicResource IconTemplate}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="0">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMinimize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="1">
                            <Setter Property="Content" Value="{DynamicResource IconWindowMaximize}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="2">
                            <Setter Property="Content" Value="{DynamicResource IconWindowRestore}" TargetName="Glyph" />
                        </Trigger>
                        <Trigger Property="Content" Value="r">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Background" Value="{DynamicResource LocalPaperWhiteBrush}" />
                            <Setter TargetName="Disc" Property="BorderBrush" Value="{DynamicResource LocalCeruleanBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Content" Value="r" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Disc" Property="Background" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="Disc" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MainWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="25" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <ContentPresenter Margin="0" />
                                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                        <TextBlock Text="{TemplateBinding Title}" DockPanel.Dock="Left" Margin="10,3,0,0" VerticalAlignment="Center"
                                                   Opacity="0.75" Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,6,0">
                                            <Button Style="{DynamicResource MainWindowButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource MainWindowButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource MainWindowButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MainMenuButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" Padding="5,7,5,7">
                        <Border x:Name="MenuTile" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True">
                            <Grid>
                                <Path HorizontalAlignment="Right" VerticalAlignment="Top" Width="6" Height="6" Stretch="Fill"
                                      Data="M 0,0 L 6,0 L 6,6 Z" Fill="{DynamicResource LocalGoldSealBrush}" IsHitTestVisible="False" />
                                <Control Width="20" Height="20" Template="{DynamicResource BrandMarkTemplate}"
                                         Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MenuTile" Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                            <Setter TargetName="MenuTile" Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
    </Style>
</ResourceDictionary>
