<!--
    Foldcraft: DerivedStyles/TextBlockGameScore.xaml.
    Cutout cardstock score badges in Oswald condensed figures on Positive (Emerald + White 5.25:1),
    Mixed (Dark Amber + White 5.5:1), Negative (Crimson + White 5.5:1), or None (Folded Ivory).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="TextBlockGameScore" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="Margin" Value="0,1,0,3" />
        <Setter Property="Background" Value="{DynamicResource LocalPaperWhiteBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Positive}">
                <Setter Property="Background" Value="{DynamicResource PositiveRatingBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Mixed}">
                <Setter Property="Background" Value="{DynamicResource MixedRatingBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource LocalPaperWhiteBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Negative}">
                <Setter Property="Background" Value="{DynamicResource NegativeRatingBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.None}">
                <Setter Property="Background" Value="{DynamicResource NormalBrushDark}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
