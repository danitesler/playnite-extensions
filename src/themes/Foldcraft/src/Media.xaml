<!--
    Foldcraft: Media.xaml — Crisp scissor-cut angular papercraft vector icons (24x24 viewport) inspired by
    Tearaway's folded paper crafts, ribbons, tabs, and bookmarks. IconMainMenu renders the Origami Seal.
    Playnite's 22 icofont menu icons omit local Foreground so they inherit TextElement.Foreground on
    Papercraft Emerald hover and Crimson Exit highlights.
-->
<ResourceDictionary xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Icon DataTemplates -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox MaxWidth="{DynamicResource IconSize}" MaxHeight="{DynamicResource IconSize}" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox MaxWidth="12" MaxHeight="12" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileSolidTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

