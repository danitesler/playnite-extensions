<!--
    Foldcraft: Constants.xaml template (Tactile Papercraft theme inspired by Tearaway).
    scripts/build-theme.ps1 renders tokens.css placeholders into Constants.xaml.
    Warm fibrous craft paper, accordion-creased ivory cardstock, gridded self-healing cutting-mat rail,
    torn-charcoal HUD top bar, seafoam-mint bookmark selections, ochre-gold Play trigger,
    emerald/crimson folded toggles, tangerine steppers, hot-magenta rules, and confetti-cobalt running sweep.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Oswald & Nunito static SIL OFL TTFs bundled in src/Typography/) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">22</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Nunito, Nunito, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Oswald, Oswald, Barlow Condensed, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Game page metadata pane defaults (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape & radii: crisp cut-paper corners; 9999 strictly for 1:1 circular badges & discs -->
    <Thickness x:Key="PopupBorderThickness">1.5</Thickness>
    <Thickness x:Key="ControlBorderThickness">1.5</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:fc-radius|5}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:fc-radius-sm|3}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:fc-radius-lg|8}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{fc-ink}}</Color>
    <Color x:Key="TextColorDarker">{{fc-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{fc-ink-on-mint}}</Color>
    <Color x:Key="MainColor">{{fc-paper-card}}</Color>
    <Color x:Key="MainColorDark">{{fc-paper-fold}}</Color>
    <Color x:Key="HoverColor">{{fc-mint-wash}}</Color>
    <Color x:Key="GlyphColor">{{fc-emerald}}</Color>
    <Color x:Key="HighlightGlyphColor">{{fc-emerald-hi}}</Color>
    <Color x:Key="PopupBackgroundColor">{{fc-paper-bright}}</Color>
    <Color x:Key="PopupBorderColor">{{fc-ink}}</Color>
    <Color x:Key="BackgroundToneColor">{{fc-mint-select}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{fc-paper-edge}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{fc-paper-shadow}}</Color>
    <Color x:Key="DataChangeNotifColor">{{fc-magenta}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{fc-paper-edge}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{fc-charcoal}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{fc-deckle-rim}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{fc-emerald}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{fc-crimson}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{fc-amber-mix}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{fc-tangerine}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{fc-paper-card}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{fc-paper}}" />

    <!-- Shell, Chrome & Game Page Brushes -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{fc-mat-teal}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{fc-charcoal}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{fc-paper}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{fc-paper}}" />
    <!-- Banner darkening color: solid warm fibrous craft paper so darkened banner blends smoothly into paper page -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{fc-paper}}" />
    <!-- ScrimBrush: deep cobalt scrim darkening RunningIndicatorBrush button plate so white text stays >= 6.5:1 -->
    <SolidColorBrush x:Key="ScrimBrush" Color="{{fc-cobalt-scrim}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{fc-paper-shadow}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{fc-mat-teal}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{fc-paper-card}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{fc-deckle-rim}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{fc-mat-teal}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{fc-ink}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{fc-magenta}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{fc-paper-edge}}" />

    <!-- Light-Theme Window Background Art Flip (readable paper-white ink directly over game art) -->
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{fc-paper-bright}}" />

    <!-- Theme-local papercraft decorative roles (prefixed with Local) -->
    <SolidColorBrush x:Key="LocalMatGridBrush" Color="{{fc-mat-grid}}" />
    <SolidColorBrush x:Key="LocalMatTealHiBrush" Color="{{fc-mat-teal-hi}}" />
    <SolidColorBrush x:Key="LocalPaperWhiteBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="LocalCardstockGreyBrush" Color="{{fc-cardstock-grey}}" />
    <SolidColorBrush x:Key="LocalCloseDiscBrush" Color="{{fc-cardstock-disc}}" />
    <SolidColorBrush x:Key="LocalMintBrightBrush" Color="{{fc-mint-bright}}" />
    <SolidColorBrush x:Key="LocalCeruleanBrush" Color="{{fc-cerulean}}" />
    <SolidColorBrush x:Key="LocalSkyRibbonBrush" Color="{{fc-sky-ribbon}}" />
    <SolidColorBrush x:Key="LocalGoldSealBrush" Color="{{fc-gold-seal}}" />
    <SolidColorBrush x:Key="LocalMagentaBrush" Color="{{fc-magenta}}" />
    <SolidColorBrush x:Key="LocalTangerineBrush" Color="{{fc-tangerine}}" />
    <SolidColorBrush x:Key="LocalDeckleRimBrush" Color="{{fc-deckle-rim}}" />
    <SolidColorBrush x:Key="LocalCharcoalBrush" Color="{{fc-charcoal}}" />
    <SolidColorBrush x:Key="LocalInkDeepBrush" Color="{{fc-ink}}" />

    <!-- State Brushes: Seafoam-Mint bookmark selection, Emerald menu highlights, Confetti Cobalt running -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{fc-mint-select}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{fc-mint-bright}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{fc-mat-teal}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{fc-ink-on-mint}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{fc-mint-wash}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{fc-mint-select}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{fc-emerald}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{fc-paper-edge}}" />
    <!-- Dedicated Confetti Electric Cobalt running indicator (distinct from Ochre Play, Mint/Emerald Selection, Magenta pip, Crimson danger) -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{fc-cobalt-run}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{fc-focus}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{fc-focus-halo}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{fc-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{fc-paper-bright}}" />

    <!-- Button Brushes: Primary Play CTA is Ochre-Gold construction-paper pill with dark umber ink -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{fc-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{fc-mint-wash}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{fc-paper-fold}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{fc-paper-edge}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{fc-ochre}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{fc-ochre-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{fc-ochre-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{fc-ochre-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{fc-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{fc-gold-seal}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{fc-paper-edge}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{fc-mint-wash}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{fc-paper-fold}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{fc-emerald}}" />

    <!-- Input & Control Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{fc-paper-edge}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{fc-cerulean}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{fc-ink-muted}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{fc-emerald}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{fc-emerald-hi}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{fc-paper-shadow}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{fc-tangerine}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{fc-ink}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{fc-tangerine}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{fc-sky-ribbon}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{fc-paper-fold}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{fc-cardstock-grey}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{fc-mat-teal}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{fc-paper-fold}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{fc-cardstock-grey}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{fc-mat-teal}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{fc-ink-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{fc-ink}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{fc-mint-wash}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{fc-paper-fold}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{fc-cerulean}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{fc-emerald}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{fc-charcoal-hi}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{fc-rail-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{fc-ink}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{fc-mint-bright}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{fc-paper-bright}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{fc-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{fc-ochre}}" />
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{fc-tangerine}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{fc-cerulean-link}}" />
</ResourceDictionary>
