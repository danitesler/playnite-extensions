<!--
    Foldcraft: Views/Library.xaml. Warm fibrous construction-paper workspace (#EFECE4) with subtle 5%
    paper pulp texture (hidden on window art).
    Window background (src/themes/AGENTS.md): PART_ImageBackground renders at full strength with no theme
    scrim, tint, mask, opacity or blur; top-aligned with a soft bottom fade into WindowArtSwatch.
    The art layer spans TopPanel and reaches under the 44px gridded cutting-mat Sidebar rail.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid Background="{TemplateBinding Background}"
                          d:DesignWidth="1500" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <!-- Layered handmade paper-fiber tooth & unfolded blueprint fold net (hidden on window art) -->
                        <Grid Grid.Row="1" IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Control Template="{DynamicResource LocalPaperFibersTemplate}"
                                     Foreground="{DynamicResource PanelShadowBrush}" Opacity="0.16"
                                     Focusable="False" IsHitTestVisible="False" />
                            <Control Template="{DynamicResource LocalBlueprintFoldsTemplate}"
                                     Foreground="{DynamicResource TextBrushDarker}" Opacity="0.11"
                                     Focusable="False" IsHitTestVisible="False" />
                            <!-- Bottom-right Tearaway layered origami corner fold collage -->
                            <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="0" Height="0" IsHitTestVisible="False">
                                <Path Canvas.Left="-210" Canvas.Top="-165" Data="M 210,165 L 210,18 L 62,165 Z"
                                      Fill="{DynamicResource SelectedBrush}" Opacity="0.4" />
                                <Path Canvas.Left="-164" Canvas.Top="-130" Data="M 164,130 L 164,10 L 44,130 Z"
                                      Fill="{DynamicResource LocalCeruleanBrush}" Opacity="0.3" />
                                <Path Canvas.Left="-116" Canvas.Top="-94" Data="M 116,94 L 116,6 L 26,94 Z"
                                      Fill="{DynamicResource PrimaryButtonBackgroundBrush}" Opacity="0.36" />
                                <Path Canvas.Left="-68" Canvas.Top="-58" Data="M 68,58 L 68,4 L 14,58 Z"
                                      Fill="{DynamicResource LocalMagentaBrush}" Opacity="0.28" />
                                <Control Canvas.Left="-98" Canvas.Top="-98" Width="56" Height="56"
                                         Template="{DynamicResource BrandMarkTemplate}"
                                         Foreground="{DynamicResource TextBrushDarker}" Opacity="0.09"
                                         Focusable="False" IsHitTestVisible="False" />
                            </Canvas>
                        </Grid>

                        <!-- Full-strength window background art spanning top bar and reaching under the 44px rail -->
                        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Margin" Value="-44,0,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                                            <Setter Property="Margin" Value="0,0,-44,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                                            <Setter Property="Margin" Value="0,-56,0,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                                            <Setter Property="Margin" Value="0,0,0,-56" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border x:Name="WindowArtSwatch" Background="{DynamicResource ContentBackgroundBrush}" Visibility="Collapsed" />
                            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Top" IsHitTestVisible="False">
                                <FadeImage x:Name="PART_ImageBackground" VerticalAlignment="Top" HorizontalAlignment="Center" />
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.55" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=WindowArtSwatch}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Grid>

                        <TopPanel DockPanel.Dock="Top" Grid.Row="0" />

                        <DockPanel Grid.Row="1">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}" />

                            <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                           DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}" />

                            <Grid DockPanel.Dock="Left">
                                <LibraryDetailsView x:Name="PART_ViewDetails" />
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
