<!--
    Foldcraft: Views/Sidebar.xaml. 44px gridded self-healing cutting-mat teal rail (#0B5853)
    with etched 64x64 cutting-mat grid mask (#25B5AD), Paper White Origami Seal MainMenuButton
    tile (hover -> Ochre-Gold), bottom angled papercraft paper-strip fan accent, and crisp
    teal/shadow seam rule. Turns Transparent when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid ClipToBounds="True">
                            <!-- Etched self-healing cutting-mat grid (hidden on window art) -->
                            <Control x:Name="MatGrid" Template="{DynamicResource LocalCuttingMatGridTemplate}"
                                     Foreground="{DynamicResource LocalMatGridBrush}" Opacity="0.18"
                                     Focusable="False" IsHitTestVisible="False" />

                            <!-- Decorative 4-strip construction paper swatch fan anchored bottom-left -->
                            <Canvas x:Name="PaperFan" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Width="44" Height="56" IsHitTestVisible="False">
                                <Border Canvas.Left="6" Canvas.Top="14" Width="28" Height="7" CornerRadius="1"
                                        Background="{DynamicResource LocalMagentaBrush}">
                                    <Border.RenderTransform><RotateTransform Angle="-16" /></Border.RenderTransform>
                                </Border>
                                <Border Canvas.Left="6" Canvas.Top="24" Width="28" Height="7" CornerRadius="1"
                                        Background="{DynamicResource PrimaryButtonBackgroundBrush}">
                                    <Border.RenderTransform><RotateTransform Angle="-10" /></Border.RenderTransform>
                                </Border>
                                <Border Canvas.Left="6" Canvas.Top="34" Width="28" Height="7" CornerRadius="1"
                                        Background="{DynamicResource LocalCeruleanBrush}">
                                    <Border.RenderTransform><RotateTransform Angle="-4" /></Border.RenderTransform>
                                </Border>
                                <Border Canvas.Left="6" Canvas.Top="44" Width="28" Height="7" CornerRadius="1"
                                        Background="{DynamicResource LocalMintBrightBrush}">
                                    <Border.RenderTransform><RotateTransform Angle="2" /></Border.RenderTransform>
                                </Border>
                            </Canvas>

                            <DockPanel x:Name="DockContentHolder">
                                <!-- Main Menu Origami Seal Tile -->
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="50" Margin="0,0,0,4"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Border x:Name="MenuTile" Margin="5,7" Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                                            <Grid ClipToBounds="True">
                                                <Border x:Name="MenuHoverWash" Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                                                        Visibility="Collapsed" Opacity="0" />
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Top" Width="6" Height="6" Stretch="Fill"
                                                      Data="M 0,0 L 6,0 L 6,6 Z" Fill="{DynamicResource LocalGoldSealBrush}" />
                                            </Grid>
                                        </Border>
                                        <!-- Accordion mark (LocalFoldcraftMenuMarkTemplate): pleats stretch on hover, fold into an envelope while open.
                                             It sits beside the tile, not inside it, so its nearest Border is PART_ElemMainMenu (menu-open state). -->
                                        <Control x:Name="MenuMark" Padding="11,14"
                                                 Template="{DynamicResource LocalFoldcraftMenuMarkTemplate}"
                                                 Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                 Focusable="False" IsTabStop="False" />
                                    </Grid>
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>

                            <!-- Matte cyan grid rim + shadow rule closing the rail edge -->
                            <Grid x:Name="EdgeRule" Width="3" HorizontalAlignment="Right" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                <Rectangle Width="1.5" HorizontalAlignment="Left" Fill="{DynamicResource LocalMatGridBrush}" Opacity="0.35" />
                                <Rectangle Width="1.5" HorizontalAlignment="Right" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MatGrid" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PaperFan" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" TargetName="MenuMark" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverWash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverWash" Storyboard.TargetProperty="Opacity" To="0.96" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="MenuHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverWash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverWash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,136,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PaperFan" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PaperFan" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
