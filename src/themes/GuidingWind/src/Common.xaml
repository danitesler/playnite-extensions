<!--
    Guiding Wind: spacing, focus and shared Japanese ink/Sayagata motifs. Measurements: ../RESEARCH.md.
      InkPlateTemplate       9-slice sumi-e dry-brush plate (Images/fx/brush-plate.png 256x64, caps 32x12 drawn at 14x6)
      GlowFrameTemplate      9-slice soft aura bloom (Images/fx/bloom.png 320x112, corners 28 drawn at 14)
      DividerTemplate        location-banner diamond-flanked hairline rule
      GrainTemplate          seamless mulberry washi paper fiber tile (Images/fx/washi-grain.png 256x256)
      BrandMarkTemplate      Guiding Wind swirling wind-eddy kamon enclosing a nested diamond seal
      SteamScreenshotsSkeletonTemplate  pulsing placeholder for Steam Screenshots
      EmptyGameTemplate      Guiding Wind kamon crest over gently drifting wind wisps + LOCErrorNoGameSelected
    Sprites in Images/fx/ are white masks filled with theme brushes so ThemeModifier recolors them.
    No fixed desired width >= 200 inside templates (Statistics cards stay compact).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">12,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">12,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">268</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- 9-slice dry-brush plate (Images/fx/brush-plate.png, 256x64, caps 32x12 drawn at 14x6). Host Background = ink. -->
    <ControlTemplate x:Key="InkPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
                <RowDefinition Height="6" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/brush-plate.png'}" Viewbox="0,0,32,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/brush-plate.png'}" Viewbox="32,0,192,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/brush-plate.png'}" Viewbox="224,0,32,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/brush-plate.png'}" Viewbox="0,12,32,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/brush-plate.png'}" Viewbox="32,12,192,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/brush-plate.png'}" Viewbox="224,12,32,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/brush-plate.png'}" Viewbox="0,52,32,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/brush-plate.png'}" Viewbox="32,52,192,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/brush-plate.png'}" Viewbox="224,52,32,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- 9-slice soft aura bloom (Images/fx/bloom.png, 320x112, pad 28 drawn at 14). Host Foreground = glow. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,0,28,28" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="28,0,264,28" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="292,0,28,28" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,28,28,56" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="28,28,264,56" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="292,28,28,56" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="0,84,28,28" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="28,84,264,28" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/bloom.png'}" Viewbox="292,84,28,28" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Diamond-flanked feathered hairline rule (hud-2 Traveler's Rest Inn). Compact, no desired width. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="12" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center">
                <Path Data="M5,0 L10,5 L5,10 L0,5 Z M5,2.2 L2.2,5 L5,7.8 L7.8,5 Z" Fill="{TemplateBinding Foreground}" />
                <Path Data="M5,3.5 L6.5,5 L5,6.5 L3.5,5 Z" Fill="{DynamicResource GlyphBrush}" />
            </Grid>
            <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#66000000" Offset="0.65" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Washi mulberry paper fiber tile (Images/fx/washi-grain.png 256x256). Host Foreground + Opacity. -->
    <ControlTemplate x:Key="GrainTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/washi-grain.png'}" TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource IconMainMenu}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Corner brackets, arm 8, 2px for keyboard focus. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,8 L0,0 8,0 8,2 2,2 2,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L8,0 8,8 6,8 6,2 0,2Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L2,0 2,6 8,6 8,8 0,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M6,0 L8,0 8,8 0,8 0,6 6,6Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBoxFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Steam Screenshots loading placeholder: breathes calmly while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel x:Name="Root" IsHitTestVisible="False" Opacity="0.4">
            <Border Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Grid.Column="2" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="4" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="6" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="8" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}" />
            </Grid>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Breathe">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0.45" To="0.95" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Breathe" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- EmptyGameTemplate: swirling Guiding Wind kamon seal over drifting wind wisps and diamond rule.
         Animation runs strictly while visible via ControlTemplate.Triggers (named Transform, no Style trigger Transform). -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Grid Width="260" Height="130" HorizontalAlignment="Center" ClipToBounds="True">
                <Canvas Width="260" Height="130" IsHitTestVisible="False" Opacity="0.45">
                    <Rectangle x:Name="WindStrip" Canvas.Left="0" Canvas.Top="-15" Width="640" Height="160" Fill="{TemplateBinding BorderBrush}">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="WindShift" X="0" />
                        </Rectangle.RenderTransform>
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{ThemeFile 'Images/fx/wind-wisps.png'}" TileMode="Tile" Viewport="0,0,320,160" ViewportUnits="Absolute" Stretch="Fill" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Canvas>
                <Ellipse x:Name="WindRingOuter" Width="108" Height="108" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{TemplateBinding Foreground}" StrokeThickness="1" StrokeDashArray="4 6" Opacity="0.38" />
                <Ellipse x:Name="WindRingInner" Width="88" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{DynamicResource HeadingMarkerBrush}" StrokeThickness="1" StrokeDashArray="12 4 2 4" Opacity="0.65" />
                <Control x:Name="Seal" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Template="{DynamicResource BrandMarkTemplate}" Foreground="{TemplateBinding Foreground}" Opacity="0.82" Focusable="False" />
            </Grid>
            <Grid Width="220" Margin="0,6,0,10" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0.38" />
                <Path Grid.Column="1" Margin="8,0" Width="8" Height="8" Stretch="Fill" Data="M4,0 L8,4 L4,8 L0,4 Z" Fill="{DynamicResource GlyphBrush}" />
                <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0.38" />
            </Grid>
            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center"
                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                       FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" Opacity="0.85" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyWindLoop">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="WindShift" Storyboard.TargetProperty="X" From="0" To="-320" Duration="0:0:9" />
                            <DoubleAnimation Storyboard.TargetName="WindRingOuter" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="40" Duration="0:0:18" />
                            <DoubleAnimation Storyboard.TargetName="WindRingInner" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-44" Duration="0:0:14" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Seal" Storyboard.TargetProperty="Opacity" Duration="0:0:3.6">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.72" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyWindLoop" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
