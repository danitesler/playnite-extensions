<!--
    Guiding Wind: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared vocabulary (scripts/data/theme-keys.json); each placeholder names the gt token that plays
    the key's role. Theme XAML reads brushes only, never Color keys.
    Light misty-washi theme with sumi-black top chrome, dry-brush crimson selections, dark Sayagata lacquer
    metadata inspector with antique gold accents, and firefly-jade running/launching states.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: clean geometric caps for headings and buttons (Sora, bundled), humanist body (Segoe UI, ships with Windows). -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">28</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:gt-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Sora, {{text:gt-font-heading|Sora}}, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:gt-font-mono|Consolas}}</FontFamily>

    <!-- Usable metadata content width; applied inside the pane's horizontal padding and border. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: sharp 2px architectural corners paired with 9-slice dry-brush masks. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:gt-radius|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:gt-radius-small|1}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:gt-radius-large|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:gt-radius-xlarge|6}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{gt-ink}}</Color>
    <Color x:Key="TextColorDarker">{{gt-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{gt-washi}}</Color>
    <Color x:Key="MainColor">{{gt-mist-lo}}</Color>
    <Color x:Key="MainColorDark">{{gt-mist-hi}}</Color>
    <Color x:Key="HoverColor">{{gt-mist-lo}}</Color>
    <Color x:Key="GlyphColor">{{gt-crimson-aa}}</Color>
    <Color x:Key="HighlightGlyphColor">{{gt-crimson}}</Color>
    <Color x:Key="PopupBackgroundColor">{{gt-mist-hi}}</Color>
    <Color x:Key="PopupBorderColor">{{gt-sayagata-rim}}</Color>
    <Color x:Key="BackgroundToneColor">{{gt-mist-hi}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{gt-mist-line}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{gt-mist-line}}</Color>
    <Color x:Key="DataChangeNotifColor">{{gt-gold-mark}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{gt-mist-edge}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{gt-sayagata}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{gt-mist-hi}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{gt-mist-hi}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <!-- Running game: Firefly jade (#137a43), distinct from sumi/crimson Play, crimson selection and gold filter/metadata markers. -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{gt-firefly}}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{gt-firefly}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{gt-crimson-aa}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{gt-gold-ink}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{gt-gold-mark}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{gt-mist-lo}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{gt-mist}}" />

    <!-- Shell and surfaces -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{gt-sumi}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{gt-mist}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{gt-sumi}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{gt-mist}}" />
    <!-- Banner darkening color (ThemeModifier): misty washi paper so darkened banners veil into fog rather than black. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{gt-mist}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{gt-sumi}}" />
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{gt-washi}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{gt-sayagata}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{gt-sayagata-chip}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{gt-sayagata}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{gt-washi}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{gt-sayagata-fret}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{gt-sayagata-chip}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{gt-tab-bot}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{gt-mist-plate}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{gt-ink-deep}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{gt-crimson-lit}}" />

    <!-- States and selection -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{gt-crimson-aa}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{gt-crimson}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{gt-gold-bright}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{gt-washi}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{gt-mist-lo}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{gt-crimson-aa}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{gt-mist-lo}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{gt-crimson-aa}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{gt-gold/55}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{gt-crimson-deep}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{gt-washi}}" />

    <!-- Buttons: crisp keycaps and sumi brush slabs -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{gt-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{gt-ink-deep}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{gt-washi}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{gt-mist-edge}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{gt-washi}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{gt-mist-plate}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{gt-brush-dark}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{gt-sayagata-rim}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{gt-crimson-aa}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{gt-crimson-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{gt-washi}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{gt-crimson-lit}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{gt-sayagata}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{gt-sayagata-rim}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{gt-sayagata-chip}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{gt-sumi}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{gt-crimson-aa}}" />

    <!-- Inputs and controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{gt-mist-hi}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{gt-washi}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{gt-mist-edge}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{gt-ink}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{gt-ink-muted}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{gt-crimson-aa}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{gt-crimson}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{gt-mist-edge}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{gt-ink-deep}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{gt-crimson-aa}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{gt-crimson-aa}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{gt-sayagata-chip}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{gt-gold-bright}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{gt-scroll-thumb}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{gt-ink}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{gt-mist-line}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{gt-scroll-thumb}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{gt-ink}}" />

    <!-- Tabs, covers, headers, Sayagata inspector -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{gt-ink-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{gt-ink-deep}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{gt-crimson-aa}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{gt-mist-edge}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{gt-crimson-aa}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{gt-gold-bright}}" />

    <!-- Dark Sayagata metadata card mapped via Parchment* shared keys -->
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{gt-sayagata}}" />
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{gt-sayagata-rim}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{gt-washi}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{gt-gold-bright}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{gt-gold}}" />
    <SolidColorBrush x:Key="ParchmentLinkBrush" Color="{{gt-gold-bright}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{gt-sayagata-chip}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{gt-washi}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{gt-crimson-aa}}" />

    <!-- Headings, banners, frames, menus, tooltips -->
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{gt-ink-banner}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{gt-washi}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{gt-ink-deep}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{gt-gold}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{gt-ink-deep}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{gt-ink}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{gt-sayagata-rim}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{gt-sayagata-fret}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{gt-gold}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{gt-tab-bot}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{gt-tab-top}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{gt-mist-line}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{gt-washi}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{gt-gold-deep}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{gt-sumi}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{gt-washi}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{gt-gold-ink}}" />
</ResourceDictionary>
