<!--
    Guiding Wind: GridViewItemTemplate. Cover content with PART_PanelHost, PART_ImageCover, PART_ButtonPlay,
    and PART_ButtonInfo. Square keycap buttons rise 8px with BackEase (50ms stagger) over a bottom scrim on hover.
    Game title switches to WindowArtForegroundBrush when ShowBackgroundImageOnWindow=True. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- GridTileButton (Info): a wind-eddy medallion. A round Sayagata disc inside a dashed gold ring (the crest's double circle); hover lights the
         crimson dry-brush plate and the ring turns an eighth of a lap. GridTilePlayButton below is the nested diamond seal. -->
    <Style x:Key="GridTileButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Ring" Margin="1" StrokeThickness="1" StrokeDashArray="2 3" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"
                                 Stroke="{DynamicResource GridViewItemSelectedBorderBrush}">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="RingTurn" Angle="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Plate" Margin="5" StrokeThickness="1"
                                 Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" />
                        <Ellipse x:Name="Eddy" Margin="11" StrokeThickness="1" Opacity="0.5" IsHitTestVisible="False"
                                 Stroke="{DynamicResource ParchmentLabelBrush}" />
                        <ContentControl x:Name="Glyph" Content="{TemplateBinding Content}"
                                        ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Width="16" Height="16" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource SelectedBrush}" />
                            <Setter TargetName="Plate" Property="Stroke" Value="{DynamicResource SelectedBorderBrush}" />
                            <Setter TargetName="Eddy" Property="Opacity" Value="0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="EddyIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingTurn" Storyboard.TargetProperty="Angle" To="45" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="EddyIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Plate" Property="Fill" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GridTilePlayButton: the nested diamond seal from the crest. A sumi-lacquer square stood on its corner with a gold inner diamond; hover
         floods it crimson, lights the gold rim and stamps it (scale 1.08 with a short overshoot); press sinks the seal. -->
    <Style x:Key="GridTilePlayButton" TargetType="Button" BasedOn="{StaticResource GridTileButton}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="False">
                        <Grid Width="34" Height="34" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SealScale" ScaleX="1" ScaleY="1" />
                                    <RotateTransform Angle="45" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="Seal" BorderThickness="1" CornerRadius="1"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                            <Border x:Name="SealRim" Margin="4" BorderThickness="1" Opacity="0.55"
                                    BorderBrush="{DynamicResource ParchmentLabelBrush}" />
                        </Grid>
                        <ContentControl Content="{TemplateBinding Content}" ContentTemplate="{DynamicResource IconTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Width="18" Height="18" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Seal" Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="Seal" Property="BorderBrush" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                            <Setter TargetName="SealRim" Property="Opacity" Value="0.95" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SealIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SealScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SealScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="SealIn" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Seal" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="{DynamicResource GridItemBackgroundBrush}">
                        <StackPanel Name="PART_PanelHost"
                                    Width="{Settings GridItemWidth}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}" ClipToBounds="True">
                                <Border Background="{DynamicResource ExpanderBackgroundBrush}"
                                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" />
                                <Image Name="PART_ImageCover"
                                       StretchDirection="Both"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="{Settings CoverArtStretch}" />
                                <Border x:Name="FallbackName" Visibility="Collapsed" Background="{DynamicResource ParchmentBrush}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                                        <Control Width="32" Height="32" Margin="0,0,0,8"
                                                 Template="{DynamicResource BrandMarkTemplate}"
                                                 Foreground="{DynamicResource ParchmentLabelBrush}"
                                                 Opacity="0.65" Focusable="False" IsHitTestVisible="False" />
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeSmall}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource ParchmentTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Rectangle x:Name="Shade" Opacity="0" IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.3" />
                                            <GradientStop Color="#DD070707" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0">
                                    <Button Name="PART_ButtonPlay" Style="{StaticResource GridTilePlayButton}" Margin="0,0,5,0"
                                            Content="{DynamicResource IconPlay}" Opacity="0" IsHitTestVisible="False">
                                        <Button.RenderTransform>
                                            <TranslateTransform x:Name="PlayShift" Y="8" />
                                        </Button.RenderTransform>
                                    </Button>
                                    <Button Name="PART_ButtonInfo" Style="{StaticResource GridTileButton}" Margin="5,0,0,0"
                                            Content="{DynamicResource IconInfo}" Opacity="0" IsHitTestVisible="False">
                                        <Button.RenderTransform>
                                            <TranslateTransform x:Name="InfoShift" Y="8" />
                                        </Button.RenderTransform>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="GridGameTitle"
                                       Text="{Binding DisplayName}"
                                       FontSize="{DynamicResource FontSize}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Padding="4,6,4,4"
                                       Width="{Settings GridItemWidth}"
                                       Visibility="{Settings ShowNamesUnderCovers}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter TargetName="PART_ButtonPlay" Property="Content" Value="{DynamicResource IconDownload}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="FallbackName" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_ButtonPlay" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="PART_ButtonInfo" Property="IsHitTestVisible" Value="True" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                    <DoubleAnimation Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="PlayShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.05" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="InfoShift" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.05" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard FillBehavior="Stop">
                                    <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="PART_ButtonPlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="PART_ButtonInfo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="PlayShift" Storyboard.TargetProperty="Y" To="8" Duration="0:0:0.16" />
                                    <DoubleAnimation Storyboard.TargetName="InfoShift" Storyboard.TargetProperty="Y" To="8" Duration="0:0:0.16" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
