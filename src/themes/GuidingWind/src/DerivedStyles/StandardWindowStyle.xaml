<!--
    Guiding Wind: StandardWindowStyle (Settings, Add-ons, Edit Game dialogs).
    44px pure sumi-black title band with subtle Sayagata lattice, Guiding Wind kamon crest, uppercase Sora
    display title (keeps PART_TextTitle inside Collapsed Border, uses LOCSettingsLabel for WindowSettings),
    and 1px gold hairline rule above misty washi paper canvas. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome ResizeBorderThickness="5" CaptionHeight="44" CornerRadius="0" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource FrameBrush}" Background="{TemplateBinding Background}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Margin" Value="8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="{DynamicResource WindowTitleBackgroundBrush}" ClipToBounds="True">
                                <Rectangle Fill="{DynamicResource FrameInnerBrush}" Opacity="0.45" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/sayagata.png'}" TileMode="Tile" Viewport="0,0,72,72" ViewportUnits="Absolute" Stretch="Fill" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Control Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,64,0"
                                         Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource HeadingMarkerBrush}"
                                         Opacity="0.08" IsHitTestVisible="False" Focusable="False" />
                                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource TooltipBorderBrush}" IsHitTestVisible="False" />

                                <Border Visibility="Collapsed">
                                    <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}" />
                                </Border>
                                <DockPanel VerticalAlignment="Stretch" Margin="14,0,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button x:Name="PART_ButtonMinimize" Style="{DynamicResource WindowBarButton}" Content="0" />
                                        <Button x:Name="PART_ButtonMaximize" Style="{DynamicResource WindowBarButton}" Content="1" />
                                        <Button x:Name="PART_ButtonClose" Style="{DynamicResource WindowBarButton}" Content="r" />
                                    </StackPanel>
                                    <DockPanel VerticalAlignment="Center">
                                        <Control DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,10,0"
                                                 Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource ParchmentTitleBrush}"
                                                 Focusable="False" IsHitTestVisible="False" />
                                        <TextBlock x:Name="DisplayTitle"
                                                   Text="{Binding Text, ElementName=PART_TextTitle, Converter={StaticResource StringToUpperCaseConverter}}"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}"
                                                   FontWeight="Bold" Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DockPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Control Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource HeadingForegroundBrush}"
                                         Opacity="0.03" IsHitTestVisible="False" Focusable="False" />
                                <AdornerDecorator>
                                    <ContentPresenter />
                                </AdornerDecorator>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource Self}}" Value="WindowSettings">
                            <Setter TargetName="DisplayTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </DataTrigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="PART_ButtonMinimize" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_ButtonMaximize" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="PART_ButtonMaximize" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_ButtonMaximize" Property="Content" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
