<!--
    Guiding Wind: FilterPanelView (dockable sidebar filter panel). Clean misty-washi background turning transparent
    under ShowBackgroundImageOnWindow=True (switching filter labels & checkboxes to WindowArtForegroundBrush),
    1px WindowPanelSeparatorBrush edge, 28px filter controls & preset actions, and Playnite's exact PART_ names
    and FilterPanel* style keys. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="FilterPanelCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="16,2,16,8" />
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
            <Trigger Property="IsChecked" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Margin" Value="16,12,16,6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
            <Trigger Property="Tag" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelFilterSearchBox" TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="16,0,16,0" />
        <Setter Property="ShowImage" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border Style="{DynamicResource HighlightBorder}" Background="{TemplateBinding Background}">
                        <Grid>
                            <ContentControl x:Name="PART_SeachIcon" ContentTemplate="{DynamicResource SearchTextIconTemplate}" Visibility="Collapsed" />
                            <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}" MinHeight="0"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="6,0,28,0" />
                            <ContentControl x:Name="PART_ClearTextIcon" ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterPanelFilterSelectionBox" TargetType="FilterSelectionBox" BasedOn="{StaticResource {x:Type FilterSelectionBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <Style x:Key="FilterPanelFilterEnumSelectionBox" TargetType="FilterEnumSelectionBox" BasedOn="{StaticResource {x:Type FilterEnumSelectionBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <Style x:Key="FilterPanelFilterStringSelectionBox" TargetType="FilterStringSelectionBox" BasedOn="{StaticResource {x:Type FilterStringSelectionBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="16,0,16,0" />
    </Style>

    <Style x:Key="FilterPresetButtonAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="3,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type FilterPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPanel}">
                    <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" d:DesignWidth="200">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings FilterPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <DockPanel Margin="12,12,12,8" DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                                        Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0"
                                        Style="{StaticResource SimpleButton}"
                                        Name="PART_ButtonClose" ToolTip="{DynamicResource LOCCloseLabel}">
                                    <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                      Content="{DynamicResource IconClear}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button DockPanel.Dock="Left" Content="{DynamicResource LOCClearFilters}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Style="{StaticResource SimpleButton}"
                                        Name="PART_ButtonClear" />
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,0,16,12">
                                <Button Width="28" MinWidth="28" MaxWidth="28" Padding="0" Height="28" MinHeight="0" MaxHeight="28"
                                        x:Name="PART_ButtonDeleteFilter" Style="{DynamicResource FilterPresetButtonAction}"
                                        ToolTip="{DynamicResource LOCRemoveFilterPreset}">
                                    <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                      Content="{DynamicResource IconRemove}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button Width="28" MinWidth="28" MaxWidth="28" Padding="0" Height="28" MinHeight="0" MaxHeight="28"
                                        x:Name="PART_ButtonRenameFilter" Style="{DynamicResource FilterPresetButtonAction}"
                                        ToolTip="{DynamicResource LOCRenameFilterPreset}">
                                    <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                      Content="{DynamicResource IconEdit}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button Width="28" MinWidth="28" MaxWidth="28" Padding="0" Height="28" MinHeight="0" MaxHeight="28"
                                        x:Name="PART_ButtonSaveFilter" Style="{DynamicResource FilterPresetButtonAction}"
                                        ToolTip="{DynamicResource LOCSaveFilterPreset}">
                                    <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                      Content="{DynamicResource IconFilterPresets}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <ComboBox Height="28" MinHeight="0" x:Name="PART_ComboFilterPresets"
                                          DockPanel.Dock="Left" VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          DockPanel.Dock="Top" Padding="0,0,0,16">
                                <StackPanel x:Name="PART_PanelItemsHost" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
