<Grid x:Name="PART_ElemAdded" VerticalAlignment="Top"><Grid.Width><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 900 ? Max(0, (x - 48) / 3) : (x &gt;= 560 ? Max(0, (x - 24) / 2) : x)" /></Grid.Width><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,3,0,3" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,3,24,3" /></DataTrigger></Style.Triggers></Style></Grid.Style>
