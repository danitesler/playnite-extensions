<!--
    Guiding Wind: Expander (grouped game list headers). Uses transparent header wash and switches foreground to
    WindowArtForegroundBrush under ShowBackgroundImageOnWindow=True so group headers read clearly over window art.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="LocalExpanderHeaderFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LocalExpanderToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource LocalExpanderHeaderFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="HeaderBar"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="True">
                            <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path x:Name="CollapsedArrow" Width="7" Height="9" Stretch="Fill"
                                      Data="M0,0 L7,4.5 L0,9 Z" Fill="{DynamicResource GlyphBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="ExpandedArrow" Visibility="Collapsed" Width="9" Height="7" Stretch="Fill"
                                      Data="M0,0 L9,0 L4.5,7 Z" Fill="{DynamicResource GlyphBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CollapsedArrow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ExpandedArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter TargetName="HeaderBar" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBar" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ToggleButton x:Name="HeaderSite"
                                      DockPanel.Dock="Top"
                                      Style="{StaticResource LocalExpanderToggleStyle}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      MinHeight="32" />
                        <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                          Margin="{TemplateBinding Padding}" Focusable="False" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
