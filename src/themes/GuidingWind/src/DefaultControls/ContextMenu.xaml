<!--
    Guiding Wind: ContextMenu. Every menu and dropdown list (the hamburger menu, the top bar dropdowns through
    TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select
    boxes) is a sheet of misty washi crowned like the game's menus:
    - Panel (LocalWashiSheetTemplate, shared by Menu.xaml's submenus, ComboBox.xaml, CustomControls/ComboBoxList.xaml and
      CustomControls/FilterSelectionBox.xaml): misty washi (PopupBackgroundBrush) with its mulberry fibre grain, a
      1px Sayagata-rim edge, a 3px sumi ink crown across the top and the active tab's 8px crimson corner triangle in
      the top-left corner. Rows sit 8px below the top (under the crown).
    Rows, the sumi brush stroke and the dry-brush group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalWashiSheetTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Control Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource TextBrush}" Opacity="0.05"
                     Margin="1" Focusable="False" IsTabStop="False" />
            <!-- Sumi crown and the active tab's crimson corner -->
            <Border Height="3" VerticalAlignment="Top" Background="{DynamicResource ShellBackgroundBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Path Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill"
                  Data="M 0,0 L 8,0 L 0,8 Z" Fill="{DynamicResource HighlightGlyphBrush}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalWashiSheetTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,8,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="4,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
