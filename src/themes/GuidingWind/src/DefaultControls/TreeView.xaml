<!--
    Guiding Wind: TreeView & TreeViewItem (Settings navigation, Add-ons, filter/explorer trees).
    Minimal bare 28px rows in Segoe UI (docs/themes/settings-screens.md); idle rows sit transparently over mist;
    hover softly washes in mist-lo; selected rows glow with crimson dry-brush ink (InkPlateTemplate), 2px gold
    left accent bar, and warm washi text. Dialog trees reserve a Visible vertical scrollbar lane
    (WindowSettings 250px, WindowExtensions 280px). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
        <Style.Resources>
            <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
                <Setter Property="Tag" Value="GuidingWindNavigationDivider" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </Style.Resources>
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer Focusable="False" Padding="6,8,6,8"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowSettings">
                <Setter Property="Width" Value="250" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowExtensions">
                <Setter Property="Width" Value="280" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Grid x:Name="Row" MinHeight="28" Background="Transparent" Margin="0,0,0,1" SnapsToDevicePixels="True">
                            <Border x:Name="HoverPlate" Background="{DynamicResource ListItemHoverBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <Control x:Name="SelectedPlate" Template="{DynamicResource InkPlateTemplate}"
                                     Background="{DynamicResource SelectedBrush}"
                                     Opacity="0" IsHitTestVisible="False" Focusable="False" />
                            <Rectangle x:Name="SelectedBar" Width="2" HorizontalAlignment="Left" Margin="0,2"
                                       Fill="{DynamicResource SelectedBorderBrush}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="SelectionBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <ToggleButton x:Name="Expander" ClickMode="Press" DockPanel.Dock="Left" Width="14" Height="14"
                                                  Margin="0,0,6,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Style>
                                            <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseStyle}">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                            <Grid Background="Transparent">
                                                                <ContentControl x:Name="IsExpandedPath" Content="{DynamicResource IconSubmenu}"
                                                                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                                                Foreground="{DynamicResource TextBrushDarker}"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <ContentControl x:Name="ExpandPath" Content="{DynamicResource IconDropDown}"
                                                                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                                                Foreground="{DynamicResource GlyphBrush}"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                Visibility="Collapsed" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="ExpandPath" Property="Visibility" Value="Visible" />
                                                                    <Setter TargetName="IsExpandedPath" Property="Visibility" Value="Collapsed" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" Height="Auto" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="MaxWidth" Value="184" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <Border x:Name="ItemsHostBorder" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1,0,0,0" Margin="16,0,0,0">
                            <ItemsPresenter x:Name="ItemsHost" Margin="4,0,0,0" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHostBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="Row">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.12" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard FillBehavior="Stop">
                                    <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Hidden" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                    <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard FillBehavior="Stop">
                                    <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                    <DoubleAnimation Storyboard.TargetName="SelectedBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Header.Tag, RelativeSource={RelativeSource Self}, FallbackValue={x:Null}}" Value="GuidingWindNavigationDivider">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
