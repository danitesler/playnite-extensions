<!--
    Shade: gives Playnite's number boxes the shared field height (ControlHeight), so it lines up with text boxes and buttons.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type LongNumericBox}" BasedOn="{StaticResource {x:Type LongNumericBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="{x:Type UlongNumericBox}" BasedOn="{StaticResource {x:Type UlongNumericBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="{x:Type NullIntNumericBox}" BasedOn="{StaticResource {x:Type NullIntNumericBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="{x:Type DoubleNumericBox}" BasedOn="{StaticResource {x:Type DoubleNumericBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
