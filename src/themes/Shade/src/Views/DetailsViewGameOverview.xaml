                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemVersion" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCVersionLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <Button x:Name="PART_ButtonVersion" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemInstallSize" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCInstallSizeLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <TextBlock x:Name="PART_TextInstallSize" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemInstallDirectory" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCGameInstallDirTitle}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <Button x:Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="MetaLinks" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <DockPanel x:Name="PART_ElemLinks" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCLinksLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <ItemsControl x:Name="PART_ItemsLinks" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </GroupBox>
                            </Grid>
                        </StackPanel>
</Grid>
<!-- Empty state (no game selected), shadcn Empty: a 40px rounded-lg muted tile with a 24px icon over a text-lg medium title, centered in the visible area. It fades in over 150ms (tw-animate fade-in) when it appears; no loop (RemoveStoryboard on exit). -->
<Grid VerticalAlignment="Top" Height="{Binding ViewportHeight, ElementName=PART_ScrollViewHost}">
<Grid.Style>
<Style TargetType="Grid">
<Setter Property="Visibility" Value="Collapsed" />
<Style.Triggers>
<DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
<Setter Property="Visibility" Value="Visible" />
</DataTrigger>
</Style.Triggers>
</Style>
</Grid.Style>
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,24">
<StackPanel.Style>
    <Style TargetType="StackPanel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyFadeIn">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.4,0,0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyFadeIn" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</StackPanel.Style>
<Border Width="40" Height="40" HorizontalAlignment="Center" CornerRadius="{DynamicResource CornerRadiusLarge}" Background="{DynamicResource ButtonBackgroundBrush}">
<Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
