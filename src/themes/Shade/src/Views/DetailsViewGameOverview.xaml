<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details mode, right pane).
    A shadcn/ui page (p-8, max-w-4xl-ish 960px). Page header: the name as the h1 (text-3xl font-bold) with the game
    icon; the actions on the right, aligned to the bottom: Edit (Button secondary, size icon, lucide pencil), More
    (secondary), Play or Install (default, the primary fill). A Separator (my-6) closes it.
    Below, two columns: the description Card (and a Notes Card) on the left, and a 384px Details Card on the right
    that holds every metadata field Playnite can show: 120px label cells in text-muted-foreground font-medium with the
    value beside them, in six groups split by a Separator (my-4): progress (completion status, time played, last
    played, recent activity, added), scores, about (developers, publishers, release date, series, age rating, region),
    tags (platforms, genres, categories, features, tags, as Badges secondary), library (library, source, version,
    install size, install folder) and links. A group whose fields are all hidden takes no space, and neither does
    its Separator.
    The background art is a banner at the top (GameBannerHeight; 0 turns it off and the title moves to the top). No cover. Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible">
                        <Grid x:Name="PageRoot" Background="{DynamicResource WindowBackgourndBrush}">
<!-- Banner: the game's background art as a band at the top. Tinted at the top, darkened toward the title by a page-colored scrim, faded into the page. GameBannerHeight sets the height; 0 turns it off. -->
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
<Grid.Style>
        <Style TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Grid.Style>
<FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
<Border Background="{DynamicResource WindowBackgourndBrush}" Opacity="0.3" />
<!-- No OpacityMask on the banner: masked art repainted in part (behind the animated Play button) left dark patches on scaled displays.
     The fade is a plain gradient to the page color, read from the page brush (PageRoot). -->
<Rectangle>
<Rectangle.Fill>
<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
<GradientStop Color="#00000000" Offset="0.25" />
<GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.95" />
</LinearGradientBrush>
</Rectangle.Fill>
</Rectangle>
</Grid>
<Grid>
<Grid.Style>
<Style TargetType="Grid">
<Style.Triggers>
<DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
<Setter Property="Visibility" Value="Collapsed" />
</DataTrigger>
</Style.Triggers>
</Style>
</Grid.Style>

<StackPanel Margin="24,16,41,32" MaxWidth="960">
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </StackPanel.Resources>
<!-- Room above the title so it sits low on the banner; gone when the banner is off or the game has no art. -->
<Border  IsHitTestVisible="False">
    <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 100 / 320'}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                    <Setter Property="Height" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
</Border>

                            <!-- Page header: title and muted developer line on the left, actions on the right -->
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                    <Grid>
                                        <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                        <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                    </Grid>
                                    <Button x:Name="PART_ButtonMoreActions" Width="36" Height="36" Padding="0" Margin="8,0,0,0"
                                            ToolTip="{DynamicResource LOCMoreAction}">
                                        <ContentPresenter Width="16" Height="16"
                                                          Content="{DynamicResource IconOptions}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                    <Button x:Name="PART_ButtonEditGame" Width="36" Height="36" Padding="0" Margin="8,0,0,0" Focusable="False"
                                            ToolTip="{DynamicResource LOCEditGame}">
                                        <ContentPresenter Width="16" Height="16"
                                                          Content="{DynamicResource IconEdit}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Bottom">
                                    <DockPanel>
                                        <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0"
                                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                        <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </DockPanel>

                            <!-- Separator my-6 -->
                            <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,24" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="240" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library or Steam source games in that gap; give up after 12s so a game without screenshots does not keep an empty block. When the plugin is not installed or is disabled the binding fails, FallbackValue=PluginUnavailable matches neither True nor False, and no skeleton shows. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                            <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                        <MultiDataTrigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                        </MultiDataTrigger.ExitActions>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                            <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                        <MultiDataTrigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                        </MultiDataTrigger.ExitActions>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <GroupBox Header="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}">
                                            <Grid>
                                                <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                    <Control.Style>
                                                        <Style TargetType="Control">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Control.Style>
                                                </Control>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                    <GroupBox x:Name="PART_ElemDescription" Margin="0,24,0,0" Header="{DynamicResource LOCGameDescriptionTitle}">
                                        <HtmlTextView x:Name="PART_HtmlDescription"
                                                      TextElement.Foreground="{DynamicResource TextBrush}"
                                                      Tag="{DynamicResource GlyphBrush}"
                                                      HtmlFontSize="{DynamicResource FontSize}"
                                                      HtmlFontFamily="{DynamicResource FontFamily}"
                                                      HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                      LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                      pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                    </GroupBox>
                                                                        <GroupBox x:Name="PART_ElemNotes" Header="{DynamicResource LOCNotesLabel}" Margin="0,24,0,0">
                                        <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                 Background="{DynamicResource ControlBackgroundBrush}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" />
                                    </GroupBox>
                                </StackPanel>
                                <GroupBox Grid.Column="2" VerticalAlignment="Top" Header="{DynamicResource LOCGameDetails}">
                                    <Border ClipToBounds="True" Width="{DynamicResource GameDetailsPaneWidth}">
                                        <StackPanel Margin="0,-33,0,-8">
                                            <Border x:Name="MetaProgress" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <DockPanel x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCCompletionStatus}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCTimePlayed}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <TextBlock x:Name="PART_TextPlayTime" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCLastPlayed}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <TextBlock x:Name="PART_TextLastActivity" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCRecentActivityLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <TextBlock x:Name="PART_TextRecentActivity" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCDateAddedLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <TextBlock x:Name="PART_TextAdded" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="MetaScores" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <DockPanel x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCCommunityScore}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <TextBlock x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCCriticScore}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <TextBlock x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCUserScore}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <TextBlock x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="MetaAbout" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <DockPanel x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCDevelopersLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <ItemsControl x:Name="PART_ItemsDevelopers" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCPublishersLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <ItemsControl x:Name="PART_ItemsPublishers" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCGameReleaseDateTitle}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCSeriesLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <ItemsControl x:Name="PART_ItemsSeries" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCAgeRatingLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <ItemsControl x:Name="PART_ItemsAgeRatings" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemRegion" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCRegionLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <ItemsControl x:Name="PART_ItemsRegions" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="MetaTags" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <DockPanel x:Name="PART_ElemPlatform" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCPlatformsTitle}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,2,0,-8">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemGenres" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCGenresLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,2,0,-8">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemCategories" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCCategoriesLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <ItemsControl x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,2,0,-8">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemFeatures" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCFeaturesLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <ItemsControl x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,2,0,-8">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemTags" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCTagsLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <ItemsControl x:Name="PART_ItemsTags" Tag="Chip" Margin="0,2,0,-8">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="MetaLibrary" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <DockPanel x:Name="PART_ElemLibrary" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCGameProviderTitle}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                        <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                    </DockPanel>
                                                    <DockPanel x:Name="PART_ElemSource" Margin="0,8,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCSourceLabel}" FontWeight="Medium" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
