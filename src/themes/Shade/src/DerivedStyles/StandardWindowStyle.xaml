<!--
    Shade: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    shadcn's inset layout (sidebar-07) for a dialog: the window frame is the sidebar color, with a 44px header row on it
    (a muted Lucide icon, the title in the body face at semibold, as DialogTitle), and the page below sits on the
    background color as a card whose top corners are rounded-xl: two frame-colored corner masks round them, the way
    MainWindow.xaml rounds the library card. Caption buttons are the 32px ghost icon buttons of WindowBarButton, so the
    caption and the content offset are 44 (Default: 25). PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- The card's rounded top corners: frame-colored masks over the page, fixed 12px so they add no width. -->
                                <Path HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,44,0,0" Width="12" Height="12" IsHitTestVisible="False"
                                      Data="M0,0 H12 A12,12 0 0 0 0,12 Z" Fill="{DynamicResource ShellBackgroundBrush}" />
                                <Path HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,0,0" Width="12" Height="12" IsHitTestVisible="False"
                                      Data="M0,0 H12 V12 A12,12 0 0 0 0,0 Z" Fill="{DynamicResource ShellBackgroundBrush}" />
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource ShellBackgroundBrush}">
                                    <DockPanel LastChildFill="False">
                                        <ContentControl DockPanel.Dock="Left" Width="16" Height="16" Margin="16,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                        Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource TextBrushDarker}" />
                                        <TextBlock Text="{TemplateBinding Title}" DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="440"
                                                   FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,10,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the header shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
