<!--
    Clearwater: Views/MainWindow.xaml.
    Alpine mist canvas hosting the floating 44px Liquid Glass Sidebar, Library workspace, and NotificationPanel.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type MainWindow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MainWindow}">
                    <Border Background="{DynamicResource WindowBackgourndBrush}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="PART_GridMain"
                              d:DesignWidth="1500" d:DesignHeight="960"
                              d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                            <Grid.Resources>
                                <Storyboard x:Key="VisibilityOn">
                                    <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin"
                                                                      Storyboard.TargetName="PART_Notifications">
                                        <SplineThicknessKeyFrame KeyTime="00:00:00" Value="-260,0,0,0" />
                                        <SplineThicknessKeyFrame KeyTime="0:0:0.12" Value="0,0,0,0" />
                                    </ThicknessAnimationUsingKeyFrames>
                                </Storyboard>
                                <Storyboard x:Key="VisibilityOff">
                                    <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin"
                                                                      Storyboard.TargetName="PART_Notifications">
                                        <SplineThicknessKeyFrame KeyTime="00:00:00" Value="0,0,0,0" />
                                        <SplineThicknessKeyFrame KeyTime="0:0:0.12" Value="-260,0,0,0" />
                                    </ThicknessAnimationUsingKeyFrames>
                                </Storyboard>
                            </Grid.Resources>

                            <DockPanel>
                                <Sidebar x:Name="PART_Sidebar" Panel.ZIndex="999"
                                         DockPanel.Dock="{Settings SidebarPosition}" />
                                <ContentControl x:Name="PART_ContentView" />
                            </DockPanel>

                            <NotificationPanel x:Name="PART_Notifications"
                                               WindowChrome.IsHitTestVisibleInChrome="True"
                                               Width="260"
                                               HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                               AnimatedVisibility.Visibility="{Settings NotificationPanelVisible}"
                                               AnimatedVisibility.Visible="{StaticResource VisibilityOn}"
                                               AnimatedVisibility.Collapsed="{StaticResource VisibilityOff}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
