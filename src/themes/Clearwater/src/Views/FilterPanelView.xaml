<!--
    Clearwater: Views/FilterPanelView.xaml.
    Frosted macOS Filter Inspector sidebar: 28px compact filter fields and 28x28 preset buttons.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="LocalFilterPanelClearButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Content">
            <Setter.Value>
                <ContentControl Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconSmallTemplate}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type FilterPanel}">
        <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPanel}">
                    <Border x:Name="PanelRoot" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,1,0"
                            d:DesignWidth="260" d:DesignHeight="700"
                            d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Border.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                <Setter Property="Margin" Value="0,10,0,4" />
                                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                            </Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="Margin" Value="0,6,0,2" />
                            </Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Height" Value="28" />
                                <Setter Property="Padding" Value="8,3" />
                            </Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="Height" Value="28" />
                            </Style>
                            <Style TargetType="FilterSelectionBox" BasedOn="{StaticResource {x:Type FilterSelectionBox}}">
                                <Setter Property="Height" Value="28" />
                            </Style>
                            <Style TargetType="FilterStringSelectionBox" BasedOn="{StaticResource {x:Type FilterStringSelectionBox}}">
                                <Setter Property="Height" Value="28" />
                            </Style>
                            <Style TargetType="SearchBox" BasedOn="{StaticResource {x:Type SearchBox}}">
                                <Setter Property="Height" Value="28" />
                            </Style>
                        </Border.Resources>

                        <DockPanel Margin="10,8,10,10">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource LOCFilters}"
                                           FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0" VerticalAlignment="Center" />
                                <Button x:Name="PART_ButtonClear" Grid.Column="1"
                                        Content="{DynamicResource LOCClearFilters}"
                                        Height="28" Padding="8,2" Margin="0,0,6,0" />
                                <Button x:Name="PART_ButtonClose" Grid.Column="2"
                                        Style="{StaticResource LocalFilterPanelClearButton}" />
                            </Grid>

                            <!-- Presets bar (28px combo + 28x28 icon buttons) -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PART_ComboPresets" Grid.Column="0" Height="28" Margin="0,0,4,0" />
                                <Button x:Name="PART_ButtonSavePreset" Grid.Column="1" Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                                        ToolTip="{DynamicResource LOCSaveLabel}">
                                    <ContentControl Content="{DynamicResource IconAdd}" ContentTemplate="{DynamicResource IconSmallTemplate}" />
                                </Button>
                                <Button x:Name="PART_ButtonRenamePreset" Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0"
                                        ToolTip="{DynamicResource LOCRenameTitle}">
                                    <ContentControl Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconSmallTemplate}" />
                                </Button>
                                <Button x:Name="PART_ButtonDeletePreset" Grid.Column="3" Width="28" Height="28" Padding="0"
                                        ToolTip="{DynamicResource LOCDeleteAction}">
                                    <ContentControl Content="{DynamicResource IconRemove}" ContentTemplate="{DynamicResource IconSmallTemplate}" />
                                </Button>
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,4,12">
                                    <CheckBox x:Name="PART_CheckInstalled" Content="{DynamicResource LOCGameIsInstalledTitle}" />
                                    <CheckBox x:Name="PART_CheckUninstalled" Content="{DynamicResource LOCGameIsUnInstalledTitle}" />
                                    <CheckBox x:Name="PART_CheckHidden" Content="{DynamicResource LOCGameHiddenTitle}" />
                                    <CheckBox x:Name="PART_CheckFavorite" Content="{DynamicResource LOCGameFavoriteTitle}" />

                                    <TextBlock Text="{DynamicResource LOCNameLabel}" />
                                    <SearchBox x:Name="PART_TextName" />

                                    <TextBlock Text="{DynamicResource LOCGamePlatformTitle}" />
                                    <FilterSelectionBox x:Name="PART_FilterPlatform" />

                                    <TextBlock Text="{DynamicResource LOCLibrary}" />
                                    <FilterSelectionBox x:Name="PART_FilterLibrary" />

                                    <TextBlock Text="{DynamicResource LOCGameCategoriesTitle}" />
                                    <FilterSelectionBox x:Name="PART_FilterCategory" />

                                    <TextBlock Text="{DynamicResource LOCGameGenresTitle}" />
                                    <FilterSelectionBox x:Name="PART_FilterGenre" />

                                    <TextBlock Text="{DynamicResource LOCGameTagsTitle}" />
                                    <FilterSelectionBox x:Name="PART_FilterTag" />

                                    <TextBlock Text="{DynamicResource LOCGameSeriesTitle}" />
                                    <FilterSelectionBox x:Name="PART_FilterSeries" />

                                    <TextBlock Text="{DynamicResource LOCGameDeveloperTitle}" />
                                    <FilterSelectionBox x:Name="PART_FilterDeveloper" />

                                    <TextBlock Text="{DynamicResource LOCGamePublisherTitle}" />
                                    <FilterSelectionBox x:Name="PART_FilterPublisher" />

                                    <TextBlock Text="{DynamicResource LOCGameReleaseYearTitle}" />
                                    <FilterStringSelectionBox x:Name="PART_FilterReleaseYear" />

                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" />
                                    <FilterSelectionBox x:Name="PART_FilterCompletionStatus" />

                                    <TextBlock Text="{DynamicResource LOCGameFeaturesTitle}" />
                                    <FilterSelectionBox x:Name="PART_FilterFeature" />

                                    <TextBlock Text="{DynamicResource LOCGameAgeRatingTitle}" />
                                    <FilterSelectionBox x:Name="PART_FilterAgeRating" />

                                    <TextBlock Text="{DynamicResource LOCGameRegionTitle}" />
                                    <FilterSelectionBox x:Name="PART_FilterRegion" />

                                    <TextBlock Text="{DynamicResource LOCGameSourceTitle}" />
                                    <FilterSelectionBox x:Name="PART_FilterSource" />

                                    <TextBlock Text="{DynamicResource LOCPlayTime}" />
                                    <FilterSelectionBox x:Name="PART_FilterPlayTime" />

                                    <TextBlock Text="{DynamicResource LOCGameLastActivityTitle}" />
                                    <FilterSelectionBox x:Name="PART_FilterLastActivity" />

                                    <TextBlock Text="{DynamicResource LOCAddedLabel}" />
                                    <FilterSelectionBox x:Name="PART_FilterAdded" />

                                    <TextBlock Text="{DynamicResource LOCModifiedLabel}" />
                                    <FilterSelectionBox x:Name="PART_FilterModified" />

                                    <TextBlock Text="{DynamicResource LOCUserScore}" />
                                    <FilterSelectionBox x:Name="PART_FilterUserScore" />

                                    <TextBlock Text="{DynamicResource LOCCriticScore}" />
                                    <FilterSelectionBox x:Name="PART_FilterCriticScore" />

                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" />
                                    <FilterSelectionBox x:Name="PART_FilterCommunityScore" />

                                    <TextBlock Text="{DynamicResource LOCVersionLabel}" />
                                    <SearchBox x:Name="PART_TextVersion" />

                                    <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" />
                                    <FilterSelectionBox x:Name="PART_FilterInstallSize" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter TargetName="PanelRoot" Property="Background" Value="Transparent" />
                            <Setter TargetName="PanelRoot" Property="BorderBrush" Value="Transparent" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings FilterPanelPosition}" Value="Right">
                            <Setter TargetName="PanelRoot" Property="BorderThickness" Value="1,0,0,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
