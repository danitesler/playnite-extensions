<!--
    Clearwater: Views/TopPanel.xaml.
    48px Translucent Liquid Glass top toolbar closed by a frosted hairline.
    Order: menu (only when sidebar hidden, hosting LocalClearwaterMenuMarkTemplate),
    search (32px frosted Spotlight pill), filter (8x8 System Orange dot pip, zero text),
    main items (sorting FIRST via Grid column triggers, icon-only view switches),
    notifications, plugin items, 12px optical blue PART_ProgressGlobal;
    108px right clearance for macOS traffic-light MainWindowButtons.
    TopPanelMenu inherits ContextMenu with no template of its own (docs/themes/menus.md).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentControl Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentControl Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentControl Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentControl Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentControl Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentControl Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentControl Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentControl Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}" Foreground="{DynamicResource DataChangeNotifBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentControl Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentControl Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentControl Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>

    <!-- Menus rule: TopPanelMenu inherits ContextMenu with no template of its own -->
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource {x:Type ContextMenu}}" />

    <!-- Filter toggle: 8x8 System Orange circular dot (TextFilter) on icon top-right, zero text label -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="RestPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource LocalGlassButtonGradient}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                IsHitTestVisible="False" />
                        <Border x:Name="HoverPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="ActivePlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource LocalGlassBlueGradient}"
                                BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="1"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <Grid Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl x:Name="FilterGlyph" Content="{DynamicResource IconFilter}"
                                            ContentTemplate="{DynamicResource IconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}" />
                            <Ellipse x:Name="TextFilter" Visibility="Collapsed" IsHitTestVisible="False"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-5,0"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource DataChangeNotifBrush}"
                                     Stroke="{DynamicResource LocalGlassSpecularBrush}" StrokeThickness="1.2" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="ActivePlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="FilterGlyph" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FilterHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="FilterHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter TargetName="RestPlate" Property="Opacity" Value="0.72" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="HoverPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Grid Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl Content="{DynamicResource IconNotifications}"
                                            ContentTemplate="{DynamicResource IconTemplate}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="Badge" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource GlyphBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-5,-6,0" Padding="4,1" MinWidth="16" Height="16"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Api Notifications.Count}" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource SelectedForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="NotifHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="NotifHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Width" Value="244" />
        <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="{DynamicResource LocalGlassBarGradient}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Border x:Name="BarRoot" Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource TopPanelSeparatorBrush}" BorderThickness="0,0,0,1"
                            d:DesignWidth="1280" d:DesignHeight="48"
                            d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid>
                            <Border x:Name="BarSpecular" BorderBrush="{DynamicResource LocalGlassSpecularBrush}"
                                    BorderThickness="0,1,0,0" Opacity="0.88" IsHitTestVisible="False" />

                            <DockPanel Margin="10,0,108,0" LastChildFill="True">
                                <!-- Main menu button: shown only when sidebar is hidden -->
                                <Border x:Name="PART_ElemMainMenu" DockPanel.Dock="Left"
                                        Width="32" Height="32" Margin="0,0,8,0"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{DynamicResource LocalGlassButtonGradient}"
                                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                        Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Settings ShowSidebar}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Control Template="{DynamicResource LocalClearwaterMenuMarkTemplate}"
                                             Focusable="False" IsTabStop="False" />
                                </Border>

                                <!-- 1. Search -->
                                <SearchBox x:Name="PART_TextMainSearch" DockPanel.Dock="Left"
                                           Style="{DynamicResource TopPanelSearchBox}" VerticalAlignment="Center" />

                                <!-- 2. Filter toggle -->
                                <CheckBox x:Name="PART_ToggleFilter" DockPanel.Dock="Left"
                                          Style="{DynamicResource TopPanelFilterToggle}" VerticalAlignment="Center" />

                                <!-- 3. Sorting first + view switches & tools -->
                                <Grid x:Name="PART_PanelMainItems" DockPanel.Dock="Left" HorizontalAlignment="Left"
                                      VerticalAlignment="Center" Margin="6,0,0,0" Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="{x:Type TopPanelItem}" BasedOn="{StaticResource {x:Type TopPanelItem}}">
                                            <Style.Triggers>
                                                <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSortSettingsTemplate}">
                                                    <Setter Property="Grid.Column" Value="0" />
                                                </Trigger>
                                                <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSearchButtonTemplate}">
                                                    <Setter Property="Grid.Column" Value="1" />
                                                </Trigger>
                                                <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGeneralViewSettingsTemplate}">
                                                    <Setter Property="Grid.Column" Value="2" />
                                                </Trigger>
                                                <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelFilterPresetsSelectionTemplate}">
                                                    <Setter Property="Grid.Column" Value="3" />
                                                </Trigger>
                                                <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelGroupSettingsTemplate}">
                                                    <Setter Property="Grid.Column" Value="4" />
                                                </Trigger>
                                                <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelExplorerSwitchTemplate}">
                                                    <Setter Property="Grid.Column" Value="5" />
                                                </Trigger>
                                                <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchDetailsViewTemplate}">
                                                    <Setter Property="Grid.Column" Value="6" />
                                                </Trigger>
                                                <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchGridViewTemplate}">
                                                    <Setter Property="Grid.Column" Value="7" />
                                                </Trigger>
                                                <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSwitchListViewTemplate}">
                                                    <Setter Property="Grid.Column" Value="8" />
                                                </Trigger>
                                                <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelUpdateButtonTemplate}">
                                                    <Setter Property="Grid.Column" Value="9" />
                                                </Trigger>
                                                <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelSelectRandomGameButtonTemplate}">
                                                    <Setter Property="Grid.Column" Value="10" />
                                                </Trigger>
                                                <Trigger Property="ContentTemplate" Value="{StaticResource TopPanelViewSelectRandomGameButtonTemplate}">
                                                    <Setter Property="Grid.Column" Value="11" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Resources>
                                </Grid>

                                <!-- Right-side controls -->
                                <ToggleButton x:Name="PART_ToggleNotifications" DockPanel.Dock="Right"
                                              Style="{DynamicResource TopPanelNotificationsToggle}" VerticalAlignment="Center" />

                                <StackPanel x:Name="PART_PanelPluginItems" DockPanel.Dock="Right"
                                            Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" />

                                <!-- Global progress bar (Height=12, >=12px side margin on text) -->
                                <Grid x:Name="PART_ElemProgress" DockPanel.Dock="Right"
                                      VerticalAlignment="Center" Margin="12,0,8,0" MaxWidth="260">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="PART_TextProgressText" FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextBrushDarker}"
                                                   Margin="12,0,12,2" TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center" />
                                        <ProgressBar x:Name="PART_ProgressGlobal" Height="12" MinWidth="110" />
                                    </StackPanel>
                                    <Button x:Name="PART_ButtonProgressCancel" Grid.Column="1"
                                            Content="{DynamicResource LOCCancelLabel}"
                                            Height="26" Margin="6,0,0,0" Padding="8,2"
                                            WindowChrome.IsHitTestVisibleInChrome="True" />
                                </Grid>

                                <Border Background="Transparent" />
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter TargetName="BarRoot" Property="Background" Value="Transparent" />
                            <Setter TargetName="BarRoot" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="BarSpecular" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
