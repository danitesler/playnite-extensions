<!--
    Clearwater: Views/Sidebar.xaml.
    44px Floating Liquid Glass left navigation rail with crisp white specular rim and
    the custom animated Liquid Glass Prism Lens main menu button at top.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="MainMenuButton" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Background" Value="{DynamicResource LocalGlassRailGradient}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="RailFrame" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,1,0"
                            d:DesignWidth="44" d:DesignHeight="800"
                            d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid>
                            <!-- Crisp 1px Liquid Glass inner specular highlight -->
                            <Border x:Name="RailSpecular" BorderBrush="{DynamicResource LocalGlassSpecularBrush}"
                                    BorderThickness="1,0,1,0" Opacity="0.65" IsHitTestVisible="False" />

                            <DockPanel x:Name="PART_PanelMain">
                                <Border x:Name="PART_ElemMainMenu" DockPanel.Dock="Top"
                                        Width="44" Height="48" Padding="6,8"
                                        Background="Transparent" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <!-- Rectangle, not a nested Border: the mark reads ContextMenu.IsOpen from the nearest Border (PART_ElemMainMenu). -->
                                    <Grid>
                                        <Rectangle RadiusX="8" RadiusY="8" IsHitTestVisible="False"
                                                   Fill="{DynamicResource LocalGlassButtonGradient}"
                                                   Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1" />
                                        <Control Template="{DynamicResource LocalClearwaterMenuMarkTemplate}"
                                                 Focusable="False" IsTabStop="False" />
                                    </Grid>
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter TargetName="RailFrame" Property="Background" Value="Transparent" />
                            <Setter TargetName="RailFrame" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="RailSpecular" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter TargetName="RailFrame" Property="BorderThickness" Value="1,0,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter TargetName="RailFrame" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter TargetName="RailFrame" Property="Height" Value="44" />
                            <Setter TargetName="PART_ElemMainMenu" Property="DockPanel.Dock" Value="Left" />
                            <Setter TargetName="PART_ElemMainMenu" Property="Height" Value="44" />
                            <Setter TargetName="PART_PanelSideBarItems" Property="Orientation" Value="Horizontal" />
                            <Setter TargetName="PART_PanelMain" Property="Margin" Value="0,0,108,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter TargetName="RailFrame" Property="BorderThickness" Value="0,1,0,0" />
                            <Setter TargetName="RailFrame" Property="Height" Value="44" />
                            <Setter TargetName="PART_ElemMainMenu" Property="DockPanel.Dock" Value="Left" />
                            <Setter TargetName="PART_ElemMainMenu" Property="Height" Value="44" />
                            <Setter TargetName="PART_PanelSideBarItems" Property="Orientation" Value="Horizontal" />
                            <Setter TargetName="PART_PanelMain" Property="Margin" Value="0,0,108,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
