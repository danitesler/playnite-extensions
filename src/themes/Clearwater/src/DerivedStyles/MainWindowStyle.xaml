<!--
    Clearwater: DerivedStyles/MainWindowStyle.xaml.
    macOS Tahoe Liquid Glass main window frame with authentic traffic-light caption dots
    (Yellow Minimize, Green Maximize/Restore, Red Close) revealing crisp dark symbols on hover.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="MainWindowButton" TargetType="Button">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="TrafficDot" Width="14" Height="14" CornerRadius="7"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource LocalTrafficYellowBrush}"
                                BorderBrush="{DynamicResource LocalTrafficYellowEdgeBrush}" BorderThickness="1">
                            <Grid>
                                <Border CornerRadius="6" BorderBrush="#66FFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />
                                <ContentPresenter x:Name="GlyphHost" Width="8" Height="8"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Opacity="0"
                                                  TextElement.Foreground="{DynamicResource LocalTrafficYellowInkBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Name" Value="PART_ButtonMaximize">
                            <Setter TargetName="TrafficDot" Property="Background" Value="{DynamicResource LocalTrafficGreenBrush}" />
                            <Setter TargetName="TrafficDot" Property="BorderBrush" Value="{DynamicResource LocalTrafficGreenEdgeBrush}" />
                            <Setter TargetName="GlyphHost" Property="TextElement.Foreground" Value="{DynamicResource LocalTrafficGreenInkBrush}" />
                        </Trigger>
                        <Trigger Property="Name" Value="PART_ButtonClose">
                            <Setter TargetName="TrafficDot" Property="Background" Value="{DynamicResource LocalTrafficRedBrush}" />
                            <Setter TargetName="TrafficDot" Property="BorderBrush" Value="{DynamicResource LocalTrafficRedEdgeBrush}" />
                            <Setter TargetName="GlyphHost" Property="TextElement.Foreground" Value="{DynamicResource LocalTrafficRedInkBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="DotHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GlyphHost" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="DotHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="GlyphHost" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TrafficDot" Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MainWindowStyle" TargetType="{x:Type WindowBase}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="48" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="5" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <Border x:Name="WindowFrame" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1">
                        <Grid>
                            <AdornerDecorator>
                                <ContentPresenter />
                            </AdornerDecorator>

                            <!-- macOS Traffic-Light Window Controls (top-right, 48px bar aligned) -->
                            <StackPanel x:Name="PART_PanelButtons" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Height="48" Margin="0,0,10,0">
                                <Button x:Name="PART_ButtonMinimize" Style="{StaticResource MainWindowButton}"
                                        ToolTip="{DynamicResource LOCMinimize}">
                                    <ContentControl Content="{DynamicResource IconWindowMinimize}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button x:Name="PART_ButtonMaximize" Style="{StaticResource MainWindowButton}"
                                        ToolTip="{DynamicResource LOCMaximize}">
                                    <ContentControl x:Name="MaxGlyph" Content="{DynamicResource IconWindowMaximize}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button x:Name="PART_ButtonClose" Style="{StaticResource MainWindowButton}"
                                        ToolTip="{DynamicResource LOCClose}">
                                    <ContentControl Content="{DynamicResource IconWindowClose}" ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowFrame" Property="BorderThickness" Value="0" />
                            <Setter TargetName="WindowFrame" Property="Padding" Value="7" />
                            <Setter TargetName="MaxGlyph" Property="Content" Value="{DynamicResource IconWindowRestore}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
