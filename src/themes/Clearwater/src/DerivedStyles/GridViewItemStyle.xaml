<!--
    Clearwater: DerivedStyles/GridViewItemStyle.xaml.
    12px-rounded macOS Liquid Glass cover frame with animated optical rim + diagonal glass-sheen.png glint on hover,
    System Blue 2px optical selection frame, and System Green RunningIndicator tape.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="TileRoot" Margin="{Settings ItemSpacingMargin}" Background="Transparent" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Border x:Name="CoverFrame" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                Padding="2" Background="{DynamicResource LocalGlassCardGradient}">
                            <Grid ClipToBounds="True">
                                <ContentPresenter />

                                <!-- Animated hover diagonal glass-sheen.png glint -->
                                <Rectangle x:Name="HoverSheen" Fill="{DynamicResource LocalGlassSpecularBrush}"
                                           Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/glass-sheen.png'}" Stretch="Fill" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>

                                <!-- Animated hover blue glass rim -->
                                <Border x:Name="HoverRim" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" BorderThickness="2"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Animated selected System Blue optical frame -->
                                <Border x:Name="SelectedRim" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" BorderThickness="2.5"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Running / Launching Indicator -->
                                <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Border x:Name="RunningWash" CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.14" />
                                    <Border x:Name="RunningFrame" CornerRadius="{DynamicResource ControlCornerRadius}"
                                            BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2.5" />
                                    <Border x:Name="RunningScan" Height="44" VerticalAlignment="Top"
                                            Background="{DynamicResource RunningIndicatorBrush}" Opacity="0">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="CoverScanY" Y="-44" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Margin="6" Padding="8,4" CornerRadius="6"
                                            Background="#D91B2A42">
                                        <Grid>
                                            <Border x:Name="RunningFill" Height="3" VerticalAlignment="Bottom"
                                                    CornerRadius="1.5" Background="{DynamicResource RunningIndicatorBrush}"
                                                    HorizontalAlignment="Left" Width="0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                                                <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                                                <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.65" />
                                                <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="GridHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Opacity" To="0.24" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="GridHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="GridSelIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedRim" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedRim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="GridSelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedRim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedRim" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="CovLaunchIn">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningScan" Storyboard.TargetProperty="Opacity" From="0.32" To="0" Duration="0:0:1.7" />
                                        <DoubleAnimation Storyboard.TargetName="CoverScanY" Storyboard.TargetProperty="Y" From="-44" To="260" Duration="0:0:1.7">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Width" From="0" To="110" Duration="0:0:1.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CovLaunchIn" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningFill" Property="Width" Value="110" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="CovRunIn">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="RunningFrame" Storyboard.TargetProperty="Opacity" From="0.68" To="1" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="CovRunIn" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
