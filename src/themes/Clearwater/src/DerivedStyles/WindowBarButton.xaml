<!--
    Clearwater: DerivedStyles/WindowBarButton.xaml.
    macOS traffic-light caption buttons for dialogs and Settings windows.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="WindowBarButton" TargetType="Button">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="TrafficDot" Width="13" Height="13" CornerRadius="6.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource LocalTrafficYellowBrush}"
                                BorderBrush="{DynamicResource LocalTrafficYellowEdgeBrush}" BorderThickness="1">
                            <Grid>
                                <Border CornerRadius="6" BorderBrush="#66FFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />
                                <ContentPresenter x:Name="GlyphHost" Width="7.5" Height="7.5"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Opacity="0"
                                                  TextElement.Foreground="{DynamicResource LocalTrafficYellowInkBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Name" Value="PART_ButtonMaximize">
                            <Setter TargetName="TrafficDot" Property="Background" Value="{DynamicResource LocalTrafficGreenBrush}" />
                            <Setter TargetName="TrafficDot" Property="BorderBrush" Value="{DynamicResource LocalTrafficGreenEdgeBrush}" />
                            <Setter TargetName="GlyphHost" Property="TextElement.Foreground" Value="{DynamicResource LocalTrafficGreenInkBrush}" />
                        </Trigger>
                        <Trigger Property="Name" Value="PART_ButtonClose">
                            <Setter TargetName="TrafficDot" Property="Background" Value="{DynamicResource LocalTrafficRedBrush}" />
                            <Setter TargetName="TrafficDot" Property="BorderBrush" Value="{DynamicResource LocalTrafficRedEdgeBrush}" />
                            <Setter TargetName="GlyphHost" Property="TextElement.Foreground" Value="{DynamicResource LocalTrafficRedInkBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BarDotIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GlyphHost" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="BarDotOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="GlyphHost" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TrafficDot" Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
