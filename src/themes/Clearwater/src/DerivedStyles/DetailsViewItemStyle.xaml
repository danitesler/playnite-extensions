<!--
    Clearwater: DerivedStyles/DetailsViewItemStyle.xaml.
    Calm macOS Finder-style library rows with animated frosted hover wash, System Blue glass selection pill,
    RowHoverPlay / RowHoverInstall (26x26 transparent buttons + 38px RowHoverRoom),
    and System Green RunningIndicator with RowRoom + RunningMarkPlate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Animated frosted hover wash -->
                        <Border x:Name="HoverPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource ListItemHoverBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                    BorderBrush="#CCFFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />
                        </Border>

                        <!-- Animated System Blue Liquid Glass selection capsule -->
                        <Border x:Name="SelectedPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource LocalGlassBlueGradient}"
                                BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="1"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                    BorderBrush="#55FFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />
                        </Border>

                        <!-- Running / Launching Indicator (above selection/hover) -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
                            <Border x:Name="RunningWash" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.14" />
                            <Border x:Name="RunningFrame" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5" />
                            <Border x:Name="RunningScan" Width="60" HorizontalAlignment="Left"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="RowScanX" X="-60" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="RunningFill" Height="2" VerticalAlignment="Bottom" Margin="6,0,6,1"
                                    CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}"
                                    HorizontalAlignment="Left" Width="0" />
                            <Border x:Name="RunningMarkPlate" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,6,0" Padding="5,3" CornerRadius="6"
                                    Background="{DynamicResource ContentBackgroundBrush}" Opacity="0.9">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                                    <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.65" />
                                    <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Row content with RowRoom (running) and RowHoverRoom (hover button) -->
                        <Border x:Name="RowRoom" Padding="0">
                            <Border x:Name="RowHoverRoom" Padding="0">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Border>
                        </Border>

                        <!-- RowHoverAction: Play (installed) or Install (uninstalled), 26x26 transparent -->
                        <Button x:Name="RowHoverPlay" Width="26" Height="26" Margin="0,0,8,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}"
                                ToolTip="{DynamicResource LOCPlayGame}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl Content="{DynamicResource IconPlay}"
                                                                        ContentTemplate="{DynamicResource IconTemplate}"
                                                                        Foreground="{TemplateBinding Foreground}" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                        <Setter TargetName="Glyph" Property="Width" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Height" Value="17" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="RowHoverInstall" Width="26" Height="26" Margin="0,0,8,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}"
                                ToolTip="{DynamicResource LOCInstallGame}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ContentControl Content="{DynamicResource IconDownload}"
                                                                        ContentTemplate="{DynamicResource IconTemplate}"
                                                                        Foreground="{TemplateBinding Foreground}" />
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                                        <Setter TargetName="Glyph" Property="Width" Value="17" />
                                                        <Setter TargetName="Glyph" Property="Height" Value="17" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="DetHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="DetHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="DetSelIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="DetSelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,42,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="DetLaunchIn">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningScan" Storyboard.TargetProperty="Opacity" From="0.28" To="0" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="RowScanX" Storyboard.TargetProperty="X" From="-60" To="240" Duration="0:0:1.6">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Width" From="0" To="180" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="DetLaunchIn" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,42,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="DetRunIn">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="RunningFrame" Storyboard.TargetProperty="Opacity" From="0.68" To="1" Duration="0:0:1.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="DetRunIn" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
