<!--
    Clearwater: DerivedStyles/PlayButton.xaml.
    Hero moment: macOS Tahoe Liquid Glass Blue Lens Pill (Height=40, MinWidth=164, ControlCornerRadius=8)
    with top specular catchlight, diagonal optical sheen (glass-sheen.png) on hover,
    System Green RunningIndicatorBrush plate with RunningBreath scrim while launching/running,
    LOCCancelLabel + RunningHoverDim on IsRunning + IsMouseOver (RelativeSource Self, Visibility=Hidden on PlayContent),
    and RunningActionIndicator overlay.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="164" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource LocalGlassBlueGradient}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="BasePlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid ClipToBounds="True">
                                <!-- Top 1px specular glass rim -->
                                <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                        BorderBrush="#77FFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />

                                <!-- Animated hover blue lens brighten + diagonal glass-sheen.png sweep -->
                                <Border x:Name="HoverLens" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{DynamicResource LocalGlassBlueHoverGradient}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Rectangle x:Name="HoverSheen" Fill="{DynamicResource LocalGlassSpecularBrush}"
                                           Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/glass-sheen.png'}" Stretch="Fill" />
                                    </Rectangle.OpacityMask>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="SheenX" X="-36" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>

                                <!-- Separate pressed glass lens layer -->
                                <Border x:Name="PressedLens" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{DynamicResource LocalGlassBluePressedGradient}"
                                        Visibility="Collapsed" IsHitTestVisible="False" />

                                <!-- Solid RunningIndicatorBrush plate while launching/running -->
                                <Border x:Name="RunningPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{DynamicResource RunningIndicatorBrush}"
                                        Visibility="Collapsed" IsHitTestVisible="False" />
                                <Border x:Name="RunningScan" Width="64" HorizontalAlignment="Left"
                                        Background="{DynamicResource LocalGlassSpecularBrush}" Opacity="0"
                                        Visibility="Collapsed" IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="PlayScanX" X="-64" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="RunningBreath" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{DynamicResource TextBrush}" Opacity="0.14"
                                        Visibility="Collapsed" IsHitTestVisible="False" />
                                <Border x:Name="RunningHoverDim" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{DynamicResource TextBrush}" Opacity="0.38"
                                        Visibility="Collapsed" IsHitTestVisible="False" />

                                <!-- Content room reserves space for running mark pips so they never overlap text -->
                                <Border x:Name="PlayRoom" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <ContentPresenter x:Name="PlayContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                                                   Visibility="Collapsed" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- ContextAction (Install) uses the same Liquid Glass lens -->
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="BasePlate" Property="Background" Value="{DynamicResource LocalGlassBlueGradient}" />
                        </Trigger>

                        <!-- Hover hero moment (off while launching/running) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLens" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLens" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="SheenX" Storyboard.TargetProperty="X" From="-36" To="18" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLens" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="SheenX" Storyboard.TargetProperty="X" To="-36" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLens" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PressedLens" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>

                        <!-- Launching / Running state -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="14,0,42,0" />
                            <Setter TargetName="BasePlate" Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayLaunchSweep">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningScan" Storyboard.TargetProperty="Opacity" From="0.32" To="0" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="PlayScanX" Storyboard.TargetProperty="X" From="-64" To="180" Duration="0:0:1.6">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayLaunchSweep" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="14,0,42,0" />
                            <Setter TargetName="BasePlate" Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayRunBreath">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.22" To="0.06" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayRunBreath" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Hover on RUNNING shows Cancel (PlayContent Hidden so width stays constant) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RunningHoverDim" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RunningActionIndicator overlay placed on the Play/ContextAction cell in both game overviews -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
                        <Border x:Name="RunningWash" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.16" IsHitTestVisible="False" />
                        <Border x:Name="RunningFrame" CornerRadius="{DynamicResource ControlCornerRadius}"
                                BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5" Opacity="0.85" />
                        <Border x:Name="RunningScan" Width="64" HorizontalAlignment="Left"
                                Background="{DynamicResource LocalGlassSpecularBrush}" Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="BtnScanX" X="-64" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="RunningFill" Height="3" VerticalAlignment="Bottom" Margin="4,0,4,2"
                                CornerRadius="1.5" Background="{DynamicResource LocalGlassSpecularBrush}"
                                HorizontalAlignment="Left" Width="0" Opacity="0.85" />
                        <StackPanel x:Name="RunningMark" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                            <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource LocalGlassSpecularBrush}" />
                            <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource LocalGlassSpecularBrush}" Opacity="0.7" />
                            <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource LocalGlassSpecularBrush}" Opacity="0.4" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="ActLaunchIn">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningScan" Storyboard.TargetProperty="Opacity" From="0.32" To="0" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="BtnScanX" Storyboard.TargetProperty="X" From="-64" To="180" Duration="0:0:1.6">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Width" From="0" To="148" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="ActLaunchIn" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningFill" Property="Width" Value="148" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="ActRunIn">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="RunningFrame" Storyboard.TargetProperty="Opacity" From="0.45" To="0.92" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="ActRunIn" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
