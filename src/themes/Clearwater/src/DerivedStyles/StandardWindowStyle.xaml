<!--
    Clearwater: DerivedStyles/StandardWindowStyle.xaml.
    42px Frosted Liquid Glass Settings / Dialog title band with Clearwater Prism Lens mark
    and macOS traffic-light WindowBarButtons. WindowDesignStyle is standalone (never BasedOn StandardWindowStyle).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="StandardWindowStyle" TargetType="{x:Type WindowBase}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="42" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="5" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <Border x:Name="DialogFrame" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1">
                        <Grid>
                            <!-- 42px Frosted Liquid Glass Title Band -->
                            <Border x:Name="TitleBand" Height="42" VerticalAlignment="Top"
                                    Background="{DynamicResource LocalGlassBarGradient}"
                                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Border BorderBrush="{DynamicResource LocalGlassSpecularBrush}" BorderThickness="0,1,0,0"
                                            Opacity="0.9" IsHitTestVisible="False" />
                                    <!-- Subtle alpine mist refraction along right side of band -->
                                    <Rectangle HorizontalAlignment="Right" Width="180" Fill="{DynamicResource GlyphBrush}"
                                               Opacity="0.06" IsHitTestVisible="False">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{ThemeFile 'Images/fx/tahoe-mist.png'}" Stretch="Fill" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <DockPanel Margin="12,0,10,0">
                                        <!-- Brand prism badge -->
                                        <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0"
                                                CornerRadius="{DynamicResource CornerRadiusSmall}"
                                                Background="{DynamicResource LocalGlassButtonGradient}"
                                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <Control Width="16" Height="16" Foreground="{DynamicResource GlyphBrush}"
                                                     Template="{DynamicResource LocalClearwaterBrandMarkTemplate}"
                                                     Focusable="False" IsTabStop="False" />
                                        </Border>

                                        <!-- Traffic-light caption buttons -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="PART_ButtonMinimize" Style="{DynamicResource WindowBarButton}"
                                                    Visibility="{Binding ShowMinimizeButton, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ContentControl Content="{DynamicResource IconWindowMinimize}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonMaximize" Style="{DynamicResource WindowBarButton}"
                                                    Visibility="{Binding ShowMaximizeButton, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ContentControl x:Name="MaxIcon" Content="{DynamicResource IconWindowMaximize}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                            <Button x:Name="PART_ButtonClose" Style="{DynamicResource WindowBarButton}"
                                                    Visibility="{Binding ShowCloseButton, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ContentControl Content="{DynamicResource IconWindowClose}" ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>

                                        <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                   FontFamily="{DynamicResource HeadingFontFamily}"
                                                   FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- Content sits below the 42px title band (matches CaptionHeight) -->
                            <AdornerDecorator Margin="0,42,0,0">
                                <ContentPresenter />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="DialogFrame" Property="BorderThickness" Value="0" />
                            <Setter TargetName="DialogFrame" Property="Padding" Value="7" />
                            <Setter TargetName="MaxIcon" Property="Content" Value="{DynamicResource IconWindowRestore}" />
                        </Trigger>
                        <Trigger Property="Name" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standalone WindowDesignStyle (never BasedOn StandardWindowStyle) -->
    <Style x:Key="WindowDesignStyle" TargetType="{x:Type Window}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
