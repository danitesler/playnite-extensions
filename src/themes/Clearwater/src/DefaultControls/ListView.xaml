<!--
    Clearwater: DefaultControls/ListView.xaml.
    Implicit ListViewItem style only (Playnite's ListView, headers and scroll viewer stay stock)
    plus the Clearwater System Green Liquid Glass RunningIndicator overlay.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="RowBg" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Background="{TemplateBinding Background}" />

                        <!-- Running / Launching Indicator -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border x:Name="RunningWash" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.14" />
                            <Border x:Name="RunningFrame" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5" />
                            <Border x:Name="RunningScan" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ScanShift" X="-120" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="RunningFill" Height="2" VerticalAlignment="Bottom" Margin="4,0,4,1"
                                    CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}"
                                    HorizontalAlignment="Left" Width="0" />
                            <StackPanel x:Name="RunningMark" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource RunningIndicatorBrush}" />
                                <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.65" />
                                <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="RowRoom" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource ListItemHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource LocalGlassBlueGradient}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="6,4,50,4" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="LvLaunchIn">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningScan" Storyboard.TargetProperty="Opacity" From="0.28" To="0" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetName="ScanShift" Storyboard.TargetProperty="X" From="-80" To="260" Duration="0:0:1.6">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Width" From="0" To="120" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="LvLaunchIn" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="6,4,50,4" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="LvRunIn">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="RunningFrame" Storyboard.TargetProperty="Opacity" From="0.68" To="1" Duration="0:0:1.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="LvRunIn" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
