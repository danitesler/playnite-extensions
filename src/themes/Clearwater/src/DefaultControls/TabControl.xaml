<!--
    Clearwater: DefaultControls/TabControl.xaml.
    macOS Tahoe segmented glass tabs. Keeps Foreground="{DynamicResource TextBrush}" on TabItem
    and sets header state colors via TargetName on the header ContentPresenter.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid Background="Transparent" Margin="2,0" SnapsToDevicePixels="True">
                        <Border x:Name="HoverPill" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Background="{DynamicResource ListItemHoverBrush}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="SelectedPill" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                Background="{DynamicResource LocalGlassCardGradient}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <Border CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    BorderBrush="#DDFFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="AccentFoot" Height="2" Margin="10,0,10,1" VerticalAlignment="Bottom"
                                CornerRadius="1" Background="{DynamicResource TabItemIndicatorBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                        <TextBlock x:Name="HeaderHost" Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TabItemForegroundBrush}">
                            <ContentPresenter ContentSource="Header" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderHost" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TabHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPill" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TabHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedPill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="AccentFoot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderHost" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="HeaderHost" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="3"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource TabControlHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
