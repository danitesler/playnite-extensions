<!--
    Clearwater: DefaultControls/TreeView.xaml.
    macOS Tahoe System Settings frosted sidebar tree: 30px rows in body font,
    animated hover wash, System Blue optical active pill, WindowSettings / WindowExtensions 240px width trigger.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Grid x:Name="HeaderRow" Height="30" Background="Transparent" Margin="0,1" SnapsToDevicePixels="True">
                            <Border x:Name="HoverWash" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource ListItemHoverBrush}"
                                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="SelectedPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource LocalGlassBlueGradient}"
                                    BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="1"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                                <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                        BorderBrush="#55FFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />
                            </Border>
                            <Border x:Name="AccentPip" Width="2" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0"
                                    CornerRadius="1" Background="{DynamicResource LocalGlassSpecularBrush}"
                                    Visibility="Collapsed" IsHitTestVisible="False" />
                            <DockPanel Margin="10,0,8,0">
                                <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,4,0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press" Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <ContentControl x:Name="Chev" Width="10" Height="10"
                                                                Foreground="{DynamicResource TextBrushDarker}"
                                                                Content="{DynamicResource IconSubmenu}"
                                                                ContentTemplate="{DynamicResource IconSmallTemplate}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chev" Property="Content" Value="{DynamicResource IconDropDown}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </DockPanel>
                        </Grid>
                        <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="HeaderRow" Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="AccentPip" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter TargetName="PART_Header" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource LocalGlassRailGradient}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="8,10" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Name, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowSettings">
                <Setter Property="Width" Value="240" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Name, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowExtensions">
                <Setter Property="Width" Value="240" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
