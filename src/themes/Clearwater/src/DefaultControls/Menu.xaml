<!--
    Clearwater: DefaultControls/Menu.xaml.
    Unified macOS Tahoe Liquid Glass menu rows (docs/themes/menus.md):
    - Panel: LocalClearwaterMenuBoardTemplate (12px frosted card, crisp white top specular rim, glass-rim.png bloom).
    - Highlight: 30px rows, System Blue optical capsule (CornerRadiusSmall=6) with top specular edge fading in (110ms CubicEase).
    - Group break: translucent divider inset to icon column (9px tall).
    - Icons: 48x48 full-color MacGlass squircle PNGs in fixed 26px column; fallback sets TextElement.Foreground on Icon.
    - Shortcuts: right-aligned Barlow muted slate, turning crisp white on blue highlight.
    - Marked rows: Alt+Q Exit in System Red (#D70015) with red glass capsule & white text; checked rows show SF checkmark.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="9" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="9" Margin="30,0,8,0" SnapsToDevicePixels="True">
                        <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource MenuSeparatorBrush}" />
                        <Border Height="1" VerticalAlignment="Center" Margin="0,2,0,0"
                                Background="{DynamicResource LocalGlassSpecularBrush}" Opacity="0.7" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Animated System Blue Liquid Glass highlight capsule -->
            <Border x:Name="HiGlass" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Background="{DynamicResource LocalGlassBlueGradient}"
                    BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="1"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border CornerRadius="{DynamicResource CornerRadiusSmall}"
                        BorderBrush="#66FFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />
            </Border>

            <!-- Danger capsule for Alt+Q Exit -->
            <Border x:Name="DangerGlass" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Background="{DynamicResource LocalGlassDangerGradient}"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border CornerRadius="{DynamicResource CornerRadiusSmall}"
                        BorderBrush="#55FFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />
            </Border>

            <Grid Margin="6,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>

                <!-- Fixed 26px icon / check column -->
                <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon"
                                  Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource TextBrushDarker}" />
                <ContentControl x:Name="CheckGlyph" Grid.Column="0" Width="13" Height="13"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                Foreground="{DynamicResource GlyphBrush}"
                                Content="{DynamicResource IconCheck}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Visibility="Collapsed" IsHitTestVisible="False" />

                <!-- Plain * label column -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                <!-- Shared-size right-aligned shortcut column -->
                <TextBlock x:Name="ShortcutText" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                           Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextBrushDarker}" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="CheckGlyph" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HiGlass" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HiGlass" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HiGlass" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HiGlass" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HiGlass" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="DangerGlass" Property="Visibility" Value="Visible" />
                <Setter TargetName="DangerGlass" Property="Opacity" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="HiGlass" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Background="{DynamicResource LocalGlassBlueGradient}"
                    BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="1"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Border CornerRadius="{DynamicResource CornerRadiusSmall}"
                        BorderBrush="#66FFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />
            </Border>
            <Border x:Name="HeldGlass" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Background="{DynamicResource LocalGlassBlueGradient}"
                    BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="1"
                    Visibility="Collapsed" IsHitTestVisible="False" />

            <Grid Margin="6,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon"
                                  Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource TextBrushDarker}" />
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                  VerticalAlignment="Center" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                <ContentControl x:Name="Arrow" Grid.Column="3" Width="11" Height="11"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBrushDarker}"
                                Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}" />
            </Grid>

            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" VerticalOffset="-6"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade">
                <Grid MinWidth="200" Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalClearwaterMenuBoardTemplate}"
                             Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="{DynamicResource MenuPadding}" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="HeldGlass" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HiGlass" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HiGlass" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HiGlass" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HiGlass" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Menu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
</ResourceDictionary>
