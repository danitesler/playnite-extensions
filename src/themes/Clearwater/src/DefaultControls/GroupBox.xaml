<!--
    Clearwater: DefaultControls/GroupBox.xaml.
    Frosted macOS Tahoe Liquid Glass card container; stays content-sized (no wide decor).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource LocalGlassCardGradient}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border CornerRadius="{DynamicResource CornerRadiusLarge}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border CornerRadius="{DynamicResource CornerRadiusLarge}"
                                    BorderBrush="#DDFFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />
                            <DockPanel Margin="{TemplateBinding Padding}">
                                <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="0,0,0,8"
                                                  TextElement.FontSize="{DynamicResource FontSizeSmall}"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}" />
                                <ContentPresenter />
                            </DockPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
