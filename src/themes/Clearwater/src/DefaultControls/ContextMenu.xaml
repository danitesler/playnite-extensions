<!--
    Clearwater: DefaultControls/ContextMenu.xaml.
    Unified macOS Tahoe Liquid Glass popover panel (LocalClearwaterMenuBoardTemplate) reused by
    ContextMenu, Menu submenus, TopPanelMenu, and ComboBox dropdowns (docs/themes/menus.md).
    Signature: 12px frosted glass card with #B8C9DF rim, crisp 1px #FFFFFF top catchlight,
    and subtle 9-slice optical lensing bloom (glass-rim.png).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalClearwaterMenuBoardTemplate" TargetType="{x:Type Control}">
        <Border CornerRadius="{DynamicResource CornerRadiusLarge}"
                Background="{DynamicResource LocalGlassCardGradient}"
                BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="{DynamicResource PopupBorderThickness}"
                SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid>
                <Border CornerRadius="{DynamicResource CornerRadiusLarge}"
                        BorderBrush="{DynamicResource LocalGlassSpecularBrush}"
                        BorderThickness="0,1,0,0" Opacity="0.92" IsHitTestVisible="False" />
                <Rectangle Fill="{DynamicResource LocalGlassSpecularBrush}" Opacity="0.35" IsHitTestVisible="False">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/glass-rim.png'}" Stretch="Fill" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="216" />
        <Setter Property="Padding" Value="{DynamicResource MenuPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid MinWidth="{TemplateBinding MinWidth}" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalClearwaterMenuBoardTemplate}"
                                 Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="{TemplateBinding Padding}" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
