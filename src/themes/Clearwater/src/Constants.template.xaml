<!--
    Clearwater: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Maps macOS 26 Tahoe Liquid Glass tokens onto Playnite palette keys, shared vocabulary keys,
    and Local* optical glass gradients and traffic-light brushes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys + shared HeadingFontFamily) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">28</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow, Barlow, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Barlow, Barlow, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- Usable metadata content width & position (ThemeModifier edits these) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape (Playnite keys + shared radius scale) -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:tahoe-radius}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:tahoe-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:tahoe-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:tahoe-radius-xl}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:tahoe-radius-full}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{tahoe-ink}}</Color>
    <Color x:Key="TextColorDarker">{{tahoe-ink-secondary}}</Color>
    <Color x:Key="TextColorDark">{{tahoe-ink-invert}}</Color>
    <Color x:Key="MainColor">{{tahoe-surface-soft}}</Color>
    <Color x:Key="MainColorDark">{{tahoe-card}}</Color>
    <Color x:Key="HoverColor">{{tahoe-glass-hover}}</Color>
    <Color x:Key="GlyphColor">{{tahoe-blue}}</Color>
    <Color x:Key="HighlightGlyphColor">{{tahoe-blue-soft}}</Color>
    <Color x:Key="PopupBackgroundColor">{{tahoe-card}}</Color>
    <Color x:Key="PopupBorderColor">{{tahoe-border-strong}}</Color>
    <Color x:Key="BackgroundToneColor">{{tahoe-canvas}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{tahoe-divider}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{tahoe-border}}</Color>
    <Color x:Key="DataChangeNotifColor">{{tahoe-orange}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{tahoe-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{tahoe-tooltip-bg}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{tahoe-card}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{tahoe-card}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{tahoe-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{tahoe-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{tahoe-orange}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{tahoe-orange}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{tahoe-card}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{tahoe-canvas}}" />

    <!-- Shared keys: Shell & Game page -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{tahoe-glass-rail}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{tahoe-glass-bar}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{tahoe-surface}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{tahoe-surface}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{tahoe-well}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{tahoe-well-hover}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{tahoe-card}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{tahoe-border}}" />
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{tahoe-banner-tint}}" />
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{tahoe-art-fg}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{tahoe-card-header}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{tahoe-ink}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{tahoe-glass-bar}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{tahoe-ink}}" />

    <!-- Shared keys: States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{tahoe-blue-hover}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{tahoe-ink-invert}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{tahoe-glass-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{tahoe-green}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{tahoe-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{tahoe-ink-invert}}" />

    <!-- Shared keys: Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{tahoe-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{tahoe-glass-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{tahoe-glass-press}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{tahoe-border}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{tahoe-blue-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{tahoe-blue-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{tahoe-ink-invert}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{tahoe-blue-edge}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{tahoe-card}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{tahoe-border}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{tahoe-glass-hover}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{tahoe-glass-press}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{tahoe-blue-tint}}" />

    <!-- Shared keys: Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{tahoe-well}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{tahoe-well-hover}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{tahoe-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{tahoe-blue}}" />

    <!-- Shared keys: Controls & Popups -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{tahoe-border-strong}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{tahoe-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{tahoe-card}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{tahoe-track}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{tahoe-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{tahoe-thumb}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{tahoe-thumb-hi}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{tahoe-thumb}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{tahoe-thumb-hi}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{tahoe-ink-secondary}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{tahoe-ink}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{tahoe-blue-soft}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{tahoe-canvas}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{tahoe-glass-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{tahoe-blue}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{tahoe-ink-secondary}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{tahoe-ink-invert}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{tahoe-surface-soft}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{tahoe-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{tahoe-blue-tint}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{tahoe-divider}}" />

    <!-- Local* Liquid Glass optical brushes & macOS traffic lights -->
    <SolidColorBrush x:Key="LocalGlassSpecularBrush" Color="{{tahoe-specular}}" />
    <SolidColorBrush x:Key="LocalGlassSpecularSoftBrush" Color="{{tahoe-specular-soft}}" />
    <SolidColorBrush x:Key="LocalBlueTintBrush" Color="{{tahoe-blue-tint}}" />
    <SolidColorBrush x:Key="LocalTrafficRedBrush" Color="{{tahoe-tl-red}}" />
    <SolidColorBrush x:Key="LocalTrafficRedEdgeBrush" Color="{{tahoe-tl-red-edge}}" />
    <SolidColorBrush x:Key="LocalTrafficRedInkBrush" Color="{{tahoe-tl-red-ink}}" />
    <SolidColorBrush x:Key="LocalTrafficYellowBrush" Color="{{tahoe-tl-yellow}}" />
    <SolidColorBrush x:Key="LocalTrafficYellowEdgeBrush" Color="{{tahoe-tl-yellow-edge}}" />
    <SolidColorBrush x:Key="LocalTrafficYellowInkBrush" Color="{{tahoe-tl-yellow-ink}}" />
    <SolidColorBrush x:Key="LocalTrafficGreenBrush" Color="{{tahoe-tl-green}}" />
    <SolidColorBrush x:Key="LocalTrafficGreenEdgeBrush" Color="{{tahoe-tl-green-edge}}" />
    <SolidColorBrush x:Key="LocalTrafficGreenInkBrush" Color="{{tahoe-tl-green-ink}}" />

    <LinearGradientBrush x:Key="LocalGlassRailGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{tahoe-glass-rail-hi}}" Offset="0" />
        <GradientStop Color="{{tahoe-glass-rail}}" Offset="0.45" />
        <GradientStop Color="{{tahoe-glass-rail-lo}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassBarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{tahoe-glass-bar-hi}}" Offset="0" />
        <GradientStop Color="{{tahoe-glass-bar}}" Offset="0.55" />
        <GradientStop Color="{{tahoe-glass-bar-lo}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassCardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{tahoe-card}}" Offset="0" />
        <GradientStop Color="{{tahoe-card-lo}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{tahoe-card}}" Offset="0" />
        <GradientStop Color="{{tahoe-surface-soft}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassBlueGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{tahoe-blue-hi}}" Offset="0" />
        <GradientStop Color="{{tahoe-blue}}" Offset="0.45" />
        <GradientStop Color="{{tahoe-blue-hover}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassBlueHoverGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{tahoe-blue-soft}}" Offset="0" />
        <GradientStop Color="{{tahoe-blue-hi}}" Offset="0.35" />
        <GradientStop Color="{{tahoe-blue-hover}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassBluePressedGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{tahoe-blue-hover}}" Offset="0" />
        <GradientStop Color="{{tahoe-blue-press}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassGreenGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{tahoe-green-hi}}" Offset="0" />
        <GradientStop Color="{{tahoe-green}}" Offset="0.5" />
        <GradientStop Color="{{tahoe-green-deep}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassDangerGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{tahoe-red-hi}}" Offset="0" />
        <GradientStop Color="{{tahoe-red}}" Offset="0.55" />
        <GradientStop Color="{{tahoe-red-deep}}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
