<!--
    Clearwater: Common.xaml.
    Shared spacing, ControlHeight (32px), GameBannerHeight (320px), GameBannerDarken (0),
    PopupBorder, FocusVisual, LocalClearwaterBrandMarkTemplate, and LocalClearwaterMenuMarkTemplate
    (animated Liquid Glass Prism Lens mark for PART_ElemMainMenu in Sidebar and TopPanel).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared spacing & metrics -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <Thickness x:Key="ButtonPadding">12,5</Thickness>
    <Thickness x:Key="InputPadding">8,5</Thickness>
    <Thickness x:Key="MenuPadding">6</Thickness>
    <Thickness x:Key="MenuItemPadding">8,4</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">6</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,4</Thickness>
    <Thickness x:Key="ListBoxItemPadding">8,5</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    </Style>

    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1" SnapsToDevicePixels="True"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}"
                            BorderThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Static Clearwater Liquid Glass Prism Brand Mark (Settings title band, Empty state) -->
    <ControlTemplate x:Key="LocalClearwaterBrandMarkTemplate" TargetType="{x:Type Control}">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Border Canvas.Left="2.5" Canvas.Top="2.5" Width="19" Height="19" CornerRadius="5.5"
                        Background="#28007AFF" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.8" />
                <Border Canvas.Left="6" Canvas.Top="6" Width="12" Height="12" CornerRadius="3.2"
                        BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.2" Opacity="0.55" />
                <Path Data="M7.5,9.2 C9.8,7.4 14.2,7.4 16.5,9.2"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Canvas.Left="9.6" Canvas.Top="10.2" Width="4.8" Height="4.8"
                         Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!--
        Main Menu Mark (docs/themes/menu-mark.md):
        Custom animated Liquid Glass Prism Lens mark inside PART_ElemMainMenu (Sidebar & TopPanel).
        - Rest: calm frosted squircle lens with refracted inner ring and System Blue optical core.
        - Hover (IsMouseOver on Control): outer optical ring expands smoothly and top specular arc gleams (180ms CubicEase).
        - Open (ContextMenu.IsOpen on ancestor Border): separate OpenLensPlate fills System Blue and core gently breathes (2.6s Forever),
          cleanly reset by ExitActions covering every animated property.
    -->
    <ControlTemplate x:Key="LocalClearwaterMenuMarkTemplate" TargetType="{x:Type Control}">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <!-- Hover-only optical rim glow (separate element from Open state) -->
            <Border x:Name="HoverLensRim" Margin="2" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource LocalBlueTintBrush}"
                    BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1.5"
                    Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

            <!-- Open-only engaged blue lens backing (separate element from Hover state) -->
            <Border x:Name="OpenLensPlate" Margin="2" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource LocalGlassBlueGradient}"
                    BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="1"
                    Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

            <Viewbox Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="24" Height="24">
                    <!-- Outer Liquid Glass Squircle -->
                    <Border x:Name="OuterPrism" Canvas.Left="2.5" Canvas.Top="2.5" Width="19" Height="19" CornerRadius="5.5"
                            BorderBrush="{DynamicResource MainMenuButtonForegroundBrush}" BorderThickness="1.8"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PrismScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                    </Border>

                    <!-- Hover-animated Specular Refraction Arc (separate element) -->
                    <Path x:Name="SpecularArc" Data="M7.5,9.2 C9.8,7.4 14.2,7.4 16.5,9.2"
                          Stroke="{DynamicResource MainMenuButtonForegroundBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.78">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="ArcShift" Y="0" />
                        </Path.RenderTransform>
                    </Path>

                    <!-- Open-animated Optical Core (separate element) -->
                    <Ellipse x:Name="OpticalCore" Canvas.Left="9.4" Canvas.Top="10.2" Width="5.2" Height="5.2"
                             Fill="{DynamicResource MainMenuButtonForegroundBrush}" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="CoreScale" ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MarkHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLensRim" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverLensRim" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PrismScale" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PrismScale" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ArcShift" Storyboard.TargetProperty="Y" To="-1.2" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SpecularArc" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MarkHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HoverLensRim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="PrismScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="PrismScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="ArcShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="SpecularArc" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLensRim" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <Setter TargetName="OuterPrism" Property="BorderBrush" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="SpecularArc" Property="Stroke" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="OpticalCore" Property="Fill" Value="{DynamicResource SelectedForegroundBrush}" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="MarkOpenIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OpenLensPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="OpenLensPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleX"
                                             From="0.92" To="1.18" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleY"
                                             From="0.92" To="1.18" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard x:Name="MarkOpenOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="OpenLensPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OpenLensPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
