<!--
    Clearwater: CustomControls/TopPanelItem.xaml.
    32x32 Liquid Glass toolbar pills (icon-only view switches & tools) with frosted rest plates
    and System Blue optical active state.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TopPanelItem}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanelItem}">
                    <Grid Background="Transparent" ToolTip="{Binding Title}" SnapsToDevicePixels="True">
                        <Border x:Name="RestPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource LocalGlassButtonGradient}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                IsHitTestVisible="False">
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                    BorderBrush="#BBFFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="HoverPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource TopPanelItemHoverBackgroundBrush}"
                                BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="CheckedPlate" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource LocalGlassBlueGradient}"
                                BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="1"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                    BorderBrush="#55FFFFFF" BorderThickness="0,1,0,0" IsHitTestVisible="False" />
                        </Border>
                        <ContentPresenter x:Name="ContentHost" Margin="7,0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsToggled" Value="True">
                            <Setter TargetName="CheckedPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TopItemIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TopItemOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsToggled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </MultiTrigger>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter TargetName="RestPlate" Property="Opacity" Value="0.72" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
