<!--
    Night City spacing and focus. Cyberpunk 2077's menus are dense and angular: tight padding, 1px hairlines, a cyan focus box.
    Values are this theme's own (no published spec); GameBannerHeight is the default banner height, edited in ThemeModifier.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Keyboard focus: a 1px cyan box 2px outside the control, no dashes. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="1" Stroke="{DynamicResource FocusBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Thickness x:Key="ButtonPadding">16,6</Thickness>
    <Thickness x:Key="InputPadding">10,6</Thickness>
    <Thickness x:Key="MenuPadding">0,4</Thickness>
    <Thickness x:Key="MenuItemPadding">14,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,2</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <sys:Double x:Key="IconSize">16</sys:Double>

    <!-- Default banner height; the game page spacer scales with it (see src/themes/AGENTS.md). -->
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
</ResourceDictionary>
