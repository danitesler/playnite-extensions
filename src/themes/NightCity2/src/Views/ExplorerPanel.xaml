<!--
    Night City explorer panel: 12px side gutters, 1px yellow hairline (WindowPanelSeparatorBrush) on the panel edge and under the field selector,
    flush list (rows are styled by the ListBox style). Keeps PART_ButtonClose, PART_SelectFields, PART_SelectItems.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type ExplorerPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ExplorerPanel}">
                    <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                            d:DesignWidth="200"
                            d:DesignHeight="400">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ExplorerPanelPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Background="{TemplateBinding Background}">
                            <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True" Margin="12,10,12,10">
                                    <Button Content="r" FontFamily="Marlett"
                                            Style="{StaticResource SimpleButton}"
                                            DockPanel.Dock="Right" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Name="PART_ButtonClose"/>
                                    <ComboBox Name="PART_SelectFields" MaxDropDownHeight="Auto"
                                              DockPanel.Dock="Left" Margin="0" />
                                </DockPanel>
                            </Border>
                            <ListBox Name="PART_SelectItems"
                                     DockPanel.Dock="Top" Margin="6,0,6,8"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            </ListBox>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
