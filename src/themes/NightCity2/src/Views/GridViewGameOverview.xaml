<!--
    Night City game page (grid side panel). Same skeleton as the details view, narrower: banner HeroArt (BitmapCache, OpacityMask fade),
    spacer x * 160 / 340 of HeroArt.ActualHeight via MathConverter (24 when the banner is off), header with title and 40px actions
    (Play with an 8px cut corner) and a close button top right, left column Steam screenshots, description, notes,
    right column 190px metadata card with captions above values (4px), six groups divided by 1px yellow rules, 20px side padding, 24px gap.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                       Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer HorizontalAlignment="Stretch"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          x:Name="PART_ScrollViewHost">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <Grid>
                                    <Grid x:Name="HeroArt" VerticalAlignment="Top" ClipToBounds="True"
                                          Height="{DynamicResource GameBannerHeight}">
                                        <Grid.CacheMode>
                                            <BitmapCache />
                                        </Grid.CacheMode>
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Black" Offset="0.45" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" />
                                        <Rectangle Fill="{DynamicResource WindowBackgourndBrush}">
                                            <Rectangle.OpacityMask>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="Transparent" Offset="0.2" />
                                                    <GradientStop Color="Black" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Grid>
                                    <Grid Margin="20,0,20,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="BannerSpacer" Grid.Row="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 160 / 340'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="24" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <DockPanel Grid.Row="1" Margin="0,0,0,12">
                                            <Image Name="PART_ImageIcon" DockPanel.Dock="Left" MaxHeight="32" MaxWidth="32"
                                                   RenderOptions.BitmapScalingMode="Fant" Margin="0,0,10,0" />
                                            <TextBlock Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLarger}"
                                                       TextWrapping="Wrap" DockPanel.Dock="Left" Margin="0,0,24,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>

                                        <Grid Grid.Row="2" Margin="0,0,0,16" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MaxWidth="150" />
                                                <ColumnDefinition Width="*" MaxWidth="150" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Button Name="PART_ButtonPlayAction" Height="40" Style="{DynamicResource PlayButton}" />
                                                <Button Name="PART_ButtonContextAction" Height="40" />
                                                <Grid Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                                                    <Path Data="M0,0 L8,0 L8,8 Z" Fill="{DynamicResource WindowBackgourndBrush}" />
                                                    <Path Data="M0,0 L8,8" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" />
                                                </Grid>
                                            </Grid>
                                            <Button Name="PART_ButtonMoreActions" Content="{DynamicResource LOCMoreAction}"
                                                    Height="40" Grid.Column="1" Margin="8,0,0,0" />
                                            <Button x:Name="PART_ButtonEditGame" Height="40" Focusable="False" Grid.Column="2" Margin="8,0,0,0"
                                                    Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <Grid Grid.Row="3" Margin="0,0,0,24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="190" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,20">
                                                    <Control Foreground="{DynamicResource TextBrushDarker}">
                                                        <Control.Style>
                                                            <Style TargetType="Control">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="Template" Value="{DynamicResource SteamScreenshotsSkeletonTemplate}" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                            <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <MultiDataTrigger.EnterActions>
                                                                            <BeginStoryboard Name="SkeletonTimeout">
                                                                                <Storyboard>
                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </MultiDataTrigger.EnterActions>
                                                                        <MultiDataTrigger.ExitActions>
                                                                            <RemoveStoryboard BeginStoryboardName="SkeletonTimeout" />
                                                                        </MultiDataTrigger.ExitActions>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Control.Style>
                                                    </Control>
                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <SteamScreenshots_SteamScreenshotsViewControl />
                                                    </Grid>
                                                </Grid>
                                                <StackPanel Name="PART_ElemDescription" Margin="0,0,0,20">
                                                    <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Foreground="{DynamicResource GlyphBrush}"
                                                               FontSize="{DynamicResource FontSizeSmall}" Style="{DynamicResource BaseTextBlockStyle}" />
                                                    <Border Height="1" Margin="0,6,0,10" Background="{DynamicResource WindowPanelSeparatorBrush}" />
                                                    <HtmlTextView Name="PART_HtmlDescription"
                                                                  HtmlFontSize="{DynamicResource FontSize}"
                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                  HtmlForeground="{DynamicResource TextColor}"
                                                                  LinkForeground="{DynamicResource GlyphColor}"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                                </StackPanel>
                                                <StackPanel Name="PART_ElemNotes" Margin="0,0,0,20">
                                                    <TextBlock Text="{DynamicResource LOCNotesLabel}" Foreground="{DynamicResource GlyphBrush}"
                                                               FontSize="{DynamicResource FontSizeSmall}" Style="{DynamicResource BaseTextBlockStyle}" />
                                                    <Border Height="1" Margin="0,6,0,10" Background="{DynamicResource WindowPanelSeparatorBrush}" />
                                                    <TextBox Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                             AcceptsReturn="True" TextWrapping="Wrap" Margin="-1,0,-1,0" Padding="0" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Grid >
                                                    <Border Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                                                            BorderThickness="1" Padding="16,14">
                                                        <Border.Resources>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
                                                            <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="VerticalAlignment" Value="Top" />
                                                            </Style>
                                                        </Border.Resources>
                                                        <Grid ClipToBounds="True">
                                                            <StackPanel Margin="0,-33,0,-8">
                                                                <Border x:Name="MetaProgress" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlyphBrush}" Margin="0,12,0,0" Padding="0,12,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <StackPanel Name="PART_ElemCompletionStatus" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <Button Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemPlayTime" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <TextBlock Name="PART_TextPlayTime" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemLastPlayed" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <TextBlock Name="PART_TextLastActivity" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemRecentActivity" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <TextBlock Name="PART_TextRecentActivity" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemAdded" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCDateAddedLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <TextBlock Name="PART_TextAdded" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaScores" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlyphBrush}" Margin="0,12,0,0" Padding="0,12,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <StackPanel Name="PART_ElemCommunityScore" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCCommunityScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <TextBlock Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemCriticScore" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCCriticScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <TextBlock Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemUserScore" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCUserScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <TextBlock Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaAbout" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlyphBrush}" Margin="0,12,0,0" Padding="0,12,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <StackPanel Name="PART_ElemDevelopers" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCDeveloperLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <ItemsControl Name="PART_ItemsDevelopers" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemPublishers" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCPublisherLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <ItemsControl Name="PART_ItemsPublishers" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemReleaseDate" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <Button Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemSeries" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCSeriesLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <ItemsControl Name="PART_ItemsSeries" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemAgeRating" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <ItemsControl Name="PART_ItemsAgeRatings" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemRegion" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCRegionLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <ItemsControl Name="PART_ItemsRegions" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaTags" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlyphBrush}" Margin="0,12,0,0" Padding="0,12,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <StackPanel Name="PART_ElemPlatform" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCPlatformTitle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <ItemsControl Name="PART_ItemsPlatforms" Tag="Chip">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemGenres" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCGenreLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <ItemsControl Name="PART_ItemsGenres" Tag="Chip">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemCategories" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCGameCategoriesTitle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <ItemsControl Name="PART_ItemsCategories" Tag="Chip">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemFeatures" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCFeaturesLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <ItemsControl Name="PART_ItemsFeatures" Tag="Chip">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemTags" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCTagsLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <ItemsControl Name="PART_ItemsTags" Tag="Chip">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaLibrary" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlyphBrush}" Margin="0,12,0,0" Padding="0,12,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                                    <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <StackPanel Name="PART_ElemLibrary" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCGameProviderTitle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <Button Name="PART_ButtonLibrary" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemSource" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCSourceLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <Button Name="PART_ButtonSource" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemVersion" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCVersionLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <Button Name="PART_ButtonVersion" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemInstallSize" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <TextBlock Name="PART_TextInstallSize" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                        <StackPanel Name="PART_ElemInstallDirectory" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <Button Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="MetaLinks" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlyphBrush}" Margin="0,12,0,0" Padding="0,12,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <StackPanel Name="PART_ElemLinks" Margin="0,8">
                                                                            <TextBlock Text="{DynamicResource LOCLinksLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,4" />
                                                                            <ItemsControl Name="PART_ItemsLinks" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <Grid Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                                                        <Path Data="M0,0 L8,0 L8,8 Z" Fill="{DynamicResource WindowBackgourndBrush}" />
                                                        <Path Data="M0,0 L8,8" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" />
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>

                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Content="r" FontFamily="Marlett"
                                    Style="{DynamicResource SimpleButton}"
                                    Command="{MainViewModel CloseGameSideBarCommand}"
                                    Margin="0,10,16,0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
