<!--
    Night City game page (details view). Cyberpunk 2077 yellow UI, dense and square.
    Banner: HeroArt band of GameBannerHeight (340 default), BitmapCache wrapper, OpacityMask fade down, page-colored scrim.
    Spacer above the title: x * 220 / 340 of HeroArt.ActualHeight via MathConverter, 24 when the banner is off.
    Header: 40px actions (Play with an 8px cut corner), title FontSizeLargest. Columns: Steam screenshots, description, notes left;
    metadata card 340px right (surface ExpanderBackgroundBrush, 1px edge, 8px cut corner), six groups divided by 1px yellow rules.
    Labels are Playnite LOC keys. Also defines SteamScreenshotsSkeletonTemplate (pulsing placeholder, shared key).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Placeholder for the Steam Screenshots plugin control: a 16:9 main image over five thumbnails, drawn in the host foreground and pulsing. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel x:Name="Root">
            <Border Background="{TemplateBinding Foreground}"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
            <UniformGrid Columns="5" Margin="0,6,0,0">
                <Border Background="{TemplateBinding Foreground}" Height="40" Margin="0,0,6,0" />
                <Border Background="{TemplateBinding Foreground}" Height="40" Margin="0,0,6,0" />
                <Border Background="{TemplateBinding Foreground}" Height="40" Margin="0,0,6,0" />
                <Border Background="{TemplateBinding Foreground}" Height="40" Margin="0,0,6,0" />
                <Border Background="{TemplateBinding Foreground}" Height="40" Margin="0,0,0,0" />
            </UniformGrid>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                             From="0.35" To="1" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1280"
                                  d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid>
                            <Grid x:Name="HeroArt" VerticalAlignment="Top" ClipToBounds="True"
                                  Height="{DynamicResource GameBannerHeight}">
                                <Grid.CacheMode>
                                    <BitmapCache />
                                </Grid.CacheMode>
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="Black" Offset="0.45" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Rectangle Fill="{DynamicResource WindowBackgourndBrush}">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="Transparent" Offset="0.2" />
                                            <GradientStop Color="Black" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                            <Grid HorizontalAlignment="Stretch" Margin="24,0,24,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="BannerSpacer" Grid.Row="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 220 / 340'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <Grid Grid.Row="1" MaxWidth="1100" Margin="0,0,0,16" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0" VerticalAlignment="Bottom">
                                        <Image Name="PART_ImageIcon" MaxHeight="40" MaxWidth="40"
                                               DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="Fant" />
                                        <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource FontFamily}"
                                                   FontSize="{DynamicResource FontSizeLargest}" Margin="0,0,12,0" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Grid Width="150">
                                            <Button Name="PART_ButtonPlayAction" Height="40" Style="{DynamicResource PlayButton}" />
                                            <Button Name="PART_ButtonContextAction" Height="40" />
                                            <Grid Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                                                <Path Data="M0,0 L8,0 L8,8 Z" Fill="{DynamicResource WindowBackgourndBrush}" />
                                                <Path Data="M0,0 L8,8" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" />
                                            </Grid>
                                        </Grid>
                                        <Button Name="PART_ButtonMoreActions"
                                                Content="&#xefb0;" FontFamily="{DynamicResource FontIcoFont}" FontSize="18"
                                                Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                                                ToolTip="{DynamicResource LOCMoreAction}" Focusable="False" />
                                        <Button x:Name="PART_ButtonEditGame"
                                                Content="&#xeded;" FontFamily="{DynamicResource FontIcoFont}" FontSize="18"
                                                Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                                                ToolTip="{DynamicResource LOCEditGame}" Focusable="False" />
                                    </StackPanel>
                                    <Image Name="PART_ImageCover" Grid.Column="2" VerticalAlignment="Bottom" Margin="16,0,0,0"
                                           Height="{Settings GameDetailsCoverHeight}"
                                           StretchDirection="Both" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="Fant" />
                                </Grid>

                                <Grid Grid.Row="2" MaxWidth="1100" Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="340" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid Margin="0,0,0,20">
                                            <Control Foreground="{DynamicResource TextBrushDarker}">
                                                <Control.Style>
                                                    <Style TargetType="Control">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Template" Value="{DynamicResource SteamScreenshotsSkeletonTemplate}" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard Name="SkeletonTimeout">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="SkeletonTimeout" />
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Control.Style>
                                            </Control>
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                            </Grid>
                                        </Grid>
                                        <StackPanel Name="PART_ElemDescription" Margin="0,0,0,20">
                                            <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Foreground="{DynamicResource GlyphBrush}"
                                                       FontSize="{DynamicResource FontSizeSmall}" Style="{DynamicResource BaseTextBlockStyle}" />
                                            <Border Height="1" Margin="0,6,0,10" Background="{DynamicResource WindowPanelSeparatorBrush}" />
                                            <HtmlTextView Name="PART_HtmlDescription"
                                                          HtmlFontSize="{DynamicResource FontSize}"
                                                          HtmlFontFamily="{DynamicResource FontFamily}"
                                                          HtmlForeground="{DynamicResource TextColor}"
                                                          LinkForeground="{DynamicResource GlyphColor}"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                        </StackPanel>
                                        <StackPanel Name="PART_ElemNotes" Margin="0,0,0,20">
                                            <TextBlock Text="{DynamicResource LOCNotesLabel}" Foreground="{DynamicResource GlyphBrush}"
                                                       FontSize="{DynamicResource FontSizeSmall}" Style="{DynamicResource BaseTextBlockStyle}" />
                                            <Border Height="1" Margin="0,6,0,10" Background="{DynamicResource WindowPanelSeparatorBrush}" />
                                            <TextBox Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                     AcceptsReturn="True" TextWrapping="Wrap" Margin="-1,0,-1,0" Padding="0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid >
                                            <Border Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                                                    BorderThickness="1" Padding="16,14">
                                                <Border.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
                                                    <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="VerticalAlignment" Value="Top" />
                                                    </Style>
                                                </Border.Resources>
                                                <Grid ClipToBounds="True">
                                                    <StackPanel Margin="0,-33,0,-8">
                                                        <Border x:Name="MetaProgress" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlyphBrush}" Margin="0,12,0,0" Padding="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Name="PART_ElemCompletionStatus" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <Button Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemPlayTime" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextPlayTime" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemLastPlayed" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextLastActivity" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemRecentActivity" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextRecentActivity" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemAdded" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextAdded" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlyphBrush}" Margin="0,12,0,0" Padding="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Name="PART_ElemCommunityScore" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemCriticScore" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCCriticScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemUserScore" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCUserScore}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                    </Grid>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlyphBrush}" Margin="0,12,0,0" Padding="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Name="PART_ElemDevelopers" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCDeveloperLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsDevelopers" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemPublishers" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCPublisherLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsPublishers" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemReleaseDate" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <Button Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemSeries" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCSeriesLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsSeries" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemAgeRating" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsAgeRatings" />
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemRegion" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCRegionLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsRegions" />
                                                                    </Grid>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaTags" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlyphBrush}" Margin="0,12,0,0" Padding="0,12,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Name="PART_ElemPlatform" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCPlatformTitle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsPlatforms" Tag="Chip">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemGenres" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGenreLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsGenres" Tag="Chip">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </Grid>
                                                                </Grid>
                                                                <Grid Name="PART_ElemCategories" Margin="0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="104" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{DynamicResource LOCGameCategoriesTitle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,8,0" />
                                                                    <Grid Grid.Column="1">
                                                                        <ItemsControl Name="PART_ItemsCategories" Tag="Chip">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
