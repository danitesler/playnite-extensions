<!--
    Night City ProgressBar. 6px tall, CornerRadius 3, rail ProgressBarTrackBrush (translucent yellow), solid yellow fill (GlyphBrush).
    Indeterminate: the fill grows and shrinks from the left (ScaleX), so the translucent rail needs no opaque masks.
    Keeps PART_Track and PART_Indicator.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Border CornerRadius="3" Background="{TemplateBinding Background}" />
                        <Rectangle Name="PART_Track" Margin="0" />
                        <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                            <Rectangle x:Name="Fill" RadiusX="3" RadiusY="3" Fill="{TemplateBinding Foreground}"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="FillScale" ScaleX="1" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Decorator>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                                         From="0.1" To="1" Duration="0:00:1.4" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
