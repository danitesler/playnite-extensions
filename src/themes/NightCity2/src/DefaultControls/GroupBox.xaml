<!--
    Night City GroupBox. Card on ExpanderBackgroundBrush, 1px WindowPanelSeparatorBrush edge, a 1px GlyphBrush hairline across the top,
    and one 8px cut corner (top right, surface WindowBackgourndBrush, 1px GlyphBrush diagonal). Header: GlyphBrush SemiBold text over a
    1px WindowPanelSeparatorBrush rule. Body padding GroupBoxPadding. Square: ControlCornerRadius.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid DockPanel.Dock="Top">
                        <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}" Margin="{TemplateBinding Padding}"
                                               Foreground="{DynamicResource GlyphBrush}" FontWeight="SemiBold">
                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                          RecognizesAccessKey="True" />
                                    </TextBlock>
                                </Border>
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                                  Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                        <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                        <Grid Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Path Data="M0,0 L8,0 L8,8 Z" Fill="{DynamicResource WindowBackgourndBrush}" />
                            <Path Data="M0,0 L8,8" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
