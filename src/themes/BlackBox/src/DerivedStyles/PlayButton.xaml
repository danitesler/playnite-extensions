<!--
    Black Box: Hero PlayButton and RunningActionIndicator.
    PlayButton: 40px rectilinear Terracotta Rust slab (PrimaryButtonBackgroundBrush) with 3px charcoal offset shadow,
    9-slice cursor-glow bloom + top/bottom rail overhangs, and horizontal scan-glitch telemetry sweep on hover.
    Tag="ContextAction" hides PlayGlyph so INSTALL / LAUNCHING / RUNNING keep the exact rectilinear YoRHa slab.
    LAUNCHING / RUNNING: plate switches to Pod-Link Teal (RunningIndicatorBrush), darkened by RunningBreath (ArtTintBrush)
    for >= 4.5:1 ivory text contrast. Launching sweeps an angled telemetry scan (RunningScan) + foot fill;
    Running pulses calmly on a 3.2s cycle with twin pulsing diamond telemetry nodes; hovering RUNNING (Self) swaps to Cancel.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Grid Height="2" Margin="10,0,10,4" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource SelectedForegroundBrush}" Opacity="0.85" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <StackPanel Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Path x:Name="RunningNode1" Width="7" Height="7" Stretch="Fill" Stroke="{DynamicResource SelectedForegroundBrush}" StrokeThickness="1.3" Opacity="0.55" Data="M3.5,0 L7,3.5 L3.5,7 L0,3.5 Z" />
                            <Path x:Name="RunningNode2" Width="6" Height="6" Margin="4,0,0,0" Stretch="Fill" Fill="{DynamicResource SelectedForegroundBrush}" Opacity="0.85" Data="M3,0 L6,3 L3,6 L0,3 Z" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningNode1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningNode2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningNode1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningNode2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,5,20,5" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- 9-slice CRT phosphor edge bloom + top/bottom rail overhangs -->
                        <Control x:Name="Bloom" Template="{DynamicResource GlowFrameTemplate}"
                                 Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                 Margin="-12,-10" Opacity="0.25" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" />

                        <!-- 3px hard YoRHa offset shadow -->
                        <Border x:Name="OffsetShadow" Margin="3,3,-3,-3" Background="{DynamicResource NormalBorderBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />

                        <!-- Base rectilinear Terracotta Rust slab -->
                        <Border x:Name="BasePlate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />

                        <!-- Deep charcoal darkening for Running / Launching contrast (light theme: ScrimBrush is parchment, so use ArtTintBrush) -->
                        <Border x:Name="RunningBreath" Background="{DynamicResource ArtTintBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />

                        <!-- Launching sweep band -->
                        <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.65" IsHitTestVisible="False">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.2">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.45" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                    <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>

                        <!-- Idle hover plate + top/bottom extended tracking rules + horizontal telemetry scan -->
                        <Grid x:Name="HoverLayer" Opacity="0" IsHitTestVisible="False">
                            <Border Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                    BorderBrush="{DynamicResource SelectedForegroundBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Rectangle Height="1" VerticalAlignment="Top" Margin="-2,-4,-2,0" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Rectangle Height="1" VerticalAlignment="Bottom" Margin="-2,0,-2,-4" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Border x:Name="ChaseTop" Height="2" VerticalAlignment="Top" Margin="0,-1,0,0" Background="{DynamicResource HighlightGlyphBrush}" Opacity="0.95">
                                 <Border.OpacityMask>
                                     <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                         <GradientStop x:Name="ChaseTopA" Color="#00000000" Offset="-0.40" />
                                         <GradientStop x:Name="ChaseTopB" Color="#FF000000" Offset="-0.28" />
                                         <GradientStop x:Name="ChaseTopC" Color="#FF000000" Offset="-0.12" />
                                         <GradientStop x:Name="ChaseTopD" Color="#00000000" Offset="0" />
                                     </LinearGradientBrush>
                                 </Border.OpacityMask>
                             </Border>
                             <Border x:Name="ChaseBottom" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-1" Background="{DynamicResource HighlightGlyphBrush}" Opacity="0.95">
                                 <Border.OpacityMask>
                                     <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                         <GradientStop x:Name="ChaseBotA" Color="#00000000" Offset="-0.40" />
                                         <GradientStop x:Name="ChaseBotB" Color="#FF000000" Offset="-0.28" />
                                         <GradientStop x:Name="ChaseBotC" Color="#FF000000" Offset="-0.12" />
                                         <GradientStop x:Name="ChaseBotD" Color="#00000000" Offset="0" />
                                     </LinearGradientBrush>
                                 </Border.OpacityMask>
                             </Border>
                             <Grid ClipToBounds="True">
                                <Control x:Name="ScanSweep" Template="{DynamicResource GlowLineTemplate}"
                                         Foreground="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.34" Focusable="False">
                                    <Control.RenderTransform>
                                        <TranslateTransform x:Name="ScanShift" X="-30" />
                                    </Control.RenderTransform>
                                </Control>
                            </Grid>
                        </Grid>

                        <!-- Pressed plate -->
                        <Border x:Name="PressLayer" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />

                        <!-- Running + hover Cancel dim scrim -->
                        <Border x:Name="RunningHoverDim" Background="{DynamicResource ArtTintBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />

                        <!-- Content & Cancel label -->
                        <Border x:Name="PlayRoom" Padding="0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                <StackPanel x:Name="PlayContent" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentControl x:Name="PlayGlyph" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"
                                                    Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}"
                                                    Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock x:Name="PlayLabel"
                                               Text="{TemplateBinding Content, Converter={StaticResource StringToUpperCaseConverter}}"
                                               FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                           Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                           FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Game.IsInstalled}" Value="False">
                            <Setter TargetName="PlayGlyph" Property="Content" Value="{DynamicResource IconDownload}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.3" To="0.5" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.45" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.452" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.452" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.42" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.22" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while RUNNING button itself is hovered (Self, never TemplatedParent). -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.42" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.68" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ScanShift" Storyboard.TargetProperty="X" From="-36" To="24" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                 <BeginStoryboard Name="PlayHoverLoop">
                                     <Storyboard RepeatBehavior="Forever">
                                         <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChaseTopA" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                             <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.3,1" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                                         </DoubleAnimationUsingKeyFrames>
                                         <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChaseTopB" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                             <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.28" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.12" KeySpline="0.4,0 0.3,1" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.12" />
                                         </DoubleAnimationUsingKeyFrames>
                                         <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChaseTopC" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                             <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.12" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.28" KeySpline="0.4,0 0.3,1" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.28" />
                                         </DoubleAnimationUsingKeyFrames>
                                         <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChaseTopD" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                             <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" KeySpline="0.4,0 0.3,1" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.4" />
                                         </DoubleAnimationUsingKeyFrames>
                                         <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChaseBotA" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                             <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.3,1" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                                         </DoubleAnimationUsingKeyFrames>
                                         <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChaseBotB" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                             <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.28" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.12" KeySpline="0.4,0 0.3,1" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.12" />
                                         </DoubleAnimationUsingKeyFrames>
                                         <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChaseBotC" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                             <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.12" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.28" KeySpline="0.4,0 0.3,1" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.28" />
                                         </DoubleAnimationUsingKeyFrames>
                                         <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChaseBotD" Storyboard.TargetProperty="Offset" Duration="0:0:2.4">
                                             <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" KeySpline="0.4,0 0.3,1" />
                                             <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.4" />
                                         </DoubleAnimationUsingKeyFrames>
                                     </Storyboard>
                                 </BeginStoryboard>
                             </MultiDataTrigger.EnterActions>
                             <MultiDataTrigger.ExitActions>
                                 <RemoveStoryboard BeginStoryboardName="PlayHoverLoop" />
                                 <BeginStoryboard>
                                     <Storyboard FillBehavior="Stop">
                                         <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26" />
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.26" />
                                        <DoubleAnimation Storyboard.TargetName="ScanShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- RunningMarkRoom left="0" right="30": reserve space for the twin Pod-Link Teal diamond nodes. -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,30,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,30,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,30,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,30,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
