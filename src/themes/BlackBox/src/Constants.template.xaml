<!--
    Black Box: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared vocabulary (scripts/data/theme-keys.json); each placeholder names the bb-* token that plays
    the key's role. Theme XAML reads brushes only, never Color keys.
    Unofficial light theme inspired by NieR:Automata's YoRHa OS UI: warm khaki-parchment telemetry sheets (#d1cdb7 / #dad4bb),
    inverted charcoal-olive selection slabs (#454138) with ivory text (#f2efe0), terracotta rust primary CTAs (#b8523b),
    and Pod-Link Teal running indicators (#386e5a).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: geometric sans headings (Sora, bundled in Typography/, standing in for FOT-Rodin Pro),
         humanist body (Segoe UI), and monospace telemetry numerals (Consolas). -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">18</sys:Double>
    <sys:Double x:Key="FontSizeLargest">26</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:bb-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Sora, {{text:bb-font-heading|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:bb-font-mono|Consolas}}</FontFamily>

    <!-- Usable metadata content width; applied inside the pane's horizontal padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: strictly rectilinear YoRHa geometry (0px control radius, 2px subtle cover/card bevel). -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:bb-radius-none|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:bb-radius-small|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:bb-radius-card|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{bb-charcoal}}</Color>
    <Color x:Key="TextColorDarker">{{bb-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{bb-ivory}}</Color>
    <Color x:Key="MainColor">{{bb-plate}}</Color>
    <Color x:Key="MainColorDark">{{bb-surface-hi}}</Color>
    <Color x:Key="HoverColor">{{bb-plate-hi}}</Color>
    <Color x:Key="GlyphColor">{{bb-terracotta}}</Color>
    <Color x:Key="HighlightGlyphColor">{{bb-terracotta-hi}}</Color>
    <Color x:Key="PopupBackgroundColor">{{bb-surface-hi}}</Color>
    <Color x:Key="PopupBorderColor">{{bb-charcoal}}</Color>
    <Color x:Key="BackgroundToneColor">{{bb-surface-hi}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{bb-grid}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{bb-grid}}</Color>
    <Color x:Key="DataChangeNotifColor">{{bb-amber}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{bb-charcoal-deep}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{bb-plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{bb-surface-hi}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <!-- Running game: Pod-Link Teal (#386e5a), distinct from terracotta Play, charcoal selection, and amber filter pip. -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{bb-pod-teal}}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{bb-pod-teal}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{bb-danger}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{bb-amber}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{bb-amber}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{bb-surface-hi}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{bb-canvas}}" />

    <!-- Shell and surfaces -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{bb-plate}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{bb-canvas}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{bb-surface}}" />
    <!-- Banner darkening color (ThemeModifier): deep bunker charcoal-olive (#333029) so darkened banners take the YoRHa cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{bb-charcoal-deep}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{bb-surface}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{bb-charcoal-deep}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{bb-surface-hi}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{bb-grid}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{bb-plate}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{bb-charcoal-hi}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{bb-terracotta-hi}}" />

    <!-- States and selection: YoRHa charcoal-olive inversion (#454138) with ivory text (#f2efe0) -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{bb-charcoal-hi}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{bb-terracotta-hi}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{bb-wash-strong}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{bb-wash-strong}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{bb-focus}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{bb-focus-halo}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{bb-danger}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{bb-ivory}}" />

    <!-- Buttons: warm khaki plates at rest that invert to charcoal-olive on hover; Terracotta Rust for Primary/Play -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{bb-charcoal-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{bb-terracotta}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{bb-terracotta-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{bb-terracotta-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{bb-terracotta-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{bb-terracotta-hi}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{bb-charcoal-deep}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{bb-charcoal-hi}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{bb-charcoal-deep}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{bb-charcoal}}" />

    <!-- Inputs and controls -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{bb-surface-hi}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{bb-terracotta}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{bb-terracotta}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{bb-terracotta-hi}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{bb-surface-hi}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{bb-terracotta-hi}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{bb-terracotta-hi}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{bb-surface-hi}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{bb-charcoal/70}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{bb-plate/45}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{bb-charcoal/70}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{bb-charcoal}}" />

    <!-- Tabs, covers, headers, metadata -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{bb-terracotta-hi}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{bb-terracotta}}" />

    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{bb-surface}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{bb-ivory}}" />

    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{bb-terracotta}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{bb-grid}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{bb-terracotta}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{bb-plate}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{bb-grid}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{bb-grid}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{bb-charcoal}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{bb-ivory}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{bb-terracotta}}" />

    <!-- Light theme window-art text flip: unselected rows, Expander headers, and game titles switch to ivory over window art. -->
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{bb-ivory}}" />
</ResourceDictionary>
