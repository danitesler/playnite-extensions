<!--
    Black Box: spacing, focus, and shared NieR:Automata YoRHa OS templates.
      GlowFrameTemplate         9-slice CRT phosphor edge bloom + rail overhangs (Images/fx/cursor-glow.png 128x64 DIP)
      GlowLineTemplate          horizontal android telemetry scan-beam (Images/fx/scan-glitch.png 160x40 DIP)
      DividerTemplate           YoRHa diamond-and-dot horizontal frieze (Images/fx/diamond-frieze.png)
      GrainTemplate             seamless 64x64 DIP coordinate grid + CRT scanlines (Images/fx/grid-scan.png)
      BookmarkTemplate          the ▊▏ musical double-bar repeat sign used on headers and buttons
      PinTemplate               the ▶▪ mechanical track-mounted pointer cursor
      BrandMarkTemplate         original Black Box octagram + concentric diamond core
      CornerMarksTemplate       rectilinear bracket ticks for keyboard focus
      SteamScreenshotsSkeletonTemplate  pulsing placeholder for Steam Screenshots
      EmptyGameTemplate         Pod targeting reticle + Black Box octagram + diamond rule + LOCErrorNoGameSelected
    Sprites in Images/fx/ are pure white masks tinted by theme brushes so ThemeModifier recolors every effect.
    No fixed desired width >= 200 inside templates (Statistics cards stay compact).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">12,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">12,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">14,12,14,14</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <!-- 9-slice CRT phosphor edge bloom + rail overhangs (Images/fx/cursor-glow.png 128x64 DIP). Host Foreground = glow color. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/cursor-glow.png'}" Viewbox="0,0,32,16" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/cursor-glow.png'}" Viewbox="32,0,64,16" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/cursor-glow.png'}" Viewbox="96,0,32,16" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/cursor-glow.png'}" Viewbox="0,16,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/cursor-glow.png'}" Viewbox="32,16,64,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/cursor-glow.png'}" Viewbox="96,16,32,32" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/cursor-glow.png'}" Viewbox="0,48,32,16" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/cursor-glow.png'}" Viewbox="32,48,64,16" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}"><Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/cursor-glow.png'}" Viewbox="96,48,32,16" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask></Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Horizontal android telemetry scan-beam (Images/fx/scan-glitch.png). Host Foreground = scan color. -->
    <ControlTemplate x:Key="GlowLineTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/scan-glitch.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- YoRHa diamond-and-dot horizontal frieze (───◇─•─◇───). Compact: no desired width >= 200. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="12" IsHitTestVisible="False" SnapsToDevicePixels="True" ClipToBounds="True">
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{TemplateBinding BorderBrush}" Opacity="0.55" />
            <Rectangle Height="12" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/diamond-frieze.png'}" Stretch="UniformToFill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Seamless 64x64 DIP 32px YoRHa coordinate grid + CRT scanlines (Images/fx/grid-scan.png). -->
    <ControlTemplate x:Key="GrainTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/grid-scan.png'}" TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Musical staff double-bar repeat mark (▊▏): thick 4px bar (Foreground) + 2px gap + thin 1.5px bar (BorderBrush). -->
    <ControlTemplate x:Key="BookmarkTemplate" TargetType="Control">
        <StackPanel Orientation="Horizontal" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Width="4" Fill="{TemplateBinding Foreground}" />
            <Rectangle Width="1.5" Margin="2,0,0,0" Fill="{TemplateBinding BorderBrush}" />
        </StackPanel>
    </ControlTemplate>

    <!-- Mechanical track-mounted pointer cursor (▶▪). -->
    <ControlTemplate x:Key="PinTemplate" TargetType="Control">
        <Viewbox Width="11" Height="10" Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="12" Height="10">
                <Path Data="M0,1 L6,5 0,9 Z M8.5,2.5 L11,5 8.5,7.5 6,5 Z" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Original Black Box octagram + concentric diamond core. -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path Data="{DynamicResource IconMainMenu}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Rectilinear bracket ticks for keyboard focus. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,7 L0,0 7,0 7,2 2,2 2,7Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L7,0 7,7 5,7 5,2 0,2Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L2,0 2,5 7,5 7,7 0,7Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M5,0 L7,0 7,7 0,7 0,5 5,5Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBoxFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Steam Screenshots loading placeholder: breathes calmly while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel x:Name="Root" IsHitTestVisible="False" Opacity="0.4">
            <Border Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource MathConverter}, ConverterParameter='x * 9 / 16'}" />
                <Border Grid.Column="2" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="4" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="6" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}" />
                <Border Grid.Column="8" Background="{TemplateBinding Foreground}" Opacity="0.35" CornerRadius="{DynamicResource ControlCornerRadius}" />
            </Grid>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Breathe">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0.45" To="0.95" Duration="0:0:1.1">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="Breathe" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- EmptyGameTemplate: YoRHa Pod targeting reticle + Black Box octagram + diamond frieze + LOCErrorNoGameSelected. -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Grid Width="180" Height="136" HorizontalAlignment="Center" ClipToBounds="True">
                <Rectangle x:Name="PodReticleMask" Width="128" Height="128" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Fill="{TemplateBinding Foreground}" Opacity="0.48">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/pod-reticle.png'}" Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Ellipse Width="114" Height="114" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" StrokeDashArray="6 4" Opacity="0.55" />
                <Control x:Name="BlackBoxCore" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Template="{DynamicResource BrandMarkTemplate}" Foreground="{TemplateBinding Foreground}" Opacity="0.88" Focusable="False" />
            </Grid>
            <Grid Width="196" Margin="0,4,0,10" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0.45" />
                <Path Grid.Column="1" Margin="8,0" Width="8" Height="8" Stretch="Fill" Data="M4,0 L8,4 L4,8 L0,4 Z" Fill="{DynamicResource GlyphBrush}" />
                <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0.45" />
            </Grid>
            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center"
                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                       FontWeight="Bold" Foreground="{TemplateBinding Foreground}" Opacity="0.9" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="EmptyPodLoop">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PodReticleMask" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.32" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.68" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.32" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlackBoxCore" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyPodLoop" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
