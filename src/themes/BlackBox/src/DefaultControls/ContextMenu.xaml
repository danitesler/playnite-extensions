<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is NieR:Automata's YoRHa System Menu sheet (LocalYorhaPanelTemplate, shared by
    ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: rectilinear warm khaki-parchment telemetry sheet (PopupBackgroundBrush) in a 1px charcoal-olive border
      (PopupBorderBrush) with a 3px hard offset shadow plate (BevelShadowBrush, no DropShadowEffect) and a 5px charcoal
      header band carrying the musical double-bar tick on the left and a terracotta pip on the right.
    - Rows, rules and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalYorhaPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <!-- 3px hard offset shadow plate -->
            <Border Margin="3,3,0,0" Background="{DynamicResource BevelShadowBrush}" />
            <!-- Main parchment telemetry sheet -->
            <Border Margin="0,0,3,3" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" />
            <!-- 5px charcoal-olive YoRHa top header band with musical double-bar tick and terracotta pip -->
            <Grid Height="5" Margin="1,1,4,0" VerticalAlignment="Top" Background="{DynamicResource SelectedBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Rectangle Width="4" Height="3" Fill="{DynamicResource SelectedForegroundBrush}" />
                    <Rectangle Width="1" Height="3" Margin="2,0,0,0" Fill="{DynamicResource SelectedForegroundBrush}" />
                </StackPanel>
                <Rectangle Width="6" Height="3" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Fill="{DynamicResource SelectedBorderBrush}" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="228" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalYorhaPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="4,9,7,7" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
