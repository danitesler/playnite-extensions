<!--
    Black Box: GroupBox. Content-sized raised parchment card (no fixed widths >= 200 so Statistics cards wrap cleanly)
    topped by a charcoal-olive header band with the musical double-bar (▊▏) and ivory heading text.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border Margin="3,3,-3,-3" Background="{DynamicResource BevelShadowBrush}" IsHitTestVisible="False" />
                        <Border Background="{DynamicResource ExpanderBackgroundBrush}"
                                BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" MinHeight="28" Margin="{DynamicResource GroupBoxHeaderMargin}"
                                      Background="{DynamicResource HeaderBandBrush}">
                                    <DockPanel Margin="10,5,14,5" LastChildFill="True">
                                        <Control DockPanel.Dock="Left" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Template="{DynamicResource BookmarkTemplate}"
                                                 Foreground="{DynamicResource HighlightGlyphBrush}"
                                                 BorderBrush="{DynamicResource HeaderBandForegroundBrush}" Focusable="False" />
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                          TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                          TextElement.FontWeight="Bold"
                                                          TextElement.Foreground="{DynamicResource HeaderBandForegroundBrush}" />
                                    </DockPanel>
                                </Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
