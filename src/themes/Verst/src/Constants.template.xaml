<!--
    Verst: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    Verst's token names (vs-*) stay in tokens.css; here each placeholder names the token that plays the key's role.
    Iron dark surfaces, a burnt-orange flag for selection, prompt-orange accents, an oscilloscope (glass, graticule,
    phosphor), a glowing console display for Play and a spiral notebook (paper, ink). Theme XAML reads brushes only, never
    Color keys. Placeholder syntax: docs/themes/reference.md. Keep double braces out of comments here: the build renders
    them too.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Typography. Barlow Semi Condensed (body; Regular and SemiBold), Barlow Condensed (Bold: rows in caps, headings, the
         Play label) and Marck Script (the map's handwritten notes) are OFL stand-ins for the games' condensed grotesque and
         handwriting; all are bundled in src/Typography and lead their stacks as ./Typography/#Family. -->
    <sys:Double x:Key="FontSizeSmall">13</sys:Double>
    <sys:Double x:Key="FontSize">15</sys:Double>
    <sys:Double x:Key="FontSizeLarge">17</sys:Double>
    <sys:Double x:Key="FontSizeLarger">22</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow Semi Condensed, {{text:font-body|Barlow Semi Condensed}}, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Barlow Condensed, {{text:font-heading|Barlow Condensed}}, Arial Narrow, Segoe UI</FontFamily>
    <FontFamily x:Key="PosterFontFamily">./Typography/#Barlow Condensed, {{text:font-heading|Barlow Condensed}}, Arial Narrow, Segoe UI</FontFamily>
    <FontFamily x:Key="NoteFontFamily">./Typography/#Marck Script, {{text:font-note|Marck Script}}, Segoe Script, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width; apply inside the pane's horizontal padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center / Stretch (full width above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: stamped steel, nearly square corners. The CRT glass alone is rounded (CornerRadiusXLarge). -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-small|1}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-large|4}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:radius-xlarge|10}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{vs-chalk}}</Color>                       <!-- text on the iron -->
    <Color x:Key="TextColorDarker">{{vs-smoke}}</Color>                 <!-- idle rows, 5.5:1 -->
    <Color x:Key="TextColorDark">{{vs-void}}</Color>                    <!-- text on the ember accent -->
    <Color x:Key="MainColor">{{vs-plate}}</Color>                       <!-- control plate -->
    <Color x:Key="MainColorDark">{{vs-panel}}</Color>                   <!-- raised surfaces: panels, cards -->
    <Color x:Key="HoverColor">{{vs-plate-lit}}</Color>
    <Color x:Key="GlyphColor">{{vs-ember}}</Color>                      <!-- accent: prompt orange -->
    <Color x:Key="HighlightGlyphColor">{{vs-flag-hi}}</Color>
    <Color x:Key="PopupBackgroundColor">{{vs-panel}}</Color>            <!-- the pause panel -->
    <Color x:Key="PopupBorderColor">{{vs-rim}}</Color>
    <Color x:Key="BackgroundToneColor">{{vs-panel}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">#00000000</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{vs-rim}}</Color>
    <Color x:Key="DataChangeNotifColor">{{vs-ember}}</Color>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{vs-rim-lit}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{vs-paper}}" />       <!-- the ticker tape -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{vs-plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{vs-void}}" />      <!-- the unlit lamp well -->
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{vs-lamp}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{vs-rust}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{vs-amber}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{vs-amber}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{vs-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{vs-iron}}" />

    <!-- Surfaces and art -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{vs-iron}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{vs-iron}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{vs-panel}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the pause panel's
         dark (#1c1b1a), the darkest branded surface that is not the void. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{vs-panel}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{vs-plate}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{vs-ember}}" />

    <!-- Selection and states: the burnt-orange flag with white caps. -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{vs-flag}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{vs-flag-hi}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{vs-white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{vs-plate}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{vs-flag}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{vs-flag}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{vs-lamp}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{vs-ember}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{vs-rust}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{vs-white}}" />

    <!-- Buttons: steel plates; the default button is the console's stamped label plate. -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{vs-chalk}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{vs-white}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{vs-rim}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{vs-plate-lit}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{vs-plate-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{vs-coil}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{vs-paper-edge}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{vs-paper}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{vs-paper-shade}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{vs-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{vs-ember}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{vs-flag}}" />

    <!-- Inputs: a void well with a lit steel rim. -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{vs-rim-lit}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{vs-smoke}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{vs-rim-lit}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{vs-smoke}}" />

    <!-- Tracks and thumbs: phosphor segments, a flag lever, a steel scroll capsule. -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{vs-plate-lit}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{vs-flag}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{vs-flag-hi}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{vs-white}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{vs-plate}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{vs-ember}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{vs-rim-lit}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{vs-smoke}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{vs-plate}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{vs-rim-lit}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{vs-smoke}}" />

    <!-- Tabs, covers, shell items -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{vs-smoke}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{vs-chalk}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{vs-flag}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{vs-ember}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{vs-white}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{vs-plate}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{vs-flag}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{vs-smoke}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{vs-white}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{vs-flag-hi}}" />

    <!-- Metadata chips (on the CRT), menus, tooltips, dialogs -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{vs-crt}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{vs-phosphor}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{vs-phosphor}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{vs-rim}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{vs-ink}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{vs-paper-edge}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{vs-panel}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{vs-white}}" />

    <!-- Paper: the field notebook under the description and notes. -->
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{vs-paper}}" />
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{vs-paper-edge}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{vs-ink}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{vs-binder}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{vs-ink-dim}}" />
    <SolidColorBrush x:Key="ParchmentLinkBrush" Color="{{vs-binder}}" />
    <SolidColorBrush x:Key="CoilBrush" Color="{{vs-coil}}" />
    <SolidColorBrush x:Key="PaperRuleBrush" Color="{{vs-rule-blue}}" />
    <SolidColorBrush x:Key="PaperShadeBrush" Color="{{vs-paper-shade}}" />

    <!-- The oscilloscope: metadata pane, Settings section list, empty page. -->
    <SolidColorBrush x:Key="CrtGlassBrush" Color="{{vs-crt}}" />
    <SolidColorBrush x:Key="CrtCaseBrush" Color="{{vs-crt-deep}}" />
    <SolidColorBrush x:Key="CrtGridBrush" Color="{{vs-crt-grid}}" />
    <SolidColorBrush x:Key="PhosphorBrush" Color="{{vs-phosphor}}" />
    <SolidColorBrush x:Key="PhosphorDimBrush" Color="{{vs-phosphor-dim}}" />
    <SolidColorBrush x:Key="WaveformBrush" Color="{{vs-wave}}" />

    <!-- The console display: Play. -->
    <SolidColorBrush x:Key="DisplayGlassBrush" Color="{{vs-display}}" />
    <SolidColorBrush x:Key="DisplayDeepBrush" Color="{{vs-display-deep}}" />
    <SolidColorBrush x:Key="DisplayGlowBrush" Color="{{vs-display-glow}}" />
    <SolidColorBrush x:Key="DisplayHotBrush" Color="{{vs-display-hot}}" />

    <!-- Frames and headings -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{vs-rim}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{vs-plate-lit}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{vs-rim-lit}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{vs-rim}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{vs-white}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{vs-flag}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{vs-ember}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{vs-rim}}" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{vs-rim-lit}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{vs-iron}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{vs-ember}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{vs-rim}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{vs-rim}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{vs-iron}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{vs-flag-hi}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{vs-void}}" />   <!-- workbench tiles: More, Edit, cover buttons -->
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{vs-rim}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{vs-ember}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{vs-void}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{vs-ember}}" />
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{vs-ember}}" />

    <!-- The torn banner behind GroupBox, Expander and section headings, its speckle and its shadow. -->
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{vs-flag}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{vs-white}}" />
    <SolidColorBrush x:Key="StripeBrush" Color="{{vs-flag-hi}}" />
    <SolidColorBrush x:Key="StripeDeepBrush" Color="{{vs-flag-deep}}" />
</ResourceDictionary>
