<!--
    Verst: the icon set. Stencilled field-equipment glyphs on a 24 grid: straight 2-unit strokes, square caps, mitred
    corners, the plates and labels of the consoles in both games (no icon from either game is copied). The geometries
    are centre lines: IconTemplate strokes them in the control's Foreground and does not fill. A zero-length segment
    with square caps is a small square dot.
    Playnite's menu icons keep their icofont glyphs; only their hardcoded colors move onto theme brushes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Geometry x:Key="IconSearch">M17,10.5 A6.5,6.5 0 1 1 4,10.5 A6.5,6.5 0 1 1 17,10.5 M15.6,15.6 L20.5,20.5</Geometry>
