    <Geometry x:Key="IconUpdate">M20,12 A8,8 0 1 1 17.66,6.34 M18,2.5 V6.5 H14</Geometry>
    <Geometry x:Key="IconExplorer">M3,6.5 L9,4.5 L15,6.5 L21,4.5 V17.5 L15,19.5 L9,17.5 L3,19.5 Z M9,4.5 V17.5 M15,6.5 V19.5</Geometry>
    <Geometry x:Key="IconRandom">M4,4 H20 V20 H4 Z M8.5,8.5 L8.51,8.5 M15.5,15.5 L15.51,15.5 M12,12 L12.01,12 M15.5,8.5 L15.51,8.5 M8.5,15.5 L8.51,15.5</Geometry>
    <Geometry x:Key="IconViewRandom">M3,7 H7 L15,17 H20 M17,14 L20,17 L17,20 M3,17 H7 L9.5,13.9 M14.5,10.1 L15,9.5 L17,7 H20 M17,4 L20,7 L17,10</Geometry>
    <Geometry x:Key="IconFilter">M3,5 H21 L14,13 V19.5 L10,17.5 V13 Z</Geometry>
    <Geometry x:Key="IconNotifications">M6,17 V11 A6,6 0 0 1 18,11 V17 H6 M4,17 H20 M10,20.5 H14</Geometry>
    <Geometry x:Key="IconMainMenu">M4,6 H20 M4,12 H20 M4,18 H20</Geometry>
    <Geometry x:Key="IconLibrary">M4,4 H9 V20 H4 Z M11,4 H15 V20 H11 Z M16.5,5.2 L20.2,4.4 L22.8,19 L19.1,19.8 Z</Geometry>
    <Geometry x:Key="IconStatistics">M3,20 H21 M6,20 V14 M11,20 V8 M16,20 V11 M21,20 V4</Geometry>
    <Geometry x:Key="IconWindowMinimize">M5,12 H19</Geometry>
    <Geometry x:Key="IconWindowMaximize">M5,5 H19 V19 H5 Z</Geometry>
    <Geometry x:Key="IconWindowRestore">M5,9 H15 V19 H5 Z M9,9 V5 H19 V15 H15</Geometry>
    <Geometry x:Key="IconWindowClose">M5,5 L19,19 M19,5 L5,19</Geometry>
    <Geometry x:Key="IconDropDown">M6.5,9.5 L12,15 L17.5,9.5</Geometry>
    <Geometry x:Key="IconSubmenu">M9.5,6.5 L15,12 L9.5,17.5</Geometry>
    <Geometry x:Key="IconCheck">M5,12.5 L10,17.5 L19,7</Geometry>
    <Geometry x:Key="IconAdd">M12,4.5 V19.5 M4.5,12 H19.5</Geometry>
    <Geometry x:Key="IconEdit">M15,4 L20,9 L9,20 H4 V15 Z M12.5,6.5 L17.5,11.5</Geometry>
    <Geometry x:Key="IconRemove">M4.5,12 H19.5</Geometry>
    <Geometry x:Key="IconOptions">M5,12 L5.01,12 M12,12 L12.01,12 M19,12 L19.01,12</Geometry>
    <Geometry x:Key="IconPlay">M7,4.5 L19,12 L7,19.5 Z</Geometry>
    <Geometry x:Key="IconInfo">M20,12 A8,8 0 1 1 4,12 A8,8 0 1 1 20,12 M12,11 V16.5 M12,7.5 L12.01,7.5</Geometry>
    <Geometry x:Key="IconDownload">M12,3.5 V15 M6.5,9.5 L12,15 L17.5,9.5 M4,20 H20</Geometry>

    <DataTemplate x:Key="IconTemplate">
        <Viewbox MaxWidth="{DynamicResource IconSize}" MaxHeight="{DynamicResource IconSize}">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                      StrokeThickness="2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" StrokeLineJoin="Miter" StrokeMiterLimit="4" />
            </Canvas>
        </Viewbox>
    </DataTemplate>
    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox MaxWidth="12" MaxHeight="12">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                      StrokeThickness="2.4" StrokeStartLineCap="Square" StrokeEndLineCap="Square" StrokeLineJoin="Miter" StrokeMiterLimit="4" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentPresenter MaxWidth="14" MaxHeight="14" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentPresenter MaxWidth="16" MaxHeight="16" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <!-- Playnite menu icons with hardcoded colors in Default: red moves onto the danger red, yellow onto the cursor amber. -->
    <!-- Playnite menu icons: omit local Foreground so they inherit TextElement.Foreground from MenuItem and invert on highlight. -->
    <TextBlock x:Key="FullscreenModeIcon" Text="&#xea48;" FontFamily="{DynamicResource FontIcoFont}" FontWeight="Light" />
