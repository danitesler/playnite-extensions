    <Geometry x:Key="IconFilterPresets">M3,5 H15 L10.5,11 V17 L7.5,15.5 V11 Z M17.5,11 H21 M17.5,15 H21 M17.5,19 H21</Geometry>
    <Geometry x:Key="IconGroup">M3,5 H10.5 V11 H3 Z M13.5,5 H21 V11 H13.5 Z M3,14 H21 V19 H3 Z</Geometry>
    <Geometry x:Key="IconSort">M7,4 V20 M3.5,16.5 L7,20 L10.5,16.5 M17,20 V4 M13.5,7.5 L17,4 L20.5,7.5</Geometry>
    <Geometry x:Key="IconDetailsView">M3,5 H8 V19 H3 Z M11,6 H21 M11,10 H21 M11,14 H21 M11,18 H17</Geometry>
