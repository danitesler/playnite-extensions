<!--
    Verst: cover tiles, the workbench's part slots. Structure: Playnite Default 10.60 (GridViewItemStyle).
    Brushes: GridViewItemHoverBorderBrush (prompt-orange frame), GridViewItemSelectedBorderBrush (white frame), ShellBackgroundBrush
    (the black name strip and the bullet tab), SelectedForegroundBrush (strip text), ValueAccentBrush (the bullet), ScrimBrush
    (lamp strips), RunningIndicatorBrush (lamp green).
    Selected, static: a 2px white frame around the cover (the workbench's selected part) and the black header strip at the cover's
    foot with the game name in bold condensed caps. Hover, animated both ways and never reading as selected: a 2px prompt-orange
    frame fades in (0.12s), the bullet counter's black tab with an orange outlined cartridge drops from the cover's top-right edge
    (0.2s, PowerEase), the name strip slides up from below the cover's edge, and the cover lifts 2 percent on a named
    ScaleTransform inside the template. Leaving fades and withdraws, FillBehavior Stop. The strips hide while names are shown
    under covers. Everything is drawn inside the item spacing margin and the covers are clipped to a rounded shape in
    GridViewItemTemplate, so no corner patches are painted.
    Running game (docs/themes/reference.md): RunningIndicator is inset 4px so selection keeps the outer edge. It holds a thick
    green band, a 2px green frame in the cover's own radius, and two strips on the top and bottom edge with tunnel lamps passing in
    opposite directions: fast while launching, slow while running while the frame breathes. Selected and hovered items keep the
    indicator: nothing in the hover or selection triggers touches it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}" Margin="{Settings ItemSpacingMargin}" x:Name="ItemGrid" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="SelectScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <ContentPresenter x:Name="CoverPresenter" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform x:Name="CoverLift" ScaleX="1" ScaleY="1" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                        <!-- The strips and the tab live inside the cover's box, clipped to it. -->
                        <Grid x:Name="CoverDecor" ClipToBounds="True" IsHitTestVisible="False">
                            <!-- Selected, animated: the black header strip with the name. -->
                            <Grid x:Name="SelectedStrip" Visibility="Collapsed" Opacity="0" Height="26" VerticalAlignment="Bottom" Margin="2,0,2,2">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="StripSlide" Y="10" />
                                </Grid.RenderTransform>
                                <Border Background="{DynamicResource ShellBackgroundBrush}" Opacity="0.88" />
                                <TextBlock Text="{Binding DisplayName, Converter={StaticResource StringToUpperCaseConverter}}" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                           FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource SelectedForegroundBrush}" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,8,1" />
                            </Grid>
                        </Grid>
                        <!-- Hover frame and selected frame, 2px around the cover. -->
                        <Border x:Name="HoverFrame" Visibility="Collapsed" BorderThickness="2" Margin="-2" CornerRadius="{DynamicResource CornerRadiusLarge}" BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}"
                                Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="SelectionBorder" Visibility="Collapsed" Opacity="0" BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" BorderThickness="2" Margin="-2" CornerRadius="{DynamicResource CornerRadiusLarge}" IsHitTestVisible="False" />
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="6" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.16" />
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <Grid Height="12" Margin="2,2,2,0" VerticalAlignment="Top" ClipToBounds="True">
                                <Border Background="{DynamicResource ScrimBrush}" Opacity="0.8" />
                                <Canvas>
                                    <Control Template="{DynamicResource LampChainTemplate}" Foreground="{DynamicResource RunningIndicatorBrush}"
                                             Canvas.Left="-28" Canvas.Top="0" Width="900" Height="12" Focusable="False" IsTabStop="False">
                                        <Control.RenderTransform>
                                            <TranslateTransform x:Name="MarchTopShift" X="0" />
                                        </Control.RenderTransform>
                                    </Control>
                                </Canvas>
                            </Grid>
                            <Grid Height="12" Margin="2,0,2,2" VerticalAlignment="Bottom" ClipToBounds="True">
                                <Border Background="{DynamicResource ScrimBrush}" Opacity="0.8" />
                                <Canvas>
                                    <Control Template="{DynamicResource LampChainTemplate}" Foreground="{DynamicResource RunningIndicatorBrush}"
                                             Canvas.Left="-28" Canvas.Top="0" Width="900" Height="12" Focusable="False" IsTabStop="False">
                                        <Control.RenderTransform>
                                            <TranslateTransform x:Name="MarchBottomShift" X="0" />
                                        </Control.RenderTransform>
                                    </Control>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="HoverExit" />
                                <BeginStoryboard Name="HoverEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="CoverLift" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CoverLift" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="HoverExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="CoverLift" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CoverLift" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility" Duration="0:0:0.2">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="HoverEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedStrip" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="SelectExit" />
                                <BeginStoryboard Name="SelectEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Visibility" Duration="0:0:0">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SelectedStrip" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="StripSlide" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.985" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1">
                                                <EasingDoubleKeyFrame.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectScale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.985" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1">
                                                <EasingDoubleKeyFrame.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Name="SelectExit">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelectedStrip" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" Storyboard.TargetProperty="Visibility" Duration="0:0:0.14">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <RemoveStoryboard BeginStoryboardName="SelectEnter" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                        <!-- Names shown under covers already name the game: the strips step aside. -->
                        <DataTrigger Binding="{Settings ShowNamesUnderCovers}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SelectedStrip" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="MarchTopShift" Storyboard.TargetProperty="X" From="0" To="28" Duration="0:0:0.45" />
                                        <DoubleAnimation Storyboard.TargetName="MarchBottomShift" Storyboard.TargetProperty="X" From="0" To="-28" Duration="0:0:0.45" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MarchTopShift" Storyboard.TargetProperty="X" From="0" To="28" Duration="0:0:2.4" />
                                        <DoubleAnimation Storyboard.TargetName="MarchBottomShift" Storyboard.TargetProperty="X" From="0" To="-28" Duration="0:0:2.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
