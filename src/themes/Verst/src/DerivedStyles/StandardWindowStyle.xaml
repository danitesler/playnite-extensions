<!--
    Verst: dialog windows (Settings, game editor, add-ons). A 44px riveted steel band (CaptionHeight 44 = the content offset)
    with faint grain, closed by a 1px steel rule that carries a 96px prompt-orange segment: the console's stencil label plate
    (the tunnel mark and "KM 0") opens the title in bold condensed caps, the oscilloscope case's green lamp sits after it,
    and the console odometer counts at the right end before the caption buttons. 1px rim frames the window. The Settings
    window has no Title, so a trigger names it. Colors: WindowTitleBackgroundBrush, WindowTitleForegroundBrush,
    PrimaryButtonBackgroundBrush, PrimaryButtonForegroundBrush, FrameBrush, FrameHoverBrush, TopPanelRuleStartBrush,
    PositiveRatingBrush (the lamp, the same green as the running game but not its brush), TextBrush, ShellBackgroundBrush, PopupBorderBrush. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>
    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" ClipToBounds="True">
                                    <Border Background="{DynamicResource WindowTitleBackgroundBrush}" />
                                    <Control Template="{DynamicResource GrainTemplate}" Foreground="{DynamicResource TextBrush}" Opacity="0.04" Focusable="False" />
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource FrameBrush}" IsHitTestVisible="False" />
                                    <Rectangle Width="96" Height="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource TopPanelRuleStartBrush}" IsHitTestVisible="False" />
                                    <Ellipse Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" Fill="{DynamicResource FrameHoverBrush}" IsHitTestVisible="False" />
                                    <Ellipse Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,5" Fill="{DynamicResource FrameHoverBrush}" IsHitTestVisible="False" />
                                    <!-- PART_TextTitle keeps the real title (Playnite and the Settings trigger set it); the band shows an uppercase copy.
                                         Playnite makes this element visible once a window has a Title, and unstyled it draws bare text over the band's
                                         top-left corner. So it lives in a Collapsed parent (a collapsed parent hides it whatever its own Visibility)
                                         and is also zero-sized and transparent. -->
                                    <Border Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="{TemplateBinding Title}" x:Name="PART_TextTitle" Width="0" Height="0" Opacity="0" Foreground="Transparent" />
                                    </Border>
                                    <DockPanel Margin="14,0,150,0" LastChildFill="False" IsHitTestVisible="False">
                                        <!-- The stencil label plate. -->
                                        <Border DockPanel.Dock="Left" Height="26" Padding="6,0,8,0" VerticalAlignment="Center" CornerRadius="{DynamicResource CornerRadiusSmall}"
                                                Background="{DynamicResource PrimaryButtonBackgroundBrush}" SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal">
                                                <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource PrimaryButtonForegroundBrush}" Width="18" Height="18"
                                                         VerticalAlignment="Center" Focusable="False" />
                                                <TextBlock Text="KM 0" Margin="6,0,0,1" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                                           FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource PrimaryButtonForegroundBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Left" Margin="12,0,0,1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Text, ElementName=PART_TextTitle, Converter={StaticResource StringToUpperCaseConverter}}"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="{DynamicResource FontSizeLarger}"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}" />
                                        <!-- The case's green lamp: a core over a soft halo. -->
                                        <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="8,1,0,0" VerticalAlignment="Center">
                                            <Rectangle Fill="{DynamicResource PositiveRatingBrush}" Opacity="0.45">
                                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                                            </Rectangle>
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource PositiveRatingBrush}" />
                                        </Grid>
                                        <!-- The console odometer. -->
                                        <Control DockPanel.Dock="Right" VerticalAlignment="Center" Template="{DynamicResource OdometerTemplate}" Tag="004172"
                                                 Background="{DynamicResource TextBrush}" Foreground="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBackgroundBrush}" Focusable="False" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0">
                                        <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                        <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                    </StackPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
