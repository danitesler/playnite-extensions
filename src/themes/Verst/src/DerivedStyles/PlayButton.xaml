<!--
    Verst: Play, the handcar console's display. Structure: Playnite Default 10.60 (PlayButton); every Default state is kept.
    Brushes: DisplayGlassBrush (the lit glass, the button's Background), DisplayDeepBrush (the unlit glass under it, its top and foot
    shade, the inner rim, the press dip), DisplayGlowBrush (the hover surge), DisplayHotBrush (white-hot letters, the glow behind them,
    the scan band), SelectedForegroundBrush (hover letters), ButtonPressedBackgroundBrush and FrameHoverBrush (the riveted steel
    housing), ScrimBrush, ShellBackgroundBrush, RunningIndicatorBrush.
    Rest: a riveted steel housing (ControlCornerRadius) holding the glass 5px in: deep orange with the lit panel over it at 0.55, a darker
    top and foot, faint scanlines, the play triangle and the label in bold condensed caps (20px) in white-hot, 4.1:1 on the glass.
    Hover, both ways: the glass surges with a five-step flicker over 0.22s (DiscreteDoubleKeyFrame), a bloom rises around the housing
    (PowerEase 0.24s), the letter glow brightens, the inner rim turns white-hot, and a bright scan band runs down the glass once. The
    hit area never moves. Labels stay at 3.2:1 or better at the brightest frame (20px bold is large text; computed with the
    surge at its 0.2 peak and the letter glow at 0.08).
    Press, its own layer: the power dips (deep orange over the glass at 0.8), the letters flare and the face sinks 3 percent;
    release recovers in 0.22s. Leaving mid-press cannot strand the hover state.
    Running and launching: the glass fills with RunningIndicatorBrush (lamp green) with a void label and rim; the deep glass, shade
    and scanlines drop out. Launching: a dark band sweeps the glass. Running: a light scrim breathes over it. The RUNNING label shows
    Cancel only while the button itself is hovered (RelativeSource Self), and the hover layers stay off while it runs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite
        swaps Play for the context action (RUNNING). The overlay carries a faint green wash, a 1px green frame with a void
        keyline, and two strips of tunnel lamps: a dark band on the top and on the bottom edge with lamps passing along it,
        in opposite directions. Launching: the lamps pass fast (0.45s per lamp). Running: slow (2.4s per lamp) while the
        frame breathes 0.72 to 1. The bands sit at the edges and never reach the label, which sits in the middle 20px.
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching). One lamp pitch is 28px (lamp.png tile).
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border Margin="1" BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1" Opacity="0.6" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                        <Grid Height="10" Margin="4,2,4,0" VerticalAlignment="Top" ClipToBounds="True">
                            <Border Background="{DynamicResource ScrimBrush}" Opacity="0.82" CornerRadius="3,3,0,0" />
                            <Canvas>
                                <Control x:Name="MarchTop" Template="{DynamicResource LampChainTemplate}" Foreground="{DynamicResource RunningIndicatorBrush}"
                                         Canvas.Left="-28" Canvas.Top="-1" Width="600" Height="12" Focusable="False" IsTabStop="False">
                                    <Control.RenderTransform>
                                        <TranslateTransform x:Name="MarchTopShift" X="0" />
                                    </Control.RenderTransform>
                                </Control>
                            </Canvas>
                        </Grid>
                        <Grid Height="10" Margin="4,0,4,2" VerticalAlignment="Bottom" ClipToBounds="True">
                            <Border Background="{DynamicResource ScrimBrush}" Opacity="0.82" CornerRadius="0,0,3,3" />
                            <Canvas>
                                <Control x:Name="MarchBottom" Template="{DynamicResource LampChainTemplate}" Foreground="{DynamicResource RunningIndicatorBrush}"
                                         Canvas.Left="-28" Canvas.Top="-1" Width="600" Height="12" Focusable="False" IsTabStop="False">
                                    <Control.RenderTransform>
                                        <TranslateTransform x:Name="MarchBottomShift" X="0" />
                                    </Control.RenderTransform>
                                </Control>
                            </Canvas>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="MarchTopShift" Storyboard.TargetProperty="X" From="0" To="28" Duration="0:0:0.45" />
                                        <DoubleAnimation Storyboard.TargetName="MarchBottomShift" Storyboard.TargetProperty="X" From="0" To="-28" Duration="0:0:0.45" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MarchTopShift" Storyboard.TargetProperty="X" From="0" To="28" Duration="0:0:2.4" />
                                        <DoubleAnimation Storyboard.TargetName="MarchBottomShift" Storyboard.TargetProperty="X" From="0" To="-28" Duration="0:0:2.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource DisplayGlassBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DisplayHotBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DisplayDeepBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,0,14,1" />
        <Setter Property="FontFamily" Value="{DynamicResource PosterFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Hover: the display's light blooms around the housing. -->
                        <Control x:Name="Bloom" Template="{DynamicResource BloomTemplate}" Foreground="{DynamicResource DisplayGlassBrush}" Margin="-26" Opacity="0"
                                 IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                        <Grid x:Name="Face" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
                                    <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <!-- The riveted steel housing. -->
                            <Border x:Name="Housing" Background="{DynamicResource ButtonPressedBackgroundBrush}" BorderBrush="{DynamicResource FrameHoverBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False" />
                            <Control Template="{DynamicResource RivetsTemplate}" Foreground="{DynamicResource FrameHoverBrush}" Margin="-1" Focusable="False" IsTabStop="False" />
                            <!-- The glass: the unlit deep orange under the lit panel (the button's Background at 0.6), its darker top and foot. -->
                            <Border x:Name="GlassBase" Margin="5" Background="{DynamicResource DisplayDeepBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" IsHitTestVisible="False" />
                            <Border x:Name="Plate" Margin="5" Background="{TemplateBinding Background}" Opacity="0.55" CornerRadius="{DynamicResource CornerRadiusSmall}" IsHitTestVisible="False" />
                            <Rectangle x:Name="EdgeShade" Margin="5" Fill="{DynamicResource DisplayDeepBrush}" Opacity="0.75" IsHitTestVisible="False">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="0.3" />
                                        <GradientStop Color="#00000000" Offset="0.72" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Border x:Name="RunningBreath" Margin="5" Background="{DynamicResource ScrimBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="RunningScan" Margin="5" Visibility="Collapsed" Background="{DynamicResource ShellBackgroundBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0.25" IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="RunningHoverDim" Margin="5" Background="{DynamicResource ScrimBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                            <!-- Hover: the surge (flickers on), the glow behind the letters, the scan band that runs down the glass. -->
                            <Border x:Name="HoverPlate" Margin="5" Background="{DynamicResource DisplayGlowBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                            <Rectangle x:Name="LetterGlow" Margin="16,7" Fill="{DynamicResource DisplayHotBrush}" Opacity="0.05" IsHitTestVisible="False">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                            </Rectangle>
                            <Grid Margin="5" ClipToBounds="True" IsHitTestVisible="False">
                                <Rectangle x:Name="ScanBand" Height="10" VerticalAlignment="Top" Fill="{DynamicResource DisplayHotBrush}" Opacity="0">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="ScanShift" Y="-10" />
                                    </Rectangle.RenderTransform>
                                    <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                            <Rectangle x:Name="Scanlines" Margin="5" Fill="{DynamicResource DisplayDeepBrush}" Opacity="0.3" IsHitTestVisible="False">
                                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/scan.png'}" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,4,3" Stretch="Fill" /></Rectangle.OpacityMask>
                            </Rectangle>
                            <!-- Press: the power dips (the glass drops to deep orange). -->
                            <Border x:Name="PressedPlate" Margin="5" Background="{DynamicResource DisplayDeepBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                            <!-- The glass's inner rim: deep at rest, white-hot on hover. -->
                            <Border x:Name="OutlineRest" Margin="5" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" IsHitTestVisible="False" />
                            <Border x:Name="OutlineHover" Margin="5" BorderThickness="1" BorderBrush="{DynamicResource DisplayHotBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" Opacity="0" IsHitTestVisible="False" />
                            <StackPanel x:Name="LabelRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <Path x:Name="PlayGlyph" Data="M0,0 L10,6 L0,12 Z" Width="10" Height="12" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                <ContentPresenter x:Name="PlayContent" VerticalAlignment="Center" RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                            <StackPanel x:Name="LabelRowHover" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Opacity="0" IsHitTestVisible="False">
                                <Path x:Name="PlayGlyphHover" Data="M0,0 L10,6 L0,12 Z" Width="10" Height="12" Fill="{DynamicResource SelectedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                <ContentPresenter x:Name="PlayContentHover" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource SelectedForegroundBrush}">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <AccessText Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                            <ContentPresenter x:Name="CancelLabel" Content="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type sys:String}">
                                        <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayGlyphHover" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Hover and press: only while the game is not launching or running. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayHoverIn">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.16" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="0.03" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="0.2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.16" Value="0.12" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="0.18" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><PowerEase Power="3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LetterGlow" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="OutlineHover" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="OutlineRest" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="LabelRowHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="LabelRow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScanBand" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="0.35" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.36" Value="0.35" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.42" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ScanShift" Storyboard.TargetProperty="Y" From="-10" To="36" Duration="0:0:0.42" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="PlayHoverOut">
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LetterGlow" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.25" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="OutlineHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="OutlineRest" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LabelRowHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LabelRow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ScanBand" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayPressIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="LetterGlow" Storyboard.TargetProperty="Opacity" To="0.15" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.99" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="PlayPressOut">
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LetterGlow" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.22" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LetterGlow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="GlassBase" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EdgeShade" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Scanlines" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Plate" Property="Opacity" Value="1" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.1" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.5">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bloom" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LetterGlow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="GlassBase" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EdgeShade" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Scanlines" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Plate" Property="Opacity" Value="1" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:2.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.04" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.12" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.04" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Hidden" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Launching and running keep Play's housing; the glass fills with the running colour (lamp green) with void text. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
