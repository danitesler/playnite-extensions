<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu,
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is Metro's riveted dark-iron pause panel: PopupBackgroundBrush with subtle
    GrainTemplate texture, 1px PopupBorderBrush rim, 2px corners, four 3px corner rivets (FrameHoverBrush), a 56px
    prompt-orange top power strip (GlyphBrush) and a 5px green case lamp (PositiveRatingBrush) top-right
    (LocalMenuPanelTemplate, shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and
    CustomControls/FilterSelectionBox.xaml). Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Control Template="{DynamicResource GrainTemplate}" Margin="1"
                     Foreground="{DynamicResource TextBrush}" Opacity="0.05"
                     Focusable="False" IsTabStop="False" />
            <!-- 56px prompt-orange top power segment and 5px green case lamp top-right -->
            <Rectangle Width="56" Height="2" Margin="10,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="{DynamicResource GlyphBrush}" />
            <Ellipse Width="5" Height="5" Margin="0,4,10,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="{DynamicResource PositiveRatingBrush}" />
            <!-- Four corner rivets -->
            <Rectangle Width="3" Height="3" Margin="4,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="{DynamicResource FrameHoverBrush}" Opacity="0.7" />
            <Rectangle Width="3" Height="3" Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Fill="{DynamicResource FrameHoverBrush}" Opacity="0.7" />
            <Rectangle Width="3" Height="3" Margin="4,0,0,4" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Fill="{DynamicResource FrameHoverBrush}" Opacity="0.7" />
            <Rectangle Width="3" Height="3" Margin="0,0,4,4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Fill="{DynamicResource FrameHoverBrush}" Opacity="0.7" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,10,0,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="5,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
