<!--
    Verst: GroupBox. A pause-panel card (ExpanderBackgroundBrush, CornerRadiusLarge, 1px FrameBrush rim, GroupBoxPadding) under the
    loading screen's torn banner: RibbonTemplate in HeaderBandBrush with its speckle in StripeBrush, 30px tall, the title in bold
    condensed caps (HeadingFontFamily, uppercase through StringToUpperCaseConverter when the header is text) in
    HeaderBandForegroundBrush. The banner overlaps the card's top edge by 10px and starts 4px outside it, as the Exodus banner
    sticks out past its panel. The template is content-sized (Statistics sections wrap as cards): no fixed or stretched wide art,
    the banner takes its width from its text and RibbonTemplate reports no width of its own. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="1" Margin="0,-10,0,0" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusLarge}">
                            <Border Padding="0,10,0,0">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Border>
                        <Grid Grid.Row="0" Panel.ZIndex="1" Height="30" Margin="-4,0,0,0" HorizontalAlignment="Left">
                            <Control Template="{DynamicResource RibbonTemplate}" Foreground="{DynamicResource HeaderBandBrush}" BorderBrush="{DynamicResource StripeBrush}"
                                     Focusable="False" IsHitTestVisible="False" />
                            <TextBlock Margin="14,0,40,1" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold"
                                       FontSize="{DynamicResource FontSizeLarge}" Foreground="{DynamicResource HeaderBandForegroundBrush}">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                  RecognizesAccessKey="True" />
                            </TextBlock>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
