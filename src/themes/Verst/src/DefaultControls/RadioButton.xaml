<!--
    Verst: RadioButton. An indicator lens: an 18px round void well (CheckBoxCheckMarkBkBrush, CornerRadius 9 on an 18x18
    square) in a 1px CheckBoxBorderBrush rim, hover CheckBoxHoverBorderBrush. Checked lights a 9px prompt-orange lens
    (CheckMarkBrush) over a soft halo with the lamp's two-frame flicker. Focus is FocusVisual. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Border x:Name="Lens" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Center"
                                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                    Background="{DynamicResource CheckBoxCheckMarkBkBrush}">
                                <Grid>
                                    <Rectangle x:Name="Halo" Width="16" Height="16" Fill="{DynamicResource CheckMarkBrush}" Opacity="0" IsHitTestVisible="False">
                                        <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Ellipse x:Name="Dot" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                                             IsHitTestVisible="False" Fill="{DynamicResource CheckMarkBrush}" />
                                </Grid>
                            </Border>
                        </BulletDecorator.Bullet>
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter RecognizesAccessKey="True" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="Lens" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource CheckMarkBrush}" TargetName="Lens" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="0.2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.1" To="0.55" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
