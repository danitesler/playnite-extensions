<!--
    Verst: Button. A stamped steel plate with a 1px rim and a 1px lit top edge (ButtonBackgroundBrush, ButtonBorderBrush,
    BevelLightBrush, ButtonForegroundBrush). Hover: ButtonHoverBackgroundBrush fades in as its own layer, the label turns
    ButtonHoverForegroundBrush and a 2px prompt-orange lamp line lights along the foot (PrimaryButtonGlowBrush) with a short
    flicker. Pressed is another layer (ButtonPressedBackgroundBrush) and sinks the plate 1px.
    The dialog default button (IsDefault) is the console's ivory label plate (PrimaryButtonBackgroundBrush, ink text in the
    bold condensed face, a rivet at each end); hover brightens it to paper (PrimaryButtonHoverBackgroundBrush).
    Focus is FocusVisual (keyboard only). Disabled is BaseStyle's ghost.
    Width 41 trigger: ThemeModifier's icon buttons (32x32 through LayoutTransform). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="Lift" X="0" Y="0" />
                        </Grid.RenderTransform>
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="HoverPlate" Margin="{TemplateBinding BorderThickness}" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource ButtonHoverBackgroundBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                        <Border x:Name="PressedPlate" Margin="{TemplateBinding BorderThickness}" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource ButtonPressedBackgroundBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}" />
                        <Rectangle x:Name="TopEdge" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Opacity="0.6" IsHitTestVisible="False" />
                        <Rectangle x:Name="LampLine" Height="2" Margin="3,0,3,1" VerticalAlignment="Bottom" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Grid x:Name="Ring" Visibility="Collapsed" IsHitTestVisible="False">
                            <Ellipse Width="3" Height="3" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource PrimaryButtonBorderBrush}" />
                            <Ellipse Width="3" Height="3" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource PrimaryButtonBorderBrush}" />
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TopEdge" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="PressedPlate" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LampLine" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="0.15" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.09" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="LampLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LampLine" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
                <Setter Property="Padding" Value="24,4" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
