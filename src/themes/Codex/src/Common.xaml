<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    The menus are built from three marks: a hairline, a diamond, and four corner brackets around whatever is current.
    CornerMarksTemplate and DividerTemplate turn the last two into one reusable piece each (drawn in the Foreground of
    the Control that hosts them, so a brush key recolors them); HeadingTextBlock is the caption style above a block.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Four 9px brackets, 1.5px wide, one per corner of the host. Host: a Control with Foreground set and hit testing off,
         stretched over the item it marks (hover, selection, keyboard focus). -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderThickness="1.5,1.5,0,0" BorderBrush="{TemplateBinding Foreground}" />
            <Border Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                    BorderThickness="0,1.5,1.5,0" BorderBrush="{TemplateBinding Foreground}" />
            <Border Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    BorderThickness="0,0,1.5,1.5" BorderBrush="{TemplateBinding Foreground}" />
            <Border Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    BorderThickness="1.5,0,0,1.5" BorderBrush="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>

    <!-- A diamond at the left end and a hairline that fades out to the right. Host: a Control with Foreground set;
         it is 9px tall and as wide as its parent gives it. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="{x:Type Control}">
        <Grid Height="9" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Rectangle Height="1" Margin="12,0,0,0" VerticalAlignment="Center"
                       Fill="{TemplateBinding Foreground}" Opacity="0.7">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="5" Height="5" Margin="1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="45" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Caption above a block of properties, a description or notes: the heading serif in small caps (fonts without
         small caps show it as typed), in the secondary ink so the gold stays for the marks. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <!-- Keyboard focus (WPF shows it for the keyboard only): the four gold corner brackets, hugging the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Margin="-3" IsHitTestVisible="False" Focusable="False"
                             Template="{DynamicResource CornerMarksTemplate}"
                             Foreground="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing: roomier than a desktop app, like the menus (32 to 36px controls, 8px rhythm). -->
    <Thickness x:Key="ButtonPadding">18,5,18,5</Thickness> <!-- Button: 36px tall inside the 1px edge (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">10,5,10,5</Thickness> <!-- Text box, password box, dropdown: 34px (height now set by ControlHeight) -->
    <Thickness x:Key="MenuPadding">4</Thickness> <!-- Menu and context menu surface -->
    <Thickness x:Key="MenuItemPadding">14,8,14,8</Thickness> <!-- Menu item: 34px -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness> <!-- Dropdown surface -->
    <Thickness x:Key="ComboBoxItemPadding">12,7,12,7</Thickness> <!-- Dropdown item -->
    <Thickness x:Key="ListBoxItemPadding">12,7,12,7</Thickness> <!-- List box item -->
    <Thickness x:Key="GroupBoxPadding">16</Thickness> <!-- Group box body -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness> <!-- Gap under the group box header -->
    <Thickness x:Key="TooltipPadding">12,7,12,8</Thickness> <!-- Tooltip -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">20</sys:Double> <!-- Top bar and sidebar icons -->
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, so the real carousel replaces it without the page jumping. Each Viewbox scales a fixed 1600px
         layout to the width its column gives it (height is unbounded in a vertical stack). The tiles are the host's
         Foreground at low opacity; the whole thing pulses while visible. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the plugin's ContentControl, visible while that control has no height. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="16"
                        Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- menu-mark begin LocalCodexMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): menu lines around a diamond, the Animus sync diamond. Hover (IsMouseOver): the hairlines unsheathe from the diamond (half length to full, 0.22s, the second pair 50ms later) while a gold gem springs up inside it. Open (ContextMenu.IsOpen of the nearest Border): four gold corner brackets close in from 1.35 to 1 around the diamond and a gold outline breathes (1.2s, auto-reversed) until the menu closes; exits restore every property. -->
    <ControlTemplate x:Key="LocalCodexMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="26" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Path Data="M13,3.5 L18.5,9 L13,14.5 L7.5,9Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" StrokeLineJoin="Miter" />
                <Rectangle x:Name="LL1" Canvas.Left="0" Canvas.Top="5.4" Width="5.5" Height="1.2" RenderTransformOrigin="1,0.5" Fill="{TemplateBinding Foreground}">
                    <Rectangle.RenderTransform><ScaleTransform x:Name="LL1S" ScaleX="0.5" ScaleY="1" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="LL2" Canvas.Left="0" Canvas.Top="11.4" Width="5.5" Height="1.2" RenderTransformOrigin="1,0.5" Fill="{TemplateBinding Foreground}">
                    <Rectangle.RenderTransform><ScaleTransform x:Name="LL2S" ScaleX="0.5" ScaleY="1" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="RL1" Canvas.Left="20.5" Canvas.Top="5.4" Width="5.5" Height="1.2" RenderTransformOrigin="0,0.5" Fill="{TemplateBinding Foreground}">
                    <Rectangle.RenderTransform><ScaleTransform x:Name="RL1S" ScaleX="0.5" ScaleY="1" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="RL2" Canvas.Left="20.5" Canvas.Top="11.4" Width="5.5" Height="1.2" RenderTransformOrigin="0,0.5" Fill="{TemplateBinding Foreground}">
                    <Rectangle.RenderTransform><ScaleTransform x:Name="RL2S" ScaleX="0.5" ScaleY="1" /></Rectangle.RenderTransform>
                </Rectangle>
                <Canvas x:Name="GemWrap" Width="26" Height="18" RenderTransformOrigin="0.5,0.5" Opacity="0">
                    <Canvas.RenderTransform><ScaleTransform x:Name="GemS" ScaleX="0.2" ScaleY="0.2" /></Canvas.RenderTransform>
                    <Path Data="M13,6.3 L15.7,9 L13,11.7 L10.3,9Z" Fill="{DynamicResource GlyphBrush}" />
                </Canvas>
                <Path x:Name="Halo" Data="M13,1.8 L20.2,9 L13,16.2 L5.8,9Z" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" Opacity="0" />
                <Canvas x:Name="Brackets" Width="26" Height="18" RenderTransformOrigin="0.5,0.5" Opacity="0">
                    <Canvas.RenderTransform><ScaleTransform x:Name="BrS" ScaleX="1.35" ScaleY="1.35" /></Canvas.RenderTransform>
                    <Path Data="M5,5 L5,0.5 L9.5,0.5 M16.5,0.5 L21,0.5 L21,5 M5,13 L5,17.5 L9.5,17.5 M16.5,17.5 L21,17.5 L21,13" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.2" />
                </Canvas>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LL1S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RL1S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LL2S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.220" BeginTime="0:0:0.050"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RL2S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.220" BeginTime="0:0:0.050"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GemS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.260" BeginTime="0:0:0.040"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GemS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.260" BeginTime="0:0:0.040"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GemWrap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.140" BeginTime="0:0:0.040"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LL1S" Storyboard.TargetProperty="ScaleX" To="0.5" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RL1S" Storyboard.TargetProperty="ScaleX" To="0.5" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LL2S" Storyboard.TargetProperty="ScaleX" To="0.5" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RL2S" Storyboard.TargetProperty="ScaleX" To="0.5" Duration="0:0:0.176" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GemS" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.208" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GemS" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.208" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GemWrap" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.120" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="BrS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.280"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BrS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.280"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Brackets" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" From="0.15" To="0.6" Duration="0:0:1.200" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BrS" Storyboard.TargetProperty="ScaleX" To="1.35" Duration="0:0:0.224" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BrS" Storyboard.TargetProperty="ScaleY" To="1.35" Duration="0:0:0.224" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Brackets" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.960" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalCodexMenuMarkTemplate -->
</ResourceDictionary>
