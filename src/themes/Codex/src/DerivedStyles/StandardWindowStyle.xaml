<!--
    Codex: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    A masthead 44px tall on the slate panel colour: a hairline above and two rules below (hairline, then the strong
    rule), and the title on a plate of four gold corner brackets with a gold diamond before it, in the heading serif
    in small caps. Caption buttons are the 40x32 WindowBarButton, so the caption and the content offset are 44
    (Default 25). PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource NormalBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource ExpanderBackgroundBrush}" ClipToBounds="True">
                                    <!-- Masthead: a hairline above, a hairline and the strong rule below, the diamond-and-fading-rule divider under the title. -->
                                    <Rectangle Height="1" VerticalAlignment="Top" Margin="12,4,12,0" Fill="{DynamicResource WindowPanelSeparatorBrush}" IsHitTestVisible="False" />
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Margin="12,0,12,4" Fill="{DynamicResource WindowPanelSeparatorBrush}" IsHitTestVisible="False" />
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource NormalBorderBrush}" IsHitTestVisible="False" />
                                    <DockPanel LastChildFill="False">
                                        <!-- The title plate: four gold corner brackets around a diamond and the title in the heading serif, small caps. -->
                                        <Grid DockPanel.Dock="Left" Margin="14,8,0,9">
                                            <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                                            <StackPanel Orientation="Horizontal" Margin="18,0,22,0" VerticalAlignment="Center">
                                                <Path Data="M0,4 L4,0 L8,4 L4,8 Z" Width="8" Height="8" Stretch="None" Fill="{DynamicResource GlyphBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}" FontWeight="SemiBold"
                                                           Typography.Capitals="AllSmallCaps"
                                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                           Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,10,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
