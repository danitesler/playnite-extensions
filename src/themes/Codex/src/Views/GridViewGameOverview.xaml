<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml.
    The game info panel beside the cover grid: the same short background band as the details page (290px, tinted and scrimmed, faded
    into the panel), then the entry-screen header (title in the heading serif, gold divider, action buttons), then
    two columns: Steam screenshots, description and notes on the left, Game details on the right (every metadata field in one pane of six groups split by hairlines, each group hidden with its fields), each under a
    small-caps heading and a divider. The panel is on the panel layer with a hairline on the side facing the grid. Every PART_ name is Playnite's; the pane lays the fields out itself.
    HtmlForeground and LinkForeground are Color-typed properties of HtmlTextView,
    so they read Color keys (the build check allows exactly these two attributes).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border x:Name="PageRoot" Padding="20,0,20,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            Background="{DynamicResource TopPanelBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Same short background band as the details page. Hidden when the game has no art. -->
                            
                        <DockPanel>


                            <DockPanel DockPanel.Dock="Top">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <ScrollViewer DockPanel.Dock="Top" HorizontalAlignment="Stretch"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                              x:Name="PART_ScrollViewHost">
<!-- The header scrolls with the page (not pinned above it). -->
<Grid>
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" Margin="0,8,0,0" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- No OpacityMask on the banner: it sits behind the animated Play button, and masked art repainted in part leaves dark seams
                                     on scaled displays. The fade is a plain gradient to the page color, read from the page's own brush. -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#00000000" Offset="0.12" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.96" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
<StackPanel Margin="20,0,20,0">
<Border DockPanel.Dock="Top"  IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 84 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,0">
                                    <Image Name="PART_ImageIcon" DockPanel.Dock="Left" MaxHeight="32" MaxWidth="32"
                                           RenderOptions.BitmapScalingMode="Fant" Margin="0,0,12,0" />
                                    <TextBlock Name="PART_TextDisplayName"
                                               FontFamily="{DynamicResource HeadingFontFamily}"
                                               FontSize="{DynamicResource FontSizeLargest}"
                                               Typography.Capitals="SmallCaps"
                                               TextWrapping="Wrap" DockPanel.Dock="Left"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                </DockPanel>

                                <Grid DockPanel.Dock="Top" Margin="0,16,0,24" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Name="PART_ButtonPlayAction" Grid.Column="0"
                                            Height="40" Style="{DynamicResource PlayButton}" />
                                    <Button Name="PART_ButtonContextAction"
                                            Height="40" Grid.Column="0" />
                                    <Button Name="PART_ButtonMoreActions" Grid.Column="1"
                                            Width="40" Height="40" Padding="0" Margin="10,0,0,0"
                                            ToolTip="{DynamicResource LOCMoreAction}" Focusable="False">
                                        <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                        Content="{DynamicResource IconOptions}"
                                                        ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                    <Button x:Name="PART_ButtonEditGame" Grid.Column="2"
                                            Margin="10,0,8,0" Height="40" Width="40" Padding="0" Focusable="False" ToolTip="{DynamicResource LOCEditGame}">
                                        <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                        Content="{DynamicResource IconEdit}"
                                                        ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                </Grid>

                                
                                    <Grid VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="2" Width="{DynamicResource GridDetailsPaneWidth}" Margin="0,0,0,24" VerticalAlignment="Top">
                                            <TextBlock Text="{DynamicResource LOCGameDetails}" Margin="0,4,0,0"
                                                       Style="{DynamicResource HeadingTextBlock}" />
                                            <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />

                                            <Border ClipToBounds="True">
                                                <StackPanel Margin="0,-33,0,-8">
                                                    <Border x:Name="MetaProgress" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <Button Grid.Column="2" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextPlayTime" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextLastActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaScores" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCUserScore}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaAbout" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCDevelopersLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsDevelopers" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCPublishersLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsPublishers" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <Button Grid.Column="2" x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCSeriesLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsSeries" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsAgeRatings" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemRegion" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCRegionLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsRegions" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaTags" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemPlatform" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCPlatformsTitle}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,2,0,-6">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemGenres" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGenresLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,2,0,-6">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemCategories" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCategoriesLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,2,0,-6">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemFeatures" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,2,0,-6">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemTags" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCTagsLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsTags" Tag="Chip" Margin="0,2,0,-6">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaLibrary" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemLibrary" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGameProviderTitle}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <Button Grid.Column="2" x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemSource" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCSourceLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <Button Grid.Column="2" x:Name="PART_ButtonSource" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemVersion" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCVersionLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <Button Grid.Column="2" x:Name="PART_ButtonVersion" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemInstallSize" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCInstallSizeLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextInstallSize" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemInstallDirectory" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGameInstallDirTitle}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <Button Grid.Column="2" x:Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaLinks" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemLinks" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCLinksLabel}" Style="{DynamicResource HeadingTextBlock}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsLinks" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="0" Margin="0,0,0,0">
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library or Steam source games in that gap; give up after 12s so a game without screenshots does not keep an empty block. When the plugin is not installed or is disabled the binding fails, FallbackValue=PluginUnavailable matches neither True nor False, and no skeleton shows. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                    <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                    <Condition Binding="{Binding Game.Source}" Value="Steam" />
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SteamScreenshotsLoadingSource">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                                <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </MultiDataTrigger.EnterActions>
                                                                <MultiDataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoadingSource" />
                                                                </MultiDataTrigger.ExitActions>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <StackPanel Margin="0,0,0,24">
                                                    <TextBlock Text="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}"
                                                               Style="{DynamicResource HeadingTextBlock}" />
                                                    <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />
                                                    <Grid>
                                                        <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                        <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                            <Control.Style>
                                                                <Style TargetType="Control">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Control.Style>
                                                        </Control>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Name="PART_ElemDescription" Margin="0,0,8,16">
                                                <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}"
                                                           Style="{DynamicResource HeadingTextBlock}" />
                                                <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />
                                                <HtmlTextView Name="PART_HtmlDescription"
                                                              HtmlFontSize="{DynamicResource FontSize}"
                                                              HtmlFontFamily="{DynamicResource FontFamily}"
                                                              HtmlForeground="{DynamicResource TextColor}"
                                                              LinkForeground="{DynamicResource GlyphColor}"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                              pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                            </StackPanel>

                                            <StackPanel Name="PART_ElemNotes" Margin="0,0,8,12">
                                                <TextBlock Text="{DynamicResource LOCNotesLabel}"
                                                           Style="{DynamicResource HeadingTextBlock}" />
                                                <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="0,8,0,12" />
                                                <TextBox Name="PART_TextNotes" IsReadOnly="True"
                                                         BorderThickness="0" Background="Transparent"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         Margin="-1,0,-1,0" Padding="0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
</Grid>
</ScrollViewer>
                            </DockPanel>
                        </DockPanel>
<!-- Empty state (no game selected): the theme's mark, a diamond split by a blade. An outer diamond drawn as a marching dotted line,
                         a gold diamond inside it, a hairline blade through both and a pulsing core, in corner brackets; under it
                         Playnite's "No game selected" in small caps over the diamond divider. Centered in the visible area. The loops run
                         only while it shows (RemoveStoryboard on exit). -->
                    <Grid >
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                            <Grid Width="120" Height="120" HorizontalAlignment="Center">
                                <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource TextBrushDarker}" Margin="-14" Opacity="0.6" />
                                <Path Data="M60,2 L118,60 L60,118 L2,60 Z" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="1" StrokeDashArray="2 4" StrokeDashOffset="0">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="DiamondMarch">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-6" Duration="0:0:1.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="DiamondMarch" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Data="M60,26 L94,60 L60,94 L26,60 Z" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5" StrokeMiterLimit="4" />
                                <Path Data="M60,8 L60,112" Stroke="{DynamicResource TextBrush}" StrokeThickness="1" Opacity="0.45" />
                                <Path Data="M60,48 L72,60 L60,72 L48,60 Z" Fill="{DynamicResource GlyphBrush}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="CorePulse">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.8">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="CorePulse" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,30,0,0"
                                       FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}"
                                       Typography.Capitals="AllSmallCaps" Foreground="{DynamicResource TextBrushDarker}" />
                            <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource GlyphBrush}" Width="160" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,32,0" Width="36" Height="36"
                                Focusable="False" Cursor="Hand"
                                Foreground="{DynamicResource TextBrush}" Background="{DynamicResource ButtonBackgroundBrush}"
                                Command="{MainViewModel CloseGameSideBarCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource NormalBorderBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <ContentPresenter Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Content="{DynamicResource IconWindowClose}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DangerBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
</Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>