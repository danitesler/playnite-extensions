<!--
    Codex: Constants.xaml template. scripts/build-theme.ps1 fills the double-brace placeholders from
    tokens.css and writes the result to the build as Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo: Playnite's
    palette keys, then shared keys for roles Playnite has none for. Each placeholder names the token that plays the
    role (gold is the accent, ivory the ink, void and night the surfaces), so the values live in tokens.css and here
    only. Theme XAML reads the brushes (never the Color keys), so ThemeModifier edits reach every control.

    Layering, deepest first: void (window, icon rail), night (library), slate (panels, top bar), slate-popup (menus).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). HeadingFontFamily is a shared key: titles and section headings. -->
    <sys:Double x:Key="FontSizeSmall">{{px:size-caption}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:size-body}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:size-lead}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:size-title}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:size-display}}</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Georgia}}</FontFamily>

    <!-- Shape (Playnite keys): hairline strokes, square corners (ControlCornerRadius is 0 and no other radius step is needed). -->
    <Thickness x:Key="PopupBorderThickness">{{px:stroke-hair}}</Thickness>
    <Thickness x:Key="ControlBorderThickness">{{px:stroke-hair}}</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">{{px:stroke-hair}}</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:corner-none}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>


    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor (selection, checked, links) is the gold; TextColorDark is the ink used on gold fills.
        HoverColor is a translucent ivory veil so one value works on every surface. PopupBorderColor is flattened
        onto the popup surface because WPF popups are layered windows.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{ivory}}</Color>
    <Color x:Key="TextColorDarker">{{ivory-soft}}</Color>
    <Color x:Key="TextColorDark">{{on-gold}}</Color>
    <Color x:Key="MainColor">{{slate}}</Color>
    <Color x:Key="MainColorDark">{{night}}</Color>
    <Color x:Key="HoverColor">{{veil-strong}}</Color>
    <Color x:Key="GlyphColor">{{gold}}</Color>
    <Color x:Key="HighlightGlyphColor">{{gold-haze}}</Color>
    <Color x:Key="PopupBackgroundColor">{{slate-popup}}</Color>
    <Color x:Key="PopupBorderColor">{{rule-strong@slate-popup}}</Color>
    <Color x:Key="BackgroundToneColor">{{slate}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{slate/70}}</Color>   <!-- the slot behind each cover -->
    <Color x:Key="PanelSeparatorColor">{{rule}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{rule}}</Color>
    <Color x:Key="DataChangeNotifColor">{{amber}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{rule-strong}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{slate-popup}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{veil}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{verdant}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{crimson-bright}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{amber}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{crimson-bright}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{slate}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{void}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{night}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{slate}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{void/60}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{void/85}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{ivory-soft}}" />

    <!-- States: gold marks the current item, a wash of it fills the row -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{gold-wash}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{gold-haze}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{ivory}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{veil}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{gold-wash}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{veil-strong}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{ivory}}" />

    <!-- Buttons: outlined glass at rest, gold wash pressed; the default button and Play are solid gold -->
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{veil-strong}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{gold-wash}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{gold-bright}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{on-gold}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{gold-wash}}" />

    <!-- Inputs: a dark inset with a hairline edge, dull gold on hover, gold on focus -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{void/60}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{gold-deep}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{ivory-soft}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{rule-strong}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{night}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{gold-bright}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{gold-bright}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{rule}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{rule-strong}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{veil}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{rule-strong}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{gold}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{ivory-soft}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{gold-bright}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{veil-strong}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{gold-wash}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{rule}}" />
</ResourceDictionary>
