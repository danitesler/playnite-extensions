<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is an Assassin's Creed Codex entry card (LocalAnimusCodexPanelTemplate, shared by
    ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: square dark slate card (PopupBackgroundBrush) in a 1px hairline border (PopupBorderBrush), crowned by a
      gold-and-hairline masthead rule centered on a hollow gold diamond split by a vertical Animus blade, and closed by
      a hairline footer rule. No DropShadowEffect.
    - Rows, rules and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalAnimusCodexPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" />
            <!-- Masthead hairline rule + centered hollow gold diamond split by a vertical Animus blade -->
            <Grid Height="9" Margin="8,2,8,0" VerticalAlignment="Top">
                <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource PanelSeparatorBrush}" />
                <Rectangle Width="56" Height="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Fill="{DynamicResource GlyphBrush}" Opacity="0.7" />
                <Grid Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="{DynamicResource PopupBackgroundBrush}">
                    <Path Width="7" Height="7" Stretch="Fill" Data="M 3.5,0 L 7,3.5 L 3.5,7 L 0,3.5 Z"
                          Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" Fill="Transparent" />
                    <Rectangle Width="1" Height="9" Fill="{DynamicResource GlyphBrush}" />
                </Grid>
            </Grid>
            <!-- Subtle bottom hairline inset -->
            <Rectangle Height="1" Margin="8,0,8,3" VerticalAlignment="Bottom"
                       Fill="{DynamicResource PanelSeparatorBrush}" Opacity="0.6" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="228" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalAnimusCodexPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="4,12,4,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
