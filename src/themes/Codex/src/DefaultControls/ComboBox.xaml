<!--
    Overlay on Playnite Default/DefaultControls/ComboBox.xaml.
    Dropdown: the inset field of TextBox.xaml (dark fill, hairline edge, square corners) with a hairline chevron on the
    right in the secondary ink. The edge turns dull gold on hover and gold with keyboard focus or while open.
    List: the menus' Codex entry card (LocalAnimusCodexPanelTemplate, ContextMenu.xaml); ComboBoxItem rows are 30px like
    Menu.xaml with the gold wash, four gold corner brackets and diamond cursor on IsHighlighted, and the nested Animus
    diamond mark on IsSelected. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Border x:Name="Border" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <DockPanel LastChildFill="False" Background="Transparent">
                                            <ToggleButton x:Name="FilterGroupIndicator" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                          Margin="0,0,-5,0" Background="Transparent" BorderThickness="0" Padding="0" Width="30" Height="28" VerticalAlignment="Center" Visibility="Collapsed"
                                                          IsHitTestVisible="False" Focusable="False" IsChecked="True"
                                                          Style="{DynamicResource ExpanderDownHeaderStyle}" />
                                            <ContentPresenter x:Name="Chevron" DockPanel.Dock="Right" Margin="0,0,10,0" Width="16" Height="16"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                              Content="{DynamicResource IconDropDown}"
                                                              ContentTemplate="{DynamicResource IconTemplate}" />
                                        </DockPanel>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType={x:Type FilterPanel}}, FallbackValue=False}" Value="True">
                                                <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="FilterGroupIndicator" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource GlyphBrush}" TargetName="Chevron" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Content inset by Padding (InputPadding) plus room for the chevron. -->
                            <Border x:Name="FilterContentReserve" Margin="0,0,26,0" Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            </Border>
                            <Border Margin="0,0,26,0" Padding="{TemplateBinding Padding}">
                                <TextBox MinHeight="0" x:Name="PART_EditableTextBox" Visibility="Hidden" VerticalAlignment="Center"
                                         HorizontalAlignment="Stretch" Focusable="True"
                                         Style="{DynamicResource BareTextBox}"
                                         IsReadOnly="{TemplateBinding IsReadOnly}" />
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" VerticalOffset="2" Focusable="False" AllowsTransparency="True">
                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                    <Control Template="{DynamicResource LocalAnimusCodexPanelTemplate}" Focusable="False" IsTabStop="False" />
                                    <ScrollViewer Margin="4,12,4,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType={x:Type FilterPanel}}, FallbackValue=False}" Value="True">
                            <Setter TargetName="FilterContentReserve" Property="Margin" Value="0,0,30,0" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox" />
                            <Setter Property="Visibility" Value="Hidden" TargetName="ContentSite" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ComboBoxItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid x:Name="ListRow" Height="30" Background="Transparent" SnapsToDevicePixels="True">
                        <Rectangle x:Name="RowRule" Height="1" Margin="8,0" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource PanelSeparatorBrush}" Opacity="0.35" IsHitTestVisible="False" />
                        <Grid x:Name="ListHover" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ListHoverScale" ScaleX="1.03" ScaleY="1.06" />
                            </Grid.RenderTransform>
                            <Border Background="{DynamicResource SelectedBrush}" />
                            <Control Focusable="False" IsTabStop="False" Foreground="{DynamicResource GlyphBrush}"
                                     Template="{DynamicResource CornerMarksTemplate}" />
                        </Grid>
                        <Path x:Name="ListCursor" Width="5" Height="5" Margin="6,0,0,0" Stretch="Fill" HorizontalAlignment="Left"
                              VerticalAlignment="Center" Data="M 2.5,0 L 5,2.5 L 2.5,5 L 0,2.5 Z" Fill="{DynamicResource GlyphBrush}"
                              Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Grid Margin="16,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="ListDiamond" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Visibility="Collapsed">
                                <Path Width="11" Height="11" Stretch="Fill" Data="M 5.5,0 L 11,5.5 L 5.5,11 L 0,5.5 Z"
                                      Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.1" Fill="Transparent" />
                                <Path Width="4" Height="4" Stretch="Fill" Data="M 2,0 L 4,2 L 2,4 L 0,2 Z"
                                      Fill="{DynamicResource GlyphBrush}" />
                            </Grid>
                            <ContentPresenter x:Name="ListLabel" Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="ListDiamond" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RowRule" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ListHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListCursor" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ListHoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ListHoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ListCursor" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="ListHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.19" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ListCursor" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.19" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ListHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.19" />
                                        <DoubleAnimation Storyboard.TargetName="ListHoverScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.19" />
                                        <DoubleAnimation Storyboard.TargetName="ListHoverScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.19" />
                                        <DoubleAnimation Storyboard.TargetName="ListCursor" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.19" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" TargetName="ListRow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
