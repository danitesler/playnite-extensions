<!--
    Medallion: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    The placeholders name values sampled from The Witcher 3 menus (tokens.css). Theme XAML reads brushes only, never
    Color keys, so ThemeModifier edits reach every control.

    The look: tone on black, grey DIN text in capitals, white for the current item, thin double frames with notched
    corners (light around the focused item, brown on static boxes), and one warm family (taupe, amber, orange) for
    headings and selection. Square corners.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Typography (Playnite keys). The game sets every screen in PF DIN: menu items about 24px at 1080p, settings
        labels about 20px, screen titles about 1.6 times the menu size. Playnite's controls run at 14px, so the scale
        is 12 / 14 / 16 / 20 / 32. Bahnschrift (Windows' DIN 1451) stands in for PF DIN, which is not bundled.
    -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">35</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Bahnschrift}}, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Bahnschrift}}, Segoe UI</FontFamily>

    <!-- Shape (Playnite keys): the game's frames are square. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius-none}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale: only the slider and scroll thumbs are pills. -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:radius-pill}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:radius-none}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:radius-pill}}</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor is the orange bar the game puts beside a selected list item; text on it is black.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{text-label}}</Color>
    <Color x:Key="TextColorDarker">{{text-subtitle}}</Color>
    <Color x:Key="TextColorDark">#FF000000</Color>
    <Color x:Key="MainColor">{{settings-row}}</Color>
    <Color x:Key="MainColorDark">{{panel}}</Color>
    <Color x:Key="HoverColor">{{settings-row-hover}}</Color>
    <Color x:Key="GlyphColor">{{accent-bar}}</Color>
    <Color x:Key="HighlightGlyphColor">{{accent-bar/30}}</Color>
    <Color x:Key="PopupBackgroundColor">{{panel}}</Color>
    <Color x:Key="PopupBorderColor">{{frame-brown}}</Color>
    <Color x:Key="BackgroundToneColor">{{settings-row}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{settings-row}}</Color>
    <Color x:Key="PanelSeparatorColor">{{frame-faint}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{frame-brown}}</Color>
    <Color x:Key="DataChangeNotifColor">{{tracked}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{frame-brown}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{{settings-row-hover}}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{settings-row}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{prompt-plate}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{settings-row}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{objective-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{logo-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{gold-numeral}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{tracked}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{scene-black}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell: the main menu's band on the left, the black page around it. -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{menu-band}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{scene-black/55}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{prompt-plate}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{settings-row}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{text-label}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{frame-brown}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#FF000000" />

    <!-- States: white for the current item, the amber wash (faded through a mask) for a selected row -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{amber-wash}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{amber-wash}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{text-active}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{settings-row-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{amber-wash}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{amber-wash}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{frame-focus}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{logo-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFFFFFF" />

    <!-- Buttons: a brown double frame on the prompt plate; Play is the selected quest header (gold frame, dark amber) -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{text-active}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{frame-brown}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{settings-row}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{keycap}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{quest-fill}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{amber-wash}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{quest-fill-end}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{category-light}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{quest-frame}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{accent-bar}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{settings-row}}" />

    <!-- Inputs: the graphics preset field, a brown edge on the prompt plate, light when focused -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{prompt-plate}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{settings-row}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{frame-brown}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{frame-hover}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{text-done}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{frame-focus}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{slider-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{slider-thumb}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{text-active}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{slider-track-edge}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{frame-focus}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{slider-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{scroll-thumb}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{category-closed}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{scroll-thumb}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{category-closed}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{page-dot}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{frame-hover}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{frame-hover}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{frame-focus}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{menu-item}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{settings-row}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{text-label}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{keycap}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{frame-faint}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{text-label}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{frame-brown}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{scene-black}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{header-taupe-light}}" />

    <!-- Frames: brown on static boxes, grey around the hovered item, FocusBrush (light) around the current one -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{frame-brown}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{frame-hover}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{row-strip}}" />

    <!-- Headings and the game page -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{category-closed}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{scene-black}}" />
</ResourceDictionary>
