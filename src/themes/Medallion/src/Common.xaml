<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    Spacing follows The Witcher 3 menus as sampled at 1080p (tokens.css): settings rows about 78px tall with a 5px
    strip on the left, main menu items every 43px, frames of two 1px lines with a 2px gap. Playnite's controls use
    14px type against the game's 20 to 24px, so the game's paddings are scaled by about 0.6 where noted.

    DoubleFrameTemplate is the game's selection frame: two 1px lines 2px apart; the outer is a plain rectangle, the
    inner one steps 4px inward at each corner (a square notch). It is drawn in the host's BorderBrush and takes no
    room of its own: hosts lay it over the item with a negative margin or inside their padding.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- The selection frame. The inner line: four edges stopped 4px short of each corner, joined by an L at each
         corner (down 4, across 4), so the corner is notched. Pixel snapped so 1px lines stay crisp. -->
    <ControlTemplate x:Key="DoubleFrameTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
            <Border BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" />
            <Grid Margin="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                <Border Grid.Column="1" Grid.Row="0" Height="1" VerticalAlignment="Top" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="1" Grid.Row="2" Height="1" VerticalAlignment="Bottom" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="0" Grid.Row="1" Width="1" HorizontalAlignment="Left" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="2" Grid.Row="1" Width="1" HorizontalAlignment="Right" Background="{TemplateBinding BorderBrush}" />
                <!-- corner steps: each is a 1px vertical and a 1px horizontal piece inside its 5x5 cell -->
                <Border Grid.Column="0" Grid.Row="0" Width="1" HorizontalAlignment="Right" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="0" Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="2" Grid.Row="0" Width="1" HorizontalAlignment="Left" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="2" Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="0" Grid.Row="2" Width="1" HorizontalAlignment="Right" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="0" Grid.Row="2" Height="1" VerticalAlignment="Top" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="2" Grid.Row="2" Width="1" HorizontalAlignment="Left" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="2" Grid.Row="2" Height="1" VerticalAlignment="Top" Background="{TemplateBinding BorderBrush}" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <!-- Menus and dropdowns: a journal panel (#070707) with the brown frame line. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: the game's selection frame in the light focus grey, 3px outside the control (keyboard only). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Margin="-3" Template="{DynamicResource DoubleFrameTemplate}"
                             BorderBrush="{DynamicResource FocusBrush}" Focusable="False" IsTabStop="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: a single light line 3px outside the box. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading: the journal's category header (COMPLETED), uppercase DIN in the closed category taupe;
         callers pass capitals. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Component spacing, keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">18,5,18,5</Thickness>          <!-- prompt plate: key cap and label, 32px tall at 14px type (height now set by ControlHeight) -->
    <Thickness x:Key="InputPadding">10,5,10,5</Thickness>           <!-- graphics preset field: 12px inset, 34px tall (height now set by ControlHeight) -->
    <Thickness x:Key="MenuPadding">1,6,1,6</Thickness>              <!-- panel, 1px brown frame -->
    <Thickness x:Key="MenuItemPadding">16,8,16,8</Thickness>        <!-- journal list rows, label 20px from the panel edge, x0.8 -->
    <Thickness x:Key="ComboBoxDropDownPadding">1,4,1,4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">14,8,14,8</Thickness>
    <Thickness x:Key="ListBoxItemPadding">14,7,14,7</Thickness>     <!-- settings row: label 26px in from the strip, x0.55 -->
    <Thickness x:Key="GroupBoxPadding">0,0,0,16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>    <!-- section name, faint rule, then the list -->
    <Thickness x:Key="TooltipPadding">12,8,12,8</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">20</sys:Double>                    <!-- inventory filter icons, about 22px -->
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art band on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five 16:9
         thumbnails, so the real carousel replaces it without the page jumping. Square corners, like the game's
         slots. Each Viewbox scales a fixed 1600px layout to its column's width. The tiles are the host's Foreground
         at low opacity; the whole thing pulses while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="0"
                        Background="{TemplateBinding Foreground}" Opacity="0.14" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="2" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="4" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="6" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="8" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- menu-mark begin LocalMedallionMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a witcher medallion, two rings with four cardinal notches around a diamond gem. Hover (IsMouseOver): the medallion trembles as it does near a monster, a 0.28s damped shake of 1.4px that settles to rest. Open (ContextMenu.IsOpen of the nearest Border): the gem lights amber and a dashed inner ring fades in and breathes (1s, auto-reversed) until the menu closes; exits restore every property. The sidebar names the element Mark (position triggers resize it), so the control keeps x:Name Mark there. -->
    <ControlTemplate x:Key="LocalMedallionMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Canvas x:Name="Shake" Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="ShakeT" X="0" Y="0" /></Canvas.RenderTransform>
                    <Ellipse Canvas.Left="1.2" Canvas.Top="1.2" Width="23.6" Height="23.6" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" />
                    <Ellipse Canvas.Left="5" Canvas.Top="5" Width="16" Height="16" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity="0.6" />
                    <Rectangle Canvas.Left="12.2" Canvas.Top="1.2" Width="1.6" Height="3.8" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="12.2" Canvas.Top="21" Width="1.6" Height="3.8" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="1.2" Canvas.Top="12.2" Width="3.8" Height="1.6" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="21" Canvas.Top="12.2" Width="3.8" Height="1.6" Fill="{TemplateBinding Foreground}" />
                    <Path Data="M13,8.5 L17,13 L13,17.5 L9,13Z" Fill="{TemplateBinding Foreground}" />
                    <Path x:Name="GemLit" Data="M13,8.5 L17,13 L13,17.5 L9,13Z" Fill="{DynamicResource GlyphBrush}" Opacity="0" />
                    <Ellipse x:Name="Dash" Canvas.Left="3" Canvas.Top="3" Width="20" Height="20" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" StrokeDashArray="2 2.4" Opacity="0" />
                </Canvas>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShakeT" Storyboard.TargetProperty="X"><LinearDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:0.040" Value="1.4" /><LinearDoubleKeyFrame KeyTime="0:0:0.080" Value="-1.4" /><LinearDoubleKeyFrame KeyTime="0:0:0.120" Value="1.1" /><LinearDoubleKeyFrame KeyTime="0:0:0.160" Value="-1.1" /><LinearDoubleKeyFrame KeyTime="0:0:0.200" Value="0.7" /><LinearDoubleKeyFrame KeyTime="0:0:0.240" Value="-0.7" /><LinearDoubleKeyFrame KeyTime="0:0:0.280" Value="0" /></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShakeT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.150" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="GemLit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.200"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Dash" Storyboard.TargetProperty="Opacity" From="0.3" To="0.9" Duration="0:0:1.000" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GemLit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.160" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Dash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.800" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalMedallionMenuMarkTemplate -->
</ResourceDictionary>
