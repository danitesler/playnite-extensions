<!--
    Overlay on Playnite Default/Common.xaml: only restyled keys live here.
    Spacing follows The Witcher 3 menus as sampled at 1080p (tokens.css): settings rows about 78px tall with a 5px
    strip on the left, main menu items every 43px, frames of two 1px lines with a 2px gap. Playnite's controls use
    14px type against the game's 20 to 24px, so the game's paddings are scaled by about 0.6 where noted.

    DoubleFrameTemplate is the game's selection frame: two 1px lines 2px apart; the outer is a plain rectangle, the
    inner one steps 4px inward at each corner (a square notch). It is drawn in the host's BorderBrush and takes no
    room of its own: hosts lay it over the item with a negative margin or inside their padding.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- The selection frame. The inner line: four edges stopped 4px short of each corner, joined by an L at each
         corner (down 4, across 4), so the corner is notched. Pixel snapped so 1px lines stay crisp. -->
    <ControlTemplate x:Key="DoubleFrameTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
            <Border BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" />
            <Grid Margin="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                <Border Grid.Column="1" Grid.Row="0" Height="1" VerticalAlignment="Top" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="1" Grid.Row="2" Height="1" VerticalAlignment="Bottom" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="0" Grid.Row="1" Width="1" HorizontalAlignment="Left" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="2" Grid.Row="1" Width="1" HorizontalAlignment="Right" Background="{TemplateBinding BorderBrush}" />
                <!-- corner steps: each is a 1px vertical and a 1px horizontal piece inside its 5x5 cell -->
                <Border Grid.Column="0" Grid.Row="0" Width="1" HorizontalAlignment="Right" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="0" Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="2" Grid.Row="0" Width="1" HorizontalAlignment="Left" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="2" Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="0" Grid.Row="2" Width="1" HorizontalAlignment="Right" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="0" Grid.Row="2" Height="1" VerticalAlignment="Top" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="2" Grid.Row="2" Width="1" HorizontalAlignment="Left" Background="{TemplateBinding BorderBrush}" />
                <Border Grid.Column="2" Grid.Row="2" Height="1" VerticalAlignment="Top" Background="{TemplateBinding BorderBrush}" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <!-- Menus and dropdowns: a journal panel (#070707) with the brown frame line. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: the game's selection frame in the light focus grey, 3px outside the control (keyboard only). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Margin="-3" Template="{DynamicResource DoubleFrameTemplate}"
                             BorderBrush="{DynamicResource FocusBrush}" Focusable="False" IsTabStop="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: a single light line 3px outside the box. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading: the journal's category header (COMPLETED), uppercase DIN in the closed category taupe;
         callers pass capitals. -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Component spacing, keyed by the Playnite control. -->
    <Thickness x:Key="ButtonPadding">18,8,18,8</Thickness>          <!-- prompt plate: key cap and label, 32px tall at 14px type -->
    <Thickness x:Key="InputPadding">10,7,10,7</Thickness>           <!-- graphics preset field: 12px inset, 34px tall -->
    <Thickness x:Key="MenuPadding">1,6,1,6</Thickness>              <!-- panel, 1px brown frame -->
    <Thickness x:Key="MenuItemPadding">16,8,16,8</Thickness>        <!-- journal list rows, label 20px from the panel edge, x0.8 -->
    <Thickness x:Key="ComboBoxDropDownPadding">1,4,1,4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">14,8,14,8</Thickness>
    <Thickness x:Key="ListBoxItemPadding">14,7,14,7</Thickness>     <!-- settings row: label 26px in from the strip, x0.55 -->
    <Thickness x:Key="GroupBoxPadding">0,0,0,16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>    <!-- section name, faint rule, then the list -->
    <Thickness x:Key="TooltipPadding">12,8,12,8</Thickness>
    <sys:Double x:Key="IconSize">20</sys:Double>                    <!-- inventory filter icons, about 22px -->
    <sys:Double x:Key="GameBannerHeight">340</sys:Double> <!-- Height of the background art band on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->

    <!-- Placeholder where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five 16:9
         thumbnails, so the real carousel replaces it without the page jumping. Square corners, like the game's
         slots. Each Viewbox scales a fixed 1600px layout to its column's width. The tiles are the host's Foreground
         at low opacity; the whole thing pulses while visible. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="0"
                        Background="{TemplateBinding Foreground}" Opacity="0.14" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="2" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="4" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="6" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                    <Border Grid.Column="8" CornerRadius="0" Background="{TemplateBinding Foreground}" Opacity="0.14" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
