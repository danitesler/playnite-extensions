<!--
    Overlay on Playnite Default/DefaultControls/Menu.xaml.
    Medallion menu rows (The Witcher 3: Wild Hunt):
      - Rows: 30px height, 24px icon column, plain * label column, shared Auto MenuGestureColumn.
      - Highlight (130ms): left-fading amber wash (MenuItemHoverBrush) + 3px orange left bar (GlyphBrush) scaling
        vertically + notched DoubleFrameTemplate (FocusBrush) fading in; label and icon turn white.
      - Submenu open: held soft amber wash + FrameHoverBrush DoubleFrameTemplate + 2px gold left bar.
      - Group break: 10px faint brown rule split at center by a 4px gold diamond (TabItemIndicatorBrush).
      - Shortcuts: square Witcher prompt-plate keycaps (ButtonBackgroundBrush, 1px FrameBrush rim).
      - Exit (Alt+Q): logo red icon & keycap at rest; left-fading DangerBrush wash + 3px red bar + red notched
        DoubleFrameTemplate + white label on highlight.
      - Checked: 14x14 brown-framed square with objective-green (PositiveRatingBrush) checkmark.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" Margin="6,0,6,0" SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" VerticalAlignment="Center" Margin="0,0,5,0"
                                Background="{DynamicResource MenuSeparatorBrush}" />
                        <Path Grid.Column="1" Width="4" Height="4" VerticalAlignment="Center"
                              Data="M 2,0 L 4,2 L 2,4 L 0,2 Z"
                              Fill="{DynamicResource TabItemIndicatorBrush}" />
                        <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Margin="5,0,0,0"
                                Background="{DynamicResource MenuSeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="Transparent" Padding="10,4,10,4">
            <Grid>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Grid MinWidth="180" Margin="0,2,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Control Template="{DynamicResource LocalMedallionMenuPanelTemplate}"
                                 Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="6,6,6,6">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="Border" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="Transparent" Padding="10,4,10,4">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="Border" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- Animated amber wash (left-fading Witcher 3 journal selection) -->
            <Rectangle x:Name="HoverWash" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                       Fill="{DynamicResource MenuItemHoverBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="0.72" Color="#66000000" />
                        <GradientStop Offset="1" Color="#1A000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <!-- Animated notched double frame -->
            <Control x:Name="HoverFrame" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                     Template="{DynamicResource DoubleFrameTemplate}"
                     BorderBrush="{DynamicResource FocusBrush}"
                     Focusable="False" IsTabStop="False" />
            <!-- Animated 3px orange left bar -->
            <Border x:Name="HoverBar" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" IsHitTestVisible="False"
                    Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="HoverBarScale" ScaleY="0" />
                </Border.RenderTransform>
            </Border>

            <!-- Danger highlight layers for Exit (Alt+Q) -->
            <Rectangle x:Name="DangerWash" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                       Fill="{DynamicResource DangerBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#8C000000" />
                        <GradientStop Offset="0.75" Color="#44000000" />
                        <GradientStop Offset="1" Color="#18000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Control x:Name="DangerFrame" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                     Template="{DynamicResource DoubleFrameTemplate}"
                     BorderBrush="{DynamicResource DangerBrush}"
                     Focusable="False" IsTabStop="False" />
            <Border x:Name="DangerBar" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" IsHitTestVisible="False"
                    Background="{DynamicResource DangerBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DangerBarScale" ScaleY="0" />
                </Border.RenderTransform>
            </Border>

            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon"
                                  TextElement.Foreground="{DynamicResource TextBrush}" />

                <!-- Objective-green check inside brown-framed square -->
                <Border x:Name="CheckBox" Grid.Column="0" Width="14" Height="14"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                        Background="{DynamicResource NormalBrush}"
                        BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1">
                    <Path Width="9" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0.5,3.5 L 3.2,6.2 L 8.5,0.8"
                          Stroke="{DynamicResource PositiveRatingBrush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Square" StrokeEndLineCap="Square" StrokeLineJoin="Miter" />
                </Border>

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center" Margin="2,0,14,0"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                <Border x:Name="GesturePlate" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                        Padding="5,1,5,1"
                        Background="{DynamicResource ButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1">
                    <TextBlock x:Name="GestureText" Text="{TemplateBinding InputGestureText}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource HeadingForegroundBrush}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckBox" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="GesturePlate" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="GesturePlate" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!-- Normal row highlight animation -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="GesturePlate" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="RowHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity"
                                             To="0.85" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverBarScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="RowHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.11" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.11" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.11" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.11" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.11" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverBarScale" Storyboard.TargetProperty="ScaleY"
                                             To="0" Duration="0:0:0.11" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Exit danger row (Alt+Q) at rest -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="GesturePlate" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Trigger>
            <!-- Exit danger row highlighted -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                    <Condition Property="IsHighlighted" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HoverWash" Property="Opacity" Value="0" />
                <Setter TargetName="HoverFrame" Property="Opacity" Value="0" />
                <Setter TargetName="HoverBar" Property="Opacity" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="GesturePlate" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="DangerHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerWash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerWash" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerFrame" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerFrame" Storyboard.TargetProperty="Opacity"
                                             To="0.9" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerBarScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="DangerHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerWash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.11" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerWash" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.11" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerFrame" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.11" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerFrame" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.11" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DangerBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.11" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="DangerBarScale" Storyboard.TargetProperty="ScaleY"
                                             To="0" Duration="0:0:0.11" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MenuRow" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="30" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- Held open plate while child submenu is open -->
            <Rectangle x:Name="OpenWash" Visibility="Collapsed" Opacity="0.65" IsHitTestVisible="False"
                       Fill="{DynamicResource MenuItemHoverBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#CC000000" />
                        <GradientStop Offset="1" Color="#18000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Control x:Name="OpenFrame" Visibility="Collapsed" IsHitTestVisible="False"
                     Template="{DynamicResource DoubleFrameTemplate}"
                     BorderBrush="{DynamicResource FrameHoverBrush}"
                     Focusable="False" IsTabStop="False" />
            <Border x:Name="OpenBar" Visibility="Collapsed" Width="2" HorizontalAlignment="Left" IsHitTestVisible="False"
                    Background="{DynamicResource TabItemIndicatorBrush}" />

            <!-- Animated highlight layers -->
            <Rectangle x:Name="HoverWash" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                       Fill="{DynamicResource MenuItemHoverBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="0.72" Color="#66000000" />
                        <GradientStop Offset="1" Color="#1A000000" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Control x:Name="HoverFrame" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                     Template="{DynamicResource DoubleFrameTemplate}"
                     BorderBrush="{DynamicResource FocusBrush}"
                     Focusable="False" IsTabStop="False" />
            <Border x:Name="HoverBar" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" IsHitTestVisible="False"
                    Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="HoverBarScale" ScaleY="0" />
                </Border.RenderTransform>
            </Border>

            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon"
                                  TextElement.Foreground="{DynamicResource TextBrush}" />

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center" Margin="2,0,14,0"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                <Path x:Name="Arrow" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="4,0,2,0"
                      Data="M 0,0 L 4,4 L 0,8"
                      Stroke="{DynamicResource HeadingForegroundBrush}" StrokeThickness="1.5"
                      StrokeStartLineCap="Square" StrokeEndLineCap="Square" StrokeLineJoin="Miter">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="ArrowShift" X="0" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <Popup x:Name="Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-6"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Grid MinWidth="180" Margin="0,2,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Control Template="{DynamicResource LocalMedallionMenuPanelTemplate}"
                             Focusable="False" IsTabStop="False" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Margin="6,6,6,6">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenWash" Property="Visibility" Value="Visible" />
                <Setter TargetName="OpenFrame" Property="Visibility" Value="Visible" />
                <Setter TargetName="OpenBar" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource GlyphBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubHoverIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity"
                                             To="0.85" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverBarScale" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="X"
                                             To="2" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubHoverOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.11" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.11" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.11" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.11" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.11" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HoverBarScale" Storyboard.TargetProperty="ScaleY"
                                             To="0" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="X"
                                             To="0" Duration="0:0:0.11" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MenuRow" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
