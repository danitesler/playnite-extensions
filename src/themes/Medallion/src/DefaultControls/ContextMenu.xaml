<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml.
    Medallion menus (The Witcher 3: Wild Hunt journal & settings menu):
      - Panel: #070707 journal black (PopupBackgroundBrush) framed by the Witcher 3 notched double frame
        (DoubleFrameTemplate in PopupBorderBrush) with a small top-center gold medallion diamond crest
        (TabItemIndicatorBrush). Shared by ContextMenu, submenu popups, ComboBox lists, ComboBoxList and
        FilterSelectionBox via LocalMedallionMenuPanelTemplate.
      - Rows: 30px tall, 24px icon column, plain * label column, shared Auto shortcut/arrow column.
      - Highlight: left-to-right fading amber wash (MenuItemHoverBrush) + 3px orange left bar (GlyphBrush)
        growing vertically + notched DoubleFrameTemplate in FocusBrush fading in (130ms).
      - Group break: 10px faint brown rule split at center by a 4px gold journal diamond (TabItemIndicatorBrush).
      - Shortcuts: square prompt-plate keycaps (ButtonBackgroundBrush, 1px FrameBrush rim, taupe text; orange rim +
        white text on highlight).
      - Marked rows: Exit (Alt+Q) uses DangerBrush (logo claw-mark red) icon & keycap at rest and a left-fading
        DangerBrush wash + 3px red bar + red DoubleFrameTemplate + white label on highlight (>= 9:1 contrast);
        checked/selected rows show a square brown-framed objective box with an objective-green (PositiveRatingBrush)
        checkmark.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMedallionMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" />
            <Control Template="{DynamicResource DoubleFrameTemplate}"
                     BorderBrush="{DynamicResource PopupBorderBrush}"
                     Focusable="False" IsTabStop="False" />
            <Path Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-2,0,0"
                  Data="M 3,0 L 6,3 L 3,6 L 0,3 Z"
                  Fill="{DynamicResource TabItemIndicatorBrush}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="MinWidth" Value="210" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True" Margin="0,2,0,0">
                        <Control Template="{DynamicResource LocalMedallionMenuPanelTemplate}"
                                 Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Margin="6,6,6,6">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
