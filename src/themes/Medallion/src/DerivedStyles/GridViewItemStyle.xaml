<!--
    Overlay on Playnite Default/DerivedStyles/GridViewItemStyle.xaml.
    Covers as the game's item slots: square, no glow. Selected = the game's selection frame, two light lines with
    notched corners (DoubleFrameTemplate in GridViewItemSelectedBorderBrush, #C6C6C6), 6px outside the cover, static.
    Hover = the grey double frame the main menu puts around the item under the pointer (GridViewItemHoverBorderBrush,
    #686868), animated both ways (no setters on animated parts, so nothing snaps):
      in  0.2s ease-out: the grey frame fades in while settling from 1.5% larger, and the orange bar (the mark of
          the item in focus, GlyphBrush) grows from the middle of the cover's left edge to its full height.
      out 0.25s: both fade away; exit animations use FillBehavior Stop so no clock outlives the fade.
    Everything is drawn inside the item's own spacing margin (6px, as the selection frame). No OpacityMask anywhere.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <ContentPresenter />
                        <Control x:Name="HoverFrame" Margin="-6" Visibility="Hidden" Opacity="0" Focusable="False" IsTabStop="False"
                                 Template="{DynamicResource DoubleFrameTemplate}" RenderTransformOrigin="0.5,0.5"
                                 BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}">
                            <Control.RenderTransform>
                                <ScaleTransform x:Name="HoverFrameScale" ScaleX="1" ScaleY="1" />
                            </Control.RenderTransform>
                        </Control>
                        <Border x:Name="HoverBar" Width="3" HorizontalAlignment="Left" IsHitTestVisible="False" Visibility="Hidden"
                                Background="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="HoverBarScale" ScaleX="1" ScaleY="0.1" />
                            </Border.RenderTransform>
                        </Border>
                        <Control x:Name="SelectionFrame" Margin="-6" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                 Template="{DynamicResource DoubleFrameTemplate}"
                                 BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrameScale" Storyboard.TargetProperty="ScaleX" From="1.015" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverFrameScale" Storyboard.TargetProperty="ScaleY" From="1.015" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverBarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverBarScale" Storyboard.TargetProperty="ScaleY" To="0.1" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectionFrame" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
