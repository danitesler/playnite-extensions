<!--
    Medallion: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    The menu band as a 44px header: the title as the section name under the logo (taupe, DIN capitals) inside the
    game's notched brown double frame (the frame the close box and the prompts wear), the medallion mark ghosted into
    the right end, and a brown rule closing the band. Caption buttons are the 36x28 WindowBarButton glyphs, so the
    caption and the content offset are 44 (Default: 25). PART_TextTitle and the three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>
    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource ShellBackgroundBrush}" ClipToBounds="True">
                                    <!-- The medallion mark ghosted into the right end, in a Canvas so it adds no desired width. -->
                                    <Canvas IsHitTestVisible="False">
                                        <ContentControl Canvas.Right="50" Canvas.Top="-26" Width="96" Height="96" Opacity="0.06"
                                                        Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource TextBrush}" />
                                    </Canvas>
                                    <Rectangle Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
                                    <DockPanel LastChildFill="False">
                                        <Grid DockPanel.Dock="Left" Margin="12,0,0,0" Height="30" VerticalAlignment="Center">
                                            <Control Template="{DynamicResource DoubleFrameTemplate}" BorderBrush="{DynamicResource FrameBrush}" Focusable="False" IsTabStop="False" />
                                            <Border Padding="18,0">
                                                <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" Typography.Capitals="AllSmallCaps" Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                            </Border>
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,10,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,44,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
