<!--
    Overlay on Playnite Default/DerivedStyles/DetailsViewItemStyle.xaml (rows of the game list).
    Rows read like the game's settings rows: a #0C0C0C strip with a 2px black gap under it and the 5px brown strip
    (#1E1915) on its left edge; installed games in label grey, the rest in subtitle grey. Under the pointer the strip
    lifts one step (#141414). The selected row takes the journal's selection: the amber wash (#593A04) fading out to
    the right over the strip, the orange bar (#D07201) in place of the brown one, and white text.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="Row" Margin="0,0,0,2" Background="{DynamicResource NormalBrush}">
                        <Rectangle x:Name="Shade" Visibility="Collapsed" IsHitTestVisible="False"
                                   Fill="{DynamicResource ListItemSelectedBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FF000000" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Border x:Name="Strip" Width="5" HorizontalAlignment="Left" IsHitTestVisible="False"
                                Background="{DynamicResource SlotBorderBrush}" />
                        <!-- Running game: the medallion hums. An objective-green diamond pip on the row's far edge over a
                             1px green hairline along the foot, fading leftward; the amber selection lives on the near edge. -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.16" />
                        <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.3">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                    <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.03" />
                                    <GradientStop x:Name="RunningScanTailB" Color="#FF000000" Offset="-0.029" />
                                    <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                    <GradientStop x:Name="RunningScanHeadB" Color="#00000000" Offset="0.001" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2"><Border BorderBrush="{DynamicResource WindowBackgourndBrush}" BorderThickness="1" Opacity="0.7" /></Border>
                            <Grid Height="2" Margin="5,0,20,0" VerticalAlignment="Bottom">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="1,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Path Width="7" Height="7" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="Fill"
                                  Data="M3.5,0 L7,3.5 L3.5,7 L0,3.5 Z" Fill="{DynamicResource RunningIndicatorBrush}">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="RunningTremble" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <Border Padding="{TemplateBinding Padding}" Margin="5,0,0,0" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ListItemHoverBrush}" TargetName="Row" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Shade" />
                            <Setter Property="Background" Value="{DynamicResource GlyphBrush}" TargetName="Strip" />
                            <Setter Property="Width" Value="3" TargetName="Strip" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.03" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="-0.03" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1.02" KeySpline="0.45,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.02" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTailB" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.029" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="-0.029" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1.021" KeySpline="0.45,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.021" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1.04" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.04" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHeadB" Storyboard.TargetProperty="Offset" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.001" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1.041" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1.041" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningTremble" Storyboard.TargetProperty="X" Duration="0:0:1.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="-1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="-1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="-1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.7" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="-1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="-1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="-1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningTremble" Storyboard.TargetProperty="X" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.6" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="-0.6" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
