<!--
    Overlay on Playnite Default/CustomControls/ComboBoxList.xaml.
    Multi-select dropdown: same field chrome as ComboBox, popup wears LocalMedallionMenuPanelTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ComboBoxList}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxList}">
                    <Border x:Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Background="{TemplateBinding Background}">
                        <DockPanel>
                            <Button x:Name="PART_ButtonClearFilter" DockPanel.Dock="Right"
                                    Style="{DynamicResource PropertyItemButton}"
                                    Content="r" FontFamily="Marlett" Margin="0,0,4,0" FontSize="12"
                                    Visibility="{TemplateBinding ShowClearButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid DockPanel.Dock="Left">
                                <ToggleButton x:Name="PART_ToggleDropDown" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <DockPanel LastChildFill="False" Background="Transparent">
                                                <ContentPresenter x:Name="Chevron" DockPanel.Dock="Right" Width="16" Height="16" Margin="0,0,8,0"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                                                  Content="{DynamicResource IconDropDown}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </DockPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chevron" Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBlock x:Name="PART_TextFilterString" IsHitTestVisible="False" VerticalAlignment="Center"
                                           Margin="10,0,30,0" Style="{DynamicResource BaseTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <Popup x:Name="PART_Popup" IsOpen="{Binding IsChecked, ElementName=PART_ToggleDropDown}"
                                       Placement="Bottom" VerticalOffset="2" Focusable="False" AllowsTransparency="True" StaysOpen="False">
                                    <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}"
                                          Margin="0,2,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Control Template="{DynamicResource LocalMedallionMenuPanelTemplate}"
                                                 Focusable="False" IsTabStop="False" />
                                        <ItemsControl x:Name="PART_ItemsPanel" Margin="8,8,8,8"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ItemsControl.Template>
                                                <ControlTemplate TargetType="{x:Type ItemsControl}">
                                                    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </ControlTemplate>
                                            </ItemsControl.Template>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Border" />
                        </Trigger>
                        <Trigger SourceName="PART_ToggleDropDown" Property="IsChecked" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Border" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
