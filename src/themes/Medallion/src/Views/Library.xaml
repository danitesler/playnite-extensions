<!--
    Overlay on Playnite Default/Views/Library.xaml.
    The main menu's scene: the selected game's background art (when Playnite shows it: Settings, Appearance) fills the
    library behind the header row, the way the game's night scene fills the screen beside the menu band. It is shaded
    in ScrimBrush so it reads as the game's dim backdrop: black at 65% next to the band, easing to 35% across the
    width, and the bottom fifth going back to black, like the smoky floor of the settings screens. Everything under
    the header row sits on black at 55%, so covers stay legible and the art only glows through.
    The shading sits inside a bitmap cache. The library starts 16px in from the band so its rough edge clears the
    first column. PART_ImageBackground and the PART_View* names are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <FadeImage x:Name="PART_ImageBackground" Grid.Row="0" Grid.RowSpan="2"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                            <Grid.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                            </Grid.CacheMode>
                            <Rectangle Fill="{DynamicResource ScrimBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#A6000000" />
                                        <GradientStop Offset="0.55" Color="#59000000" />
                                        <GradientStop Offset="1" Color="#59000000" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle Fill="{DynamicResource ScrimBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0.8" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#FF000000" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>

                        <TopPanel Grid.Row="0" />

                        <DockPanel Grid.Row="1" Background="{DynamicResource ContentBackgroundBrush}">
                            <Border Width="16" DockPanel.Dock="Left" />
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}" />

                            <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                           DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}" />

                            <Grid DockPanel.Dock="Left">
                                <LibraryDetailsView x:Name="PART_ViewDetails" />
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
