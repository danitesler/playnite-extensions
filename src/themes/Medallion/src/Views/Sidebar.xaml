<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    The Witcher 3 main menu band, narrowed to an icon rail: a near-black (#020202) column on the left, 72px, with a
    rough dry-brush right edge over the page. The logo sits at the top of the band, centered; here it is this theme's
    medallion mark (PART_ElemMainMenu, the main menu button), with the short brown rule the game draws under the
    section name. The menu items follow below it as icons in the game's grey, framed like its menu items
    (CustomControls/SidebarItem.xaml).
    The rough edge is two jagged polygons (drawn for this theme, not taken from the game) in the band color, the
    outer one at half strength, hanging 20px over the content. Docked at the right the edge flips to the left side;
    docked at the top or bottom the band becomes a 56px strip without the edge and 150px stay clear on the right for
    the caption buttons. Views/MainWindow.xaml docks it with Playnite's Sidebar position.
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Main menu button: the medallion in label grey, white under the pointer (the game's logo has no hover; the
         menu items brighten to white, so the mark does the same). Also used by Views/TopPanel.xaml. -->
    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="72" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid x:Name="Root" Width="72">
                        <!-- The brush edge, outside the band so it lies over the page. -->
                        <Grid x:Name="Edge" Width="20" Margin="0,0,-20,0" HorizontalAlignment="Right" IsHitTestVisible="False"
                              RenderTransformOrigin="0.5,0.5">
                            <Path Stretch="Fill" Opacity="0.5" Fill="{DynamicResource ShellBackgroundBrush}"
                                  Data="M0,0 L6,15 L20,32 L7,45 L9,58 L11,69 L10,82 L8,96 L10,110 L10,116 L11,127 L19,136 L18,142 L20,152 L6,161 L15,175 L20,183 L20,189 L7,197 L13,210 L19,221 L7,237 L7,254 L6,265 L15,271 L12,287 L19,304 L13,315 L10,330 L20,344 L19,357 L18,364 L12,379 L18,387 L15,400 L7,416 L9,433 L9,444 L8,451 L13,466 L14,472 L13,488 L13,493 L15,505 L14,511 L19,523 L13,536 L12,546 L19,559 L20,566 L9,571 L6,577 L12,589 L7,601 L17,616 L10,631 L13,638 L13,647 L10,658 L8,674 L13,686 L10,695 L18,710 L7,715 L10,723 L18,738 L7,749 L7,761 L14,773 L16,785 L8,790 L16,801 L7,810 L8,816 L12,823 L20,832 L19,844 L9,850 L13,864 L18,879 L12,885 L16,900 L6,907 L15,918 L10,933 L20,948 L15,953 L15,966 L10,976 L10,984 L11,997 L6,1000 L0,1000 Z" />
                            <Path Stretch="Fill" Width="14" HorizontalAlignment="Left" Fill="{DynamicResource ShellBackgroundBrush}"
                                  Data="M0,0 L4,18 L12,38 L3,47 L3,72 L11,91 L10,100 L2,114 L8,124 L3,145 L3,160 L8,185 L11,194 L5,205 L2,231 L11,257 L2,277 L2,292 L4,317 L8,334 L10,346 L11,357 L10,374 L3,387 L11,413 L7,427 L10,438 L11,448 L11,457 L9,471 L8,496 L9,514 L9,540 L6,559 L14,574 L13,587 L3,602 L6,628 L9,652 L13,670 L6,692 L3,702 L8,726 L14,739 L4,757 L8,780 L12,789 L14,799 L11,824 L7,842 L11,861 L11,884 L3,906 L6,916 L13,939 L2,949 L12,966 L12,992 L6,1000 L0,1000 Z" />
                        </Grid>

                        <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}">
                            <DockPanel x:Name="DockContentHolder">
                                <StackPanel x:Name="Head" DockPanel.Dock="Top">
                                    <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}">
                                        <ContentPresenter x:Name="Mark" Width="40" Height="40" Margin="0,12,0,0"
                                                          Content="{DynamicResource IconMainMenu}"
                                                          ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Border>
                                    <!-- The faint brown rule under the section name. -->
                                    <Border x:Name="HeadRule" Width="32" Height="1" Margin="0,6,0,14"
                                            Background="{DynamicResource TopPanelSeparatorBrush}" />
                                </StackPanel>

                                <ScrollViewer x:Name="ScrollSidebarItems" DockPanel.Dock="Top"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="True">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" Margin="10,0,10,0" HorizontalAlignment="Center" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="Edge" />
                            <Setter Property="Margin" Value="-20,0,0,0" TargetName="Edge" />
                            <Setter Property="RenderTransform" TargetName="Edge">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="-1" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Width" Value="Auto" TargetName="Root" />
                            <Setter Property="Height" Value="56" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Edge" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeadRule" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="Head" />
                            <Setter Property="Height" Value="56" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Width" Value="64" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Width" Value="32" TargetName="Mark" />
                            <Setter Property="Height" Value="32" TargetName="Mark" />
                            <Setter Property="Margin" Value="0" TargetName="Mark" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,150,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Margin" Value="0" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Width" Value="Auto" TargetName="Root" />
                            <Setter Property="Height" Value="56" TargetName="Root" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Edge" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeadRule" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="Head" />
                            <Setter Property="Height" Value="56" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Width" Value="64" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Width" Value="32" TargetName="Mark" />
                            <Setter Property="Height" Value="32" TargetName="Mark" />
                            <Setter Property="Margin" Value="0" TargetName="Mark" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" TargetName="ScrollSidebarItems" />
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Margin" Value="0" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
