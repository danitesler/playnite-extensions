{
    "_comment": "Lucide 1.49.0 stroke centerlines and menu PNGs (ISC; info/LICENSE-lucide.txt). Media.xaml keeps its earlier lucide: settings path for IconOptions.",
    "jobs": [
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/lucide-static@{ref}/icons/{name}.svg",
            "ref": "1.49.0",
            "format": "Geometry",
            "strokeGeometry": true,
            "keyPrefix": "Icon",
            "xamlOut": "src/Media.xaml",
            "updateXaml": true,
            "icons": [
                "search=Search",
                "x=Clear",
                "sliders-horizontal=ViewSettings",
                "bookmark=FilterPresets",
                "layers=Group",
                "arrow-up-down=Sort",
                "panel-right=DetailsView",
                "layout-grid=GridView",
                "list=ListView",
                "circle-arrow-down=Update",
                "folder-tree=Explorer",
                "dices=Random",
                "shuffle=ViewRandom",
                "list-filter=Filter",
                "bell=Notifications",
                "menu=MainMenu",
                "library=Library",
                "chart-column=Statistics",
                "minus=WindowMinimize",
                "square=WindowMaximize",
                "copy=WindowRestore",
                "x=WindowClose",
                "chevron-down=DropDown",
                "chevron-right=Submenu",
                "check=Check",
                "plus=Add",
                "pencil=Edit",
                "trash-2=Remove",
                "play=Play",
                "info=Info",
                "download=Download"
            ]
        },
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/lucide-static@{ref}/icons/{name}.svg",
            "ref": "1.49.0",
            "format": "Png",
            "outDir": "src/Images/Lucide",
            "colorToken": "ayy-color-muted",
            "icons": [
                "maximize",
                "plus",
                "refresh-cw",
                "info",
                "settings",
                "puzzle",
                "play",
                "download",
                "link",
                "folder-open",
                "hard-drive",
                "app-window",
                "star-off",
                "eye-off",
                "eye",
                "sun",
                "pencil",
                "dices",
                "book-open",
                "archive",
                "history"
            ]
        },
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/lucide-static@{ref}/icons/{name}.svg",
            "ref": "1.49.0",
            "format": "Png",
            "outDir": "src/Images/Lucide",
            "colorToken": "ayy-color-destructive",
            "suffix": "-destructive",
            "icons": [
                "log-out",
                "trash-2"
            ]
        },
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/lucide-static@{ref}/icons/{name}.svg",
            "ref": "1.49.0",
            "format": "Png",
            "outDir": "src/Images/Lucide",
            "colorToken": "ayy-color-warning",
            "suffix": "-warning",
            "icons": [
                "star"
            ]
        }
    ]
}
