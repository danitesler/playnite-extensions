<!--
    Overlay on Playnite Default/DerivedStyles/PlayButton.xaml: the Play / Install button on the game page.
    ayywi Button, primary variant (src/components/button/button.css): radius-control (ControlCornerRadius, 12), 48px tall here,
    18px Unbounded Bold (700, 1.3 line height), white fill (PrimaryButtonBackgroundBrush) with black text
    (PrimaryButtonForegroundBrush), 1px transparent border. Keyboard focus: FocusVisual (2px ring, 2px outside).
    Motion, all from the ayywi tokens (duration.base 300ms; ease and spring curves as KeySplines):
      hover in/out 0.3s: the white plate (Rest) fades to 90 percent (ayywi's opacity 0.9; PrimaryButtonHoverBackgroundBrush is
          the same color at alpha, so the plate itself dims instead of a plate over it), shadow.glow fades in (0 0 18px at 18 percent: the 9-sliced glow.png mask in the plate color),
          the button lifts 2px (translateY -2) on the spring curve (0.175, 0.885, 0.32, 1.275).
      pressed: ayywi's :active cancels the lift (transform none) and has no scale: PressDrop moves the button back 2px and
          the plate fades to 80 percent. IsPressed is declared before IsMouseOver so that leaving while pressed ends at full opacity.
    No loops. Exit animations use FillBehavior Stop. The outer Grid keeps the original hit area, so the lift cannot
    flicker the hover at the bottom edge. IsEnabled: BaseStyle already fades a disabled button.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextBlock.LineHeight" Value="23.4" />
        <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="Lift" Y="0" />
                                    <TranslateTransform x:Name="PressDrop" Y="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Control x:Name="Glow" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource PrimaryButtonBackgroundBrush}"
                                     Margin="-24" Opacity="0" />
                            <Border x:Name="Rest" SnapsToDevicePixels="True"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.8" KeySpline="0.2,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressDrop" Storyboard.TargetProperty="Y"><SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="2" KeySpline="0.2,0,0,1" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0.9" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="PressDrop" Storyboard.TargetProperty="Y"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0.9" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0.36" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="-2" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Rest" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="1" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0" KeySpline="0.25,0.1,0.25,1" /></DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y"><SplineDoubleKeyFrame KeyTime="0:0:0.300" Value="0" KeySpline="0.175,0.885,0.32,1.275" /></DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
