<!--
    Overlay on Playnite Default/DerivedStyles/PropertyItemButton.xaml: the clickable field values of the game overview
    (a click filters the library by that value).
    Default: ayywi's link button (button.css, the ayy-button link variant): text color, no padding, underlined on hover, 1px
    vertical margin so link values and plain text values stack at the same rhythm.
    Chip: when the owning ItemsControl has Tag="Chip" (platforms, genres, categories, features, tags), ayywi's badge
    (src/components/badge/badge.css): ControlCornerRadius (12), 1px line-strong edge (InputBorderBrush), wash fill, padding 2 x 10, weight
    medium, 12px text (FontSizeSmall; the badge itself is 11px); hover lifts the fill to wash-hover and the edge to
    line-hover. The margin is the space-1-5 (6) gap of a badge row.
    Keyboard focus: FocusVisual on both.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                               TextWrapping="Wrap" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Background" Value="{DynamicResource PropertyItemBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chip" Padding="10,2,10,2" SnapsToDevicePixels="True"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
