<!--
    Overlay on Playnite Default/DerivedStyles/HighlightBorder.xaml. The input chrome that Default templates (date pickers, data grids,
    anything this theme does not restyle) put on a Border: ayywi's input edge, 1px InputBorderBrush (line-strong), ControlCornerRadius (12),
    InputHoverBorderBrush (line-hover) on hover, FocusBrush (color-ring) while focus is inside. No fill: the host keeps its own.
    Styled controls of this theme draw their own edge and focus ring, so they do not use this.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="HighlightBorder" TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
