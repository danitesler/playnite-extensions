<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. ayywi menu surface: PopupBorder (surface-raised, 1px line-strong edge,
    radius-control 12), MenuPadding (space-1, 4px) around the items. The padding is the items' margin, not the border's, so a separator
    can bleed to both edges like ayywi's (see Menu.xaml). Shared size scope so icon and shortcut columns line up across the items.
    Also the base of GameMenu, GameGroupMenu and TrayContextMenu.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Style="{DynamicResource PopupBorder}" Grid.IsSharedSizeScope="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="{DynamicResource MenuPadding}" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
