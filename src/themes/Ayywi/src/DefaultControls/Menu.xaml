<!--
    Overlay on Playnite Default/DefaultControls/Menu.xaml. ayywi dropdown menu: every popup menu (hamburger menu, top bar
    dropdowns, game and group menus, tray) on the raised card of ContextMenu.xaml. Roles: TopLevelHeader and TopLevelItem
    (a horizontal Menu bar, pill hover, unchanged), SubmenuHeader and SubmenuItem (every popup menu).
    The Separator and MenuItem.SeparatorStyleKey are both redefined (the Default one points at its own sibling).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Height="1"
                            SnapsToDevicePixels="true"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group break in every menu: ayywi's menu separator, a hairline that bleeds to both edges of the card (the items sit
         4px inside it, so the rule takes -4 on each side), 9px tall with the rule centred. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="-4,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="9" SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource MenuSeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TopLevelHeader: menu bar item opening a popup menu -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border">
            <Grid>
                <Border x:Name="HoverBorder" Background="{DynamicResource MenuItemHoverBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}" Visibility="Collapsed" />
                <TextBlock VerticalAlignment="Center" Padding="12,7" Style="{DynamicResource BaseTextBlockStyle}"
                           FontWeight="Medium" Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                </TextBlock>
                <Popup Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                    <Border Style="{DynamicResource PopupBorder}" SnapsToDevicePixels="True">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" Margin="{DynamicResource MenuPadding}"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="HoverBorder" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="HoverBorder" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- TopLevelItem -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Border x:Name="Border" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}">
            <TextBlock VerticalAlignment="Center" Padding="12,7" Style="{DynamicResource BaseTextBlockStyle}"
                       FontWeight="Medium" Foreground="{TemplateBinding Foreground}">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </TextBlock>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}" TargetName="Border" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Rows of every popup menu, compact: 32px items (ayywi menu item, radius-lg) inside the raised card of ContextMenu.xaml.
        - Row: a 22px lead gutter, a fixed 26px icon column (icon 16, at 0.7 at rest), the label in text, shortcuts as
          ayywi outline badges (line-strong hairline, radius-lg, muted caption text); a checked row draws the Lucide check.
        - Highlight (pointer or keyboard): the wash-hover plate fades in over duration.fast (0.15s, ease.standard as a
          0.2,0 0,1 spline) and the system's status dot (6px, primary white) pops in the lead gutter with a slight
          overshoot (BackEase, the ease.spring stand-in); the badge edge and text light up. Out over 0.2s.
        - Exit (gesture Alt+Q) is the one marked row: a destructive plate with primary-fg ink (the system's danger pair),
          a black dot and badge.
        - Submenu headers: the Lucide chevron at the right edge (muted, white highlighted or open) and a held wash plate
          while open; their submenus open on the same card.
        Recipe: docs/themes/menus.md.
    -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="32" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="MenuPlate" Background="{DynamicResource MenuItemHoverBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />
            <Ellipse x:Name="MenuDot" Width="6" Height="6" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Fill="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="MenuDotScale" ScaleX="0" ScaleY="0" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Grid Margin="22,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                </Grid.ColumnDefinitions>
                <!-- Ink socket behind the icon on the highlighted Exit row: Playnite's red Exit PNG cannot be recoloured and
                     would vanish on the destructive plate -->
                <Border x:Name="IconSocket" Width="22" Height="22" Margin="-3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource TextBrushDark}" CornerRadius="6" Visibility="Collapsed" />
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.7" />
                <ContentPresenter x:Name="CheckMark" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Visibility="Collapsed" TextElement.Foreground="{DynamicResource GlyphBrush}"
                                  Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconTemplate}" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <Border x:Name="MenuBadge" Grid.Column="2" Height="20" Margin="16,0,0,0" Padding="6,0" HorizontalAlignment="Right"
                        VerticalAlignment="Center" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusSmall}">
                    <TextBlock x:Name="GestureText" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="CheckMark" />
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuBadge" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="MenuBadge" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}" TargetName="MenuPlate" />
                <Setter Property="Fill" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuDot" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Icon" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="GestureText" />
                <Setter Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}" TargetName="MenuBadge" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuPlateIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuDot" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuPlate" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.2,0 0,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuDotScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuDotScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuPlateOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuDot" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuDotScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuDotScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="Icon" />
                <!-- primary-fg ink on the destructive plate (white would fall under 4.5:1) -->
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuLabel" />
                <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" TargetName="GestureText" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" TargetName="MenuBadge" />
                <Setter Property="Visibility" Value="Visible" TargetName="IconSocket" />
            </MultiTrigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="IconSocket" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="MenuRow" Height="32" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held wash plate while the submenu is open (a setter, so moving into the submenu never flickers) -->
            <Border x:Name="MenuHeld" Background="{DynamicResource ListItemHoverBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="MenuPlate" Background="{DynamicResource MenuItemHoverBrush}" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />
            <Ellipse x:Name="MenuDot" Width="6" Height="6" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Fill="{DynamicResource GlyphBrush}" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="MenuDotScale" ScaleX="0" ScaleY="0" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Grid Margin="22,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" Opacity="0.7" />
                <TextBlock x:Name="MenuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource BaseTextBlockStyle}"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <ContentPresenter RecognizesAccessKey="True" ContentSource="Header" />
                </TextBlock>
                <ContentPresenter x:Name="MenuChevron" Grid.Column="3" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource TextBrushDarker}"
                                  Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconTemplate}" />
            </Grid>
            <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                   HorizontalOffset="6" VerticalOffset="-5" Focusable="False" AllowsTransparency="True">
                <Grid MinWidth="200" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalMenuSurfaceTemplate}" Focusable="False" IsTabStop="False" />
                    <ScrollViewer Margin="5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Grid.IsSharedSizeScope="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Visibility" Value="Visible" TargetName="MenuHeld" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="MenuChevron" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="Icon" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" TargetName="MenuChevron" />
                <Setter Property="Opacity" Value="1" TargetName="Icon" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuPlateIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuDot" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuPlate" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.2,0 0,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuDotScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MenuDotScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuPlateOut">
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuDot" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="MenuPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuDotScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="MenuDotScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" TargetName="MenuRow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="true" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
