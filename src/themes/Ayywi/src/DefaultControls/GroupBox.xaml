<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml. ayywi card: ExpanderBackgroundBrush fill (surface), 1px WindowPanelSeparatorBrush
    edge (line), CornerRadiusLarge (radius-card, 16). Header: HeadingFontFamily, GroupBoxHeaderFontSize (16), Medium, padded by
    GroupBoxHeaderPadding (20,16,20,0); body: GroupBoxPadding (20) on all sides, so the gap under the title is the body's 20px top padding.
    A group box without a header draws just the body. GroupBoxHeaderMargin is not used: the body padding already is the gap.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border DockPanel.Dock="Top" Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="{DynamicResource CornerRadiusLarge}">
                        <DockPanel>
                            <Border x:Name="HeaderBorder" DockPanel.Dock="Top" Padding="{DynamicResource GroupBoxHeaderPadding}">
                                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                           FontSize="{DynamicResource GroupBoxHeaderFontSize}" FontWeight="Medium">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </TextBlock>
                            </Border>
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                              Margin="{TemplateBinding Padding}"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderBorder" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
