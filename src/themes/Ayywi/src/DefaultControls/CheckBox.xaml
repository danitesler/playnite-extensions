<!--
    Overlay on Playnite Default/DefaultControls/CheckBox.xaml. ayywi checkbox: 18px box (size-check), 1px CheckBoxBorderBrush edge
    (line-hover), 4px radius (radius-sm), CheckBoxCheckMarkBkBrush fill (wash), hover CheckBoxHoverBorderBrush edge (text-soft).
    Checked / indeterminate: GlyphBrush (color-primary) fill and edge, TextBrushDark (color-primary-fg) IconCheck or bar;
    checked hover CheckBoxCheckedHoverBackgroundBrush. Label gap 8px (space-2). Keyboard focus: CheckBoxFocusVisual ring.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource CheckBoxFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Border x:Name="BulletBorder" DockPanel.Dock="Left" CornerRadius="4"
                                    Width="18" Height="18" VerticalAlignment="Center"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{DynamicResource CheckBoxCheckMarkBkBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Grid>
                                    <ContentPresenter x:Name="CheckIcon" Visibility="Collapsed" Width="14" Height="14"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="{DynamicResource TextBrushDark}"
                                                      Content="{DynamicResource IconCheck}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                    <Border x:Name="IndeterminateIcon" Visibility="Collapsed" Width="10" Height="2" CornerRadius="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{DynamicResource TextBrushDark}" />
                                </Grid>
                            </Border>
                            <ContentPresenter DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="8,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="BulletBorder" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Setter Property="Background" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon" />
                            <Setter Property="Background" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource CheckBoxCheckedHoverBackgroundBrush}" TargetName="BulletBorder" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource CheckBoxCheckedHoverBackgroundBrush}" TargetName="BulletBorder" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
