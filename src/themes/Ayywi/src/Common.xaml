<!--
    Overlay on Playnite Default/Common.xaml. ayywi's spacing (comfortable density: control 40, small 32, large 48 tall;
    control text 14px; padding 18 (md); space scale 4/6/8/12/16/20/24) and focus.
    Playnite lays most controls out by padding, so each control key below turns ayywi's fixed heights into padding
    around 14px text (about 19px tall): 40 = 19 + 2 x 9 + 2 x 1 border.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: surface-raised, 1px line-strong edge, radius-control (12) -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus, as ayywi's focus-visible: 2px ring in color-ring, 2px outside the control. Pill radius (buttons, tabs). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="24" RadiusY="24" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: the same ring around a 4px box (radius-sm) and around the round radio. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="6" RadiusY="6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: control-pad-md (18) inline; 40 tall (size-control-md) -->
    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <!-- Text box, password box, dropdown: space-3 (12) inline; 40 tall -->
    <Thickness x:Key="InputPadding">12,5</Thickness>
    <!-- Menu: space-1 (4) inside the popup; item: space-2 / space-3 inline. ayywi items are 40 tall; menus here use 33
         (19 + 2 x 7) because Playnite's game menu is long. -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">8,7,12,7</Thickness>
    <!-- Select popup: space-1 around items, the same item as menus -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,7,12,7</Thickness>
    <!-- List box item: space-3 inline -->
    <Thickness x:Key="ListBoxItemPadding">12,8</Thickness>
    <!-- Card (group box) body: space-5 (20), header gap space-3 -->
    <Thickness x:Key="GroupBoxPadding">20</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">20,16,20,0</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">16</sys:Double>
    <!-- Tooltip: space-1-5 (6) block, space-3 (12) inline -->
    <Thickness x:Key="TooltipPadding">12,6</Thickness>
    <!-- Lucide at 18px (ayywi buttons draw 1.25em icons around 14px text) -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- shadow.glow as a mask: 9-slice of Images/fx/glow.png (96px, box edge at inset 24, radius 12; slices 36 / 24 / 36).
         Host at Margin -24 around the button, Foreground = the glow brush. Generated by art/fx.py. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="0,0,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="36,0,24,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="60,0,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="0,36,36,24" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="60,36,36,24" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="0,60,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="36,60,24,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Viewbox="60,60,36,36" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- menu-mark begin LocalAyywiMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a segmented pill, the ayywi tab control with its thumb. Hover (IsMouseOver): the thumb slides to the second segment (7.2px, 0.22s cubic in-out). Open (ContextMenu.IsOpen of the nearest Border): the pill fills with a breathing wash (20 to 40 percent, 1.1s, auto-reversed) and the dividers grow to 1.5 times their height until the menu closes; hover and open move different elements and the exits restore every property. -->
    <ControlTemplate x:Key="LocalAyywiMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="26" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Rectangle x:Name="PillFill" Canvas.Left="1" Canvas.Top="1" Width="24" Height="14" RadiusX="7" RadiusY="7" Fill="{TemplateBinding Foreground}" Opacity="0" />
                <Rectangle Canvas.Left="1" Canvas.Top="1" Width="24" Height="14" RadiusX="7" RadiusY="7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" />
                <Canvas x:Name="Divs" Width="26" Height="16" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform x:Name="DivS" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="9.4" Canvas.Top="4.5" Width="1" Height="7" Fill="{TemplateBinding Foreground}" Opacity="0.35" />
                    <Rectangle Canvas.Left="16.4" Canvas.Top="4.5" Width="1" Height="7" Fill="{TemplateBinding Foreground}" Opacity="0.35" />
                </Canvas>
                <Rectangle x:Name="Thumb" Canvas.Left="3.2" Canvas.Top="3" Width="5" Height="10" RadiusX="2.5" RadiusY="2.5" Fill="{TemplateBinding Foreground}">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="ThumbT" X="0" Y="0" /></Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ThumbT" Storyboard.TargetProperty="X" To="7.2" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ThumbT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.176" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PillFill" Storyboard.TargetProperty="Opacity" From="0.2" To="0.4" Duration="0:0:1.100" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DivS" Storyboard.TargetProperty="ScaleY" To="1.5" Duration="0:0:0.250"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PillFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.880" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="DivS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.200" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalAyywiMenuMarkTemplate -->
</ResourceDictionary>
