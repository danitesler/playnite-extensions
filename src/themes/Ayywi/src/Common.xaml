<!--
    Overlay on Playnite Default/Common.xaml. ayywi's spacing (comfortable density: control 40, small 32, large 48 tall;
    control text 14px; padding 18 (md); space scale 4/6/8/12/16/20/24) and focus.
    Playnite lays most controls out by padding, so each control key below turns ayywi's fixed heights into padding
    around 14px text (about 19px tall): 40 = 19 + 2 x 9 + 2 x 1 border.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: surface-raised, 1px line-strong edge, radius-control (12) -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus, as ayywi's focus-visible: 2px ring in color-ring, 2px outside the control. Pill radius (buttons, tabs). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="24" RadiusY="24" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: the same ring around a 4px box (radius-sm) and around the round radio. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="6" RadiusY="6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: control-pad-md (18) inline; 40 tall (size-control-md) -->
    <Thickness x:Key="ButtonPadding">18,9</Thickness>
    <!-- Text box, password box, dropdown: space-3 (12) inline; 40 tall -->
    <Thickness x:Key="InputPadding">12,9</Thickness>
    <!-- Menu: space-1 (4) inside the popup; item: space-2 / space-3 inline. ayywi items are 40 tall; menus here use 33
         (19 + 2 x 7) because Playnite's game menu is long. -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">8,7,12,7</Thickness>
    <!-- Select popup: space-1 around items, the same item as menus -->
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">8,7,12,7</Thickness>
    <!-- List box item: space-3 inline -->
    <Thickness x:Key="ListBoxItemPadding">12,8</Thickness>
    <!-- Card (group box) body: space-5 (20), header gap space-3 -->
    <Thickness x:Key="GroupBoxPadding">20</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">20,16,20,0</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">16</sys:Double>
    <!-- Tooltip: space-1-5 (6) block, space-3 (12) inline -->
    <Thickness x:Key="TooltipPadding">12,6</Thickness>
    <!-- Lucide at 18px (ayywi buttons draw 1.25em icons around 14px text) -->
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">360</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
</ResourceDictionary>
