<!--
    Overlay on Playnite Default/CustomControls/SearchBox.xaml.
    ayywi input (input.css: wash fill, 1px line-strong edge, radius-control 12, 40px tall, 12px inline padding, 14px
    text; hover edge line-hover; focus removes the edge and draws a 2px ring in color-ring): InputBackgroundBrush fill,
    InputBorderBrush edge, InputHoverBorderBrush on hover, FocusBrush ring on keyboard focus (an overlay border, so
    layout does not shift). A Lucide search icon (16px, muted) sits 12px from the start, the text 12px after it.
    Uses ControlCornerRadius (12) matching ayywi's control radius. ShowImage="False" (filter panel fields) drops
    the icon and shifts the text left.
    Chrome is drawn here around a chromeless text box (BareTextBox) so hosts can restyle it through Background,
    BorderBrush and Height.
    Playnite hides PART_SeachIcon while the box has focus or text, so it carries the placeholder ("Search", muted);
    the icon itself is a separate element that stays. PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon are
    Playnite's parts (all three must exist).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid>
                        <Border x:Name="Chrome" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <ContentControl x:Name="Glyph" Margin="12,0,0,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                                Foreground="{DynamicResource TextBrushDarker}"
                                                ContentTemplate="{DynamicResource SearchTextIconTemplate}" />
                                <TextBlock x:Name="PART_SeachIcon" Margin="40,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource BaseTextBlockStyle}"
                                           Foreground="{DynamicResource TextBrushDarker}"
                                           Text="{DynamicResource LOCSearchLabel}" />
                                <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                         VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                         Padding="38,0,36,0" />
                                <ContentControl x:Name="PART_ClearTextIcon" Margin="0,0,12,0" Focusable="False" IsTabStop="False"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                                Background="Transparent"
                                                Foreground="{DynamicResource TextBrushDarker}"
                                                ContentTemplate="{DynamicResource ClearTextIconTemplate}" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRing" BorderThickness="2" Visibility="Collapsed"
                                IsHitTestVisible="False" SnapsToDevicePixels="True"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                BorderBrush="{DynamicResource FocusBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Chrome" />
                        </Trigger>
                        <Trigger SourceName="PART_ClearTextIcon" Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="PART_ClearTextIcon" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="FocusRing" />
                            <Setter Property="BorderBrush" Value="Transparent" TargetName="Chrome" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Glyph" />
                            <Setter Property="Padding" Value="12,0,36,0" TargetName="PART_TextInpuText" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
