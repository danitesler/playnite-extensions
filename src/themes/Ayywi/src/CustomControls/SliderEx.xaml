<!--
    Overlay on Playnite Default/CustomControls/SliderEx.xaml. SliderEx is a Slider with a value edit box in code; it takes the theme's
    Slider template (DefaultControls/Slider.xaml) through BasedOn.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SliderEx}" BasedOn="{StaticResource {x:Type Slider}}" />
</ResourceDictionary>
