<!--
    Ayywi: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    ayywi is monochrome: black page, white as the primary color, hairlines and washes mixed from the text color.
    Surfaces (dark): bg 000000 (window, shell, content), surface 0a0a0a (cards), surface-raised 141414 (popups).
    Lines are alpha strokes (line 12%, line-strong 14%, line-hover 25%); popup edges are flattened onto the popup.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). Placeholder syntax: see reference.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). ayywi body text is 14px (text-sm), controls 12 to 16, headings text-md to 2xl. -->
    <sys:Double x:Key="FontSizeSmall">{{px:ayy-text-xs}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:ayy-text-sm}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:ayy-text-md}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:ayy-text-xl}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:ayy-text-2xl}}</sys:Double>
    <!-- Unbounded bundled font for headings/titles/play button, falling back to installed Unbounded, Sora, or Segoe UI. -->
    <FontFamily x:Key="FontFamily">Sora, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Unbounded, Unbounded, Sora, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- Shape (Playnite keys): hairline borders; radius-control (12) is the medium step. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:ayy-radius-control}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">10</Thickness>

    <!-- Radius scale: radius-lg (menu items, small tiles), radius-card (cards), radius-3xl, pill (buttons, chips, tabs). -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:ayy-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:ayy-radius-card}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:ayy-radius-3xl}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">10000</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor (selection, checked, links) is color-primary (white), TextColorDark is color-primary-fg (black).
        MainColor is the wash fill flattened onto surface; HoverColor is wash-hover flattened onto surface.
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{ayy-color-text}}</Color>
    <Color x:Key="TextColorDarker">{{ayy-color-muted}}</Color>
    <Color x:Key="TextColorDark">{{ayy-color-primary-fg}}</Color>
    <Color x:Key="MainColor">{{ayy-color-wash@ayy-color-surface}}</Color>
    <Color x:Key="MainColorDark">{{ayy-color-surface}}</Color>
    <Color x:Key="HoverColor">{{ayy-color-wash-hover@ayy-color-surface}}</Color>
    <Color x:Key="GlyphColor">{{ayy-color-primary}}</Color>
    <Color x:Key="HighlightGlyphColor">{{ayy-color-line-hover}}</Color>
    <Color x:Key="PopupBackgroundColor">{{ayy-color-surface-raised}}</Color>
    <Color x:Key="PopupBorderColor">{{ayy-color-line-strong@ayy-color-surface-raised}}</Color>
    <Color x:Key="BackgroundToneColor">{{ayy-color-surface}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{ayy-color-hairline}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{ayy-color-line}}</Color>
    <Color x:Key="DataChangeNotifColor">{{ayy-color-warning}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{ayy-color-line-strong}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{ayy-color-surface-raised}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{ayy-color-wash}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{ayy-color-wash}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{ayy-color-success}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{ayy-color-destructive}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{ayy-color-warning}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{ayy-color-warning}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{ayy-color-surface}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{ayy-color-bg}}" />

    <!-- Shell: one black layer; cards (surface) and hairlines separate things -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{ayy-color-bg}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{ayy-color-bg}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{ayy-color-bg}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{ayy-color-wash}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{ayy-color-wash}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{ayy-color-wash}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{ayy-color-text}}" />

    <!-- States: "on" is inverted (white fill, black text) like a selected ayywi tab; list rows use wash-hover -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{ayy-color-primary}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{ayy-color-primary/90}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{ayy-color-primary-fg}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{ayy-color-wash}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{ayy-color-wash-hover}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{ayy-color-wash-hover}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{ayy-color-ring}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{ayy-color-line-hover}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{ayy-color-destructive}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{ayy-color-primary-fg}}" />

    <!-- Buttons: default is ayywi's secondary (wash fill, line edge), Play is primary (white, black text) -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{ayy-color-text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{ayy-color-wash-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{ayy-color-line}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{ayy-color-line}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{ayy-color-primary}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{ayy-color-primary/90}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{ayy-color-primary/80}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{ayy-color-primary-fg}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{ayy-color-primary}}" />

    <!-- Inputs: wash fill, line-strong edge, line-hover edge on hover -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{ayy-color-wash}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{ayy-color-wash}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{ayy-color-line-strong}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{ayy-color-line-hover}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{ayy-color-line-hover}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{ayy-color-text-soft}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{ayy-color-primary/90}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{ayy-color-line}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{ayy-color-primary}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{ayy-color-line-hover}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{ayy-color-primary}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{ayy-color-primary}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{ayy-color-wash-hover}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{ayy-color-line-strong}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{ayy-color-line-hover}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{ayy-color-line-strong}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{ayy-color-line-hover}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{ayy-color-primary}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{ayy-color-line-hover}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{ayy-color-wash}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{ayy-color-line-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{ayy-color-wash-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{ayy-color-primary}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{ayy-color-wash}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{ayy-color-text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{ayy-color-wash-hover}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{ayy-color-hairline}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{ayy-color-text}}" />
</ResourceDictionary>
