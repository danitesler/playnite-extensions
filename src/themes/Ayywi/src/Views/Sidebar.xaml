<!--
    Overlay on Playnite Default/Views/Sidebar.xaml.
    A 64px icon rail on the shell layer (ShellBackgroundBrush) with a 1px WindowPanelSeparatorBrush hairline on the
    edge facing the views. Rail = 12px gutter + 40px items + 12px gutter (space-3, size-control-md). The main menu
    button (MainMenuButton, defined here, also used by Views/TopPanel.xaml when the sidebar is hidden) sits 8px from
    the top so it centers on the 56px top bar; items start at y = 56.
    Left and right: vertical rail. Right also starts 56px down so the window buttons (Views/TopPanel.xaml keeps the
    same corner clear) sit above it. Top and bottom: a 56px strip (8px above and below the 40px items); the top strip
    keeps 168px clear on its right for the window buttons (3 x 48 + 12 edge + 12 gap).
    PART_ElemMainMenu and PART_PanelSideBarItems are Playnite's parts; Playnite collapses PART_ElemMainMenu when the
    main menu lives in the top bar.

    MainMenuButton (button.css, secondary + icon: 40 x 40, pill so it is a circle, wash fill, 1px line edge, hover
    wash-hover fill and line-hover edge): MainMenuButtonBackgroundBrush fill, ButtonBorderBrush edge, InputHoverBorderBrush
    hover edge, MainMenuButtonForegroundBrush icon (IconSize).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="MainMenuButton" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusFull}" />
        <Setter Property="Background" Value="{DynamicResource MainMenuButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MainMenuButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                            Background="{DynamicResource ShellBackgroundBrush}"
                            x:Name="BorderContentHolder" Margin="{TemplateBinding Padding}">
                        <DockPanel x:Name="DockContentHolder">
                            <Border x:Name="PART_ElemMainMenu" Style="{StaticResource MainMenuButton}"
                                    DockPanel.Dock="Top" Margin="12,8,12,8">
                                <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <!-- The 12px gutter is the panel's margin: the scroll presenter clips at its own edge. -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" Margin="12,0,12,12" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Main menu hidden (it is in the top bar): the items still start at the top bar's bottom edge. -->
                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemMainMenu}" Value="Collapsed">
                            <Setter Property="Margin" Value="0,56,0,0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,56,0,0" />
                            <Setter Property="BorderThickness" Value="1,1,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Margin" Value="12,8,12,8" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Margin" Value="0" TargetName="ScrollSidebarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="BorderThickness" Value="0,0,0,1" TargetName="BorderContentHolder" />
                            <Setter Property="Margin" Value="12,8,4,8" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,168,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="4,8,4,8" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="BorderThickness" Value="0,1,0,0" TargetName="BorderContentHolder" />
                            <Setter Property="Margin" Value="12,8,4,8" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="4,8,4,8" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
