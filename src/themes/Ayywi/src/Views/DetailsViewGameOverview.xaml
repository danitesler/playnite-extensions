                                                <HtmlTextView x:Name="PART_HtmlDescription"
                                                              TextElement.Foreground="{DynamicResource TextBrush}"
                                                              Tag="{DynamicResource GlyphBrush}"
                                                              HtmlFontSize="{DynamicResource FontSize}"
                                                              HtmlFontFamily="{DynamicResource FontFamily}"
                                                              HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                              LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                              pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,0,24" Padding="{DynamicResource GroupBoxPadding}"
                                                Background="{DynamicResource ExpanderBackgroundBrush}"
                                                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="1"
                                                CornerRadius="{DynamicResource CornerRadiusLarge}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemNotes}" Value="Collapsed">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel x:Name="PART_ElemNotes">
                                                <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCNotesLabel}" Margin="0,0,0,12" />
                                                <TextBox x:Name="PART_TextNotes" Style="{DynamicResource BareTextBox}" IsReadOnly="True"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Padding="0" BorderThickness="0"
                                                         Foreground="{DynamicResource TextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
</Grid>
</Grid>
                            </Grid>
                            <!-- Empty state (no game selected), ayywi empty-state.css: an icon tile (wash fill, muted glyph, radius-control) over a
                                 heading-font title, no description, centered in the visible area (ViewportHeight of the scroll host). No loop: the
                                 system has none; it fades in over duration.slow (450ms, out-expo) when it appears (RemoveStoryboard on exit). -->
                            <Grid VerticalAlignment="Top" Height="{Binding ViewportHeight, ElementName=PART_ScrollViewHost}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,24">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="EmptyFadeIn">
                                                            <Storyboard>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1" KeySpline="0.25,1,0.5,1" />
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="EmptyFadeIn" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="64" Height="64" HorizontalAlignment="Center" CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Background="{DynamicResource ButtonBackgroundBrush}">
                                        <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <!-- lucide: gamepad-2 -->
                                                <Path Data="M 6 11 L 10 11 M 8 9 L 8 13 M 15 12 L 15.01 12 M 18 10 L 18.01 10 M 17.32 5 H 6.68 a 4 4 0 0 0 -3.978 3.59 c -0.006 0.052 -0.01 0.101 -0.017 0.152 C 2.604 9.416 2 14.456 2 16 a 3 3 0 0 0 3 3 c 1 0 1.5 -0.5 2 -1 l 1.414 -1.414 A 2 2 0 0 1 9.828 16 h 4.344 a 2 2 0 0 1 1.414 0.586 L 17 18 c 0.5 0.5 1 1 2 1 a 3 3 0 0 0 3 -3 c 0 -1.545 -0.604 -6.584 -0.685 -7.258 c -0.007 -0.05 -0.011 -0.1 -0.017 -0.151 A 4 4 0 0 0 17.32 5 Z" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                               FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
