<!--
    Bloodpetal: RadioButton. A round gem socket, the page pips under the source's dialogs: an 18px iron ring, dark when
    empty; on, a cut red gem sits in it with a speck of light. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <DockPanel Background="Transparent">
                        <Grid Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Ellipse x:Name="Socket" Fill="{DynamicResource CheckBoxCheckMarkBkBrush}" Stroke="{DynamicResource CheckBoxBorderBrush}" StrokeThickness="1.5" />
                            <Ellipse Margin="2.5" Stroke="{DynamicResource BevelShadowBrush}" StrokeThickness="1" Opacity="0.8" />
                            <Grid x:Name="Gem" Visibility="Collapsed">
                                <Ellipse Margin="4" Fill="{DynamicResource DangerBrush}" />
                                <Ellipse Width="3" Height="3" Margin="6,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource TextBrush}" Opacity="0.75" />
                            </Grid>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Socket" Property="Stroke" Value="{DynamicResource CheckBoxHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Gem" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
