<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is Diablo IV's iron-framed Sanctuary panel (LocalSanctuaryPanelTemplate, shared by
    ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: tomb-black cut stone (PopupBackgroundBrush with subtle stone grain) framed in FramedPlateTemplate (black
      outline, pewter line, dark inner line, four 7px iron corner studs), with a molten ember seam (GlowLineTemplate)
      glowing along the top inner edge. Square corners, no DropShadowEffect.
    - Rows, rules and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalSanctuaryPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" />
            <Rectangle Margin="2" Fill="{DynamicResource BevelLightBrush}" Opacity="0.22">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/stone.png'}" TileMode="Tile" Stretch="None"
                                Viewport="0,0,256,256" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <!-- Molten ember seam glowing along the top inner edge -->
            <Grid Height="10" Margin="4,2,4,0" VerticalAlignment="Top" ClipToBounds="True">
                <Control Margin="0,-3,0,0" VerticalAlignment="Top" Focusable="False" IsTabStop="False"
                         Foreground="{DynamicResource TopPanelRuleStartBrush}"
                         BorderBrush="{DynamicResource TopPanelRuleEndBrush}"
                         Template="{DynamicResource GlowLineTemplate}" />
            </Grid>
            <!-- Iron frame with four corner studs -->
            <Control Focusable="False" IsTabStop="False" Foreground="{DynamicResource PopupBorderBrush}"
                     Template="{DynamicResource FramedPlateTemplate}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="228" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalSanctuaryPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="6,8,6,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
