<!--
    Bloodpetal: GroupBox as a source panel: pitch body inside the iron frame, headed by a 30px stone band that opens with
    the four-point ornament and carries the title in serif small capitals. Content-sized, no fixed widths: the band is a
    BevelTemplate (a Border with a tiled mask, no desired width) and the ornament is 10px, so Statistics sections stay
    compact cards. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{DynamicResource ExpanderBackgroundBrush}" Padding="5">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" MinHeight="30" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                    <Control Template="{DynamicResource BevelTemplate}" Background="{DynamicResource HeadingRuleBrush}"
                                             BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1" Focusable="False" />
                                    <DockPanel Margin="12,5,14,5" LastChildFill="True">
                                        <Path DockPanel.Dock="Left" Width="10" Height="10" Margin="0,1,10,0" VerticalAlignment="Center" Fill="{DynamicResource HeadingMarkerBrush}"
                                              Data="M5,0.4 L6.6,2 5,3.6 3.4,2Z M2,3.4 L3.6,5 2,6.6 0.4,5Z M8,3.4 L9.6,5 8,6.6 6.4,5Z M5,6.4 L6.6,8 5,9.6 3.4,8Z" />
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                          TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                          TextElement.FontWeight="Bold"
                                                          Typography.Capitals="SmallCaps"
                                                          TextElement.Foreground="{DynamicResource HeadingForegroundBrush}" />
                                    </DockPanel>
                                </Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                        <Control Template="{DynamicResource FramedPlateTemplate}" Foreground="{DynamicResource FrameBrush}" Focusable="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
