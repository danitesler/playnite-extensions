<!--
    Bloodpetal: Button. A cut stone slab (BevelTemplate: grain, lit top edge, shadowed bottom) in a pewter outline with a
    carved line 2px inside, serif small capitals in bone. Hover lifts the stone and gilds the label; press sinks it.
    The default button is the blood plate (SelectionBarTemplate): wine lit from its centre inside a blood rim, gilt label,
    the way every confirm button in the source is drawn. Width 41 trigger: ThemeModifier's icon buttons.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Typography.Capitals" Value="SmallCaps" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="Slab" Template="{DynamicResource BevelTemplate}" Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Focusable="False" />
                        <Border x:Name="Carve" Margin="2" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1" Opacity="0.6" IsHitTestVisible="False" />
                        <Control x:Name="Blood" Template="{DynamicResource SelectionBarTemplate}" Foreground="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}" Visibility="Collapsed" Focusable="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Blood" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Slab" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Carve" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonGlowBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
