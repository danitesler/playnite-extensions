<!--
    Bloodpetal: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). Token names (bp-*) live in tokens.css; each
    placeholder names the token that plays the key's role. Role map: ../AGENTS.md -> Tokens; measurements: ../RESEARCH.md.
    Theme XAML reads brushes only, never Color keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: carved serif capitals for headings, a plain humanist sans for everything read at length. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">34</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-heading|Palatino Linotype}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape: square cut stone and iron. Nothing in the source is rounded but its gems. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{bp-bone}}</Color>
    <Color x:Key="TextColorDarker">{{bp-parchment}}</Color>
    <Color x:Key="TextColorDark">{{bp-abyss}}</Color>
    <Color x:Key="MainColor">{{bp-slate}}</Color>
    <Color x:Key="MainColorDark">{{bp-pitch}}</Color>
    <Color x:Key="HoverColor">{{bp-slab}}</Color>
    <Color x:Key="GlyphColor">{{bp-gilt}}</Color>
    <Color x:Key="HighlightGlyphColor">{{bp-gilt-lit}}</Color>
    <Color x:Key="PopupBackgroundColor">{{bp-tomb}}</Color>
    <Color x:Key="PopupBorderColor">{{bp-pewter}}</Color>
    <Color x:Key="BackgroundToneColor">{{bp-pitch}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{bp-iron}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{bp-iron}}</Color>
    <Color x:Key="DataChangeNotifColor">{{bp-legend}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{bp-iron-lit}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{bp-tomb}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{bp-stone}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{bp-slate}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{bp-verdant}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{bp-hot}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{bp-legend}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{bp-legend}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{bp-pitch}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{bp-pitch}}" />

    <!-- Surfaces and art -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{bp-abyss}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{bp-pitch}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{bp-slab-dim}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{bp-pitch}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{bp-abyss}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{bp-clot}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the theme's
         own ArtTint color, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{bp-clot}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{bp-wine}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{bp-gilt}}" />

    <!-- Selection and states -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{bp-wine}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{bp-blood}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{bp-bone}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{bp-stone}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{bp-wine}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{bp-stone}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{bp-bone}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{bp-gem}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{bp-bone}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{bp-bone}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{bp-gilt-lit}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{bp-pewter}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{bp-slab}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{bp-slab-dim}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{bp-wine}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{bp-blood}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{bp-blood}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{bp-oxide}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{bp-gilt-lit}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{bp-hot}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{bp-wine}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{bp-slate}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{bp-iron-lit}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{bp-pewter}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{bp-pewter}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{bp-steel}}" />

    <!-- Tracks and thumbs -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{bp-well}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{bp-steel}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{bp-bone}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{bp-parchment}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{bp-well}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{bp-gem}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{bp-slab}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{bp-pewter}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{bp-slab}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{bp-pewter}}" />

    <!-- Tabs, covers, shell items -->
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{bp-parchment}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{bp-bone}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{bp-ember}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{bp-steel}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{bp-bone}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{bp-slab}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{bp-wine}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{bp-dust}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{bp-gilt-lit}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{bp-hot}}" />

    <!-- Metadata, menus, tooltips, dialogs -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{bp-slate}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{bp-parchment}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{bp-wine}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{bp-iron}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{bp-parchment}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{bp-pewter}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{bp-slab-dim}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{bp-bone}}" />

    <!-- Frames and headings -->
    <SolidColorBrush x:Key="FrameBrush" Color="{{bp-pewter}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{bp-iron}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{bp-steel}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{bp-iron}}" />
    <SolidColorBrush x:Key="TextShadowBrush" Color="{{bp-abyss}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{bp-bone}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{bp-steel}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{bp-slab}}" />

    <!-- Stone, iron and fire: the slab's lit and shadowed edges, the grain laid over it, the seam's two layers. -->
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{bp-slab-lit}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{bp-abyss}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{bp-stone}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{bp-ember}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{bp-ember-core}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{bp-iron-lit}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{bp-abyss}}" />
    <SolidColorBrush x:Key="SelectedSheenBrush" Color="{{bp-hot}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{bp-slate}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{bp-iron-lit}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{bp-legend}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{bp-gem}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{bp-abyss}}" />
</ResourceDictionary>
