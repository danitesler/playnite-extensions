<!--
    Bloodpetal: spacing, focus and the shared motifs. Measurements: ../RESEARCH.md.
      BevelTemplate         a cut stone slab: fill, grain, a lit top edge and a shadowed bottom edge (section bands, tabs, rails)
      RivetsTemplate        four square iron studs, one on each corner of a frame
      FramedPlateTemplate   the iron panel frame: black outline, pewter line, a dark line 2px inside, studs on the corners
      SelectionBarTemplate  the blood plate: wine fill lit from its centre, a blood rim inside a black outline
      GlowLineTemplate      the ember seam: a molten crack (Foreground glow, BorderBrush core), tiles in x
      GlowFrameTemplate     bloom behind a plate
      DividerTemplate       the four-point ornament running into a rule
      CornerMarksTemplate   bone corner ticks (keyboard focus)
    Sprites are white masks filled with theme brushes, so ThemeModifier edits reach them. None of these report a
    desired width of their own (Statistics cards stay compact).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Buttons carry serif capitals with 18px of stone either side; fields are wells with 9px. -->
    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <Thickness x:Key="InputPadding">9,5</Thickness>
    <Thickness x:Key="MenuPadding">3,4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">3,4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,7</Thickness>
    <Thickness x:Key="GroupBoxPadding">16,14,16,16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,0</Thickness>
    <Thickness x:Key="TooltipPadding">12,8</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">360</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Stone slab. Background = the stone, BorderBrush + BorderThickness = its outline. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="Control">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid>
                <Rectangle Fill="{DynamicResource BevelLightBrush}" Opacity="0.5">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/stone.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,256,256" ViewportUnits="Absolute" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Opacity="0.6" />
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.85" />
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- Iron studs: 7px squares with a lit corner, sitting on the frame's corners. -->
    <ControlTemplate x:Key="RivetsTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{TemplateBinding Foreground}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1">
                <Rectangle Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            </Border>
            <Border Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{TemplateBinding Foreground}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1">
                <Rectangle Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            </Border>
            <Border Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{TemplateBinding Foreground}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1">
                <Rectangle Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            </Border>
            <Border Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{TemplateBinding Foreground}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1">
                <Rectangle Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Iron frame. Foreground = the pewter line and studs. Overlay it on a panel; it draws no fill. -->
    <ControlTemplate x:Key="FramedPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1" />
            <Border Margin="1" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" />
            <Border Margin="3" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" />
            <Control Template="{DynamicResource RivetsTemplate}" Foreground="{TemplateBinding Foreground}" Focusable="False" />
        </Grid>
    </ControlTemplate>

    <!-- Blood plate. Foreground = fill, BorderBrush = rim. The centre is lit through a radial mask. -->
    <ControlTemplate x:Key="SelectionBarTemplate" TargetType="Control">
        <Border Background="{TemplateBinding Foreground}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1"
                SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid>
                <Rectangle Fill="{DynamicResource SelectedSheenBrush}" Opacity="0.34">
                    <Rectangle.OpacityMask>
                        <RadialGradientBrush RadiusX="0.62" RadiusY="0.95">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- Ember seam, 16px tall: host it with a negative vertical margin so only the crack takes room. -->
    <ControlTemplate x:Key="GlowLineTemplate" TargetType="Control">
        <Grid Height="16" IsHitTestVisible="False">
            <Rectangle Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/seam.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,1024,16" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/seam-core.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,1024,16" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Bloom. The host decides its own bleed with a negative margin. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- The four-point ornament that opens every section band, then a rule that takes the rest of the row. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" VerticalAlignment="Center" Height="10" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Width="10" Height="10" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}"
                  Data="M5,0.4 L6.6,2 5,3.6 3.4,2Z M2,3.4 L3.6,5 2,6.6 0.4,5Z M8,3.4 L9.6,5 8,6.6 6.4,5Z M5,6.4 L6.6,8 5,9.6 3.4,8Z" />
            <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0.45" />
        </Grid>
    </ControlTemplate>

    <!-- Bone corner ticks, arm 8, 1px: the frame the game puts on a selected slot, cut down to its corners. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,8 L0,0 8,0 8,1 1,1 1,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L8,0 8,8 7,8 7,1 0,1Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L1,0 1,7 8,7 8,8 0,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M7,0 L8,0 8,8 0,8 0,7 7,7Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Keyboard focus: bone corner ticks 3px outside the control. -->
    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a three-petal bud: a solid petal in the middle and two outlined
         petals folded against it, drawn in the host's Foreground (the rail's own hover trigger heats the colour), 20x20 over
         a pivot at the stem. Hover (IsMouseOver of the nearest Border, so the whole 44x62 button counts): the outer petals
         unfurl 14 degrees (BackEase, 0.26s) and fold back on exit. Open (the menu's ContextMenu.IsOpen on the nearest Border,
         which is PART_ElemMainMenu): the bud is in bloom: the outer petals open a further 28 degrees and a blood gem
         kindles in the heart of the middle petal and breathes (scale 1 to 1.25, 1.8s) until the menu closes. Each outer petal
         carries two rotations (hover, open) and the gem its own scale, so the states never fight over a property. -->
    <ControlTemplate x:Key="LocalBloodpetalMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="False">
            <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Path Data="M10,2 C13,6 14.5,9 14.5,12 C14.5,15 12.5,17.5 10,17.5 C7.5,17.5 5.5,15 5.5,12 C5.5,9 7,6 10,2Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.25">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform CenterX="10" CenterY="17.5" ScaleX="0.82" ScaleY="0.82" />
                            <RotateTransform x:Name="HoverL" CenterX="10" CenterY="17.5" Angle="-16" />
                            <RotateTransform x:Name="OpenL" CenterX="10" CenterY="17.5" Angle="0" />
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>
                <Path Data="M10,2 C13,6 14.5,9 14.5,12 C14.5,15 12.5,17.5 10,17.5 C7.5,17.5 5.5,15 5.5,12 C5.5,9 7,6 10,2Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.25">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform CenterX="10" CenterY="17.5" ScaleX="0.82" ScaleY="0.82" />
                            <RotateTransform x:Name="HoverR" CenterX="10" CenterY="17.5" Angle="16" />
                            <RotateTransform x:Name="OpenR" CenterX="10" CenterY="17.5" Angle="0" />
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>
                <Path Data="M10,2 C13,6 14.5,9 14.5,12 C14.5,15 12.5,17.5 10,17.5 C7.5,17.5 5.5,15 5.5,12 C5.5,9 7,6 10,2Z" Fill="{TemplateBinding Foreground}" />
                <Path Data="M10,17.5 V20" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.25" />
                <Rectangle x:Name="Gem" Canvas.Left="8.25" Canvas.Top="10.25" Width="3.5" Height="3.5" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="GemScale" ScaleX="0.2" ScaleY="0.2" />
                            <RotateTransform Angle="45" />
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverL" Storyboard.TargetProperty="Angle" To="-30" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HoverR" Storyboard.TargetProperty="Angle" To="30" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverL" Storyboard.TargetProperty="Angle" To="-16" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverR" Storyboard.TargetProperty="Angle" To="16" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="OpenL" Storyboard.TargetProperty="Angle" To="-28" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="OpenR" Storyboard.TargetProperty="Angle" To="28" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Gem" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.12" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="GemScale" Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.12" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GemScale" Storyboard.TargetProperty="ScaleY" To="1" BeginTime="0:0:0.12" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GemScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.25" BeginTime="0:0:0.45" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GemScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.25" BeginTime="0:0:0.45" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="OpenL" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.24" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="OpenR" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.24" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Gem" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GemScale" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="GemScale" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
