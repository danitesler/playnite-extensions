<!--
    Bloodpetal: spacing, focus and the shared motifs. Measurements: ../RESEARCH.md.
      BevelTemplate         a cut stone slab: fill, grain, a lit top edge and a shadowed bottom edge (section bands, tabs, rails)
      RivetsTemplate        four square iron studs, one on each corner of a frame
      FramedPlateTemplate   the iron panel frame: black outline, pewter line, a dark line 2px inside, studs on the corners
      SelectionBarTemplate  the blood plate: wine fill lit from its centre, a blood rim inside a black outline
      GlowLineTemplate      the ember seam: a molten crack (Foreground glow, BorderBrush core), tiles in x
      GlowFrameTemplate     bloom behind a plate
      DividerTemplate       the four-point ornament running into a rule
      CornerMarksTemplate   bone corner ticks (keyboard focus)
    Sprites are white masks filled with theme brushes, so ThemeModifier edits reach them. None of these report a
    desired width of their own (Statistics cards stay compact).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <!-- Buttons carry serif capitals with 18px of stone either side; fields are wells with 9px. -->
    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <Thickness x:Key="InputPadding">9,5</Thickness>
    <Thickness x:Key="MenuPadding">3,4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">3,4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,7</Thickness>
    <Thickness x:Key="GroupBoxPadding">16,14,16,16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,0</Thickness>
    <Thickness x:Key="TooltipPadding">12,8</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">360</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Stone slab. Background = the stone, BorderBrush + BorderThickness = its outline. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="Control">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid>
                <Rectangle Fill="{DynamicResource BevelLightBrush}" Opacity="0.5">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/stone.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,256,256" ViewportUnits="Absolute" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" Opacity="0.6" />
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" Opacity="0.85" />
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- Iron studs: 7px squares with a lit corner, sitting on the frame's corners. -->
    <ControlTemplate x:Key="RivetsTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{TemplateBinding Foreground}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1">
                <Rectangle Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            </Border>
            <Border Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{TemplateBinding Foreground}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1">
                <Rectangle Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            </Border>
            <Border Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{TemplateBinding Foreground}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1">
                <Rectangle Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            </Border>
            <Border Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{TemplateBinding Foreground}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1">
                <Rectangle Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Iron frame. Foreground = the pewter line and studs. Overlay it on a panel; it draws no fill. -->
    <ControlTemplate x:Key="FramedPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1" />
            <Border Margin="1" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" />
            <Border Margin="3" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" />
            <Control Template="{DynamicResource RivetsTemplate}" Foreground="{TemplateBinding Foreground}" Focusable="False" />
        </Grid>
    </ControlTemplate>

    <!-- Blood plate. Foreground = fill, BorderBrush = rim. The centre is lit through a radial mask. -->
    <ControlTemplate x:Key="SelectionBarTemplate" TargetType="Control">
        <Border Background="{TemplateBinding Foreground}" BorderBrush="{DynamicResource BevelShadowBrush}" BorderThickness="1"
                SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid>
                <Rectangle Fill="{DynamicResource SelectedSheenBrush}" Opacity="0.34">
                    <Rectangle.OpacityMask>
                        <RadialGradientBrush RadiusX="0.62" RadiusY="0.95">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- Ember seam, 16px tall: host it with a negative vertical margin so only the crack takes room. -->
    <ControlTemplate x:Key="GlowLineTemplate" TargetType="Control">
        <Grid Height="16" IsHitTestVisible="False">
            <Rectangle Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/seam.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,1024,16" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Fill="{TemplateBinding BorderBrush}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/seam-core.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,1024,16" ViewportUnits="Absolute" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Bloom. The host decides its own bleed with a negative margin. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- The four-point ornament that opens every section band, then a rule that takes the rest of the row. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" VerticalAlignment="Center" Height="10" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Width="10" Height="10" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}"
                  Data="M5,0.4 L6.6,2 5,3.6 3.4,2Z M2,3.4 L3.6,5 2,6.6 0.4,5Z M8,3.4 L9.6,5 8,6.6 6.4,5Z M5,6.4 L6.6,8 5,9.6 3.4,8Z" />
            <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0.45" />
        </Grid>
    </ControlTemplate>

    <!-- Bone corner ticks, arm 8, 1px: the frame the game puts on a selected slot, cut down to its corners. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,8 L0,0 8,0 8,1 1,1 1,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L8,0 8,8 7,8 7,1 0,1Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L1,0 1,7 8,7 8,8 0,8Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M7,0 L8,0 8,8 0,8 0,7 7,7Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Keyboard focus: bone corner ticks 3px outside the control. -->
    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Control Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource FocusBrush}" Margin="-3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
