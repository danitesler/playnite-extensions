<!--
    Bloodpetal: left rail, 44px of dark cut stone (grain, no plates at rest) closed on its inner edge by an iron line
    beside a black one. The main menu is the rail's seal: a 32px blood plate holding the theme's gilt petal (no owner
    mark), a four-point ornament under it. Hover heats the plate. With the sidebar at the top or bottom the ornament
    and the edge drop away. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource TopPanelBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <Rectangle IsHitTestVisible="False" Fill="{DynamicResource BevelLightBrush}" Opacity="0.45">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/stone.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,256,256" ViewportUnits="Absolute" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <DockPanel x:Name="DockContentHolder">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="62" Margin="0,0,0,2"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Control x:Name="SealBloom" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}"
                                                 Width="44" Height="44" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0" Focusable="False" />
                                        <Control x:Name="Seal" Template="{DynamicResource SelectionBarTemplate}" Foreground="{DynamicResource MainMenuButtonBackgroundBrush}"
                                                 BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" Width="32" Height="32" VerticalAlignment="Top" Margin="0,8,0,0" Focusable="False" />
                                        <ContentControl x:Name="MenuMark" Content="{DynamicResource IconMainMenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource MainMenuButtonForegroundBrush}" Focusable="False"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" />
                                        <Path x:Name="SealOrnament" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" Fill="{DynamicResource HeadingMarkerBrush}" Opacity="0.7"
                                              Data="M5,0.4 L6.6,2 5,3.6 3.4,2Z M2,3.4 L3.6,5 2,6.6 0.4,5Z M8,3.4 L9.6,5 8,6.6 6.4,5Z M5,6.4 L6.6,8 5,9.6 3.4,8Z" />
                                    </Grid>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                            <Border x:Name="EdgeRule" Width="2" HorizontalAlignment="Right" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                    Background="{DynamicResource BevelShadowBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Window art on: the rail is see-through; Views/Library.xaml draws the art under it. -->
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" TargetName="Seal" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonGlowBrush}" TargetName="Seal" />
                            <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" TargetName="MenuMark" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SealBloom" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SealBloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                            <Setter Property="BorderThickness" Value="0,0,1,0" TargetName="EdgeRule" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,132,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SealOrnament" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Margin" Value="0,6,0,0" TargetName="Seal" />
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="SealBloom" />
                            <Setter Property="Margin" Value="0,14,0,0" TargetName="MenuMark" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SealOrnament" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Margin" Value="0,6,0,0" TargetName="Seal" />
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="SealBloom" />
                            <Setter Property="Margin" Value="0,14,0,0" TargetName="MenuMark" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
