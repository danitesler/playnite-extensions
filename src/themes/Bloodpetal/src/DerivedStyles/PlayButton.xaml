<!--
    Bloodpetal: Play, the source's great red button. An iron socket (black, pewter line, a stud on each corner) holding a
    blood plate lit from its centre, gilt serif small capitals. Layers bottom to top: bloom, socket, plate, hover plate,
    pressed plate, ember seam, studs, label.
    Hover, animated both ways (no setters on animated parts, so nothing snaps):
      in  0.2s: the hotter plate and the bloom fade in; the ember seam lights along the plate's foot and crawls (one
          1024px tile in 14s) while the bloom breathes on its wrapper.
      out 0.35s: everything fades back; every exit animation has FillBehavior Stop, so no clock is left running.
    Press fades in its own dark plate, so leaving while pressed cannot strand the hover state.
    Sprites are white masks filled with theme brushes. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages (DataContext: Playnite's
        GameDetailsViewModel, IsRunning / IsLaunching). While the game runs Playnite swaps Play for the context action
        (RUNNING): a 0.12 tint, a 1px frame in the slab's square shape and a hairline between two gems along its top (the
        hover seam owns the foot). LAUNCHING: the hairline fills while the right gem flares and pings a ring (2s loop); the
        slab itself carries the glint. RUNNING: the hairline stays full, the gem idles and pings once per 3.4s.
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1" />
                        <!-- Hairline between two gems along the slab's top: the progress rail while launching. The right gem is the mark. -->
                        <Grid Margin="6,4" VerticalAlignment="Top" Height="5">
                            <Rectangle Height="1" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                            <Rectangle x:Name="RunningFill" Height="1" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Path Width="5" Height="5" Stretch="Fill" HorizontalAlignment="Left" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.9" Data="M4,0 L8,4 L4,8 L0,4 Z" />
                            <Grid Width="5" Height="5" HorizontalAlignment="Right">
                                <Path x:Name="RunningRing" Width="5" Height="5" Stretch="Fill" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5" Data="M4,0 L8,4 L4,8 L0,4 Z">
                                    <Path.RenderTransform><ScaleTransform x:Name="RunningRingScale" ScaleX="1" ScaleY="1" /></Path.RenderTransform>
                                </Path>
                                <Path x:Name="RunningGem" Width="5" Height="5" Stretch="Fill" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" RenderTransformOrigin="0.5,0.5" Data="M4,0 L8,4 L4,8 L0,4 Z">
                                    <Path.RenderTransform><ScaleTransform x:Name="RunningGemScale" ScaleX="1" ScaleY="1" /></Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.7,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGemScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.38" Value="1.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGemScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.38" Value="1.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRing" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0.9" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0" KeySpline="0.3,0 0.7,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRingScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="3.2" KeySpline="0.2,0.6 0.4,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRingScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="3.2" KeySpline="0.2,0.6 0.4,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGem" Storyboard.TargetProperty="Opacity" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.65" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGemScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.14" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningGemScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.14" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRing" Storyboard.TargetProperty="Opacity" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="0.75" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0" KeySpline="0.3,0 0.7,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRingScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="2.8" KeySpline="0.2,0.6 0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="2.8" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningRingScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="2.8" KeySpline="0.2,0.6 0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="2.8" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <!-- The foot line completes once (the sweep has landed) and stays full. -->
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="26,0,26,1" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Typography.Capitals" Value="SmallCaps" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid x:Name="BloomWrap" Margin="-24,-20" IsHitTestVisible="False">
                            <Control x:Name="Bloom" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0.16" Focusable="False" />
                        </Grid>
                        <Border Background="{DynamicResource BevelShadowBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1" SnapsToDevicePixels="True" />
                        <Control Margin="3" Template="{DynamicResource SelectionBarTemplate}" Foreground="{TemplateBinding Background}"
                                 BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" Focusable="False" x:Name="PlayFill" />
                        <!-- RunningPlate: while launching or running a clean plate in the running colour covers the blood plate's lit centre. -->
                        <Border x:Name="RunningPlate" Margin="4" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" IsHitTestVisible="False" />
                        <!-- Running and launching only, in the plate's shape and under the label. RunningBreath: a ScrimBrush layer over the solid running-colour plate (launching holds 0.2, running breathes 0.06 to 0.2) so the dark label keeps its contrast. RunningScan: the glint, launching only. -->
                        <Border x:Name="RunningBreath" Margin="4" Background="{DynamicResource ScrimBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="RunningScan" Margin="4" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.65" IsHitTestVisible="False">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.1">
                                    <GradientStop x:Name="RunningScanA" Color="#00000000" Offset="-0.4" />
                                    <GradientStop x:Name="RunningScanB" Color="#FF000000" Offset="-0.26" />
                                    <GradientStop x:Name="RunningScanC" Color="#FF000000" Offset="-0.13999999999999999" />
                                    <GradientStop x:Name="RunningScanD" Color="#00000000" Offset="0" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Control x:Name="HoverPlate" Margin="3" Template="{DynamicResource SelectionBarTemplate}" Foreground="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                 BorderBrush="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0" Focusable="False" />
                        <Border x:Name="PressedPlate" Margin="3" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0" IsHitTestVisible="False" />
                        <!-- RunningHoverDim: the Cancel state, a second scrim faded in only while a RUNNING button is hovered. Below the label. -->
                        <Border x:Name="RunningHoverDim" Margin="3" Background="{DynamicResource ScrimBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Grid x:Name="SeamHost" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <Grid x:Name="SeamBand" Height="16" VerticalAlignment="Bottom" Margin="5,0,5,-3" ClipToBounds="True" IsHitTestVisible="False" Opacity="0" Visibility="Hidden">
                                <Canvas>
                                    <Grid Width="3072" Height="16">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="SeamShift" X="0" />
                                        </Grid.RenderTransform>
                                        <Rectangle Fill="{DynamicResource TopPanelRuleStartBrush}">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/seam.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,1024,16" ViewportUnits="Absolute" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <Rectangle Fill="{DynamicResource TopPanelRuleEndBrush}">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/seam-core.png'}" TileMode="Tile" Stretch="None" Viewport="0,0,1024,16" ViewportUnits="Absolute" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Grid>
                                </Canvas>
                            </Grid>
                        </Grid>
                        <Control Template="{DynamicResource RivetsTemplate}" Foreground="{DynamicResource FrameBrush}" Margin="-1" Focusable="False" />
                        <ContentPresenter x:Name="PlayContent" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource TextBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="BloomWrap" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SeamHost" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.1" To="0.2" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanA" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1" KeySpline="0.7,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanB" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.26" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1.14" KeySpline="0.7,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.14" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanC" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.14" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1.26" KeySpline="0.7,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.26" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanD" Storyboard.TargetProperty="Offset" Duration="0:0:2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="1.4" KeySpline="0.7,0 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="BloomWrap" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="SeamHost" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningPlate" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.06" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="0.2" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING button is under the pointer. The binding is Self (this button); TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SeamBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SeamBand" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SeamShift" Storyboard.TargetProperty="X" From="0" To="-1024" Duration="0:0:14" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.2">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BloomWrap" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.62" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Bloom" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BloomWrap" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SeamBand" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="SeamShift" Storyboard.TargetProperty="X" By="-12" Duration="0:0:0.35" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="SeamBand" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.35" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Launching and running keep Play's plate, filled with the running colour; the label is the dark ink (the plate is light), Cancel (a light label on the darker plate) is set in the template. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
