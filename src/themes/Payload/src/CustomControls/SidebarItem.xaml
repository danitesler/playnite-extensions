<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml. A tab of the Overwatch 2 navigation as a 44 x 40 rail
    item: a 16px glyph in the menus' blue-grey (SidebarItemForegroundBrush) at rest, white under the pointer on a faint
    slanted plate (ListItemHoverBrush), and, when current, the game's selected-tab look: a cyan parallelogram plate
    (SelectedBrush, 1defef) slanted 15 degrees with the glyph in black (SidebarItemSelectedForegroundBrush) and a short orange
    tick under it (PrimaryButtonBackgroundBrush). Library and Statistics use the Material Symbols glyphs of Media.xaml.
    PART_ProgressStatus (Playnite shows it while an add-on reports progress) is a 2px orange bar along the tile's bottom
    edge. An item with no content is a bare marker: WarningBrush fill.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="Plate" Width="32" Height="30" Background="{TemplateBinding Background}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-15" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="Tick" Width="10" Height="2" Margin="0,0,0,2" Visibility="Collapsed"
                                Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        <Border Padding="14,12">
                            <Border Padding="0"> <!-- not IconPadding: the 14,12 plate already sizes the glyph to 16px; adding IconPadding (8) leaves 0px and hides the icon -->
                                <Viewbox x:Name="ItemIcon">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Viewbox>
                            </Border>
                        </Border>
                        <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                        IsHitTestVisible="False" Width="16" Height="16"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ContentTemplate="{DynamicResource IconTemplate}" />
                        <ProgressBar x:Name="PART_ProgressStatus" Height="2" Margin="8,0,8,1"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource GlyphBrush}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="Tick" />
                        </DataTrigger>
                        <!-- An item with no content fills its whole cell, upright. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="{x:Null}" />
                                <Condition Property="ContentTemplate" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Width" Value="44" TargetName="Plate" />
                            <Setter Property="Height" Value="40" TargetName="Plate" />
                            <Setter Property="RenderTransform" Value="{x:Null}" TargetName="Plate" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource ListItemHoverBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
