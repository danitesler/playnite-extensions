<!--
    Overlay on Playnite Default/DefaultControls/ListView.xaml (the row only; the list, its column headers and the header
    scroll viewer are Playnite's). Library list view rows: Default's hover and selected fills, plus the running game
    indicator drawn above both fills and below the cells.
    Selected rows take the career list's cyan wash (ListItemSelectedBrush) with light text, as DetailsViewItemStyle.
    Payload: the running game's row pushes the payload, three lemon chevrons on the far edge lighting in turn (same as
    DetailsViewItemStyle).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,1,0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Grid>
                        <Rectangle x:Name="HoverRectangle" Visibility="Collapsed" Fill="{DynamicResource HoverBrush}" />
                        <Rectangle x:Name="SelectedRectangle" Visibility="Collapsed" Fill="{DynamicResource ListItemSelectedBrush}" />
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.16" />
                            <Grid ClipToBounds="True" IsHitTestVisible="False">
                                <Border x:Name="RunningScan" Visibility="Collapsed" Margin="-8,0" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.4"  RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <SkewTransform AngleX="-15" />
                                    </Border.RenderTransform>
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScan0" Color="#00000000" Offset="-0.22" />
                                            <GradientStop x:Name="RunningScan1" Color="#FF000000" Offset="-0.218" />
                                            <GradientStop x:Name="RunningScan2" Color="#FF000000" Offset="-0.15" />
                                            <GradientStop x:Name="RunningScan3" Color="#00000000" Offset="-0.148" />
                                            <GradientStop x:Name="RunningScan4" Color="#FF000000" Offset="-0.098" />
                                            <GradientStop x:Name="RunningScan5" Color="#FF000000" Offset="-0.02" />
                                            <GradientStop x:Name="RunningScan6" Color="#00000000" Offset="-0.018" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2">
                                <Border BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1" Opacity="0.7" />
                            </Border>
                            <Grid Height="3" Margin="8,0,46,4" VerticalAlignment="Bottom">
                                <Line X1="0" X2="1" Stretch="Fill" VerticalAlignment="Center" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" StrokeDashArray="3 2" Opacity="0.3" />
                                <Line x:Name="RunningFill" X1="0" X2="1" Stretch="Fill" VerticalAlignment="Center" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" StrokeDashArray="3 2">
                                    <Line.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningFillHead" Color="#FF000000" Offset="1" />
                                            <GradientStop x:Name="RunningFillEdge" Color="#00000000" Offset="1.002" />
                                        </LinearGradientBrush>
                                    </Line.OpacityMask>
                                </Line>
                            </Grid>
                            <StackPanel Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                <Path x:Name="RunningChevron1" Data="M1,1 L5,5 L1,9" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" Opacity="0.3" />
                                <Path x:Name="RunningChevron2" Data="M1,1 L5,5 L1,9" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" Opacity="0.3" Margin="1,0,0,0" />
                                <Path x:Name="RunningChevron3" Data="M1,1 L5,5 L1,9" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" Opacity="0.3" Margin="1,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <GridViewRowPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Stretch" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Selector.IsSelected" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedRectangle" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="HoverRectangle" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScan0" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.22" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.0" KeySpline="0.1,0.8 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScan1" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.218" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.002" KeySpline="0.1,0.8 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.002" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScan2" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.07" KeySpline="0.1,0.8 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.07" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScan3" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.148" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.072" KeySpline="0.1,0.8 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.072" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScan4" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.098" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.122" KeySpline="0.1,0.8 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.122" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScan5" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.02" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.2" KeySpline="0.1,0.8 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScan6" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.018" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.202" KeySpline="0.1,0.8 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.202" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1" KeySpline="0.1,0.8 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.002" KeySpline="0.1,0.8 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.002" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="StrokeDashOffset" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="-15" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningChevron1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.7" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningChevron2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningChevron3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.4">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="StrokeDashOffset" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="-5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningChevron1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.72" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningChevron2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.02" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningChevron3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.32" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.3" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.3" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillHead" Storyboard.TargetProperty="Offset" From="0" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillEdge" Storyboard.TargetProperty="Offset" From="0.002" To="1.002" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Selector.IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
