<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is a career profile panel of the Overwatch 2 menus: medium blue (PopupBackgroundBrush)
    on a 1px hairline with 2px corners, its top edge lit like the section headings (a 2px band whose first 40px are a
    slanted orange tab, the rest the edge colour). LocalMenuPanelTemplate is shared by ComboBox.xaml,
    CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml. Rows start 6px below the top (nothing
    rises above the panel); rows, highlight and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False" ClipToBounds="True">
            <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" />
            <!-- Section-heading edge: a 2px band across the top, its first 40px a slanted orange tab -->
            <Border Height="2" Margin="1,1,1,0" VerticalAlignment="Top" Background="{DynamicResource NormalBorderBrush}" Opacity="0.6" />
            <Border Width="40" Height="3" Margin="10,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{DynamicResource MainMenuButtonBackgroundBrush}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <SkewTransform AngleX="-15" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,6,0,4" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="4,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
