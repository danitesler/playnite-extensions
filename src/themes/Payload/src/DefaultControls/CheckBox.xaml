<!--
    Overlay on Playnite Default/DefaultControls/CheckBox.xaml. The Overwatch 2 options box: an 18px square with 2px
    corners, a 2px CheckBoxBorderBrush edge (muted blue-grey a1aec5) around a dark blue well (CheckBoxCheckMarkBkBrush).
    Checked: filled with the selection cyan (GlyphBrush, 1defef) and a black tick (IconCheck, TextBrushDark), the way the
    game prints black on its cyan; indeterminate: a black bar on cyan. Hover: the edge and the label turn white
    (CheckBoxHoverBorderBrush, SelectedForegroundBrush). Label 8px after the box. Keyboard focus: FocusVisual.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Border x:Name="BulletBorder" DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{DynamicResource CheckBoxCheckMarkBkBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Grid>
                                    <ContentPresenter x:Name="CheckIcon" Visibility="Collapsed" Width="14" Height="14"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="{DynamicResource TextBrushDark}"
                                                      Content="{DynamicResource IconCheck}"
                                                      ContentTemplate="{DynamicResource IconTemplate}" />
                                    <Border x:Name="IndeterminateIcon" Visibility="Collapsed" Width="8" Height="3"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{DynamicResource TextBrushDark}" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="Label" DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="8,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="BulletBorder" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="Label" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="CheckIcon" />
                            <Setter Property="Background" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="IndeterminateIcon" />
                            <Setter Property="Background" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="BulletBorder" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
