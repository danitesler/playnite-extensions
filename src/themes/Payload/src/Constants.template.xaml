<!--
    Payload: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    The Overwatch 2 menus, dark side: Blizzard's neutral dark blue for the page (0e1425), the medium blue for panels
    (1d253a), the career profile's tab bar navy for the rail and top bar (191d2f) and its stat tile grey-blue for cards
    (323a4b); off-white text (e5ebf4) over a blue-grey secondary (a1aec5). Selection is the game's cyan fill with black
    text (1defef), the call to action the OW2 orange (ed6516, hovered ff7926), the team colors carry status (ally
    00accf, enemy d91547). Corners 2px, accents slanted 15 degrees.
    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). Placeholder syntax: see reference.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): body 14, section titles 24, page titles 40 in the display face. -->
    <sys:Double x:Key="FontSizeSmall">{{px:ow-text-sm}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:ow-text-md}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:ow-text-lg}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:ow-text-xl}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:ow-text-2xl}}</sys:Double>
    <!-- Config (the OW2 menu face) and BigNoodleTooOblique (the display face) are not bundled; Windows' Bahnschrift
         (a condensed DIN) stands in for both, slanted by the hosts for the display role. -->
    <FontFamily x:Key="FontFamily">Config, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">BigNoodleTooOblique, Big Noodle Too Oblique, BigNoodleToo, Bahnschrift SemiBold Condensed, Bahnschrift, Impact</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys) and the radius scale: near-square plates; CornerRadiusFull only for 1:1 marks. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:ow-radius-md}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:ow-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:ow-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:ow-radius-xl}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="FrameThickness">{{px:ow-outline}}</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{ow-text}}</Color>
    <Color x:Key="TextColorDarker">{{ow-text-muted}}</Color>
    <Color x:Key="TextColorDark">{{ow-on-accent}}</Color>
    <Color x:Key="MainColor">{{ow-item}}</Color>
    <Color x:Key="MainColorDark">{{ow-color-neutral-medium-blue}}</Color>
    <Color x:Key="HoverColor">{{ow-hover}}</Color>
    <Color x:Key="GlyphColor">{{ow-cyan}}</Color>
    <Color x:Key="HighlightGlyphColor">{{ow-cyan/40}}</Color>
    <Color x:Key="PopupBackgroundColor">{{ow-color-neutral-medium-blue}}</Color>
    <Color x:Key="PopupBorderColor">{{ow-edge}}</Color>
    <Color x:Key="BackgroundToneColor">{{ow-tab-bar}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{ow-edge}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{ow-edge}}</Color>
    <Color x:Key="DataChangeNotifColor">{{ow-color-yellow-100}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{ow-color-neutral-light-blue}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{ow-color-neutral-dark-blue}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{ow-item}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{ow-color-neutral-dark-blue}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <!-- Scores in the team colors: ally blue good, the NEW! yellow mixed, enemy red bad -->
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{ow-ally}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{ow-enemy}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{ow-color-yellow-100}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{ow-color-yellow-100}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{ow-tile}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{ow-color-neutral-dark-blue}}" />

    <!-- Shell: the profile tab bar navy for the rail, the medium blue for the top bar (translucent over art), the dark
         blue for the library layer -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{ow-tab-bar}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{ow-color-neutral-dark-blue}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{ow-tab-bar/70}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{ow-color-neutral-dark-blue}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{ow-hover}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{ow-edge}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{ow-color-orange-150}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{ow-color-neutral-off-white}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{ow-text-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{ow-on-accent}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{ow-cyan}}" />
    <!-- Art behind the library and the banner: the site's navy video wash, then the page blue as a scrim -->
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{ow-color-neutral-navy}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{ow-color-neutral-dark-blue}}" />

    <!-- States: the selected tab's cyan fill with black text; lists use a cyan wash with a cyan edge -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{ow-cyan}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{ow-color-neutral-off-white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{ow-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{ow-cyan-wash}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{ow-band}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{ow-cyan}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{ow-enemy}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{ow-color-neutral-off-white}}" />

    <!-- Buttons: the unselected item plate with off-white type, the profile band on hover; Play is the OW2 orange -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{ow-color-neutral-off-white}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{ow-header}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{ow-tile}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{ow-text-muted}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{ow-color-orange-150}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{ow-color-orange-100}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{ow2-color-primary-orange-150}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{ow-cyan}}" />

    <!-- Inputs: a dark blue well with a light blue edge; cyan when focused -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{ow-color-neutral-dark-blue}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{ow-tab-bar}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{ow-color-neutral-light-blue}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{ow-text-muted}}" />
    <SolidColorBrush x:Key="InputUnderlineBrush" Color="{{ow-color-neutral-light-blue}}" />
    <SolidColorBrush x:Key="InputHoverUnderlineBrush" Color="{{ow-text-muted}}" />

    <!-- Controls: the Battle Pass bar (orange on a thin rail), cyan checks, blue-grey thumbs -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{ow-text-muted}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{ow-color-neutral-off-white}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{ow-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{ow-plate}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{ow-cyan}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{ow-color-orange-100}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{ow-color-orange-150}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{ow-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{ow-band}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{ow-text-muted}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{ow-band}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{ow-text-muted}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{ow-cyan}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{ow-color-neutral-off-white}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{ow-glow}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{ow-tile}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{ow-color-neutral-off-white}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{ow-header}}" />

    <!-- Popups: medium blue panels with a hairline; tooltips in the site's tooltip blue -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{ow-edge}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{ow-color-neutral-off-white}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{ow-edge}}" />

    <!-- Section headings: white display type (the gallery's "HERO GALLERY", role headers) -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{ow-color-neutral-off-white}}" />
</ResourceDictionary>
