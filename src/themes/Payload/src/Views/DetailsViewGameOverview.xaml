</Grid>
</Grid>
                            </Grid>
                        <!-- Empty state (no game selected): the tile mark's slanted plate in outline with its forward chevrons lighting one after the other (a payload
                                     pushing ahead), and Playnite's "No game selected" in the oblique display face. The three chevrons pulse 0.25s apart on a 1.5s loop,
                                     only while this shows (RemoveStoryboard on exit). Centered in the visible area. -->
                            <Grid VerticalAlignment="Top" Height="{Binding ViewportHeight, ElementName=PART_ScrollViewHost}">
                                <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                                    <Viewbox Width="104" Height="104" HorizontalAlignment="Center">
                                        <Canvas Width="100" Height="100">
                                            <Path Data="M 24 18 L 96 18 L 76 82 L 4 82 Z" Stroke="{DynamicResource TextBrushDarker}" StrokeThickness="3" StrokeLineJoin="Round" />
                                            <Path Data="M 24 31 L 39 31 L 54 50 L 39 69 L 24 69 L 39 50 Z" Fill="{DynamicResource FocusBrush}" Opacity="0.2">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="ChevronA">
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" BeginTime="0:0:0" Duration="0:0:1.5">
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="0.2" />
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.2" />
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="ChevronA" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <Path Data="M 46 31 L 61 31 L 76 50 L 61 69 L 46 69 L 61 50 Z" Fill="{DynamicResource FocusBrush}" Opacity="0.2">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="ChevronB">
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.25" Duration="0:0:1.5">
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="0.2" />
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.2" />
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="ChevronB" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <Path Data="M 68 31 L 83 31 L 98 50 L 83 69 L 68 69 L 83 50 Z" Fill="{DynamicResource FocusBrush}" Opacity="0.2">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="ChevronC">
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.5" Duration="0:0:1.5">
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="0.2" />
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.2" />
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <RemoveStoryboard BeginStoryboardName="ChevronC" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,18,0,0"
                                               FontFamily="{DynamicResource HeadingFontFamily}" FontStyle="Oblique" FontSize="{DynamicResource FontSizeLarge}"
                                               Foreground="{DynamicResource TextBrushDarker}" />
                                </StackPanel>
                            </Grid>
