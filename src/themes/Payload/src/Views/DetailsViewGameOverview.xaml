    <TextBlock Style="{DynamicResource HeadingTextBlock}" Text="{DynamicResource LOCGameDescriptionTitle}" />
    <Grid Height="2" Margin="0,6,0,0"><Border Background="{DynamicResource WindowPanelSeparatorBrush}" /><Border Width="40" HorizontalAlignment="Left" Background="{DynamicResource PrimaryButtonBackgroundBrush}" /></Grid>
</StackPanel>
                                                <HtmlTextView x:Name="PART_HtmlDescription"
