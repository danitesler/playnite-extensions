<!--
    Payload: dialog windows (Settings, game editor, add-ons). Overlay on Playnite Default/DerivedStyles/StandardWindowStyle.xaml.
    The profile tab bar turned into a 40px band on the tab-bar navy: the rail's orange slanted plate (15 degrees) leads into
    the title in the oblique display face, and three slanted stripes (cyan, orange, cyan, fading) are ghosted into the right
    end like the VS-screen plates. A 1px edge closes the band with a short cyan segment lit under the title. Caption buttons
    are the 44x40 WindowBarButton icons, so the caption and the content offset are 40 (Default: 25). PART_TextTitle and the
    three PART_Button* names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid Height="40" VerticalAlignment="Top" Background="{DynamicResource ShellBackgroundBrush}" ClipToBounds="True">
                                    <!-- Slanted stripes ghosted into the right end, in a Canvas so they add no desired width. -->
                                    <Canvas IsHitTestVisible="False">
                                        <Polygon Canvas.Right="198" Canvas.Top="0" Points="10.7,0 22.7,0 12,40 0,40" Fill="{DynamicResource SelectedBrush}" Opacity="0.16" />
                                        <Polygon Canvas.Right="178" Canvas.Top="0" Points="10.7,0 16.7,0 6,40 0,40" Fill="{DynamicResource PrimaryButtonBackgroundBrush}" Opacity="0.55" />
                                        <Polygon Canvas.Right="164" Canvas.Top="0" Points="10.7,0 18.7,0 8,40 0,40" Fill="{DynamicResource SelectedBrush}" Opacity="0.28" />
                                    </Canvas>
                                    <Rectangle Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{DynamicResource WindowPanelSeparatorBrush}" />
                                    <Rectangle Height="2" Width="120" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0" IsHitTestVisible="False"
                                               Fill="{DynamicResource SelectedBrush}" />
                                    <DockPanel LastChildFill="False">
                                        <!-- The rail's orange slanted plate, then the title. -->
                                        <Border DockPanel.Dock="Left" Width="30" Height="24" Margin="18,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                Background="{DynamicResource PrimaryButtonBackgroundBrush}" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <SkewTransform AngleX="-15" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <TextBlock Text="{TemplateBinding Title}" DockPanel.Dock="Left" Margin="16,0,0,2" VerticalAlignment="Center" MaxWidth="420"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLarger}"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,2,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,40,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <!-- Playnite gives the Settings window no Title; without this the band shows no name. -->
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
