<!--
    Overlay on Playnite Default/Common.xaml. Spacing and focus of the Overwatch 2 menus, measured on 1080p captures of
    the career profile and hero gallery and scaled by 2/3 for a desktop window: tab and list rows about 48px tall in
    game (32 here), buttons about 54px (36), 12px gutters between stat tiles (8), 2px corners. Playnite lays most
    controls out by padding, so each key turns those heights into padding around 14px text (about 19px tall).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: a medium blue panel with a 1px hairline and 2px corners (WPF popups are layered
             windows: no glow) -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
    </Style>

    <!-- Keyboard focus: the selection cyan as a 2px frame set 3px outside the control (FocusBrush). Keyboard only. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" SnapsToDevicePixels="True" CornerRadius="{DynamicResource CornerRadiusLarge}"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: the menu button, 36 tall (54 at 1080p), 18 inline -->
    <Thickness x:Key="ButtonPadding">18,8</Thickness>
    <!-- Text box, password box, dropdown: the profile's filter dropdowns, 34 tall -->
    <Thickness x:Key="InputPadding">10,7</Thickness>
    <!-- Menu: a medium blue panel, 4px around rows 30 tall -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">10,5,16,5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,5,16,5</Thickness>
    <!-- List box row: the profile sidebar list, 32 tall -->
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <!-- Group box: a stat tile section: a header strip, then the body -->
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">12,6</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">20</sys:Double>
    <!-- Tooltip: the site's tooltip, 10 / 6 -->
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Glyphs at 18px -->
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">360</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">320</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">270</sys:Double>
</ResourceDictionary>
