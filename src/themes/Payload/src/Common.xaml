<!--
    Overlay on Playnite Default/Common.xaml. Spacing and focus of the Overwatch 2 menus, measured on 1080p captures of
    the career profile and hero gallery and scaled by 2/3 for a desktop window: tab and list rows about 48px tall in
    game (32 here), buttons about 54px (36), 12px gutters between stat tiles (8), 2px corners. Playnite lays most
    controls out by padding, so each key turns those heights into padding around 14px text (about 19px tall).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: a medium blue panel with a 1px hairline and 2px corners (WPF popups are layered
             windows: no glow) -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}" />
    </Style>

    <!-- Keyboard focus: the selection cyan as a 2px frame set 3px outside the control (FocusBrush). Keyboard only. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" SnapsToDevicePixels="True" CornerRadius="{DynamicResource CornerRadiusLarge}"
                            BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: the menu button, 36 tall (54 at 1080p), 18 inline -->
    <Thickness x:Key="ButtonPadding">18,5</Thickness>
    <!-- Text box, password box, dropdown: the profile's filter dropdowns, 34 tall -->
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <!-- Menu: a medium blue panel, 4px around rows 30 tall -->
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">10,5,16,5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,5,16,5</Thickness>
    <!-- List box row: the profile sidebar list, 32 tall -->
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <!-- Group box: a stat tile section: a header strip, then the body -->
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">12,6</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">20</sys:Double>
    <!-- Tooltip: the site's tooltip, 10 / 6 -->
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Glyphs at 18px -->
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">18</sys:Double>

    <sys:Double x:Key="GameBannerHeight">360</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- menu-mark begin LocalPayloadMenuMarkTemplate -->
    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a payload cart on its track, counter-skewed upright inside the slanted plate. Hover (IsMouseOver): the cart bumps 3px forward (BackEase 0.22s). Open (ContextMenu.IsOpen of the nearest Border): the progress bar on the track fills from the left in 1.5s and holds for 0.5s, again and again, until the menu closes; the exit restores every property. -->
    <ControlTemplate x:Key="LocalPayloadMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="26" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Canvas x:Name="Cart" Width="26" Height="18">
                    <Canvas.RenderTransform><TranslateTransform x:Name="CartT" X="0" Y="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="13" Height="7" RadiusX="1" RadiusY="1" Fill="{TemplateBinding Foreground}" />
                    <Rectangle Canvas.Left="17" Canvas.Top="5" Width="5" Height="5" RadiusX="1" RadiusY="1" Fill="{TemplateBinding Foreground}" />
                    <Ellipse Canvas.Left="5" Canvas.Top="10" Width="4" Height="4" Fill="{TemplateBinding Foreground}" />
                    <Ellipse Canvas.Left="13" Canvas.Top="10" Width="4" Height="4" Fill="{TemplateBinding Foreground}" />
                    <Ellipse Canvas.Left="17.5" Canvas.Top="10" Width="4" Height="4" Fill="{TemplateBinding Foreground}" />
                </Canvas>
                <Rectangle Canvas.Left="0" Canvas.Top="14.2" Width="26" Height="1.3" Fill="{TemplateBinding Foreground}" Opacity="0.4" />
                <Rectangle x:Name="Prog" Canvas.Left="0" Canvas.Top="14.2" Width="26" Height="1.3" RenderTransformOrigin="0,0.5" Fill="{TemplateBinding Foreground}">
                    <Rectangle.RenderTransform><ScaleTransform x:Name="ProgS" ScaleX="0" ScaleY="1" /></Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CartT" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.220"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CartT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.176" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ProgS" Storyboard.TargetProperty="ScaleX" RepeatBehavior="Forever"><LinearDoubleKeyFrame KeyTime="0:0:0.000" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:1.500" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><LinearDoubleKeyFrame KeyTime="0:0:2.000" Value="1" /></DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ProgS" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.150" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- menu-mark end LocalPayloadMenuMarkTemplate -->
</ResourceDictionary>
