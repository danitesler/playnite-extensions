{
    "_comment": "Material Symbols Sharp 0.27.0, weight 700 (Apache-2.0). Preserve the original negative Y origin for IconTemplate. PNG colors reference src/tokens.css.",
    "jobs": [
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/@material-symbols/svg-700@{ref}/sharp/{name}.svg",
            "ref": "0.27.0",
            "format": "Geometry",
            "keyPrefix": "Icon",
            "xamlOut": "src/Media.xaml",
            "updateXaml": true,
            "preserveViewBox": true,
            "icons": [
                "search-fill=Search",
                "close-fill=Clear",
                "tune-fill=ViewSettings",
                "bookmark-fill=FilterPresets",
                "stacks-fill=Group",
                "swap_vert-fill=Sort",
                "view_list-fill=DetailsView",
                "grid_view-fill=GridView",
                "view_agenda-fill=ListView",
                "downloading-fill=Update",
                "account_tree-fill=Explorer",
                "casino-fill=Random",
                "shuffle-fill=ViewRandom",
                "filter_alt-fill=Filter",
                "notifications-fill=Notifications",
                "menu-fill=MainMenu",
                "sports_esports-fill=Library",
                "leaderboard-fill=Statistics",
                "remove-fill=WindowMinimize",
                "crop_square-fill=WindowMaximize",
                "filter_none-fill=WindowRestore",
                "close-fill=WindowClose",
                "arrow_drop_down-fill=DropDown",
                "arrow_right-fill=Submenu",
                "check-fill=Check",
                "add-fill=Add",
                "edit-fill=Edit",
                "delete-fill=Remove",
                "more_horiz-fill=Options",
                "play_arrow-fill=Play",
                "info-fill=Info",
                "download-fill=Download"
            ]
        },
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/@material-symbols/svg-700@{ref}/sharp/{name}.svg",
            "ref": "0.27.0",
            "format": "Png",
            "outDir": "src/Images/Symbols",
            "size": 48,
            "colorToken": "ow-text",
            "icons": [
                "fullscreen-fill=fullscreen",
                "add-fill=add",
                "sync-fill=sync",
                "info-fill=info",
                "settings-fill=settings",
                "extension-fill=extension",
                "play_arrow-fill=play_arrow",
                "download-fill=download",
                "link-fill=link",
                "folder_open-fill=folder_open",
                "hard_drive-fill=hard_drive",
                "desktop_windows-fill=desktop_windows",
                "star=star-outline",
                "visibility_off-fill=visibility_off",
                "visibility-fill=visibility",
                "hdr_on-fill=hdr_on",
                "edit-fill=edit",
                "casino-fill=casino",
                "menu_book-fill=menu_book",
                "archive-fill=archive",
                "history-fill=history"
            ]
        },
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/@material-symbols/svg-700@{ref}/sharp/{name}.svg",
            "ref": "0.27.0",
            "format": "Png",
            "outDir": "src/Images/Symbols",
            "size": 48,
            "colorToken": "ow-enemy",
            "icons": [
                "logout-fill=logout-red",
                "delete-fill=delete-red"
            ]
        },
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/@material-symbols/svg-700@{ref}/sharp/{name}.svg",
            "ref": "0.27.0",
            "format": "Png",
            "outDir": "src/Images/Symbols",
            "size": 48,
            "colorToken": "ow-color-orange-150",
            "icons": [
                "star-fill=star-orange"
            ]
        }
    ]
}
