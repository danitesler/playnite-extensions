                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <Border x:Name="PART_ElemDevelopers" Margin="0,8">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
