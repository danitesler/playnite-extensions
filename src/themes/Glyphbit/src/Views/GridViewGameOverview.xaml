<!--
    Glyphbit: grid side panel. Generated by art/gen-overviews.mjs; edit the generator, not this file.
    Same skeleton, narrower: spacer x * 130 / 320 (52 with no banner, room for the close button), actions under the title,
    text left and the metadata frame right. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="GridViewGameOverview">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewGameOverview">
                    <Border BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <ScrollViewer CanContentScroll="False" x:Name="PART_ScrollViewHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                                <Grid x:Name="PageRoot" Background="{DynamicResource GameOverviewBackgroundBrush}" UseLayoutRounding="True">
                                    <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False" ClipToBounds="True">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Height" Value="{DynamicResource GameBannerHeight}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" />
                                        <Border Background="{DynamicResource ArtTintBrush}" Opacity="0.22" />
                                        <Canvas HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.3">
                                            <Path Data="{DynamicResource IconScanlines}" Fill="{DynamicResource ScrimBrush}" />
                                        </Canvas>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0.3" />
                                                    <GradientStop Color="{Binding Background.Color, ElementName=PageRoot}" Offset="0.96" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Canvas HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="40">
                                            <Path Data="{DynamicResource IconCrumbleEdge}" Fill="{Binding Background, ElementName=PageRoot}" />
                                        </Canvas>
                                    </Grid>
                                    <StackPanel Panel.ZIndex="2" Margin="22,0,22,24">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border MinHeight="14" x:Name="GridBannerSpacer">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 130 / 320'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                            <Setter Property="Height" Value="14" />
                                                        </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="14" />
</DataTrigger>
</Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Panel.ZIndex="2" Margin="0,8,0,20">
                                            <DockPanel Panel.ZIndex="2">
                                                <Button x:Name="InlineSidePanelCloseButton" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" Width="28" Height="28" Padding="0"
                                                    Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}" Command="{MainViewModel CloseGameSideBarCommand}"
                                                    Template="{Binding Template, ElementName=SidePanelCloseButton}"
                                                    Visibility="{Binding Tag, ElementName=SidePanelCloseButton, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Visible` : `Collapsed`'}">
                                                        <Button.RenderTransform>
                                                            <TranslateTransform Y="{Binding ContentVerticalOffset, ElementName=PART_ScrollViewHost}" />
                                                        </Button.RenderTransform>
                                                </Button>
                                                <Image x:Name="PART_ImageIcon" MaxWidth="32" MaxHeight="32" Margin="0,0,12,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                <TextBlock x:Name="PART_TextDisplayName" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSizeLargest}"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Grid Width="160" Height="40">
                                                    <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                    <Button x:Name="PART_ButtonContextAction" />
                                                </Grid>
                                                <Button x:Name="PART_ButtonMoreActions" Width="40" Height="40" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource LOCMoreAction}">
                                                    <ContentControl Focusable="False" Content="{DynamicResource IconOptions}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                                <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource LOCEditGame}">
                                                    <ContentControl Focusable="False" Content="{DynamicResource IconEdit}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid x:Name="GridOverviewBody">
<Grid.Tag>
    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 24 + 400">
        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Tag" ElementName="GridMetadataContent" />
    </MultiBinding>
</Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>


                                            <Grid x:Name="GridMainColumn" VerticalAlignment="Top">
<Grid.Style><Style TargetType="Grid">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
    </DataTrigger></Style.Triggers>
</Style></Grid.Style>
<Grid.MaxWidth>
    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="z == true ? x : Max(0, x - y - 24)">
        <Binding Path="ActualWidth" ElementName="GridOverviewBody" />
        <Binding Path="ActualWidth" ElementName="GridMetadataColumn" />
        <Binding Path="Tag" ElementName="GridOverviewBody" />
    </MultiBinding>
</Grid.MaxWidth>
<StackPanel>
                                                <Grid x:Name="SteamScreenshotsGameScope">
                                                    <!-- Plugin visibility is shared: a late Steam load must never reveal a different game's section. -->
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Game.Source.Name}" Value="Steam">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" Margin="0,0,0,18">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Game.PluginId}" Value="CB91DFC9-B977-43BF-8E70-55F46E410FAB" />
                                                                        <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=PluginUnavailable}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Border Tag="{Binding Game.Id, NotifyOnTargetUpdated=True}" Visibility="Collapsed" Height="150" Margin="0,0,0,18"
                                                            Background="{DynamicResource NormalBrush}" BorderBrush="{DynamicResource SlotBorderBrush}" BorderThickness="1">
                                                        <Border.Triggers>
                                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Border.Triggers>
                                                        <Control Template="{DynamicResource CornerMarksTemplate}" Focusable="False" IsTabStop="False" Margin="24" Foreground="{DynamicResource SlotBorderBrush}" />
                                                    </Border>
                                                </Grid>
                                                </Grid>
                                                <StackPanel x:Name="PART_ElemDescription">
                                                    <Control Template="{DynamicResource PixelRampTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Width="96" Height="4" HorizontalAlignment="Left" Margin="0,0,0,12"
                                                             Background="{DynamicResource HeadingMarkerBrush}" Foreground="{DynamicResource GlyphBrush}" />
                                                    <HtmlTextView x:Name="PART_HtmlDescription" HtmlFontFamily="{DynamicResource FontFamily}" HtmlFontSize="{DynamicResource FontSize}"
                                                                  TextElement.Foreground="{DynamicResource TextBrushDarker}" Tag="{DynamicResource GlyphBrush}"
                                                                  HtmlForeground="{Binding Path=(TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                                  LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}" />
                                                </StackPanel>
                                                <StackPanel x:Name="PART_ElemNotes" Margin="0,24,0,0">
                                                    <Control Template="{DynamicResource PixelRampTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Width="96" Height="4" HorizontalAlignment="Left" Margin="0,0,0,12"
                                                             Background="{DynamicResource HeadingMarkerBrush}" Foreground="{DynamicResource GlyphBrush}" />
                                                    <TextBox x:Name="PART_TextNotes" IsReadOnly="True" TextWrapping="Wrap" Style="{DynamicResource BareTextBox}" Foreground="{DynamicResource TextBrushDarker}" />
                                                </StackPanel>
                                            </StackPanel>
</Grid>
                                            <Grid x:Name="GridMetadataColumn" VerticalAlignment="Top">
<Grid.Style><Style TargetType="Grid">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="Margin" Value="24,0,0,0" />
    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </DataTrigger></Style.Triggers>
</Style></Grid.Style>
<Grid VerticalAlignment="Top">
                                                <Border Background="{DynamicResource ExpanderBackgroundBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="2" Padding="14,12,14,14">
                                                    <StackPanel Tag="{DynamicResource GridDetailsPaneWidth}" x:Name="GridMetadataContent" HorizontalAlignment="Stretch">
<StackPanel.Style>
    <Style TargetType="StackPanel">
        <Setter Property="Width" Value="{DynamicResource GridDetailsPaneWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource GridDetailsPaneWidth}" /><Style.Triggers>
            <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /></DataTrigger>
        <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers>
    </Style>
</StackPanel.Style>
                                                        <Grid ClipToBounds="True" x:Name="GridMetadataViewport">
                                                            <WrapPanel x:Name="GridMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-33,0,-8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-33,-24,-8" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                                <Border x:Name="MetaProgress" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </MultiDataTrigger>
                                                                            <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <Border x:Name="PART_ElemCompletionStatus" Margin="0,8">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCCompletionStatus}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                                                <Button Grid.Column="2" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PropertyItemButton}" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemPlayTime" Margin="0,8">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCTimePlayed}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                                                <TextBlock Grid.Column="2" x:Name="PART_TextPlayTime" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemLastPlayed" Margin="0,8">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCLastPlayed}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                                                <TextBlock Grid.Column="2" x:Name="PART_TextLastActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border x:Name="PART_ElemRecentActivity" Margin="0,8">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="2*" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="3*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                                                <TextBlock Grid.Column="2" x:Name="PART_TextRecentActivity" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                                                            </Grid>
                                                                        </Border>
