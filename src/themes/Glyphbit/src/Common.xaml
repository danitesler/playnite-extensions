<!--
    Glyphbit: spacing, focus and the shared pixel shapes.
    ChamferTemplate is the one plate shape: two crossed rectangles per layer give a 2px stepped corner at any size,
    with no geometry and no desired size. PixelRampTemplate is the stepped gradient: Foreground in 12 hard bands over
    Background, opacity only, so ThemeModifier recolors it. Sizes: 32px fields, 16px glyphs (one art pixel = 2px).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <Thickness x:Key="ButtonPadding">14,5</Thickness>
    <Thickness x:Key="InputPadding">8,5</Thickness>
    <Thickness x:Key="MenuPadding">0,4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,2</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">16,14,16,16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">2,0,0,6</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>

    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>

    <ControlTemplate x:Key="ChamferTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True">
            <Rectangle Margin="2,0" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Margin="0,2" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Margin="2,1" Fill="{TemplateBinding Background}" />
            <Rectangle Margin="1,2" Fill="{TemplateBinding Background}" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="PixelRampTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}" />
            <UniformGrid Rows="1" Columns="12">
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.09" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.18" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.27" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.36" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.45" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.55" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.64" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.73" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.82" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.91" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="1" />
            </UniformGrid>
        </Grid>
    </ControlTemplate>

    <!-- The empty-slot brackets: four 8px L marks, 2px thick, in the host's Foreground. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True">
            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}" Data="F1M0,0h8v2h-6v6h-2z" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}" Data="F1M0,0h8v8h-2v-6h-6z" />
            <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Data="F1M0,0h2v6h6v2h-8z" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Data="F1M6,0h2v8h-8v-2h6z" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): a Drifter diamond cut from eight 3px pixels on a 4px pitch with a
         dim core pixel, 19x19 in a 22x22 cell. Rest: the mint diamond ring and a quiet core. Hover (IsMouseOver): the ring
         blows open by a pixel (the whole ring scales 1 to 1.28, BackEase, 0.2s) while the core ignites white; both reverse
         on exit. Open (the menu's ContextMenu.IsOpen on the nearest Border, which is PART_ElemMainMenu): the ring dims and a
         white head pixel with a magenta tail runs around it in hard one-pixel hops (0.11s a step, 0.88s a lap, no easing, like
         the game's pixel loaders) while the core burns magenta, until the menu closes. Hover animates the ring host's scale and
         the core's white layer; open animates the ring's opacity, the head, the tail and the core's magenta layer. -->
    <ControlTemplate x:Key="LocalGlyphbitMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Canvas Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas x:Name="RingHost" Width="19" Height="19" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform x:Name="RingScale" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                    <Path x:Name="Ring" Data="M8,0 h3 v3 h-3z M4,4 h3 v3 h-3z M12,4 h3 v3 h-3z M0,8 h3 v3 h-3z M16,8 h3 v3 h-3z M4,12 h3 v3 h-3z M12,12 h3 v3 h-3z M8,16 h3 v3 h-3z" Fill="{DynamicResource MainMenuButtonForegroundBrush}" />
                    <Rectangle x:Name="Tail" Canvas.Left="8" Canvas.Top="0" Width="3" Height="3" Fill="{DynamicResource GlyphBrush}" Opacity="0">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="TailMove" X="0" Y="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Head" Canvas.Left="8" Canvas.Top="0" Width="3" Height="3" Fill="{DynamicResource TextBrush}" Opacity="0">
                        <Rectangle.RenderTransform><TranslateTransform x:Name="HeadMove" X="0" Y="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
                <Rectangle Canvas.Left="8" Canvas.Top="8" Width="3" Height="3" Fill="{DynamicResource MainMenuButtonForegroundBrush}" Opacity="0.35" />
                <Rectangle x:Name="CoreHot" Canvas.Left="8" Canvas.Top="8" Width="3" Height="3" Fill="{DynamicResource TextBrush}" Opacity="0" />
                <Rectangle x:Name="CoreOpen" Canvas.Left="8" Canvas.Top="8" Width="3" Height="3" Fill="{DynamicResource GlyphBrush}" Opacity="0" />
            </Canvas>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" To="1.28" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" To="1.28" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CoreHot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CoreHot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="CoreOpen" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="Head" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                            <DoubleAnimation Storyboard.TargetName="Tail" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeadMove" Storyboard.TargetProperty="X" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.11" Value="4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="8" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.33" Value="4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.44" Value="0" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="-4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.66" Value="-8" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.77" Value="-4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.88" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeadMove" Storyboard.TargetProperty="Y" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.11" Value="4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="8" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.33" Value="12" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.44" Value="16" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="12" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.66" Value="8" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.77" Value="4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.88" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TailMove" Storyboard.TargetProperty="X" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.11" Value="0" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.33" Value="8" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.44" Value="4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.66" Value="-4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.77" Value="-8" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.88" Value="-4" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TailMove" Storyboard.TargetProperty="Y" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.11" Value="0" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.22" Value="4" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.33" Value="8" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.44" Value="12" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="16" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.66" Value="12" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.77" Value="8" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.88" Value="4" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CoreOpen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Head" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Tail" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HeadMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.01" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HeadMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.01" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="TailMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.01" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="TailMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.01" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
