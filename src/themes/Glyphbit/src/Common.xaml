<!--
    Glyphbit: spacing, focus and the shared pixel shapes.
    ChamferTemplate is the one plate shape: two crossed rectangles per layer give a 2px stepped corner at any size,
    with no geometry and no desired size. PixelRampTemplate is the stepped gradient: Foreground in 12 hard bands over
    Background, opacity only, so ThemeModifier recolors it. Sizes: 32px fields, 16px glyphs (one art pixel = 2px).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <Thickness x:Key="ButtonPadding">14,5</Thickness>
    <Thickness x:Key="InputPadding">8,5</Thickness>
    <Thickness x:Key="MenuPadding">0,4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,2</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">16,14,16,16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">2,0,0,6</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>

    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>

    <ControlTemplate x:Key="ChamferTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True">
            <Rectangle Margin="2,0" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Margin="0,2" Fill="{TemplateBinding BorderBrush}" />
            <Rectangle Margin="2,1" Fill="{TemplateBinding Background}" />
            <Rectangle Margin="1,2" Fill="{TemplateBinding Background}" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="PixelRampTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}" />
            <UniformGrid Rows="1" Columns="12">
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.09" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.18" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.27" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.36" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.45" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.55" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.64" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.73" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.82" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="0.91" />
                <Rectangle Fill="{TemplateBinding Foreground}" Opacity="1" />
            </UniformGrid>
        </Grid>
    </ControlTemplate>

    <!-- The empty-slot brackets: four 8px L marks, 2px thick, in the host's Foreground. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True">
            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}" Data="F1M0,0h8v2h-6v6h-2z" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}" Data="F1M0,0h8v8h-2v-6h-6z" />
            <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Data="F1M0,0h2v6h6v2h-8z" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}" Data="F1M6,0h2v8h-8v-2h6z" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>

    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
