<!--
    Glyphbit: Play. The mint health pip, its right end a stepped ramp into magenta. Hover is the dash: two magenta afterimages
    trail left of the plate, four pips charge across the ramp one by one and the plate brightens, all in hard frames 40 to
    60ms apart; the afterimages flicker while hovered. Pressed is its own darker plate. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages. While the game runs Playnite
        swaps Play for the context action (RUNNING); a cyan hairline frames the cell and four cyan pips sit at its foot,
        stepping up and down in hard frames (3s). Launching charges the pips one by one, as Play's hover pips charge.
        DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching).
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Control x:Name="RunningWash" Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource RunningIndicatorBrush}" BorderBrush="{DynamicResource RunningIndicatorBrush}" Opacity="0.22" Focusable="False" IsTabStop="False" />
                        <!-- RunningFrame: the plate's stepped chamfer (ChamferTemplate's 2px notch at each corner) as a 1px outline. -->
                        <Grid x:Name="RunningFrame" SnapsToDevicePixels="True">
                            <Border Margin="2,0" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="0,1,0,1" />
                            <Border Margin="0,2" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1,0,1,0" />
                            <Border Width="3" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="0,0,1,1" />
                            <Border Width="3" Height="3" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1,0,0,1" />
                            <Border Width="3" Height="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="0,1,1,0" />
                            <Border Width="3" Height="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1,1,0,0" />
                        </Grid>
                        <Grid Height="2" Margin="12,0,12,4" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Margin="0,0,3,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                            <Rectangle Grid.Column="1" Margin="0,0,3,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                            <Rectangle Grid.Column="2" Margin="0,0,3,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                            <Rectangle Grid.Column="3" Margin="0,0,0,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.35" />
                            <Rectangle x:Name="RunningPip1" Grid.Column="0" Margin="0,0,3,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0" />
                            <Rectangle x:Name="RunningPip2" Grid.Column="1" Margin="0,0,3,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0" />
                            <Rectangle x:Name="RunningPip3" Grid.Column="2" Margin="0,0,3,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0" />
                            <Rectangle x:Name="RunningPip4" Grid.Column="3" Margin="0,0,0,0" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0" />
                        </Grid>
                        <Grid Margin="0,0,16,0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="14" Height="14">
                            <Rectangle x:Name="RunningMark" Width="9" Height="9" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><RotateTransform x:Name="RunningMarkTurn" Angle="45" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="RunningCore" Width="3" Height="3" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningPip1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.14" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningPip2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.31" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.39" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningPip3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.48" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.56" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningPip4" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.68" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.76" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMarkTurn" Storyboard.TargetProperty="Angle" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="135" KeySpline="0.2,0.8 0.3,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="135" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningCore" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.25" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.07" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:2.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.7" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMarkTurn" Storyboard.TargetProperty="Angle" Duration="0:0:2.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="135" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Opacity" Duration="0:0:2.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.6" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningCore" Storyboard.TargetProperty="Opacity" Duration="0:0:2.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningPip1" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RunningPip2" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RunningPip3" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.2" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RunningPip4" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.3" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,0,56,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Grid" Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="GhostFar" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="-14,0,14,0" Opacity="0"
                                 Background="{DynamicResource PrimaryButtonGlowBrush}" BorderBrush="{DynamicResource PrimaryButtonGlowBrush}" />
                        <Control x:Name="GhostNear" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="-7,0,7,0" Opacity="0"
                                 Background="{DynamicResource PrimaryButtonGlowBrush}" BorderBrush="{DynamicResource PrimaryButtonGlowBrush}" />
                        <Control x:Name="PlayFill" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Background}" />
                        <!-- Running and launching only, in the plate's stepped shape and under the label. RunningBreath: a scrim over the solid running plate (launching 0.5, running 0.22 to 0.42 breathing). -->
                        <Control x:Name="RunningBreath" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Opacity="0"
                                 Background="{DynamicResource ScrimBrush}" BorderBrush="{DynamicResource ScrimBrush}" />
                        <!-- RunningScan (launching only): the dash, a hard lead bar and a fainter afterimage on a slant, on the plate's own chamfered shape. -->
                        <Control x:Name="RunningScan" Template="{DynamicResource ChamferTemplate}" Visibility="Collapsed" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Opacity="0.85"
                                 Background="{DynamicResource RunningIndicatorBrush}" BorderBrush="{DynamicResource RunningIndicatorBrush}">
                            <Control.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.2"><GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.19" /><GradientStop x:Name="RunningScanA1" Color="#B3000000" Offset="-0.188" /><GradientStop x:Name="RunningScanA2" Color="#B3000000" Offset="-0.14" /><GradientStop x:Name="RunningScanA3" Color="#00000000" Offset="-0.138" /><GradientStop x:Name="RunningScanA4" Color="#00000000" Offset="-0.07" /><GradientStop x:Name="RunningScanLead" Color="#FF000000" Offset="-0.068" /><GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" /><GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" /></LinearGradientBrush>
                            </Control.OpacityMask>
                        </Control>
                        <Control x:Name="HoverPlate" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Opacity="0"
                                 Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" BorderBrush="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                        <Control x:Name="PressedPlate" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Opacity="0"
                                 Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" BorderBrush="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        <Control x:Name="PlayRamp" Template="{DynamicResource PixelRampTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Width="60" HorizontalAlignment="Right" Margin="0,2"
                                 Background="{TemplateBinding Background}" Foreground="{DynamicResource PrimaryButtonGlowBrush}" />
                        <StackPanel x:Name="HoverPips" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False">
                            <Rectangle x:Name="Pip1" Width="5" Height="5" Margin="0,0,3,0" Fill="{DynamicResource TextBrush}" Opacity="0" />
                            <Rectangle x:Name="Pip2" Width="5" Height="5" Margin="0,0,3,0" Fill="{DynamicResource TextBrush}" Opacity="0" />
                            <Rectangle x:Name="Pip3" Width="5" Height="5" Margin="0,0,3,0" Fill="{DynamicResource TextBrush}" Opacity="0" />
                            <Rectangle x:Name="Pip4" Width="5" Height="5" Fill="{DynamicResource TextBrush}" Opacity="0" />
                        </StackPanel>
                        <!-- RunningHoverDim: the Cancel state. A second scrim faded in only while a RUNNING plate is hovered; below the label. -->
                        <Control x:Name="RunningHoverDim" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Opacity="0"
                                 Background="{DynamicResource ScrimBrush}" BorderBrush="{DynamicResource ScrimBrush}" />
                        <ContentPresenter x:Name="PlayContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="GhostFar" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="GhostNear" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPips" />
                            <Setter Property="Foreground" Value="{DynamicResource ScrimBrush}" TargetName="PlayRamp" />
                            <Setter Property="Opacity" Value="0.7" TargetName="PlayRamp" />
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningScan" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.2" To="0.36" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.19" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1.16" KeySpline="0.3,0.2 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.16" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanA1" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.188" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1.162" KeySpline="0.3,0.2 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.162" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanA2" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.14" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1.21" KeySpline="0.3,0.2 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.21" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanA3" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.138" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1.212" KeySpline="0.3,0.2 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.212" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanA4" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.07" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1.28" KeySpline="0.3,0.2 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.28" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanLead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.068" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1.282" KeySpline="0.3,0.2 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.282" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1.35" KeySpline="0.3,0.2 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1.352" KeySpline="0.3,0.2 0.35,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.352" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="GhostFar" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="GhostNear" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HoverPips" />
                            <Setter Property="Foreground" Value="{DynamicResource ScrimBrush}" TargetName="PlayRamp" />
                            <Setter Property="Opacity" Value="0.7" TargetName="PlayRamp" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:2.8">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="0.12" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.3" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING slab is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Collapsed" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.75" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip1" Storyboard.TargetProperty="Opacity">
