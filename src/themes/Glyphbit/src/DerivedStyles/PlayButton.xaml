<!--
    Glyphbit: Play. The mint health pip, its right end a stepped ramp into magenta. Hover is the dash: two magenta afterimages
    trail left of the plate, four pips charge across the ramp one by one and the plate brightens, all in hard frames 40 to
    60ms apart; the afterimages flicker while hovered. Pressed is its own darker plate. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,0,56,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Grid" Background="Transparent" SnapsToDevicePixels="True">
                        <Control x:Name="GhostFar" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="-14,0,14,0" Opacity="0"
                                 Background="{DynamicResource PrimaryButtonGlowBrush}" BorderBrush="{DynamicResource PrimaryButtonGlowBrush}" />
                        <Control x:Name="GhostNear" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Margin="-7,0,7,0" Opacity="0"
                                 Background="{DynamicResource PrimaryButtonGlowBrush}" BorderBrush="{DynamicResource PrimaryButtonGlowBrush}" />
                        <Control Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Background}" />
                        <Control x:Name="HoverPlate" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Opacity="0"
                                 Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" BorderBrush="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                        <Control x:Name="PressedPlate" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Opacity="0"
                                 Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}" BorderBrush="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        <Control Template="{DynamicResource PixelRampTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False" Width="60" HorizontalAlignment="Right" Margin="0,2"
                                 Background="{TemplateBinding Background}" Foreground="{DynamicResource PrimaryButtonGlowBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False">
                            <Rectangle x:Name="Pip1" Width="5" Height="5" Margin="0,0,3,0" Fill="{DynamicResource TextBrush}" Opacity="0" />
                            <Rectangle x:Name="Pip2" Width="5" Height="5" Margin="0,0,3,0" Fill="{DynamicResource TextBrush}" Opacity="0" />
                            <Rectangle x:Name="Pip3" Width="5" Height="5" Margin="0,0,3,0" Fill="{DynamicResource TextBrush}" Opacity="0" />
                            <Rectangle x:Name="Pip4" Width="5" Height="5" Fill="{DynamicResource TextBrush}" Opacity="0" />
                        </StackPanel>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="0.75" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip1" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip2" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip3" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip4" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostNear" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" Duration="0:0:0.6">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.75" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostFar" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" Duration="0:0:0.6">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.66" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.07" Value="0.33" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.14" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip4" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip3" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip2" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pip1" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostNear" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0.2" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.16" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhostFar" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
