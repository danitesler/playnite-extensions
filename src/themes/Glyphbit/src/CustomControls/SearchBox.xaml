<!-- Glyphbit: SearchBox. A chamfered plate holding a bare text box and the pixel search and clear glyphs. Keeps Playnite's three parts. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid x:Name="Root" Background="Transparent">
                        <Control x:Name="Plate" Template="{DynamicResource ChamferTemplate}" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                 Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" />
                        <ContentControl x:Name="Glyph" Focusable="False" ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False"
                                        Foreground="{DynamicResource GlyphBrush}" Panel.ZIndex="1" />
                            <Grid x:Name="PART_SeachIcon" IsHitTestVisible="False" />
                        <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Margin="33,0,28,0" />
                        <ContentControl x:Name="PART_ClearTextIcon" Focusable="False" ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,9,0"
                                        Foreground="{DynamicResource TextBrushDarker}">
                            <ContentControl.Template>
                                <ControlTemplate TargetType="ContentControl">
                                    <Border Background="Transparent">
                                        <ContentPresenter ContentSource="Content" />
                                    </Border>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="Root">
                            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" TargetName="Plate" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True" SourceName="PART_TextInpuText">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="Plate" />
                        </Trigger>

                        <!-- Keep the magnifier visible while Playnite hides its placeholder. -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="ShowImage" Value="False">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
