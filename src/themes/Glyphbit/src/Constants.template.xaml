<!--
    Glyphbit: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Keys are the shared vocabulary (scripts/data/theme-keys.json). Token names (gb-*) live in tokens.css.
    Role map: ../AGENTS.md -> Tokens. Theme XAML reads brushes only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">30</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:gb-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:gb-font-heading|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width; applied inside the pane's padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Shape: everything is square; corners are stepped pixels, drawn by ChamferTemplate. -->
    <Thickness x:Key="PopupBorderThickness">2</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:gb-radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Thickness x:Key="FrameThickness">2</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{gb-white}}</Color>
    <Color x:Key="TextColorDarker">{{gb-ash}}</Color>
    <Color x:Key="TextColorDark">{{gb-void}}</Color>
    <Color x:Key="MainColor">{{gb-slot}}</Color>
    <Color x:Key="MainColorDark">{{gb-ink}}</Color>
    <Color x:Key="HoverColor">{{gb-slate}}</Color>
    <Color x:Key="GlyphColor">{{gb-magenta}}</Color>
    <Color x:Key="HighlightGlyphColor">{{gb-magenta-deep}}</Color>
    <Color x:Key="PopupBackgroundColor">{{gb-ink}}</Color>
    <Color x:Key="PopupBorderColor">{{gb-magenta-deep}}</Color>
    <Color x:Key="BackgroundToneColor">{{gb-night}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{gb-slate}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{gb-edge}}</Color>
    <Color x:Key="DataChangeNotifColor">{{gb-amber}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{gb-edge}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{gb-void}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{gb-slot}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{gb-void}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <!-- Running game: the cyan of the ramp's middle, never the magenta selection bar or the mint of Play and focus -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{gb-cyan}}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{gb-mint}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{gb-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{gb-amber}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{gb-amber}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{gb-void}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{gb-void}}" />

    <!-- Shell -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{gb-void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{gb-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{gb-ink}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{gb-ink}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{gb-void}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{gb-violet}}" />
    <!-- Banner darkening color (ThemeModifier "Banner darkening" sets its opacity over the banner art): the theme's
         own ArtTint color, so a darker banner keeps the theme's cast. -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{gb-violet}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{gb-magenta}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{gb-mint}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{gb-cyan}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{gb-slot}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{gb-slate}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{gb-mint}}" />

    <!-- States: the settings row is a full magenta bar with white text -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{gb-magenta-deep}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{gb-magenta}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{gb-magenta}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{gb-white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{gb-slate}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{gb-magenta-deep}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{gb-mint}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{gb-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{gb-white}}" />

    <!-- Headings: magenta label over the frame -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{gb-magenta}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{gb-mint}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{gb-amber}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{gb-edge}}" />

    <!-- Buttons: dark plate with a thin edge; Play is the mint health pip -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{gb-white}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{gb-edge}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{gb-magenta-dark}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{gb-magenta-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{gb-mint}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{gb-void}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{gb-mint-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{gb-mint-dim}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{gb-magenta}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{gb-magenta-deep}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{gb-void}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{gb-edge}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{gb-magenta}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{gb-ash}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{gb-magenta}}" />

    <!-- Controls: pip rows -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{gb-edge}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{gb-white}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{gb-mint}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{gb-magenta}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{gb-edge}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{gb-edge}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{gb-magenta}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{gb-edge}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{gb-magenta}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{gb-ash}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{gb-white}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{gb-edge}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{gb-white}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{gb-magenta-deep}}" />

    <!-- Library -->
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{gb-mint}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{gb-magenta}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{gb-edge}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{gb-magenta-deep}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{gb-mauve}}" />
    <SolidColorBrush x:Key="FrameHoverBrush" Color="{{gb-magenta}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{gb-slate}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{gb-white}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{gb-ash}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{gb-mint}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{gb-mint}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{gb-slot}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{gb-white}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{gb-magenta-dark}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{gb-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{gb-magenta}}" />
</ResourceDictionary>
