<!--
    Glyphbit: ProgressBar. The energy gauge: 8px magenta pips with a 2px gap on a dark row. Indeterminate sends one block
    along the bar. Structure and parts: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Grid.OpacityMask>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,10,8" ViewportUnits="Absolute" Viewbox="0,0,10,8" ViewboxUnits="Absolute" Stretch="Fill">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0H8V8H0Z M9.99,0H10V0.01H9.99Z M9.99,7.99H10V8H9.99Z" />
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Grid.OpacityMask>
                        <Rectangle Fill="{TemplateBinding Background}" />
                        <Rectangle Name="PART_Track" Margin="0" />
                        <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                            <Grid ClipToBounds="True">
                                <Rectangle x:Name="Fill" Fill="{TemplateBinding Foreground}" />
                                <Rectangle x:Name="Block" Width="60" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" Visibility="Collapsed">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="BlockShift" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Decorator>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Fill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Block" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlockRun">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="BlockShift" Storyboard.TargetProperty="X" From="-60" To="800" Duration="0:0:2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="BlockRun" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
