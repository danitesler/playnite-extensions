<!--
    Glyphbit: ContextMenu. Every menu and dropdown list (the hamburger menu, the top bar dropdowns through TopPanelMenu,
    GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select boxes) is the
    settings screen's frame:
    - Panel (LocalMenuFrameTemplate, shared by Menu.xaml's submenus, ComboBox.xaml, CustomControls/ComboBoxList.xaml and
      CustomControls/FilterSelectionBox.xaml): the ink floor inside a square 2px magenta frame (FrameBrush), white pips
      on the top-right and bottom-left corners, and an unreadable rune column (IconGlyphColumn) inside the top-left
      corner, under the first row's icon gutter.
    The root is a shared-size scope so the shortcut chips line up. Rows, the stepped magenta bar and the pixel rules:
    Menu.xaml. Recipe: docs/themes/menus.md. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuFrameTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="2" />
            <Grid Margin="2" ClipToBounds="True">
                <Canvas Margin="2,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.6">
                    <Path Data="{DynamicResource IconGlyphColumn}" Fill="{DynamicResource FrameInnerBrush}" />
                </Canvas>
            </Grid>
            <Rectangle Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource TextBrush}" />
            <Rectangle Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource TextBrush}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuFrameTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="2,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
