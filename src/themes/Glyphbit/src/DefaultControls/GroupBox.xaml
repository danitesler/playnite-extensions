<!--
    Glyphbit: GroupBox. A label above a thin square frame, with a rune column inside the top-left corner and one magenta
    pip on the top-right corner, as on the inventory panels. Content-sized: the runes sit in a Canvas, so Statistics
    keeps its wrapping cards. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource SlotBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}" Style="{DynamicResource HeadingTextBlock}">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header" RecognizesAccessKey="True" />
                        </TextBlock>
                        <Grid>
                            <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <Grid ClipToBounds="True" IsHitTestVisible="False">
                                <Canvas Margin="5,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.75">
                                    <Path Data="{DynamicResource IconGlyphColumn}" Fill="{DynamicResource FrameInnerBrush}" />
                                </Canvas>
                            </Grid>
                            <Rectangle Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
