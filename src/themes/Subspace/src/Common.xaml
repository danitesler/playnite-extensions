<!--
    Subspace: Common.xaml — spacing keys, shared white-mask FX ImageBrushes, and LCARS structural templates
    (BrandMarkTemplate, DividerTemplate, LocalScanCellsMaskBrush, LocalPlayGlintMaskBrush,
    LocalBacklitBloomMaskBrush, LocalViewscreenGridMaskBrush, EmptyGameTemplate,
    SteamScreenshotsSkeletonTemplate, HeadingTextBlock, SecondaryButton).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Spacing & Metric Keys (per repo FormControlHeight & Menu rules) -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>                <!-- Standard 32px inputs, combos, buttons -->
    <sys:Double x:Key="IconSize">16</sys:Double>                     <!-- Compact rail and top bar glyphs -->
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>            <!-- Default viewscreen banner height (0..600) -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>              <!-- Default banner darkening slider (0..1) -->
    <Thickness x:Key="ButtonPadding">14,4</Thickness>                <!-- 1.5px border + 4px v-pad = 32px -->
    <Thickness x:Key="InputPadding">9,4</Thickness>                  <!-- TextBox / PasswordBox / ComboBox -->
    <Thickness x:Key="MenuPadding">16,12,8,8</Thickness>             <!-- LCARS mini-elbow menu board inset -->
    <Thickness x:Key="MenuItemPadding">8,4</Thickness>               <!-- Compact 30px menu rows -->
    <Thickness x:Key="ComboBoxDropDownPadding">16,12,8,8</Thickness> <!-- LCARS mini-elbow ComboBox popup inset -->
    <Thickness x:Key="ComboBoxItemPadding">8,4</Thickness>           <!-- 30px ComboBox rows -->
    <Thickness x:Key="ListBoxItemPadding">10,5</Thickness>           <!-- ListBox rows -->
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>       <!-- Framed LCARS GroupBox inset -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>               <!-- Backlit LCARS tooltip inset -->

    <!-- Shared White-Mask FX ImageBrushes (recolored live by ThemeModifier via Fill/Background) -->
    <ImageBrush x:Key="LocalPlayGlintMaskBrush" ImageSource="{ThemeFile 'Images/fx/play-glint.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalBacklitBloomMaskBrush" ImageSource="{ThemeFile 'Images/fx/backlit-bloom.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalScanCellsMaskBrush" ImageSource="{ThemeFile 'Images/fx/scan-cells.png'}"
                TileMode="Tile" Viewport="0,0,20,16" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalScanCellsTightMaskBrush" ImageSource="{ThemeFile 'Images/fx/scan-cells.png'}"
                TileMode="Tile" Viewport="0,0,14,12" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalViewscreenGridMaskBrush" ImageSource="{ThemeFile 'Images/fx/viewscreen-grid.png'}"
                TileMode="Tile" Viewport="0,0,160,96" ViewportUnits="Absolute" Stretch="Fill" />

    <!-- Popup Border -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard Focus Visual (Science Ice-Cyan crisp outline) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Original Brand Mark: Subspace Elbow-Wave Emblem (uses Foreground brush) -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M2,10 A8,8 0 0,1 10,2 H16 V7 H11 A4,4 0 0,0 7,11 V17.5 H2 Z" />
                <Rectangle Canvas.Left="2" Canvas.Top="19" Width="5" Height="3" RadiusX="1" RadiusY="1"
                           Fill="{TemplateBinding Foreground}" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="M17.5,2 H19.5 A2.5,2.5 0 0,1 19.5,7 H17.5 Z" />
                <Rectangle Canvas.Left="9.5" Canvas.Top="9.5" Width="12.5" Height="3" RadiusX="1.5" RadiusY="1.5"
                           Fill="{TemplateBinding Foreground}" />
                <Rectangle Canvas.Left="9.5" Canvas.Top="14" Width="8" Height="3" RadiusX="1.5" RadiusY="1.5"
                           Fill="{TemplateBinding Foreground}" />
                <Rectangle Canvas.Left="19" Canvas.Top="14" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5"
                           Fill="{TemplateBinding Foreground}" />
                <Rectangle Canvas.Left="9.5" Canvas.Top="18.5" Width="5" Height="3.5" RadiusX="1.5" RadiusY="1.5"
                           Fill="{TemplateBinding Foreground}" />
                <Rectangle Canvas.Left="16" Canvas.Top="18.5" Width="6" Height="3.5" RadiusX="1.75" RadiusY="1.75"
                           Fill="{TemplateBinding Foreground}" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- LCARS Tri-Block Segmented Divider (Tangerine pill start + Periwinkle trace + African Violet endcap) -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="10" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="12" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="3" VerticalAlignment="Center" CornerRadius="1.5,0,0,1.5"
                    Background="{DynamicResource StripeBrush}" />
            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                       Fill="{DynamicResource LocalPeriwinkleDimBrush}" />
            <Border Grid.Column="4" Height="3" VerticalAlignment="Center" CornerRadius="0,1.5,1.5,0"
                    Background="{DynamicResource GlyphBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Designed Empty Game Page State (Subspace Calibration Viewscreen) -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource LocalLavenderEdgeBrush}" BorderThickness="1"
                    CornerRadius="14,6,6,14" MinWidth="320" MaxWidth="420">
                <Grid ClipToBounds="True">
                    <!-- Subtle viewscreen astrometric graticule -->
                    <Rectangle Fill="{DynamicResource LocalPeriwinkleBrush}" Opacity="0.09"
                               OpacityMask="{DynamicResource LocalViewscreenGridMaskBrush}" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="6" />
                        </Grid.RowDefinitions>

                        <!-- Top mini LCARS elbow header bar -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource StripeBrush}" CornerRadius="12,0,0,0" />
                            <Rectangle Grid.Column="2" Fill="{DynamicResource StripeAltBrush}" />
                            <Rectangle Grid.Column="4" Fill="{DynamicResource GlyphBrush}" />
                            <Border Grid.Column="6" Background="{DynamicResource StripeDeepBrush}" CornerRadius="0,6,0,0" />
                        </Grid>

                        <!-- Left segmented elbow spine + Center calibration badge -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="3" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Fill="{DynamicResource StripeBrush}" />
                                <Rectangle Grid.Row="2" Fill="{DynamicResource GlyphBrush}" />
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="24,22,24,22" HorizontalAlignment="Center">
                                <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Ellipse x:Name="EmptyOuterArc" Stroke="{DynamicResource LocalPeriwinkleBrush}"
                                             StrokeThickness="1.5" StrokeDashArray="4 3" Opacity="0.55" />
                                    <Border Margin="8" CornerRadius="16,4,16,4"
                                            Background="{DynamicResource NormalBrush}"
                                            BorderBrush="{DynamicResource StripeBrush}" BorderThickness="1.5" />
                                    <Control Width="32" Height="32"
                                             Template="{DynamicResource BrandMarkTemplate}"
                                             Foreground="{DynamicResource LocalGoldBrush}" />
                                </Grid>

                                <!-- 3 LCARS telemetry status pips -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Border x:Name="EmptyPip1" Width="18" Height="4" CornerRadius="2"
                                            Background="{DynamicResource StripeBrush}" />
                                    <Border x:Name="EmptyPip2" Width="10" Height="4" Margin="4,0,0,0" CornerRadius="2"
                                            Background="{DynamicResource GlyphBrush}" />
                                    <Border x:Name="EmptyPip3" Width="14" Height="4" Margin="4,0,0,0" CornerRadius="2"
                                            Background="{DynamicResource StripeDeepBrush}" />
                                </StackPanel>

                                <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                           FontSize="{DynamicResource FontSizeLarger}"
                                           Foreground="{DynamicResource HeadingForegroundBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- Foot segmented bar -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource StripeDeepBrush}" CornerRadius="0,0,0,12" />
                            <Rectangle Grid.Column="2" Fill="{DynamicResource NormalBorderBrush}" />
                            <Border Grid.Column="4" Background="{DynamicResource StripeAltBrush}" CornerRadius="0,0,5,0" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="EmptyBoardIdle">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyOuterArc" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.90" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.35" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyPip1" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyPip2" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.42" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.42" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyPip3" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.6" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyBoardIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SteamScreenshots Plugin Loading Skeleton (LCARS sensor capture frames) -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Height="196" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                    CornerRadius="8" Margin="0,0,0,8">
                <Grid ClipToBounds="True">
                    <Rectangle Fill="{DynamicResource LocalPeriwinkleBrush}" Opacity="0.08"
                               OpacityMask="{DynamicResource LocalViewscreenGridMaskBrush}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="10,10,0,0">
                        <Border Width="38" Height="5" CornerRadius="2.5" Background="{DynamicResource StripeBrush}" />
                        <Border Width="18" Height="5" Margin="4,0,0,0" CornerRadius="2.5" Background="{DynamicResource GlyphBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7">
                        <Border Width="14" Height="5" CornerRadius="2.5" Background="{DynamicResource StripeBrush}" />
                        <Border Width="14" Height="5" Margin="5,0,0,0" CornerRadius="2.5" Background="{DynamicResource GlyphBrush}" />
                        <Border Width="14" Height="5" Margin="5,0,0,0" CornerRadius="2.5" Background="{DynamicResource StripeDeepBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <UniformGrid Columns="4">
                <Border Height="48" Margin="0,0,6,0" CornerRadius="6" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.85" />
                <Border Height="48" Margin="0,0,6,0" CornerRadius="6" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.72" />
                <Border Height="48" Margin="0,0,6,0" CornerRadius="6" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.85" />
                <Border Height="48" CornerRadius="6" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.72" />
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- Game Page Section Heading (Pathway Gothic One tall uppercase in LCARS Data Gold) -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Read-only Notes TextBox (calm flat LCARS reading field without editable input stub) -->
    <Style x:Key="LocalNotesTextBox" TargetType="TextBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Game Page Secondary Action Button (40x40 LCARS modular key; Tag="RightCap" gets right half-pill curve) -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LocalPeriwinkleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Border x:Name="HoverFill" CornerRadius="6.5"
                                        Background="{DynamicResource SecondaryButtonHoverBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="PressFill" CornerRadius="6.5"
                                        Background="{DynamicResource SecondaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="RightCap">
                            <Setter TargetName="Plate" Property="CornerRadius" Value="8,16,16,8" />
                            <Setter TargetName="HoverFill" Property="CornerRadius" Value="6.5,14.5,14.5,6.5" />
                            <Setter TargetName="PressFill" Property="CornerRadius" Value="6.5,14.5,14.5,6.5" />
                            <Setter Property="BorderBrush" Value="{DynamicResource LocalPeachBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalPeachBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource LocalGoldBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LocalGoldBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecBtnHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecBtnHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressFill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressFill" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
