<!--
    Subspace: DefaultControls/TabControl.xaml.
    Segmented LCARS upper-pill tabs separated by 3px black channels; selected tab lights Tangerine top cap +
    backlit violet plate with Gold header text. Keeps Foreground="{DynamicResource TextBrush}" on TabItem
    and applies state colors on the named HeaderText TextBlock so tab body controls inherit TextBrush cleanly.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid Margin="0,0,3,0" SnapsToDevicePixels="True">
                        <Border x:Name="TabPlate" CornerRadius="10,10,0,0"
                                Background="{DynamicResource TabControlHeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1,1,1,0"
                                Padding="14,7">
                            <Grid>
                                <Border x:Name="TopCap" Height="3" Margin="-14,-7,-14,0" VerticalAlignment="Top"
                                        CornerRadius="9,9,0,0" Background="{DynamicResource LocalPeriwinkleDimBrush}"
                                        IsHitTestVisible="False" />
                                <TextBlock x:Name="HeaderText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TabItemForegroundBrush}">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabPlate" Property="Background" Value="{DynamicResource ListItemHoverBrush}" />
                            <Setter TargetName="TopCap" Property="Background" Value="{DynamicResource TabItemHoverIndicatorBrush}" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabPlate" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            <Setter TargetName="TabPlate" Property="BorderBrush" Value="{DynamicResource LocalLavenderEdgeBrush}" />
                            <Setter TargetName="TopCap" Property="Background" Value="{DynamicResource TabItemIndicatorBrush}" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource LocalGoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel" Grid.Row="0" Panel.ZIndex="1"
                                  IsItemsHost="True" Background="Transparent" Margin="0,0,0,0" />
                        <Grid Grid.Row="1" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="{DynamicResource StripeBrush}" />
                            <Rectangle Grid.Column="2" Fill="{DynamicResource LocalLavenderEdgeBrush}" />
                            <Rectangle Grid.Column="4" Fill="{DynamicResource GlyphBrush}" />
                        </Grid>
                        <Border x:Name="Border" Grid.Row="2"
                                Background="{DynamicResource WindowBackgourndBrush}"
                                BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1,0,1,1"
                                CornerRadius="0,0,6,6" Padding="10">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
