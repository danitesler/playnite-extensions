<!--
    Subspace: DefaultControls/Menu.xaml.
    Menus signature levers (docs/themes/menus.md):
    - Panel: LocalLcarsMenuBoardTemplate (#0B0D14 backlit board framed on left & top by a continuous 9px Tangerine
      LCARS elbow spine curving into a 6px Tangerine/Violet/Gold top bar with concave inner fillet and Periwinkle foot).
    - Highlight: 30px rows; solid Sunflower Gold (#FFCC66) right-rounded LCARS command lozenge led by a 5px
      Tangerine stub + 2px black channel scales in (ScaleX 0.90->1, 110ms CubicEase), flipping label, icon
      (TextElement.Foreground on TargetName="Icon"), arrow, and shortcut capsule to #000000 ink (13.7:1) + 2px nudge.
    - Group break: 10px tri-block LCARS segmented bar (14px Tangerine pill -> 2px gap -> 1px Periwinkle -> 10px Violet cap).
    - Shortcuts: outline telemetry pill capsules (CornerRadius="8", 1px Periwinkle rim, Consolas Gold digits at rest;
      invert cleanly to crisp #000000 ink on Sunflower Gold highlight).
    - Submenu mark: rounded LCARS chevron (IconSubmenu); open submenus hold a steady backlit African Violet plate.
    - Marked rows: Exit (Alt+Q) wears Mars Red text + red stub at rest, highlighting as a solid Red Alert (#C42828)
      right-rounded lozenge with Space White ink (5.9:1); checked rows show a 14x14 Ops Mint rounded pill badge.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group Break: 10px LCARS tri-block segmented bar -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="6,0,6,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid Height="10" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="10" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="3" VerticalAlignment="Center" CornerRadius="1.5,0,0,1.5"
                                Background="{DynamicResource StripeBrush}" />
                        <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                                   Fill="{DynamicResource MenuSeparatorBrush}" />
                        <Border Grid.Column="4" Height="3" VerticalAlignment="Center" CornerRadius="0,1.5,1.5,0"
                                Background="{DynamicResource GlyphBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SubmenuItem (plain leaf row, 30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Solid Sunflower Gold LCARS right-rounded command lozenge led by 5px Tangerine stub -->
            <Grid x:Name="HighlightPlate" Margin="2,1.5,2,1.5" Visibility="Collapsed" Opacity="0"
                  IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" ScaleY="1" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="HighlightStub" Grid.Column="0" CornerRadius="2,0,0,2"
                        Background="{DynamicResource StripeBrush}" />
                <Border x:Name="HighlightFill" Grid.Column="2" CornerRadius="0,13,13,0"
                        Background="{DynamicResource MenuItemHoverBrush}" />
            </Grid>

            <!-- Quiet resting Mars Red leading tick on Exit (Alt+Q) -->
            <Border x:Name="ExitRestTick" Width="3" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0"
                    CornerRadius="1.5" Background="{DynamicResource LocalDangerBrightBrush}"
                    Visibility="Collapsed" IsHitTestVisible="False" />

            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <!-- Fixed icon column (16px icon + 8px gap = 24px) -->
                    <ColumnDefinition Width="24" />
                    <!-- Plain * label column (never SharedSizeGroup on star column) -->
                    <ColumnDefinition Width="*" />
                    <!-- Shared shortcut column flush right -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                    <!-- Arrow spacer column matching SubmenuHeader -->
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <!-- Icon or Ops Mint Pill Check Badge -->
                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" TextElement.Foreground="{DynamicResource TextBrushDarker}" />

                <Border x:Name="CheckBoxMark" Grid.Column="0" Width="14" Height="14"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        CornerRadius="5"
                        Background="{DynamicResource CheckBoxCheckMarkBkBrush}"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <ContentControl x:Name="CheckGlyph" Width="9" Height="9"
                                    Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                    Foreground="{DynamicResource TextBrushDark}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Label (nudges +2px right on highlight) -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{DynamicResource TextBrush}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelSlide" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Outline LCARS Telemetry Capsule Shortcut -->
                <Border x:Name="ShortcutCap" Grid.Column="2" Margin="12,0,0,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        CornerRadius="8" Background="{DynamicResource NormalBrush}"
                        BorderBrush="{DynamicResource LocalPeriwinkleDimBrush}" BorderThickness="1">
                    <TextBlock x:Name="ShortcutText" Padding="7,1" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource LocalGoldBrush}" />
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutCap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutCap" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckBoxMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter TargetName="ExitRestTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource LocalDangerBrightBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalDangerBrightBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource LocalDangerBrightBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource TextBrushDark}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource TextBrushDark}" />
                <Setter TargetName="ShortcutCap" Property="Background" Value="{DynamicResource StripeBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource TextBrushDark}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuItemHlIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.11">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.11" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuItemHlOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <!-- Red Alert Exit lozenge on highlight (Space White on #C42828 = 5.9:1) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ExitRestTick" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="HighlightStub" Property="Background" Value="{DynamicResource LocalDangerBrightBrush}" />
                <Setter TargetName="HighlightFill" Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutCap" Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
                <Setter TargetName="ShortcutCap" Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeader (row opening a nested popup, 30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held backlit African Violet plate while submenu stays open (no flicker) -->
            <Grid x:Name="OpenPlate" Margin="2,1.5,2,1.5" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="2,0,0,2" Background="{DynamicResource GlyphBrush}" />
                <Border Grid.Column="2" CornerRadius="0,13,13,0" Background="{DynamicResource SelectedBrush}"
                        BorderBrush="{DynamicResource LocalLavenderEdgeBrush}" BorderThickness="1" />
            </Grid>

            <!-- Sunflower Gold highlight lozenge -->
            <Grid x:Name="HighlightPlate" Margin="2,1.5,2,1.5" Visibility="Collapsed" Opacity="0"
                  IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" ScaleY="1" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="2,0,0,2" Background="{DynamicResource StripeBrush}" />
                <Border Grid.Column="2" CornerRadius="0,13,13,0" Background="{DynamicResource MenuItemHoverBrush}" />
            </Grid>

            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" TextElement.Foreground="{DynamicResource TextBrushDarker}" />

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{DynamicResource TextBrush}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelSlide" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <ContentControl x:Name="SubArrow" Grid.Column="3" Width="10" Height="10"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource GlyphBrush}" />
            </Grid>

            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-10"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade">
                <Grid MinWidth="210" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalLcarsMenuBoardTemplate}"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    <ScrollViewer Margin="14,10,6,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle"
                                        Grid.IsSharedSizeScope="True" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource LocalGoldBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource LocalGoldBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource LocalGoldBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource TextBrushDark}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource TextBrushDark}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource TextBrushDark}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubmenuHlIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.11">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.11" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubmenuHlOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
