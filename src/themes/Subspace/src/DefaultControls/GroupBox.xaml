<!--
    Subspace: DefaultControls/GroupBox.xaml.
    Content-sized LCARS module card (no child width >= 200px; horizontal header track sits in a clipped Grid)
    crowned by a Tangerine pill cap, Gold uppercase header, and Periwinkle rule.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10,6,6,6" SnapsToDevicePixels="True">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="{DynamicResource GroupBoxHeaderMargin}" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="8" VerticalAlignment="Center" CornerRadius="4,0,0,4"
                                        Background="{DynamicResource StripeBrush}" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="8,0,8,0"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"
                                                  TextElement.Foreground="{DynamicResource HeadingForegroundBrush}"
                                                  TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                  TextElement.FontSize="{DynamicResource FontSizeLarge}" />
                                <Rectangle Grid.Column="2" Height="2" VerticalAlignment="Center"
                                           Fill="{DynamicResource NormalBorderBrush}" />
                                <Border Grid.Column="3" Height="6" Margin="4,0,0,0" VerticalAlignment="Center"
                                        CornerRadius="0,3,3,0" Background="{DynamicResource GlyphBrush}" />
                            </Grid>
                            <ContentPresenter Grid.Row="1" ContentSource="Content" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
