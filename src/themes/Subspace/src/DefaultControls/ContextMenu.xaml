<!--
    Subspace: DefaultControls/ContextMenu.xaml.
    Signature menu panel (LocalLcarsMenuBoardTemplate) shared by ContextMenu, TopPanelMenu, submenus, and ComboBox lists:
    True-black / #0B0D14 backlit LCARS console board framed on its entire left and top edges by a continuous
    10px Tangerine LCARS elbow spine curving cleanly into a 6px segmented top cap (Tangerine -> 2px black gap ->
    African Violet -> 2px black gap -> Sunflower Gold right half-pill endcap) with a concave inner elbow fillet,
    a 4px Periwinkle bottom foot cap, and a 1px Lavender-Edge outer border. Zero DropShadowEffect.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared LCARS Mini-Elbow Console Board Panel Template -->
    <ControlTemplate x:Key="LocalLcarsMenuBoardTemplate" TargetType="{x:Type Control}">
        <Border Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="1"
                CornerRadius="12,6,6,10"
                IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="4" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Top segmented LCARS header bar curving from the left elbow spine -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="2" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource StripeBrush}" CornerRadius="11,0,0,0" />
                    <Rectangle Grid.Column="2" Fill="{DynamicResource GlyphBrush}" />
                    <Border Grid.Column="4" Background="{DynamicResource LocalGoldBrush}" CornerRadius="0,5,3,0" />
                </Grid>

                <!-- Left segmented LCARS vertical elbow spine -->
                <Grid Grid.Row="1" Grid.Column="0" Width="9" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="18" />
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Fill="{DynamicResource StripeBrush}" />
                    <Rectangle Grid.Row="2" Fill="{DynamicResource StripeAltBrush}" />
                    <Rectangle Grid.Row="4" Fill="{DynamicResource StripeDeepBrush}" />
                </Grid>

                <!-- Concave 7x7 inner elbow fillet -->
                <Path Grid.Row="1" Grid.Column="1" Width="7" Height="7"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Fill="{DynamicResource StripeBrush}"
                      Data="M0,0 L7,0 A7,7 0 0,0 0,7 Z" />

                <!-- Bottom segmented LCARS foot bar -->
                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="2" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource StripeDeepBrush}" CornerRadius="0,0,0,9" />
                    <Rectangle Grid.Column="2" Fill="{DynamicResource NormalBorderBrush}" />
                    <Border Grid.Column="4" Background="{DynamicResource GlyphBrush}" CornerRadius="0,0,5,0" />
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="MinWidth" Value="224" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalLcarsMenuBoardTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ScrollViewer Margin="14,10,6,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle"
                                            Grid.IsSharedSizeScope="True" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
