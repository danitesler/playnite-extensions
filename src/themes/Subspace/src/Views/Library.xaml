<!--
    Subspace: Views/Library.xaml.
    True-black (#000000) backlit LCARS console canvas.
    Window background (src/themes/AGENTS.md): PART_ImageBackground renders at full strength with no theme
    scrim, tint, mask, opacity or blur; top-aligned with a soft bottom fade into WindowArtSwatch so art never
    ends in a hard line. The art layer spans TopPanel and reaches under the 44px Sidebar rail.
    A 14x14 concave Tangerine LCARS inner elbow fillet sits cleanly at the top-left of the library row when
    the left rail is active and window art is off.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid Background="{TemplateBinding Background}"
                          d:DesignWidth="1500" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <!-- Full-strength window background art spanning top bar and reaching under the 44px sidebar rail -->
                        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Margin" Value="-44,0,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                                            <Setter Property="Margin" Value="0,0,-44,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                                            <Setter Property="Margin" Value="0,-56,0,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                                            <Setter Property="Margin" Value="0,0,0,-56" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border x:Name="WindowArtSwatch" Background="{DynamicResource ContentBackgroundBrush}" Visibility="Collapsed" />
                            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Top" IsHitTestVisible="False">
                                <FadeImage x:Name="PART_ImageBackground" VerticalAlignment="Top" HorizontalAlignment="Center" />
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.55" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=WindowArtSwatch}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Grid>

                        <TopPanel DockPanel.Dock="Top" Grid.Row="0" />

                        <Grid Grid.Row="1">
                            <DockPanel>
                                <FilterPanel x:Name="PART_FilterPanel"
                                             DockPanel.Dock="{Settings FilterPanelPosition}"
                                             Width="{Settings FilterPanelWitdh}"
                                             Visibility="{Settings FilterPanelVisible}" />

                                <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                               DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                               Width="{Settings ExplorerPanelWitdh}" />

                                <Grid DockPanel.Dock="Left">
                                    <LibraryDetailsView x:Name="PART_ViewDetails" />
                                    <LibraryGridView x:Name="PART_ViewGrid" />
                                    <LibraryListView x:Name="PART_ViewList" />
                                </Grid>
                            </DockPanel>

                            <!-- Concave 14x14 LCARS inner elbow fillet seamlessly joining Sidebar rail to TopPanel track -->
                            <Path x:Name="ElbowInnerFillet" Width="14" Height="14"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Fill="{DynamicResource StripeBrush}"
                                  Data="M0,0 L14,0 A14,14 0 0,0 0,14 Z"
                                  IsHitTestVisible="False" Panel.ZIndex="10">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings ShowSidebar}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
