<!--
    Subspace: Views/Sidebar.xaml.
    44px true-black LCARS vertical rail spine: crowned by a 44x50 Tangerine curved upper-left elbow cap
    (PART_ElemMainMenu, CornerRadius="22,0,0,0") with the Subspace Elbow-Wave mark in black ink, flowing
    directly into a 14px Tangerine elbow stem beside the concave fillet, a 3px black channel, an 8px Peach
    collar, scrollable 44x40 sidebar slots, and a lower-left multi-block LCARS foot stack (47-01 / 09-A / LC-4).
    Turns transparent when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource ShellBackgroundBrush}" Margin="{TemplateBinding Padding}">
                        <DockPanel x:Name="DockContentHolder">
                            <!-- Upper-left sweeping LCARS Elbow cap (44x50) + seamless 14px elbow stem -->
                            <StackPanel x:Name="TopElbowGroup" DockPanel.Dock="Top" Orientation="Vertical">
                                <Border x:Name="PART_ElemMainMenu" Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                        Width="44" Height="50" CornerRadius="22,0,0,0"
                                        Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Border x:Name="MenuHoverFill" CornerRadius="22,0,0,0"
                                                Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}"
                                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                        <Control x:Name="MenuMark" Width="22" Height="22"
                                                 Template="{DynamicResource BrandMarkTemplate}"
                                                 Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <!-- Seamless 14px Tangerine elbow stem directly beside Library's concave inner fillet -->
                                <Rectangle x:Name="ElbowStem" Width="44" Height="14"
                                           Fill="{DynamicResource StripeBrush}" IsHitTestVisible="False" />
                                <!-- 3px pure-black LCARS channel + 8px Peach accent collar -->
                                <Rectangle x:Name="ElbowCollar" Width="44" Height="8" Margin="0,3,0,3"
                                           Fill="{DynamicResource StripeAltBrush}" IsHitTestVisible="False" />
                            </StackPanel>

                            <!-- Lower LCARS multi-block structural rail foot stack (Periwinkle / Peach / Tangerine curved foot) -->
                            <StackPanel x:Name="RailFootStack" DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,6,0,4" IsHitTestVisible="False">
                                <Border Height="68" Width="44" Background="{DynamicResource StripeDeepBrush}" Margin="0,0,0,3">
                                    <TextBlock Text="47-01" FontFamily="{DynamicResource MonospaceFontFamily}"
                                               FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextBrushDark}"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" />
                                </Border>
                                <Border Height="26" Width="44" Background="{DynamicResource StripeAltBrush}" Margin="0,0,0,3">
                                    <TextBlock Text="09-A" FontFamily="{DynamicResource MonospaceFontFamily}"
                                               FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextBrushDark}"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" />
                                </Border>
                                <Border Height="40" Width="44" CornerRadius="0,0,0,18" Background="{DynamicResource StripeBrush}">
                                    <TextBlock Text="LC-4" FontFamily="{DynamicResource MonospaceFontFamily}"
                                               FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextBrushDark}"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" />
                                </Border>
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                          DockPanel.Dock="Top" CanContentScroll="True"
                                          x:Name="ScrollSidebarItems">
                                <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Background" Value="Transparent" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" TargetName="MenuMark" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ElbowStem" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ElbowCollar" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootStack" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" TargetName="MenuMark" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="MenuHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="CornerRadius" Value="0,22,0,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="CornerRadius" Value="0,22,0,0" TargetName="MenuHoverFill" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ElbowStem" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="TopElbowGroup" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="TopElbowGroup" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="CornerRadius" Value="0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="CornerRadius" Value="0" TargetName="MenuHoverFill" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ElbowStem" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ElbowCollar" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootStack" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,136,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="TopElbowGroup" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="TopElbowGroup" />
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="CornerRadius" Value="0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="CornerRadius" Value="0" TargetName="MenuHoverFill" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ElbowStem" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ElbowCollar" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootStack" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
