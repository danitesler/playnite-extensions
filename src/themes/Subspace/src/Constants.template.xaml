<!--
    Subspace: Constants.xaml template (Star Trek: LCARS-inspired dark bridge-console theme).
    scripts/build-theme.ps1 renders tokens.css placeholders into Constants.xaml.
    True-black (#000000) backlit Kodalith glass framed by Tangerine/Gold/Violet/Peach/Periwinkle LCARS
    acrylic segments, Ice Cyan science filter pip, Warp Ops Teal running sweeps, and Red Alert danger.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Pathway Gothic One unmodified OFL + Barlow Semi Condensed OFL bundled in src/Typography/) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">22</sys:Double>
    <sys:Double x:Key="FontSizeLargest">38</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow Semi Condensed, Barlow Semi Condensed, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Pathway Gothic One, Pathway Gothic One, Barlow Semi Condensed, Arial Narrow, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Game page metadata pane defaults (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape & radii: modular LCARS rounded blocks & half-pill endcaps (never CornerRadiusFull on non-square controls) -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1.5</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">20</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{lcars-text}}</Color>
    <Color x:Key="TextColorDarker">{{lcars-text-muted}}</Color>
    <Color x:Key="TextColorDark">{{lcars-text-ink}}</Color>
    <Color x:Key="MainColor">{{lcars-surface}}</Color>
    <Color x:Key="MainColorDark">{{lcars-panel}}</Color>
    <Color x:Key="HoverColor">{{lcars-periwinkle-wash}}</Color>
    <Color x:Key="GlyphColor">{{lcars-lavender}}</Color>
    <Color x:Key="HighlightGlyphColor">{{lcars-lavender-wash}}</Color>
    <Color x:Key="PopupBackgroundColor">{{lcars-panel}}</Color>
    <Color x:Key="PopupBorderColor">{{lcars-lavender-edge}}</Color>
    <Color x:Key="BackgroundToneColor">{{lcars-void}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{lcars-border}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{lcars-border}}</Color>
    <Color x:Key="DataChangeNotifColor">{{lcars-cyan}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{lcars-border-strong}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{lcars-panel}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{lcars-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{lcars-tangerine}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{lcars-surface}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{lcars-ops-mint}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{lcars-rating-pos}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{lcars-rating-neg}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{lcars-rating-mix}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{lcars-gold}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{lcars-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{lcars-void}}" />

    <!-- Shell, Chrome & Game Page Brushes -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{lcars-void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{lcars-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{lcars-void}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{lcars-void}}" />
    <!-- Solid deep obsidian-plum brand tint for banner darkening (no alpha) -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{lcars-banner-tint}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{lcars-void}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{lcars-tangerine}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{lcars-text-ink}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{lcars-panel}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{lcars-surface}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{lcars-border}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{lcars-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{lcars-gold}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{lcars-gold}}" />

    <!-- LCARS Multi-Color Structural Acrylic Blocks (Local* + shared Stripe roles) -->
    <SolidColorBrush x:Key="StripeBrush" Color="{{lcars-tangerine}}" />
    <SolidColorBrush x:Key="StripeAltBrush" Color="{{lcars-peach}}" />
    <SolidColorBrush x:Key="StripeDeepBrush" Color="{{lcars-periwinkle}}" />
    <SolidColorBrush x:Key="StripeAccentBrush" Color="{{lcars-gold}}" />
    <SolidColorBrush x:Key="LocalTangerineBrush" Color="{{lcars-tangerine}}" />
    <SolidColorBrush x:Key="LocalGoldBrush" Color="{{lcars-gold}}" />
    <SolidColorBrush x:Key="LocalFlashBrush" Color="{{lcars-flash}}" />
    <SolidColorBrush x:Key="LocalPeachBrush" Color="{{lcars-peach}}" />
    <SolidColorBrush x:Key="LocalLavenderBrush" Color="{{lcars-lavender}}" />
    <SolidColorBrush x:Key="LocalLavenderEdgeBrush" Color="{{lcars-lavender-edge}}" />
    <SolidColorBrush x:Key="LocalPeriwinkleBrush" Color="{{lcars-periwinkle}}" />
    <SolidColorBrush x:Key="LocalPeriwinkleDimBrush" Color="{{lcars-periwinkle-dim}}" />
    <SolidColorBrush x:Key="LocalRunningHighlightBrush" Color="{{lcars-ops-mint}}" />
    <SolidColorBrush x:Key="LocalDangerBrightBrush" Color="{{lcars-alert-red-hi}}" />
    <SolidColorBrush x:Key="LocalDimTextBrush" Color="{{lcars-text-dim}}" />

    <!-- State Brushes: African Violet backlit wash for selection; Periwinkle for hover; Warp Ops Teal for running -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{lcars-lavender-wash}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{lcars-lavender-hover}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{lcars-lavender}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{lcars-text}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{lcars-periwinkle-wash}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{lcars-lavender-wash}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{lcars-gold}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{lcars-periwinkle-dim}}" />
    <!-- Dedicated Warp Ops Teal running indicator (distinct from Tangerine Play, Violet selection, Periwinkle hover, Cyan filter, Red Alert) -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{lcars-ops-teal}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{lcars-cyan}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{lcars-cyan-halo}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{lcars-alert-red}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{lcars-text}}" />

    <!-- Button Brushes: Tangerine LCARS Command Lozenge -> Sunflower Gold hover -> Pale Gold flash press -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{lcars-text}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{lcars-text}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{lcars-text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{lcars-periwinkle-wash}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{lcars-periwinkle-press}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{lcars-periwinkle-dim}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{lcars-tangerine}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{lcars-gold}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{lcars-flash}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{lcars-tangerine-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{lcars-text-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{lcars-gold}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{lcars-surface}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{lcars-periwinkle-dim}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{lcars-periwinkle-wash}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{lcars-periwinkle-press}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{lcars-lavender}}" />

    <!-- Input & Control Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{lcars-panel}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{lcars-surface}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{lcars-periwinkle-dim}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{lcars-periwinkle}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{lcars-periwinkle-dim}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{lcars-ops-mint}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{lcars-ops-mint}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{lcars-surface}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{lcars-gold}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{lcars-tangerine}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{lcars-gold}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{lcars-gold}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{lcars-surface}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{lcars-periwinkle-dim}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{lcars-periwinkle}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{lcars-panel}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{lcars-periwinkle-dim}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{lcars-gold}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{lcars-text-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{lcars-text}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{lcars-tangerine}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{lcars-periwinkle}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{lcars-panel}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{lcars-periwinkle}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{lcars-tangerine}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{lcars-periwinkle-wash}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{lcars-lavender}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{lcars-text-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{lcars-text-ink}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{lcars-surface}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{lcars-text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{lcars-periwinkle}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{lcars-periwinkle}}" />
</ResourceDictionary>
