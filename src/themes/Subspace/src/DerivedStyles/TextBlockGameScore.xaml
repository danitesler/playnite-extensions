<!--
    Subspace: DerivedStyles/TextBlockGameScore.xaml.
    LCARS numeric readout plaque: colored status bar (Positive Ops Emerald / Mixed Gold / Negative Mars Red)
    paired with crisp Pathway Gothic One tall numerals inside a dark console readout cell.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TextBlockGameScore" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Padding" Value="9,1,9,1" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource NormalBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreGroup.Positive}">
                <Setter Property="Foreground" Value="{DynamicResource PositiveRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreGroup.Negative}">
                <Setter Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreGroup.Mixed}">
                <Setter Property="Foreground" Value="{DynamicResource MixedRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreGroup.None}">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
