<!--
    Subspace: DerivedStyles/GridViewItemStyle.xaml (Grid View Cover Tiles).
    - Hover (IsMouseOver): smooth 1.02 lift (ControlTemplate.Triggers RenderTransform) + Periwinkle top & bottom
      LCARS pill-bar brackets illuminating and scaling cleanly from center (140ms CubicEase).
    - Click / Selection (IsSelected): signature dual-color LCARS elbow lock — solid Tangerine top-left L-elbow
      and African Violet bottom-right L-elbow framing the cover with 2px black gaps (160ms CubicEase).
    - RunningIndicator (Margin="4" inset): Warp Ops Teal rounded frame + wash + segmented RunningScan + 16px
      bottom telemetry tape holding pill-capped RunningFill + 3 staggered Ops Mint equalizer bars.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="TileRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <ContentPresenter />

                        <!-- Hover Overlay: Periwinkle top & bottom LCARS tracking bars -->
                        <Grid x:Name="HoverOverlay" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Margin="1" CornerRadius="10"
                                    BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" BorderThickness="1.5" />
                            <Border x:Name="HoverTopBar" Height="4" Margin="18,1,18,0" VerticalAlignment="Top"
                                    CornerRadius="2" Background="{DynamicResource LocalPeriwinkleBrush}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="HoverBarScaleX" ScaleX="0.35" />
                                </Border.RenderTransform>
                            </Border>
                            <Border Height="3" Margin="26,0,26,1" VerticalAlignment="Bottom"
                                    CornerRadius="1.5" Background="{DynamicResource LocalPeriwinkleBrush}" Opacity="0.8" />
                        </Grid>

                        <!-- Selected Overlay: Dual-Color LCARS L-Elbow Brackets (Tangerine TL + African Violet BR) -->
                        <Grid x:Name="SelectedOverlay" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Margin="1" CornerRadius="10"
                                    BorderBrush="{DynamicResource LocalLavenderEdgeBrush}" BorderThickness="1.5" />
                            <!-- Top-Left Tangerine L-Elbow -->
                            <Path HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0"
                                  Fill="{DynamicResource GridViewItemSelectedBorderBrush}"
                                  Data="M0,12 A12,12 0 0,1 12,0 H42 V5 H12 A7,7 0 0,0 5,12 V38 H0 Z" />
                            <!-- Bottom-Right African Violet L-Elbow -->
                            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0"
                                  Fill="{DynamicResource SelectedBorderBrush}"
                                  Data="M42,26 A12,12 0 0,1 30,38 H0 V33 H30 A7,7 0 0,0 37,26 V0 H42 Z" />
                        </Grid>

                        <!-- Running / Launching Warp Ops Teal Indicator (Margin="4" inset above selection/hover) -->
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.94"
                              IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" CornerRadius="8"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.18" />
                            <!-- Segmented scan sweep -->
                            <Border CornerRadius="8" OpacityMask="{DynamicResource LocalScanCellsMaskBrush}">
                                <Border x:Name="RunningScan" Visibility="Collapsed" CornerRadius="8"
                                        Background="{DynamicResource LocalRunningHighlightBrush}" Opacity="0.34">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </Border>
                            <!-- 16px Footer Telemetry Tape inside cover frame -->
                            <Border Height="16" VerticalAlignment="Bottom" Margin="1.5" CornerRadius="0,0,7,7"
                                    Background="{DynamicResource ShellBackgroundBrush}" Opacity="0.84">
                                <Grid Margin="6,0,6,0">
                                    <Grid Height="2" VerticalAlignment="Center" Margin="0,0,22,0">
                                        <Border CornerRadius="1" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34" />
                                        <Border x:Name="RunningFill" CornerRadius="1" Background="{DynamicResource LocalRunningHighlightBrush}"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="10">
                                        <Border x:Name="CovEq1" Width="2.5" Height="10" Margin="0,0,2,0" CornerRadius="1,1,0,0"
                                                Background="{DynamicResource LocalRunningHighlightBrush}" RenderTransformOrigin="0.5,1">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="CovEq1ScaleY" ScaleY="0.5" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="CovEq2" Width="2.5" Height="10" Margin="0,0,2,0" CornerRadius="1,1,0,0"
                                                Background="{DynamicResource TextBrush}" RenderTransformOrigin="0.5,1">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="CovEq2ScaleY" ScaleY="0.9" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="CovEq3" Width="2.5" Height="10" CornerRadius="1,1,0,0"
                                                Background="{DynamicResource LocalRunningHighlightBrush}" RenderTransformOrigin="0.5,1">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="CovEq3ScaleY" ScaleY="0.6" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="RunningFrame" CornerRadius="8"
                                    BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CoverHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="HoverBarScaleX" Storyboard.TargetProperty="ScaleX" From="0.35" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CoverHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CoverSelectIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CoverSelectOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.20" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovEq1ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.95" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovEq2ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.08" Value="1.0" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovEq3ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.20" Value="0.90" KeySpline="0.3,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovEq1ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.88" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.45" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovEq2ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.90" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.52" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.90" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CovEq3ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0.92" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.55" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
