<!--
    Subspace: DerivedStyles/StandardWindowStyle.xaml (Settings, Add-ons, Game Editor, every Playnite dialog).
    44px LCARS inline header band (CaptionHeight=44, ContentPresenter Margin="0,44,0,0"):
    Left 52px Tangerine curved elbow cap bearing Subspace's Elbow-Wave mark in black ink, uppercase
    Pathway Gothic One title in LCARS Gold, sweeping segmented African Violet / Peach / Periwinkle tracking
    bar, modular 44x41 WindowBarButton caption keys, and a 3px segmented Tangerine / Periwinkle / Violet
    closing rule. WindowDesignStyle is defined standalone (never BasedOn StandardWindowStyle).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource LocalLavenderEdgeBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px LCARS Inline Tracking Header Band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}"
                                      ClipToBounds="True" SnapsToDevicePixels="True">
                                    <!-- 3px segmented closing rule under the band -->
                                    <Grid Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="{DynamicResource StripeBrush}" />
                                        <Rectangle Grid.Column="2" Fill="{DynamicResource LocalPeriwinkleDimBrush}" />
                                        <Rectangle Grid.Column="4" Fill="{DynamicResource GlyphBrush}" />
                                    </Grid>

                                    <DockPanel LastChildFill="True" Height="41" VerticalAlignment="Top">
                                        <!-- Right-aligned modular LCARS caption keys -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>

                                        <!-- Left Tangerine elbow emblem cap -->
                                        <Border DockPanel.Dock="Left" Width="52" Height="41"
                                                Background="{DynamicResource StripeBrush}"
                                                CornerRadius="12,0,0,0" Margin="0,0,10,0"
                                                IsHitTestVisible="False">
                                            <Control Width="22" Height="22" Template="{DynamicResource BrandMarkTemplate}"
                                                     Foreground="{DynamicResource TextBrushDark}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Title text embedded inline in LCARS header track -->
                                        <TextBlock x:Name="PART_TextTitle" DockPanel.Dock="Left"
                                                   Text="{TemplateBinding Title}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   FontFamily="{DynamicResource HeadingFontFamily}"
                                                   FontSize="24"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Sweeping segmented LCARS bar filling remaining width (zero-size Canvas-safe Grid) -->
                                        <Grid VerticalAlignment="Center" Height="20" Margin="0,0,8,0" IsHitTestVisible="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Fill="{DynamicResource GlyphBrush}" />
                                            <Rectangle Grid.Column="2" Fill="{DynamicResource StripeAltBrush}" />
                                            <Border Grid.Column="4" Background="{DynamicResource StripeDeepBrush}" CornerRadius="0,10,10,0" />
                                        </Grid>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter Property="Text" Value="{DynamicResource LOCSettingsLabel}" TargetName="PART_TextTitle" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
