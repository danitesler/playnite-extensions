<!--
    Cloudbank: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json). Token names (tr-*) live in tokens.css; each
    placeholder names the token that plays the key's role. Role map and sources: ../AGENTS.md -> Tokens, ../RESEARCH.md.
    Theme XAML reads brushes only, never Color keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Raleway headings and Ubuntu body in the game; Windows fallbacks follow (no font ships). -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">29</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:tr-font-body|Segoe UI}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:tr-font-heading|Segoe UI}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape: rectangles with a 2px softening at most; panels stay square. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:tr-radius|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">1</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">3</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{tr-text}}</Color>
    <Color x:Key="TextColorDarker">{{tr-text-body}}</Color>
    <Color x:Key="TextColorDark">{{tr-cell}}</Color>
    <Color x:Key="MainColor">{{tr-cell}}</Color>
    <Color x:Key="MainColorDark">{{tr-panel}}</Color>
    <Color x:Key="HoverColor">{{tr-panel-raised}}</Color>
    <Color x:Key="GlyphColor">{{tr-turn}}</Color>
    <Color x:Key="HighlightGlyphColor">{{tr-turn-dim}}</Color>
    <Color x:Key="PopupBackgroundColor">{{tr-panel-raised}}</Color>
    <Color x:Key="PopupBorderColor">{{tr-circuit-soft}}</Color>
    <Color x:Key="BackgroundToneColor">{{tr-deep}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{tr-frame}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{tr-trace}}</Color>
    <Color x:Key="DataChangeNotifColor">{{tr-active}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{tr-frame}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{tr-panel-raised}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{tr-cell}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{tr-cell}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{tr-mem}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{tr-process}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{tr-active}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{tr-active}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{tr-panel}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{tr-void}}" />

    <!-- Shared keys. ThemeModifier lists them under Edit constants. -->
    <!-- Shell layers -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{tr-void}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{tr-void}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{tr-deep}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{tr-deep}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{tr-deep}}" />
    <SolidColorBrush x:Key="ArtTintBrush" Color="{{tr-cell}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{tr-frame}}" />
    <SolidColorBrush x:Key="TopPanelRuleStartBrush" Color="{{tr-circuit}}" />
    <SolidColorBrush x:Key="TopPanelRuleEndBrush" Color="{{tr-trace}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{tr-mint}}" />
    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{tr-glow}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{tr-bracket}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{tr-text}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{tr-panel}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{tr-glow}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{tr-bracket}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{tr-process}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{tr-text}}" />
    <!-- Headings: the colored bar and rule of the game's section headers -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{tr-text}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{tr-func}}" />
    <SolidColorBrush x:Key="HeadingMarkerAltBrush" Color="{{tr-detail}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{tr-text-body}}" />
    <SolidColorBrush x:Key="TitleSuffixBrush" Color="{{tr-mint}}" />
    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{tr-text}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{tr-circuit-soft}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{tr-glow}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{tr-trace}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{tr-turn}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{tr-cell}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{tr-mint}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{tr-turn-dim}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{tr-turn/35}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{tr-glow}}" />
    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{tr-cell}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{tr-frame}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{tr-circuit-soft}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{tr-circuit-soft}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{tr-circuit}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{tr-cell}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{tr-turn}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{tr-turn}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{tr-cell}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{tr-frame}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{tr-circuit-soft}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{tr-frame}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{tr-circuit-soft}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{tr-text-body}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{tr-turn}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{tr-trace}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{tr-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{tr-circuit-soft}}" />
    <!-- Library -->
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{tr-circuit-soft}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{tr-bracket}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{tr-frame}}" />
    <SolidColorBrush x:Key="FrameBrush" Color="{{tr-circuit}}" />
    <SolidColorBrush x:Key="FrameInnerBrush" Color="{{tr-circuit/25}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{tr-glow}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{tr-turn}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{tr-text-menu}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{tr-turn}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{tr-turn}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{tr-cell}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{tr-mint}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{tr-glow}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{tr-void}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{tr-text}}" />
</ResourceDictionary>
