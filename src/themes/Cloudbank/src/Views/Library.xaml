<!--
    Cloudbank: library layer. Solid Functions-panel teal (ContentBackgroundBrush) easing toward the window black at the
    bottom, with the pause-panel glow under the top bar; no texture. Background art sits above it at 0.14, washed toward
    the cell color, faded out by 70% with a plain gradient overlay (no mask). The top bar is raised (ZIndex 1) so its bloom shows over
    the views. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid x:Name="LibraryRoot" Background="{DynamicResource ContentBackgroundBrush}"
                          d:DesignWidth="1500" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                            <FadeImage x:Name="PART_ImageBackground" Opacity="0.14"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <Border Background="{DynamicResource ArtTintBrush}" Opacity="0.35"
                                    Visibility="{Binding Visibility, ElementName=PART_ImageBackground}" />
                            <!-- No OpacityMask on library art: animated covers and top bar items above it would leave dark boxes
                                 on scaled displays (see reference.md). A plain gradient to the page color fades it out instead. -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="{Binding Background.Color, ElementName=LibraryRoot}" Offset="0.7" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <!-- Bottom darkening and the pause-panel glow as plain gradients (no masks behind animated items).
                             Colors come from brush swatches so ThemeModifier edits still apply. -->
                        <Border x:Name="VoidSwatch" Background="{DynamicResource WindowBackgourndBrush}" Visibility="Collapsed" />
                        <Border x:Name="AccentSwatch" Background="{DynamicResource GlyphBrush}" Visibility="Collapsed" />
                        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.65">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.25" />
                                    <GradientStop Color="{Binding Background.Color, ElementName=VoidSwatch}" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Height="520" Margin="-200,-260,-200,0" Opacity="0.09" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{Binding Background.Color, ElementName=AccentSwatch}" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <TopPanel DockPanel.Dock="Top" Grid.Row="0" Panel.ZIndex="1" />

                        <DockPanel Grid.Row="1">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}" />

                            <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                           DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}" />

                            <Grid DockPanel.Dock="Left">
                                <LibraryDetailsView x:Name="PART_ViewDetails" />
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
