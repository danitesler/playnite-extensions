<!--
    Overlay on Playnite Default/Views/Library.xaml. Solid Functions-panel teal library layer
    (ContentBackgroundBrush) with the pause-panel glow under the top bar (decor); no texture. The top bar is raised
    (ZIndex 1) so its bloom shows over the views.
    Layout and parts are Playnite's: top bar over the panels and views, filter and explorer panels on their
    settings' sides, the three library views stacked.
    Window background (repo AGENTS.md "Window background"): PART_ImageBackground holds the game art only while
    Playnite's "Use game background image as window background" is on, and shows it at full strength with no theme
    scrim, tint, mask or blur: Playnite's own darken and blur settings are the only treatment. While it is on, the
    top bar, the side panels and the game pages turn see-through.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid x:Name="LibraryRoot" Background="{DynamicResource ContentBackgroundBrush}"
                          d:DesignWidth="1500" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                            <!-- Window art (Playnite's window background setting): shown at full strength, top-aligned at its own size;
                                 its bottom edge fades into the color behind it so the art never ends in a hard line. -->
                            <Border x:Name="WindowArtSwatch" Background="{DynamicResource ContentBackgroundBrush}" Visibility="Collapsed" />
                            <Grid VerticalAlignment="Top" IsHitTestVisible="False">
                                <FadeImage x:Name="PART_ImageBackground" VerticalAlignment="Top" HorizontalAlignment="Center" />
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.55" />
                                            <GradientStop Color="{Binding Background.Color, ElementName=WindowArtSwatch}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Grid>

                        <Border x:Name="AccentSwatch" Background="{DynamicResource GlyphBrush}" Visibility="Collapsed" />
                        <Rectangle Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Height="520" Margin="-200,-260,-200,0" Opacity="0.09" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{Binding Background.Color, ElementName=AccentSwatch}" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <TopPanel DockPanel.Dock="Top" Grid.Row="0" Panel.ZIndex="1" />

                        <DockPanel Grid.Row="1">
                            <FilterPanel x:Name="PART_FilterPanel"
                                         DockPanel.Dock="{Settings FilterPanelPosition}"
                                         Width="{Settings FilterPanelWitdh}"
                                         Visibility="{Settings FilterPanelVisible}" />

                            <ExplorerPanel Visibility="{Settings ExplorerPanelVisible}"
                                           DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}" />

                            <Grid DockPanel.Dock="Left">
                                <LibraryDetailsView x:Name="PART_ViewDetails" />
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
