<!--
    Cloudbank: dialog windows (Settings, game editor, add-ons). A 36px title band on the pause-menu black, closed by a
    1px trace rule, with the title as a section header: 4x14 aqua marker bar, heading font, white. The rule's left third is charged like the Turn() bar. Caption buttons are
    the 40x32 WindowBarButton glyphs, so the caption and the content offset are 36 (Default: 25).
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="36" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Border Height="36" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}"
                                        BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel LastChildFill="False">
                                        <Rectangle DockPanel.Dock="Left" Width="4" Height="14" Margin="14,0,0,0" VerticalAlignment="Center"
                                                   Fill="{DynamicResource GlyphBrush}" />
                                        <TextBlock Text="{TemplateBinding Title}" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                   Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,1,1,0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- Charged left third of the band's rule: bloom (GlowLineTemplate) and a lit 1px line, fading out. -->
                                <Grid VerticalAlignment="Top" Height="49" Margin="0,11,0,0" IsHitTestVisible="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30*" />
                                        <ColumnDefinition Width="70*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Black" Offset="0" />
                                            <GradientStop Color="Black" Offset="0.18" />
                                            <GradientStop Color="Transparent" Offset="0.3" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <Control Grid.ColumnSpan="2" Template="{DynamicResource GlowLineTemplate}" Foreground="{DynamicResource GlyphBrush}"
                                             Height="48" VerticalAlignment="Center" Opacity="0.45" />
                                    <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Center" Fill="{DynamicResource GlyphBrush}" />
                                </Grid>
                                <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                <ContentPresenter Margin="0,36,0,0" />
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
