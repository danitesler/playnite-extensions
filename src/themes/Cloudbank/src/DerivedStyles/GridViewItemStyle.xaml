<!--
    Cloudbank: cover tiles. Selected = the game's selected-function look, static: a cyan bloom behind the cover
    (GlowFrameTemplate), a 1px cyan outline and cyan corner brackets 4px outside it (CornerMarksTemplate).
    Hover = a "target lock", animated both ways (no setters on animated parts, so nothing snaps):
      in  0.2s ease-out: cyan brackets close in from 8% outside the cover while fading in, the 1px mint outline and a
          mint bloom fade in; while hovered the bloom breathes (1 to 0.55, 1.4s each way).
      out 0.25s: everything fades away; exit animations use FillBehavior Stop so no clock outlives the fade.
    Everything is drawn inside the item's own spacing margin so the panel does not clip it. Library art behind the grid
    has no OpacityMask (reference.md -> masked art behind animated controls). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}" Margin="{Settings ItemSpacingMargin}" x:Name="ItemGrid">
                        <!-- Selected: static -->
                        <Control x:Name="SelectGlow" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource SelectedBorderBrush}"
                                 Margin="-32" Opacity="0.85" Visibility="Collapsed" />
                        <!-- Hover: animated -->
                        <Grid x:Name="Pulse" Margin="-32" IsHitTestVisible="False">
                            <Control x:Name="HoverGlow" Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource GridViewItemHoverBorderBrush}"
                                     Opacity="0" Visibility="Hidden" />
                        </Grid>
                        <ContentPresenter />
                        <Border x:Name="SelectionBorder" BorderThickness="1" Margin="-2" IsHitTestVisible="False" />
                        <Border x:Name="HoverBorder" BorderThickness="1" Margin="-2" IsHitTestVisible="False" Opacity="0"
                                BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" />
                        <Control x:Name="Marks" Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource SelectedBorderBrush}"
                                 Margin="-5" Visibility="Collapsed" />
                        <!-- Running game (Cloudbank, the powered circuit): a 2px orange frame inside the cover edge over a 6px band (the cyan line and brackets sit outside), a dark tape at the foot holding a trace of pips and a node. LAUNCHING: a block of lit cells crosses the cover while the trace fills; the node lights and turns as it lands (1.7s). RUNNING: trace full, node turns slowly, frame breathes (3.2s). -->
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True">
                            <Border x:Name="RunningWash" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="6" Opacity="0.18" />
                            <Grid x:Name="RunningScan" Visibility="Collapsed" Opacity="0.3">
                                <Grid.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,6,8" ViewportUnits="Absolute" Viewbox="0,0,6,8" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#FF000000">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,4,8" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Grid.OpacityMask>
                                <Border Background="{DynamicResource RunningIndicatorBrush}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.23" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.226" />
                                            <GradientStop x:Name="RunningScanTrail" Color="#FF000000" Offset="-0.05" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="-0.046" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />
                            <Grid Height="18" Margin="12,0,12,10" VerticalAlignment="Bottom">
                                <Border Background="{DynamicResource WindowBackgourndBrush}" Opacity="0.85" />
                                <Grid Height="3" Margin="6,0,26,0" VerticalAlignment="Center">
                                    <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3">
                                        <Rectangle.OpacityMask>
                                            <DrawingBrush TileMode="Tile" Viewport="0,0,6,3" ViewportUnits="Absolute" Viewbox="0,0,6,3" ViewboxUnits="Absolute">
                                                <DrawingBrush.Drawing>
                                                    <GeometryDrawing Brush="#FF000000">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,4,3" />
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Grid x:Name="RunningFill">
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF000000" Offset="0" />
                                                <GradientStop x:Name="RunningFillHard" Color="#FF000000" Offset="0" />
                                                <GradientStop x:Name="RunningFillCut" Color="#00000000" Offset="0.001" />
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>
                                        <Rectangle Fill="{DynamicResource RunningIndicatorBrush}">
                                            <Rectangle.OpacityMask>
                                                <DrawingBrush TileMode="Tile" Viewport="0,0,6,3" ViewportUnits="Absolute" Viewbox="0,0,6,3" ViewboxUnits="Absolute">
                                                    <DrawingBrush.Drawing>
                                                        <GeometryDrawing Brush="#FF000000">
                                                            <GeometryDrawing.Geometry>
                                                                <RectangleGeometry Rect="0,0,4,3" />
                                                            </GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Grid>
                                </Grid>
                                <Grid x:Name="RunningMark" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform x:Name="RunningHexTurn" Angle="0" />
                                    </Grid.RenderTransform>
                                    <Polygon Points="12,5.2 9,10.4 3,10.4 0,5.2 3,0 9,0" VerticalAlignment="Center" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="1.5" />
                                    <Ellipse Width="3" Height="3" Fill="{DynamicResource RunningIndicatorBrush}" />
                                </Grid>
                            </Grid>
                        </Grid>
                        <Control x:Name="HoverMarks" Template="{DynamicResource CornerMarksTemplate}" Foreground="{DynamicResource SelectedBorderBrush}"
                                 Margin="-5" Opacity="0" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
                            <Control.RenderTransform>
                                <ScaleTransform x:Name="HoverMarksScale" ScaleX="1" ScaleY="1" />
                            </Control.RenderTransform>
                        </Control>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="HoverMarksScale" Storyboard.TargetProperty="ScaleX" From="1.08" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverMarksScale" Storyboard.TargetProperty="ScaleY" From="1.08" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True" BeginTime="0:0:0.2">
                                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From="1" To="0.55" Duration="0:0:1.4">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames FillBehavior="Stop" Storyboard.TargetName="HoverMarks" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{x:Static Visibility.Hidden}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GridViewItemSelectedBorderBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Marks" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectGlow" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.23" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.06" KeySpline="0,0 1,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.06" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.226" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.064" KeySpline="0,0 1,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.064" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTrail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.05" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.24" KeySpline="0,0 1,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.24" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.046" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.244" KeySpline="0,0 1,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.244" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillHard" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0,0 1,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillCut" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.001" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.001" KeySpline="0,0 1,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.001" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" KeySpline="0.4,0 0.6,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.35" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningHexTurn" Storyboard.TargetProperty="Angle" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="120" KeySpline="0.2,0.8 0.2,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.7" KeySpline="0.4,0 0.6,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningHexTurn" Storyboard.TargetProperty="Angle" Duration="0:0:3.2">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="60" KeySpline="0,0 1,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillHard" Storyboard.TargetProperty="Offset" Duration="0:0:0.45">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1" KeySpline="0.2,0 0,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillCut" Storyboard.TargetProperty="Offset" Duration="0:0:0.45">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.001" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1.001" KeySpline="0.2,0 0,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
