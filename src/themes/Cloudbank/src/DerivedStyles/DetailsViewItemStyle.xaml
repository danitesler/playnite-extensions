<!--
    Cloudbank: game list rows (details view). Installed games in white, the rest in body grey (Default's rule). Hover
    lifts the row to the panel fill; the selected row takes the glow fill, white text and a 2px aqua bar on its left,
    the bar the game puts before a section header, with its light bleeding 22px into the row. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid>
                    <Grid>
                        <Border x:Name="HoverRectangle" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0" Background="{DynamicResource ListItemHoverBrush}" />
                        <Border x:Name="SelectedRectangle" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0"
                                Background="{DynamicResource SelectedBrush}" BorderThickness="2,0,0,0" BorderBrush="{DynamicResource GlyphBrush}" />
                        <Rectangle x:Name="BarGlow" Width="22" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="BarGlowScale" ScaleX="0" />
                            </Rectangle.RenderTransform>
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#55000000" Offset="0" />
                                    <GradientStop Color="#18000000" Offset="0.45" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <!-- Running game (Cloudbank, the powered circuit): the Function orange as a trace into a node. LAUNCHING: a block of lit cells (RunningScan, the memory pips) crosses the row at a steady pace while a trace of pips fills behind it; as it lands the node (an upgrade-slot hexagon) lights and turns (1.7s loop, 0.5s rest). RUNNING: the trace stays full, the node turns slowly and the layer breathes 0.72 to 1 (3.2s). -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False" SnapsToDevicePixels="True" Tag="{DynamicResource RunningIndicatorBrush}">
                            <Border x:Name="RunningWash" Background="{Binding Tag, ElementName=RunningIndicator}" Opacity="0.16" />
                            <Border x:Name="RunningMarkPlate" Visibility="Visible" Width="35" HorizontalAlignment="Right" Margin="2" Background="{Binding Tag, ElementName=RunningIndicator}" Opacity="0.34">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Grid x:Name="RunningScan" Visibility="Collapsed" Opacity="0.4">
                                <Grid.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,6,8" ViewportUnits="Absolute" Viewbox="0,0,6,8" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#FF000000">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,4,8" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Grid.OpacityMask>
                                <Border Background="{Binding Tag, ElementName=RunningIndicator}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.23" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="-0.226" />
                                            <GradientStop x:Name="RunningScanTrail" Color="#FF000000" Offset="-0.05" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="-0.046" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                            <Grid Height="3" Margin="6,0,30,3" VerticalAlignment="Bottom">
                                <Rectangle Fill="{Binding Tag, ElementName=RunningIndicator}" Opacity="0.3">
                                    <Rectangle.OpacityMask>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,6,3" ViewportUnits="Absolute" Viewbox="0,0,6,3" ViewboxUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="#FF000000">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,4,3" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Grid x:Name="RunningFill">
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningFillHard" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningFillCut" Color="#00000000" Offset="0.001" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <Rectangle Fill="{Binding Tag, ElementName=RunningIndicator}">
                                        <Rectangle.OpacityMask>
                                            <DrawingBrush TileMode="Tile" Viewport="0,0,6,3" ViewportUnits="Absolute" Viewbox="0,0,6,3" ViewboxUnits="Absolute">
                                                <DrawingBrush.Drawing>
                                                    <GeometryDrawing Brush="#FF000000">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,4,3" />
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2">
                                <Border BorderBrush="{DynamicResource TextBrushDark}" BorderThickness="1" Opacity="0.7" />
                            </Border>
                            <Grid x:Name="RunningMark" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="RunningHexTurn" Angle="0" />
                                </Grid.RenderTransform>
                                <Polygon Points="12,5.2 9,10.4 3,10.4 0,5.2 3,0 9,0" VerticalAlignment="Center" Stroke="{Binding Tag, ElementName=RunningIndicator}" StrokeThickness="1.5" />
                                <Ellipse Width="3" Height="3" Fill="{Binding Tag, ElementName=RunningIndicator}" />
                            </Grid>
                        </Grid>
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <Border x:Name="RowRoom">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="RowHoverRoom">
                                        <ContentPresenter>
                                            <ContentPresenter.RenderTransform>
                                                <TranslateTransform x:Name="RowShift" X="0" />
                                            </ContentPresenter.RenderTransform>
                                        </ContentPresenter>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <!-- RowHoverAction: play (installed) or install (not installed) button on the row's right edge, only while the row is hovered; hidden while launching or running. -->
                    <Button x:Name="RowHoverPlay" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCPlayGame}"
                            Command="{MainViewModel StartGameCommand}" CommandParameter="{Binding Game}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                            <Condition Binding="{Binding IsInstalled}" Value="True" />
                                            <Condition Binding="{Binding IsRunning}" Value="False" />
                                            <Condition Binding="{Binding IsLaunching}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <ContentControl Focusable="False" Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" /><Setter TargetName="Glyph" Property="Width" Value="17" /><Setter TargetName="Glyph" Property="Height" Value="17" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="RowHoverInstall" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCInstallGame}"
                            Command="{MainViewModel InstallGameCommand}" CommandParameter="{Binding Game}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                            <Condition Binding="{Binding IsInstalled}" Value="False" />
                                            <Condition Binding="{Binding IsRunning}" Value="False" />
                                            <Condition Binding="{Binding IsLaunching}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <ContentControl Focusable="False" Content="{DynamicResource IconDownload}" ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Glyph" Property="Opacity" Value="1" /><Setter TargetName="Glyph" Property="Width" Value="17" /><Setter TargetName="Glyph" Property="Height" Value="17" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="RowHoverEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RowShift" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RowHoverEnter" />
                                <BeginStoryboard Name="RowHoverExit">
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="RowShift" Storyboard.TargetProperty="X" From="3" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="RowSelectEnter">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedRectangle" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BarGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedRectangle" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BarGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="BarGlowScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RowSelectEnter" />
                                <BeginStoryboard Name="RowSelectExit">
                                    <Storyboard FillBehavior="Stop">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedRectangle" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BarGlow" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedRectangle" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="BarGlow" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Tag" Value="{DynamicResource LaunchingIndicatorBrush}" />
                            <Setter TargetName="RunningFrame" Property="BorderBrush" Value="{DynamicResource LaunchingIndicatorBrush}" />
        <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.23" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.06" KeySpline="0,0 1,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.06" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.226" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.064" KeySpline="0,0 1,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.064" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTrail" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.05" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.24" KeySpline="0,0 1,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.24" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.046" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.244" KeySpline="0,0 1,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.244" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillHard" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0,0 1,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillCut" Storyboard.TargetProperty="Offset" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.001" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1.001" KeySpline="0,0 1,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="1.001" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0" KeySpline="0.4,0 0.6,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Opacity" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.35" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" KeySpline="0.4,0 0.6,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="0.35" KeySpline="0.4,0 0.6,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningHexTurn" Storyboard.TargetProperty="Angle" Duration="0:0:1.7">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.7" Value="120" KeySpline="0.2,0.8 0.2,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningMark" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.7" KeySpline="0.4,0 0.6,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningHexTurn" Storyboard.TargetProperty="Angle" Duration="0:0:3.2">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="60" KeySpline="0,0 1,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillHard" Storyboard.TargetProperty="Offset" Duration="0:0:0.45">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1" KeySpline="0.2,0 0,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillCut" Storyboard.TargetProperty="Offset" Duration="0:0:0.45">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.001" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1.001" KeySpline="0.2,0 0,1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- RunningMarkRoom left="0" right="35": the running mark owns this strip of the row, so a long name stops before it. -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,35,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,35,0" />
                        </DataTrigger>
                        <!-- RowHoverAction: keep the row text clear of the hover button (26px + 8px margin + gap). -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
