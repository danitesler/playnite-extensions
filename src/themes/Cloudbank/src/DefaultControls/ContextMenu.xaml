<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu, the
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and
    Playnite's multi-select boxes) is Transistor's Functions DETAILS panel (LocalTransistorPanelTemplate, shared by
    ComboBox.xaml, CustomControls/ComboBoxList.xaml and CustomControls/FilterSelectionBox.xaml):
    - Panel: raised teal-void panel (PopupBackgroundBrush) in a 1px lit mint circuit border (FrameBrush), a 1px faint
      inner circuit line 3px inside (FrameInnerBrush), a charged Turn() top light line (GlowLineTemplate) fading right,
      and cyan L corner marks on top-left and bottom-right (SelectedBorderBrush). No DropShadowEffect.
    - Rows, rules and marks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalTransistorPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1" />
            <Border Margin="3" BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1" />
            <!-- Charged Turn() top hairline fading right -->
            <Grid Height="12" Margin="1,1,1,0" VerticalAlignment="Top" ClipToBounds="True">
                <Control Height="24" Margin="0,-11,0,0" VerticalAlignment="Top" Focusable="False" IsTabStop="False"
                         Foreground="{DynamicResource TopPanelRuleStartBrush}"
                         Template="{DynamicResource GlowLineTemplate}">
                    <Control.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FF000000" />
                            <GradientStop Offset="0.65" Color="#88000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush>
                    </Control.OpacityMask>
                </Control>
            </Grid>
            <!-- Diagonal cyan L corner marks (top-left and bottom-right) -->
            <Path Data="M0,9 L0,0 9,0" Stroke="{DynamicResource SelectedBorderBrush}" StrokeThickness="2"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M9,0 L9,9 0,9" Stroke="{DynamicResource SelectedBorderBrush}" StrokeThickness="2"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="228" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalTransistorPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="5,8,5,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
