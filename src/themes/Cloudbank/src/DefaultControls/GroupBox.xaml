<!--
    Cloudbank: GroupBox as a Functions-screen panel: panel fill, 1px dim circuit edge, square corners. Header = the game's
    section header: a 4x14 orange marker bar, the title, then the hairline rule with its circuit stub (DividerTemplate).
    A faint bloom (GlowFrameTemplate at 0.22) lights the edge. Content-sized for the Statistics page: no fixed widths; the rule is a Rectangle (no desired width) plus a 22px stub.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                    <Control Template="{DynamicResource GlowFrameTemplate}" Foreground="{DynamicResource FrameBrush}" Margin="-32" Opacity="0.22" />
                    <Border BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="1"
                            Background="{DynamicResource ExpanderBackgroundBrush}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="{DynamicResource GroupBoxHeaderMargin}">
                                <Rectangle DockPanel.Dock="Left" Width="4" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Fill="{DynamicResource HeadingMarkerBrush}" />
                                <ContentPresenter DockPanel.Dock="Left" ContentSource="Header" VerticalAlignment="Center"
                                                  TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{DynamicResource HeadingForegroundBrush}" />
                                <Control Template="{DynamicResource DividerTemplate}" Foreground="{DynamicResource HeadingRuleBrush}"
                                         Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="30" />
                            </DockPanel>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
