<!--
    Cloudbank: spacing, focus and the shared motifs.
    Spacing follows the game's menus at 1080p scaled to Playnite's 14px base: hint buttons sit on a 6px vertical pad,
    list rows on 6 to 8, panels breathe at 16. Values: ../AGENTS.md -> Component spacing.
    Motifs (../RESEARCH.md -> Chrome and component rules):
      CornerMarksTemplate  the cyan L brackets that mark the selected function tile
      DividerTemplate      the hairline rule that runs on from a section header, ending in a circuit stub
      HeadingTextBlock     section header text
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <Thickness x:Key="ButtonPadding">14,6</Thickness>
    <Thickness x:Key="InputPadding">8,6</Thickness>
    <Thickness x:Key="MenuPadding">0,6</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">16,12,16,16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,10</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">220</sys:Double>

    <!-- Selection brackets: four 2px L marks, arm 8px, drawn in the host's Foreground. No desired size of their own. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,8 L0,0 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L8,0 8,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L0,8 8,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M8,0 L8,8 0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <!--
        Glow sprites (Images/fx, generated by art/sprites.py): white masks colored at runtime, so every glow follows
        the brush the host passes as Foreground (ThemeModifier edits included). No BitmapCache on glow layers: at display scaling above 100% WPF draws a faint dark edge around cached layers.
    -->

    <!-- Panel bloom, the lit circuit edge of the Functions screen: 9-slice of glow-frame.png (128px, host edge at inset
         32, inner falloff to inset 44, so the slices are 44 / 40 / 44 and the empty centre is skipped). The host sits
         at Margin -32 around the element it lights. Grid columns are 44 + star + 44: no wide desired size. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,84,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- The Turn() bar's light: 2px hot core, 10px body, 14px bloom each side (glow-line.png, 48px tall). Host is
         48px tall, centred on the line it lights; it may add its own OpacityMask to fade along the line. -->
    <ControlTemplate x:Key="GlowLineTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-line.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Electric arcs along a line (arc-strip.png, 512x40, tiles horizontally). Host is 40px tall. -->
    <ControlTemplate x:Key="ArcStripTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/arc-strip.png'}" TileMode="Tile" Stretch="Fill"
                            Viewport="0,0,512,40" ViewportUnits="Absolute" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Header rule: 1px line stretched by its column (Rectangle has no desired width), ending in the game's circuit
         flourish (flourish.png, 72x18: a curl, two ticks and a ring node). The flourish's stem sits on the rule's row. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" VerticalAlignment="Center" Height="18" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <Rectangle Height="1" Fill="{TemplateBinding Foreground}" VerticalAlignment="Top" Margin="0,9,0,0" Opacity="0.7" SnapsToDevicePixels="True" />
            <Rectangle Grid.Column="1" Width="72" Height="18" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/flourish.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Keyboard focus: the selection brackets in the focus cyan, 3px outside the control. -->
    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-3" SnapsToDevicePixels="True">
                        <Path Data="M0,7 L0,0 7,0" Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Path Data="M0,0 L7,0 7,7" Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <Path Data="M0,0 L0,7 7,7" Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <Path Data="M7,0 L7,7 0,7" Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
