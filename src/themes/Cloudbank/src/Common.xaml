<!--
    Cloudbank: spacing, focus and the shared motifs.
    Spacing follows the game's menus at 1080p scaled to Playnite's 14px base: hint buttons sit on a 6px vertical pad,
    list rows on 6 to 8, panels breathe at 16. Values: ../AGENTS.md -> Component spacing.
    Motifs (../RESEARCH.md -> Chrome and component rules):
      CornerMarksTemplate  the cyan L brackets that mark the selected function tile
      DividerTemplate      the hairline rule that runs on from a section header, ending in a circuit stub
      HeadingTextBlock     section header text
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
    </Style>

    <Thickness x:Key="ButtonPadding">14,5</Thickness>
    <Thickness x:Key="InputPadding">8,5</Thickness>
    <Thickness x:Key="MenuPadding">0,6</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">0,4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
    <Thickness x:Key="GroupBoxPadding">16,12,16,16</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,10</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="GameBannerHeight">340</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- Selection brackets: four 2px L marks, arm 8px, drawn in the host's Foreground. No desired size of their own. -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Path Data="M0,8 L0,0 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L8,0 8,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L0,8 8,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M8,0 L8,8 0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <!--
        Glow sprites (Images/fx, generated by art/sprites.py): white masks colored at runtime, so every glow follows
        the brush the host passes as Foreground (ThemeModifier edits included). No BitmapCache on glow layers: at display scaling above 100% WPF draws a faint dark edge around cached layers.
    -->

    <!-- Panel bloom, the lit circuit edge of the Functions screen: 9-slice of glow-frame.png (128px, host edge at inset
         32, inner falloff to inset 44, so the slices are 44 / 40 / 44 and the empty centre is skipped). The host sits
         at Margin -32 around the element it lights. Grid columns are 44 + star + 44: no wide desired size. -->
    <ControlTemplate x:Key="GlowFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="0,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="44,84,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-frame.png'}" Viewbox="84,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Lit gold frame: the same 9-slice geometry as GlowFrameTemplate (host at -32) from gilt-frame.png, which adds a
         hot 2px core on the edge and a stronger inner light. Selected function tiles and active controls. -->
    <ControlTemplate x:Key="LocalGiltFrameTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/gilt-frame.png'}" Viewbox="0,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/gilt-frame.png'}" Viewbox="44,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/gilt-frame.png'}" Viewbox="84,0,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/gilt-frame.png'}" Viewbox="0,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/gilt-frame.png'}" Viewbox="84,44,44,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/gilt-frame.png'}" Viewbox="0,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/gilt-frame.png'}" Viewbox="44,84,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/gilt-frame.png'}" Viewbox="84,84,44,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Lit gold corner brackets, the selection marks of a function tile: an L at each corner of the element it
         frames plus a short tick along each arm. Host sits at Margin -4 around the element; Foreground colors it. -->
    <ControlTemplate x:Key="LocalGiltBracketsTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Path Data="M0,9 L0,0 9,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Flat" HorizontalAlignment="Left" VerticalAlignment="Top" Width="9" Height="9" />
            <Path Data="M0,0 L9,0 9,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="9" Height="9" />
            <Path Data="M0,0 L0,9 9,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="9" Height="9" />
            <Path Data="M9,0 L9,9 0,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="9" Height="9" />
        </Grid>
    </ControlTemplate>

    <!-- Same brackets, the two upper corners in Foreground and the two lower ones in Tag (a gold to mint fade). -->
    <ControlTemplate x:Key="LocalGiltBracketsFadeTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Path Data="M0,9 L0,0 9,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Flat" HorizontalAlignment="Left" VerticalAlignment="Top" Width="9" Height="9" />
            <Path Data="M0,0 L9,0 9,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="9" Height="9" />
            <Path Data="M0,0 L0,9 9,9" Stroke="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="9" Height="9" />
            <Path Data="M9,0 L9,9 0,9" Stroke="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="9" Height="9" />
        </Grid>
    </ControlTemplate>

    <!-- The Turn() bar's light: 2px hot core, 10px body, 14px bloom each side (glow-line.png, 48px tall). Host is
         48px tall, centred on the line it lights; it may add its own OpacityMask to fade along the line. -->
    <ControlTemplate x:Key="GlowLineTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow-line.png'}" Stretch="Fill" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Electric arcs along a line (arc-strip.png, 512x40, tiles horizontally). Host is 40px tall. -->
    <ControlTemplate x:Key="ArcStripTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{ThemeFile 'Images/fx/arc-strip.png'}" TileMode="Tile" Stretch="Fill"
                            Viewport="0,0,512,40" ViewportUnits="Absolute" />
            </Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- Header rule: 1px line stretched by its column (Rectangle has no desired width), ending in the game's circuit
         flourish (flourish.png, 72x18: a curl, two ticks and a ring node). The flourish's stem sits on the rule's row. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" VerticalAlignment="Center" Height="18" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <Rectangle Height="1" Fill="{TemplateBinding Foreground}" VerticalAlignment="Top" Margin="0,9,0,0" Opacity="0.7" SnapsToDevicePixels="True" />
            <Rectangle Grid.Column="1" Width="72" Height="18" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{ThemeFile 'Images/fx/flourish.png'}" Stretch="Fill" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): an upgrade-slot hexagon holding three rows of memory pips
         (2-3-2, the theme's 4px lit / 2px gap cells), the menu glyph made out of the game's own parts. Host = the whole button
         (44x52 in the rail, 32x32 in the top bar); the mark is a fixed 28x28 in its middle, with its gilt halo behind it.
         Hover (IsMouseOver): an aqua outline traces itself around the slot (dash offset 52 to 0 = the 78px perimeter in 1.5px
         strokes, 0.32s, no opacity animation: a faded path leaves a faint box at its bounds) and the pip rows light aqua one
         after another; leaving retracts the outline and fades the rows (FillBehavior Stop).
         Open (the menu's ContextMenu.IsOpen on the nearest Border, which is PART_ElemMainMenu): the slot turns 60 degrees and
         lights hot gold, the pip rows slide into the middle and go out, a diamond node with a ring ignites there, and the
         halo and node breathe until the menu closes. Hover and open never animate the same element or property, so they
         layer without fighting; each exit storyboard covers everything its enter storyboard animates. -->
    <ControlTemplate x:Key="LocalMainMenuMarkTemplate" TargetType="Control">
        <ControlTemplate.Resources>
            <!-- halo.png's falloff (alpha 1 / .82 / .45 / .17 / 0 at 0 / 25 / 50 / 75 / 100% of the radius) as a gradient: a sprite mask
                 re-rendered for the repaint patch of an animated neighbour leaves a faint box at the patch bounds. -->
            <RadialGradientBrush x:Key="LocalMenuHaloMask" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#FF000000" Offset="0" />
                <GradientStop Color="#D1000000" Offset="0.25" />
                <GradientStop Color="#73000000" Offset="0.5" />
                <GradientStop Color="#2B000000" Offset="0.75" />
                <GradientStop Color="#00000000" Offset="1" />
            </RadialGradientBrush>
        </ControlTemplate.Resources>
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Rectangle x:Name="Halo" Fill="{DynamicResource GiltBrush}" Opacity="0.3" OpacityMask="{StaticResource LocalMenuHaloMask}" IsHitTestVisible="False" />
            <Rectangle x:Name="HaloOpen" Fill="{DynamicResource GiltBrush}" Opacity="0" OpacityMask="{StaticResource LocalMenuHaloMask}" IsHitTestVisible="False" />
            <Grid Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas x:Name="HexLayer" Width="28" Height="28" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><RotateTransform x:Name="HexTurn" Angle="0" /></Canvas.RenderTransform>
                    <Path x:Name="Hex" Data="M7.5,2.75 L20.5,2.75 27,14 20.5,25.25 7.5,25.25 1,14Z" Stroke="{DynamicResource GiltBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" />
                    <Path x:Name="HexHot" Data="M7.5,2.75 L20.5,2.75 27,14 20.5,25.25 7.5,25.25 1,14Z" Stroke="{DynamicResource GiltHotBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" Opacity="0" />
                    <Path x:Name="Trace" Data="M7.5,2.75 L20.5,2.75 27,14 20.5,25.25 7.5,25.25 1,14Z" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter"
                          StrokeDashArray="52 52" StrokeDashOffset="52" />
                </Canvas>
                <Canvas x:Name="BarTop" Width="28" Height="28">
                    <Canvas.RenderTransform><TranslateTransform x:Name="BarTopMove" Y="0" /></Canvas.RenderTransform>
                    <Path Data="M9,9 L19,9" Stroke="{DynamicResource GiltHotBrush}" StrokeThickness="2" StrokeDashArray="2 1" StrokeDashCap="Flat" />
                    <Path x:Name="LitTop" Data="M9,9 L19,9" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="2" StrokeDashArray="2 1" StrokeDashCap="Flat" Opacity="0" />
                </Canvas>
                <Canvas x:Name="BarMid" Width="28" Height="28" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform x:Name="BarMidScale" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                    <Path Data="M6,14 L22,14" Stroke="{DynamicResource GiltHotBrush}" StrokeThickness="2" StrokeDashArray="2 1" StrokeDashCap="Flat" />
                    <Path x:Name="LitMid" Data="M6,14 L22,14" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="2" StrokeDashArray="2 1" StrokeDashCap="Flat" Opacity="0" />
                </Canvas>
                <Canvas x:Name="BarBot" Width="28" Height="28">
                    <Canvas.RenderTransform><TranslateTransform x:Name="BarBotMove" Y="0" /></Canvas.RenderTransform>
                    <Path Data="M9,19 L19,19" Stroke="{DynamicResource GiltHotBrush}" StrokeThickness="2" StrokeDashArray="2 1" StrokeDashCap="Flat" />
                    <Path x:Name="LitBot" Data="M9,19 L19,19" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="2" StrokeDashArray="2 1" StrokeDashCap="Flat" Opacity="0" />
                </Canvas>
                <Canvas Width="28" Height="28">
                    <Rectangle x:Name="NodeRing" Canvas.Left="8.5" Canvas.Top="8.5" Width="11" Height="11" Stroke="{DynamicResource GiltBrush}" StrokeThickness="1"
                               RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="RingScale" ScaleX="0.2" ScaleY="0.2" />
                                <RotateTransform Angle="45" />
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Node" Canvas.Left="11" Canvas.Top="11" Width="6" Height="6" Fill="{DynamicResource GiltHotBrush}"
                               RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="NodeScale" ScaleX="0.2" ScaleY="0.2" />
                                <RotateTransform Angle="45" />
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Trace" Storyboard.TargetProperty="StrokeDashOffset" From="52" To="0" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LitTop" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.06" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="LitMid" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.13" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="LitBot" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.2" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Trace" Storyboard.TargetProperty="StrokeDashOffset" To="52" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LitTop" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LitMid" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LitBot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HexTurn" Storyboard.TargetProperty="Angle" To="60" Duration="0:0:0.45"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HexHot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="BarTopMove" Storyboard.TargetProperty="Y" To="5" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BarBotMove" Storyboard.TargetProperty="Y" To="-5" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BarMidScale" Storyboard.TargetProperty="ScaleX" To="0.4" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="BarTop" Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.08" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="BarMid" Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.08" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="BarBot" Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.08" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="Node" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.16" Duration="0:0:0.08" />
                            <DoubleAnimation Storyboard.TargetName="NodeScale" Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.16" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NodeScale" Storyboard.TargetProperty="ScaleY" To="1" BeginTime="0:0:0.16" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NodeRing" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.22" Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" To="1" BeginTime="0:0:0.22" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" To="1" BeginTime="0:0:0.22" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HaloOpen" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.3" />
                            <DoubleAnimation Storyboard.TargetName="HaloOpen" Storyboard.TargetProperty="Opacity" From="0.45" To="0.75" BeginTime="0:0:0.3" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NodeScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.14" BeginTime="0:0:0.5" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NodeScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.14" BeginTime="0:0:0.5" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HexTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HexHot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BarTopMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.25" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BarBotMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.25" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BarMidScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BarTop" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BarMid" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BarBot" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Node" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="NodeScale" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="NodeScale" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="NodeRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX" To="0.2" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.2" />
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HaloOpen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Keyboard focus: the selection brackets in the focus cyan, 3px outside the control. -->
    <Style x:Key="FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-3" SnapsToDevicePixels="True">
                        <Path Data="M0,7 L0,0 7,0" Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Path Data="M0,0 L7,0 7,7" Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <Path Data="M0,0 L0,7 7,7" Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <Path Data="M7,0 L7,7 0,7" Stroke="{DynamicResource FocusBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
