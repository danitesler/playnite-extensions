<!--
    Cloudbank: SearchBox as a sunken Turn() cell. Cell fill, 1px frame line, body-grey magnifier on the left and clear
    glyph on the right; hover lights the edge mint, typing lights it aqua. Keeps PART_SeachIcon, PART_TextInpuText and
    PART_ClearTextIcon. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Border x:Name="Field" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <ContentControl x:Name="PART_SeachIcon" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{DynamicResource TextBrushDarker}" Margin="9,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox MinHeight="0" x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                     Padding="32,0,28,0" VerticalContentAlignment="Center" />
                            <ContentControl x:Name="PART_ClearTextIcon" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,8,0" Cursor="Hand"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="PART_SeachIcon" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
