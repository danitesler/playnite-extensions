<!--
    CS 1.6: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    The look is Counter-Strike 1.6's VGUI in two tones, as the game shipped it: olive Steam / GoldSrc frames and
    bevelled controls (shell, buttons, title bands, scroll bars) around black panels with amber text (lists, game page,
    inputs). Corners are square everywhere; edges are 1px bevels (lit top and left, dark bottom and right).
    Playnite palette: TextColor is the scheme's amber BaseText, TextColorDarker its DimBaseText, GlyphColor the
    accent (amber), TextColorDark the ink on amber fills (black). MainColor is a control body (olive), MainColorDark a
    black panel. Brushes only in controls; ThemeModifier edits the palette and the shared brushes below.

    Placeholder syntax: .claude/skills/playnite-theme-dev/reference.md. Keep double braces out of comments here: the build renders
    them too.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys): Verdana, the face the scheme files name, at VGUI sizes. -->
    <sys:Double x:Key="FontSizeSmall">{{px:font-size-small}}</sys:Double>
    <sys:Double x:Key="FontSize">{{px:font-size}}</sys:Double>
    <sys:Double x:Key="FontSizeLarge">{{px:font-size-large}}</sys:Double>
    <sys:Double x:Key="FontSizeLarger">{{px:font-size-larger}}</sys:Double>
    <sys:Double x:Key="FontSizeLargest">{{px:font-size-largest}}</sys:Double>
    <FontFamily x:Key="FontFamily">{{text:font-body|Verdana}}</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">{{text:font-body|Verdana}}</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">{{text:font-mono|Consolas}}</FontFamily>

    <!-- Shape (Playnite keys): square corners and 1px edges. The whole radius scale is zero, so no style can turn a non-square control into an oval. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:cs-radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <CornerRadius x:Key="CornerRadiusSmall">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">0</CornerRadius>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{cs-base-text}}</Color>                  <!-- default text -->
    <Color x:Key="TextColorDarker">{{cs-dim-text}}</Color>            <!-- secondary / muted text -->
    <Color x:Key="TextColorDark">{{cs-void}}</Color>              <!-- text on GlyphColor fills (selected rows, play button) -->
    <Color x:Key="MainColor">{{steam-olive}}</Color>                  <!-- control fill -->
    <Color x:Key="MainColorDark">{{cs-window-bg}}</Color>              <!-- raised surface (panels, cards) -->
    <Color x:Key="HoverColor">{{steam-olive-hover}}</Color>                 <!-- hover fill -->
    <Color x:Key="GlyphColor">{{cs-base-text}}</Color>                 <!-- accent: selection, checked, links -->
    <Color x:Key="HighlightGlyphColor">{{cs-dim-list-text}}</Color>        <!-- accent at partial strength -->
    <Color x:Key="PopupBackgroundColor">{{cs-window-bg}}</Color>       <!-- menus, popovers, dropdowns -->
    <Color x:Key="PopupBorderColor">{{steam-olive-light}}</Color>           <!-- popup edge; flatten translucent strokes onto the popup (@surface) -->
    <Color x:Key="BackgroundToneColor">{{cs-list-bg}}</Color>        <!-- tinted areas in Playnite's views -->
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>   <!-- frame around covers; transparent = no frame -->
    <Color x:Key="PanelSeparatorColor">#00000000</Color>       <!-- lines between library panels -->
    <Color x:Key="WindowPanelSeparatorColor">{{cs-border-soft}}</Color>  <!-- dividers and card edges -->
    <Color x:Key="DataChangeNotifColor">{{cs-title-text}}</Color>       <!-- "data changed" warning text -->

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{steam-olive-light}}" />       <!-- control edge -->
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{steam-olive-deep}}" />  <!-- tooltip fill -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{steam-olive}}" />   <!-- button fill -->
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{cs-list-bg}}" /> <!-- unchecked check box and radio fill -->
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{steam-light-green}}" />     <!-- success -->
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{cs-team-t}}" />     <!-- danger -->
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{cs-title-text}}" />        <!-- warning -->

    <SolidColorBrush x:Key="WarningBrush" Color="{{cs-title-text}}" />            <!-- warnings, errors, the update icon -->

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{cs-control-dark}}" /> <!-- cards: group boxes and expanders -->
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{cs-window-bg}}" />   <!-- window background (Playnite's spelling) -->

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->
    <!-- Shell: olive Steam frame (rail darker than the top bar), black content layer -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{steam-olive-dark}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{steam-olive}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{cs-window-bg}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{cs-list-bg}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{cs-list-bg}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{steam-olive}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{cs-base-text}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{steam-olive-deep}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{cs-void}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{cs-window-bg}}" />
    <!-- States: SelectionBG, the white 39 percent bar of the buy menu, with bright text -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{cs-selection}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{cs-bright-text}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{cs-selection-soft}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{cs-selection}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{cs-selection}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{cs-base-text}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{cs-team-t}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{cs-bright-text}}" />
    <!-- Buttons: olive bevelled body with pale olive text; the Play button is amber with black ink -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{steam-olive-text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{steam-olive-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{steam-olive-dark}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{steam-olive-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{cs-base-text}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{cs-void}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{cs-amber-bright}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{cs-dim-list-text}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{cs-void}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{steam-olive-dark}}" />
    <!-- Inputs: black inset (ListBG) with a lit olive edge -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{cs-list-bg}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{steam-olive-light}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{cs-border-bright}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{steam-olive-light}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{cs-border-bright}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{cs-slider-track}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{steam-olive}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{cs-amber-bright}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{cs-hud}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{cs-slider-track}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{steam-olive}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{steam-olive-hover}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{cs-control-dark}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{steam-olive}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{steam-olive-hover}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{cs-base-text}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{cs-dim-list-text}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{cs-control-dark}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{cs-base-text}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{cs-bright-text}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{steam-olive-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{steam-olive-deep}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{steam-olive-text}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{cs-base-text}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{steam-olive-deep}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{steam-olive-text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{steam-olive}}" />
    <!-- Popups and windows: olive title band as in the Steam skin -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{cs-border-soft}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{steam-olive-text}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{steam-olive-light}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{steam-olive}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{cs-bright-text}}" />
    <!-- Frames: the VGUI bevel -->
    <SolidColorBrush x:Key="BevelLightBrush" Color="{{steam-olive-light}}" />
    <SolidColorBrush x:Key="BevelShadowBrush" Color="{{steam-olive-deep}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{cs-border-soft}}" />
    <!-- Headings: the Steam skin's gold -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{steam-olive-gold}}" />
</ResourceDictionary>
