<!--
    Overlay on Playnite Default/Common.xaml. Spacing and focus of Counter-Strike 1.6's VGUI (ClientScheme.res and the
    Steam / GoldSrc olive skin): Verdana 12px labels, buttons about 24px tall with the label 14px in from the edge,
    1px bevels (lit top and left, dark bottom and right), square corners, dotted keyboard focus.
    Playnite lays most controls out by padding, so each control key turns the VGUI control height into padding around
    12px text (about 15px tall): 24 = 15 + 2 x 4.5.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menus, dropdowns and popovers: the translucent black menu (WindowBG) with a lit olive 1px edge, square. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Keyboard focus is the classic dotted rectangle (VGUI ButtonFocusBorder), drawn 3px outside the control. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="3" SnapsToDevicePixels="True" Stroke="{DynamicResource FocusBrush}"
                               StrokeThickness="1" StrokeDashArray="1 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Raised plate (VGUI TitleButtonBorder): the host's Background with 1px lit edges on top and left and 1px dark
         edges on the bottom and right. Host: a Control stretched behind the content, hit testing off. -->
    <ControlTemplate x:Key="BevelTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Left" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelShadowBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BevelShadowBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Sunken plate (VGUI BaseBorder): dark edges on top and left, lit edges on the bottom and right. Used for
         inputs, lists and pressed buttons. Same host contract as BevelTemplate. -->
    <ControlTemplate x:Key="BevelInsetTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BevelShadowBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Left" Fill="{DynamicResource BevelShadowBrush}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BevelLightBrush}" />
            <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource BevelLightBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Section caption: the Steam skin's gold, bold Verdana (DialogTitle font). -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
    </Style>

    <!-- Button: 24px tall (15px text + 2 x 4.5), label 14 in -->
    <Thickness x:Key="ButtonPadding">14,4.5</Thickness>
    <!-- Text box, password box, dropdown: 22px tall field, label 6 in -->
    <Thickness x:Key="InputPadding">6,3.5</Thickness>
    <!-- Menu: 2px around rows 22px tall (the buy menu rows) -->
    <Thickness x:Key="MenuPadding">2</Thickness>
    <Thickness x:Key="MenuItemPadding">8,3.5,14,3.5</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">2</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">6,3.5,10,3.5</Thickness>
    <!-- List box row: 22px, 8 in -->
    <Thickness x:Key="ListBoxItemPadding">8,3.5</Thickness>
    <!-- Group box: etched 1px frame with the gold title cut into it -->
    <Thickness x:Key="GroupBoxPadding">10,8,10,10</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,6</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">12</sys:Double>
    <!-- Tooltip: olive panel, 8 / 4 -->
    <Thickness x:Key="TooltipPadding">8,4</Thickness>
    <!-- Glyphs at 16px, the compact rail's size -->
    <sys:Double x:Key="IconSize">16</sys:Double>

    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">340</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">280</sys:Double>
</ResourceDictionary>
