<!--
    CS 1.6: SearchBox. A sunken black field (BevelInsetTemplate over InputBackgroundBrush) with a dim search glyph on
    the left and a clear glyph on the right. The text is the chrome-less BareTextBox (amber). A 1px edge over the bevel
    marks hover (InputHoverBorderBrush) and keyboard focus (FocusBrush, on IsKeyboardFocusWithin). Square corners.
    Keeps PART_SeachIcon, PART_TextInpuText and PART_ClearTextIcon.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Control x:Name="Plate" Template="{DynamicResource BevelInsetTemplate}"
                                 Background="{TemplateBinding Background}"
                                 IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
                        <Border x:Name="Edge" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False" />
                        <ContentControl x:Name="PART_SeachIcon"
                                        ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0"
                                        Foreground="{DynamicResource TextBrushDarker}" />
                        <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource BareTextBox}"
                                 VerticalContentAlignment="Center" Padding="26,0,24,0" />
                        <ContentControl x:Name="PART_ClearTextIcon"
                                        ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                        FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"
                                        Foreground="{DynamicResource TextBrushDarker}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
