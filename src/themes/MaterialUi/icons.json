{
    "_comment": "Menu icons this theme ships, rendered by scripts/render-icons.ps1 -Extension materialui. Material Icons, filled (@material-design-icons/svg 0.14.15), white like MUI's ListItemIcon (error.main for exit and remove). Media.xaml maps Playnite's *Icon keys to these files.",
    "jobs": [
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/@material-design-icons/svg@0.14.15/filled/{name}.svg",
            "format": "Png",
            "outDir": "src/Images/Material",
            "size": 48,
            "color": "#ffffff",
            "icons": [
                "fullscreen",
                "add",
                "sync",
                "info",
                "settings",
                "extension",
                "play_arrow",
                "file_download",
                "link",
                "folder",
                "storage",
                "shortcut",
                "star_border",
                "star",
                "visibility_off",
                "visibility",
                "hdr_on",
                "edit",
                "casino",
                "menu_book",
                "archive",
                "history"
            ]
        },
        {
            "urlTemplate": "https://cdn.jsdelivr.net/npm/@material-design-icons/svg@0.14.15/filled/{name}.svg",
            "format": "Png",
            "outDir": "src/Images/Material",
            "size": 48,
            "color": "#f44336",
            "suffix": "-danger",
            "icons": [
                "logout",
                "delete"
            ]
        }
    ]
}