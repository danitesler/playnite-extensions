<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml (details mode, right pane).
    Material Design's media detail page (Google Play's app page, in MUI parts). Hero: the background art, 360px,
    under a scrim that fades into background.default; hidden when there is no art. The content column (max 1100px,
    24px gutters) starts 200px down so the header overlaps the hero: the cover (Playnite's cover height setting) and,
    beside it, the title as Typography h4 (regular weight), then the actions: contained Play (or Install), text
    Button More, IconButton Edit (40px circle, 24px icon, action hover).
    Below, two Cards (GroupBox: Paper elevation 1): Description (and a Notes card) on the left; on the right a 380px
    Details card that holds every metadata field Playnite can show: a dense List of two-column rows (label in
    text.secondary, 120px, the value beside it) in six groups split by a Divider: progress (completion status, time
    played, last played, recent activity, added), scores, about (developers, publishers, release date, series, age
    rating, region), tags (platforms, genres, categories, features, tags, as small filled Chips), library (library,
    source, version, install size, install folder) and links. A group whose fields are all hidden takes no space, and
    neither does its Divider.
    Parts left out are skipped by Playnite.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <ScrollViewer x:Name="PART_ScrollViewHost"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>

                            <!-- Hero: background art under a scrim that fades into background.default -->
                            <Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Fill="{DynamicResource WindowBackgourndBrush}">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#33000000" Offset="0" />
                                            <GradientStop Color="#99000000" Offset="0.55" />
                                            <GradientStop Color="#FF000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>

                            <StackPanel MaxWidth="1100" VerticalAlignment="Top">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Margin" Value="24,200,24,32" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                <Setter Property="Margin" Value="24,24,24,32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Header: cover card, then title (h4) and actions -->
                                <DockPanel>
                                    <Image x:Name="PART_ImageCover" DockPanel.Dock="Left" Margin="0,0,24,0" VerticalAlignment="Bottom"
                                           Height="{Settings GameDetailsCoverHeight}" Stretch="Uniform" StretchDirection="Both"
                                           RenderOptions.BitmapScalingMode="Fant" />
                                    <StackPanel VerticalAlignment="Bottom">
                                        <DockPanel>
                                            <Image x:Name="PART_ImageIcon" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock x:Name="PART_TextDisplayName" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeLargest}"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Grid>
                                                <Button x:Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                <Button x:Name="PART_ButtonContextAction" Style="{DynamicResource PlayButton}" />
                                            </Grid>
                                            <Button x:Name="PART_ButtonMoreActions" Content="{DynamicResource LOCMoreAction}"
                                                    Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <Button x:Name="PART_ButtonEditGame" Width="40" Height="40" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource CornerRadiusFull}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <ContentPresenter Width="24" Height="24"
                                                                  Content="{DynamicResource IconEdit}"
                                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Cards: Description (and notes), and Details (every metadata field) -->
                                <Grid Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="240" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=False}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <!-- The plugin hides its control and clears IsControlVisible on every game change, then needs about a second before the screenshots are in. Show the section (skeleton) for Steam library games in that gap; give up after 12s so a game without screenshots does not keep an empty block. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=False}" Value="False" />
                                                                <Condition Binding="{Binding Game.PluginId}" Value="cb91dfc9-b977-43bf-8e70-55f46e410fab" />
                                                            </MultiDataTrigger.Conditions>
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="SteamScreenshotsLoading">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:12">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:12" Value="{x:Static Visibility.Collapsed}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="SteamScreenshotsLoading" />
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <GroupBox Header="{DynamicResource LOC_SteamScreenshots_SteamScreenshotsLabel}">
                                                <Grid>
                                                    <ContentControl x:Name="SteamScreenshots_SteamScreenshotsViewControl" />
                                                    <Control Template="{DynamicResource SteamScreenshotsSkeletonTemplate}" Foreground="{DynamicResource TextBrushDarker}" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                                        <Control.Style>
                                                            <Style TargetType="Control">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=SteamScreenshots, Path=IsControlVisible, FallbackValue=False}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Control.Style>
                                                    </Control>
                                                </Grid>
                                            </GroupBox>
                                        </Grid>
                                        <GroupBox x:Name="PART_ElemDescription" Margin="0,16,0,0" Header="{DynamicResource LOCGameDescriptionTitle}">
                                            <HtmlTextView x:Name="PART_HtmlDescription"
                                                          TextElement.Foreground="{DynamicResource TextBrush}"
                                                          Tag="{DynamicResource GlyphBrush}"
                                                          HtmlFontSize="{DynamicResource FontSize}"
                                                          HtmlFontFamily="{DynamicResource FontFamily}"
                                                          HtmlForeground="{Binding (TextElement.Foreground).Color, RelativeSource={RelativeSource Self}}"
                                                          LinkForeground="{Binding Tag.Color, RelativeSource={RelativeSource Self}}"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          pbeh:FocusBahaviors.BlockBringIntoViewRequest="True" />
                                        </GroupBox>
                                                                                <GroupBox x:Name="PART_ElemNotes" Header="{DynamicResource LOCNotesLabel}" Margin="0,16,0,0">
                                            <TextBox x:Name="PART_TextNotes" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                     Background="{DynamicResource ControlBackgroundBrush}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" />
                                        </GroupBox>
                                    </StackPanel>
                                    <GroupBox Grid.Column="2" Width="{DynamicResource GameDetailsPaneWidth}" VerticalAlignment="Top" Header="{DynamicResource LOCGameDetails}">
                                        <Border ClipToBounds="True">
                                            <StackPanel Margin="0,-21,0,-4">
                                                <Border x:Name="MetaProgress" Margin="0,8,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel x:Name="PART_ElemCompletionStatus" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCCompletionStatus}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemPlayTime" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCTimePlayed}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextPlayTime" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemLastPlayed" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCLastPlayed}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextLastActivity" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemRecentActivity" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCRecentActivityLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextRecentActivity" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemAdded" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCDateAddedLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextAdded" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaScores" Margin="0,8,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel x:Name="PART_ElemCommunityScore" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCCommunityScore}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemCriticScore" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCCriticScore}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemUserScore" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCUserScore}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaAbout" Margin="0,8,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel x:Name="PART_ElemDevelopers" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCDevelopersLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsDevelopers" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemPublishers" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCPublishersLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsPublishers" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemReleaseDate" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCGameReleaseDateTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemSeries" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCSeriesLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsSeries" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemAgeRating" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCAgeRatingLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsAgeRatings" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemRegion" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCRegionLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsRegions" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaTags" Margin="0,8,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel x:Name="PART_ElemPlatform" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCPlatformsTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,3,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemGenres" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCGenresLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,3,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemCategories" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCCategoriesLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,3,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemFeatures" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCFeaturesLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,3,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemTags" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCTagsLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,3,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsTags" Tag="Chip" Margin="0,0,0,-8">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaLibrary" Margin="0,8,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemLibrary}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemSource}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemVersion}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallSize}" Value="Collapsed" />
                                                                        <Condition Binding="{Binding Visibility, ElementName=PART_ElemInstallDirectory}" Value="Collapsed" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel x:Name="PART_ElemLibrary" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCGameProviderTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <Button x:Name="PART_ButtonLibrary" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemSource" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCSourceLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <Button x:Name="PART_ButtonSource" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemVersion" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCVersionLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <Button x:Name="PART_ButtonVersion" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemInstallSize" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCInstallSizeLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <TextBlock x:Name="PART_TextInstallSize" />
                                                        </DockPanel>
                                                        <DockPanel x:Name="PART_ElemInstallDirectory" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCGameInstallDirTitle}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <Button x:Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="MetaLinks" Margin="0,8,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ElemLinks}" Value="Collapsed">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel x:Name="PART_ElemLinks" Margin="0,4,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Width="120" Text="{DynamicResource LOCLinksLabel}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,1,16,0" />
                                                            <ItemsControl x:Name="PART_ItemsLinks" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </GroupBox>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
