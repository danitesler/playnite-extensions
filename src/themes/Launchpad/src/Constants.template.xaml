<!--
    Launchpad: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    Launchpad publishes no design system, so the placeholders name this theme's own approximated lp tokens
    (see tokens.css). Theme XAML reads brushes only, never Color keys, so ThemeModifier edits reach every control.

    The look: near-black blue-grey surfaces, white text, one bright launcher blue for Play, selection, links and
    focus, and small corner radii.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Playnite keys). The client's own typeface is not bundled; Segoe UI ships with Windows. -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">37</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shape (Playnite keys). ControlCornerRadius is the medium step of the radius scale. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:lp-radius}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Radius scale -->
    <CornerRadius x:Key="CornerRadiusSmall">{{px:lp-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:lp-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:lp-radius-full}}</CornerRadius>

    <!--
        Playnite palette. Every view and control the theme does not restyle reads these, and ThemeModifier edits them.
        GlyphColor is launcher blue, paired with white as TextColorDark (text on blue fills).
    -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{lp-text}}</Color>
    <Color x:Key="TextColorDarker">{{lp-text-muted}}</Color>
    <Color x:Key="TextColorDark">{{lp-on-blue}}</Color>
    <Color x:Key="MainColor">{{lp-card}}</Color>
    <Color x:Key="MainColorDark">{{lp-rail}}</Color>
    <Color x:Key="HoverColor">{{lp-card-hover}}</Color>
    <Color x:Key="GlyphColor">{{lp-blue}}</Color>
    <Color x:Key="HighlightGlyphColor">{{lp-blue/50}}</Color>
    <Color x:Key="PopupBackgroundColor">{{lp-popup}}</Color>
    <Color x:Key="PopupBorderColor">{{lp-border}}</Color>
    <Color x:Key="BackgroundToneColor">{{lp-card}}</Color>
    <Color x:Key="GridItemBackgroundColor">{{lp-card}}</Color>
    <Color x:Key="PanelSeparatorColor">{{lp-divider}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{lp-divider}}</Color>
    <Color x:Key="DataChangeNotifColor">{{lp-amber}}</Color>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{lp-border}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{{lp-card-hover}}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{lp-popup}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{lp-button}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{lp-frame}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{lp-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{lp-red}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{lp-amber}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{lp-red}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{lp-card}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{lp-page}}" />

    <!-- Shared keys: roles Playnite's palette has no key for. ThemeModifier lists them under Edit constants. -->

    <!-- Shell: the darkest surface frames the window (top bar, sidebar); the page sits on a lighter one -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{lp-frame}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{lp-page}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{lp-frame}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{lp-card}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{lp-card-hover}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{lp-blue}}" />

    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{lp-card-active}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{lp-text}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{lp-card-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{lp-card-active}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{lp-card-hover}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{lp-blue}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{lp-red-deep}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{lp-on-blue}}" />

    <!-- Buttons: the Play button is the blue one; every other button is the flat grey secondary button -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{lp-text}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{lp-button-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{lp-button-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{lp-blue}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{lp-blue-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{lp-blue-pressed}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{lp-on-blue}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{lp-card-active}}" />

    <!-- Inputs: dark wells with a thin edge; the edge turns blue on focus -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{lp-frame}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{lp-border}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{lp-border-strong}}" />

    <!-- Controls -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{lp-border-strong}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{lp-text-dim}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{lp-card-active}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{lp-text}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{lp-blue}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{lp-blue}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{lp-card-active}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{lp-border-strong}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{lp-text-dim}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{lp-border-strong}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{lp-text-dim}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{lp-blue}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{lp-text-dim}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{lp-border-strong}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{lp-card-hover}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{lp-card-active}}" />
    <!-- Game overview chips (platforms, genres, tags): the secondary-button grey, one step lighter under the pointer -->
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{lp-button}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{lp-text}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{lp-button-hover}}" />

    <!-- Popups -->
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{lp-divider}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{lp-text}}" />
</ResourceDictionary>
