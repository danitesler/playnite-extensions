<!-- Overlay on Playnite Default/Common.xaml: only restyled keys live here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menus and dropdown surfaces: a dark panel with a 1px edge and the client's small corner radius. -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: a 2px blue outline drawn inside the control edge (FocusVisualStyle shows for keyboard focus only). -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check boxes and radios: the same outline, 2px outside the box. -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource FocusBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Component spacing, keyed by the Playnite control. Launchpad's controls are roomy: 36px buttons and inputs, 36px menu rows. -->
    <Thickness x:Key="ButtonPadding">18,5,18,5</Thickness>
    <Thickness x:Key="InputPadding">12,5,12,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,8,12,8</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">4</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">12,8,12,8</Thickness>
    <Thickness x:Key="ListBoxItemPadding">12,8,12,8</Thickness>
    <Thickness x:Key="GroupBoxPadding">16</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">16,12,16,12</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">20</sys:Double>
    <sys:Double x:Key="GameBannerHeight">320</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double> <!-- Height of the background art banner on the game page. 0 turns it off; ThemeModifier edits it. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column on the game page (details view). ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center (centred above screenshots and description) or Right. Narrow pages stack it first for Left and Center, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double> <!-- Width of the Details column in the grid view side panel. ThemeModifier edits it. -->
    <Thickness x:Key="TooltipPadding">10,6,10,6</Thickness>

    <!-- Placeholder shown where the Steam Screenshots plugin control will appear: a 16:9 main image over a row of five
         16:9 thumbnails, so the real carousel replaces it without the page jumping. Each Viewbox scales a fixed 1600px
         layout to the width its column gives it (height is unbounded in a vertical stack). The tiles are the host's
         Foreground at low opacity; the whole thing pulses while visible. Host: a Control with Foreground set and hit
         testing off, in a Grid next to the plugin's ContentControl, visible while that control has no height. -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="{x:Type Control}">
        <StackPanel x:Name="SkeletonRoot" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Viewbox Stretch="Uniform">
                <Border Width="1600" Height="900" CornerRadius="16"
                        Background="{TemplateBinding Foreground}" Opacity="0.2" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Margin="0,8,0,0">
                <Grid Width="1600" Height="173">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="2" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="4" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="6" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                    <Border Grid.Column="8" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0.2" />
                </Grid>
            </Viewbox>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="SkeletonRoot" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SkeletonPulse" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Empty page (no game selected): a launcher home shelf. Three cover cards drift, the middle one selected (blue underline growing from the centre, an orbit
         ring with one satellite, a slanted glint crossing it), a three-bar equaliser under it and a soft blue glow behind. The host sets position and margin.
         Loops start from ControlTemplate.Triggers on named transforms (never a Style trigger) and are removed on exit. -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False">
            <Grid Width="380" Height="236" HorizontalAlignment="Center">
                <Ellipse x:Name="PadGlow" Width="320" Height="210" Fill="{DynamicResource PrimaryButtonBackgroundBrush}" Opacity="0.12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.OpacityMask>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.OpacityMask>
                </Ellipse>
                <Border Width="88" Height="120" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,196,0" Opacity="0.55" CornerRadius="{DynamicResource CornerRadiusLarge}"
                        Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                    <Border.RenderTransform><TranslateTransform x:Name="PadLeftFloat" Y="0" /></Border.RenderTransform>
                    <ContentControl Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}" Width="22" Height="22" Foreground="{DynamicResource TextBrushDarker}" Opacity="0.6" />
                </Border>
                <Border Width="88" Height="120" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="196,26,0,0" Opacity="0.55" CornerRadius="{DynamicResource CornerRadiusLarge}"
                        Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                    <Border.RenderTransform><TranslateTransform x:Name="PadRightFloat" Y="0" /></Border.RenderTransform>
                    <ContentControl Content="{DynamicResource IconInfo}" ContentTemplate="{DynamicResource IconTemplate}" Width="22" Height="22" Foreground="{DynamicResource TextBrushDarker}" Opacity="0.6" />
                </Border>
                <Border Width="112" Height="150" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" ClipToBounds="True" CornerRadius="{DynamicResource CornerRadiusLarge}"
                        Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource PrimaryButtonBackgroundBrush}" BorderThickness="2">
                    <Border.RenderTransform><TranslateTransform x:Name="PadCenterFloat" Y="0" /></Border.RenderTransform>
                    <Grid>
                        <Grid Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform x:Name="PadOrbit" Angle="0" /></Grid.RenderTransform>
                            <Ellipse Margin="1" StrokeThickness="1.5" Stroke="{DynamicResource PrimaryButtonBackgroundBrush}" Opacity="0.55" />
                            <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0" Fill="{DynamicResource PrimaryButtonBackgroundBrush}" />
                        </Grid>
                        <ContentControl Content="{DynamicResource IconLibrary}" ContentTemplate="{DynamicResource IconTemplate}" Width="40" Height="40"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBrushDarker}" />
                        <Rectangle Width="22" HorizontalAlignment="Left" Fill="{DynamicResource TextBrush}" Opacity="0.12">
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform AngleX="-18" />
                                    <TranslateTransform x:Name="PadGlint" X="-70" />
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Border>
                <Rectangle Width="112" Height="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,168,0,0" Fill="{DynamicResource PrimaryButtonBackgroundBrush}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform x:Name="PadUnderline" ScaleX="0.25" /></Rectangle.RenderTransform>
                </Rectangle>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="20">
                    <Rectangle Width="4" Height="18" Margin="0,0,4,0" VerticalAlignment="Bottom" Fill="{DynamicResource TextBrushDarker}" Opacity="0.8" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="PadBarA" ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="4" Height="18" Margin="0,0,4,0" VerticalAlignment="Bottom" Fill="{DynamicResource TextBrushDarker}" Opacity="0.8" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="PadBarB" ScaleY="1" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="4" Height="18" VerticalAlignment="Bottom" Fill="{DynamicResource TextBrushDarker}" Opacity="0.8" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="PadBarC" ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                </StackPanel>
            </Grid>
            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,16,0,0"
                       FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="PadIdle">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PadLeftFloat" Storyboard.TargetProperty="Y" From="0" To="-5" Duration="0:0:4.6" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PadRightFloat" Storyboard.TargetProperty="Y" From="-4" To="3" Duration="0:0:5.4" BeginTime="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PadCenterFloat" Storyboard.TargetProperty="Y" From="0" To="-4" Duration="0:0:3.6" BeginTime="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PadOrbit" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:9" RepeatBehavior="Forever"></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PadUnderline" Storyboard.TargetProperty="ScaleX" From="0.25" To="1" Duration="0:0:3.2" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PadBarA" Storyboard.TargetProperty="ScaleY" From="0.3" To="1" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PadBarB" Storyboard.TargetProperty="ScaleY" From="1" To="0.35" Duration="0:0:1.5" BeginTime="0:0:0.2" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PadBarC" Storyboard.TargetProperty="ScaleY" From="0.4" To="0.9" Duration="0:0:1.3" BeginTime="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PadGlow" Storyboard.TargetProperty="Opacity" From="0.12" To="0.3" Duration="0:0:4.2" AutoReverse="True" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PadGlint" Storyboard.TargetProperty="X" RepeatBehavior="Forever">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-70" />
                                <SplineDoubleKeyFrame KeyTime="0:0:1.3" Value="130" KeySpline="0.65,0,0.35,1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:4.2" Value="130" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="PadIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
