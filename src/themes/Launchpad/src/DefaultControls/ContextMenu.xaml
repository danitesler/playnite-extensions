<!--
    Launchpad: ContextMenu. Every popup menu and dropdown list (hamburger menu, top bar dropdowns via TopPanelMenu,
    GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists and Playnite's multi-select boxes) wears
    the Battle.net launcher flyout (LocalLauncherMenuTemplate): blue-grey PopupBackgroundBrush, 3px ControlCornerRadius,
    1px PopupBorderBrush rim, faint top inner specular hairline, and a 2px launcher-blue top bar inset 12px from the
    corners. Rows start 6px down. Rows and the 9px blue-led rule are in Menu.xaml.
    Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalLauncherMenuTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}" />
            <Border Margin="1" Height="1" VerticalAlignment="Top" Background="{DynamicResource InputHoverBorderBrush}" Opacity="0.35" />
            <!-- Launcher-blue top accent bar -->
            <Rectangle Height="2" Margin="14,0,14,0" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalLauncherMenuTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,6,0,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="4,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
