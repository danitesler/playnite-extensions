<!--
    Overlay on Playnite Default/Views/GridViewGameOverview.xaml: the game panel beside the cover grid.
    The same game page on the rail color: the same background band as the details page (290px), then a bold title,
    then Steam screenshots, description and notes on the left and Game details on the right (one pane with every metadata field, in groups that hide with their fields). The action
    buttons sit in a sticky footer, the same bar as the details page: blue Play, the context action, Options
    (gear + "More") and edit, on the frame color. Every PART_ element of Playnite's file is kept.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border Padding="24,0,24,0" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            Background="{DynamicResource NormalBrushDark}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Same short background band as the details page. Hidden when the game has no art. -->
<!-- Empty state (no game selected): a quiet launcher tile (Library glyph in a card square) that breathes slowly, and Playnite's
                                     "No game selected". Centered in the visible area. The breathing loop lives in the tile's own style and stops when a game is selected. -->
                                <Grid VerticalAlignment="Center">
                                    <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24">
                                        <Border Width="64" Height="64" HorizontalAlignment="Center" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                                Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="TileBreath">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:3">
                                                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="TileBreath" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                            </Border.Style>
                                            <ContentControl Content="{DynamicResource IconLibrary}" ContentTemplate="{DynamicResource IconTemplate}"
                                                            Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Foreground="{DynamicResource TextBrushDarker}" />
                                        </Border>
                                        <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}" HorizontalAlignment="Center" Margin="0,20,0,0"
                                                   FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrushDarker}" />
                                    </StackPanel>
                                </Grid>

                            
                        <DockPanel>



                            <DockPanel DockPanel.Dock="Top">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <Trigger Property="DataContext" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <ScrollViewer CanContentScroll="False" DockPanel.Dock="Top" HorizontalAlignment="Stretch"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"
                                              x:Name="PART_ScrollViewHost">
<!-- The header scrolls with the page (not pinned above it). -->
<Grid>
<Grid x:Name="HeroClip" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" Margin="0,8,0,0" IsHitTestVisible="False">
<Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
<Grid.OpacityMask><VisualBrush Visual="{Binding ElementName=HeroClipShape}" /></Grid.OpacityMask>
<Border x:Name="HeroClipShape" CornerRadius="{DynamicResource CornerRadiusLarge}" Background="{DynamicResource NormalBrushDark}" />
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.CacheMode>
                                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                </Grid.CacheMode>
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#A6000000" Offset="0" />
                                        <GradientStop Color="Black" Offset="0.3" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.OpacityMask>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- Scrim: panel color, clear at the top, darker toward the title so any art stays readable. -->
                                <Border Background="{DynamicResource NormalBrushDark}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="Transparent" Offset="0.1" />
                                            <GradientStop Color="#A6000000" Offset="0.4" />
                                            <GradientStop Color="#CC000000" Offset="0.7" />
                                            <GradientStop Color="#E6000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
</Grid>
<StackPanel Margin="20,0,20,0">
<Border DockPanel.Dock="Top"  IsHitTestVisible="False" MinHeight="20" x:Name="GridBannerSpacer">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 96 / 320'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                    <Setter Property="Height" Value="20" />
                                                </DataTrigger>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="20" />
</DataTrigger>
</Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <DockPanel Panel.ZIndex="2" DockPanel.Dock="Top">
                                    <Button x:Name="InlineSidePanelCloseButton" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" Width="28" Height="28" Padding="0"
                                        Focusable="False" Cursor="Hand" ToolTip="{DynamicResource LOCCloseLabel}" Command="{MainViewModel CloseGameSideBarCommand}"
                                        Template="{Binding Template, ElementName=SidePanelCloseButton}"
                                        Visibility="{Binding Tag, ElementName=SidePanelCloseButton, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 120 ? `Visible` : `Collapsed`'}">
                                            <Button.RenderTransform>
                                                <TranslateTransform Y="{Binding ContentVerticalOffset, ElementName=PART_ScrollViewHost}" />
                                            </Button.RenderTransform>
                                    </Button>
                                    <Image Name="PART_ImageIcon" DockPanel.Dock="Left" MaxHeight="32" MaxWidth="32"
                                           RenderOptions.BitmapScalingMode="Fant" Margin="0,0,12,0" />
                                    <TextBlock Name="PART_TextDisplayName" FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold"
                                               TextWrapping="Wrap" DockPanel.Dock="Left"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}">
                                        <TextBlock.Effect>
                                            <DropShadowEffect ShadowDepth="3"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </DockPanel>

                                <Grid DockPanel.Dock="Top" Margin="0,16,0,32" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Name="PART_ButtonPlayAction" Grid.Column="0"
                                            Height="44" Style="{DynamicResource PlayButton}" />
                                    <Button Name="PART_ButtonContextAction"
                                            Height="44" Grid.Column="0" />
                                    <Button Name="PART_ButtonMoreActions" Grid.Column="1"
                                            Height="44" Width="44" Margin="12,0,0,0" Padding="0"
                                            ToolTip="{DynamicResource LOCMoreAction}">
                                        <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                        Content="{DynamicResource IconOptions}"
                                                        ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                    <Button x:Name="PART_ButtonEditGame" Grid.Column="2"
                                            Margin="12,0,0,0" Height="44" Width="44" Padding="0" Focusable="False"
                                            ToolTip="{DynamicResource LOCEditGame}">
                                        <ContentControl Width="18" Height="18" Focusable="False" IsTabStop="False"
                                                        Content="{DynamicResource IconEdit}"
                                                        ContentTemplate="{DynamicResource IconTemplate}" />
                                    </Button>
                                </Grid>

                                
                                    <Grid VerticalAlignment="Top" x:Name="GridOverviewBody">
<Grid.Tag>
    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 32 + 400">
        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
        <Binding Path="Tag" ElementName="GridMetadataContent" />
    </MultiBinding>
</Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>


                                        <Grid x:Name="GridMetadataColumn" VerticalAlignment="Top">
<Grid.Style><Style TargetType="Grid">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.Row" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="Margin" Value="32,0,0,0" />
    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </DataTrigger></Style.Triggers>
</Style></Grid.Style>
<StackPanel Margin="0,0,0,24" VerticalAlignment="Top" Tag="{DynamicResource GridDetailsPaneWidth}" x:Name="GridMetadataContent" HorizontalAlignment="Stretch">
<StackPanel.Style>
    <Style TargetType="StackPanel">
        <Setter Property="Width" Value="{DynamicResource GridDetailsPaneWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource GridDetailsPaneWidth}" /><Style.Triggers>
            <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /></DataTrigger>
        <DataTrigger Binding="{Binding Tag, ElementName=GridOverviewBody}" Value="True"><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers>
    </Style>
</StackPanel.Style>
                                            <TextBlock Text="{DynamicResource LOCGameDetails}" FontWeight="SemiBold"
                                                       Style="{DynamicResource BaseTextBlockStyle}" />
                                            <Separator Background="{DynamicResource PanelSeparatorBrush}" Margin="0,8,0,16" />

                                            <Border ClipToBounds="True" x:Name="GridMetadataViewport">
                                                <WrapPanel x:Name="GridMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-33,0,-8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-33,-24,-8" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="GridMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                    <Border x:Name="MetaProgress" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NormalBorderBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <Button Grid.Column="2" x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextPlayTime" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextLastActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaScores" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NormalBorderBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCUserScore}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2" x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="MetaAbout" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NormalBorderBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="GridMetadataViewport" /><Binding Path="Tag" ElementName="GridMetadataGroups" /></MultiBinding></Border.Width>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                            <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding Tag, ElementName=GridMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCDevelopersLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsDevelopers" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCPublishersLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsPublishers" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <Button Grid.Column="2" x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                            </Grid>
                                                            <Grid x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="3*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{DynamicResource LOCSeriesLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,0" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                                <ItemsControl Grid.Column="2" x:Name="PART_ItemsSeries" />
