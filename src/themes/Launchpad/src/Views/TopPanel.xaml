<!--
    Overlay on Playnite Default/Views/TopPanel.xaml.
    The top bar: 52px in the frame color, the search box first (320px, left), then Playnite's view controls, filters
    and notifications as flat 36px icon buttons. Notifications show a blue count badge; an active filter shows
    "Filter active" on the button. 140px stay clear on the right for the window buttons. When the sidebar is hidden
    the bar carries the logo button instead (PART_ElemMainMenu).
    TopPanelMenu, the toggles and the icon templates keep Playnite's keys. All PART_ names are Playnite's.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconViewSettings}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconFilterPresets}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconGroup}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconSort}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconDetailsView}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconGridView}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconListView}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconUpdate}" ContentTemplate="{DynamicResource IconTemplate}" TextElement.Foreground="{DynamicResource WarningBrush}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconExplorer}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconRandom}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconViewRandom}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <!-- Popup menu of the view controls: the theme's menu surface, items from DefaultControls/Menu.xaml. -->
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{DynamicResource MenuPadding}"
                            Grid.IsSharedSizeScope="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter toggle: icon button that also says "Filter active" while a filter is applied. -->
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderThickness="0"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <StackPanel Orientation="Horizontal" Margin="8,0,8,0" VerticalAlignment="Center">
                            <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                              Content="{DynamicResource IconFilter}"
                                              ContentTemplate="{DynamicResource IconTemplate}" />
                            <TextBlock x:Name="TextFilter" Text="{DynamicResource LOCFilterActiveLabel}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Notifications: bell with a blue count badge. -->
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <ContentPresenter Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                              Content="{DynamicResource IconNotifications}"
                                              ContentTemplate="{DynamicResource IconTemplate}" />
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}" MinWidth="16" Height="16"
                                    Margin="0,3,3,0" Background="{DynamicResource GlyphBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="{DynamicResource FontSizeSmall}"
                                           FontWeight="SemiBold" Margin="4,0,4,0"
                                           Foreground="{DynamicResource TextBrushDark}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemCheckedBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelItemHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The toolbar search: SearchBox chrome at 320px and 36px. -->
    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="Width" Value="320" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TopPanelSearchBoxHoverBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Border Height="52" Padding="16,0,140,0"
                            Background="{DynamicResource TopPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Border x:Name="PART_ElemMainMenu" Style="{DynamicResource MainMenuButton}"
                                    DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center">
                                <ContentPresenter Width="36" Height="36"
                                                  Content="{DynamicResource IconMainMenu}"
                                                  ContentTemplate="{DynamicResource IconTemplate}" />
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch" DockPanel.Dock="Left"
                                       Style="{StaticResource TopPanelSearchBox}"
                                       Margin="0,0,8,0"
                                       WindowChrome.IsHitTestVisibleInChrome="True" />

                            <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" DockPanel.Dock="Left" />

                            <CheckBox x:Name="PART_ToggleFilter" DockPanel.Dock="Left"
                                      ToolTip="{DynamicResource LOCFilters}"
                                      Style="{DynamicResource TopPanelFilterToggle}" />

                            <CheckBox x:Name="PART_ToggleNotifications" DockPanel.Dock="Left"
                                      Style="{DynamicResource TopPanelNotificationsToggle}" />

                            <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="12,0,0,0"
                                        DockPanel.Dock="{Settings PluginTopPanelAlignment}" />

                            <!-- Global progress: the label over a 6px bar, then Cancel. -->
                            <!-- Fills the space the bar has left: the bar shrinks first, the cancel button always stays in view. -->
                            <Grid VerticalAlignment="Center" Margin="16,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="480" MinWidth="60" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Name="PART_TextProgressText" Margin="0,0,0,4"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextBrushDarker}"
                                               Style="{DynamicResource BaseTextBlockStyle}" />
                                    <ProgressBar Name="PART_ProgressGlobal" Height="6" />
                                </StackPanel>
                                <Button Name="PART_ButtonProgressCancel" Grid.Column="1"
                                        Content="{DynamicResource LOCCancelLabel}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Margin="12,0,0,0" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
