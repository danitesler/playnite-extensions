<!--
    Overlay on Playnite Default/Views/DetailsViewGameOverview.xaml: the game info page beside the game list.
    Laid out like a Launchpad game page:
      - the game's background art is a 340px band at the top, tinted at the top and scrimmed toward the title, and fades into the page color (PART_ImageBackground);
      - the game's icon and name in large white type on the art, its cover at the right;
      - two columns below: Steam screenshots, description and notes on the left, Game details on the right (one pane with every metadata field, in groups that hide with their fields);
      - a bottom action bar in the frame color with the big blue Play button, the context action, Options (the gear,
        Playnite's "More" menu) and an edit button at the right.
    Every PART_ element of Playnite's file is kept. HtmlTextView takes Color-typed properties, the one place theme
    XAML reads Color keys (the build check allows exactly HtmlForeground and LinkForeground).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <DockPanel
                               d:DesignWidth="1280" d:DesignHeight="960"
                               d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <!-- Action bar: Play, context action, Options, edit. Hidden while no game is selected. -->
                        <Border x:Name="ActionBar" DockPanel.Dock="Bottom" Padding="24,16,24,16"
                                Background="{DynamicResource TopPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="0,1,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="DataContext" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Name="PART_ButtonPlayAction" Width="240" Height="52"
                                            Style="{DynamicResource PlayButton}" />
                                    <Button Name="PART_ButtonContextAction" Tag="ContextAction" Style="{DynamicResource PlayButton}" Grid.Column="1" Width="160" Height="52" />
                                    <Control Grid.ColumnSpan="2" Style="{DynamicResource RunningActionIndicator}" />
                                </Grid>
                                <Button Name="PART_ButtonMoreActions" Width="52" Height="52" Margin="12,0,0,0" Padding="0"
                                        ToolTip="{DynamicResource LOCMoreAction}">
                                    <ContentControl Width="20" Height="20" Focusable="False" IsTabStop="False"
                                                    Content="{DynamicResource IconOptions}"
                                                    ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                                <Button x:Name="PART_ButtonEditGame" Width="52" Height="52" Margin="12,0,0,0" Padding="0" Focusable="False"
                                        ToolTip="{DynamicResource LOCEditGame}">
                                    <ContentControl Width="20" Height="20" Focusable="False" IsTabStop="False"
                                                    Content="{DynamicResource IconEdit}"
                                                    ContentTemplate="{DynamicResource IconTemplate}" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Visible"
                                      Style="{DynamicResource DetailsScrollViewer}" Visibility="Visible"
                                      x:Name="PART_ScrollViewHost">
                            <Grid>
<Grid x:Name="HeroArt" Height="{DynamicResource GameBannerHeight}" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=PART_ImageBackground}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ImageBackground}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.CacheMode>
                                        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="False" />
                                    </Grid.CacheMode>
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#A6000000" Offset="0" />
                                            <GradientStop Color="Black" Offset="0.3" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="{DynamicResource GameBannerDarken}" IsHitTestVisible="False" />
                                    <!-- banner darkening floor: any value above 0 starts at 50%, so the result is 50% + 50% x the slider -->
                                    <Rectangle Fill="{DynamicResource GameBannerTintBrush}" Opacity="0.5" Tag="{DynamicResource GameBannerDarken}" IsHitTestVisible="False">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <!-- Scrim: page color, clear at the top, darker toward the title so any art stays readable. -->
                                    <Border Background="{DynamicResource ContentBackgroundBrush}">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Transparent" Offset="0.1" />
                                                <GradientStop Color="#A6000000" Offset="0.4" />
                                                <GradientStop Color="#CC000000" Offset="0.7" />
                                                <GradientStop Color="#E6000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                </Grid>
<Grid>
                                    <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Game, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <!-- Background art, a short band. Cropped and faded into the page. Hidden when the game has no art. -->


                                <Grid HorizontalAlignment="Stretch" MaxWidth="1400" Margin="24,0,41,32">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- A short strip of art above the title. Collapses with the hero when the game has no background. -->
                                    <Border Grid.Row="0"  IsHitTestVisible="False" x:Name="DetailsBannerSpacer" MinHeight="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Height" Value="{Binding ActualHeight, ElementName=HeroArt, Converter={StaticResource MathConverter}, ConverterParameter='x * 100 / 320'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActualHeight, ElementName=HeroArt}" Value="0">
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=HeroArt}" Value="Collapsed">
    <Setter Property="Height" Value="0" />
</DataTrigger>
</Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Title on the art: icon and name, cover at the right. -->
                                    <DockPanel Margin="0,24,0,20" Grid.Row="1" Background="Transparent">
                                        <Image Name="PART_ImageCover" VerticalAlignment="Bottom"
                                               DockPanel.Dock="Right" Margin="24,0,0,0"
                                               Height="{Settings GameDetailsCoverHeight}"
                                               StretchDirection="Both" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="Fant" />
                                        <DockPanel VerticalAlignment="Bottom" DockPanel.Dock="Left">
                                            <Image Name="PART_ImageIcon" MaxHeight="56" MaxWidth="56"
                                                   DockPanel.Dock="Left" Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                            <TextBlock Name="PART_TextDisplayName" FontFamily="{DynamicResource FontFamily}"
                                                       FontSize="{DynamicResource FontSizeLargest}" FontWeight="Bold"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.8" RenderingBias="Quality" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </DockPanel>
                                    </DockPanel>

                                    <Grid Grid.Row="2" x:Name="DetailsOverviewBody">

<Grid.Tag><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="x &lt; y + 20 + 400"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" ElementName="DetailsMetadataContent" /></MultiBinding></Grid.Tag>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid x:Name="DetailsMetadataColumn" VerticalAlignment="Top"><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Margin" Value="20,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger></Style.Triggers></Style></Grid.Style>
<Border VerticalAlignment="Top" Margin="0,0,0,0"

                                                Background="{DynamicResource ExpanderBackgroundBrush}"
                                                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" BorderThickness="1"
                                                CornerRadius="{DynamicResource CornerRadiusLarge}" Padding="20,16,20,16" HorizontalAlignment="Stretch">
                                            <StackPanel Tag="{DynamicResource GameDetailsPaneWidth}" HorizontalAlignment="Stretch" x:Name="DetailsMetadataContent">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Width" Value="{DynamicResource GameDetailsPaneWidth}" /><Setter Property="MaxWidth" Value="{DynamicResource GameDetailsPaneWidth}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DetailsOverviewBody}" Value="True"><Setter Property="Width" Value="NaN" /><Setter Property="MaxWidth" Value="Infinity" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                <TextBlock Text="{DynamicResource LOCGameDetails}" FontSize="{DynamicResource FontSizeLarge}"
                                                           FontWeight="SemiBold" Style="{DynamicResource BaseTextBlockStyle}" />
                                                <Separator Margin="0,12,0,12" Background="{DynamicResource PanelSeparatorBrush}" />

                                                <Border ClipToBounds="True" x:Name="DetailsMetadataViewport">
                                                    <WrapPanel x:Name="DetailsMetadataGroups" UseLayoutRounding="False">
<WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Margin" Value="0,-33,0,-8" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Margin" Value="0,-33,-24,-8" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
<WrapPanel.Tag><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" Converter="{StaticResource MathConverter}" ConverterParameter="x &gt;= 560" /></WrapPanel.Tag>
                                                        <Border x:Name="MetaProgress" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NormalBorderBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCompletionStatus}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlayTime}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemLastPlayed}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRecentActivity}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAdded}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemCompletionStatus" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCCompletionStatus}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <Button x:Name="PART_ButtonCompletionStatus" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemPlayTime" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCTimePlayed}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <TextBlock x:Name="PART_TextPlayTime" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemLastPlayed" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCLastPlayed}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <TextBlock x:Name="PART_TextLastActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemRecentActivity" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCRecentActivityLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <TextBlock x:Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemAdded" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCDateAddedLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <TextBlock x:Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaScores" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NormalBorderBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCommunityScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCriticScore}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemUserScore}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemCommunityScore" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCCommunityScore}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <TextBlock x:Name="PART_TextCommunityScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemCriticScore" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCCriticScore}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <TextBlock x:Name="PART_TextCriticScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemUserScore" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCUserScore}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <TextBlock x:Name="PART_TextUserScore" Style="{DynamicResource TextBlockGameScore}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaAbout" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NormalBorderBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemDevelopers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPublishers}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemReleaseDate}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemSeries}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemAgeRating}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemRegion}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemDevelopers" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCDevelopersLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <ItemsControl x:Name="PART_ItemsDevelopers" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemPublishers" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCPublishersLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <ItemsControl x:Name="PART_ItemsPublishers" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemReleaseDate" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <Button x:Name="PART_ButtonReleaseDate" HorizontalAlignment="Left" Style="{StaticResource PropertyItemButton}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemSeries" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCSeriesLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <ItemsControl x:Name="PART_ItemsSeries" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemAgeRating" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCAgeRatingLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <ItemsControl x:Name="PART_ItemsAgeRatings" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemRegion" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCRegionLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <ItemsControl x:Name="PART_ItemsRegions" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="MetaTags" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NormalBorderBrush}"><Border.Width><MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="y == true ? Max(0, (x - 24) / 2) : x"><Binding Path="ActualWidth" ElementName="DetailsMetadataViewport" /><Binding Path="Tag" ElementName="DetailsMetadataGroups" /></MultiBinding></Border.Width>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                                    <Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemPlatform}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemGenres}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemCategories}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemFeatures}" Value="Collapsed" />
                                                                                <Condition Binding="{Binding Visibility, ElementName=PART_ElemTags}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, ElementName=DetailsMetadataGroups}" Value="True"><Setter Property="Margin" Value="0,12,24,0" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <StackPanel x:Name="PART_ElemPlatform" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCPlatformsTitle}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <ItemsControl x:Name="PART_ItemsPlatforms" Tag="Chip" Margin="0,2,0,-8">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemGenres" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCGenresLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <ItemsControl x:Name="PART_ItemsGenres" Tag="Chip" Margin="0,2,0,-8">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemCategories" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCCategoriesLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <ItemsControl x:Name="PART_ItemsCategories" Tag="Chip" Margin="0,2,0,-8">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PART_ElemFeatures" Margin="0,8,0,8">
                                                                    <TextBlock Text="{DynamicResource LOCFeaturesLabel}" Style="{DynamicResource BaseTextBlockStyle}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,2" />
                                                                    <ItemsControl x:Name="PART_ItemsFeatures" Tag="Chip" Margin="0,2,0,-8">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
