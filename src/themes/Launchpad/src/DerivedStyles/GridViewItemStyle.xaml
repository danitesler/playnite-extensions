<!--
    Launchpad: cover tiles. Selected = a static 2px launcher-blue outline drawn just outside the cover (setters).
    Hover = animated and distinct from it, the app's selected-tab underline language on a tile:
      in  0.16s ease-out: a 2px strong-grey outline fades in and a 3px launcher-blue bar grows from the centre of the
          bottom edge to the full width (ScaleX 0 to 1, 0.22s ease-out).
      out 0.2s: both fade away; exit animations use FillBehavior Stop so no clock is left running.
    Everything is drawn inside the item's own spacing margin (3px outside the cover, the same as the outline), so the
    panel does not clip it. Covers stay square. No glow and no sprites: the client is flat. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="{DynamicResource GridItemBackgroundBrush}"
                          Margin="{Settings ItemSpacingMargin}"
                          x:Name="ItemGrid">
                        <!-- Hover: animated layers, below the selected outline -->
                        <Border x:Name="HoverBorder" BorderThickness="2" Margin="-3" Opacity="0" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" />
                        <!-- Selected: static -->
                        <Border x:Name="SelectionBorder" BorderThickness="2" Margin="-3" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource CornerRadiusSmall}" />
                        <ContentPresenter />
                        <Border x:Name="HoverBar" Height="3" Margin="-3,0,-3,-3" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False"
                                Background="{DynamicResource FocusBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="HoverBarScale" ScaleX="0" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="HoverBarScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverBarScale" Storyboard.TargetProperty="ScaleX" To="0.4" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Canvas.ZIndex" Value="90" />
                        </Trigger>
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
