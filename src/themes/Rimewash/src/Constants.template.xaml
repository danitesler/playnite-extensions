<!--
    Rimewash: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.

    Keys are the shared theme vocabulary (scripts/data/theme-keys.json), the same in every theme of this repo.
    Token names (rw-*) stay in tokens.css; here each placeholder names the token that plays the key's role.
    A light theme: snow plates on a frosted blue-grey wash, slate ink and slate plates, a gold chevron marker and
    orange values. Theme XAML reads brushes only, never Color keys.

    Placeholder syntax: docs/themes/reference.md. Keep double braces out of comments here: the build renders
    them too.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography: Jost (bundled, Regular and Medium) for the geometric UI text, Constantia (ships with Windows) for the
         storybook serif titles. Jost is Futura-like with a small x-height, so the scale runs one step larger than Playnite's. -->
    <sys:Double x:Key="FontSizeSmall">13</sys:Double>
    <sys:Double x:Key="FontSize">15</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarger">22</sys:Double>
    <sys:Double x:Key="FontSizeLargest">32</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Jost, Jost, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Constantia, Georgia, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width; apply inside the pane's horizontal padding and frame. -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <!-- Details view metadata pane: Left, Center / Stretch (full-width divider-free 3/2/1-col item grid above content), or Right. ThemeModifier edits it. -->
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape. The plates are torn by a sprite, so the radii stay modest. -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:rw-radius}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:rw-radius-small}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:rw-radius-card}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">{{px:rw-radius-plate}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{rw-ink}}</Color>                       <!-- slate ink -->
    <Color x:Key="TextColorDarker">{{rw-ink-muted}}</Color>           <!-- secondary text, 4.8:1 on snow -->
    <Color x:Key="TextColorDark">{{rw-snow}}</Color>                  <!-- paper-white text on slate fills -->
    <Color x:Key="MainColor">{{rw-frost-band}}</Color>                <!-- control fill: the header band tone -->
    <Color x:Key="MainColorDark">{{rw-mist}}</Color>                  <!-- recessed areas -->
    <Color x:Key="HoverColor">{{rw-mist}}</Color>                     <!-- hover fill -->
    <Color x:Key="GlyphColor">{{rw-slate-deep}}</Color>               <!-- selection fill: the selected slot -->
    <Color x:Key="HighlightGlyphColor">{{rw-slate-mid}}</Color>       <!-- the L1 chip slate -->
    <Color x:Key="PopupBackgroundColor">{{rw-frost}}</Color>          <!-- snow plate -->
    <Color x:Key="PopupBorderColor">{{rw-pencil-blue}}</Color>        <!-- pencil edge -->
    <Color x:Key="BackgroundToneColor">{{rw-sky}}</Color>             <!-- tinted areas -->
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">#00000000</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{rw-pencil-blue}}</Color> <!-- pencil rules -->
    <Color x:Key="DataChangeNotifColor">{{rw-amber-mid}}</Color>      <!-- the notice mark and changed-data ink: the orange of the values -->

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{rw-slate}}" />            <!-- slot rim -->
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{rw-night-slate}}" />  <!-- the dim pause-screen tooltip -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{rw-slate-btn}}" />     <!-- Craft Oculi plate -->
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{rw-snow}}" />      <!-- unchecked box fill -->
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{rw-leaf-ink}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{rw-cast}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{rw-amber-ink}}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{{rw-cast}}" />

    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{rw-frost}}" />       <!-- snow plates: group boxes and expanders -->
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{rw-wash}}" />          <!-- the frosted wash -->

    <!-- Shared keys outside the Playnite palette. ThemeModifier lists the keys opted in through the shared catalog. -->
    <!-- Shell layers: slate rail, frost header band, wash content -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{rw-slate-deep}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{rw-frost-band}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{rw-wash}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{rw-pencil}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{rw-slate-deep}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{rw-slate-deep}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{rw-wash}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{rw-ink}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{rw-frost-band}}" />
    <SolidColorBrush x:Key="PanelShadowBrush" Color="{{rw-plate-shadow}}" />
    <!-- Game page -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{rw-frost-band}}" />      <!-- paper tint: the banner dissolves into snow -->
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{rw-frost}}" />
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{rw-snow}}" />       <!-- lightest ink, on game art -->
    <SolidColorBrush x:Key="ValueAccentBrush" Color="{{rw-amber-ink}}" />        <!-- the orange of numeric values, 4.9:1 on snow -->
    <SolidColorBrush x:Key="ParchmentBrush" Color="{{rw-frost}}" />                <!-- the snow sheet -->
    <SolidColorBrush x:Key="ParchmentEdgeBrush" Color="{{rw-pencil-blue}}" />
    <SolidColorBrush x:Key="ParchmentTextBrush" Color="{{rw-ink-body}}" />
    <SolidColorBrush x:Key="ParchmentTitleBrush" Color="{{rw-ink}}" />
    <SolidColorBrush x:Key="ParchmentLabelBrush" Color="{{rw-ink-muted}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{rw-ink}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{rw-gold}}" />             <!-- the chevron -->
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{rw-pencil}}" />             <!-- dotted pencil rule -->
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{rw-ink}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{rw-slate-btn}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{rw-mist}}" />    <!-- HP / MP strip -->
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{rw-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{rw-snow}}" />
    <!-- States -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{rw-slate-deep}}" />            <!-- the selected slot -->
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{rw-slate-btn}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{rw-snow}}" />            <!-- white slot rim -->
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{rw-snow/65}}" />          <!-- the swipe, half drawn -->
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{rw-snow}}" />          <!-- the swipe -->
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{rw-mist}}" />
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{rw-wisp-deep}}" />     <!-- Igniculus teal: never Play, selection or hover -->
    <SolidColorBrush x:Key="FocusBrush" Color="{{rw-gold}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{rw-gold-bright/40}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{rw-cast}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{rw-snow}}" />
    <!-- Buttons: the slate plate with white caps -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{rw-slate-deep}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{rw-slate-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{rw-slate-press}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{rw-frost-band}}" />   <!-- plain plate -->
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{rw-slate}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{rw-mist}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{rw-slate-btn}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{rw-slate-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{rw-slate-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{rw-slate-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{rw-gold-bright}}" />
    <!-- Inputs -->
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{rw-slate-deep}}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{rw-slate}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{rw-slate-mid}}" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="{{rw-leaf}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{rw-slate-mid}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{rw-slate-deep}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{rw-mist}}" />
    <!-- Controls -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{rw-slate-mid}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{rw-gold-bright}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{rw-slate-deep}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{rw-gold}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{rw-sky}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{rw-teal}}" />     <!-- the WAIT zone -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{rw-slate}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{rw-slate-mid}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{rw-frost-band}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{rw-slate}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{rw-slate-mid}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{rw-ink-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{rw-ink}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{rw-slate-mid}}" />      <!-- the L1 chip -->
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{rw-slate}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{rw-gold}}" />    <!-- cover rim, hovered -->
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="SlotBorderBrush" Color="{{rw-slate}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{rw-pencil-blue}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{rw-snow}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{rw-fog}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{rw-frost-band}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{rw-ink}}" />
    <SolidColorBrush x:Key="HeaderBandBrush" Color="{{rw-frost-band}}" />
    <SolidColorBrush x:Key="HeaderBandForegroundBrush" Color="{{rw-ink}}" />
</ResourceDictionary>
