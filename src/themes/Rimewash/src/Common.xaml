<!--
    Overlay on Playnite Default/Common.xaml. Rimewash's spacing, focus and sprite templates.
    The menus of the game are airy: rows about 32px at 1080p with a 14px label, soft snow plates with torn edges,
    a dotted pencil rule under every title. ControlHeight is 32; vertical padding stays at 5 so it decides the height.
    Every sprite is a white alpha mask in Images/fx (art/sprites.py) painted through an OpacityMask, so a brush colours it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="PopupBorder" TargetType="Border">
        <!-- Menus, dropdowns and popovers: a snow sheet with a pencil edge. Popups are layered windows, so no sprite and no shadow. -->
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard focus: a 2px gold ring 3px outside the control, the colour of the chevron. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="10" RadiusY="10" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusBrush}" StrokeThickness="2"
                               RadiusX="7" RadiusY="7" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading on the game pages and cards: the serif of the screen titles. It reads in the lightest ink while game
         art is drawn behind the window (the sheet is gone then). -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Button: 16 inline -->
    <Thickness x:Key="ButtonPadding">16,5</Thickness>
    <!-- Text box, password box, dropdown: 10 inline -->
    <Thickness x:Key="InputPadding">10,5</Thickness>
    <!-- Menu: a snow sheet, rows 31px (17 + 2 x 7) -->
    <Thickness x:Key="MenuPadding">5</Thickness>
    <Thickness x:Key="MenuItemPadding">10,7,12,7</Thickness>
    <Thickness x:Key="ComboBoxDropDownPadding">5</Thickness>
    <Thickness x:Key="ComboBoxItemPadding">10,7,12,7</Thickness>
    <Thickness x:Key="ListBoxItemPadding">12,7</Thickness>
    <!-- Card (group box): a snow plate; the header carries the serif title and the pencil rule -->
    <Thickness x:Key="GroupBoxPadding">20,14,20,18</Thickness>
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,10</Thickness>
    <Thickness x:Key="GroupBoxHeaderPadding">22,16,22,0</Thickness>
    <sys:Double x:Key="GroupBoxHeaderFontSize">18</sys:Double>
    <!-- Tooltip: the dim pause-screen note -->
    <Thickness x:Key="TooltipPadding">14,9</Thickness>
    <!-- Every form field and button: one height across all themes (validate-extension.ps1, FormControlHeight). -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>

    <sys:Double x:Key="GameBannerHeight">380</sys:Double>
    <!-- Banner darkening (ThemeModifier slider, 0 = none; above 0 the tint is 50% + 50% x the value): GameBannerTintBrush over the banner art, under the
         theme's own fade. Off while Playnite draws the art behind the window (the banner collapses then). -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment> <!-- Details view metadata pane: Left, Center / Stretch (full-width item grid above screenshots and description) or Right. Narrow pages stack it first for Left, Center and Stretch, last for Right. ThemeModifier edits it. -->
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>

    <!-- ===================================================================================================== -->
    <!-- Sprites. Cell sizes are in DIP: the PNGs are saved at 192 dpi, so Viewbox/Viewport read in DIP.        -->
    <!-- ===================================================================================================== -->

    <!-- SnowPlateTemplate: the torn snow plate (plate-snow.png, 112 DIP: corners 24, edge 64). The host's Background is the
         paper. It is a layer behind content (no content presenter). The nominal edge sits 5.5 DIP inside the host, so the
         centre underlay is inset 8 and the plate reads as feathered paper, never a rectangle. -->
    <ControlTemplate x:Key="SnowPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="9" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-snow.png'}" Viewbox="0,0,24,24" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-snow.png'}" Viewbox="24,0,64,24" ViewboxUnits="Absolute" Viewport="0,0,64,24" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-snow.png'}" Viewbox="88,0,24,24" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-snow.png'}" Viewbox="0,24,24,64" ViewboxUnits="Absolute" Viewport="0,0,24,64" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-snow.png'}" Viewbox="88,24,24,64" ViewboxUnits="Absolute" Viewport="0,0,24,64" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-snow.png'}" Viewbox="0,88,24,24" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-snow.png'}" Viewbox="24,88,64,24" ViewboxUnits="Absolute" Viewport="0,0,64,24" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-snow.png'}" Viewbox="88,88,24,24" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- SnowShadowTemplate: the soft blue shadow of a plate (plate-shadow.png, 112 DIP: corners 40, edge 32), in the host's Foreground.
         Put it behind the plate with Margin="-14,-8,-14,-22" and an Opacity (0.3 to 0.5). -->
    <ControlTemplate x:Key="SnowShadowTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="30" Fill="{TemplateBinding Foreground}" />
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-shadow.png'}" Viewbox="0,0,40,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-shadow.png'}" Viewbox="40,0,32,40" ViewboxUnits="Absolute" Viewport="0,0,32,40" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-shadow.png'}" Viewbox="72,0,40,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-shadow.png'}" Viewbox="0,40,40,32" ViewboxUnits="Absolute" Viewport="0,0,40,32" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-shadow.png'}" Viewbox="72,40,40,32" ViewboxUnits="Absolute" Viewport="0,0,40,32" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-shadow.png'}" Viewbox="0,72,40,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-shadow.png'}" Viewbox="40,72,32,40" ViewboxUnits="Absolute" Viewport="0,0,32,40" ViewportUnits="Absolute" TileMode="Tile" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-shadow.png'}" Viewbox="72,72,40,40" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- ChipPlateTemplate: a small torn chip (plate-chip.png, 40 DIP: corners 12, edge 16), host Background is the paper.
         A layer behind content; the host should be at least 24 x 24. -->
    <ControlTemplate x:Key="ChipPlateTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
            </Grid.RowDefinitions>
            <Rectangle Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="5,4" Fill="{TemplateBinding Background}" />
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-chip.png'}" Viewbox="0,0,12,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-chip.png'}" Viewbox="12,0,16,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-chip.png'}" Viewbox="28,0,12,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-chip.png'}" Viewbox="0,12,12,16" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-chip.png'}" Viewbox="28,12,12,16" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-chip.png'}" Viewbox="0,28,12,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-chip.png'}" Viewbox="12,28,16,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/plate-chip.png'}" Viewbox="28,28,12,12" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- SwipeTemplate: the dry-brush stroke behind a selected or hovered row (swipe.png, 112 x 44 DIP: caps 40, body 32), host Background.
         Caps are drawn 28 wide and the body stretches, so a 28px tree row and a 40px list row both get the full ragged ends. -->
    <ControlTemplate x:Key="SwipeTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" UseLayoutRounding="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/swipe.png'}" Viewbox="0,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Column="1" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/swipe.png'}" Viewbox="40,0,32,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Grid.Column="2" Fill="{TemplateBinding Background}">
                <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/swipe.png'}" Viewbox="72,0,40,44" ViewboxUnits="Absolute" Stretch="Fill" /></Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- SwipeCompactTemplate: the whole stroke squeezed into a small host (rail item, toolbar cell). -->
    <ControlTemplate x:Key="SwipeCompactTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Background}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/swipe.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- ChevronTemplate: the hand-drawn cursor (chevron.png 28 x 36 DIP) in the host's Foreground. -->
    <ControlTemplate x:Key="ChevronTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Foreground}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/chevron.png'}" Stretch="Uniform" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- ChevronGlowTemplate: the lantern glow around the chevron (chevron-glow.png: the chevron sits in its middle half).
         Size the host at twice the chevron and centre it on it. -->
    <ControlTemplate x:Key="ChevronGlowTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Foreground}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/chevron-glow.png'}" Stretch="Uniform" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- DividerTemplate: the dotted pencil rule under a heading (pencil-rule.png tile, 32 x 3 DIP), host Foreground. -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Rectangle Height="3" IsHitTestVisible="False" Fill="{TemplateBinding Foreground}" SnapsToDevicePixels="True">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/pencil-rule.png'}" Viewport="0,0,32,3" ViewportUnits="Absolute" TileMode="Tile" Stretch="None" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- CloudTemplate: seamless watercolour mottling (cloud.png, 256 DIP tile) over a calm surface; the host sets Opacity. -->
    <ControlTemplate x:Key="CloudTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Foreground}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/cloud.png'}" Viewport="0,0,256,256" ViewportUnits="Absolute" TileMode="Tile" Stretch="Fill" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- VignetteTemplate: deepens the corners of a page (vignette.png stretched), host Foreground; the host sets Opacity. -->
    <ControlTemplate x:Key="VignetteTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Foreground}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/vignette.png'}" Stretch="Fill" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- RootsTemplate: faint pencil roots for a page corner (roots.png 120 x 260 DIP), host Foreground and Opacity. -->
    <ControlTemplate x:Key="RootsTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Foreground}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/roots.png'}" Stretch="Uniform" AlignmentX="Right" AlignmentY="Bottom" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- WispTemplate: the running wisp (wisp.png 48 DIP: soft glow, bright core), host Foreground; scales to the host. -->
    <ControlTemplate x:Key="WispTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Foreground}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/wisp.png'}" Stretch="Uniform" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- BlobTemplate: the watercolour blob disc (blob.png 40 DIP): level badge and filter mark, host Foreground. -->
    <ControlTemplate x:Key="BlobTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Foreground}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/blob.png'}" Stretch="Uniform" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- RingTemplate: the hand-drawn double ring (ring.png 32 DIP): caption buttons, prompt glyphs, host Foreground. -->
    <ControlTemplate x:Key="RingTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Foreground}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/ring.png'}" Stretch="Uniform" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- CrystalTemplate: the hoarfrost crystal sprite (crystal.png 96 DIP) for the empty page, host Foreground. -->
    <ControlTemplate x:Key="CrystalTemplate" TargetType="Control">
        <Rectangle IsHitTestVisible="False" Fill="{TemplateBinding Foreground}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="{ThemeFile 'Images/fx/crystal.png'}" Stretch="Uniform" /></Rectangle.OpacityMask>
        </Rectangle>
    </ControlTemplate>

    <!-- BrandMarkTemplate: Rimewash's mark (art/mark.svg: a wobbled ring and a six-armed hoarfrost crystal, one 96 x 96 stroke
         drawing) in the host's Foreground. Scales to the host; the host sets Width and Height. -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="96" Height="96">
                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M61.92,8.74 L64.77,10.11 L67.54,11.59 L70.23,13.20 L72.84,14.95 L75.33,16.88 L77.67,19.01 L79.79,21.36 L81.67,23.91 L83.30,26.62 L84.68,29.46 L85.86,32.38 L86.87,35.36 L87.73,38.39 L88.45,41.47 L89.00,44.61 L89.34,47.80 L89.39,51.03 L89.12,54.25 L88.48,57.43 L87.49,60.51 L86.17,63.47 L84.59,66.27 L82.80,68.93 L80.86,71.46 L78.80,73.88 L76.61,76.17 L74.29,78.34 L71.82,80.33 L69.19,82.11 L66.39,83.62 L63.46,84.85 L60.43,85.78 L57.35,86.44 L54.24,86.87 L51.12,87.14 L48.00,87.27 L44.87,87.27 L41.73,87.12 L38.57,86.78 L35.43,86.20 L32.35,85.32 L29.36,84.11 L26.53,82.58 L23.87,80.76 L21.40,78.70 L19.11,76.46 L16.97,74.08 L14.99,71.58 L13.14,68.97 L11.47,66.24 L10.00,63.39 L8.80,60.41 L7.91,57.33 L7.36,54.17 L7.14,50.97 L7.22,47.79 L7.54,44.64 L8.05,41.54 L8.70,38.49 L9.47,35.47 L10.37,32.47 L11.43,29.51 L12.70,26.62 L14.22,23.83 L16.02,21.20 L18.07,18.77 L20.37,16.55 L22.85,14.54 L25.47,12.74 L28.19,11.10 L31.01,9.62 L33.91,8.29" />
                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M48.00,45.00 L48.00,19.00 M48.00,32.00 L40.76,26.93 M48.00,32.00 L55.24,26.93 M48.00,24.72 L43.31,21.44 M48.00,24.72 L52.69,21.44 M48.00,45.00 L70.52,32.00 M59.26,38.50 L60.03,29.69 M59.26,38.50 L67.27,42.24 M65.56,34.86 L66.06,29.16 M65.56,34.86 L70.75,37.28 M48.00,45.00 L70.52,58.00 M59.26,51.50 L67.27,47.76 M59.26,51.50 L60.03,60.31 M65.56,55.14 L70.75,52.72 M65.56,55.14 L66.06,60.84 M48.00,45.00 L48.00,71.00 M48.00,58.00 L55.24,63.07 M48.00,58.00 L40.76,63.07 M48.00,65.28 L52.69,68.56 M48.00,65.28 L43.31,68.56 M48.00,45.00 L25.48,58.00 M36.74,51.50 L35.97,60.31 M36.74,51.50 L28.73,47.76 M30.44,55.14 L29.94,60.84 M30.44,55.14 L25.25,52.72 M48.00,45.00 L25.48,32.00 M36.74,38.50 L28.73,42.24 M36.74,38.50 L35.97,29.69 M30.44,34.86 L25.25,37.28 M30.44,34.86 L29.94,29.16" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>
</ResourceDictionary>
