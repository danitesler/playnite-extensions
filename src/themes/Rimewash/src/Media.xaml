<!--
    Overlay on Playnite Default/Media.xaml.
    Icon set: Rimewash's own, drawn by hand on a 24px grid with a 1.8px round stroke (ring, crystal and chevron are its
    shapes). Each Icon<Role> is one path string, stroked by IconTemplate in the inherited foreground; the host sets the
    size (IconSize). No icon pack ships: the game's painted icons are not stroked glyphs, so these are the nearest hand-drawn set.

    Playnite's own menu icons (AddGameIcon, PlayIcon, ...) are not overridden: Playnite draws its icofont glyphs in the menu
    text colour, which the palette already paints in ink.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Geometry x:Key="IconSearch">M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13z M15.4 15.4L20.4 20.4</Geometry>
    <Geometry x:Key="IconClear">M6.5 6.5l11 11 M17.5 6.5l-11 11</Geometry>
    <Geometry x:Key="IconViewSettings">M4 8h9 M17 8h3 M13 8a2 2 0 1 0 4 0 2 2 0 0 0-4 0 M4 16h3 M11 16h9 M7 16a2 2 0 1 0 4 0 2 2 0 0 0-4 0</Geometry>
    <Geometry x:Key="IconFilterPresets">M7 4.5h10a1 1 0 0 1 1 1V20l-6-3.6L6 20V5.5a1 1 0 0 1 1-1z</Geometry>
    <Geometry x:Key="IconGroup">M12 4l8 4-8 4-8-4z M4 12.5l8 4 8-4 M4 16.5l8 4 8-4</Geometry>
    <Geometry x:Key="IconSort">M7 5v13 M3.8 15l3.2 3.2 3.2-3.2 M13 7h8 M13 12h6 M13 17h4</Geometry>
    <Geometry x:Key="IconDetailsView">M4 5.5h16v13H4z M9.5 5.5v13 M12.5 9h5 M12.5 12.5h4</Geometry>
    <Geometry x:Key="IconGridView">M4.5 4.5h6v6h-6z M13.5 4.5h6v6h-6z M4.5 13.5h6v6h-6z M13.5 13.5h6v6h-6z</Geometry>
    <Geometry x:Key="IconListView">M4 7h2 M9 7h11 M4 12h2 M9 12h11 M4 17h2 M9 17h11</Geometry>
    <Geometry x:Key="IconUpdate">M19.5 12a7.5 7.5 0 1 1-2.4-5.5 M19.5 4.5v4.2h-4.2</Geometry>
    <Geometry x:Key="IconExplorer">M3.5 7a1.5 1.5 0 0 1 1.5-1.5h4l2 2.5h8a1.5 1.5 0 0 1 1.5 1.5v8a1.5 1.5 0 0 1-1.5 1.5H5a1.5 1.5 0 0 1-1.5-1.5z</Geometry>
    <Geometry x:Key="IconRandom">M5 5h14v14H5z M9 9h.01 M15 9h.01 M12 12h.01 M9 15h.01 M15 15h.01</Geometry>
    <Geometry x:Key="IconViewRandom">M4 7h3.5a4 4 0 0 1 3.3 1.8l2.4 3.4a4 4 0 0 0 3.3 1.8H20 M17 11.5l3 2.5-3 2.5 M4 17h3.5a4 4 0 0 0 3.3-1.8 M13.2 8.8A4 4 0 0 1 16.5 7H20 M17 4.5l3 2.5-3 2.5</Geometry>
    <Geometry x:Key="IconFilter">M4 5.5h16l-6 7.2V19l-4-1.8v-4.5z</Geometry>
    <Geometry x:Key="IconNotifications">M6.5 16.5V11a5.5 5.5 0 0 1 11 0v5.5l1.8 2H4.7z M10 20.5a2 2 0 0 0 4 0</Geometry>
    <Geometry x:Key="IconMainMenu">M4 7h16 M4 12h16 M4 17h16</Geometry>
    <Geometry x:Key="IconLibrary">M4.5 5v14 M9 5v14 M4.5 5H9 M4.5 19H9 M13 6.2l4.6-1.4 3.3 13.5-4.6 1.3z</Geometry>
    <Geometry x:Key="IconStatistics">M5.5 19v-7 M10.5 19V6 M15.5 19v-5 M20.5 19V9 M3.5 19.5h18</Geometry>
    <Geometry x:Key="IconWindowMinimize">M6 12h12</Geometry>
    <Geometry x:Key="IconWindowMaximize">M6.5 6.5h11v11h-11z</Geometry>
    <Geometry x:Key="IconWindowRestore">M9.5 6.5h8v8 M6.5 9.5h8v8h-8z</Geometry>
    <Geometry x:Key="IconWindowClose">M6.5 6.5l11 11 M17.5 6.5l-11 11</Geometry>
    <Geometry x:Key="IconDropDown">M6 9l6 6 6-6</Geometry>
    <Geometry x:Key="IconSubmenu">M9 6l6 6-6 6</Geometry>
    <Geometry x:Key="IconCheck">M5 12.5l4.5 5L19 7</Geometry>
    <Geometry x:Key="IconAdd">M5 12h14 M12 5v14</Geometry>
    <Geometry x:Key="IconEdit">M4.5 19.5l1-4.2L16.8 4a2 2 0 0 1 2.8 0l.4.4a2 2 0 0 1 0 2.8L8.7 18.5z M14.5 6.5l3 3</Geometry>
    <Geometry x:Key="IconRemove">M5 7h14 M9 7V5h6v2 M7 7l1 12h8l1-12 M10.5 11v5 M13.5 11v5</Geometry>
    <Geometry x:Key="IconOptions">M4.5 12a1.2 1.2 0 1 0 2.4 0 1.2 1.2 0 0 0-2.4 0 M10.8 12a1.2 1.2 0 1 0 2.4 0 1.2 1.2 0 0 0-2.4 0 M17.1 12a1.2 1.2 0 1 0 2.4 0 1.2 1.2 0 0 0-2.4 0</Geometry>
    <Geometry x:Key="IconPlay">M7 4.8l12.5 7.2L7 19.2l3.2-7.2z</Geometry>
    <Geometry x:Key="IconInfo">M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17z M12 11v5 M12 7.9h.01</Geometry>
    <Geometry x:Key="IconDownload">M12 4v11 M7 10.5l5 5 5-5 M5 19.5h14</Geometry>

    <!-- Content = one of the geometries above, stroked in the inherited foreground. -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource IconSearch}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentPresenter Width="16" Height="16"
                          Content="{DynamicResource IconClear}"
                          ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
</ResourceDictionary>
