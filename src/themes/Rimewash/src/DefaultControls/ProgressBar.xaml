<!--
    Overlay on Playnite Default/DefaultControls/ProgressBar.xaml. The battle timeline: a pencil-framed bar (2px
    WindowPanelSeparatorBrush frame, ProgressBarTrackBrush track) filled teal (ProgressBarForegroundBrush, the WAIT zone) with a
    red CAST end (DangerBrush) on its leading edge and a round wisp (RunningIndicatorBrush) riding the tip. The wisp is hidden
    for indeterminate bars, which keep Playnite's two-hider animation.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="0"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Rectangle Name="PART_Track" Margin="0" />
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                <Grid>
                                    <Border Background="{TemplateBinding Foreground}" CornerRadius="1.5" />
                                    <Border x:Name="Cast" Width="6" HorizontalAlignment="Right" Background="{DynamicResource DangerBrush}" CornerRadius="0,1.5,1.5,0" />
                                    <Control x:Name="Wisp" Template="{DynamicResource WispTemplate}" Foreground="{DynamicResource RunningIndicatorBrush}"
                                             Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-12,0" IsHitTestVisible="False" />
                                    <Grid x:Name="Animation" Visibility="Hidden">
                                        <Rectangle Fill="{TemplateBinding Background}" RadiusX="2" RadiusY="2" Margin="0,0,50,0">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="HiderPreTransform" ScaleX="0"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Rectangle Fill="{TemplateBinding Background}" RadiusX="2" RadiusY="2" RenderTransformOrigin="1, 0" Margin="50,0,0,0">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="HiderPostTransform" ScaleX="1" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                </Grid>
                            </Decorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Value" Value="0">
                            <Setter TargetName="Cast" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Wisp" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Animation" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Cast" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Wisp" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="HiderPreTransform" Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:00:2" AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="HiderPostTransform" Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                                                         To="0" Duration="0:00:2" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
