<!--
    Overlay on Playnite Default/DefaultControls/CheckBox.xaml. The game's option box, measured from the Options screen:
    a 20x20 snow square with a slate frame (CheckBoxBorderBrush, 1.5px, radius 4) and a hand-drawn green tick
    (CheckMarkBrush over a darker PositiveRatingBrush outline) that draws itself in 160ms when the box is checked.
    Indeterminate: a short slate dash. Hover: the frame deepens and a soft gold ring (CheckBoxHoverBorderBrush) shows.
    Label gap 10px. Keyboard focus: CheckBoxFocusVisual.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource CheckBoxFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center">
                                <Border x:Name="HoverRing" Margin="-3" CornerRadius="7" Opacity="0"
                                        BorderThickness="2" BorderBrush="{DynamicResource CheckBoxHoverBorderBrush}" />
                                <Border x:Name="BulletBorder" CornerRadius="4" BorderThickness="1.5"
                                        Background="{DynamicResource CheckBoxCheckMarkBkBrush}"
                                        BorderBrush="{TemplateBinding BorderBrush}" />
                                <!-- Indeterminate dash -->
                                <Path x:Name="Dash" Data="M5.5,10 L14.5,10" Stroke="{DynamicResource CheckBoxBorderBrush}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" />
                                <!-- The tick: an outline and the green stroke, both drawn by animating the dash offset -->
                                <Canvas x:Name="Tick" Width="20" Height="20" Opacity="0">
                                    <Path x:Name="TickOutline" Data="M4.4,10.6 L8.4,14.8 L16,4.6" Stroke="{DynamicResource PositiveRatingBrush}" StrokeThickness="4.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          StrokeDashArray="5,5" StrokeDashOffset="5" />
                                    <Path x:Name="TickFill" Data="M4.4,10.6 L8.4,14.8 L16,4.6" Stroke="{DynamicResource CheckMarkBrush}" StrokeThickness="2.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          StrokeDashArray="8,8" StrokeDashOffset="8" />
                                </Canvas>
                            </Grid>
                            <ContentPresenter DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="10,0,0,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.55" TargetName="HoverRing" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="BulletBorder" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="Tick" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TickOutline" Storyboard.TargetProperty="StrokeDashOffset" From="5" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="TickFill" Storyboard.TargetProperty="StrokeDashOffset" From="8" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Opacity" Value="1" TargetName="Dash" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
