<!--
    Overlay on Playnite Default/DefaultControls/GroupBox.xaml. A snow plate card, the way the game lays its content on
    torn white sheets: SnowPlateTemplate in ExpanderBackgroundBrush over a soft blue shadow (SnowShadowTemplate), headed by the
    title in HeadingFontFamily (the serif of the screen titles) and a dotted pencil rule (DividerTemplate) running to the right.
    Content-sized: the rule is a star column with no width of its own and the sprites have no desired size, so Statistics
    cards still wrap. A group box without a header draws just the body.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid>
                        <Control Template="{DynamicResource SnowShadowTemplate}" Foreground="{DynamicResource PanelShadowBrush}"
                                 Margin="-14,-6,-14,-20" Opacity="0.3" IsHitTestVisible="False" />
                        <Control Template="{DynamicResource SnowPlateTemplate}" Background="{TemplateBinding Background}" IsHitTestVisible="False" />
                        <DockPanel>
                            <Border x:Name="HeaderBorder" DockPanel.Dock="Top" Padding="{DynamicResource GroupBoxHeaderPadding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                               Foreground="{DynamicResource HeadingForegroundBrush}"
                                               FontFamily="{DynamicResource HeadingFontFamily}"
                                               FontSize="{DynamicResource GroupBoxHeaderFontSize}" FontWeight="Normal">
                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                          RecognizesAccessKey="True" />
                                    </TextBlock>
                                    <Control Grid.Column="1" Template="{DynamicResource DividerTemplate}" Margin="12,0,0,5" VerticalAlignment="Bottom"
                                             Foreground="{DynamicResource HeadingRuleBrush}" />
                                </Grid>
                            </Border>
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" DockPanel.Dock="Top"
                                              Margin="{TemplateBinding Padding}"/>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="HeaderBorder" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
