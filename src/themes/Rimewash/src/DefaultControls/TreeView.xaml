<!--
    Overlay on Playnite Default/DefaultControls/TreeView.xaml: the Settings and Add-ons section list (also the filter
    and explorer trees), drawn as the game's menu list. Rows are 30px (28 + 1px gaps) bare lines in the body font.
    Idle: TextBrushDarker label, nothing behind it. Hover: the dry-brush swipe (SwipeTemplate in NormalBorderBrush, slate, so it reads on snow
    and on the wash) fades in faint, TextBrush label. Selected: the swipe in full, a TextBrush label and the gold chevron (ChevronTemplate with
    its glow) sliding in left of the line, all animated on Opacity. Children indent under a pencil hairline. Expanders are
    IconSubmenu / IconDropDown at 12px in the row's own colour. Width 256 (Settings) and 280 (Add-ons) by window trigger
    only; the scroll lane is reserved there (Visible) so opening a node never reflows the window.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
        <Style.Resources>
            <!-- Section breaks in the Settings tree: a hairline instead of Playnite's heavy line. -->
            <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
                <Setter Property="Tag" Value="RimewashNavigationDivider" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </Style.Resources>
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer Focusable="False" Padding="0,8"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowSettings">
                <Setter Property="Width" Value="256" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(AutomationProperties.AutomationId), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="WindowExtensions">
                <Setter Property="Width" Value="280" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Padding" Value="10,0,12,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel>
                        <Grid x:Name="SelectionBorder" Background="Transparent" MinHeight="28" Margin="20,1,6,1">
                            <!-- Hover plate and selected plate are separate layers so the two states never share a look. -->
<Control x:Name="HoverPlate" Template="{DynamicResource SwipeTemplate}" Background="{DynamicResource NormalBorderBrush}" Opacity="0" IsHitTestVisible="False" />
                            <Control x:Name="SelectedPlate" Template="{DynamicResource SwipeTemplate}" Background="{DynamicResource NormalBorderBrush}" Opacity="0" IsHitTestVisible="False" />
                            <!-- The cursor, in the gutter left of the line: it slides in when the row is selected. -->
                            <Grid x:Name="Marker" Width="10" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-16,0,0,0"
                                  Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><TranslateTransform x:Name="MarkerShift" X="-6" /></Grid.RenderTransform>
                                <Control Template="{DynamicResource ChevronGlowTemplate}" Width="22" Height="26" Margin="-6" Foreground="{DynamicResource FocusHaloBrush}" />
                                <Control Template="{DynamicResource ChevronTemplate}" Foreground="{DynamicResource HeadingMarkerBrush}" />
                            </Grid>
                            <DockPanel Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                <ToggleButton x:Name="Expander" ClickMode="Press" DockPanel.Dock="Left" Width="14" Height="16" Margin="0,0,4,0"
                                              IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Style>
                                        <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseStyle}">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                        <Grid Background="Transparent">
                                                            <ContentControl x:Name="Collapsed" Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <ContentControl x:Name="Expanded" Content="{DynamicResource IconDropDown}" ContentTemplate="{DynamicResource IconTemplate}"
                                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" TargetName="Expanded" />
                                                                <Setter Property="Visibility" Value="Collapsed" TargetName="Collapsed" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" DockPanel.Dock="Left" VerticalAlignment="Center" RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="180"
                                                       FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DockPanel>
                        </Grid>
                        <!-- Children: indented under a hairline. -->
                        <Border x:Name="ItemsHost" Margin="12,0,0,0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
                            <ItemsPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemsHost" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="Visibility" Value="Hidden" TargetName="Expander" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="SelectionBorder">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0.62" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.04" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="MarkerShift" Storyboard.TargetProperty="X" To="0" BeginTime="0:0:0.04" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="MarkerShift" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- TreeView wraps Separator objects in TreeViewItem containers; suppress interaction on that container too. -->
            <DataTrigger Binding="{Binding Header.Tag, RelativeSource={RelativeSource Self}}" Value="RimewashNavigationDivider">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="IsSelected" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                            <ContentPresenter ContentSource="Header" Margin="14,6,14,6" IsHitTestVisible="False" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
