<!--
    Overlay on Playnite Default/DefaultControls/ContextMenu.xaml. Every menu and dropdown list (the hamburger menu,
    top bar dropdowns through TopPanelMenu, GameMenu, GameGroupMenu, TrayContextMenu, text box menus, ComboBox lists
    and Playnite's multi-select boxes) is Child of Light's frosted watercolour sheet: frost paper (PopupBackgroundBrush)
    mottled with CloudTemplate in BackgroundToneColor, a 1px pencil-blue rim (PopupBorderBrush) with CornerRadiusSmall
    (4px), a top and bottom dotted pencil trim (DividerTemplate) and a small gold hoarfrost diamond at top-right
    (LocalMenuPanelTemplate, shared by ComboBox.xaml, CustomControls/ComboBoxList.xaml and
    CustomControls/FilterSelectionBox.xaml). Rows and group breaks: Menu.xaml. Recipe: docs/themes/menus.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalMenuPanelTemplate" TargetType="{x:Type Control}">
        <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusSmall}" />
            <!-- Soft watercolour cloud mottling inside the frosted sheet -->
            <Control Template="{DynamicResource CloudTemplate}" Margin="1" Opacity="0.35"
                     Foreground="{DynamicResource ProgressBarTrackBrush}" Focusable="False" IsTabStop="False" />
            <!-- Top dotted pencil trim and hoarfrost diamond accent -->
            <Control Template="{DynamicResource DividerTemplate}" Margin="10,3,22,0" VerticalAlignment="Top"
                     Foreground="{DynamicResource HeadingRuleBrush}" Opacity="0.85" Focusable="False" IsTabStop="False" />
            <Path Width="7" Height="7" Margin="0,2,9,0" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Data="M 3.5,0 L 7,3.5 L 3.5,7 L 0,3.5 Z" Fill="{DynamicResource HeadingMarkerBrush}" />
            <Control Template="{DynamicResource DividerTemplate}" Margin="10,0,10,3" VerticalAlignment="Bottom"
                     Foreground="{DynamicResource HeadingRuleBrush}" Opacity="0.55" Focusable="False" IsTabStop="False" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid x:Name="MenuPanel" MinWidth="220" SnapsToDevicePixels="True" Grid.IsSharedSizeScope="True">
                        <Control Template="{DynamicResource LocalMenuPanelTemplate}" Focusable="False" IsTabStop="False" />
                        <ScrollViewer Margin="0,8,0,7" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="4,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
