<!--
    Overlay on Playnite Default/CustomControls/SidebarItem.xaml.
    Rail item: a 44x40 compact item (repo shell rule) with a 16px glyph on the slate rail. The menus of the game mark the
    selected line with a white dry-brush swipe and a gold chevron cursor, so that is the whole language here:
      idle     glyph in SidebarItemForegroundBrush (frost wash);
      hover    a faint swipe fades in (0.18) and the glyph lifts to snow;
      current  the full swipe (ListItemSelectedBrush) behind an ink glyph, and the gold chevron slides in on the rail's
               outer edge with its lantern glow (HeadingMarkerBrush). The chevron is hidden for a top or bottom rail.
    The whole 44x40 item is the hit target. Icons are scaled into a fixed 16x16 IconHost (no IconPadding); Library and
    Statistics use the theme's icons. PART_ProgressStatus (shown while an add-on reports progress) is a thin bar along the
    item's bottom edge. An item with no content is a bare marker: WarningBrush fill.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="Tile" SnapsToDevicePixels="True" Width="32" Height="32"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Control x:Name="HoverSwipe" Template="{DynamicResource SwipeCompactTemplate}" Margin="2,3,2,3" Opacity="0"
                                 Background="{DynamicResource ListItemSelectedBrush}" IsHitTestVisible="False" />
                        <Control x:Name="SelectedSwipe" Template="{DynamicResource SwipeCompactTemplate}" Margin="2,3,-4,3" Opacity="0"
                                 Background="{DynamicResource ListItemSelectedBrush}" IsHitTestVisible="False" />
                        <Grid x:Name="IconHost" Width="16" Height="16" TextElement.Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox x:Name="ItemIcon">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                            <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                                            IsHitTestVisible="False"
                                            ContentTemplate="{DynamicResource IconTemplate}" />
                        </Grid>
                        <!-- The cursor: chevron with its glow on the outer edge, sliding in when the item becomes current. -->
                        <Grid x:Name="Marker" Width="14" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,-3,0" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="MarkerShift" X="-8" />
                            </Grid.RenderTransform>
                            <Control Template="{DynamicResource ChevronGlowTemplate}" Width="30" Height="34" Margin="-8"
                                     Foreground="{DynamicResource FocusHaloBrush}" />
                            <Control Template="{DynamicResource ChevronTemplate}" Foreground="{DynamicResource HeadingMarkerBrush}" />
                        </Grid>
                        <ProgressBar x:Name="PART_ProgressStatus" Height="3" Margin="12,0,12,3"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource ProgressBarForegroundBrush}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverSwipe" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverSwipe" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" TargetName="PART_ProgressStatus" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Marker" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedSwipe" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.05" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="MarkerShift" Storyboard.TargetProperty="X" To="0" BeginTime="0:0:0.05" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectedSwipe" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="MarkerShift" Storyboard.TargetProperty="X" To="-8" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Marker" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Marker" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDark}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                <Setter Property="Margin" Value="2,0,2,0" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
