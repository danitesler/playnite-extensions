<!--
    Cropmark: DerivedStyles/StandardWindowStyle.xaml (Settings, Add-ons, Game Editor, every Playnite dialog).
    44px Bristol board title band (CaptionHeight=44, ContentPresenter top margin=44) with a 5px Marker Orange
    leading edge bar, Cropmark Brand Mark, Anton display title, non-photo blue =|+|= registration crosshair,
    subtle Ben-Day halftone corner (in a zero-desired-size Canvas), 46x44 WindowBarButton captions, and closing 2px ink rule.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource NormalBorderBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px Bristol Title Band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource WindowTitleBackgroundBrush}"
                                      ClipToBounds="True" SnapsToDevicePixels="True">
                                    <!-- Leading 5px Marker Orange stripe -->
                                    <Rectangle Width="5" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />

                                    <!-- Subtle Ben-Day halftone in Canvas so small dialogs never expand -->
                                    <Canvas IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0">
                                        <Control Canvas.Left="-318" Canvas.Top="0" Width="180" Height="44"
                                                 Template="{DynamicResource LocalHalftoneCornerTemplate}"
                                                 Foreground="{DynamicResource LocalCropGuideBrush}" Opacity="0.22" />
                                    </Canvas>

                                    <!-- Closing 2px charcoal ink rule -->
                                    <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource NormalBorderBrush}" IsHitTestVisible="False" />

                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
                                            <!-- Cropmark Brand Mark badge -->
                                            <Border Width="24" Height="24" Margin="0,0,10,0"
                                                    Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                                    IsHitTestVisible="False">
                                                <Control Width="16" Height="16" Template="{DynamicResource BrandMarkTemplate}"
                                                         Foreground="{DynamicResource MainMenuButtonForegroundBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontSize="{DynamicResource FontSizeLarger}"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <Control Margin="14,0,0,0" Template="{DynamicResource LocalRegistrationMarkTemplate}"
                                                     Foreground="{DynamicResource LocalCropGuideBrush}" Opacity="0.72"
                                                     VerticalAlignment="Center" IsHitTestVisible="False" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter Property="Text" Value="{DynamicResource LOCSettingsLabel}" TargetName="PART_TextTitle" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource LocalCropGuideBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
