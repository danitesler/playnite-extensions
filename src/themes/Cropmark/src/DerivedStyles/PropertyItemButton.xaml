<!--
    Cropmark: DerivedStyles/PropertyItemButton.xaml.
    Default: blueprint ink link (#005F99) underlining on hover.
    Tag="Chip" (ItemsControl ancestor): stamped 0px inked comic production tags with a 3px non-photo blue left
    accent bar that snaps to Marker Orange + warm orange wash on hover. Uses ControlCornerRadius (never CornerRadiusFull).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PropertyItemButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="ChipPlate" Visibility="Collapsed"
                                Background="{DynamicResource PropertyItemBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Rectangle x:Name="ChipBar" Width="3" HorizontalAlignment="Left"
                                       Fill="{DynamicResource LocalCropGuideBrush}" IsHitTestVisible="False" />
                        </Border>
                        <TextBlock x:Name="Label" Margin="{TemplateBinding Padding}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                            <Setter TargetName="ChipPlate" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource PropertyItemForegroundBrush}" />
                            <Setter Property="Padding" Value="8,2,7,2" />
                            <Setter Property="Margin" Value="0,0,5,5" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Label" Property="TextDecorations" Value="{x:Null}" />
                            <Setter TargetName="ChipPlate" Property="Background" Value="{DynamicResource PropertyItemHoverBackgroundBrush}" />
                            <Setter TargetName="ChipBar" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
