<!--
    Cropmark: DerivedStyles/PlayButton.xaml (+ RunningActionIndicator).
    Hero Moment (PlayButton): Main Menu EPISODE-inspired charcoal ink slab (#2D3024) with an oversized 10px
    Marker Orange (#FF7916) left drop-block, 2px deep ink border, hard 3px orange offset backing lip, and
    Barlow Condensed Bold Italic uppercase label.
    - Hover: textured diagonal Marker Orange sheen sweeps across the slab, charcoal body lifts, and four vivid
      non-photo blue corner crop ticks snap outward (150ms CubicEase).
    - Press: separate sunken pressed layer collapses the offset lip (90ms).
    - Launching / Running: plate fills solid RunningIndicatorBrush (Punish! Teal #00756B), darkened by ScrimBrush
      RunningBreath (keeping paper-white label >= 6.5:1), swept by angled RunningScan (1.55s loop), and framed by
      RunningActionIndicator with 3 skewed comic Punish! spark bars in a 34px right strip (PlayRoom padded 0,0,34,0
      so bars never overlap LAUNCHING / RUNNING / Cancel).
    - Cancel on hover: single MultiDataTrigger on IsRunning + RelativeSource Self IsMouseOver (never TemplatedParent).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinWidth" Value="156" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="18,0,18,0" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontFamily" Value="{DynamicResource LocalCondensedFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Hard 3px Marker Orange offset backing lip (EPISODE construction-paper backing) -->
                        <Border x:Name="OffsetLip" Margin="3,3,-3,-3" Background="{DynamicResource PrimaryButtonGlowBrush}"
                                IsHitTestVisible="False" />

                        <!-- Expanding vivid non-photo blue corner crop ticks on hover (Collapsed at rest) -->
                        <Control x:Name="HoverCrops" Margin="-5" Template="{DynamicResource CornerMarksTemplate}"
                                 Foreground="{DynamicResource FocusBrush}"
                                 Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Control.RenderTransform>
                                <ScaleTransform x:Name="CropScale" ScaleX="0.92" ScaleY="0.92" />
                            </Control.RenderTransform>
                        </Control>

                        <!-- Main Slab -->
                        <Border x:Name="PlayFill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid ClipToBounds="True">
                                <!-- Idle oversized 10px Marker Orange left drop-block (hidden while launching/running) -->
                                <Border x:Name="OrangeDropBlock" Width="10" HorizontalAlignment="Left"
                                        Background="{DynamicResource GlyphBrush}"
                                        BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="0,0,1.5,0"
                                        IsHitTestVisible="False" />

                                <!-- Hover layer: lifted charcoal + diagonal textured marker-orange sheen (Collapsed at rest) -->
                                <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Border Background="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Margin="10,0,0,0" />
                                    <Rectangle Margin="10,0,0,0" Fill="{DynamicResource GlyphBrush}" Opacity="0.28"
                                               OpacityMask="{DynamicResource LocalMarkerStrokeMaskBrush}"
                                               RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="SheenScale" ScaleX="0.25" ScaleY="1" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>

                                <!-- Pressed layer (Collapsed at rest) -->
                                <Border x:Name="PressedLayer" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Running / Launching plate scrim (keeps paper-white label >= 6.5:1 across all frames) -->
                                <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}"
                                        Visibility="Collapsed" Opacity="0.32" IsHitTestVisible="False" />

                                <!-- Launching angled Punish! sweep (below label, inside plate shape) -->
                                <Border x:Name="RunningScan" Background="{DynamicResource LocalRunningHighlightBrush}"
                                        Visibility="Collapsed" Opacity="0.38" IsHitTestVisible="False">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.42" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>

                                <!-- Running hover darken scrim under Cancel label -->
                                <Border x:Name="RunningHoverDim" Background="{DynamicResource ScrimBrush}"
                                        Opacity="0" IsHitTestVisible="False" />

                                <!-- Label host (PlayRoom reserves 34px right strip while Launching/Running) -->
                                <!-- RunningMarkRoom left="0" right="34" -->
                                <Border x:Name="PlayRoom" Margin="10,0,0,0">
                                    <StackPanel x:Name="PlayContent" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="{TemplateBinding Padding}">
                                        <ContentControl x:Name="PlayGlyph" Width="13" Height="13" Margin="0,0,8,0"
                                                        Content="{DynamicResource IconPlay}" ContentTemplate="{DynamicResource IconTemplate}"
                                                        Foreground="{DynamicResource GlyphBrush}" VerticalAlignment="Center"
                                                        IsHitTestVisible="False" />
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                    </StackPanel>
                                </Border>

                                <!-- Cancel hover label (shown ONLY while IsRunning AND button itself IsMouseOver) -->
                                <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                           Visibility="Collapsed" Opacity="0" Margin="0,0,34,0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource LocalCondensedFontFamily}"
                                           FontSize="18" FontWeight="Bold" FontStyle="Italic"
                                           Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Idle Hover (strictly gated off during IsLaunching / IsRunning so animated HoverLayer never paints over a running plate) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverCrops" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="SheenScale" Storyboard.TargetProperty="ScaleX" From="0.25" To="1" Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverCrops" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CropScale" Storyboard.TargetProperty="ScaleX" From="0.92" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CropScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="HoverCrops" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.24" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverCrops" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.22" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OffsetLip" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedLayer" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressedLayer" Property="Opacity" Value="0.85" />
                        </Trigger>

                        <!-- LAUNCHING: Punish! Teal plate + ScrimBreath 0.42 + angled RunningScan sweep -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PlayFill" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="OffsetLip" Property="Background" Value="{DynamicResource LocalRunningHighlightBrush}" />
                            <Setter TargetName="OrangeDropBlock" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverCrops" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayRoom" Property="Margin" Value="0" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity"
                                                         From="0.34" To="0.52" Duration="0:0:0.22" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.42" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.42" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.42" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.422" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.422" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING: Punish! Teal plate + slow 3.0s idle ScrimBreath -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PlayFill" Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                            <Setter TargetName="OffsetLip" Property="Background" Value="{DynamicResource LocalRunningHighlightBrush}" />
                            <Setter TargetName="OrangeDropBlock" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverCrops" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayRoom" Property="Margin" Value="0" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,34,0" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.22" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.40" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.22" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- RUNNING + HOVER (RelativeSource Self, NEVER TemplatedParent): Cancel label + dim scrim -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="RunningCancelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RunningActionIndicator: Overlay placed over Play/ContextAction cell in DetailsViewGameOverview & GridViewGameOverview -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.94" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2">
                            <Border BorderBrush="{DynamicResource LocalRunningHighlightBrush}" BorderThickness="1" Opacity="0.7" />
                        </Border>

                        <!-- Foot progress bar (5px above bottom) -->
                        <Grid Height="2" Margin="6,0,6,5" VerticalAlignment="Bottom">
                            <Rectangle Fill="{DynamicResource LocalRunningHighlightBrush}" Opacity="0.32" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource PrimaryButtonForegroundBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <!-- 3 Skewed Comic Punish! Spark Bars on right edge (clear of 34px PlayRoom) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,2">
                            <Rectangle x:Name="SparkBar1" Width="3" Height="10" Margin="0,0,3,0"
                                       Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.55" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="Bar1ScaleY" ScaleY="0.55" />
                                        <SkewTransform AngleX="-12" />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="SparkBar2" Width="3" Height="14" Margin="0,0,3,0"
                                       Fill="{DynamicResource LocalRunningHighlightBrush}" Opacity="0.7" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="Bar2ScaleY" ScaleY="0.7" />
                                        <SkewTransform AngleX="-12" />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="SparkBar3" Width="3" Height="11"
                                       Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.55" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="Bar3ScaleY" ScaleY="0.6" />
                                        <SkewTransform AngleX="-12" />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1" KeySpline="0.4,0 0.2,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar1ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.78" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.96" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar2ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.86" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.04" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar3ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.55">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.94" Value="0.45" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.12" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar1ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="0.95" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.55" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar2ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.75" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.75" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar3ScaleY" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.0">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.0" Value="0.95" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.6" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42" />
                                        <DoubleAnimation Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
