<!--
    Cropmark: DefaultControls/GroupBox.xaml.
    Content-sized inked comic panel card (zero fixed widths >= 200 so Playnite's Statistics sections wrap cleanly).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Hard 3px bottom-left offset charcoal backing (content-sized, no fixed width) -->
                        <Border Margin="0,3,3,0" Background="{DynamicResource LocalBackingPaperBrush}" Opacity="0.88"
                                IsHitTestVisible="False" />
                        <Border Margin="3,0,0,3" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource NormalBrushDark}"
                                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="5" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"
                                                   Fill="{DynamicResource GlyphBrush}" />
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                          TextElement.FontFamily="{DynamicResource LocalCondensedFontFamily}"
                                                          TextElement.FontSize="{DynamicResource FontSizeLarge}"
                                                          TextElement.FontWeight="Bold"
                                                          TextElement.Foreground="{DynamicResource HeadingForegroundBrush}" />
                                    </StackPanel>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
