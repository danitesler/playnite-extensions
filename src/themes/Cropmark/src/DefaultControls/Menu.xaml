<!--
    Cropmark: DefaultControls/Menu.xaml.
    Menus signature levers (docs/themes/menus.md):
    - Panel: LocalMenuBoardTemplate (perforated tear-off Bristol notepad, 3px charcoal offset, blue trim + =|+|=).
    - Highlight: 30px rows; textured Marker Orange brush wipe (ScaleX 0.88->1, 120ms) with 1px ink keylines,
      sliding charcoal triangle pointer, and +2px label nudge in deep ink (6.30:1); Icon Foreground explicitly set.
    - Group break: 10px dashed non-photo blue fold rule led by a || trim tick (DividerTemplate).
    - Shortcuts: monochrome ink-ring key-prompt pills inverting to solid charcoal with cream text on highlight.
    - Marked rows: Exit (Alt+Q) uses Issue Crimson at rest and solid Issue Crimson marker plate with cream ink (5.34:1)
      on highlight; checked rows draw a 14x14 sky-blue inked square with bold charcoal check.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group Break: 10px dashed non-photo blue fold rule with || trim tick -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="4,0,4,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Control Template="{DynamicResource DividerTemplate}"
                             Foreground="{DynamicResource LocalCropGuideBrush}"
                             BorderBrush="{DynamicResource MenuSeparatorBrush}"
                             VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SubmenuItem (plain leaf row, 30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Textured Marker Orange highlight wipe -->
            <Grid x:Name="HighlightPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.88" ScaleY="1" />
                </Grid.RenderTransform>
                <Border x:Name="HighlightFill" Background="{DynamicResource MenuItemHoverBrush}"
                        BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="0,1,0,1" />
                <Control x:Name="HighlightTexture" Template="{DynamicResource LocalMarkerFillTemplate}"
                         Foreground="{DynamicResource HighlightGlyphBrush}" Opacity="0.45" />
                <Rectangle x:Name="HighlightEdge" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource SelectedBorderBrush}" />
            </Grid>

            <!-- Sliding charcoal ink triangle pointer (cleanly clear of the icon column) -->
            <Path x:Name="CursorArrow" Data="M0,0 L5,3.5 L0,7 Z" Width="5" Height="7"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                  Fill="{DynamicResource SelectedForegroundBrush}"
                  Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="CursorSlide" X="-5" />
                </Path.RenderTransform>
            </Path>

            <Grid Margin="15,0,8,0">
                <Grid.ColumnDefinitions>
                    <!-- Fixed icon column (16px icon + 8px gap = 24px) -->
                    <ColumnDefinition Width="24" />
                    <!-- Plain * label column (never SharedSizeGroup on star column) -->
                    <ColumnDefinition Width="*" />
                    <!-- Shared shortcut column flush right -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                    <!-- Arrow spacer column matching SubmenuHeader -->
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <!-- Icon or Check square -->
                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" TextElement.Foreground="{DynamicResource TextBrush}" />

                <Border x:Name="CheckBoxMark" Grid.Column="0" Width="14" Height="14"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource LocalDraftingTabBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.2"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <ContentControl x:Name="CheckGlyph" Width="10" Height="10"
                                    Content="{DynamicResource IconCheck}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                    Foreground="{DynamicResource SelectedForegroundBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Label (nudges +2px right on highlight) -->
                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{DynamicResource TextBrush}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelSlide" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <!-- Monochrome ink-ring key-prompt pill shortcut -->
                <Border x:Name="ShortcutPill" Grid.Column="2" Margin="14,0,0,0" Padding="7,1"
                        HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="9"
                        Background="{DynamicResource ContentBackgroundBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrushDarker}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutPill" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutPill" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckBoxMark" Property="Visibility" Value="Visible" />
            </Trigger>

            <!-- Exit at rest: Issue Crimson label, icon, and shortcut ring -->
            <Trigger Property="InputGestureText" Value="Alt+Q">
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutPill" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Trigger>

            <!-- Standard Highlight: Textured Marker Orange sweep + charcoal cursor + deep ink text & icon (keep FontWeight constant so menu never resizes on hover) -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="CheckBoxMark" Property="Background" Value="{DynamicResource LocalBackingPaperBrush}" />
                <Setter TargetName="CheckGlyph" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="ShortcutPill" Property="Background" Value="{DynamicResource LocalBackingPaperBrush}" />
                <Setter TargetName="ShortcutPill" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuItemHighlightIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.88" To="1" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="CursorSlide" Storyboard.TargetProperty="X" From="-6" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuItemHighlightOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!-- Exit Highlight: Issue Crimson plate + cream paper text, icon, cursor & pill (5.34:1) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True" />
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HighlightFill" Property="Background" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="HighlightTexture" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="HighlightTexture" Property="Opacity" Value="0.12" />
                <Setter TargetName="HighlightEdge" Property="Fill" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="CursorArrow" Property="Fill" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutPill" Property="Background" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutPill" Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SubmenuHeader (row opening a child popup submenu, 30px) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True">
            <!-- Held plate while submenu is open (never flickers when pointer enters submenu) -->
            <Border x:Name="OpenPlate" Background="{DynamicResource LocalDraftingTabBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,1,0,1"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource GlyphBrush}" />
            </Border>

            <!-- Animated Marker Orange highlight wipe -->
            <Grid x:Name="HighlightPlate" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.88" ScaleY="1" />
                </Grid.RenderTransform>
                <Border Background="{DynamicResource MenuItemHoverBrush}"
                        BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="0,1,0,1" />
                <Control Template="{DynamicResource LocalMarkerFillTemplate}"
                         Foreground="{DynamicResource HighlightGlyphBrush}" Opacity="0.45" />
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource SelectedBorderBrush}" />
            </Grid>

            <Path x:Name="CursorArrow" Data="M0,0 L5,3.5 L0,7 Z" Width="5" Height="7"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                  Fill="{DynamicResource SelectedForegroundBrush}"
                  Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="CursorSlide" X="-5" />
                </Path.RenderTransform>
            </Path>

            <Grid Margin="15,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="Icon" Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  ContentSource="Icon" TextElement.Foreground="{DynamicResource TextBrush}" />

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" VerticalAlignment="Center"
                                  ContentSource="Header" RecognizesAccessKey="True"
                                  TextElement.Foreground="{DynamicResource TextBrush}">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="LabelSlide" X="0" />
                    </ContentPresenter.RenderTransform>
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <ContentControl x:Name="SubArrow" Grid.Column="3" Width="10" Height="10"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Content="{DynamicResource IconSubmenu}" ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource TextBrushDarker}" IsHitTestVisible="False" />
            </Grid>

            <Popup x:Name="Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-10"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade">
                <Grid MinWidth="208" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalMenuBoardTemplate}"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                    <ScrollViewer Margin="11,10,6,6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OpenPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubHeaderHighlightIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.88" To="1" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="CursorSlide" Storyboard.TargetProperty="X" From="-6" To="0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubHeaderHighlightOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="LabelSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightPlate" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CursorArrow" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RowRoot" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
