<!--
    Cropmark: DefaultControls/ProgressBar.xaml.
    Modeled on EPISODE's non-photo blue PROGRESS strip in a sharp inked track; takes Height from TemplateBinding
    with MinHeight=8 so TopPanel's PART_ProgressGlobal (Height=12) breathes cleanly behind loading text.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid Height="{TemplateBinding Height}" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True" Margin="1.5">
                            <Border Background="{TemplateBinding Foreground}" />
                            <Rectangle Width="4" HorizontalAlignment="Right" Fill="{DynamicResource GlyphBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
