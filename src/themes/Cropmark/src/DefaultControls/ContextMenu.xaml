<!--
    Cropmark: DefaultControls/ContextMenu.xaml.
    Signature menu panel (LocalMenuBoardTemplate) shared by ContextMenu, TopPanelMenu, submenus, and ComboBox lists:
    PAUSE MENU / CONFIRMATION perforated tear-off Bristol notepad (#F5EFE5), 1.5px sumi-olive ink rim,
    3px hard offset charcoal backing lip (no DropShadowEffect), vertical dashed left tear-off perforation line,
    3px non-photo blue top trim bar with centered =|+|= registration mark, and 3% paper rag grain.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Tear-Off Bristol Board Menu Panel Template (zero DropShadowEffect) -->
    <ControlTemplate x:Key="LocalMenuBoardTemplate" TargetType="{x:Type Control}">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- Hard 3px offset charcoal construction-paper backing -->
            <Border Margin="3,3,0,0" Background="{DynamicResource LocalBackingPaperBrush}" />
            <!-- Main cream Bristol tear-off sheet -->
            <Border Margin="0,0,3,3" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="{DynamicResource PopupBorderThickness}">
                <Grid ClipToBounds="True">
                    <!-- Subtle Bristol paper grain -->
                    <Control Template="{DynamicResource LocalPaperGrainTemplate}"
                             Foreground="{DynamicResource NormalBorderBrush}" Opacity="0.035" />
                    <!-- 3px non-photo blue top trim band -->
                    <Rectangle Height="3" VerticalAlignment="Top" Fill="{DynamicResource LocalCropGuideBrush}" />
                    <!-- Centered =|+|= registration tick along top edge -->
                    <Control Template="{DynamicResource LocalRegistrationMarkTemplate}"
                             Foreground="{DynamicResource LocalCropGuideBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0.85" />
                    <!-- Vertical dashed tear-off notepad perforation seam (stretches cleanly with zero fixed height) -->
                    <Rectangle Width="1" Margin="7,8,0,6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                               Stroke="{DynamicResource NormalBorderBrush}" StrokeThickness="1"
                               StrokeDashArray="2.5,2.5" Opacity="0.45" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="MinWidth" Value="216" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid Margin="0,0,0,0" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalMenuBoardTemplate}"
                                 Focusable="False" IsTabStop="False" IsHitTestVisible="False" />
                        <ScrollViewer Margin="11,10,6,6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle"
                                            Grid.IsSharedSizeScope="True" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
