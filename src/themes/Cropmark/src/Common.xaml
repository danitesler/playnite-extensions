<!--
    Cropmark: Common.xaml — spacing keys, shared white-mask ImageBrushes, Bristol drafting chrome templates
    (BrandMarkTemplate, DividerTemplate, CornerMarksTemplate, RegistrationHeaderTemplate, LocalMarkerFillTemplate,
    LocalPaperGrainTemplate, LocalHalftoneCornerTemplate, EmptyGameTemplate).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Spacing & Metric Keys (per repo FormControlHeight & Menu rules) -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>               <!-- Standard 32px inputs, combos, buttons -->
    <sys:Double x:Key="IconSize">16</sys:Double>                    <!-- Compact rail and top bar glyphs -->
    <sys:Double x:Key="GameBannerHeight">300</sys:Double>           <!-- Default hero banner height (0..600) -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>             <!-- Default banner darkening slider (0..1) -->
    <Thickness x:Key="ButtonPadding">14,4</Thickness>               <!-- 1.5px ink border + 4px v-pad = 32px -->
    <Thickness x:Key="InputPadding">9,4</Thickness>                 <!-- TextBox / PasswordBox / ComboBox -->
    <Thickness x:Key="MenuPadding">12,6,6,6</Thickness>             <!-- Tear-off notepad menu board inset -->
    <Thickness x:Key="MenuItemPadding">10,4</Thickness>             <!-- Compact 30px menu rows -->
    <Thickness x:Key="ComboBoxDropDownPadding">12,5,5,5</Thickness> <!-- Tear-off ComboBox list inset -->
    <Thickness x:Key="ComboBoxItemPadding">10,4</Thickness>         <!-- 30px ComboBox rows -->
    <Thickness x:Key="ListBoxItemPadding">10,5</Thickness>          <!-- ListBox rows -->
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>      <!-- Framed comic-panel GroupBox inset -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>              <!-- Charcoal ink tooltip inset -->

    <!-- Shared White-Mask FX ImageBrushes (recolored live by ThemeModifier via Fill/Background) -->
    <ImageBrush x:Key="LocalMarkerStrokeMaskBrush" ImageSource="{ThemeFile 'Images/fx/marker-stroke.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalPaperGrainMaskBrush" ImageSource="{ThemeFile 'Images/fx/paper-grain.png'}"
                TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute" Stretch="None" />
    <ImageBrush x:Key="LocalBackingEdgeMaskBrush" ImageSource="{ThemeFile 'Images/fx/backing-edge.png'}" Stretch="Fill" />
    <ImageBrush x:Key="LocalHalftoneCornerMaskBrush" ImageSource="{ThemeFile 'Images/fx/halftone-corner.png'}" Stretch="UniformToFill" />

    <!-- Popup Border -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard Focus Visual (vivid non-photo blueprint ring) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Textured Comic Marker Brush Layer (recolored by Foreground) -->
    <ControlTemplate x:Key="LocalMarkerFillTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalMarkerStrokeMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Subtle Bristol Rag Paper Grain Layer (sparse chrome only) -->
    <ControlTemplate x:Key="LocalPaperGrainTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalPaperGrainMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Comic Ben-Day Halftone Corner Layer (sparse chrome only) -->
    <ControlTemplate x:Key="LocalHalftoneCornerTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalHalftoneCornerMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Cropmark Brand Mark (4 corner L-crops + cardinal registration ticks + 4-point spark reticle) -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="64" Height="64">
                <Path Fill="{DynamicResource GlyphBrush}"
                      Data="M6,6 H20 V11 H11 V20 H6 Z M44,6 H58 V20 H53 V11 H44 Z M6,44 H11 V53 H20 V58 H6 Z M53,44 H58 V58 H44 V53 H53 Z" />
                <Path Fill="{DynamicResource LocalDraftingTabBrush}"
                      Data="M29.5,4 H34.5 V15 H29.5 Z M29.5,49 H34.5 V60 H29.5 Z M4,29.5 H15 V34.5 H4 Z M49,29.5 H60 V34.5 H49 Z" />
                <Path Fill="{TemplateBinding Foreground}"
                      Data="F0 M32,14 L38,26 L50,32 L38,38 L32,50 L26,38 L14,32 L26,26 Z M32,25 L35.5,32 L32,39 L28.5,32 Z" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!-- Non-Photo Blue Dashed Fold Rule with Left Trim Tick (content-sized safe — safe inside GroupBox/Statistics) -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="10" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Miniature || trim tick -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                <Rectangle Width="1.5" Height="6" Fill="{TemplateBinding Foreground}" />
                <Rectangle Width="1.5" Height="6" Margin="2,0,0,0" Fill="{TemplateBinding Foreground}" />
            </StackPanel>
            <!-- Dashed fold line inside ClipToBounds zero-desired-size Canvas (safe inside GroupBox/Statistics) -->
            <Grid Grid.Column="1" Height="2" VerticalAlignment="Center" ClipToBounds="True" SnapsToDevicePixels="True">
                <Canvas Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Line X1="0" Y1="1" X2="2000" Y2="1" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"
                          StrokeDashArray="3,3" />
                </Canvas>
            </Grid>
        </Grid>
    </ControlTemplate>

    <!-- Four Sharp L-Shaped Corner Cropmarks (zero fixed width — safe for cards, covers, Play button) -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Data="M0,10 L0,0 L10,0 L10,2 L2,2 L2,10 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M0,0 L10,0 L10,10 L8,10 L8,2 L0,2 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M0,0 L2,0 L2,8 L10,8 L10,10 L0,10 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M8,0 L10,0 L10,10 L0,10 L0,8 L8,8 Z" Fill="{TemplateBinding Foreground}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <!-- Non-Photo Blue =|+|= Registration Crosshair Motif (compact 52x9 ornament) -->
    <ControlTemplate x:Key="LocalRegistrationMarkTemplate" TargetType="Control">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Rectangle Width="14" Height="3" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            <Path Data="M3,0 H5 V3 H8 V5 H5 V8 H3 V5 H0 V3 H3 Z" Width="8" Height="8" Margin="4,0"
                  Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            <Rectangle Width="14" Height="3" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" />
        </StackPanel>
    </ControlTemplate>

    <!-- Empty Game Page (Bristol Drafting Board + Breathing Registration Reticle + LOCErrorNoGameSelected) -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid Background="Transparent" Margin="28" SnapsToDevicePixels="True">
            <Grid MaxWidth="440" MaxHeight="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Offset charcoal construction-paper backing -->
                <Border Margin="0,6,6,0" Background="{DynamicResource LocalBackingPaperBrush}" Opacity="0.9"
                        IsHitTestVisible="False" />
                <!-- Cream Bristol drafting sheet -->
                <Border Margin="6,0,0,6" Background="{DynamicResource PopupBackgroundBrush}"
                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                        Padding="28,24">
                    <Grid>
                        <!-- Faint halftone top-right corner -->
                        <Control Template="{DynamicResource LocalHalftoneCornerTemplate}"
                                 Foreground="{DynamicResource LocalCropGuideBrush}" Opacity="0.16"
                                 Width="130" Height="130" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-24,-28,0" IsHitTestVisible="False" />
                        <!-- Dashed inner non-photo blue copy-area frame -->
                        <Rectangle Margin="-12,-10" Stroke="{DynamicResource LocalCropGuideBrush}"
                                   StrokeThickness="1" StrokeDashArray="4,3" Opacity="0.7"
                                   IsHitTestVisible="False" />
                        <!-- Corner crop ticks -->
                        <Control x:Name="EmptyCrops" Margin="-18,-16" Template="{DynamicResource CornerMarksTemplate}"
                                 Foreground="{DynamicResource LocalCropGuideBrush}" IsHitTestVisible="False" />

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="54" Height="54" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Border Background="{DynamicResource MainMenuButtonBackgroundBrush}"
                                        BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5" />
                                <Border x:Name="EmptyPulseBorder" Margin="-4"
                                        BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1.5"
                                        Opacity="0.6" IsHitTestVisible="False" />
                                <Control x:Name="EmptyBrandMark" Width="32" Height="32"
                                         Template="{DynamicResource BrandMarkTemplate}"
                                         Foreground="{DynamicResource PrimaryButtonForegroundBrush}" />
                            </Grid>

                            <Control Template="{DynamicResource LocalRegistrationMarkTemplate}"
                                     Foreground="{DynamicResource LocalCropGuideBrush}"
                                     HorizontalAlignment="Center" Margin="0,0,0,10" />

                            <TextBlock Text="{DynamicResource LOCErrorNoGameSelected}"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       FontSize="{DynamicResource FontSizeLarger}"
                                       Foreground="{DynamicResource HeadingForegroundBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="EmptyBoardIdle">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyPulseBorder" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.25" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:4.5" Value="0.45" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmptyCrops" Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.25" Value="1" KeySpline="0.4,0 0.6,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:4.5" Value="0.65" KeySpline="0.4,0 0.6,1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="EmptyBoardIdle" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- SteamScreenshots Plugin Loading Skeleton (3 inked comic panels + main frame) -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <StackPanel IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border Height="200" Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1.5"
                    Margin="0,0,0,8">
                <Grid>
                    <Rectangle Margin="8" Stroke="{DynamicResource LocalCropGuideBrush}" StrokeThickness="1"
                               StrokeDashArray="4,3" Opacity="0.7" />
                    <Control Template="{DynamicResource LocalRegistrationMarkTemplate}"
                             Foreground="{DynamicResource LocalCropGuideBrush}" Opacity="0.6"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <UniformGrid Columns="4">
                <Border Height="48" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.85" />
                <Border Height="48" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.75" />
                <Border Height="48" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.85" />
                <Border Height="48" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" Opacity="0.75" />
            </UniformGrid>
        </StackPanel>
    </ControlTemplate>

    <!-- Game Page Section Heading (Barlow Condensed Bold, flips to WindowArtForegroundBrush over window art) -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource LocalCondensedFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Game Page Secondary Action Button (40x40 sharp inked square with 2px offset lip, icon-only) -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="OffsetLip" Margin="2,2,-2,-2" Background="{DynamicResource LocalBackingPaperBrush}"
                                IsHitTestVisible="False" />
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="HoverFill" Background="{DynamicResource SecondaryButtonHoverBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="PressFill" Background="{DynamicResource SecondaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OffsetLip" Property="Background" Value="{DynamicResource GlyphBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SecBtnHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="SecBtnHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OffsetLip" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressFill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PressFill" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): three tapered G-pen ink strokes on the charcoal tile, stacked like menu rows. Hover: four orange crop marks snap in from outside to frame the strokes (Back ease on their own translates). Open (ContextMenu.IsOpen of the nearest Border): the strokes shorten from the right, an orange ink drop falls onto the tile with a bounce and keeps sending a ripple ring outward until the menu closes. -->
    <ControlTemplate x:Key="LocalCropmarkMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas x:Name="Strokes" Width="22" Height="22" RenderTransformOrigin="0,0.5">
                    <Canvas.RenderTransform><ScaleTransform x:Name="StrokesScale" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                    <Path Data="M3,5.3 H16 L19.5,6.5 L16,7.7 H3Z" Fill="{TemplateBinding Foreground}" />
                    <Path Data="M3,9.8 H12.5 L16,11 L12.5,12.2 H3Z" Fill="{TemplateBinding Foreground}" />
                    <Path Data="M3,14.3 H16 L19.5,15.5 L16,16.7 H3Z" Fill="{TemplateBinding Foreground}" />
                </Canvas>
                <Canvas x:Name="Crops" Width="22" Height="22" Opacity="0">
                    <Path Data="M1,6 V1 H6" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5"><Path.RenderTransform><TranslateTransform x:Name="CropTLMove" X="-3" Y="-3" /></Path.RenderTransform></Path>
                    <Path Data="M16,1 H21 V6" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5"><Path.RenderTransform><TranslateTransform x:Name="CropTRMove" X="3" Y="-3" /></Path.RenderTransform></Path>
                    <Path Data="M1,16 V21 H6" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5"><Path.RenderTransform><TranslateTransform x:Name="CropBLMove" X="-3" Y="3" /></Path.RenderTransform></Path>
                    <Path Data="M21,16 V21 H16" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.5"><Path.RenderTransform><TranslateTransform x:Name="CropBRMove" X="3" Y="3" /></Path.RenderTransform></Path>
                </Canvas>
                <Canvas Width="22" Height="22">
                    <Ellipse x:Name="Ripple" Canvas.Left="4" Canvas.Top="4" Width="14" Height="14" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="RippleScale" ScaleX="0.3" ScaleY="0.3" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Drop" Canvas.Left="8" Canvas.Top="8" Width="6" Height="6" Fill="{DynamicResource GlyphBrush}" Opacity="0">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="DropFall" Y="-9" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Crops" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CropTLMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CropTLMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CropTRMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CropTRMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CropBLMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CropBLMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CropBRMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CropBRMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.9" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="Crops" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CropTLMove" Storyboard.TargetProperty="X" To="-3" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CropTLMove" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CropTRMove" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CropTRMove" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CropBLMove" Storyboard.TargetProperty="X" To="-3" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CropBLMove" Storyboard.TargetProperty="Y" To="3" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CropBRMove" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="CropBRMove" Storyboard.TargetProperty="Y" To="3" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
