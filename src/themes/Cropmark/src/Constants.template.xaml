<!--
    Cropmark: Constants.xaml template (Bristol Comic Board theme inspired by Marvel Tokon: Fighting Souls).
    scripts/build-theme.ps1 renders tokens.css placeholders into Constants.xaml.
    Light paper palette: warm Bristol rag paper, sumi-olive charcoal ink, non-photo blue crop guides & tabs,
    textured Comic Marker Orange selection/accent, Punish! Teal running indicator, and Issue Crimson danger/Exit.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (Anton & Barlow Condensed bundled as static OFL TTFs in Typography/) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">13.5</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">30</sys:Double>
    <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Anton, Anton, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="LocalCondensedFontFamily">./Typography/#Barlow Condensed, Barlow Condensed, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Game page metadata pane defaults (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Shape & radii: 0px sharp comic panels; 9999 strictly for 1:1 circular badges -->
    <Thickness x:Key="PopupBorderThickness">1.5</Thickness>
    <Thickness x:Key="ControlBorderThickness">1.5</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:cm-radius|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:cm-radius-sm|0}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:cm-radius-lg|2}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{cm-ink}}</Color>
    <Color x:Key="TextColorDarker">{{cm-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{cm-ink-deep}}</Color>
    <Color x:Key="MainColor">{{cm-paper-hi}}</Color>
    <Color x:Key="MainColorDark">{{cm-paper-well}}</Color>
    <Color x:Key="HoverColor">{{cm-blue-wash}}</Color>
    <Color x:Key="GlyphColor">{{cm-orange}}</Color>
    <Color x:Key="HighlightGlyphColor">{{cm-orange-hi}}</Color>
    <Color x:Key="PopupBackgroundColor">{{cm-paper-hi}}</Color>
    <Color x:Key="PopupBorderColor">{{cm-ink}}</Color>
    <Color x:Key="BackgroundToneColor">{{cm-paper-well}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{cm-blue-guide}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{cm-ink}}</Color>
    <Color x:Key="DataChangeNotifColor">{{cm-orange}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{cm-ink}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{cm-charcoal}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{cm-paper-hi}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{cm-paper-hi}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{cm-paper-hi}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{cm-green}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{cm-crimson}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{cm-gold}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{cm-gold}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{cm-paper-well}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{cm-paper}}" />

    <!-- Shell & Game Page Brushes -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{cm-paper-well}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{cm-paper-hi}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{cm-paper}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{cm-paper}}" />
    <!-- Banner darkening color: light Bristol paper so darkened banner art washes cleanly into the board -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{cm-paper}}" />
    <!-- ScrimBrush: deep ink scrim for darkening RunningIndicatorBrush plates (keeps white label >= 6:1) -->
    <SolidColorBrush x:Key="ScrimBrush" Color="{{cm-charcoal}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{cm-charcoal}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{cm-paper-hi}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{cm-paper}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{cm-paper-hi}}" />

    <!-- Light-Theme Window Background Art Flip (readable paper-white text directly over game art) -->
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{cm-paper-hi}}" />

    <!-- State Brushes: Marker Orange selection with deep ink text; sky-blue drafting hover -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{cm-orange}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{cm-orange-hi}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{cm-ink-deep}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{cm-ink-deep}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{cm-blue-wash}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{cm-orange}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{cm-orange}}" />
    <!-- Dedicated HUD Punish! Teal running indicator (distinct from charcoal Play, orange selection, sky-blue tabs) -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{cm-punish}}" />
    <SolidColorBrush x:Key="LocalRunningHighlightBrush" Color="{{cm-punish-hi}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{cm-blue-vivid}}" />
    <SolidColorBrush x:Key="FocusHaloBrush" Color="{{cm-blue-halo}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{cm-crimson}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{cm-paper-hi}}" />

    <!-- Button Brushes: Primary Play CTA is EPISODE charcoal ink slab with cream text + orange drop-bar -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{cm-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{cm-blue-wash}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{cm-paper-deep}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{cm-ink}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{cm-charcoal}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{cm-charcoal-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{cm-charcoal-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{cm-ink-deep}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{cm-paper-hi}}" />
    <SolidColorBrush x:Key="PrimaryButtonGlowBrush" Color="{{cm-orange}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{cm-paper-hi}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{cm-ink}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{cm-blue-wash}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{cm-paper-deep}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{cm-blue-tab}}" />

    <!-- Input & Control Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{cm-paper-hi}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{cm-paper-hi}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{cm-ink}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{cm-blue-vivid}}" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{cm-ink}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{cm-orange-deep}}" />
    <SolidColorBrush x:Key="CheckBoxCheckedHoverBackgroundBrush" Color="{{cm-orange-hi}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{cm-hairline}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{cm-orange}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{cm-ink-deep}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{cm-charcoal}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{cm-blue-tab}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{cm-paper-well}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{cm-charcoal}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{cm-orange}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{cm-paper-well}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{cm-charcoal}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{cm-orange}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{cm-ink-muted}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{cm-ink}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{cm-blue-tab}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{cm-blue-tab-hi}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{cm-paper-hi}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{cm-blue-vivid}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{cm-orange}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{cm-blue-wash}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{cm-blue-tab}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{cm-ink-muted}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{cm-ink-deep}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedGlowBrush" Color="{{cm-blue-tab}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{cm-paper}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{cm-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{cm-orange-wash}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{cm-blue-link}}" />

    <!-- Bristol Drafting & Chrome Brushes -->
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{cm-ink}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{cm-orange}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{cm-ink}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{cm-paper-hi}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{cm-ink}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{cm-blue-guide}}" />
    <SolidColorBrush x:Key="LocalCropGuideBrush" Color="{{cm-blue-guide}}" />
    <SolidColorBrush x:Key="LocalCropGuideFaintBrush" Color="{{cm-blue-faint}}" />
    <SolidColorBrush x:Key="LocalBackingPaperBrush" Color="{{cm-charcoal}}" />
    <SolidColorBrush x:Key="LocalBackingPaperSoftBrush" Color="{{cm-paper-deep}}" />
    <SolidColorBrush x:Key="LocalDraftingTabBrush" Color="{{cm-blue-tab}}" />
    <SolidColorBrush x:Key="LocalDraftingTabHoverBrush" Color="{{cm-blue-tab-hi}}" />
    <SolidColorBrush x:Key="LocalOrangeDeepBrush" Color="{{cm-orange-deep}}" />
    <SolidColorBrush x:Key="LocalOrangeWashBrush" Color="{{cm-orange-wash}}" />
</ResourceDictionary>
