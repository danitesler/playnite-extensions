<!--
    Cropmark: Media.xaml — Bespoke comic-inked geometric vector icons (sharp 0px mitered cuts, bold ink silhouettes)
    matched to Marvel Tokon: Fighting Souls' Bristol art board iconography. IconMainMenu carries Cropmark's original
    corner-crop + registration-crosshair + 4-point spark mark. Playnite's 22 icofont menu icons omit local Foreground
    so they inherit TextElement.Foreground on Marker Orange and Issue Crimson highlights.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Icon DataTemplates (uniformly scaled Viewbox fitting smallest hosts) -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox MaxWidth="{DynamicResource IconSize}" MaxHeight="{DynamicResource IconSize}" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox MaxWidth="12" MaxHeight="12" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileSolidTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <!-- Brand Mark: Four L-Crop Ticks + Registration Crosshair + 4-Point Comic Spark -->
    <Geometry x:Key="IconMainMenu">F0 M2,2 H8 V4.2 H4.2 V8 H2 Z M16,2 H22 V8 H19.8 V4.2 H16 Z M2,16 H4.2 V19.8 H8 V22 H2 Z M19.8,16 H22 V22 H16 V19.8 H19.8 Z M11,1.5 H13 V5.5 H11 Z M11,18.5 H13 V22.5 H11 Z M1.5,11 H5.5 V13 H1.5 Z M18.5,11 H22.5 V13 H18.5 Z M12,5.5 L14.4,9.6 L18.5,12 L14.4,14.4 L12,18.5 L9.6,14.4 L5.5,12 L9.6,9.6 Z M12,9.5 L13.4,12 L12,14.5 L10.6,12 Z</Geometry>

