<!--
    Stride v2: CustomControls/SidebarItem.xaml.
    Mirror's Edge 2008 STORY red-pillar menu selection:
    - Idle items sit as crisp white icons on the blazing red vertical pillar.
    - Hover washes translucent frost white across the tile.
    - Active selection cuts an inverted pure-white horizontal glass slab across the red pillar with bold dark ink.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Padding" Value="{DynamicResource SidebarItemPadding}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSidebarItem}">
                        <!-- Hover frost wash on the red pillar -->
                        <Border x:Name="HoverPlate" Background="{DynamicResource LocalWhiteBrush}"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                        <!-- Active selection: stark pure-white horizontal glass slab cutting across the red pillar -->
                        <Border x:Name="ActiveSlab" Background="{DynamicResource LocalGlassHeaderBrush}"
                                BorderBrush="{DynamicResource LocalWhiteBrush}" BorderThickness="0,1,0,1"
                                Visibility="Collapsed" IsHitTestVisible="False" />

                        <ContentControl x:Name="IconContent"
                                        Content="{Binding IconObject}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Width="18" Height="18"
                                        Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter TargetName="ActiveSlab" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Selected}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="SidebarHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="SidebarHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                                <Condition Binding="{Binding Selected}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Width" Value="40" />
                            <Setter Property="Height" Value="44" />
                            <Setter Property="Margin" Value="2,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Width" Value="40" />
                            <Setter Property="Height" Value="44" />
                            <Setter Property="Margin" Value="2,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
