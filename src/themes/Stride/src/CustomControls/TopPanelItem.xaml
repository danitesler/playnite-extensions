<!--
    Stride v2: CustomControls/TopPanelItem.xaml.
    32x32 frosted ice-blue glass toolbar tiles with steel-blue rim and white top catchlight.
    Checked/active view switches ignite in blazing Mirror's Edge Red glass with Catalyst bottom-right 6px facet.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TopPanelItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LocalSteelInkBrush}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanelItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Resting frosted ice-blue glass tile -->
                        <Border x:Name="GlassChip" Background="{DynamicResource LocalGlassButtonBrush}"
                                BorderBrush="{DynamicResource LocalRimSoftBrush}" BorderThickness="1"
                                IsHitTestVisible="False">
                            <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource LocalWhiteBrush}" Opacity="0.85" />
                        </Border>
                        <!-- Hover glass brighten -->
                        <Border x:Name="HoverPlate" Background="{DynamicResource LocalGlassButtonHoverBrush}"
                                BorderBrush="{DynamicResource LocalRimStrongBrush}" BorderThickness="1"
                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                        <!-- Active/Checked: Blazing Mirror's Edge Red glass plate with 6px bottom-right Catalyst facet -->
                        <Border x:Name="CheckedPlate" Background="{DynamicResource LocalCrimsonGlassBrush}"
                                BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="1"
                                CornerRadius="0,0,6,0"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource LocalWhiteBrush}" Opacity="0.35" />
                        </Border>

                        <ContentPresenter Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter TargetName="GlassChip" Property="Opacity" Value="0.18" />
                        </DataTrigger>
                        <Trigger Property="IsToggled" Value="True">
                            <Setter TargetName="CheckedPlate" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TopItemHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TopItemHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsToggled" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
