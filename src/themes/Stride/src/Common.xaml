<!--
    Stride v2: Common.xaml — spacing metrics, 5 white-mask FX ImageBrushes (glass-inset, glass-sheen,
    city-skyline, micro-grid, momentum-stripes), 9-slice & compact 4-edge inner-shadow templates,
    tempered glass panel template, steel-blue architectural dividers, SecondaryButton, EmptyGameTemplate,
    SteamScreenshotsSkeletonTemplate, and italic glass-etched HeadingTextBlock.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared Spacing & Metric Keys -->
    <sys:Double x:Key="ControlHeight">32</sys:Double>               <!-- Standard 32px inputs, combos, buttons -->
    <sys:Double x:Key="IconSize">16</sys:Double>                    <!-- Compact rail and top bar glyphs -->
    <sys:Double x:Key="GameBannerHeight">260</sys:Double>           <!-- Default hero banner height (0..600) -->
    <sys:Double x:Key="GameBannerDarken">0</sys:Double>             <!-- Default banner darkening slider (0..1) -->
    <Thickness x:Key="ButtonPadding">14,5</Thickness>               <!-- 1px border + 5px v-pad = 32px -->
    <Thickness x:Key="InputPadding">9,5</Thickness>                 <!-- TextBox / PasswordBox / ComboBox -->
    <Thickness x:Key="MenuPadding">0,4,0,4</Thickness>              <!-- Tempered glass menu board inset -->
    <Thickness x:Key="MenuItemPadding">10,4</Thickness>             <!-- Compact 30px menu rows -->
    <Thickness x:Key="ComboBoxDropDownPadding">0,4,0,4</Thickness>  <!-- Unified glass dropdown inset -->
    <Thickness x:Key="ComboBoxItemPadding">10,4</Thickness>         <!-- 30px ComboBox rows -->
    <Thickness x:Key="ListBoxItemPadding">10,5</Thickness>          <!-- ListBox rows -->
    <Thickness x:Key="GroupBoxPadding">12,10,12,12</Thickness>      <!-- Tempered glass GroupBox inset -->
    <Thickness x:Key="GroupBoxHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TooltipPadding">10,6</Thickness>              <!-- Charcoal glass tooltip inset -->

    <!-- Shared White-Mask FX ImageBrushes (recolored live by ThemeModifier via Fill/Background) -->
    <ImageBrush x:Key="LocalGlassSheenMaskBrush" ImageSource="{ThemeFile 'Images/fx/glass-sheen.png'}"
                Stretch="Fill" />
    <ImageBrush x:Key="LocalCitySkylineMaskBrush" ImageSource="{ThemeFile 'Images/fx/city-skyline.png'}"
                Stretch="Fill" />
    <ImageBrush x:Key="LocalMicroGridMaskBrush" ImageSource="{ThemeFile 'Images/fx/micro-grid.png'}"
                TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalMomentumStripesMaskBrush" ImageSource="{ThemeFile 'Images/fx/momentum-stripes.png'}"
                TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalEdgeWiggleVMaskBrush" ImageSource="{ThemeFile 'Images/fx/edge-wiggle-v.png'}"
                Stretch="Fill" />
    <ImageBrush x:Key="LocalEdgeWiggleHMaskBrush" ImageSource="{ThemeFile 'Images/fx/edge-wiggle-h.png'}"
                Stretch="Fill" />

    <!-- 9-Slice ImageBrushes for glass-inset.png (96x96 with 28px corner/edge velvety inner shadow) -->
    <ImageBrush x:Key="LocalGlassInsetTL" ImageSource="{ThemeFile 'Images/fx/glass-inset.png'}" Viewbox="0,0,28,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlassInsetTC" ImageSource="{ThemeFile 'Images/fx/glass-inset.png'}" Viewbox="28,0,40,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlassInsetTR" ImageSource="{ThemeFile 'Images/fx/glass-inset.png'}" Viewbox="68,0,28,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlassInsetML" ImageSource="{ThemeFile 'Images/fx/glass-inset.png'}" Viewbox="0,28,28,40" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlassInsetMR" ImageSource="{ThemeFile 'Images/fx/glass-inset.png'}" Viewbox="68,28,28,40" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlassInsetBL" ImageSource="{ThemeFile 'Images/fx/glass-inset.png'}" Viewbox="0,68,28,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlassInsetBC" ImageSource="{ThemeFile 'Images/fx/glass-inset.png'}" Viewbox="28,68,40,28" ViewboxUnits="Absolute" Stretch="Fill" />
    <ImageBrush x:Key="LocalGlassInsetBR" ImageSource="{ThemeFile 'Images/fx/glass-inset.png'}" Viewbox="68,68,28,28" ViewboxUnits="Absolute" Stretch="Fill" />

    <!-- Popup Border -->
    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LocalGlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- Keyboard Focus Visual (Blazing Mirror's Edge Red frame) -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 9-Slice Velvety 4-Edge Cool-Blue Glass Inner Shadow (for large panels: menus, list, dossier, windows) -->
    <ControlTemplate x:Key="LocalGlassInsetTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalGlassInsetTL}" />
            <Rectangle Grid.Row="0" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalGlassInsetTC}" />
            <Rectangle Grid.Row="0" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalGlassInsetTR}" />
            <Rectangle Grid.Row="1" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalGlassInsetML}" />
            <Rectangle Grid.Row="1" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalGlassInsetMR}" />
            <Rectangle Grid.Row="2" Grid.Column="0" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalGlassInsetBL}" />
            <Rectangle Grid.Row="2" Grid.Column="1" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalGlassInsetBC}" />
            <Rectangle Grid.Row="2" Grid.Column="2" Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalGlassInsetBR}" />
        </Grid>
    </ControlTemplate>

    <!-- Vector 4-Edge Compact Inner Shadow (12px smooth falloff for buttons, inputs, tabs; zero DPI seams) -->
    <ControlTemplate x:Key="LocalCompactInsetTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Rectangle Height="10" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B8000000" Offset="0" />
                        <GradientStop Color="#52000000" Offset="0.4" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Height="10" VerticalAlignment="Bottom" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#C8000000" Offset="0" />
                        <GradientStop Color="#58000000" Offset="0.4" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="10" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#A8000000" Offset="0" />
                        <GradientStop Color="#44000000" Offset="0.4" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="10" HorizontalAlignment="Right" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                        <GradientStop Color="#A8000000" Offset="0" />
                        <GradientStop Color="#44000000" Offset="0.4" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Recessed Top Inner Shadow (for glass input wells, recessed search box, inactive tabs) -->
    <ControlTemplate x:Key="LocalRecessedWellShadowTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Rectangle Height="7" VerticalAlignment="Top" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C4000000" Offset="0" />
                        <GradientStop Color="#44000000" Offset="0.48" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Width="5" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#72000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!-- Diagonal Architectural Window Glass Sheen Overlay -->
    <ControlTemplate x:Key="LocalGlassSheenTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalGlassSheenMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Subtle Glass Curtain-Wall Micro-Grid Overlay -->
    <ControlTemplate x:Key="LocalMicroGridTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalMicroGridMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Sunlit Geometric City Skyline Silhouette Backdrop -->
    <ControlTemplate x:Key="LocalCitySkylineTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalCitySkylineMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Diagonal Velocity Stripes Overlay (ProgressBar & Running Sweeps) -->
    <ControlTemplate x:Key="LocalMomentumStripesTemplate" TargetType="Control">
        <Rectangle Fill="{TemplateBinding Foreground}" OpacityMask="{DynamicResource LocalMomentumStripesMaskBrush}"
                   IsHitTestVisible="False" />
    </ControlTemplate>

    <!-- Brand Mark Template (Stride Kinetic Shard Chevron) -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="Control">
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Path Data="{DynamicResource IconMainMenu}" Fill="{TemplateBinding Foreground}"
                  Width="24" Height="24" Stretch="Uniform" />
        </Viewbox>
    </ControlTemplate>

    <!-- Architectural Steel-Blue Section Divider with Leading Blazing Red Tick -->
    <ControlTemplate x:Key="DividerTemplate" TargetType="Control">
        <Grid Height="4" SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource LocalRimSoftBrush}" />
            <Border Width="14" Height="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{DynamicResource LocalRimStrongBrush}" />
        </Grid>
    </ControlTemplate>

    <!-- Architectural Corner Calibration Ticks (Grid Hover Frame) -->
    <ControlTemplate x:Key="CornerMarksTemplate" TargetType="Control">
        <Grid IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Path Data="M 0,10 L 0,0 L 10,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="M 0,0 L 10,0 L 10,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                  HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Path Data="M 0,0 L 0,10 L 10,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Path Data="M 10,0 L 10,10 L 0,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </ControlTemplate>

    <!-- Tempered Ice-Blue Glass Secondary Action Button (42x42 More / Edit beside Play) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource LocalGlassButtonBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LocalSteelInkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Crisp white top glass catchlight -->
                            <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource LocalWhiteBrush}"
                                    Opacity="0.88" IsHitTestVisible="False" />
                            <!-- Cool-blue bottom edge inner shadow -->
                            <Control Template="{DynamicResource LocalCompactInsetTemplate}"
                                     Foreground="{DynamicResource LocalGlassInsetBrush}" Opacity="0.16"
                                     IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource LocalGlassButtonHoverBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource LocalRimStrongBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SecondaryButtonPressedBackgroundBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Squared Italic Architectural Section Heading (Orbitron Bold Italic) -->
    <Style x:Key="HeadingTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Empty-Library / No-Selection Architectural State over Sunlit City Skyline -->
    <ControlTemplate x:Key="EmptyGameTemplate" TargetType="Control">
        <Grid Background="Transparent">
            <!-- Sunlit geometric skyscraper skyline rising along the bottom edge -->
            <Control Template="{DynamicResource LocalCitySkylineTemplate}"
                     Foreground="{DynamicResource LocalSkylineBrush}" Opacity="0.22"
                     Height="180" VerticalAlignment="Bottom" IsHitTestVisible="False" />

            <!-- Open floating empty-state mark and prompt (no surrounding box/container) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <!-- Breathing Runner Vision reticle -->
                    <Border x:Name="Reticle" Width="64" Height="64"
                            BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1.5"
                            Opacity="0.34" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ReticleScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.22" To="0.72" Duration="0:0:2.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0.96" To="1.05" Duration="0:0:2.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0.96" To="1.05" Duration="0:0:2.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                    <!-- Red glass brand badge -->
                    <Border Width="42" Height="42" Background="{DynamicResource LocalRedPillarBrush}"
                            BorderBrush="{DynamicResource PrimaryButtonBorderBrush}" BorderThickness="1">
                        <Control Template="{DynamicResource BrandMarkTemplate}"
                                 Foreground="{DynamicResource LocalWhiteBrush}" Width="24" Height="24" />
                    </Border>
                </Grid>

                <TextBlock Text="NO ROUTE SELECTED"
                           FontFamily="{DynamicResource HeadingFontFamily}" FontStyle="Italic"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Pick a title from the library to open its dossier."
                           FontFamily="{DynamicResource FontFamily}" FontSize="13"
                           Foreground="{DynamicResource LocalSteelInkBrush}" HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <!-- SteamScreenshots Plugin Skeleton (Tempered Ice-Blue Glass Shimmer) -->
    <ControlTemplate x:Key="SteamScreenshotsSkeletonTemplate" TargetType="Control">
        <Border Background="{DynamicResource LocalGlassSurfaceBrush}"
                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                Padding="10" SnapsToDevicePixels="True">
            <Grid>
                <Control Template="{DynamicResource LocalGlassInsetTemplate}"
                         Foreground="{DynamicResource LocalGlassInsetBrush}" Opacity="0.18"
                         IsHitTestVisible="False" />
                <StackPanel>
                    <Border Height="190" Background="{DynamicResource LocalGlassZebraBrush}"
                            BorderBrush="{DynamicResource LocalRimSoftBrush}" BorderThickness="1"
                            ClipToBounds="True">
                        <Rectangle x:Name="Shimmer" Width="160" HorizontalAlignment="Left"
                                   Fill="{DynamicResource LocalWhiteBrush}" Opacity="0.45"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform AngleX="-24" />
                                    <TranslateTransform x:Name="ShimmerX" X="-180" />
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                             From="-180" To="780" Duration="0:0:1.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                    </Border>
                    <UniformGrid Columns="4" Margin="0,8,0,0">
                        <Border Height="54" Margin="0,0,6,0" Background="{DynamicResource LocalGlassZebraBrush}" BorderBrush="{DynamicResource LocalRimSoftBrush}" BorderThickness="1" />
                        <Border Height="54" Margin="3,0,3,0" Background="{DynamicResource LocalGlassZebraBrush}" BorderBrush="{DynamicResource LocalRimSoftBrush}" BorderThickness="1" />
                        <Border Height="54" Margin="3,0,3,0" Background="{DynamicResource LocalGlassZebraBrush}" BorderBrush="{DynamicResource LocalRimSoftBrush}" BorderThickness="1" />
                        <Border Height="54" Margin="6,0,0,0" Background="{DynamicResource LocalGlassZebraBrush}" BorderBrush="{DynamicResource LocalRimSoftBrush}" BorderThickness="1" />
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- Main menu mark (Sidebar and TopPanel PART_ElemMainMenu): three white rooftop slabs stepping down to the right, like menu rows run as a staircase. Hover: the slabs pop up in turn like platforms (a springy 2px rise, staggered). Open (ContextMenu.IsOpen of the nearest Border): Runner Vision turns the slabs Mirror red one after another and a white runner dot sprints diagonally down the steps on repeat until the menu closes. -->
    <ControlTemplate x:Key="LocalStrideMenuMarkTemplate" TargetType="Control">
        <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True">
            <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="PopA" Y="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="2" Canvas.Top="6" Width="10" Height="3.8" Fill="{TemplateBinding Foreground}" />
                    <Rectangle x:Name="RedA" Canvas.Left="2" Canvas.Top="6" Width="10" Height="3.8" Fill="{DynamicResource LocalRedPillarBrush}" Opacity="0" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="PopB" Y="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="8" Canvas.Top="11.6" Width="10" Height="3.8" Fill="{TemplateBinding Foreground}" />
                    <Rectangle x:Name="RedB" Canvas.Left="8" Canvas.Top="11.6" Width="10" Height="3.8" Fill="{DynamicResource LocalRedPillarBrush}" Opacity="0" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Canvas.RenderTransform><TranslateTransform x:Name="PopC" Y="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="14" Canvas.Top="17.2" Width="10" Height="3.8" Fill="{TemplateBinding Foreground}" />
                    <Rectangle x:Name="RedC" Canvas.Left="14" Canvas.Top="17.2" Width="10" Height="3.8" Fill="{DynamicResource LocalRedPillarBrush}" Opacity="0" />
                </Canvas>
                <Canvas Width="26" Height="26">
                    <Ellipse x:Name="Runner" Canvas.Left="3" Canvas.Top="1.4" Width="3.6" Height="3.6" Fill="{DynamicResource LocalWhiteBrush}" Opacity="0">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="RunnerMove" X="0" Y="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PopA" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="1.2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PopB" Storyboard.TargetProperty="Y" To="-2" BeginTime="0:0:0.06" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="1.2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PopC" Storyboard.TargetProperty="Y" To="-2" BeginTime="0:0:0.12" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="1.2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PopA" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PopB" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PopC" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
