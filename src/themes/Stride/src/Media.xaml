<!--
    Stride: Media.xaml — Bespoke Mirror's Edge-inspired Swiss architectural & diagonal-faceted Icon* vector
    geometries. IconMainMenu carries Stride's original Kinetic Shard Chevron brand mark.
    Menu item icons are the theme's own PNG set (art/menu-icons.json, docs/themes/menu-icons.md).
-->
<ResourceDictionary xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Icon DataTemplates (uniformly scaled Viewbox fitting smallest hosts) -->
    <DataTemplate x:Key="IconTemplate">
        <Viewbox MaxWidth="{DynamicResource IconSize}" MaxHeight="{DynamicResource IconSize}" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox MaxWidth="12" MaxHeight="12" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IconTileSolidTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                  Stretch="Uniform" Width="24" Height="24" />
        </Viewbox>
    </DataTemplate>

    <!-- Brand Mark: Stride Kinetic Shard Chevron -->
    <Geometry x:Key="IconMainMenu">M 6.8,3.8 L 14.3,3.8 L 19.5,12 L 14.3,20.2 L 6.8,20.2 L 12,12 Z M 2.2,6 L 5.6,6 L 9.4,12 L 5.6,18 L 2.2,18 L 6,12 Z M 16.5,18 L 21.8,18 L 20.6,20.2 L 15.4,20.2 Z</Geometry>

