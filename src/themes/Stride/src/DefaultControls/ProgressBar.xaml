<!--
    Stride v2: DefaultControls/ProgressBar.xaml.
    Mirror's Edge Time Trial meter: translucent steel-blue glass track (ProgressBarTrackBrush) with 1px steel-blue
    rim and Blazing Mirror's Edge Red glass fill overlaid by subtle diagonal momentum stripes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LocalRimStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0" SnapsToDevicePixels="True" />
                        <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                            <Border Background="{DynamicResource LocalCrimsonGlassBrush}" CornerRadius="0" />
                            <Control Template="{DynamicResource LocalMomentumStripesTemplate}"
                                     Foreground="{DynamicResource LocalWhiteBrush}" Opacity="0.22"
                                     IsHitTestVisible="False" />
                            <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource LocalWhiteBrush}"
                                    Opacity="0.32" IsHitTestVisible="False" />
                            <Rectangle x:Name="IndeterminatePulse" Width="72" HorizontalAlignment="Left"
                                       Fill="{DynamicResource LocalWhiteBrush}" Opacity="0.36"
                                       Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <SkewTransform AngleX="-24" />
                                        <TranslateTransform x:Name="PulseX" X="-90" />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="IndeterminatePulse" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateAnim">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PulseX" Storyboard.TargetProperty="X"
                                                         From="-90" To="560" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateAnim" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
