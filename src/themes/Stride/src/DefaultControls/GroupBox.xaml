<!--
    Stride v2: DefaultControls/GroupBox.xaml.
    Content-sized tempered ice-blue frosted glass card with velvety 4-edge cool-blue inner shadow,
    1px steel-blue rim, white top catchlight, and italic Sora heading led by a 3px blazing red left bar.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource LocalGlassSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Velvety 4-edge cool-blue glass inner shadow + white top catchlight -->
                            <Control Template="{DynamicResource LocalGlassInsetTemplate}"
                                     Foreground="{DynamicResource LocalGlassInsetBrush}" Opacity="0.18"
                                     IsHitTestVisible="False" />
                            <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource LocalWhiteBrush}"
                                    Opacity="0.90" IsHitTestVisible="False" />

                            <StackPanel Margin="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="HeaderHost" ContentSource="Header"
                                                  Margin="{DynamicResource GroupBoxHeaderMargin}"
                                                  RecognizesAccessKey="True"
                                                  TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                                  TextElement.FontStyle="Italic"
                                                  TextElement.FontSize="14.5"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.Foreground="{DynamicResource LocalSteelInkBrush}" />
                                <ContentPresenter />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
