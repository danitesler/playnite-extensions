<!--
    Stride v2: DefaultControls/Expander.xaml.
    Frosted ice-blue glass group header with Sora Italic steel-blue heading and crisp steel-blue hairline.
    Swaps IconSubmenu / IconDropDown on Arrow (never RotateTransform Setter) and flips transparent +
    WindowArtForegroundBrush when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalExpanderToggleTemplate" TargetType="{x:Type ToggleButton}">
        <Border x:Name="HeaderPlate" Background="{DynamicResource LocalGlassHeaderBrush}"
                BorderBrush="{DynamicResource LocalRimSoftBrush}" BorderThickness="0,0,0,1"
                Padding="8,5" Cursor="Hand" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="Arrow" Grid.Column="0" Width="10" Height="10"
                                Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{DynamicResource GlyphBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Focusable="False" IsTabStop="False" />

                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                  RecognizesAccessKey="True"
                                  TextElement.FontFamily="{DynamicResource HeadingFontFamily}"
                                  TextElement.FontStyle="Italic"
                                  TextElement.FontSize="13.5"
                                  TextElement.FontWeight="Bold"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter TargetName="HeaderPlate" Property="Background" Value="Transparent" />
                <Setter TargetName="HeaderPlate" Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Arrow" Property="Content" Value="{DynamicResource IconDropDown}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderPlate" Property="Background" Value="{DynamicResource LocalWhiteBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource LocalSteelInkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel SnapsToDevicePixels="True">
                        <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Template="{StaticResource LocalExpanderToggleTemplate}" />
                        <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom"
                                          Focusable="False" Visibility="Collapsed"
                                          Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
