<!--
    Stride v2: DefaultControls/TabControl.xaml.
    Exact Mirror's Edge 2008 EXTRAS / UNLOCKABLES (ARTWORK | VIDEOS | MUSIC, id=815) glass folder tabs:
    - Active tab: raised pure snow-white glass plate crowned by a 2px blazing Mirror's Edge Red top bar,
      opening seamlessly into the frosted glass tab body below.
    - Inactive tabs: recessed ice-blue glass plates with subtle inner depth shadow and steel-blue rim.
    - TabItem keeps Foreground="{DynamicResource TextBrush}" (never muted on TabItem itself, which would
      cascade to TabControl content); header text color is targeted on HeaderText directly.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,12,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,0,1"
                                Background="Transparent">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="0,0,0,-1" Panel.ZIndex="1" />
                        </Border>

                        <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="TabRoot" Margin="{TemplateBinding Margin}" Cursor="Hand" SnapsToDevicePixels="True">
                        <!-- Recessed ice-blue glass plate (idle) -> raised pure white glass plate (selected) -->
                        <Border x:Name="TabPlate" Background="{DynamicResource LocalGlassTabIdleGradBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1,1,1,1"
                                Margin="0,3,0,0" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="TopCatchlight" VerticalAlignment="Top" Height="1"
                                        Background="{DynamicResource LocalWhiteBrush}" Opacity="0.72"
                                        IsHitTestVisible="False" />
                                <Control x:Name="IdleShadow" Template="{DynamicResource LocalRecessedWellShadowTemplate}"
                                         Foreground="{DynamicResource LocalGlassInsetBrush}" Opacity="0.16"
                                         IsHitTestVisible="False" />
                                <!-- 2px Blazing Mirror's Edge Red top bar on selected tab -->
                                <Border x:Name="ActiveTopBar" Height="2" VerticalAlignment="Top"
                                        Background="{DynamicResource TabItemIndicatorBrush}"
                                        Visibility="Collapsed" IsHitTestVisible="False" />
                                <TextBlock x:Name="HeaderText" Margin="{TemplateBinding Padding}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource HeadingFontFamily}" FontStyle="Italic"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TabItemForegroundBrush}">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabPlate" Property="Background" Value="{DynamicResource LocalGlassButtonHoverBrush}" />
                            <Setter TargetName="TabPlate" Property="BorderBrush" Value="{DynamicResource LocalRimStrongBrush}" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TabItemHoverForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="3" />
                            <Setter TargetName="TabPlate" Property="Margin" Value="0,0,0,0" />
                            <Setter TargetName="TabPlate" Property="Background" Value="{DynamicResource LocalGlassTabActiveGradBrush}" />
                            <Setter TargetName="TabPlate" Property="BorderBrush" Value="{DynamicResource LocalRimStrongBrush}" />
                            <Setter TargetName="TabPlate" Property="BorderThickness" Value="1,1,1,0" />
                            <Setter TargetName="IdleShadow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ActiveTopBar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="HeaderText" Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
