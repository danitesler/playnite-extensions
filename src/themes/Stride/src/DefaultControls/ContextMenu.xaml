<!--
    Stride v2: DefaultControls/ContextMenu.xaml.
    Unified Mirror's Edge Architectural Glass popup sheet (LocalStrideMenuBoardTemplate) shared by
    ContextMenu, TopPanelMenu, Menu.xaml submenus, and ComboBox.xaml dropdowns:
    - Tempered ice-blue frosted glass sheet (LocalGlassSurfaceBrush)
    - 9-slice velvety 4-edge cool-blue glass inner shadow (LocalGlassInsetTemplate)
    - Diagonal window glass reflection (LocalGlassSheenTemplate)
    - 1px steel-blue rim + 1px white top specular catchlight
    - Iconic 4px Blazing Mirror's Edge Red vertical pillar along the left edge
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Tempered Glass Menu Board Chrome -->
    <ControlTemplate x:Key="LocalStrideMenuBoardTemplate" TargetType="Control">
        <Border Background="{DynamicResource LocalGlassSurfaceBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="{DynamicResource PopupBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                SnapsToDevicePixels="True" IsHitTestVisible="False">
            <Grid>
                <!-- Velvety 4-edge cool-blue glass inner shadow -->
                <Control Template="{DynamicResource LocalGlassInsetTemplate}"
                         Foreground="{DynamicResource LocalGlassInsetBrush}" Opacity="0.22"
                         IsHitTestVisible="False" />
                <!-- Diagonal window sheen -->
                <Control Template="{DynamicResource LocalGlassSheenTemplate}"
                         Foreground="{DynamicResource LocalWhiteBrush}" Opacity="0.16"
                         IsHitTestVisible="False" />
                <!-- Top specular catchlight -->
                <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource LocalWhiteBrush}"
                        Opacity="0.90" IsHitTestVisible="False" />
                <!-- Signature 4px Blazing Mirror's Edge Red vertical pillar on the left edge -->
                <Border Width="4" HorizontalAlignment="Left" Background="{DynamicResource LocalRedPillarBrush}"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Padding" Value="{DynamicResource MenuPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid MinWidth="188" SnapsToDevicePixels="True">
                        <Control Template="{DynamicResource LocalStrideMenuBoardTemplate}"
                                 Focusable="False" IsTabStop="False" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Margin="5,5,1,5">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
