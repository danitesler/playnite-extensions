<!--
    Stride v2: DefaultControls/TreeView.xaml.
    Settings & Add-ons frosted ice-blue glass navigation column (docs/themes/settings-screens.md):
    - Tempered ice-blue frosted glass column with velvety 4-edge inner shadow & steel-blue right rim
    - Minimal bare 28px rows in Barlow body font (no idle boxes/borders, no heading face/caps)
    - Hover washes pure snow-white (LocalWhiteBrush); IsSelected paints Mirror's Edge 2008 glossy charcoal-glass
      bar (LocalCharcoalBarBrush) + 3px blazing red left pillar + pure white text (changes 2+ named parts)
    - WindowSettings (Width=252) & WindowExtensions (Width=280) reserve VerticalScrollBarVisibility=Visible
      and HorizontalScrollBarVisibility=Disabled so expanding nodes never causes a layout reflow
    - Expander carries explicit Width="16" Height="16"; Separator scoped in TreeView.Resources.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LocalTreeExpandToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" Width="16" Height="16">
                        <ContentControl x:Name="ExpGlyph" Width="10" Height="10"
                                        Content="{DynamicResource IconSubmenu}"
                                        ContentTemplate="{DynamicResource IconSmallTemplate}"
                                        Foreground="{DynamicResource GlyphBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Focusable="False" IsTabStop="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ExpGlyph" Property="Content" Value="{DynamicResource IconDropDown}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource BaseStyle}">
        <Style.Resources>
            <Style TargetType="{x:Type Separator}">
                <Setter Property="Tag" Value="TreeSeparator" />
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="8,6" />
                <Setter Property="Background" Value="{DynamicResource WindowPanelSeparatorBrush}" />
            </Style>
        </Style.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,8,4,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Border x:Name="TreeFrame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Control x:Name="TreeGlassShadow" Template="{DynamicResource LocalGlassInsetTemplate}"
                                     Foreground="{DynamicResource LocalGlassInsetBrush}" Opacity="0.22"
                                     Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False"
                                          CanContentScroll="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          Padding="{TemplateBinding Padding}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(AutomationProperties.AutomationId)}" Value="WindowSettings">
                            <Setter TargetName="TreeGlassShadow" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(AutomationProperties.AutomationId)}" Value="WindowExtensions">
                            <Setter TargetName="TreeGlassShadow" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(AutomationProperties.AutomationId)}" Value="WindowSettings">
                <Setter Property="Width" Value="252" />
                <Setter Property="Background" Value="{DynamicResource LocalGlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(AutomationProperties.AutomationId)}" Value="WindowExtensions">
                <Setter Property="Width" Value="280" />
                <Setter Property="Background" Value="{DynamicResource LocalGlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WindowPanelSeparatorBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LocalSteelInkBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <StackPanel SnapsToDevicePixels="True">
                        <!-- Bare 28px row in body font -->
                        <Grid x:Name="RowGrid" MinHeight="28" Margin="0,1" Background="Transparent" Cursor="Hand">
                            <Border x:Name="HoverPlate" Background="{DynamicResource LocalWhiteBrush}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <!-- Glossy Charcoal-Glass Selection Bar (id=815) -->
                            <Border x:Name="SelectedPlate" Background="{DynamicResource LocalCharcoalBarBrush}"
                                    BorderBrush="{DynamicResource LocalCharcoalBotBrush}" BorderThickness="0,1,0,1"
                                    Opacity="0" IsHitTestVisible="False">
                                <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource LocalWhiteBrush}" Opacity="0.22" />
                            </Border>

                            <Grid Margin="10,2,8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="Expander" Grid.Column="0" Width="16" Height="16"
                                              Style="{StaticResource LocalTreeExpandToggle}"
                                              IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press" VerticalAlignment="Center" />

                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="MaxWidth" Value="196" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Grid>

                        <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Hidden (not Collapsed) keeps parent & leaf labels aligned on one vertical column -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="RowGrid">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="TreeHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="TreeHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="SelectedPlate" Property="Opacity" Value="1" />
                            <Setter TargetName="HoverPlate" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag}" Value="TreeSeparator">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
