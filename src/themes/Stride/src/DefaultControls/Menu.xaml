<!--
    Stride v2: DefaultControls/Menu.xaml.
    Compact 30px Mirror's Edge Architectural Glass rows:
    - Defines {x:Static MenuItem.SubmenuItemTemplateKey} & {x:Static MenuItem.SubmenuHeaderTemplateKey}
    - Idle: dark carbon ink over tempered ice-blue glass sheet
    - Highlighted: glossy charcoal-glass horizontal wipe bar (LocalCharcoalBarBrush, ScaleX 0.90->1, 110ms)
      with chunky blazing Mirror's Edge Red '+' mark sliding in on left, pure white inverted label/icon/chevron,
      and frosted keycap
    - Exit (Alt+Q): blazing crimson glass bar with pure white '+' mark and white label/icon/keycap
    - Checked: 14x14 steel-blue square filled blazing crimson with pure white checkmark
    - Separator: 10px steel-blue hairline led by a chunky red '+' mark
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group Separator: 10px steel-blue architectural hairline led by a chunky blazing red '+' -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="8,1,8,1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{DynamicResource LocalPlusMark}" Width="7" Height="7" Stretch="Uniform"
                              Fill="{DynamicResource GlyphBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <Border Grid.Column="1" Height="1" VerticalAlignment="Center"
                                Background="{DynamicResource MenuSeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Submenu Leaf Item Template -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True" Margin="2,0">
            <!-- Glossy Charcoal-Glass Wipe Highlight Bar (110ms CubicEase from left) -->
            <Border x:Name="HighlightBar" Background="{DynamicResource LocalCharcoalBarBrush}"
                    BorderBrush="{DynamicResource LocalCharcoalBotBrush}" BorderThickness="0,1,0,1"
                    Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" ScaleY="1" />
                </Border.RenderTransform>
                <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource LocalWhiteBrush}" Opacity="0.22" />
            </Border>

            <!-- Chunky Blazing Red '+' Signal Mark on left of active highlight (white on Exit) -->
            <Path x:Name="HoverPlus" Data="{DynamicResource LocalPlusMark}" Width="9" Height="9" Stretch="Uniform"
                  Fill="{DynamicResource LocalCrimsonTopBrush}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                  Visibility="Collapsed" IsHitTestVisible="False" />

            <Grid Margin="18,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" SharedSizeGroup="Icon" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="16" Height="16">
                    <ContentPresenter x:Name="Icon" ContentSource="Icon"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                    <Border x:Name="CheckBoxPlate" Width="14" Height="14"
                            Background="{DynamicResource CheckBoxCheckMarkBkBrush}"
                            BorderBrush="{DynamicResource CheckBoxBorderBrush}" BorderThickness="1"
                            Visibility="Collapsed" SnapsToDevicePixels="True">
                        <Path x:Name="CheckGlyph" Data="{DynamicResource IconCheck}"
                              Width="9" Height="9" Stretch="Uniform"
                              Fill="{DynamicResource PrimaryButtonForegroundBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed" />
                    </Border>
                </Grid>

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="True" VerticalAlignment="Center"
                                  Margin="4,0,14,0" />

                <Border x:Name="ShortcutChip" Grid.Column="2" VerticalAlignment="Center"
                        Background="{DynamicResource LocalGlassMidBrush}"
                        BorderBrush="{DynamicResource LocalRimSoftBrush}" BorderThickness="1"
                        Padding="5,1" Margin="0,0,4,0">
                    <TextBlock x:Name="ShortcutText" Text="{TemplateBinding InputGestureText}"
                               FontFamily="{DynamicResource MonospaceFontFamily}" FontSize="10.5"
                               Foreground="{DynamicResource LocalSteelInkBrush}" />
                </Border>
            </Grid>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="">
                <Setter TargetName="ShortcutChip" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InputGestureText" Value="{x:Null}">
                <Setter TargetName="ShortcutChip" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsCheckable" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckBoxPlate" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckBoxPlate" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckBoxPlate" Property="Background" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="CheckBoxPlate" Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="HoverPlus" Property="Visibility" Value="Visible" />
                <Setter TargetName="ShortcutChip" Property="Background" Value="{DynamicResource LocalCharcoalTopBrush}" />
                <Setter TargetName="ShortcutChip" Property="BorderBrush" Value="{DynamicResource LocalCharcoalBotBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="MenuRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.11">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MenuRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <!-- Exit / Destructive Row (Alt+Q): Blazing Mirror's Edge Red glass bar with white '+' and white text -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="InputGestureText" Value="Alt+Q" />
                    <Condition Property="IsHighlighted" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="HighlightBar" Property="Background" Value="{DynamicResource LocalCrimsonGlassBrush}" />
                <Setter TargetName="HighlightBar" Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter TargetName="HoverPlus" Property="Fill" Value="{DynamicResource LocalWhiteBrush}" />
                <Setter TargetName="ShortcutChip" Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                <Setter TargetName="ShortcutChip" Property="BorderBrush" Value="{DynamicResource LocalCrimsonTopBrush}" />
                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Submenu Header Template (with Chevron & Child Popup reusing LocalStrideMenuBoardTemplate) -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="{x:Type MenuItem}">
        <Grid x:Name="RowRoot" Height="30" Background="Transparent" SnapsToDevicePixels="True" Margin="2,0">
            <Border x:Name="HighlightBar" Background="{DynamicResource LocalCharcoalBarBrush}"
                    BorderBrush="{DynamicResource LocalCharcoalBotBrush}" BorderThickness="0,1,0,1"
                    Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="HighlightScale" ScaleX="0.90" ScaleY="1" />
                </Border.RenderTransform>
                <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource LocalWhiteBrush}" Opacity="0.22" />
            </Border>

            <Path x:Name="HoverPlus" Data="{DynamicResource LocalPlusMark}" Width="9" Height="9" Stretch="Uniform"
                  Fill="{DynamicResource LocalCrimsonTopBrush}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                  Visibility="Collapsed" IsHitTestVisible="False" />

            <Grid Margin="18,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" SharedSizeGroup="Icon" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="16" Height="16">
                    <ContentPresenter x:Name="Icon" ContentSource="Icon"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>

                <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="True" VerticalAlignment="Center"
                                  Margin="4,0,14,0" />

                <ContentControl x:Name="SubmenuArrow" Grid.Column="3"
                                Content="{DynamicResource IconSubmenu}"
                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Focusable="False" IsTabStop="False" />
            </Grid>

            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-5"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade">
                <Grid MinWidth="188" SnapsToDevicePixels="True">
                    <Control Template="{DynamicResource LocalStrideMenuBoardTemplate}"
                             Focusable="False" IsTabStop="False" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="5,5,1,5">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter TargetName="HoverPlus" Property="Visibility" Value="Visible" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SubRowIn">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="HighlightBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                            <DoubleAnimation Storyboard.TargetName="HighlightScale" Storyboard.TargetProperty="ScaleX" From="0.90" To="1" Duration="0:0:0.11">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="SubRowOut">
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="HighlightBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightBar" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Menu}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource LocalGlassHeaderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
</ResourceDictionary>
