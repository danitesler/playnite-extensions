<!--
    Stride v2: Constants.xaml template. scripts/build-theme.ps1 renders it with tokens.css into Constants.xaml.
    Mirror's Edge (2008 id=815) & Mirror's Edge Catalyst (id=181) Architectural Glass theme:
    - Tempered ice-blue frosted glass surfaces with velvety 4-edge cool-blue inner shadows
    - Blazing Mirror's Edge Red full-height sidebar pillar with pure white inverted active slab
    - Glossy vertical charcoal-glass selection bars with pure white ink and chunky red '+' markers
    - Blazing red scrollbar thumb & slider thumb on translucent steel-blue glass tracks
    - Raised snow-white vs recessed ice-blue glass folder tabs + Rooftop Sky Cerulean running polarity
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography (bundled SIL OFL static TTFs in src/Typography/ + Windows Consolas) -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeLarger">20</sys:Double>
    <sys:Double x:Key="FontSizeLargest">28</sys:Double>
    <FontFamily x:Key="FontFamily">./Typography/#Barlow, Barlow, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">./Typography/#Orbitron, Orbitron, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Usable metadata content width & pane position (ThemeModifier editable) -->
    <sys:Double x:Key="GameDetailsPaneWidth">300</sys:Double>
    <sys:Double x:Key="GridDetailsPaneWidth">300</sys:Double>
    <HorizontalAlignment x:Key="GameDetailsPanePosition">Right</HorizontalAlignment>

    <!-- Sharp Architectural Glass Geometry -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <sys:Double x:Key="EllipseBorderThickness">1.5</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">{{px:me-radius-md}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">{{px:me-radius-sm}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">{{px:me-radius-lg}}</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">{{px:me-radius-full}}</CornerRadius>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <!-- Playnite Palette Colors -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">{{me-ink}}</Color>
    <Color x:Key="TextColorDarker">{{me-ink-muted}}</Color>
    <Color x:Key="TextColorDark">{{me-white}}</Color>
    <Color x:Key="MainColor">{{me-glass-mid}}</Color>
    <Color x:Key="MainColorDark">{{me-glass-bot}}</Color>
    <Color x:Key="HoverColor">{{me-glass-hover}}</Color>
    <Color x:Key="GlyphColor">{{me-crimson}}</Color>
    <Color x:Key="HighlightGlyphColor">{{me-crimson-wash}}</Color>
    <Color x:Key="PopupBackgroundColor">{{me-glass-top}}</Color>
    <Color x:Key="PopupBorderColor">{{me-rim}}</Color>
    <Color x:Key="BackgroundToneColor">{{me-glass-mid}}</Color>
    <Color x:Key="GridItemBackgroundColor">#00000000</Color>
    <Color x:Key="PanelSeparatorColor">{{me-rim}}</Color>
    <Color x:Key="WindowPanelSeparatorColor">{{me-rim}}</Color>
    <Color x:Key="DataChangeNotifColor">{{me-amber}}</Color>

    <!-- Playnite Palette Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{{me-charcoal-bot}}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{{me-white}}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{{me-crimson}}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{{me-glass-top}}" />
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{DynamicResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{{me-glass-top}}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />
    <SolidColorBrush x:Key="PositiveRatingBrush" Color="{{me-emerald}}" />
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="{{me-danger}}" />
    <SolidColorBrush x:Key="MixedRatingBrush" Color="{{me-amber-text}}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{{me-amber}}" />
    <SolidColorBrush x:Key="ExpanderBackgroundBrush" Color="{{me-glass-mid}}" />
    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="{{me-sky-bg}}" />

    <!-- Shell, Chrome & Game Page Brushes (glacial sky-mist & tempered ice-blue glass) -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{{me-sky-bg}}" />
    <SolidColorBrush x:Key="TopPanelBackgroundBrush" Color="{{me-glass-mid}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxBackgroundBrush" Color="{{me-glass-top}}" />
    <SolidColorBrush x:Key="TopPanelSearchBoxHoverBackgroundBrush" Color="{{me-white}}" />
    <SolidColorBrush x:Key="TopPanelSeparatorBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="MainMenuButtonBackgroundBrush" Color="{{me-crimson}}" />
    <SolidColorBrush x:Key="MainMenuButtonForegroundBrush" Color="{{me-white}}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{{me-sky-bg}}" />
    <SolidColorBrush x:Key="GameOverviewBackgroundBrush" Color="{{me-sky-bg}}" />
    <!-- Solid glacial sky-mist banner tint so darkened hero dissolves seamlessly into daylight canvas -->
    <SolidColorBrush x:Key="GameBannerTintBrush" Color="{{me-sky-bg}}" />
    <!-- Light-theme ink flip when ShowBackgroundImageOnWindow=True -->
    <SolidColorBrush x:Key="WindowArtForegroundBrush" Color="{{me-white}}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{{me-scrim}}" />
    <SolidColorBrush x:Key="WindowTitleBackgroundBrush" Color="{{me-glass-top}}" />
    <SolidColorBrush x:Key="WindowTitleForegroundBrush" Color="{{me-ink}}" />

    <!-- States (Glossy charcoal-glass selection + blazing crimson actions + Rooftop Sky Cerulean running) -->
    <SolidColorBrush x:Key="SelectedBrush" Color="{{me-crimson}}" />
    <SolidColorBrush x:Key="SelectedHoverBrush" Color="{{me-crimson-hover}}" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="{{me-crimson}}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{{me-white}}" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{{me-glass-hover}}" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{{me-charcoal-mid}}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{{me-charcoal-mid}}" />
    <!-- Dedicated Running & Launching hue: Rooftop Sky Cerulean -->
    <SolidColorBrush x:Key="RunningIndicatorBrush" Color="{{me-sky}}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{{me-crimson}}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{{me-danger}}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{{me-white}}" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{{me-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="{{me-ink}}" />
    <SolidColorBrush x:Key="ButtonPressedForegroundBrush" Color="{{me-ink}}" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="{{me-glass-hover}}" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="{{me-glass-bot}}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{{me-crimson}}" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{{me-crimson-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="{{me-crimson-hover}}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="{{me-crimson-press}}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="{{me-white}}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{{me-glass-top}}" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="{{me-white}}" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="{{me-glass-bot}}" />
    <SolidColorBrush x:Key="ToggleButtonCheckedBackgroundBrush" Color="{{me-crimson}}" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{{me-glass-top}}" />
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="{{me-white}}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{{me-rim-strong}}" />
    <SolidColorBrush x:Key="InputUnderlineBrush" Color="{{me-rim-strong}}" />
    <SolidColorBrush x:Key="InputHoverUnderlineBrush" Color="{{me-crimson}}" />

    <!-- Controls & Typography Helpers -->
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{{me-rim-strong}}" />
    <SolidColorBrush x:Key="CheckBoxHoverBorderBrush" Color="{{me-crimson}}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{{me-slider-idle}}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundBrush" Color="{{me-crimson-top}}" />
    <SolidColorBrush x:Key="SliderThumbHoverBorderBrush" Color="{{me-crimson-press}}" />
    <SolidColorBrush x:Key="SliderHoverForegroundBrush" Color="{{me-slider-active}}" />
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="{{me-crimson}}" />
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="{{me-track-blue}}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{{me-crimson-top}}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{{me-crimson-hover}}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{{me-track-blue}}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{{me-crimson-top}}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{{me-crimson-hover}}" />
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="{{me-steel-ink}}" />
    <SolidColorBrush x:Key="TabItemHoverForegroundBrush" Color="{{me-ink}}" />
    <SolidColorBrush x:Key="TabItemIndicatorBrush" Color="{{me-crimson}}" />
    <SolidColorBrush x:Key="TabItemHoverIndicatorBrush" Color="{{me-rim-strong}}" />
    <SolidColorBrush x:Key="TabControlHeaderBackgroundBrush" Color="{{me-glass-tab-idle}}" />
    <SolidColorBrush x:Key="GridViewItemHoverBorderBrush" Color="{{me-charcoal-bot}}" />
    <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{{me-crimson}}" />
    <SolidColorBrush x:Key="TopPanelItemHoverBackgroundBrush" Color="{{me-white}}" />
    <SolidColorBrush x:Key="TopPanelItemCheckedBackgroundBrush" Color="{{me-crimson}}" />
    <SolidColorBrush x:Key="SidebarItemForegroundBrush" Color="{{me-white}}" />
    <SolidColorBrush x:Key="SidebarItemSelectedForegroundBrush" Color="{{me-ink}}" />
    <SolidColorBrush x:Key="PropertyItemBackgroundBrush" Color="{{me-glass-top}}" />
    <SolidColorBrush x:Key="PropertyItemForegroundBrush" Color="{{me-ink}}" />
    <SolidColorBrush x:Key="PropertyItemHoverBackgroundBrush" Color="{{me-charcoal-mid}}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{{me-rim-soft}}" />
    <SolidColorBrush x:Key="HeadingForegroundBrush" Color="{{me-steel-ink}}" />
    <SolidColorBrush x:Key="HeadingMarkerBrush" Color="{{me-crimson}}" />
    <SolidColorBrush x:Key="HeadingRuleBrush" Color="{{me-rim}}" />
    <SolidColorBrush x:Key="SectionHeaderBrush" Color="{{me-steel-ink}}" />
    <SolidColorBrush x:Key="LinkBrush" Color="{{me-ink}}" />

    <!-- Stride v2 Local Architectural Glass, Pillar & Charcoal Tokens -->
    <SolidColorBrush x:Key="LocalSkyTopBrush" Color="{{me-sky-top}}" />
    <SolidColorBrush x:Key="LocalGlassTopBrush" Color="{{me-glass-top}}" />
    <SolidColorBrush x:Key="LocalGlassMidBrush" Color="{{me-glass-mid}}" />
    <SolidColorBrush x:Key="LocalGlassBotBrush" Color="{{me-glass-bot}}" />
    <SolidColorBrush x:Key="LocalGlassTabIdleBrush" Color="{{me-glass-tab-idle}}" />
    <SolidColorBrush x:Key="LocalGlassZebraBrush" Color="{{me-glass-zebra}}" />
    <SolidColorBrush x:Key="LocalGlassInsetBrush" Color="{{me-glass-inset}}" />
    <SolidColorBrush x:Key="LocalSkylineBrush" Color="{{me-skyline}}" />
    <SolidColorBrush x:Key="LocalRimSoftBrush" Color="{{me-rim-soft}}" />
    <SolidColorBrush x:Key="LocalRimStrongBrush" Color="{{me-rim-strong}}" />
    <SolidColorBrush x:Key="LocalSteelInkBrush" Color="{{me-steel-ink}}" />
    <SolidColorBrush x:Key="LocalInkSubtleBrush" Color="{{me-ink-subtle}}" />
    <SolidColorBrush x:Key="LocalWhiteBrush" Color="{{me-white}}" />
    <SolidColorBrush x:Key="LocalCharcoalTopBrush" Color="{{me-charcoal-top}}" />
    <SolidColorBrush x:Key="LocalCharcoalBotBrush" Color="{{me-charcoal-bot}}" />
    <SolidColorBrush x:Key="LocalCrimsonTopBrush" Color="{{me-crimson-top}}" />
    <SolidColorBrush x:Key="LocalCrimsonBotBrush" Color="{{me-crimson-bot}}" />
    <SolidColorBrush x:Key="LocalSliderActiveBrush" Color="{{me-slider-active}}" />
    <SolidColorBrush x:Key="LocalSkyBrightBrush" Color="{{me-sky-bright}}" />
    <SolidColorBrush x:Key="LocalSkyWashBrush" Color="{{me-sky-wash}}" />
    <SolidColorBrush x:Key="LocalAmberSignalBrush" Color="{{me-amber}}" />

    <!-- Reusable Tempered Glass, Red Pillar & Glossy Charcoal Gradient Brushes -->
    <LinearGradientBrush x:Key="LocalSkyCanvasBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{me-sky-top}}" Offset="0" />
        <GradientStop Color="{{me-sky-bg}}" Offset="0.28" />
        <GradientStop Color="{{me-sky-bg}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{me-glass-top}}" Offset="0" />
        <GradientStop Color="{{me-glass-mid}}" Offset="0.52" />
        <GradientStop Color="{{me-glass-bot}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{me-white}}" Offset="0" />
        <GradientStop Color="{{me-glass-mid}}" Offset="0.58" />
        <GradientStop Color="{{me-glass-bot}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{me-white}}" Offset="0" />
        <GradientStop Color="{{me-glass-mid}}" Offset="0.58" />
        <GradientStop Color="{{me-glass-bot}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{me-white}}" Offset="0" />
        <GradientStop Color="{{me-glass-hover}}" Offset="0.62" />
        <GradientStop Color="{{me-glass-mid}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassTabIdleGradBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{me-glass-mid}}" Offset="0" />
        <GradientStop Color="{{me-glass-tab-idle}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalGlassTabActiveGradBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{me-white}}" Offset="0" />
        <GradientStop Color="{{me-glass-top}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalRedPillarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{me-crimson-top}}" Offset="0" />
        <GradientStop Color="{{me-crimson}}" Offset="0.5" />
        <GradientStop Color="{{me-crimson-bot}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalCrimsonGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{me-crimson-top}}" Offset="0" />
        <GradientStop Color="{{me-crimson}}" Offset="0.5" />
        <GradientStop Color="{{me-crimson-bot}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalCrimsonGlassHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{me-crimson}}" Offset="0" />
        <GradientStop Color="{{me-crimson-hover}}" Offset="0.55" />
        <GradientStop Color="{{me-crimson-press}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalCharcoalBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{{me-charcoal-top}}" Offset="0" />
        <GradientStop Color="{{me-charcoal-mid}}" Offset="0.48" />
        <GradientStop Color="{{me-charcoal-bot}}" Offset="1" />
    </LinearGradientBrush>

    <!-- Architectural Glass Score Plaque Brushes (4px left signal bar + frosted ice-blue glass body) -->
    <LinearGradientBrush x:Key="LocalScorePositiveBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="5,0" SpreadMethod="Pad">
        <GradientStop Color="{{me-emerald}}" Offset="0" />
        <GradientStop Color="{{me-emerald}}" Offset="0.80" />
        <GradientStop Color="{{me-glass-top}}" Offset="0.81" />
        <GradientStop Color="{{me-glass-top}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalScoreMixedBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="5,0" SpreadMethod="Pad">
        <GradientStop Color="{{me-amber}}" Offset="0" />
        <GradientStop Color="{{me-amber}}" Offset="0.80" />
        <GradientStop Color="{{me-glass-top}}" Offset="0.81" />
        <GradientStop Color="{{me-glass-top}}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LocalScoreNegativeBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="5,0" SpreadMethod="Pad">
        <GradientStop Color="{{me-danger}}" Offset="0" />
        <GradientStop Color="{{me-danger}}" Offset="0.80" />
        <GradientStop Color="{{me-glass-top}}" Offset="0.81" />
        <GradientStop Color="{{me-glass-top}}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
