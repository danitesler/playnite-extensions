<!--
    Stride v2: DerivedStyles/PropertyItemButton.xaml.
    Metadata values: crisp steel-blue underlined architectural links by default; frosted ice-blue glass tag chips
    (LocalGlassButtonBrush + white top catchlight + 1px steel-blue rim) when inside a Tag="Chip" ItemsControl,
    inverting sharply to Mirror's Edge 2008 glossy charcoal-glass bar + 2.5px blazing red left rail + pure white ink
    on hover.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="LocalGlassChipTemplate" TargetType="{x:Type Button}">
        <Border x:Name="ChipPlate" Background="{DynamicResource LocalGlassButtonBrush}"
                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Margin="0,0,5,5" SnapsToDevicePixels="True" Cursor="Hand">
            <Grid>
                <Border x:Name="TopCatch" VerticalAlignment="Top" Height="1"
                        Background="{DynamicResource LocalWhiteBrush}" Opacity="0.88" IsHitTestVisible="False" />
                <TextBlock x:Name="ChipLabel" Margin="7,2,7,3"
                           FontFamily="{DynamicResource FontFamily}" FontSize="{DynamicResource FontSizeSmall}"
                           FontWeight="Medium" Foreground="{DynamicResource PropertyItemForegroundBrush}"
                           VerticalAlignment="Center">
                    <ContentPresenter ContentSource="Content" RecognizesAccessKey="True" />
                </TextBlock>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChipPlate" Property="Background" Value="{DynamicResource LocalCharcoalBarBrush}" />
                <Setter TargetName="ChipPlate" Property="BorderBrush" Value="{DynamicResource LocalCharcoalBotBrush}" />
                <Setter TargetName="TopCatch" Property="Opacity" Value="0.24" />
                <Setter TargetName="ChipLabel" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ChipPlate" Property="Background" Value="{DynamicResource LocalCrimsonGlassBrush}" />
                <Setter TargetName="ChipPlate" Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter TargetName="ChipLabel" Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PropertyItemButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="LinkWrap" Background="Transparent" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource NormalBorderBrush}" Padding="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="LinkWrap" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Template" Value="{StaticResource LocalGlassChipTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
