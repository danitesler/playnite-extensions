<!--
    Stride: DerivedStyles/PlayButton.xaml (+ RunningActionIndicator).
    Hero Moment (PlayButton): 168x42 solid Runner Vision crimson (#D8121B) architectural slab with 4px pure white
    leading bar, Sora Bold label, and crisp ControlCornerRadius. On hover, deepens to #B50E16, sweeps the -22 deg
    diagonal white kinetic velocity sheen (stride-sheen.png) across the plate, and glides right-edge twin momentum
    chevrons (+4px, 140ms CubicEase). Press snaps to #920B12 with subtle 0.985 scale detent.
    Tag="ContextAction" hides Play-only glyph & chevrons.
    Launching/Running: plate fills solid Rooftop Sky Cerulean (#006EA8) darkened by RunningBreath scrim (#141A22,
    keeping white text >7.5:1), carries angled diagonal RunningScan (EndPoint="1,0.35"), reserves PlayRoom
    padding 0,0,36,0 for RunningActionIndicator's 3 staggered skewed momentum bars, and shows LOCCancelLabel +
    RunningHoverDim ONLY on IsRunning + IsMouseOver (RelativeSource Self, never TemplatedParent), hiding
    PlayContent with Visibility="Hidden" so the button never resizes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="MinWidth" Value="168" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="18,0,16,0" />
        <Setter Property="Background" Value="{DynamicResource LocalCrimsonGlassBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <!-- FOLLOW THE RED soft wide elliptical crimson bloom spilling under the Play button -->
                        <Rectangle x:Name="PlayBottomGlow" Height="26" VerticalAlignment="Bottom" Margin="-10,0,-10,-26"
                                   Fill="{DynamicResource LocalCrimsonTopBrush}" Opacity="0.58" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.52" RadiusY="0.92">
                                    <GradientStop Color="#E0000000" Offset="0" />
                                    <GradientStop Color="#6E000000" Offset="0.32" />
                                    <GradientStop Color="#22000000" Offset="0.65" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>

                        <Border x:Name="PlayFill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Top white glass catchlight + clean luminous white-hot bottom rim -->
                                <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource LocalWhiteBrush}"
                                        Opacity="0.38" IsHitTestVisible="False" />
                                <Rectangle x:Name="PlayBottomRim" VerticalAlignment="Bottom" Height="1.5"
                                           Fill="{DynamicResource LocalWhiteBrush}" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#55000000" Offset="0" />
                                            <GradientStop Color="#FF000000" Offset="0.35" />
                                            <GradientStop Color="#FF000000" Offset="0.65" />
                                            <GradientStop Color="#55000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource LocalWhiteBrush}"
                                           OpacityMask="{DynamicResource LocalGlassSheenMaskBrush}"
                                           Opacity="0.16" IsHitTestVisible="False" />

                                <!-- Idle hover fill (explicitly collapsed while launching or running) -->
                                <Border x:Name="HoverPlate" Background="{DynamicResource LocalCrimsonGlassHoverBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Hero diagonal window glass sheen sweeping across Play on hover -->
                                <Rectangle x:Name="HoverSheen" Fill="{DynamicResource PrimaryButtonForegroundBrush}"
                                           OpacityMask="{DynamicResource LocalGlassSheenMaskBrush}"
                                           Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="SheenSlide" X="-28" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>

                                <!-- Press detent layer -->
                                <Border x:Name="PressPlate" Background="{DynamicResource PrimaryButtonPressedBackgroundBrush}"
                                        Visibility="Collapsed" IsHitTestVisible="False" />

                                <!-- RunningBreath scrim: darkens RunningIndicatorBrush plate for >=7.5:1 label contrast -->
                                <Border x:Name="RunningBreath" Background="{DynamicResource ScrimBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- Angled diagonal Launching velocity sweep inside the plate shape -->
                                <Border x:Name="RunningScan" Visibility="Collapsed"
                                        Background="{DynamicResource LocalSkyBrightBrush}" Opacity="0.46"
                                        IsHitTestVisible="False">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                                            <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                            <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                            <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>

                                <!-- Cancel hover scrim (strictly below label; animated independently from RunningBreath) -->
                                <Border x:Name="RunningHoverDim" Background="{DynamicResource ScrimBrush}"
                                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />

                                <!-- PlayRoom reserves right strip while Launching/Running so mark never touches text -->
                                <Border x:Name="PlayRoom" Padding="0">
                                    <Grid Margin="{TemplateBinding Padding}">
                                        <DockPanel x:Name="PlayContent" VerticalAlignment="Center" LastChildFill="True">
                                            <!-- Right-edge twin diagonal momentum chevrons (Play only, hidden on ContextAction & launch/run) -->
                                            <StackPanel x:Name="PlayChevrons" DockPanel.Dock="Right" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                                                <StackPanel.RenderTransform>
                                                    <TranslateTransform x:Name="ChevronShift" X="0" />
                                                </StackPanel.RenderTransform>
                                                <ContentControl Width="10" Height="10" Content="{DynamicResource IconSubmenu}"
                                                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                                Foreground="{TemplateBinding Foreground}" Focusable="False" IsTabStop="False" />
                                                <ContentControl Width="10" Height="10" Margin="-3,0,0,0" Opacity="0.68"
                                                                Content="{DynamicResource IconSubmenu}"
                                                                ContentTemplate="{DynamicResource IconSmallTemplate}"
                                                                Foreground="{TemplateBinding Foreground}" Focusable="False" IsTabStop="False" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ContentControl x:Name="PlayIconHost" Width="13" Height="13" Margin="0,0,8,0"
                                                                Content="{DynamicResource IconPlay}"
                                                                ContentTemplate="{DynamicResource IconTemplate}"
                                                                Foreground="{TemplateBinding Foreground}"
                                                                VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Running hover Cancel overlay (keeps identical button size while PlayContent is Hidden) -->
                                        <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}"
                                                   Visibility="Collapsed" Opacity="0"
                                                   Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                                                   FontFamily="{DynamicResource HeadingFontFamily}"
                                                   FontSize="13.5" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- ContextAction (Install / Running / Launching): hide Play-only icon & chevrons -->
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayIconHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayChevrons" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Idle Play hover ONLY when not launching or running (animated layers never paint over sky plate) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning, FallbackValue=False}" Value="False" />
                                <Condition Binding="{Binding IsLaunching, FallbackValue=False}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PlayHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SheenSlide" Storyboard.TargetProperty="X" From="-28" To="6" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ChevronShift" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="PlayHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="SheenSlide" Storyboard.TargetProperty="X" To="-28" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="ChevronShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <!-- Tactile pressed detent -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressPlate" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PlayPressIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="PlayPressOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- RunningMarkRoom left="0" right="36" -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PlayBottomGlow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayBottomRim" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverSheen" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayChevrons" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayIconHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,36,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,0,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:1.55">
                                        <DoubleAnimation Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" From="0.46" To="0.54" Duration="0:0:0.25" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PlayBottomGlow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayBottomRim" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverSheen" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayChevrons" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayIconHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningBreath" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,36,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,0,0" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3.0">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.24" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0.42" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.24" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Running + button hover ONLY (RelativeSource Self, never TemplatedParent): show Cancel -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningHoverDim" Property="Visibility" Value="Visible" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" From="0" To="0.34" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="RunningCancelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Overlaid on the Play/ContextAction cell in Details & Grid overviews -->
    <Style x:Key="RunningActionIndicator" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.12"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />

                        <!-- 2px velocity track 4px above bottom edge -->
                        <Grid Height="2" VerticalAlignment="Bottom" Margin="5,0,5,4">
                            <Rectangle Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.28" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource PrimaryButtonForegroundBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" ScaleY="1" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>

                        <!-- Right-edge 3 staggered -22 deg pure-white momentum bars inside the reserved 36px strip -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,2">
                            <Polygon x:Name="M1" Points="2,0 5.5,0 3.5,9 0,9" Fill="{DynamicResource PrimaryButtonForegroundBrush}"
                                     VerticalAlignment="Bottom" Opacity="0.65" Margin="0,0,2.5,0" RenderTransformOrigin="0.5,1">
                                <Polygon.RenderTransform><ScaleTransform x:Name="M1Scale" ScaleY="0.7" /></Polygon.RenderTransform>
                            </Polygon>
                            <Polygon x:Name="M2" Points="2,0 5.5,0 3.5,14 0,14" Fill="{DynamicResource PrimaryButtonForegroundBrush}"
                                     VerticalAlignment="Bottom" Opacity="0.88" Margin="0,0,2.5,0" RenderTransformOrigin="0.5,1">
                                <Polygon.RenderTransform><ScaleTransform x:Name="M2Scale" ScaleY="0.85" /></Polygon.RenderTransform>
                            </Polygon>
                            <Polygon x:Name="M3" Points="2,0 5.5,0 3.5,11 0,11" Fill="{DynamicResource PrimaryButtonForegroundBrush}"
                                     VerticalAlignment="Bottom" Opacity="1.0" RenderTransformOrigin="0.5,1">
                                <Polygon.RenderTransform><ScaleTransform x:Name="M3Scale" ScaleY="0.75" /></Polygon.RenderTransform>
                            </Polygon>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:1.55">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M1Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="0.65" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M2Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M3Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="0.65" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3.0">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.74" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.74" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M1Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
