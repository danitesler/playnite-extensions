<!--
    Stride v2: DerivedStyles/StandardWindowStyle.xaml (Settings, Add-ons, Game Editor, dialogs).
    Tempered ice-blue glass window body with 4-edge cool-blue inner shadow, topped by a 44px Frosted Ice-Blue
    Glass Masthead (CaptionHeight=44, ContentPresenter Margin="0,44,0,0") crowned at far-left by a 14px Blazing
    Mirror's Edge Red vertical pillar, Stride Kinetic Shard Chevron, Sora Italic Bold title (WindowSettings ->
    LOCSettingsLabel), subtle city-skyline.png silhouette in a zero-desired-size Canvas, and 46x43 WindowBarButton.
    WindowDesignStyle is standalone (never BasedOn StandardWindowStyle).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource LocalGlassSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource LocalRimStrongBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Velvety 4-edge cool-blue glass inner shadow across the window interior -->
                                <Control Margin="0,44,0,0" Template="{DynamicResource LocalGlassInsetTemplate}"
                                         Foreground="{DynamicResource LocalGlassInsetBrush}" Opacity="0.22"
                                         IsHitTestVisible="False" Focusable="False" IsTabStop="False" />

                                <ContentPresenter Margin="0,44,0,0" />

                                <!-- 44px Frosted Ice-Blue Glass Masthead Title Band -->
                                <Grid Height="44" VerticalAlignment="Top" Background="{DynamicResource LocalGlassHeaderBrush}"
                                      ClipToBounds="True" SnapsToDevicePixels="True">
                                    <!-- White top glass catchlight -->
                                    <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource LocalWhiteBrush}"
                                            Opacity="0.92" IsHitTestVisible="False" />

                                    <!-- Signature 14px Blazing Mirror's Edge Red vertical pillar at far-left -->
                                    <Border Width="14" HorizontalAlignment="Left" Background="{DynamicResource LocalRedPillarBrush}"
                                            IsHitTestVisible="False" />

                                    <!-- Subtle sunlit skyscraper skyline in zero-desired-size Canvas (never inflates small dialogs) -->
                                    <Canvas IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="0" Height="0">
                                        <Control Canvas.Left="-410" Canvas.Top="-44" Width="260" Height="44"
                                                 Template="{DynamicResource LocalCitySkylineTemplate}"
                                                 Foreground="{DynamicResource LocalSkylineBrush}" Opacity="0.22"
                                                 Focusable="False" IsTabStop="False" />
                                    </Canvas>

                                    <!-- Closing 1px steel-blue glass rim -->
                                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource WindowPanelSeparatorBrush}"
                                            IsHitTestVisible="False" />

                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,12,0">
                                            <!-- Stride Kinetic Shard Chevron Brand Mark -->
                                            <Control Width="18" Height="18" Margin="0,0,10,0"
                                                     Template="{DynamicResource BrandMarkTemplate}"
                                                     Foreground="{DynamicResource GlyphBrush}"
                                                     VerticalAlignment="Center" IsHitTestVisible="False"
                                                     Focusable="False" IsTabStop="False" />

                                            <TextBlock x:Name="PART_TextTitle" Text="{TemplateBinding Title}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                                       FontStyle="Italic"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter Property="Text" Value="{DynamicResource LOCSettingsLabel}" TargetName="PART_TextTitle" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standalone WindowDesignStyle (never BasedOn StandardWindowStyle to avoid TargetType seal crash) -->
    <Style x:Key="WindowDesignStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource LocalGlassSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
    </Style>
</ResourceDictionary>
