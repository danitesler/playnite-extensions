<!--
    Stride: DerivedStyles/DetailsViewItemStyle.xaml.
    Calm snow-white Swiss library rows with smooth branded hover & click/selection animations:
    - Hover: cool concrete-mist wash (#E9EEF4) + 2px carbon-ink left guide (110ms CubicEase).
    - Selection: Runner Vision crimson wash (#FCECEE) + scaling 3.5px crimson left slash bar + sliding -22 deg
      crimson momentum chevron on the right edge (140ms CubicEase) + SemiBold carbon ink.
    - RowHoverAction: bare 26x26 Play / Install button on right edge (RowHoverRoom padding 0,0,38,0 on hover),
      explicitly collapsed during IsLaunching / IsRunning.
    - RunningIndicator: Rooftop Sky Cerulean angled velocity sweep, 2px bottom track, 3 staggered skewed bars,
      RunningMarkPlate + RowRoom padding 0,0,38,0.
    - Light-theme WindowArtForegroundBrush ink flip on unselected rows when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- RowHoverAction: bare transparent Play/Install glyph inheriting row Foreground -->
    <Style x:Key="LocalRowHoverButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Viewbox x:Name="Glyph" Width="14" Height="14" Opacity="0.75"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl Content="{TemplateBinding Content}"
                                            ContentTemplate="{DynamicResource IconTemplate}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Focusable="False" IsTabStop="False" />
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Width" Value="17" />
                            <Setter TargetName="Glyph" Property="Height" Value="17" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DetailsViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent" MinHeight="32" SnapsToDevicePixels="True">
                        <!-- Bright snow-white glass hover wash + subtle steel-blue rim -->
                        <Grid x:Name="HoverLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Background="{DynamicResource LocalWhiteBrush}" Opacity="0.90"
                                    BorderBrush="{DynamicResource LocalRimSoftBrush}" BorderThickness="0,1,0,1" />
                        </Grid>

                        <!-- Iconic Mirror's Edge 2008 Glossy Charcoal-Glass Selected Row + Blazing Red '+' Mark -->
                        <Grid x:Name="SelectedLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Background="{DynamicResource LocalCharcoalBarBrush}"
                                    BorderBrush="{DynamicResource LocalCharcoalBotBrush}" BorderThickness="0,1,0,1">
                                <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource LocalWhiteBrush}" Opacity="0.24" />
                            </Border>
                            <Path x:Name="SelectedChevron" Data="{DynamicResource LocalPlusMark}" Width="10" Height="10" Stretch="Uniform"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                  Fill="{DynamicResource LocalCrimsonTopBrush}">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="SelChevronSlide" X="-6" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>

                        <!-- RowRoom (running mark) + RowHoverRoom (hover Play/Install button) keep title clear -->
                        <Border x:Name="RowRoom" Padding="0">
                            <Border x:Name="RowHoverRoom" Padding="0">
                                <ContentPresenter x:Name="RowContent" Margin="4,2,6,2"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="RowSlide" X="0" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Border>

                        <!-- RowHoverAction: Installed -> StartGameCommand, Uninstalled -> InstallGameCommand -->
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button x:Name="RowHoverPlay"
                                    Command="{MainViewModel StartGameCommand}"
                                    CommandParameter="{Binding Game}"
                                    Content="{DynamicResource IconPlay}"
                                    ToolTip="{DynamicResource LOCPlayGame}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LocalRowHoverButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                    <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                    <Condition Binding="{Binding IsRunning}" Value="False" />
                                                    <Condition Binding="{Binding IsLaunching}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="RowHoverInstall"
                                    Command="{MainViewModel InstallGameCommand}"
                                    CommandParameter="{Binding Game}"
                                    Content="{DynamicResource IconDownload}"
                                    ToolTip="{DynamicResource LOCInstallGame}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LocalRowHoverButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
                                                    <Condition Binding="{Binding IsInstalled}" Value="False" />
                                                    <Condition Binding="{Binding IsRunning}" Value="False" />
                                                    <Condition Binding="{Binding IsLaunching}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Dedicated Rooftop Sky Cerulean Running / Launching Indicator (above selection & hover) -->
                        <Grid x:Name="RunningIndicator" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.18" />

                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.40">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>

                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="1.5" />

                            <!-- 2px velocity bottom track -->
                            <Grid Height="2" VerticalAlignment="Bottom" Margin="2,0,2,1">
                                <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.28" />
                                <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="RunningFillScale" ScaleX="0" ScaleY="1" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>

                            <!-- Right-edge mark backing strip + 3 staggered -22 deg sky momentum bars -->
                            <Border x:Name="RunningMarkPlate" Width="38" HorizontalAlignment="Right"
                                    Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.34">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="0.45" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,1">
                                <Polygon x:Name="M1" Points="2,0 5,0 3,8 0,8" Fill="{DynamicResource RunningIndicatorBrush}"
                                         VerticalAlignment="Bottom" Opacity="0.58" Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                                    <Polygon.RenderTransform><ScaleTransform x:Name="M1Scale" ScaleY="0.7" /></Polygon.RenderTransform>
                                </Polygon>
                                <Polygon x:Name="M2" Points="2,0 5,0 3,12 0,12" Fill="{DynamicResource RunningIndicatorBrush}"
                                         VerticalAlignment="Bottom" Opacity="0.82" Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                                    <Polygon.RenderTransform><ScaleTransform x:Name="M2Scale" ScaleY="0.85" /></Polygon.RenderTransform>
                                </Polygon>
                                <Polygon x:Name="M3" Points="2,0 5,0 3,10 0,10" Fill="{DynamicResource RunningIndicatorBrush}"
                                         VerticalAlignment="Bottom" Opacity="0.96" RenderTransformOrigin="0.5,1">
                                    <Polygon.RenderTransform><ScaleTransform x:Name="M3Scale" ScaleY="0.75" /></Polygon.RenderTransform>
                                </Polygon>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0,0,38,0" />
                            <Setter TargetName="SelectedChevron" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RowHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="RowHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsLaunching, FallbackValue=False}" Value="False" />
                                <Condition Binding="{Binding IsRunning, FallbackValue=False}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="RowSelectIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelChevronSlide" Storyboard.TargetProperty="X" From="-6" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RowSlide" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="RowSelectOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="RowSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <!-- RunningMarkRoom left="0" right="38" -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="SelectedLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,38,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SelectedChevron" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:1.55">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M1Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="0.65" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M2Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M3Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="0.65" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="SelectedLayer" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowRoom" Property="Padding" Value="0,0,38,0" />
                            <Setter TargetName="RowHoverRoom" Property="Padding" Value="0" />
                            <Setter TargetName="RowHoverPlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowHoverInstall" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SelectedChevron" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3.0">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.74" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.74" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M1Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1.05" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.65" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M2Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.75" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.05" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.75" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M3Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.68" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="1.05" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.68" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Light theme: unselected rows flip to WindowArtForegroundBrush over window art; plates keep dark ink -->
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                <Setter Property="Opacity" Value="0.74" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
