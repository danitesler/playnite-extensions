<!--
    Stride v2: DerivedStyles/TextBlockGameScore.xaml.
    Architectural glass tabular Consolas Bold score plaque: frosted ice-blue glass body with architectural
    carbon ink and a crisp 4px left-edge signal bar (Emerald positive, Signal Amber mixed, Crimson negative)
    matching Stride's glass dossier aesthetic.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TextBlockGameScore" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource MonospaceFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="10,2,8,2" />
        <Setter Property="Margin" Value="0,1,0,2" />
        <Setter Property="Background" Value="{DynamicResource LocalGlassButtonBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Positive}">
                <Setter Property="Background" Value="{DynamicResource LocalScorePositiveBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Mixed}">
                <Setter Property="Background" Value="{DynamicResource LocalScoreMixedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Negative}">
                <Setter Property="Background" Value="{DynamicResource LocalScoreNegativeBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.None}">
                <Setter Property="Background" Value="{DynamicResource LocalGlassButtonBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
