<!--
    Stride: DerivedStyles/GridViewItemStyle.xaml.
    Architectural cover tile container with smooth hover & click/selection animations:
    - Hover: crisp 1.5px Architectural Carbon Ink frame + 4 Swiss CornerMarksTemplate registration ticks + subtle
      1.015 lift (120ms CubicEase).
    - Selection: razor-sharp 2.5px Runner Vision crimson perimeter frame + top-left diagonal crimson shard notch
      wiping in cleanly (140ms CubicEase).
    - RunningIndicator (Margin="4" inset inside selection frame): Rooftop Sky Cerulean border, angled velocity
      sweep, and an 18px bottom sky tape carrying the 2px RunningFill bar + 3 staggered pure-white momentum bars.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="TileRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <ContentPresenter />

                        <!-- Hover frame: Architectural Carbon Ink rim + 4 Swiss corner registration ticks -->
                        <Grid x:Name="HoverOverlay" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border BorderBrush="{DynamicResource GridViewItemHoverBorderBrush}" BorderThickness="1.5" />
                            <Control Margin="4" Template="{DynamicResource CornerMarksTemplate}"
                                     Foreground="{DynamicResource GridViewItemHoverBorderBrush}"
                                     Focusable="False" IsTabStop="False" />
                        </Grid>

                        <!-- Selected frame: Runner Vision crimson 2.5px rim + top-left diagonal crimson shard notch -->
                        <Grid x:Name="SelectedOverlay" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border BorderBrush="{DynamicResource GridViewItemSelectedBorderBrush}" BorderThickness="2.5" />
                            <Polygon x:Name="SelShard" Points="0,0 26,0 18,12 0,12"
                                     Fill="{DynamicResource GridViewItemSelectedBorderBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
                                <Polygon.RenderTransform>
                                    <ScaleTransform x:Name="SelShardScale" ScaleX="0.2" ScaleY="1" />
                                </Polygon.RenderTransform>
                            </Polygon>
                        </Grid>

                        <!-- Running / Launching Indicator (inset Margin="4" so selection rim stays visible outside it) -->
                        <Grid x:Name="RunningIndicator" Margin="4" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
                            <Border x:Name="RunningWash" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.18" />

                            <Border x:Name="RunningScan" Visibility="Collapsed" Background="{DynamicResource RunningIndicatorBrush}" Opacity="0.32">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                                        <GradientStop x:Name="RunningScanTail" Color="#00000000" Offset="-0.4" />
                                        <GradientStop x:Name="RunningScanHead" Color="#FF000000" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="#00000000" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>

                            <Border x:Name="RunningFrame" BorderBrush="{DynamicResource RunningIndicatorBrush}" BorderThickness="2" />

                            <!-- 18px bottom Rooftop Sky velocity tape holding foot line + 3 skewed momentum bars -->
                            <Grid Height="18" VerticalAlignment="Bottom" Background="{DynamicResource RunningIndicatorBrush}">
                                <Border Background="{DynamicResource ScrimBrush}" Opacity="0.24" />
                                <Grid Height="2" VerticalAlignment="Bottom" Margin="4,0,4,3">
                                    <Rectangle Fill="{DynamicResource PrimaryButtonForegroundBrush}" Opacity="0.30" />
                                    <Rectangle x:Name="RunningFill" Fill="{DynamicResource PrimaryButtonForegroundBrush}" RenderTransformOrigin="0,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="RunningFillScale" ScaleX="0" ScaleY="1" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,2">
                                    <Polygon x:Name="M1" Points="1.5,0 4,0 2.5,7 0,7" Fill="{DynamicResource PrimaryButtonForegroundBrush}"
                                             VerticalAlignment="Bottom" Opacity="0.65" Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                                        <Polygon.RenderTransform><ScaleTransform x:Name="M1Scale" ScaleY="0.7" /></Polygon.RenderTransform>
                                    </Polygon>
                                    <Polygon x:Name="M2" Points="1.5,0 4,0 2.5,10 0,10" Fill="{DynamicResource PrimaryButtonForegroundBrush}"
                                             VerticalAlignment="Bottom" Opacity="0.90" Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                                        <Polygon.RenderTransform><ScaleTransform x:Name="M2Scale" ScaleY="0.85" /></Polygon.RenderTransform>
                                    </Polygon>
                                    <Polygon x:Name="M3" Points="1.5,0 4,0 2.5,8 0,8" Fill="{DynamicResource PrimaryButtonForegroundBrush}"
                                             VerticalAlignment="Bottom" Opacity="1.0" RenderTransformOrigin="0.5,1">
                                        <Polygon.RenderTransform><ScaleTransform x:Name="M3Scale" ScaleY="0.75" /></Polygon.RenderTransform>
                                    </Polygon>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CoverHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CoverHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CoverSelIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="SelShardScale" Storyboard.TargetProperty="ScaleX" From="0.2" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="CoverSelOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectedOverlay" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:1.55">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.0" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.10" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.55" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M1Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="1.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.25" Value="0.65" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M2Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="1.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.35" Value="0.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M3Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.95" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.15" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.45" Value="0.65" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:3.0">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.74" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.74" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M1Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.0" Value="1.05" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.65" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M2Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0.75" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.05" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.75" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="M3Scale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0.68" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.1" Value="1.05" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.0" Value="0.68" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
