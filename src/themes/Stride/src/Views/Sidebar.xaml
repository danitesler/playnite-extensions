<!--
    Stride v2: Views/Sidebar.xaml.
    Iconic Mirror's Edge 2008 STORY menu full-height 44px Blazing Red Vertical Glass Pillar
    (LocalRedPillarBrush + micro-grid.png + glass-sheen.png + soft right-edge inset shadow).
    Crowned by the pure-white Kinetic Shard Chevron brand tile and anchored at the foot by a chunky '+' mark.
    Turns transparent with WindowArtForegroundBrush when ShowBackgroundImageOnWindow=True.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Border x:Name="BorderContentHolder" Background="{DynamicResource LocalRedPillarBrush}" Margin="{TemplateBinding Padding}">
                        <Grid>
                            <!-- Architectural glass micro-grid + window sheen over the red pillar -->
                            <Control x:Name="PillarGrid" Template="{DynamicResource LocalMicroGridTemplate}"
                                     Foreground="{DynamicResource LocalWhiteBrush}" Opacity="0.14" IsHitTestVisible="False" />
                            <Control x:Name="PillarSheen" Template="{DynamicResource LocalGlassSheenTemplate}"
                                     Foreground="{DynamicResource LocalWhiteBrush}" Opacity="0.18" IsHitTestVisible="False" />
                            <!-- Right edge crimson depth inner shadow -->
                            <Rectangle x:Name="PillarRightShadow" Width="8" HorizontalAlignment="Right"
                                       Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0.45"
                                       IsHitTestVisible="False">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>

                            <DockPanel x:Name="DockContentHolder">
                                <!-- Main Menu Tile: 44x48 crimson glass tile with pure-white Kinetic Shard Chevron -->
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="44" Height="48" Margin="0,0,0,6"
                                        DockPanel.Dock="Top" Padding="0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Grid>
                                        <Border x:Name="MenuHoverFill" Background="{DynamicResource LocalWhiteBrush}"
                                                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" />
                                        <Control x:Name="MenuMark" Width="22" Height="22"
                                                 Template="{DynamicResource BrandMarkTemplate}"
                                                 Foreground="{DynamicResource LocalWhiteBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsHitTestVisible="False" />
                                        <Border x:Name="MenuDivider" Height="1" VerticalAlignment="Bottom"
                                                Background="{DynamicResource LocalWhiteBrush}" Opacity="0.28"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </Border>

                                <!-- Chunky white Mirror's Edge '+' mark at the bottom of the red pillar -->
                                <Path x:Name="RailFootPlus" DockPanel.Dock="Bottom"
                                      Data="{DynamicResource LocalPlusMark}" Width="11" Height="11" Stretch="Uniform"
                                      Fill="{DynamicResource LocalWhiteBrush}" Opacity="0.65"
                                      HorizontalAlignment="Center" Margin="0,0,0,14" IsHitTestVisible="False" />

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>

                            <!-- FOLLOW THE RED glossy blurry random-weight wiggle edge + wide soft outward crimson bloom -->
                            <Rectangle x:Name="EdgeGlow" Width="22" HorizontalAlignment="Right" Margin="0,0,-22,0"
                                       IsHitTestVisible="False" Panel.ZIndex="10"
                                       Fill="{DynamicResource LocalCrimsonTopBrush}" Opacity="0.62">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#D8000000" Offset="0" />
                                        <GradientStop Color="#5A000000" Offset="0.28" />
                                        <GradientStop Color="#1C000000" Offset="0.62" />
                                        <GradientStop Color="#06000000" Offset="0.84" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle x:Name="EdgeRule" Width="10" HorizontalAlignment="Right" Margin="0,0,-4,0"
                                       IsHitTestVisible="False" Panel.ZIndex="11"
                                       Fill="{DynamicResource LocalWhiteBrush}" Opacity="0.92"
                                       OpacityMask="{DynamicResource LocalEdgeWiggleVMaskBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                            <Setter Property="Background" Value="Transparent" TargetName="BorderContentHolder" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PillarGrid" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PillarSheen" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PillarRightShadow" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeGlow" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootPlus" />
                            <Setter Property="Foreground" Value="{DynamicResource WindowArtForegroundBrush}" TargetName="MenuMark" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ElemMainMenu">
                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" TargetName="MenuMark" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MenuHoverIn">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Opacity" To="0.96" Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="MenuHoverOut">
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuHoverFill" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Padding" Value="0,25,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="EdgeRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeGlow" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="PillarRightShadow" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,136,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeGlow" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootPlus" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuDivider" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="0,0,4,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="Height" Value="44" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeRule" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="EdgeGlow" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="RailFootPlus" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="MenuDivider" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
