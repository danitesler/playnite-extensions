<!--
    Gilded Rift: RepeatButton. The compact plate used by number boxes and plugins (spin arrows, carousel steps): ButtonBackgroundBrush body,
    1px ButtonBorderBrush edge, top-left corner cut 3px (a 6px cut would eat a 14px high spin button). Hover lifts it to
    ButtonHoverBackgroundBrush with a FrameHoverBrush edge and ButtonHoverForegroundBrush glyph, pressed takes ButtonPressedBackgroundBrush.
    Slider and scroll bar parts use their own styles. State changes are instant: these buttons repeat while held, so a fade would lag.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Rectangle x:Name="BodyTop" Height="3" Margin="3,0,0,0" VerticalAlignment="Top" IsHitTestVisible="False" Fill="{TemplateBinding Background}" />
                        <Rectangle x:Name="BodyMain" Margin="0,3,0,0" IsHitTestVisible="False" Fill="{TemplateBinding Background}" />
                        <Path x:Name="BodyCut" Width="3" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Data="M3,0 L3,3 L0,3 Z" Fill="{TemplateBinding Background}" />
                        <Border x:Name="EdgeBottomRight" BorderThickness="0,0,1,1" IsHitTestVisible="False" BorderBrush="{TemplateBinding BorderBrush}" />
                        <Rectangle x:Name="EdgeTop" Height="1" Margin="3,0,0,0" VerticalAlignment="Top" IsHitTestVisible="False" Fill="{TemplateBinding BorderBrush}" />
                        <Rectangle x:Name="EdgeLeft" Width="1" Margin="0,3,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Fill="{TemplateBinding BorderBrush}" />
                        <Path x:Name="EdgeCut" Width="3" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Data="M0,3.5 L3.5,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BodyTop" Property="Fill" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Setter TargetName="BodyMain" Property="Fill" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Setter TargetName="BodyCut" Property="Fill" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Setter TargetName="EdgeBottomRight" Property="BorderBrush" Value="{DynamicResource FrameHoverBrush}" />
                            <Setter TargetName="EdgeTop" Property="Fill" Value="{DynamicResource FrameHoverBrush}" />
                            <Setter TargetName="EdgeLeft" Property="Fill" Value="{DynamicResource FrameHoverBrush}" />
                            <Setter TargetName="EdgeCut" Property="Stroke" Value="{DynamicResource FrameHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BodyTop" Property="Fill" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                            <Setter TargetName="BodyMain" Property="Fill" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                            <Setter TargetName="BodyCut" Property="Fill" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
