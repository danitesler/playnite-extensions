<!--
    Gilded Rift: GroupBox. A navy card (ExpanderBackgroundBrush, ControlCornerRadius, 1px FrameBrush gold-dim edge, GroupBoxPadding for the
    body) with a header row inside its top edge: a 6px gem (HeadingMarkerBrush), the title in HeadingFontFamily Bold 13px in
    HeadingForegroundBrush and a 1px rule (HeadingRuleBrush) that fades out to the right across the rest of the card.
    The template is content-sized (Statistics sections wrap as cards): nothing here has a fixed or stretched wide size, the
    header's rule is a Rectangle in a star column with no desired width. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource FrameBrush}" />
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource GroupBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="HeaderRow" Grid.Row="0" Margin="14,11,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="M3,0 L6,3 L3,6 L0,3 Z" Width="6" Height="6" Stretch="None" Margin="0,0,9,1"
                                      VerticalAlignment="Center" IsHitTestVisible="False" Fill="{DynamicResource HeadingMarkerBrush}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{DynamicResource HeadingFontFamily}"
                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource HeadingForegroundBrush}">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </TextBlock>
                                <Rectangle Grid.Column="2" Height="1" Margin="12,1,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Fill="{DynamicResource HeadingRuleBrush}">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="Black" />
                                            <GradientStop Offset="1" Color="Transparent" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                            <ContentPresenter Grid.Row="1" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- No header, no gem and rule. -->
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
