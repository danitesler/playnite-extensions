<!--
    Gilded Rift: CheckBox (HANDOFF Controls row). An 18px void well with the top-left corner cut 5px: CheckBoxCheckMarkBkBrush fill and a 1px
    CheckBoxBorderBrush edge drawn as one stroked path. Hover lifts the edge to CheckBoxHoverBorderBrush. Checked turns the edge GlyphBrush
    (HighlightGlyphBrush while hovered) and a 2.2px TextBrush tick draws in over 140 ms (a dash pattern longer than the tick whose offset
    runs to 0, so the tick appears from its start). Indeterminate is a static 2.2px dash. The label uses the body face. Focus is
    FocusVisual. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path x:Name="Box" Width="18" Height="18" StrokeThickness="1" StrokeLineJoin="Miter"
                                      Data="M5.5,0.5 L17.5,0.5 L17.5,17.5 L0.5,17.5 L0.5,5.5 Z"
                                      Stroke="{TemplateBinding BorderBrush}" Fill="{DynamicResource CheckBoxCheckMarkBkBrush}" />
                                <Path x:Name="Tick" Width="18" Height="18" IsHitTestVisible="False" StrokeThickness="2.2" StrokeLineJoin="Miter"
                                      StrokeDashArray="6.3 6.3" StrokeDashOffset="6.3" Data="M4.5,9.5 L7.5,12.5 L13.5,5.5"
                                      Stroke="{DynamicResource TextBrush}" />
                                <Path x:Name="Dash" Width="18" Height="18" IsHitTestVisible="False" StrokeThickness="2.2" Visibility="Collapsed"
                                      Data="M5,9 L13,9" Stroke="{DynamicResource TextBrush}" />
                            </Grid>
                            <ContentPresenter DockPanel.Dock="Left" RecognizesAccessKey="True" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource CheckBoxHoverBorderBrush}" TargetName="Box" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource GlyphBrush}" TargetName="Box" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="StrokeDashOffset" From="6.3" To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="StrokeDashOffset" To="6.3" Duration="0:0:0.08" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Stroke" Value="{DynamicResource HighlightGlyphBrush}" TargetName="Box" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}" />
                                <Condition Property="IsThreeState" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Stroke" Value="{DynamicResource GlyphBrush}" TargetName="Box" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Dash" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
