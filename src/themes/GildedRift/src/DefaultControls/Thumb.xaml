<!--
    Gilded Rift: the generic Thumb (scroll bars and sliders use their own ScrollBarThumb and SliderThumb styles). A slim dim gold bar:
    ThumbBrush fill, a 1px FrameInnerBrush rim, ThumbHoverBrush on hover, drag, or while the owning track has focus. Explicit radius of 3
    (the bar is thin, never CornerRadiusFull). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource ThumbBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <Rectangle x:Name="HoverRectangle" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" RadiusX="3" RadiusY="3"
                                   Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1" Margin="0" MinHeight="10"
                                   Fill="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource ThumbHoverBrush}" TargetName="HoverRectangle" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource ThumbHoverBrush}" TargetName="HoverRectangle" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Track}}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource ThumbHoverBrush}" TargetName="HoverRectangle" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
