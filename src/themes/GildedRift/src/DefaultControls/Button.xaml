<!--
    Gilded Rift: Button. The ready-check plate of the client (HANDOFF Controls row): a slate plate with the top-left corner cut 6px,
    a 1px dim gold edge (ButtonBackgroundBrush, ButtonBorderBrush), a 12px semibold label (FontSizeSmall) in ButtonForegroundBrush.
    Hover: the plate lifts to ButtonHoverBackgroundBrush and the edge to FrameHoverBrush as their own layers (fade in 120 ms, out 200 ms,
    CubicEase), the label turns ButtonHoverForegroundBrush. Pressed is a third layer (ButtonPressedBackgroundBrush). The cut is drawn as a
    rectangle pair and a triangle per layer (a stretching shape cannot keep a fixed corner), so the plate fits any size.
    The dialog default button (IsDefault) is the Play plate in small: PrimaryButtonBackgroundBrush void, PrimaryButtonBorderBrush edge,
    a pale gold bloom (PrimaryButtonGlowBrush) rising from its foot that swells on hover, PrimaryButtonHover/PressedBackgroundBrush layers.
    Focus is FocusVisual (keyboard only). Disabled is BaseStyle's opacity.
    Width 41 trigger: ThemeModifier's icon buttons (32x32 through LayoutTransform). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- The plate: body, top-left corner cut 6px. -->
                        <Rectangle Height="6" Margin="6,0,0,0" VerticalAlignment="Top" IsHitTestVisible="False" Fill="{TemplateBinding Background}" />
                        <Rectangle Margin="0,6,0,0" IsHitTestVisible="False" Fill="{TemplateBinding Background}" />
                        <Path Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Data="M6,0 L6,6 L0,6 Z" Fill="{TemplateBinding Background}" />
                        <!-- Hover body. -->
                        <Grid x:Name="HoverPlate" Opacity="0" IsHitTestVisible="False">
                            <Rectangle x:Name="HoverTop" Height="6" Margin="6,0,0,0" VerticalAlignment="Top" Fill="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Rectangle x:Name="HoverMain" Margin="0,6,0,0" Fill="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Path x:Name="HoverCut" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M6,0 L6,6 L0,6 Z" Fill="{DynamicResource ButtonHoverBackgroundBrush}" />
                        </Grid>
                        <!-- Pressed body. -->
                        <Grid x:Name="PressedPlate" Opacity="0" IsHitTestVisible="False">
                            <Rectangle x:Name="PressedTop" Height="6" Margin="6,0,0,0" VerticalAlignment="Top" Fill="{DynamicResource ButtonPressedBackgroundBrush}" />
                            <Rectangle x:Name="PressedMain" Margin="0,6,0,0" Fill="{DynamicResource ButtonPressedBackgroundBrush}" />
                            <Path x:Name="PressedCut" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M6,0 L6,6 L0,6 Z" Fill="{DynamicResource ButtonPressedBackgroundBrush}" />
                        </Grid>
                        <!-- Default button: pale gold bloom rising from the foot. The radial mask is clear in the cut corner. -->
                        <Rectangle x:Name="DefaultBloom" Margin="1" Visibility="Collapsed" Opacity="0.3" IsHitTestVisible="False" Fill="{DynamicResource PrimaryButtonGlowBrush}">
                            <Rectangle.OpacityMask>
                                <RadialGradientBrush Center="0.5,1.3" GradientOrigin="0.5,1.3" RadiusX="0.75" RadiusY="1.2">
                                    <GradientStop Color="Black" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <!-- The edge: 1px, right and bottom as one border, top and left stop at the cut, a diagonal across it. -->
                        <Border BorderThickness="0,0,1,1" IsHitTestVisible="False" BorderBrush="{TemplateBinding BorderBrush}" />
                        <Rectangle Height="1" Margin="6,0,0,0" VerticalAlignment="Top" IsHitTestVisible="False" Fill="{TemplateBinding BorderBrush}" />
                        <Rectangle Width="1" Margin="0,6,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Fill="{TemplateBinding BorderBrush}" />
                        <Path Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Data="M0,6.5 L6.5,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                        <!-- Hover edge. -->
                        <Grid x:Name="HoverEdge" Opacity="0" IsHitTestVisible="False">
                            <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource FrameHoverBrush}" />
                            <Rectangle Height="1" Margin="6,0,0,0" VerticalAlignment="Top" Fill="{DynamicResource FrameHoverBrush}" />
                            <Rectangle Width="1" Margin="0,6,0,0" HorizontalAlignment="Left" Fill="{DynamicResource FrameHoverBrush}" />
                            <Path Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,6.5 L6.5,0" Stroke="{DynamicResource FrameHoverBrush}" StrokeThickness="1" />
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="DefaultBloom" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HoverTop" Property="Fill" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="HoverMain" Property="Fill" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="HoverCut" Property="Fill" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
                            <Setter TargetName="PressedTop" Property="Fill" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                            <Setter TargetName="PressedMain" Property="Fill" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                            <Setter TargetName="PressedCut" Property="Fill" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="DefaultBloom" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="DefaultBloom" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Height" Value="NaN">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
            </Trigger>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                <Setter Property="MinWidth" Value="96" />
            </Trigger>
            <Trigger Property="Width" Value="41">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="41" />
                <Setter Property="MinWidth" Value="41" />
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MaxWidth" Value="41" />
                <Setter Property="MaxHeight" Value="41" />
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.7804878048780488" ScaleY="0.7804878048780488" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoadMoreButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
