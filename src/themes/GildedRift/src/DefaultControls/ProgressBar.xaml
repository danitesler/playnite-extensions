<!--
    Gilded Rift: ProgressBar (HANDOFF Controls row), the XP bar. An 8px track (ProgressBarTrackBrush, the control's Background) in a 1px
    FrameInnerBrush rim, radius 4; the fill is ProgressBarForegroundBrush (the control's Foreground, hextech teal: progress is live
    state), radius 3, inset by the rim, with a soft glow.png bloom at its leading end. PART_Track and PART_Indicator are kept: Playnite
    sizes the indicator and the fill sits inside it. Indeterminate hides the indicator and marches a row of 24px lit segments along the
    track (StrokeDashOffset, one 72px period per loop, removed when the state ends), because the bar's width is unknown to a storyboard.
    Radii are half the thickness (the thin-track rule). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="Root" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Background="Transparent">
                        <Grid MinHeight="8" Height="{TemplateBinding Height}" VerticalAlignment="Center">
                            <Border x:Name="PART_Track" CornerRadius="4" BorderThickness="1"
                                    Background="{TemplateBinding Background}" BorderBrush="{DynamicResource FrameInnerBrush}" />
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                <Grid Margin="1">
                                    <Border CornerRadius="3" Background="{TemplateBinding Foreground}" />
                                    <Rectangle x:Name="EndGlow" Width="18" HorizontalAlignment="Right" Margin="0,-5,-9,-5" IsHitTestVisible="False"
                                               Opacity="0.7" Fill="{TemplateBinding Foreground}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                            </Decorator>
                            <Canvas x:Name="Sweep" Height="6" Margin="1" VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="False" Visibility="Collapsed">
                                <Path x:Name="SweepSegments" Data="M-72,3 L3000,3" StrokeThickness="6" StrokeDashArray="4 8"
                                      Stroke="{TemplateBinding Foreground}" />
                            </Canvas>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Value" Value="0">
                            <Setter TargetName="EndGlow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SegmentSweepStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SweepSegments" Storyboard.TargetProperty="StrokeDashOffset"
                                                         From="0" To="-12" Duration="0:0:1.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="SegmentSweepStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
