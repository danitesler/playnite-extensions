<!--
    Gilded Rift: Expander. The header (ExpanderDownHeaderStyle, a ToggleButton) is a navy band (ExpanderBackgroundBrush) 30px tall
    holding an 8px gem (a diamond: an open ring while the section is closed, filled gold while it is open), the title in
    HeadingFontFamily Bold 13px and a 1px rule (HeadingRuleBrush) that fades out to the right and takes the rest of the width.
    Playnite's own group headers draw their text with an explicit TextBlock style in TextBrush (cream), which reads on the navy band.
    The body is the bare content, no fill, so grouped lists stay flat like the rest of the library.
    While Playnite draws the game art behind the window ({Settings ShowBackgroundImageOnWindow}) the band goes transparent,
    leaving gem, cream text and rule on the art (AGENTS.md Window background). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ExpanderDownHeaderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" Margin="{TemplateBinding Padding}" MinHeight="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="Gem" Grid.Column="0" Data="M4,0.5 L7.5,4 L4,7.5 L0.5,4 Z" Width="8" Height="8" Stretch="None"
                              Margin="12,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                              Fill="Transparent" Stroke="{DynamicResource HeadingMarkerBrush}" StrokeThickness="1" StrokeLineJoin="Miter" />
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,1" RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                        <Rectangle x:Name="Rule" Grid.Column="2" Height="1" Margin="14,1,12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Fill="{DynamicResource HeadingRuleBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="Black" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gem" Property="Stroke" Value="{DynamicResource HighlightGlyphBrush}" />
                            <Setter TargetName="Rule" Property="Fill" Value="{DynamicResource FrameHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Gem" Property="Fill" Value="{DynamicResource HeadingMarkerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Expander}">
        <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel>
                        <ToggleButton Panel.ZIndex="1" Style="{DynamicResource ExpanderDownHeaderStyle}"
                                      MinHeight="30" DockPanel.Dock="Top"
                                      Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding Header}"
                                      IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Border" DockPanel.Dock="Top" Visibility="Collapsed"
                                Background="Transparent" BorderThickness="0">
                            <ContentPresenter Focusable="False" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="true">
                            <Setter Property="Visibility" TargetName="Border" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Settings ShowBackgroundImageOnWindow}" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
