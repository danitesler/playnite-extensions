<!--
    Gilded Rift: Slider (AGENTS.md, Controls measurements). A 4px rail (SliderTrackBrush) in a 1px FrameInnerBrush rim, radius 2. The range left of the
    thumb is gold: SliderRangeButton draws FrameBrush with GlyphBrush fading in toward the thumb (SliderHoverForegroundBrush while the slider
    is hovered), 4px high, radius 2, drawn 12px past the button so it runs under the thumb to its centre. The thumb is a 14px square turned on its corner: a diamond in SliderThumbBackgroundBrush with a 1px void
    rim (ShellBackgroundBrush) and a 6px void centre; hover scales it to 1.15 (120 ms, CubicEase), turns the rim SliderThumbHoverBorderBrush
    and lights a soft halo (glow.png in GlyphBrush). The scale is a named transform animated from the template's own triggers. Track.Thumb is
    set last. The two MultiDataTriggers disable ThemeModifier's banner height and banner darkening sliders while Playnite draws the game art
    behind the window (AGENTS.md Window background). Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SliderTrackButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The lit range: dim gold with the bright gold coming up toward the thumb. -->
    <Style x:Key="SliderRangeButton" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource SliderTrackButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid Background="Transparent">
                        <Grid Height="4" Margin="1,0,-12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border CornerRadius="2" Background="{DynamicResource FrameBrush}" />
                            <Border x:Name="RangeLit" CornerRadius="2" Background="{DynamicResource GlyphBrush}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0" />
                                        <GradientStop Color="Black" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="True">
                            <Setter TargetName="RangeLit" Property="Background" Value="{DynamicResource SliderHoverForegroundBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="26" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Grow" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Rectangle x:Name="Halo" Margin="-8" Opacity="0" IsHitTestVisible="False"
                                   Fill="{DynamicResource GlyphBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Path x:Name="Gem" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="1" StrokeLineJoin="Miter"
                              Data="M10,0 L20,10 L10,20 L0,10 Z"
                              Fill="{DynamicResource SliderThumbBackgroundBrush}" Stroke="{DynamicResource ShellBackgroundBrush}" />
                        <Path Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                              Data="M10,5.8 L14.2,10 L10,14.2 L5.8,10 Z" Fill="{DynamicResource ShellBackgroundBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gem" Property="Stroke" Value="{DynamicResource SliderThumbHoverBorderBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Gem" Property="Stroke" Value="{DynamicResource SliderThumbHoverBorderBrush}" />
                            <Setter TargetName="Halo" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid x:Name="GridRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TickBar x:Name="TopTick" Visibility="Collapsed" Height="4" Placement="Top"
                                 SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Fill="{DynamicResource TextBrushDarker}" />
                        <Border x:Name="Rail" Grid.Row="1" Height="6" VerticalAlignment="Center" CornerRadius="2" BorderThickness="1" IsHitTestVisible="False"
                                Background="{DynamicResource SliderTrackBrush}" BorderBrush="{DynamicResource FrameInnerBrush}" />
                        <Track Grid.Row="1" x:Name="PART_Track" Height="{TemplateBinding Height}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="ButtonDecrease" Style="{StaticResource SliderRangeButton}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="ButtonIncrease" Style="{StaticResource SliderTrackButton}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                        <TickBar x:Name="BottomTick" Visibility="Collapsed" Grid.Row="2" Height="4" Placement="Bottom"
                                 SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Fill="{DynamicResource TextBrushDarker}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_Track" Property="FocusManager.FocusedElement" Value="{Binding ElementName=PART_Track}" />
                        </Trigger>
                        <Trigger Property="TickPlacement" Value="TopLeft">
                            <Setter Property="Visibility" Value="Visible" TargetName="TopTick" />
                        </Trigger>
                        <Trigger Property="TickPlacement" Value="BottomRight">
                            <Setter Property="Visibility" Value="Visible" TargetName="BottomTick" />
                        </Trigger>
                        <Trigger Property="TickPlacement" Value="Both">
                            <Setter Property="Visibility" Value="Visible" TargetName="TopTick" />
                            <Setter Property="Visibility" Value="Visible" TargetName="BottomTick" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="LayoutTransform" TargetName="GridRoot">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- ThemeModifier's banner height and banner darkening sliders (each row label is the Grid's first child, Tag = the key) are off while
             Playnite draws the game art behind the whole window: the game pages collapse the banner then (AGENTS.md Window background). -->
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerHeight" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Children[0].Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="GameBannerDarken" />
                    <Condition Binding="{Settings ShowBackgroundImageOnWindow}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.4" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
