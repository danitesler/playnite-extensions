<!--
    Gilded Rift: ToggleButton. The same cut plate as Button (top-left corner cut 6px, 1px ButtonBorderBrush edge, ButtonBackgroundBrush body,
    12px semibold label) with its own hover layers (ButtonHoverBackgroundBrush body, FrameHoverBrush edge). Checked is the lit state of the
    toolbar cells: the bronze plate (ToggleButtonCheckedBackgroundBrush) fades in, the edge turns GlyphBrush, the label SelectedForegroundBrush
    and a 2px gold underline (GlyphBrush, inset 8px) draws in under it. Checked and hovered keeps the lit edge. Focus is FocusVisual.
    Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- Plate body. -->
                        <Rectangle Height="6" Margin="6,0,0,0" VerticalAlignment="Top" IsHitTestVisible="False" Fill="{TemplateBinding Background}" />
                        <Rectangle Margin="0,6,0,0" IsHitTestVisible="False" Fill="{TemplateBinding Background}" />
                        <Path Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Data="M6,0 L6,6 L0,6 Z" Fill="{TemplateBinding Background}" />
                        <!-- Hover body. -->
                        <Grid x:Name="HoverPlate" Opacity="0" IsHitTestVisible="False">
                            <Rectangle Height="6" Margin="6,0,0,0" VerticalAlignment="Top" Fill="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Rectangle Margin="0,6,0,0" Fill="{DynamicResource ButtonHoverBackgroundBrush}" />
                            <Path Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M6,0 L6,6 L0,6 Z" Fill="{DynamicResource ButtonHoverBackgroundBrush}" />
                        </Grid>
                        <!-- Checked body: the bronze plate. -->
                        <Grid x:Name="CheckedPlate" Opacity="0" IsHitTestVisible="False">
                            <Rectangle Height="6" Margin="6,0,0,0" VerticalAlignment="Top" Fill="{DynamicResource ToggleButtonCheckedBackgroundBrush}" />
                            <Rectangle Margin="0,6,0,0" Fill="{DynamicResource ToggleButtonCheckedBackgroundBrush}" />
                            <Path Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M6,0 L6,6 L0,6 Z" Fill="{DynamicResource ToggleButtonCheckedBackgroundBrush}" />
                        </Grid>
                        <!-- The edge. -->
                        <Border BorderThickness="0,0,1,1" IsHitTestVisible="False" BorderBrush="{TemplateBinding BorderBrush}" />
                        <Rectangle Height="1" Margin="6,0,0,0" VerticalAlignment="Top" IsHitTestVisible="False" Fill="{TemplateBinding BorderBrush}" />
                        <Rectangle Width="1" Margin="0,6,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Fill="{TemplateBinding BorderBrush}" />
                        <Path Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Data="M0,6.5 L6.5,0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                        <!-- Hover edge. -->
                        <Grid x:Name="HoverEdge" Opacity="0" IsHitTestVisible="False">
                            <Border BorderThickness="0,0,1,1" BorderBrush="{DynamicResource FrameHoverBrush}" />
                            <Rectangle Height="1" Margin="6,0,0,0" VerticalAlignment="Top" Fill="{DynamicResource FrameHoverBrush}" />
                            <Rectangle Width="1" Margin="0,6,0,0" HorizontalAlignment="Left" Fill="{DynamicResource FrameHoverBrush}" />
                            <Path Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,6.5 L6.5,0" Stroke="{DynamicResource FrameHoverBrush}" StrokeThickness="1" />
                        </Grid>
                        <Rectangle x:Name="CheckedLine" Height="2" Margin="8,0,8,2" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False" Fill="{DynamicResource GlyphBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="HoverEdge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckedPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CheckedLine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="CheckedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CheckedLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
