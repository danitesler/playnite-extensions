<!--
    Gilded Rift: the icon set. Thin angular glyphs on a 24 grid, drawn after the previews (art/preview-details.html, the symbols
    block): 1.6 unit stroke, square caps, miter joins, no fill, so a 16px glyph reads as a hairline gold line. The geometries
    are centre lines: IconTemplate strokes them in the control's Foreground and does not fill. A closed square a unit or two wide
    stands for a dot (square caps would make a zero length segment a speck).
    EmptyGameIcon is the brand mark (art/mark.svg, a 64 unit square, filled), for hosts that fill a Path with it.
    Playnite's menu icons keep their icofont glyphs; only their hardcoded colors move onto theme brushes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Geometry x:Key="IconSearch">M16.5,10.5 A6,6 0 1 1 4.5,10.5 A6,6 0 1 1 16.5,10.5 M15,15 L20.5,20.5</Geometry>
    <Geometry x:Key="IconClear">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="IconViewSettings">M4,7 H12.5 M17.5,7 H20 M4,17 H6.5 M11.5,17 H20 M15,4.5 L17.5,7 L15,9.5 L12.5,7 Z M9,14.5 L11.5,17 L9,19.5 L6.5,17 Z</Geometry>
    <Geometry x:Key="IconFilterPresets">M7,4 H17 V20 L12,16 L7,20 Z</Geometry>
    <Geometry x:Key="IconGroup">M12,3.5 L21,8.5 L12,13.5 L3,8.5 Z M3,13 L12,18 L21,13</Geometry>
    <Geometry x:Key="IconSort">M4,6 H20 M4,12 H15 M4,18 H10</Geometry>
    <Geometry x:Key="IconDetailsView">M4,5 H20 V11 H4 Z M4,14 H20 V19 H4 Z</Geometry>
    <Geometry x:Key="IconGridView">M4,4 H11 V11 H4 Z M13,4 H20 V11 H13 Z M4,13 H11 V20 H4 Z M13,13 H20 V20 H13 Z</Geometry>
    <Geometry x:Key="IconListView">M4,6 H6 M9,6 H20 M4,12 H6 M9,12 H20 M4,18 H6 M9,18 H20</Geometry>
    <Geometry x:Key="IconUpdate">M12,2.5 L21.5,12 L12,21.5 L2.5,12 Z M12,16 V8.5 M8.5,12 L12,8.5 L15.5,12</Geometry>
    <Geometry x:Key="IconExplorer">M20.5,12 A8.5,8.5 0 1 1 3.5,12 A8.5,8.5 0 1 1 20.5,12 M15.5,8.5 L13,13 L8.5,15.5 L11,11 Z</Geometry>
    <Geometry x:Key="IconRandom">M5,4 H19 V20 H5 Z M8.5,8.5 H9.5 V9.5 H8.5 Z M11.5,11.5 H12.5 V12.5 H11.5 Z M14.5,14.5 H15.5 V15.5 H14.5 Z</Geometry>
    <Geometry x:Key="IconViewRandom">M4,7 H8 L16,17 H20 M17,14 L20,17 L17,20 M4,17 H8 L10.5,13.8 M13.5,10.2 L16,7 H20 M17,4 L20,7 L17,10</Geometry>
    <Geometry x:Key="IconFilter">M4,5 H20 L14,12.5 V19 L10,20.5 V12.5 Z</Geometry>
    <Geometry x:Key="IconNotifications">M6,17 V11 A6,6 0 0 1 18,11 V17 L20,19 H4 Z M10,21.5 H14</Geometry>
    <Geometry x:Key="IconMainMenu">M4,7 H20 M4,12 H20 M4,17 H20</Geometry>
    <Geometry x:Key="IconLibrary">M4,4 H8 V20 H4 Z M10,4 H14 V20 H10 Z M16.5,5 L20,5.9 L16.5,20.1 L13,19.2 Z</Geometry>
    <Geometry x:Key="IconStatistics">M5,20 V13 M11,20 V5 M17,20 V10 M3,21 H21</Geometry>
    <Geometry x:Key="IconWindowMinimize">M6,17 H18</Geometry>
    <Geometry x:Key="IconWindowMaximize">M6,6 H18 V18 H6 Z</Geometry>
    <Geometry x:Key="IconWindowRestore">M5,9 H15 V19 H5 Z M9,9 V5 H19 V15 H15</Geometry>
    <Geometry x:Key="IconWindowClose">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="IconDropDown">M5,9 L12,16 L19,9</Geometry>
    <Geometry x:Key="IconSubmenu">M9,5 L16,12 L9,19</Geometry>
    <Geometry x:Key="IconCheck">M4,12.5 L9,17.5 L20,6.5</Geometry>
    <Geometry x:Key="IconAdd">M12,4 V20 M4,12 H20</Geometry>
    <Geometry x:Key="IconEdit">M4,20 L5,15 L16,4 L20,8 L9,19 Z M14,6 L18,10</Geometry>
    <Geometry x:Key="IconRemove">M5,12 H19</Geometry>
    <!-- Options: three small solid squares (a 1.8 unit square plus the 1.6 stroke is a 3.4 unit dot, as in the preview). -->
    <Geometry x:Key="IconOptions">M4.1,11.1 H5.9 V12.9 H4.1 Z M11.1,11.1 H12.9 V12.9 H11.1 Z M18.1,11.1 H19.9 V12.9 H18.1 Z</Geometry>
    <Geometry x:Key="IconPlay">M7,4.5 L19,12 L7,19.5 Z</Geometry>
    <Geometry x:Key="IconInfo">M12,3 L21,12 L12,21 L3,12 Z M12,11 V16.5 M11.4,7.4 H12.6 V8.6 H11.4 Z</Geometry>
    <Geometry x:Key="IconDownload">M12,3.5 V15 M7,10.5 L12,15.5 L17,10.5 M4,20.5 H20</Geometry>

    <!-- The brand mark, art/mark.svg on its 64 unit square: centre stone, three feathers each side, base chevron. Fill it. -->
    <Geometry x:Key="EmptyGameIcon">M31,7 L23,20 L31,50 Z M33,7 L41,20 L33,50 Z M22,23 L2,14 L9,25 Z M22,28 L4,26 L11,34 Z M23,33 L8,38 L15,44 Z M42,23 L62,14 L55,25 Z M42,28 L60,26 L53,34 Z M41,33 L56,38 L49,44 Z M32,54 L36.5,57.5 L32,61 L27.5,57.5 Z</Geometry>

    <DataTemplate x:Key="IconTemplate">
        <Viewbox Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                      StrokeThickness="1.6" StrokeStartLineCap="Square" StrokeEndLineCap="Square" StrokeLineJoin="Miter" />
            </Canvas>
        </Viewbox>
    </DataTemplate>
    <DataTemplate x:Key="IconSmallTemplate">
        <Viewbox Width="12" Height="12">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                      StrokeThickness="2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" StrokeLineJoin="Miter" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <ContentPresenter Width="14" Height="14" Content="{DynamicResource IconClear}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>
    <DataTemplate x:Key="SearchTextIconTemplate">
        <ContentPresenter Width="16" Height="16" Content="{DynamicResource IconSearch}" ContentTemplate="{DynamicResource IconTemplate}" />
    </DataTemplate>

    <!-- Playnite menu icons with hardcoded colors in Default: red moves onto the loss red, yellow onto the warning gold. -->
    <TextBlock x:Key="ExitIcon" Text="&#xef1d;" FontFamily="{DynamicResource FontIcoFont}" Foreground="{DynamicResource DangerBrush}" FontWeight="Light"/>
    <TextBlock x:Key="RemoveGameIcon" Text="&#xec53;" FontFamily="{DynamicResource FontIcoFont}" Foreground="{DynamicResource DangerBrush}" FontWeight="Light"/>
    <TextBlock x:Key="AddFavoritesIcon" Text="&#xef25;" FontFamily="{DynamicResource FontIcoFont}" Foreground="{DynamicResource MixedRatingBrush}" FontWeight="Light"/>
</ResourceDictionary>
