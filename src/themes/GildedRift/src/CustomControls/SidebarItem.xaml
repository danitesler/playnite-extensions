<!--
    Gilded Rift: SidebarItem. A 44x40 cell with a 16px stroke glyph. Idle glyphs are SidebarItemForegroundBrush; hover lays a
    ListItemHoverBrush plate under the glyph and lifts it to HighlightGlyphBrush. Current item: the glyph in
    SidebarItemSelectedForegroundBrush, a gold wash (SidebarItemSelectedGlowBrush at 16%, brightest at the right edge and
    clear by 85% leftwards), a 7x12 gold triangle notch on the rail's right edge pointing left (2px in from the edge,
    14px from the top) and a 1px hairline along the bottom that fades in from the right. The notch slides in from the
    edge and the wash fades in over 160ms (CubicEase EaseOut). Fixed 14,12 padding sizes the glyph to 16x16; IconPadding is
    not added on top (it would collapse the Viewbox, src/themes/AGENTS.md Sidebar Icon Sizing). Library and Statistics
    use the theme's own glyphs. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type SidebarItem}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarItemForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SidebarItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="Plate" Width="32" Height="32" SnapsToDevicePixels="True" Background="{TemplateBinding Background}" />
                        <!-- Hover: a slate plate across the cell. -->
                        <Rectangle x:Name="HoverPlate" Fill="{DynamicResource ListItemHoverBrush}" Opacity="0" IsHitTestVisible="False" />
                        <!-- Current: wash, bottom hairline and the notch on the rail edge. -->
                        <Grid x:Name="Marks" Visibility="Collapsed" IsHitTestVisible="False">
                            <Rectangle Fill="{DynamicResource SidebarItemSelectedGlowBrush}" Opacity="0.16">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Offset="0" Color="Black" />
                                        <GradientStop Offset="0.85" Color="Transparent" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Rectangle Height="1" VerticalAlignment="Bottom" Margin="0,0,3,0" Fill="{DynamicResource FrameBrush}">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="Transparent" />
                                        <GradientStop Offset="1" Color="Black" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Path x:Name="Notch" Data="M7,0 L7,12 L0,6 Z" Width="7" Height="12" Stretch="None"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,2,0"
                                  Fill="{DynamicResource GlyphBrush}" SnapsToDevicePixels="True">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="NotchShift" X="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <Border x:Name="GlyphHost" Padding="14,12">
                            <Viewbox x:Name="ItemIcon">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Viewbox>
                        </Border>
                        <ContentControl x:Name="SetIcon" Visibility="Collapsed" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                        Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ContentTemplate="{DynamicResource IconTemplate}" />
                        <ProgressBar x:Name="PART_ProgressStatus" Height="2" Margin="10,0,10,2" BorderThickness="0" Background="Transparent"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Visibility" Value="Hidden" TargetName="HoverPlate" />
                            <Setter Property="Visibility" Value="Visible" TargetName="Marks" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NotchShift" Storyboard.TargetProperty="X" From="8" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Marks" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarLibraryIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconLibrary}" TargetName="SetIcon" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SideItem.Icon}" Value="SidebarStatisticsIcon">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="ItemIcon" />
                            <Setter Property="Visibility" Value="Visible" TargetName="SetIcon" />
                            <Setter Property="Content" Value="{DynamicResource IconStatistics}" TargetName="SetIcon" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Content" Value="{x:Null}" />
                    <Condition Property="ContentTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
