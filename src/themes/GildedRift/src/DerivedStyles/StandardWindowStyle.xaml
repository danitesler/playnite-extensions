<!--
    Gilded Rift: dialog windows (Settings, game editor, add-ons). A 40px title band (CaptionHeight 40 = the content offset): the
    void WindowTitleBackgroundBrush fading down into ContentBackgroundBrush, closed by a 1px gold rule (FrameInnerBrush at the ends,
    FrameHoverBrush at 22 and 78 percent, FrameBrush in the centre; stacked masked rectangles, since brushes cannot be gradient
    stops). Left: a 26px diamond-ring crest (a FrameBrush diamond with a void diamond inside) holding the winged gem
    (BrandMarkTemplate), then the title in the heading face (Cinzel Bold, FontSize key; WPF has no letter-spacing, so the preview's
    3px tracking is not drawn). Centre: WingsTemplate, three tapering feathers fanning out of a centre diamond, 360px wide in a Canvas
    (no desired width, so small dialogs still size to their content), centred with MathConverter and hidden under 600px of window width
    so it never meets the title or the caption buttons. Right: 46x40 caption buttons flush in
    the corner, close hovering on DangerBrush. The window is framed by a 1px FrameBrush line with a FrameInnerBrush hairline inside it
    and sits on the raised navy NormalBrushDark (the recessed tree column and the bottom bar are darker). The Settings window has no
    Title, so a trigger names it. PART_TextTitle keeps the real title inside a Collapsed parent (Playnite makes it visible again once a
    window has a Title and unstyled it draws bare text at the band's top-left). Colors: WindowTitleBackgroundBrush,
    WindowTitleForegroundBrush, MainMenuButtonBackgroundBrush, MainMenuButtonForegroundBrush, GlyphBrush, FrameBrush, FrameInnerBrush,
    FrameHoverBrush. Structure: Playnite Default 10.60.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="WindowDesignStyle" TargetType="WindowBase">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>
    <Style x:Key="StandardWindowStyle" TargetType="WindowBase">
        <Setter Property="Background" Value="{DynamicResource NormalBrushDark}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40" CornerRadius="0" ResizeBorderThickness="4"
                              NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type WindowBase}">
                    <ControlTemplate.Resources>
                        <sys:Boolean x:Key="True">True</sys:Boolean>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border x:Name="WindowBorder" BorderBrush="{DynamicResource FrameBrush}" CornerRadius="0"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Border BorderBrush="{DynamicResource FrameInnerBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid Height="40" VerticalAlignment="Top" ClipToBounds="True">
                                        <!-- The band ground: void at the top, fading into the abyss. -->
                                        <Border Background="{DynamicResource WindowTitleBackgroundBrush}" />
                                        <Border Background="{DynamicResource ContentBackgroundBrush}" IsHitTestVisible="False">
                                            <Border.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="Transparent" />
                                                    <GradientStop Offset="1" Color="Black" />
                                                </LinearGradientBrush>
                                            </Border.OpacityMask>
                                        </Border>
                                        <!-- The closing rule: dark at the ends, lit at 22 and 78 percent, dim in the centre. -->
                                        <Grid Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                            <Rectangle Fill="{DynamicResource FrameInnerBrush}" />
                                            <Rectangle Fill="{DynamicResource FrameBrush}">
                                                <Rectangle.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="Transparent" />
                                                        <GradientStop Offset="0.35" Color="Black" />
                                                        <GradientStop Offset="0.65" Color="Black" />
                                                        <GradientStop Offset="1" Color="Transparent" />
                                                    </LinearGradientBrush>
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                            <Rectangle Fill="{DynamicResource FrameHoverBrush}">
                                                <Rectangle.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="Transparent" />
                                                        <GradientStop Offset="0.22" Color="Black" />
                                                        <GradientStop Offset="0.45" Color="Transparent" />
                                                        <GradientStop Offset="0.55" Color="Transparent" />
                                                        <GradientStop Offset="0.78" Color="Black" />
                                                        <GradientStop Offset="1" Color="Transparent" />
                                                    </LinearGradientBrush>
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Grid>
                                        <!-- The signature graphic: the wings, 360px wide and centred. A Canvas has no desired size, so a small dialog still sizes to its
                                             content (WingsTemplate alone asks for about 240px). Under 600px of window width the wings step aside for the title and
                                             the caption buttons. -->
                                        <Canvas Height="40" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                                            <Control Template="{DynamicResource WingsTemplate}" Foreground="{DynamicResource GlyphBrush}" BorderBrush="{DynamicResource FrameBrush}"
                                                     Width="360" Height="40" Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                                     Canvas.Left="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}, Converter={StaticResource MathConverter}, ConverterParameter='(x - 360) / 2'}"
                                                     Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 600 ? `Collapsed` : `Visible`'}" />
                                        </Canvas>
                                        <!-- The crest: a diamond ring holding the winged gem. -->
                                        <Grid Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                                            <Path Data="M13,0 L26,13 L13,26 L0,13 Z" Fill="{DynamicResource FrameBrush}" />
                                            <Path Data="M13,1.4 L24.6,13 L13,24.6 L1.4,13 Z" Fill="{DynamicResource MainMenuButtonBackgroundBrush}" />
                                            <Control Template="{DynamicResource BrandMarkTemplate}" Foreground="{DynamicResource MainMenuButtonForegroundBrush}" Width="20" Height="20"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
                                        </Grid>
                                        <!-- PART_TextTitle keeps the real title (Playnite and the Settings trigger set it); the band shows a copy in the heading face.
                                             Playnite makes this element visible once a window has a Title, and unstyled it draws bare text over the band's
                                             top-left corner. So it lives in a Collapsed parent (a collapsed parent hides it whatever its own Visibility)
                                             and is also zero-sized and transparent. -->
                                        <Border Visibility="Collapsed" IsHitTestVisible="False">
                                            <TextBlock Text="{TemplateBinding Title}" x:Name="PART_TextTitle" Width="0" Height="0" Opacity="0" Foreground="Transparent" />
                                        </Border>
                                        <TextBlock Text="{Binding Text, ElementName=PART_TextTitle}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Margin="50,0,150,0" IsHitTestVisible="False"
                                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="{DynamicResource FontSize}" FontWeight="Bold"
                                                   Foreground="{DynamicResource WindowTitleForegroundBrush}"
                                                   Style="{DynamicResource BaseTextBlockStyle}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0">
                                            <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" />
                                            <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- Drawn after the title band: a dialog whose content is taller than its window (progress, loading) stays visible over the band instead of hidden under it. -->
                                    <ContentPresenter Margin="0,40,0,0" />
                                </Grid>
                            </Border>
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.AutomationId" Value="WindowSettings">
                            <Setter TargetName="PART_TextTitle" Property="Text" Value="{DynamicResource LOCSettingsLabel}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize" />
                            <Setter Property="Padding" Value="8" TargetName="WindowBorder" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasChildWindow, Mode=OneWay, RelativeSource={RelativeSource Self}, TargetNullValue=False}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" TargetName="WindowBorder" />
                            <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
