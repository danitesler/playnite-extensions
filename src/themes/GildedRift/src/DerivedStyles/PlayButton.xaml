<!--
    Gilded Rift: Play, the winged plate. Structure: Playnite Default 10.60 (PlayButton); every Default state is kept.
    Brushes: PrimaryButtonBackgroundBrush (the void plate), PrimaryButtonBorderBrush (the gold bevel outline),
    PrimaryButtonForegroundBrush (label), PrimaryButtonHoverBackgroundBrush (the lit gold-dark fill), PrimaryButtonPressedBackgroundBrush
    (gold-dim), PrimaryButtonGlowBrush (bloom and shine), BevelLightBrush (hovered outline), GlyphBrush and FrameBrush (wings and the
    pressed label), FrameInnerBrush (inner hairline), ScrimBrush, RunningIndicatorBrush.
    Rest: a 196x46 void plate with all four corners cut 10px, a 1.5px gold outline, a FrameInnerBrush hairline inset 4px with
    8px cuts, two feather wings that overhang 16px each side of the plate (an outer feather in GlyphBrush with a small chevron
    notch on the edge, an inner feather in FrameBrush; the right one is the left mirrored), the play triangle and the label in
    Cinzel Bold 17px (it draws lowercase as small capitals). The wings sit outside the button's bounds: the cell keeps 16px margins.
    Hover, 0.2s in and 0.32s out, fades only: the fill goes to PrimaryButtonHoverBackgroundBrush, a pale-gold bloom rises from the
    plate's foot (glow.png as the mask of two brush-filled rectangles, a wide gold one and a pale core), the outline turns BevelLightBrush,
    and one skewed shine band with a spark.png glint at its head sweeps left to right once (a named TranslateTransform).
    Press, its own layer: a PrimaryButtonPressedBackgroundBrush plate fades over the bloom (the bloom drops to gold-dim), the face sinks
    1px and the label crossfades to GlyphBrush. Leaving mid-press cannot strand the hover state.
    Running and launching (Playnite swaps Play for the context action, Tag ContextAction): the plate keeps its shape, takes the running
    colour as fill and outline, and a ScrimBrush copy of the plate (RunningBreath) darkens it so the opaque label holds contrast
    (cream on the darkened plate: launching 0.55 steady, about 6:1; running breathes 0.46 to 0.58, 4.7:1 at the lightest frame; the sweep
    band is capped at 0.4). Launching: a band sweeps the plate (RunningScan, a travelling gradient mask). Running: the scrim breathes on a
    3.2s cycle. The RUNNING label shows Cancel only while the button itself is hovered (RelativeSource Self, never TemplatedParent) and
    the hover layers stay off while it runs. PlayRoom and CancelLabel reserve 36px on the right for the overlay's gem while it runs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        RunningActionIndicator: laid over the Play / context action cell on both game pages (Playnite shows RUNNING or LAUNCHING
        there). The rift gem: a hextech frame in the plate's own cut shape, a faint wash, a 2px foot line (it fills while launching,
        full while running) and a diamond-ring gem (an 18px ring around a solid diamond) in a 36px strip at the plate's right end.
        Launching: as the band lands the ring pings outward and the core flares (1.6s loop with a short rest). Running: the same ping
        fires once per 3.2s cycle and the core breathes. The plate itself (PlayButton) carries the sweep and the scrim; this overlay
        sits above the label, so its wash is 0.12. DataContext is Playnite's GameDetailsViewModel (IsRunning, IsLaunching).
    -->
    <Style x:Key="RunningActionIndicator" TargetType="{x:Type Control}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid x:Name="RunningIndicator" Visibility="Collapsed" Opacity="0.85" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Path x:Name="RunningWash" Stretch="Fill" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.12" IsHitTestVisible="False"
                              Data="M 10,0 L 186,0 L 196,10 L 196,36 L 186,46 L 10,46 L 0,36 L 0,10 Z" />
                        <Path x:Name="RunningFrame" Stretch="Fill" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="1" StrokeLineJoin="Miter" IsHitTestVisible="False"
                              Data="M 10,0 L 186,0 L 196,10 L 196,36 L 186,46 L 10,46 L 0,36 L 0,10 Z" />
                        <Grid Height="2" Margin="20,0,40,6" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <Rectangle Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.3" />
                            <Rectangle x:Name="RunningFill" Fill="{DynamicResource RunningIndicatorBrush}" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RunningFillScale" ScaleX="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Grid x:Name="RunningMark" Width="26" Height="26" Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Path x:Name="GemPing" Width="18" Height="18" Stretch="Fill" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter"
                                  Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" Data="M 9,0 L 18,9 L 9,18 L 0,9 Z">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="GemPingScale" ScaleX="1" ScaleY="1" />
                                </Path.RenderTransform>
                            </Path>
                            <Path x:Name="GemRing" Width="18" Height="18" Stretch="Fill" Stroke="{DynamicResource RunningIndicatorBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter"
                                  Opacity="0.9" IsHitTestVisible="False" Data="M 9,0 L 18,9 L 9,18 L 0,9 Z" />
                            <Path x:Name="GemCore" Width="8" Height="8" Stretch="Fill" Fill="{DynamicResource RunningIndicatorBrush}" Opacity="0.5" IsHitTestVisible="False"
                                  Data="M 4,0 L 8,4 L 4,8 L 0,4 Z" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningFill" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GemPingScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" KeySpline="0.2,0 0.4,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GemPingScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" KeySpline="0.2,0 0.4,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GemPing" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="0.85" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GemCore" Storyboard.TargetProperty="Opacity" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.05" Value="0.35" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.18" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.45" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="RunningIndicator" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningIndicatorRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningIndicator" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.72" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.72" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GemPingScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.4" KeySpline="0.2,0 0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GemPingScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="1.4" KeySpline="0.2,0 0.4,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GemPing" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="0.55" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GemCore" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.5" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="RunningIndicatorFill">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningFillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorRunning" />
                                <RemoveStoryboard BeginStoryboardName="RunningIndicatorFill" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid x:Name="Face">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="PressShift" Y="0" />
                            </Grid.RenderTransform>
                            <!-- Wings: swept feathers 16px off both edges, outside the button's bounds. The outer feather carries the edge chevron. -->
                            <Path x:Name="WingLeftOuter" Width="16" Height="32" Margin="-16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                                  Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" SnapsToDevicePixels="False"
                                  Data="M 16,15 C 10,14 5,16 0,12 C 2,17 4,19 1,25 C 6,24 11,24 16,26 M 16,17 L 12,23 L 16,29" />
                            <Path x:Name="WingLeftInner" Width="16" Height="32" Margin="-16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                                  Stroke="{DynamicResource FrameBrush}" StrokeThickness="1" SnapsToDevicePixels="False"
                                  Data="M 16,20 C 11,20 7,21 3,19" />
                            <Path x:Name="WingRightOuter" Width="16" Height="32" Margin="0,0,-16,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                                  Stroke="{DynamicResource GlyphBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" SnapsToDevicePixels="False" RenderTransformOrigin="0.5,0.5"
                                  Data="M 16,15 C 10,14 5,16 0,12 C 2,17 4,19 1,25 C 6,24 11,24 16,26 M 16,17 L 12,23 L 16,29">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </Path.RenderTransform>
                            </Path>
                            <Path x:Name="WingRightInner" Width="16" Height="32" Margin="0,0,-16,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                                  Stroke="{DynamicResource FrameBrush}" StrokeThickness="1" SnapsToDevicePixels="False" RenderTransformOrigin="0.5,0.5"
                                  Data="M 16,20 C 11,20 7,21 3,19">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </Path.RenderTransform>
                            </Path>
                            <!-- The plate: all four corners cut 10px, filled with the button's Background (the void; the running colour while it runs). -->
                            <Path x:Name="Plate" Stretch="Fill" Fill="{TemplateBinding Background}" IsHitTestVisible="False" SnapsToDevicePixels="False"
                                  Data="M 10,0 L 186,0 L 196,10 L 196,36 L 186,46 L 10,46 L 0,36 L 0,10 Z" />
                            <!-- Running and launching only, in the plate's shape and under the label. RunningBreath darkens the running-colour plate so the opaque cream label keeps its contrast. -->
                            <Path x:Name="RunningBreath" Stretch="Fill" Fill="{DynamicResource ScrimBrush}" Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="False"
                                  Data="M 10,0 L 186,0 L 196,10 L 196,36 L 186,46 L 10,46 L 0,36 L 0,10 Z" />
                            <!-- RunningScan (launching only): a band with a soft tail and a hard leading edge, masked by a gradient whose three stops travel across the plate. -->
                            <Path x:Name="RunningScan" Stretch="Fill" Fill="{DynamicResource RunningIndicatorBrush}" Visibility="Collapsed" Opacity="0.4" IsHitTestVisible="False" SnapsToDevicePixels="False"
                                  Data="M 10,0 L 186,0 L 196,10 L 196,36 L 186,46 L 10,46 L 0,36 L 0,10 Z">
                                <Path.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="RunningScanTail" Color="Transparent" Offset="-0.4" />
                                        <GradientStop x:Name="RunningScanHead" Color="Black" Offset="0" />
                                        <GradientStop x:Name="RunningScanEdge" Color="Transparent" Offset="0.002" />
                                    </LinearGradientBrush>
                                </Path.OpacityMask>
                            </Path>
                            <!-- RunningHoverDim: the Cancel state. A second scrim, faded in only while a RUNNING plate is hovered. Below the label. -->
                            <Path x:Name="RunningHoverDim" Stretch="Fill" Fill="{DynamicResource ScrimBrush}" Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="False"
                                  Data="M 10,0 L 186,0 L 196,10 L 196,36 L 186,46 L 10,46 L 0,36 L 0,10 Z" />
                            <!-- Hover: the lit fill, then the bloom rising from the foot, then the shine (all fade or sweep in; none loops). -->
                            <Path x:Name="HoverPlate" Stretch="Fill" Fill="{DynamicResource PrimaryButtonHoverBackgroundBrush}" Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="False"
                                  Data="M 10,0 L 186,0 L 196,10 L 196,36 L 186,46 L 10,46 L 0,36 L 0,10 Z" />
                            <Grid x:Name="BloomHost" Margin="12,4" ClipToBounds="True" Opacity="0" IsHitTestVisible="False">
                                <Rectangle Width="520" Height="110" Margin="0,0,0,-55" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" Opacity="0.55" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Rectangle Width="300" Height="84" Margin="0,0,0,-42" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0.8" IsHitTestVisible="False">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/fx/glow.png'}" Stretch="Fill" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                            <Grid x:Name="ShineHost" Margin="12,4" ClipToBounds="True" IsHitTestVisible="False">
                                <Grid x:Name="ShineCarrier" Width="64" HorizontalAlignment="Left" IsHitTestVisible="False">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="ShineShift" X="-70" />
                                    </Grid.RenderTransform>
                                    <Rectangle Width="38" HorizontalAlignment="Left" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0.45" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                        <Rectangle.RenderTransform>
                                            <SkewTransform AngleX="-18" />
                                        </Rectangle.RenderTransform>
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="Transparent" Offset="0" />
                                                <GradientStop Color="Black" Offset="0.75" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Rectangle Width="30" Height="30" Margin="26,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource PrimaryButtonGlowBrush}" Opacity="0.9" IsHitTestVisible="False">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{ThemeFile 'Images/fx/spark.png'}" Stretch="Uniform" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                            <!-- Pressed, its own layer: the gold-dim plate over the bloom. -->
                            <Path x:Name="PressedPlate" Stretch="Fill" Fill="{DynamicResource PrimaryButtonPressedBackgroundBrush}" Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="False"
                                  Data="M 10,0 L 186,0 L 196,10 L 196,36 L 186,46 L 10,46 L 0,36 L 0,10 Z" />
                            <!-- The bevel: the button's BorderBrush outline (gold; the running colour while it runs), BevelLightBrush on hover, and the FrameInnerBrush hairline inset 4px. -->
                            <Path x:Name="OutlineRest" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" IsHitTestVisible="False" SnapsToDevicePixels="False"
                                  Data="M 10,0 L 186,0 L 196,10 L 196,36 L 186,46 L 10,46 L 0,36 L 0,10 Z" />
                            <Path x:Name="OutlineHover" Stretch="Fill" Stroke="{DynamicResource BevelLightBrush}" StrokeThickness="1.5" StrokeLineJoin="Miter" Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="False"
                                  Data="M 10,0 L 186,0 L 196,10 L 196,36 L 186,46 L 10,46 L 0,36 L 0,10 Z" />
                            <Path x:Name="InnerRim" Margin="4" Stretch="Fill" Stroke="{DynamicResource FrameInnerBrush}" StrokeThickness="1" StrokeLineJoin="Miter" IsHitTestVisible="False" SnapsToDevicePixels="False"
                                  Data="M 8,0 L 180,0 L 188,8 L 188,30 L 180,38 L 8,38 L 0,30 L 0,8 Z" />
                            <!-- Label: the play triangle and the caption. PlayRoom reserves the gem's strip on the right while the game launches or runs. -->
                            <Border x:Name="PlayRoom" IsHitTestVisible="False">
                                <Grid Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel x:Name="LabelRow" Orientation="Horizontal">
                                        <Path x:Name="PlayGlyph" Width="11" Height="11" Stretch="Fill" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,10,1" Data="M 0,0 L 11,5.5 L 0,11 Z" />
                                        <ContentPresenter x:Name="PlayContent" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                    </StackPanel>
                                    <StackPanel x:Name="LabelRowPressed" Orientation="Horizontal" Opacity="0">
                                        <Path x:Name="PlayGlyphPressed" Width="11" Height="11" Stretch="Fill" Fill="{DynamicResource GlyphBrush}" VerticalAlignment="Center" Margin="0,0,10,1" Data="M 0,0 L 11,5.5 L 0,11 Z" />
                                        <ContentPresenter x:Name="PlayContentPressed" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource GlyphBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="CancelLabel" Text="{DynamicResource LOCCancelLabel}" Visibility="Collapsed" IsHitTestVisible="False"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="ContextAction">
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayGlyphPressed" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Hover: only while the game is not launching or running. In 0.2s, out 0.32s. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayHoverIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BloomHost" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OutlineHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ShineShift" Storyboard.TargetProperty="X" From="-70" To="190" Duration="0:0:0.65">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="PlayHoverOut">
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="BloomHost" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="OutlineHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ShineShift" Storyboard.TargetProperty="X" To="-70" Duration="0:0:0.01" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <!-- Press: its own layer. The plate sinks 1px, the gold-dim plate fades in over the bloom, the label crossfades to GlyphBrush. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsRunning}" Value="False" />
                                <Condition Binding="{Binding IsLaunching}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayPressIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="1" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="LabelRowPressed" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="LabelRow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Name="PlayPressOut">
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressedPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="PressShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LabelRowPressed" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LabelRow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BloomHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ShineHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="OutlineHover" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RunningScan" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningBreath" Property="Opacity" Value="0.55" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillLaunching">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanTail" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-0.4" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanHead" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.4" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningScanEdge" Storyboard.TargetProperty="Offset" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.002" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.15" Value="1.402" KeySpline="0.45,0 0.25,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="1.402" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillLaunching" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="HoverPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BloomHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ShineHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedPlate" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="OutlineHover" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="PlayFillRunning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RunningBreath" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.58" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0.46" KeySpline="0.4,0 0.6,1" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0.58" KeySpline="0.4,0 0.6,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="PlayFillRunning" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Cancel: only while a RUNNING plate is under the pointer. The binding is Self (this button). TemplatedParent is the whole game page. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelLabel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PlayContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Hidden" />
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="RunningCancelIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RunningHoverDim" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="CancelLabel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="RunningCancelIn" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <!-- RunningMarkRoom left="0" right="36": the running gem owns this strip of the button, never the label. -->
                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,36,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,36,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="PlayRoom" Property="Padding" Value="0,0,36,0" />
                            <Setter TargetName="CancelLabel" Property="Margin" Value="0,0,36,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Launching and running keep Play's plate, filled and outlined with the running colour; the cream label stays and RunningBreath darkens the plate under it. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RunningIndicatorBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RunningIndicatorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
