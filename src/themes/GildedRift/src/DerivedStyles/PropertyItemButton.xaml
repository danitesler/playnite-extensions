<!--
    Gilded Rift: metadata values on the notched pane. Structure: Playnite Default 10.60 (PropertyItemButton).
    Brushes: LinkBrush (hextech teal: a link is live), PropertyItemBackgroundBrush, PropertyItemHoverBackgroundBrush,
    PropertyItemForegroundBrush, FrameInnerBrush and FrameBrush (the chip's edge), TextBrushDarker (disabled).
    By default a text link: teal text with no underline at rest and a 1px teal rule that fades in under it on hover (0.12s).
    In a list tagged Tag="Chip" (RelativeSource AncestorType=ItemsControl) the value is a chip: a ChamferTemplate plate with the
    top-left and bottom-right corners cut 5px, a 1px FrameInnerBrush edge and a PropertyItemBackgroundBrush fill, 12px
    PropertyItemForegroundBrush text. Hover fades a second plate in (PropertyItemHoverBackgroundBrush fill, FrameBrush edge, 0.12s);
    leaving fades back in 0.2s with FillBehavior Stop. No setters on animated parts. The whole value is the hit area.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="PropertyItemButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Margin" Value="0,1,10,1" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <!-- Text link: teal text, and a thin rule that fades in under it on hover. -->
                        <Grid x:Name="LinkLayer">
                            <TextBlock x:Name="LinkText" Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                                       TextWrapping="Wrap" IsHitTestVisible="False" />
                            <Border x:Name="LinkRule" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource LinkBrush}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <!-- Chip: the chamfer-5 plate (a second one, lit, fades in on hover) and the text. -->
                        <Grid x:Name="ChipLayer" Visibility="Collapsed" MinHeight="22" IsHitTestVisible="False">
                            <Control Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource PropertyItemBackgroundBrush}" BorderBrush="{DynamicResource FrameInnerBrush}"
                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                <Control.Tag>
                                    <sys:Double>5</sys:Double>
                                </Control.Tag>
                            </Control>
                            <Control x:Name="ChipPlateLit" Template="{DynamicResource ChamferTemplate}" Background="{DynamicResource PropertyItemHoverBackgroundBrush}" BorderBrush="{DynamicResource FrameBrush}"
                                     Opacity="0" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
                                <Control.Tag>
                                    <sys:Double>5</sys:Double>
                                </Control.Tag>
                            </Control>
                            <TextBlock Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource PropertyItemForegroundBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="9,2,9,3" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                            <Setter TargetName="ChipLayer" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LinkLayer" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LinkRule" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ChipPlateLit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="LinkRule" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="ChipPlateLit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="LinkText" Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                            <Setter TargetName="LinkRule" Property="Background" Value="{DynamicResource TextBrushDarker}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Chip">
                <Setter Property="Margin" Value="0,2,5,3" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
